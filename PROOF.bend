          +j2 = {(pt.lt_nz(p, k, lt), i2) : pt.All(g2, z => Bool.not(Nat.is_eq(z, 0n)))}
          +j3 = {(pt.not_t(Tr.has(B, k), pt.blw_has(B, e, r, bw)), i3) : pt.All(g2, z => Bool.not(Tr.has(B, z)))}
          +tl = pt.ob_go(r, g2, Tr.gone.at(r, g2), {==}, x, t, B, j1, j2, j3, pt.blw_tail(B, e, r, bw, st), tree.pt.and_r(Tr.above(k, r), Tr.sorted(r), st), tree.pt.and_r(Tr.ok(t, k, p), Tr.rooted.go(r, t), rs))
