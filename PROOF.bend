      +x2 = O.bit(Nat.is_le(s2, sb), 0n)
      +x1 = O.bit(Nat.is_le(s, sb), 0n)
      %Equal.sym(Nat, 1n+Nat.add(x2, a2), Nat.add(x2, 1n+a2), cover.add_succ(x2, a2)) : {Nat.is_le(_, Nat.add(x1, a1)) == True{} : Bool}
