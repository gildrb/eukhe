def pt.allhas_self(t: List<&2, Tr.Ent>) -> {pt.allhas(t, t) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      tree.pt.and_t(Tr.has(h <> r, Tr.Ent.k(h)), pt.allhas(r, h <> r), pt.has_head(h, r), pt.allhas_cons(r, h, r, pt.allhas_self(r)))

def pt.dels_nil(s: List<&2, Tr.Ent>, +b: List<&2, Tr.Ent>, hit: Bool, eh: {Tr.held.at(s, b) == hit : Bool}, +ah: {pt.allhas(s, b) == True{} : Bool}) -> {Tr.dels.go(s, b, hit) == Nil{} : List<&2, Tr.Op>}:
  match s:
    case Nil{}:
      {==}
    case +e <> +r:
      match hit:
        case True{}:
          +i = Tr.has(b, Tr.Ent.k(e))
          pt.dels_nil(r, b, Tr.held.at(r, b), {==}, tree.pt.and_r(i, pt.allhas(r, b), ah))
        case False{}:
          +i = Tr.has(b, Tr.Ent.k(e))
          pt.void({Tr.dels.go(e <> r, b, False{}) == Nil{} : List<&2, Tr.Op>}, pt.flip(i, tree.pt.and_l(i, pt.allhas(r, b), ah), eh))

def pt.puts_nil(+a: List<&2, Tr.Ent>, s: List<&2, Tr.Ent>, hit: Bool, eh: {Tr.kept.at(a, s) == hit : Bool}, +w: {Tr.within(s, a) == True{} : Bool}) -> {Tr.puts.go(a, s, hit) == Nil{} : List<&2, Tr.Op>}:
  match s:
    case Nil{}:
      {==}
    case +e <> +r:
      match hit:
        case True{}:
          +i = Tr.same(Tr.get(a, Tr.Ent.k(e)), Some{e})
          pt.puts_nil(a, r, Tr.kept.at(a, r), {==}, tree.pt.and_r(i, Tr.within(r, a), w))
        case False{}:
          +i = Tr.same(Tr.get(a, Tr.Ent.k(e)), Some{e})
          pt.void({Tr.puts.go(a, e <> r, False{}) == Nil{} : List<&2, Tr.Op>}, pt.flip(i, tree.pt.and_l(i, Tr.within(r, a), w), eh))

def rewind_still(+a: List<&2, Tr.Ent>, ga: {Tr.sorted(a) == True{} : Bool}) -> {Tr.diff(a, a) == Nil{} : List<&2, Tr.Op>}:
  %Equal.sym(List<&2, Tr.Op>, Tr.dels(a, a), Nil{}, pt.dels_nil(a, a, Tr.held.at(a, a), {==}, pt.allhas_self(a))) : {List.append(&2, Tr.Op, _, Tr.puts(a, a)) == Nil{} : List<&2, Tr.Op>}
  pt.puts_nil(a, a, Tr.kept.at(a, a), {==}, pt.within_self(a, ga))

def pt.changed_app(xs: List<&2, Tr.Op>, +ys: List<&2, Tr.Op>, +a: List<&2, Tr.Ent>, +b: List<&2, Tr.Ent>, +cx: {Tr.changed(a, b, xs) == True{} : Bool}, cy: {Tr.changed(a, b, ys) == True{} : Bool}) -> {Tr.changed(a, b, List.append(&2, Tr.Op, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      cy
    case +o <> +r:
      +i = Bool.not(Tr.same(Tr.get(a, Tr.Op.k(o)), Tr.get(b, Tr.Op.k(o))))
