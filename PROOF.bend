def delete_within(+t: List<&2, Tr.Ent>, +good: {Tr.sound(t) == True{} : Bool}, +x: Nat) -> {Tr.within(Tr.apply(t, Tr.Do{Tr.Del{x}}), t) == True{} : Bool}:
  match x:
    case 0n:
      pt.within_self(t, tree.pt.and_l(Tr.sorted(t), Tr.rooted(t), good))
    case 1n+y:
      pt.within_prune_go(t, [1n+y], Tr.gone.at(t, [1n+y]), t, pt.within_self(t, tree.pt.and_l(Tr.sorted(t), Tr.rooted(t), good)))

# Rewind: still, minimal
# ----------------------

# b has the key of every node of s
def pt.allhas(s: List<&2, Tr.Ent>, +b: List<&2, Tr.Ent>) -> Bool:
  match s:
    case Nil{}:
      True{}
    case +e <> rest:
      Bool.and(Tr.has(b, Tr.Ent.k(e)), pt.allhas(rest, b))

def pt.allhas_cons(s: List<&2, Tr.Ent>, +h: Tr.Ent, +r: List<&2, Tr.Ent>, +ah: {pt.allhas(s, r) == True{} : Bool}) -> {pt.allhas(s, h <> r) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case +e <> +rest:
      +i = Tr.has(r, Tr.Ent.k(e))
      +hd = Equal.trans(Bool, Tr.has(h <> r, Tr.Ent.k(e)), Bool.or(Nat.is_eq(Tr.Ent.k(h), Tr.Ent.k(e)), i), True{}, pt.has_cons(h, r, Tr.Ent.k(e)), pt.or_tr(Nat.is_eq(Tr.Ent.k(h), Tr.Ent.k(e)), i, tree.pt.and_l(i, pt.allhas(rest, r), ah)))
