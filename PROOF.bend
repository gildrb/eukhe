    case Nil{}:
      {==}
    case +e <> +rest:
      +i = Tr.same(Tr.get(r, Tr.Ent.k(e)), Some{e})
      +gm = pt.get_miss(h, r, Tr.Ent.k(e), pt.lt_ne(Tr.Ent.k(h), Tr.Ent.k(e), al))
      +hd = Equal.trans(Bool, Tr.same(Tr.get(h <> r, Tr.Ent.k(e)), Some{e}), i, True{}, Equal.cong(Maybe<&2, Tr.Ent>, Bool, m => Tr.same(m, Some{e}), Tr.get(h <> r, Tr.Ent.k(e)), Tr.get(r, Tr.Ent.k(e)), gm), tree.pt.and_l(i, Tr.within(rest, r), w))
