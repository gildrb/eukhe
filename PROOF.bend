# a delete of the root changes nothing, and the root is no node
def delete_removes(+t: List<&2, Tr.Ent>, +good: {Tr.sound(t) == True{} : Bool}, +x: Nat) -> {Tr.has(Tr.apply(t, Tr.Do{Tr.Del{x}}), x) == False{} : Bool}:
  match x:
    case 0n:
      pt.rooted_nz(t, t, tree.pt.and_r(Tr.sorted(t), Tr.rooted(t), good))
    case 1n+y:
      pt.removes_nz(t, 1n+y)

def pt.within_prune_go(s: List<&2, Tr.Ent>, +gone: List<&2, Nat>, hit: Bool, +t: List<&2, Tr.Ent>, +w: {Tr.within(s, t) == True{} : Bool}) -> {Tr.within(Tr.prune.go(s, gone, hit), t) == True{} : Bool}:
