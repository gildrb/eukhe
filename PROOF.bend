      pa.vlast(d, pa.B(r))))

def pa.sv_r(+r: List<&2, Bool>, +v1: Nat, e1: {v1 == Nat.double(pa.B(r)) : Nat}) -> {List.reverse.go(&2, Nat, pa.SE(r, 1n), [v1]) == List.append(&2, Nat, pa.dbls(pa.rev(pa.SE(r, 0n))), [Nat.double(pa.B(r))]) : List<&2, Nat>}:
