      %pf.node_eq_refl(h) : {Bool.and(Bool.and(Bool.or(_, O.Nodes.has(rest, h)), True{}), C.needed(info, h <> rest, rec)) == True{} : Bool}
      pc.needed_cons(info, h, rest, rec, ih)
    case False{} False{} False{}:
