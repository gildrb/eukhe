          tree.pt.and_t(Bool.or(Tr.has(R, k), Bool.or(Nat.is_eq(k, x), Bool.and(Bool.not(Nat.is_eq(p, 0n)), Bool.not(Tr.has(R, p))))), Tr.only_below(r, x, R), hd, tl)

# a prune of a node (not the root) removes only its subtree
def pt.only_below_nz(+t: List<&2, Tr.Ent>, +good: {Tr.sound(t) == True{} : Bool}, +x: Nat, nz: {Nat.is_eq(x, 0n) == False{} : Bool}) -> {Tr.only_below(t, x, Tr.prune(t, x)) == True{} : Bool}:
  +i1 = {(pt.or_tl(Nat.is_eq(x, x), Tr.above(x, t), Equal.sym(Bool, True{}, Nat.is_eq(x, x), pt.eq_refl(x))), Unit{}) : pt.All([x], z => Bool.or(Nat.is_eq(z, x), Tr.above(z, t)))}
  +i2 = {(pt.not_t(Nat.is_eq(x, 0n), nz), Unit{}) : pt.All([x], z => Bool.not(Nat.is_eq(z, 0n)))}
  +i3 = {({==}, Unit{}) : pt.All([x], z => Bool.not(Tr.has(Nil{}, z)))}
  pt.ob_go(t, [x], Tr.gone.at(t, [x]), {==}, x, t, Nil{}, i1, i2, i3, {==}, tree.pt.and_l(Tr.sorted(t), Tr.rooted(t), good), tree.pt.and_r(Tr.sorted(t), Tr.rooted(t), good))

# a tree that keeps every node drops none
def pt.ob_all(s: List<&2, Tr.Ent>, +x: Nat, +r: List<&2, Tr.Ent>, +ah: {pt.allhas(s, r) == True{} : Bool}) -> {Tr.only_below(s, x, r) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case +e <> +rest:
      +i = Tr.has(r, Tr.Ent.k(e))
      +o = Bool.or(Nat.is_eq(Tr.Ent.k(e), x), Bool.and(Bool.not(Nat.is_eq(Tr.Ent.p(e), 0n)), Bool.not(Tr.has(r, Tr.Ent.p(e)))))
      tree.pt.and_t(Bool.or(i, o), Tr.only_below(rest, x, r), pt.or_tl(i, o, tree.pt.and_l(i, pt.allhas(rest, r), ah)), pt.ob_all(rest, x, r, tree.pt.and_r(i, pt.allhas(rest, r), ah)))

# a delete of the root changes nothing; of a node, removes its subtree
def delete_only_below(+t: List<&2, Tr.Ent>, +good: {Tr.sound(t) == True{} : Bool}, +x: Nat) -> {Tr.only_below(t, x, Tr.apply(t, Tr.Do{Tr.Del{x}})) == True{} : Bool}:
  match x:
    case 0n:
      pt.ob_all(t, 0n, t, pt.allhas_self(t))
    case 1n+y:
      pt.only_below_nz(t, good, 1n+y, {==})

# ---- job ----

# proof_job: the S2 laws (docs/runtime.md) of the job model in
# bend/job.bend: output caps and drops, one end per job, ended jobs stay
# ended, a blocking call never outlives its budget, a tool call's stream
# journals one final record carrying everything, and a rewind stops
# exactly the orphan jobs. Each job lemma speaks of a job at any state,
# by induction on the events it sees.

# Logic
# -----

def pj.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pj.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pj.BD(_, A, Unit)
  Unit{}

def pj.beq_refl(r: Bool) -> {True{} == Jb.b.eq(r, r) : Bool}:
  match r:
    case True{}:
      {==}
    case False{}:
      {==}

def pj.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pj.eq_refl(p)

# Arithmetic
# ----------

def pj.le0(t: Nat) -> {Nat.is_le(0n, t) == True{} : Bool}:
  match t:
    case 0n:
      {==}
    case 1n+q:
      {==}

def pj.le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pj.le_refl(p)

def pj.add_zero(x: Nat) -> {x == Nat.add(x, 0n) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %pj.add_zero(p) : {1n+p == 1n+_ : Nat}
      {==}

def pj.add_succ(a: Nat, +b: Nat) -> {1n+Nat.add(a, b) == Nat.add(a, 1n+b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pj.add_succ(p, b) : {1n+1n+Nat.add(p, b) == 1n+_ : Nat}
      {==}

def pj.add_assoc(a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pj.add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

def pj.swap(+x: Nat, +y: Nat, +s: Nat) -> {Nat.add(x, Nat.add(y, s)) == Nat.add(y, Nat.add(x, s)) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %pj.add_succ(y, Nat.add(p, s)) : {1n+Nat.add(p, Nat.add(y, s)) == _ : Nat}
      %pj.swap(p, y, s) : {1n+Nat.add(p, Nat.add(y, s)) == 1n+_ : Nat}
      {==}

def pj.swap4(k: Nat, +t: Nat, +d: Nat, +s: Nat) -> {Nat.add(Nat.add(k, d), Nat.add(t, s)) == Nat.add(Nat.add(k, t), Nat.add(d, s)) : Nat}:
  match k:
    case 0n:
      pj.swap(d, t, s)
    case 1n+p:
      %pj.swap4(p, t, d, s) : {1n+Nat.add(Nat.add(p, d), Nat.add(t, s)) == 1n+_ : Nat}
      {==}

def pj.sub_zero(c: Nat) -> {c == Nat.sub(c, 0n) : Nat}:
  match c:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pj.sub_self(n: Nat) -> {0n == Nat.sub(n, n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pj.sub_self(p)

def pj.sub_sub(c: Nat, k: Nat, +n: Nat) -> {Nat.sub(Nat.sub(c, k), n) == Nat.sub(c, Nat.add(k, n)) : Nat}:
  match c k:
    case 0n _:
      {==}
    case 1n+cp 0n:
      {==}
    case 1n+cp 1n+kp:
      pj.sub_sub(cp, kp, n)

def pj.add_sub(t: Nat, n: Nat, le: {Nat.is_le(t, n) == True{} : Bool}) -> {n == Nat.add(t, Nat.sub(n, t)) : Nat}:
  match t n:
    case 0n _:
      pj.sub_zero(n)
    case 1n+tp 0n:
      pj.absurdF({0n == Nat.add(1n+tp, Nat.sub(0n, 1n+tp)) : Nat}, le)
    case 1n+tp 1n+np:
      %pj.add_sub(tp, np, le) : {1n+np == 1n+_ : Nat}
      {==}

def pj.min_le_l(n: Nat, m: Nat) -> {Nat.is_le(Nat.min(n, m), n) == True{} : Bool}:
  match n m:
    case 0n _:
      {==}
    case 1n+np 0n:
      {==}
    case 1n+np 1n+mp:
      pj.min_le_l(np, mp)

def pj.min_le_r(n: Nat, m: Nat) -> {Nat.is_le(Nat.min(n, m), m) == True{} : Bool}:
  match n m:
    case 0n _:
      pj.le0(m)
    case 1n+np 0n:
      {==}
    case 1n+np 1n+mp:
      pj.min_le_r(np, mp)

def pj.min_of_le(n: Nat, m: Nat, h: {Nat.is_le(n, m) == True{} : Bool}) -> {n == Nat.min(n, m) : Nat}:
  match n m:
    case 0n _:
      {==}
    case 1n+np 0n:
      pj.absurdF({1n+np == Nat.min(1n+np, 0n) : Nat}, h)
    case 1n+np 1n+mp:
      %pj.min_of_le(np, mp, h) : {1n+np == 1n+_ : Nat}
      {==}

def pj.le_addl(n: Nat, +p: Nat, m: Nat, h: {Nat.is_le(Nat.add(n, p), m) == True{} : Bool}) -> {Nat.is_le(n, m) == True{} : Bool}:
  match n m:
    case 0n _:
      pj.le0(m)
    case 1n+np 0n:
      pj.absurdF({Nat.is_le(1n+np, 0n) == True{} : Bool}, h)
    case 1n+np 1n+mp:
      pj.le_addl(np, p, mp, h)

def pj.le_sub(n: Nat, +p: Nat, m: Nat, h: {Nat.is_le(Nat.add(n, p), m) == True{} : Bool}) -> {Nat.is_le(p, Nat.sub(m, n)) == True{} : Bool}:
  match n m:
    case 0n 0n:
      h
    case 0n 1n+mp:
      h
    case 1n+np 0n:
      pj.absurdF({Nat.is_le(p, 0n) == True{} : Bool}, h)
    case 1n+np 1n+mp:
      pj.le_sub(np, p, mp, h)

# a kept count under the cap stays under it after any output
def pj.bound(k: Nat, c: Nat, +n: Nat, h: {Nat.is_le(k, c) == True{} : Bool}) -> {Nat.is_le(Nat.add(k, Nat.min(n, Nat.sub(c, k))), c) == True{} : Bool}:
  match k c:
    case 0n 0n:
      pj.min_le_r(n, 0n)
    case 0n 1n+cp:
      pj.min_le_r(n, 1n+cp)
    case 1n+kp 0n:
      pj.absurdF({Nat.is_le(Nat.add(1n+kp, Nat.min(n, Nat.sub(0n, 1n+kp))), 0n) == True{} : Bool}, h)
    case 1n+kp 1n+cp:
      pj.bound(kp, cp, n, h)

def pj.take_le(cap: Maybe<&2, Nat>, +k: Nat, +n: Nat) -> {Nat.is_le(Jb.take(cap, k, n), n) == True{} : Bool}:
  match cap:
    case None{}:
      pj.le_refl(n)
    case Some{c}:
      pj.min_le_l(n, Nat.sub(c, k))

# an output of n bytes adds n to the bytes kept plus dropped
def pj.split(+k: Nat, +d: Nat, +t: Nat, +n: Nat, le: {Nat.is_le(t, n) == True{} : Bool}) -> {Nat.add(Nat.add(k, d), n) == Nat.add(Nat.add(k, t), Nat.add(d, Nat.sub(n, t))) : Nat}:
  %pj.swap4(k, t, d, Nat.sub(n, t)) : {Nat.add(Nat.add(k, d), n) == _ : Nat}
  %pj.add_sub(t, n, le) : {Nat.add(Nat.add(k, d), n) == Nat.add(Nat.add(k, d), _) : Nat}
  {==}

# the room left under the cap shrinks by the output that fits
def pj.fit_room(+c: Nat, +k: Nat, +n: Nat, +p: Nat, h: {Nat.is_le(Nat.add(n, p), Nat.sub(c, k)) == True{} : Bool}) -> {Nat.is_le(p, Nat.sub(c, Nat.add(k, n))) == True{} : Bool}:
  %pj.sub_sub(c, k, n) : {Nat.is_le(p, _) == True{} : Bool}
  pj.le_sub(n, p, Nat.sub(c, k), h)

def pj.room0(+c: Nat, -es: List<&2, Jb.JEv>, fits: {Nat.is_le(Jb.produced(es), c) == True{} : Bool}) -> {Nat.is_le(Jb.produced(es), Nat.sub(c, 0n)) == True{} : Bool}:
  %pj.sub_zero(c) : {Nat.is_le(Jb.produced(es), _) == True{} : Bool}
  fits

# Jobs
# ----

# an ended job stays as it ended
def pj.ended(es: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat, +x: Jb.End) -> {Jb.Ended{k, d, x} == Jb.go(es, cap, Jb.Ended{k, d, x}) : Jb.J}:
  match es:
    case Nil{}:
      {==}
    case e <> rest:
      pj.ended(rest, cap, k, d, x)

# an ended job reports no more ends
def pj.ends_ended(es: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat, +x: Jb.End) -> {Nil{} == Jb.ends.go(es, cap, Jb.Ended{k, d, x}) : List<&2, Jb.End>}:
  match es:
    case Nil{}:
      {==}
    case e <> rest:
      pj.ends_ended(rest, cap, k, d, x)

def pj.same(+xs: List<&2, Jb.JEv>, +ys: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat, +x: Jb.End) -> {Jb.go(xs, cap, Jb.Ended{k, d, x}) == Jb.go(ys, cap, Jb.Ended{k, d, x}) : Jb.J}:
  %pj.ended(xs, cap, k, d, x) : {_ == Jb.go(ys, cap, Jb.Ended{k, d, x}) : Jb.J}
  pj.ended(ys, cap, k, d, x)

def pj.quit_end(+xs: List<&2, Jb.JEv>, +ys: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, j: Jb.J, +q: Nat) -> {Jb.go(xs, cap, Jb.step(cap, j, Jb.Quit{q})) == Jb.go(ys, cap, Jb.step(cap, j, Jb.Quit{q})) : Jb.J}:
  match j:
    case Jb.Live{k, d}:
      pj.same(xs, ys, cap, k, d, Jb.Exited{q})
    case Jb.Ended{k, d, x}:
      pj.same(xs, ys, cap, k, d, x)

def pj.kill_end(+xs: List<&2, Jb.JEv>, +ys: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, j: Jb.J) -> {Jb.go(xs, cap, Jb.step(cap, j, Jb.Kill{})) == Jb.go(ys, cap, Jb.step(cap, j, Jb.Kill{})) : Jb.J}:
  match j:
    case Jb.Live{k, d}:
      pj.same(xs, ys, cap, k, d, Jb.Killed{})
    case Jb.Ended{k, d, x}:
      pj.same(xs, ys, cap, k, d, x)

# once a prefix holds an end, the rest changes nothing
def pj.final(pre: List<&2, Jb.JEv>, post: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +j: Jb.J, h: {Jb.has_end(pre) == True{} : Bool}) -> {Jb.go(List.append(&2, Jb.JEv, pre, post), cap, j) == Jb.go(pre, cap, j) : Jb.J}:
  match pre:
    case Nil{}:
      pj.absurdF({Jb.go(post, cap, j) == j : Jb.J}, h)
    case e <> +rest:
      match e:
        case Jb.Out{n}:
          pj.final(rest, post, cap, Jb.step(cap, j, Jb.Out{n}), h)
        case Jb.Quit{q}:
          pj.quit_end(List.append(&2, Jb.JEv, rest, post), rest, cap, j, q)
        case Jb.Kill{}:
          pj.kill_end(List.append(&2, Jb.JEv, rest, post), rest, cap, j)
        case Jb.Tick{}:
          pj.final(rest, post, cap, Jb.step(cap, j, Jb.Tick{}), h)

# one step keeps the kept bytes under the cap
def pj.step_bd(+c: Nat, j: Jb.J, e: Jb.JEv, h: {Nat.is_le(Jb.J.kept(j), c) == True{} : Bool}) -> {Nat.is_le(Jb.J.kept(Jb.step(Some{c}, j, e)), c) == True{} : Bool}:
  match j:
    case Jb.Live{+k, d}:
      match e:
        case Jb.Out{+n}:
          pj.bound(k, c, n, h)
        case Jb.Quit{q}:
          h
        case Jb.Kill{}:
          h
        case Jb.Tick{}:
          h
    case Jb.Ended{k, d, x}:
      h

def pj.bounded(es: List<&2, Jb.JEv>, +c: Nat, +j: Jb.J, h: {Nat.is_le(Jb.J.kept(j), c) == True{} : Bool}) -> {Nat.is_le(Jb.J.kept(Jb.go(es, Some{c}, j)), c) == True{} : Bool}:
  match es:
    case Nil{}:
      h
    case +e <> rest:
      pj.bounded(rest, c, Jb.step(Some{c}, j, e), pj.step_bd(c, j, e, h))

# the bytes kept plus dropped grow by every byte written before the end
def pj.loss(es: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat) -> {Nat.add(Nat.add(k, d), Jb.produced(es)) == Nat.add(Jb.J.kept(Jb.go(es, cap, Jb.Live{k, d})), Jb.J.dropped(Jb.go(es, cap, Jb.Live{k, d}))) : Nat}:
  match es:
    case Nil{}:
      %pj.add_zero(Nat.add(k, d)) : {_ == Nat.add(k, d) : Nat}
      {==}
    case e <> +rest:
      match e:
        case Jb.Out{+n}:
          +t = Jb.take(cap, k, n)
          +p = Jb.produced(rest)
          %pj.loss(rest, cap, Nat.add(k, t), Nat.add(d, Nat.sub(n, t))) : {Nat.add(Nat.add(k, d), Nat.add(n, p)) == _ : Nat}
          %pj.split(k, d, t, n, pj.take_le(cap, k, n)) : {Nat.add(Nat.add(k, d), Nat.add(n, p)) == Nat.add(_, p) : Nat}
          %pj.add_assoc(Nat.add(k, d), n, p) : {_ == Nat.add(Nat.add(Nat.add(k, d), n), p) : Nat}
          {==}
        case Jb.Quit{q}:
          %pj.ended(rest, cap, k, d, Jb.Exited{q}) : {Nat.add(Nat.add(k, d), 0n) == Nat.add(Jb.J.kept(_), Jb.J.dropped(_)) : Nat}
          %pj.add_zero(Nat.add(k, d)) : {_ == Nat.add(k, d) : Nat}
          {==}
        case Jb.Kill{}:
          %pj.ended(rest, cap, k, d, Jb.Killed{}) : {Nat.add(Nat.add(k, d), 0n) == Nat.add(Jb.J.kept(_), Jb.J.dropped(_)) : Nat}
          %pj.add_zero(Nat.add(k, d)) : {_ == Nat.add(k, d) : Nat}
          {==}
        case Jb.Tick{}:
          pj.loss(rest, cap, k, d)

# with the opt-out, nothing is dropped
def pj.optout(es: List<&2, Jb.JEv>, +k: Nat) -> {Jb.J.dropped(Jb.go(es, None{}, Jb.Live{k, 0n})) == 0n : Nat}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Jb.Out{+n}:
          %pj.sub_self(n) : {Jb.J.dropped(Jb.go(rest, None{}, Jb.Live{Nat.add(k, n), _})) == 0n : Nat}
          pj.optout(rest, Nat.add(k, n))
        case Jb.Quit{q}:
          %pj.ended(rest, None{}, k, 0n, Jb.Exited{q}) : {Jb.J.dropped(_) == 0n : Nat}
          {==}
        case Jb.Kill{}:
          %pj.ended(rest, None{}, k, 0n, Jb.Killed{}) : {Jb.J.dropped(_) == 0n : Nat}
          {==}
        case Jb.Tick{}:
          pj.optout(rest, k)

# output that fits the room left under the cap drops nothing
def pj.fit(es: List<&2, Jb.JEv>, +c: Nat, +k: Nat, +h: {Nat.is_le(Jb.produced(es), Nat.sub(c, k)) == True{} : Bool}) -> {Jb.J.dropped(Jb.go(es, Some{c}, Jb.Live{k, 0n})) == 0n : Nat}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Jb.Out{+n}:
          %pj.min_of_le(n, Nat.sub(c, k), pj.le_addl(n, Jb.produced(rest), Nat.sub(c, k), h)) : {Jb.J.dropped(Jb.go(rest, Some{c}, Jb.Live{Nat.add(k, _), Nat.sub(n, _)})) == 0n : Nat}
          %pj.sub_self(n) : {Jb.J.dropped(Jb.go(rest, Some{c}, Jb.Live{Nat.add(k, n), _})) == 0n : Nat}
          pj.fit(rest, c, Nat.add(k, n), pj.fit_room(c, k, n, Jb.produced(rest), h))
        case Jb.Quit{q}:
          %pj.ended(rest, Some{c}, k, 0n, Jb.Exited{q}) : {Jb.J.dropped(_) == 0n : Nat}
          {==}
        case Jb.Kill{}:
          %pj.ended(rest, Some{c}, k, 0n, Jb.Killed{}) : {Jb.J.dropped(_) == 0n : Nat}
          {==}
        case Jb.Tick{}:
          pj.fit(rest, c, k, h)

# a live job reports one end iff its events hold one
def pj.once(es: List<&2, Jb.JEv>, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat) -> {List.length(&2, Jb.End, Jb.ends.go(es, cap, Jb.Live{k, d})) == Jb.once(Jb.has_end(es)) : Nat}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Jb.Out{+n}:
          +t = Jb.take(cap, k, n)
          pj.once(rest, cap, Nat.add(k, t), Nat.add(d, Nat.sub(n, t)))
        case Jb.Quit{q}:
          %pj.ends_ended(rest, cap, k, d, Jb.Exited{q}) : {1n+List.length(&2, Jb.End, _) == 1n : Nat}
          {==}
        case Jb.Kill{}:
          %pj.ends_ended(rest, cap, k, d, Jb.Killed{}) : {1n+List.length(&2, Jb.End, _) == 1n : Nat}
          {==}
        case Jb.Tick{}:
          pj.once(rest, cap, k, d)

# Blocking calls
# --------------

def pj.blocks(es: List<&2, Jb.JEv>, +b: Nat, long: {Nat.is_le(b, Jb.ticks(es)) == True{} : Bool}) -> {Maybe.is_some(&2, Jb.Wait, Jb.wait(es, b)) == True{} : Bool}:
  match es:
    case Nil{}:
      match b:
        case 0n:
          {==}
        case 1n+l:
          pj.absurdF({Maybe.is_some(&2, Jb.Wait, Jb.wait(Nil{}, 1n+l)) == True{} : Bool}, long)
    case e <> rest:
      match e:
        case Jb.Out{n}:
          match b:
            case 0n:
              {==}
            case 1n+l:
              pj.blocks(rest, 1n+l, long)
        case Jb.Quit{q}:
          match b:
            case 0n:
              {==}
            case 1n+l:
              {==}
        case Jb.Kill{}:
          match b:
            case 0n:
              {==}
            case 1n+l:
              {==}
        case Jb.Tick{}:
          match b:
            case 0n:
              {==}
            case 1n+l:
              pj.blocks(rest, l, long)

def pj.is_settled(m: Maybe<&2, Jb.Wait>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{w}:
      match w:
        case Jb.Settled{x}:
          True{}
        case Jb.Detached{}:
          False{}

def pj.end_of(m: Maybe<&2, Jb.Wait>) -> Jb.End:
  match m:
    case None{}:
      Jb.Killed{}
    case Some{w}:
      match w:
        case Jb.Settled{x}:
          x
        case Jb.Detached{}:
          Jb.Killed{}

# an answer that settled is a settle
def pj.settled(-m: Maybe<&2, Jb.Wait>, -x: Jb.End, s: {m == Some{Jb.Settled{x}} : Maybe<&2, Jb.Wait>}) -> {pj.is_settled(m) == True{} : Bool}:
  Equal.cong(Maybe<&2, Jb.Wait>, Bool, w => pj.is_settled(w), m, Some{Jb.Settled{x}}, s)

# an answer that settled carries its end
def pj.end_eq(-m: Maybe<&2, Jb.Wait>, -x: Jb.End, s: {m == Some{Jb.Settled{x}} : Maybe<&2, Jb.Wait>}) -> {pj.end_of(m) == x : Jb.End}:
  Equal.cong(Maybe<&2, Jb.Wait>, Jb.End, w => pj.end_of(w), m, Some{Jb.Settled{x}}, s)

def pj.settle(es: List<&2, Jb.JEv>, +b: Nat, +cap: Maybe<&2, Nat>, +k: Nat, +d: Nat, +x: Jb.End, s: {Jb.wait(es, b) == Some{Jb.Settled{x}} : Maybe<&2, Jb.Wait>}) -> {Jb.ends.go(es, cap, Jb.Live{k, d}) == [x] : List<&2, Jb.End>}:
  match es:
    case Nil{}:
      match b:
        case 0n:
          pj.absurdF({Nil{} == [x] : List<&2, Jb.End>}, pj.settled(Some{Jb.Detached{}}, x, s))
        case 1n+l:
          pj.absurdF({Nil{} == [x] : List<&2, Jb.End>}, pj.settled(None{}, x, s))
    case e <> +rest:
      match e:
        case Jb.Out{+n}:
          match b:
            case 0n:
              pj.absurdF({Jb.ends.go(Jb.Out{n} <> rest, cap, Jb.Live{k, d}) == [x] : List<&2, Jb.End>}, pj.settled(Some{Jb.Detached{}}, x, s))
            case 1n+l:
              +t = Jb.take(cap, k, n)
              pj.settle(rest, 1n+l, cap, Nat.add(k, t), Nat.add(d, Nat.sub(n, t)), x, s)
        case Jb.Quit{+q}:
          match b:
            case 0n:
              pj.absurdF({Jb.ends.go(Jb.Quit{q} <> rest, cap, Jb.Live{k, d}) == [x] : List<&2, Jb.End>}, pj.settled(Some{Jb.Detached{}}, x, s))
            case 1n+l:
              %pj.ends_ended(rest, cap, k, d, Jb.Exited{q}) : {Jb.Exited{q} <> _ == [x] : List<&2, Jb.End>}
              %pj.end_eq(Some{Jb.Settled{Jb.Exited{q}}}, x, s) : {[Jb.Exited{q}] == [_] : List<&2, Jb.End>}
              {==}
        case Jb.Kill{}:
          match b:
            case 0n:
              pj.absurdF({Jb.ends.go(Jb.Kill{} <> rest, cap, Jb.Live{k, d}) == [x] : List<&2, Jb.End>}, pj.settled(Some{Jb.Detached{}}, x, s))
            case 1n+l:
              %pj.ends_ended(rest, cap, k, d, Jb.Killed{}) : {Jb.Killed{} <> _ == [x] : List<&2, Jb.End>}
              %pj.end_eq(Some{Jb.Settled{Jb.Killed{}}}, x, s) : {[Jb.Killed{}] == [_] : List<&2, Jb.End>}
              {==}
        case Jb.Tick{}:
          match b:
            case 0n:
              pj.absurdF({Jb.ends.go(Jb.Tick{} <> rest, cap, Jb.Live{k, d}) == [x] : List<&2, Jb.End>}, pj.settled(Some{Jb.Detached{}}, x, s))
            case 1n+l:
              pj.settle(rest, l, cap, k, d, x, s)

# Streams
# -------

# a settled call journals nothing more
def pj.cshut(es: List<&2, Jb.CEv>) -> {Nil{} == Jb.c.go(es, Jb.Shut{}) : List<&2, Jb.CRec>}:
  match es:
    case Nil{}:
      {==}
    case e <> rest:
      pj.cshut(rest)

def pj.two(es: List<&2, Jb.CEv>, +b: Nat, +w: Nat, +u: Nat) -> {Nat.is_le(List.length(&2, Jb.CRec, Jb.c.go(es, Jb.Open{b, w, u})), 1n) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Jb.Delta{n}:
          pj.two(rest, Nat.add(b, n), w, u)
        case Jb.Warn{}:
          pj.two(rest, b, 1n+w, u)
        case Jb.Use{n}:
          pj.two(rest, b, w, Nat.add(u, n))
        case Jb.Final{}:
          %pj.cshut(rest) : {Nat.is_le(1n+List.length(&2, Jb.CRec, _), 1n) == True{} : Bool}
          {==}
        case Jb.Cancel{}:
          %pj.cshut(rest) : {Nat.is_le(1n+List.length(&2, Jb.CRec, _), 1n) == True{} : Bool}
          {==}

def pj.sett(es: List<&2, Jb.CEv>, +b: Nat, +w: Nat, +u: Nat) -> {Jb.settles(Jb.c.go(es, Jb.Open{b, w, u})) == Jb.once(Jb.c.ends(es)) : Nat}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Jb.Delta{n}:
          pj.sett(rest, Nat.add(b, n), w, u)
        case Jb.Warn{}:
          pj.sett(rest, b, 1n+w, u)
        case Jb.Use{n}:
          pj.sett(rest, b, w, Nat.add(u, n))
        case Jb.Final{}:
          %pj.cshut(rest) : {1n+Jb.settles(_) == 1n : Nat}
          {==}
        case Jb.Cancel{}:
          %pj.cshut(rest) : {1n+Jb.settles(_) == 1n : Nat}
          {==}

def pj.carry(es: List<&2, Jb.CEv>, +b: Nat, +w: Nat, +u: Nat, h: {Jb.c.ends(es) == True{} : Bool}) -> {Jb.carried(Jb.c.go(es, Jb.Open{b, w, u})) == Some{Jb.Tally{Nat.add(b, Jb.c.bytes(es)), Nat.add(w, Jb.c.warns(es)), Nat.add(u, Jb.c.usage(es))}} : Maybe<&2, Jb.Tally>}:
  match es:
    case Nil{}:
      pj.absurdF({Jb.carried(Nil{}) == Some{Jb.Tally{Nat.add(b, 0n), Nat.add(w, 0n), Nat.add(u, 0n)}} : Maybe<&2, Jb.Tally>}, h)
    case e <> +rest:
      match e:
        case Jb.Delta{+n}:
          %pj.add_assoc(b, n, Jb.c.bytes(rest)) : {Jb.carried(Jb.c.go(rest, Jb.Open{Nat.add(b, n), w, u})) == Some{Jb.Tally{_, Nat.add(w, Jb.c.warns(rest)), Nat.add(u, Jb.c.usage(rest))}} : Maybe<&2, Jb.Tally>}
          pj.carry(rest, Nat.add(b, n), w, u, h)
        case Jb.Warn{}:
          %pj.add_succ(w, Jb.c.warns(rest)) : {Jb.carried(Jb.c.go(rest, Jb.Open{b, 1n+w, u})) == Some{Jb.Tally{Nat.add(b, Jb.c.bytes(rest)), _, Nat.add(u, Jb.c.usage(rest))}} : Maybe<&2, Jb.Tally>}
          pj.carry(rest, b, 1n+w, u, h)
        case Jb.Use{+n}:
          %pj.add_assoc(u, n, Jb.c.usage(rest)) : {Jb.carried(Jb.c.go(rest, Jb.Open{b, w, Nat.add(u, n)})) == Some{Jb.Tally{Nat.add(b, Jb.c.bytes(rest)), Nat.add(w, Jb.c.warns(rest)), _}} : Maybe<&2, Jb.Tally>}
          pj.carry(rest, b, w, Nat.add(u, n), h)
        case Jb.Final{}:
          %pj.add_zero(b) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{_, Nat.add(w, 0n), Nat.add(u, 0n)}} : Maybe<&2, Jb.Tally>}
          %pj.add_zero(w) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{b, _, Nat.add(u, 0n)}} : Maybe<&2, Jb.Tally>}
          %pj.add_zero(u) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{b, w, _}} : Maybe<&2, Jb.Tally>}
          {==}
        case Jb.Cancel{}:
          %pj.add_zero(b) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{_, Nat.add(w, 0n), Nat.add(u, 0n)}} : Maybe<&2, Jb.Tally>}
          %pj.add_zero(w) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{b, _, Nat.add(u, 0n)}} : Maybe<&2, Jb.Tally>}
          %pj.add_zero(u) : {Some{Jb.Tally{b, w, u}} == Some{Jb.Tally{b, w, _}} : Maybe<&2, Jb.Tally>}
          {==}

# Rewinds
# -------

def pj.id_stop(h: Bool, +i: Nat, +r: Bool) -> {i == Jb.Slot.id(Jb.stop.at(h, Jb.Slot{i, r})) : Nat}:
  match h:
    case True{}:
      {==}
    case False{}:
      {==}

def pj.ok_run(h: Bool, +i: Nat, r: Bool) -> {True{} == Bool.or(Bool.not(Jb.Slot.running(Jb.stop.at(h, Jb.Slot{i, r}))), h) : Bool}:
  match h:
    case True{}:
      match r:
        case True{}:
          {==}
        case False{}:
          {==}
    case False{}:
      {==}

def pj.ok_keep(h: Bool, +i: Nat, +r: Bool) -> {True{} == Bool.or(Bool.not(h), Bool.and(Nat.is_eq(i, i), Jb.b.eq(Jb.Slot.running(Jb.stop.at(h, Jb.Slot{i, r})), r))) : Bool}:
  match h:
    case True{}:
      %pj.eq_refl(i) : {True{} == Bool.and(_, Jb.b.eq(r, r)) : Bool}
      pj.beq_refl(r)
    case False{}:
      {==}

def pj.stops(js: List<&2, Jb.Slot>, +keep: List<&2, Nat>) -> {Jb.running_in(Jb.rewind(js, keep), keep) == True{} : Bool}:
  match js:
    case Nil{}:
      {==}
    case s <> rest:
      match s:
        case Jb.Slot{+i, +r}:
          +h = Jb.elem(keep, i)
          %pj.id_stop(h, i, r) : {Bool.and(Bool.or(Bool.not(Jb.Slot.running(Jb.stop.at(h, Jb.Slot{i, r}))), Jb.elem(keep, _)), Jb.running_in(Jb.rewind(rest, keep), keep)) == True{} : Bool}
          %pj.ok_run(h, i, r) : {Bool.and(_, Jb.running_in(Jb.rewind(rest, keep), keep)) == True{} : Bool}
          pj.stops(rest, keep)

def pj.keeps(js: List<&2, Jb.Slot>, +keep: List<&2, Nat>) -> {Jb.kept(Jb.rewind(js, keep), js, keep) == True{} : Bool}:
  match js:
    case Nil{}:
      {==}
    case s <> +rest:
      match s:
        case Jb.Slot{+i, +r}:
          +h = Jb.elem(keep, i)
          +S = Jb.stop.at(h, Jb.Slot{i, r})
          %pj.id_stop(h, i, r) : {Bool.and(Bool.or(Bool.not(Jb.elem(keep, _)), Bool.and(Nat.is_eq(_, i), Jb.b.eq(Jb.Slot.running(S), r))), Jb.kept(Jb.rewind(rest, keep), rest, keep)) == True{} : Bool}
          %pj.ok_keep(h, i, r) : {Bool.and(_, Jb.kept(Jb.rewind(rest, keep), rest, keep)) == True{} : Bool}
          pj.keeps(rest, keep)

# The laws
# --------

def pj.job_output_bounded(+c: Nat, es: List<&2, Jb.JEv>) -> {Nat.is_le(Jb.J.kept(Jb.run(Some{c}, es)), c) == True{} : Bool}:
  pj.bounded(es, c, Jb.Live{0n, 0n}, pj.le0(c))

def pj.job_no_silent_loss(+cap: Maybe<&2, Nat>, +es: List<&2, Jb.JEv>) -> {Nat.add(Jb.J.kept(Jb.run(cap, es)), Jb.J.dropped(Jb.run(cap, es))) == Jb.produced(es) : Nat}:
  Equal.sym(Nat, Jb.produced(es), Nat.add(Jb.J.kept(Jb.run(cap, es)), Jb.J.dropped(Jb.run(cap, es))), pj.loss(es, cap, 0n, 0n))

def pj.job_optout_keeps_all(es: List<&2, Jb.JEv>) -> {Jb.J.dropped(Jb.run(None{}, es)) == 0n : Nat}:
  pj.optout(es, 0n)

def pj.job_cap_drops_only_excess(+c: Nat, +es: List<&2, Jb.JEv>, fits: {Nat.is_le(Jb.produced(es), c) == True{} : Bool}) -> {Jb.J.dropped(Jb.run(Some{c}, es)) == 0n : Nat}:
  pj.fit(es, c, 0n, pj.room0(c, es, fits))

def pj.job_ends_once(+cap: Maybe<&2, Nat>, +es: List<&2, Jb.JEv>) -> {List.length(&2, Jb.End, Jb.ends(cap, es)) == Jb.once(Jb.has_end(es)) : Nat}:
  pj.once(es, cap, 0n, 0n)

def pj.job_end_is_final(+cap: Maybe<&2, Nat>, +pre: List<&2, Jb.JEv>, post: List<&2, Jb.JEv>, ended: {Jb.has_end(pre) == True{} : Bool}) -> {Jb.run(cap, List.append(&2, Jb.JEv, pre, post)) == Jb.run(cap, pre) : Jb.J}:
  pj.final(pre, post, cap, Jb.Live{0n, 0n}, ended)

def pj.job_kill_ends_now(+cap: Maybe<&2, Nat>, +k: Nat, +d: Nat) -> {Jb.step(cap, Jb.Live{k, d}, Jb.Kill{}) == Jb.Ended{k, d, Jb.Killed{}} : Jb.J}:
  {==}

def pj.call_blocks_at_most_budget(+b: Nat, +es: List<&2, Jb.JEv>, long: {Nat.is_le(b, Jb.ticks(es)) == True{} : Bool}) -> {Maybe.is_some(&2, Jb.Wait, Jb.wait(es, b)) == True{} : Bool}:
  pj.blocks(es, b, long)

def pj.call_settles_with_job(+cap: Maybe<&2, Nat>, +b: Nat, +es: List<&2, Jb.JEv>, +x: Jb.End, settled: {Jb.wait(es, b) == Some{Jb.Settled{x}} : Maybe<&2, Jb.Wait>}) -> {Jb.ends(cap, es) == [x] : List<&2, Jb.End>}:
  pj.settle(es, b, cap, 0n, 0n, x, settled)

def pj.stream_journals_two(es: List<&2, Jb.CEv>) -> {Nat.is_le(List.length(&2, Jb.CRec, Jb.journal(es)), 2n) == True{} : Bool}:
  pj.two(es, 0n, 0n, 0n)

def pj.stream_settles_once(+es: List<&2, Jb.CEv>) -> {Jb.settles(Jb.journal(es)) == Jb.once(Jb.c.ends(es)) : Nat}:
  pj.sett(es, 0n, 0n, 0n)

def pj.stream_settle_carries_all(+es: List<&2, Jb.CEv>, ended: {Jb.c.ends(es) == True{} : Bool}) -> {Jb.carried(Jb.journal(es)) == Some{Jb.Tally{Jb.c.bytes(es), Jb.c.warns(es), Jb.c.usage(es)}} : Maybe<&2, Jb.Tally>}:
  pj.carry(es, 0n, 0n, 0n, ended)

def pj.rewind_stops_orphans(+js: List<&2, Jb.Slot>, +keep: List<&2, Nat>) -> {Jb.running_in(Jb.rewind(js, keep), keep) == True{} : Bool}:
  pj.stops(js, keep)

def pj.rewind_keeps_target_jobs(+js: List<&2, Jb.Slot>, +keep: List<&2, Nat>) -> {Jb.kept(Jb.rewind(js, keep), js, keep) == True{} : Bool}:
  pj.keeps(js, keep)

# ---- sandbox ----

# proof_sandbox: the S3 laws (docs/runtime.md) of the sandbox model in
# bend/sandbox.bend: the protocol and the copy-on-write hand-back.
#
# The protocol: one host step adds one reply and runs the frame iff it is
# accepted (`px.ids_add`, `px.ok_add`, `px.len_add`); each law follows by
# induction on the frames. The hand-back: the lookup of a path k in the new
# workspace is the merge of k when k is listed, else nothing
# (`px.read_back`), and k is a conflict iff it is listed and its merge
# clashes (`px.cl_back`). The merge of one path then decides each law
# (`px.keep_body`, `px.take_body`, `px.clash_one`, `px.real`).

# Logic
# -----

def px.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def px.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : px.BD(_, A, Unit)
  Unit{}

def px.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      px.absurdF({b == True{} : Bool}, h)

def px.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def px.and_false(b: Bool) -> {False{} == Bool.and(b, False{}) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# Numbers
# -------

def px.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      px.eq_refl(p)

def px.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      px.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      px.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, px.eq_true(p, q, h))

# b below a: a is not at most b
def px.lt_nle(a: Nat, b: Nat, h: {Nat.is_lt(b, a) == True{} : Bool}) -> {False{} == Nat.is_le(a, b) : Bool}:
  match a b:
    case 0n 0n:
      px.absurdF({False{} == Nat.is_le(0n, 0n) : Bool}, h)
    case 0n 1n+q:
      px.absurdF({False{} == Nat.is_le(0n, 1n+q) : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      px.lt_nle(p, q, h)

def px.meq_refl(m: Maybe<&2, Nat>) -> {True{} == Sb.m.eq(m, m) : Bool}:
  match m:
    case None{}:
      {==}
    case Some{x}:
      px.eq_refl(x)

# 1. The protocol
# ---------------

def px.ids_add(g: Bool, +f: Sb.Frame, h: Sb.Host) -> {Sb.Frame.id(f) <> Sb.reply.ids(Sb.Host.replies(h)) == Sb.reply.ids(Sb.Host.replies(Sb.host.add(g, f, h))) : List<&2, Nat>}:
  match g:
    case True{}:
      match h:
        case Sb.Host{rs, xs}:
          {==}
    case False{}:
      match h:
        case Sb.Host{rs, xs}:
          {==}

def px.proto_one_reply_each(+fs: List<&2, Sb.Frame>, +max: Nat, +allowed: List<&2, Nat>) -> {Sb.reply.ids(Sb.Host.replies(Sb.serve(fs, max, allowed))) == Sb.frame.ids(fs) : List<&2, Nat>}:
  match fs:
    case Nil{}:
      {==}
    case f <> rest:
      %px.ids_add(Sb.accepts(max, allowed, f), f, Sb.serve(rest, max, allowed)) : {_ == Sb.Frame.id(f) <> Sb.frame.ids(rest) : List<&2, Nat>}
      %px.proto_one_reply_each(rest, max, allowed) : {Sb.Frame.id(f) <> Sb.reply.ids(Sb.Host.replies(Sb.serve(rest, max, allowed))) == Sb.Frame.id(f) <> _ : List<&2, Nat>}
      {==}

# a step keeps every frame run accepted
def px.ok_add(g: Bool, +f: Sb.Frame, h: Sb.Host, +max: Nat, +allowed: List<&2, Nat>, e: {Sb.accepts(max, allowed, f) == g : Bool}, ih: {Sb.all_ok(Sb.Host.ran(h), max, allowed) == True{} : Bool}) -> {Sb.all_ok(Sb.Host.ran(Sb.host.add(g, f, h)), max, allowed) == True{} : Bool}:
  match g:
    case True{}:
      match h:
        case Sb.Host{rs, xs}:
          px.and_t(Sb.accepts(max, allowed, f), Sb.all_ok(xs, max, allowed), e, ih)
    case False{}:
      match h:
        case Sb.Host{rs, xs}:
          ih

def px.proto_runs_only_accepted(+fs: List<&2, Sb.Frame>, +max: Nat, +allowed: List<&2, Nat>) -> {Sb.all_ok(Sb.Host.ran(Sb.serve(fs, max, allowed)), max, allowed) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case f <> rest:
      px.ok_add(Sb.accepts(max, allowed, f), f, Sb.serve(rest, max, allowed), max, allowed, {==}, px.proto_runs_only_accepted(rest, max, allowed))

def px.len_add(g: Bool, +f: Sb.Frame, h: Sb.Host) -> {Nat.add(Sb.one(g), List.length(&2, Sb.Frame, Sb.Host.ran(h))) == List.length(&2, Sb.Frame, Sb.Host.ran(Sb.host.add(g, f, h))) : Nat}:
  match g:
    case True{}:
      match h:
        case Sb.Host{rs, xs}:
          {==}
    case False{}:
      match h:
        case Sb.Host{rs, xs}:
          {==}

def px.proto_runs_every_accepted(+fs: List<&2, Sb.Frame>, +max: Nat, +allowed: List<&2, Nat>) -> {List.length(&2, Sb.Frame, Sb.Host.ran(Sb.serve(fs, max, allowed))) == Sb.oks(fs, max, allowed) : Nat}:
  match fs:
    case Nil{}:
      {==}
    case f <> rest:
      %px.len_add(Sb.accepts(max, allowed, f), f, Sb.serve(rest, max, allowed)) : {_ == Nat.add(Sb.one(Sb.accepts(max, allowed, f)), Sb.oks(rest, max, allowed)) : Nat}
      %px.proto_runs_every_accepted(rest, max, allowed) : {Nat.add(Sb.one(Sb.accepts(max, allowed, f)), List.length(&2, Sb.Frame, Sb.Host.ran(Sb.serve(rest, max, allowed)))) == Nat.add(Sb.one(Sb.accepts(max, allowed, f)), _) : Nat}
      {==}

def px.proto_rejects_oversize(+i: Nat, +l: Nat, +k: Nat, +max: Nat, +allowed: List<&2, Nat>, over: {Nat.is_lt(max, l) == True{} : Bool}) -> {Sb.serve([Sb.Frame{i, l, k}], max, allowed) == Sb.Host{[Sb.Err{i}], Nil{}} : Sb.Host}:
  %px.lt_nle(l, max, over) : {Sb.host.add(Bool.and(_, Sb.elem(allowed, k)), Sb.Frame{i, l, k}, Sb.Host{Nil{}, Nil{}}) == Sb.Host{[Sb.Err{i}], Nil{}} : Sb.Host}
  {==}

# 2. A copy-on-write workspace
# ----------------------------

# the merge of path k
def px.mk(+par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat) -> Sb.One:
  Sb.merge1(Sb.read(par, k), Sb.read(base, k), Sb.read(child, k))

def px.sel(b: Bool, m: Maybe<&2, Nat>) -> Maybe<&2, Nat>:
  match b:
    case True{}:
      m
    case False{}:
      None{}

def px.sel_none(b: Bool) -> {None{} == px.sel(b, None{}) : Maybe<&2, Nat>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# a file added at k is what k reads, else what follows
def px.read_hit(+k: Nat, m: Maybe<&2, Nat>, +W: List<&2, Sb.Doc>, +b: Bool, ih: {px.sel(b, m) == Sb.read(W, k) : Maybe<&2, Nat>}) -> {m == Sb.read(List.append(&2, Sb.Doc, Sb.back.file(k, m), W), k) : Maybe<&2, Nat>}:
  match m:
    case None{}:
      %ih : {None{} == _ : Maybe<&2, Nat>}
      px.sel_none(b)
    case Some{v}:
      %px.eq_refl(k) : {Some{v} == Sb.read.go(Sb.Doc{k, v} <> W, k, _) : Maybe<&2, Nat>}
      {==}

# a file added at another path is not read
def px.read_miss(+j: Nat, m: Maybe<&2, Nat>, +W: List<&2, Sb.Doc>, +k: Nat, ne: {Nat.is_eq(j, k) == False{} : Bool}) -> {Sb.read(W, k) == Sb.read(List.append(&2, Sb.Doc, Sb.back.file(j, m), W), k) : Maybe<&2, Nat>}:
  match m:
    case None{}:
      {==}
    case Some{v}:
      %Equal.sym(Bool, Nat.is_eq(j, k), False{}, ne) : {Sb.read(W, k) == Sb.read.go(Sb.Doc{j, v} <> W, k, _) : Maybe<&2, Nat>}
      {==}

def px.read_hit2(+k: Nat, +o: Sb.One, x: Sb.Back, +b: Bool, ih: {px.sel(b, Sb.One.body(o)) == Sb.read(Sb.Back.ws(x), k) : Maybe<&2, Nat>}) -> {Sb.One.body(o) == Sb.read(Sb.Back.ws(Sb.back.add(k, o, x)), k) : Maybe<&2, Nat>}:
  match x:
    case Sb.Back{w, c}:
      px.read_hit(k, Sb.One.body(o), w, b, ih)

def px.read_miss2(+j: Nat, +o: Sb.One, x: Sb.Back, +k: Nat, ne: {Nat.is_eq(j, k) == False{} : Bool}) -> {Sb.read(Sb.Back.ws(x), k) == Sb.read(Sb.Back.ws(Sb.back.add(j, o, x)), k) : Maybe<&2, Nat>}:
  match x:
    case Sb.Back{w, c}:
      px.read_miss(j, Sb.One.body(o), w, k, ne)

def px.rb_go(+j: Nat, +rest: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, c: Bool, ec: {Nat.is_eq(j, k) == c : Bool}, ih: {px.sel(Sb.elem(rest, k), Sb.One.body(px.mk(par, base, child, k))) == Sb.read(Sb.Back.ws(Sb.back(rest, par, base, child)), k) : Maybe<&2, Nat>}) -> {px.sel(Bool.or(c, Sb.elem(rest, k)), Sb.One.body(px.mk(par, base, child, k))) == Sb.read(Sb.Back.ws(Sb.back(j <> rest, par, base, child)), k) : Maybe<&2, Nat>}:
  match c:
    case True{}:
      %Equal.sym(Nat, j, k, px.eq_true(j, k, ec)) : {Sb.One.body(px.mk(par, base, child, k)) == Sb.read(Sb.Back.ws(Sb.back(_ <> rest, par, base, child)), k) : Maybe<&2, Nat>}
      px.read_hit2(k, px.mk(par, base, child, k), Sb.back(rest, par, base, child), Sb.elem(rest, k), ih)
    case False{}:
      %px.read_miss2(j, px.mk(par, base, child, j), Sb.back(rest, par, base, child), k, ec) : {px.sel(Sb.elem(rest, k), Sb.One.body(px.mk(par, base, child, k))) == _ : Maybe<&2, Nat>}
      ih

# the new workspace holds at k the merge of k, if k is listed
def px.read_back(ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat) -> {px.sel(Sb.elem(ks, k), Sb.One.body(px.mk(par, base, child, k))) == Sb.read(Sb.Back.ws(Sb.back(ks, par, base, child)), k) : Maybe<&2, Nat>}:
  match ks:
    case Nil{}:
      {==}
    case +j <> +rest:
      px.rb_go(j, rest, par, base, child, k, Nat.is_eq(j, k), {==}, px.read_back(rest, par, base, child, k))

def px.cl_hit_go(+k: Nat, d: Bool, +cs: List<&2, Nat>, +b: Bool, ih: {Bool.and(b, d) == Sb.elem(cs, k) : Bool}) -> {d == Sb.elem(List.append(&2, Nat, Sb.back.clash(k, d), cs), k) : Bool}:
  match d:
    case True{}:
      %px.eq_refl(k) : {True{} == Bool.or(_, Sb.elem(cs, k)) : Bool}
      {==}
    case False{}:
      %ih : {False{} == _ : Bool}
      px.and_false(b)

def px.cl_miss_go(+j: Nat, d: Bool, +cs: List<&2, Nat>, +k: Nat, ne: {Nat.is_eq(j, k) == False{} : Bool}) -> {Sb.elem(cs, k) == Sb.elem(List.append(&2, Nat, Sb.back.clash(j, d), cs), k) : Bool}:
  match d:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(j, k), False{}, ne) : {Sb.elem(cs, k) == Bool.or(_, Sb.elem(cs, k)) : Bool}
      {==}
    case False{}:
      {==}

def px.cl_hit(+k: Nat, +o: Sb.One, x: Sb.Back, +b: Bool, ih: {Bool.and(b, Sb.One.clash(o)) == Sb.elem(Sb.Back.clashes(x), k) : Bool}) -> {Sb.One.clash(o) == Sb.elem(Sb.Back.clashes(Sb.back.add(k, o, x)), k) : Bool}:
  match x:
    case Sb.Back{w, cs}:
      px.cl_hit_go(k, Sb.One.clash(o), cs, b, ih)

def px.cl_miss(+j: Nat, +o: Sb.One, x: Sb.Back, +k: Nat, ne: {Nat.is_eq(j, k) == False{} : Bool}) -> {Sb.elem(Sb.Back.clashes(x), k) == Sb.elem(Sb.Back.clashes(Sb.back.add(j, o, x)), k) : Bool}:
  match x:
    case Sb.Back{w, cs}:
      px.cl_miss_go(j, Sb.One.clash(o), cs, k, ne)

def px.cb_go(+j: Nat, +rest: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, c: Bool, ec: {Nat.is_eq(j, k) == c : Bool}, ih: {Bool.and(Sb.elem(rest, k), Sb.One.clash(px.mk(par, base, child, k))) == Sb.elem(Sb.Back.clashes(Sb.back(rest, par, base, child)), k) : Bool}) -> {Bool.and(Bool.or(c, Sb.elem(rest, k)), Sb.One.clash(px.mk(par, base, child, k))) == Sb.elem(Sb.Back.clashes(Sb.back(j <> rest, par, base, child)), k) : Bool}:
  match c:
    case True{}:
      %Equal.sym(Nat, j, k, px.eq_true(j, k, ec)) : {Sb.One.clash(px.mk(par, base, child, k)) == Sb.elem(Sb.Back.clashes(Sb.back(_ <> rest, par, base, child)), k) : Bool}
      px.cl_hit(k, px.mk(par, base, child, k), Sb.back(rest, par, base, child), Sb.elem(rest, k), ih)
    case False{}:
      %px.cl_miss(j, px.mk(par, base, child, j), Sb.back(rest, par, base, child), k, ec) : {Bool.and(Sb.elem(rest, k), Sb.One.clash(px.mk(par, base, child, k))) == _ : Bool}
      ih

# k is a conflict iff it is listed and its merge clashes
def px.cl_back(ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat) -> {Bool.and(Sb.elem(ks, k), Sb.One.clash(px.mk(par, base, child, k))) == Sb.elem(Sb.Back.clashes(Sb.back(ks, par, base, child)), k) : Bool}:
  match ks:
    case Nil{}:
      {==}
    case +j <> +rest:
      px.cb_go(j, rest, par, base, child, k, Nat.is_eq(j, k), {==}, px.cl_back(rest, par, base, child, k))

# The merge of one path
# ---------------------

def px.keep_body(+p: Maybe<&2, Nat>, +b: Maybe<&2, Nat>, +c: Maybe<&2, Nat>, calm: {Sb.m.eq(c, b) == True{} : Bool}) -> {p == Sb.One.body(Sb.merge1(p, b, c)) : Maybe<&2, Nat>}:
  %Equal.sym(Bool, Sb.m.eq(c, b), True{}, calm) : {p == Sb.One.body(Sb.merge.at(Bool.not(_), Bool.not(Sb.m.eq(p, b)), Sb.m.eq(p, c), p, c)) : Maybe<&2, Nat>}
  {==}

def px.take_body(+p: Maybe<&2, Nat>, +b: Maybe<&2, Nat>, +c: Maybe<&2, Nat>, moved: {Sb.m.eq(c, b) == False{} : Bool}, still: {Sb.m.eq(p, b) == True{} : Bool}) -> {c == Sb.One.body(Sb.merge1(p, b, c)) : Maybe<&2, Nat>}:
  %Equal.sym(Bool, Sb.m.eq(c, b), False{}, moved) : {c == Sb.One.body(Sb.merge.at(Bool.not(_), Bool.not(Sb.m.eq(p, b)), Sb.m.eq(p, c), p, c)) : Maybe<&2, Nat>}
  %Equal.sym(Bool, Sb.m.eq(p, b), True{}, still) : {c == Sb.One.body(Sb.merge.at(True{}, Bool.not(_), Sb.m.eq(p, c), p, c)) : Maybe<&2, Nat>}
  {==}

def px.clash_one(+p: Maybe<&2, Nat>, +b: Maybe<&2, Nat>, +c: Maybe<&2, Nat>, moved: {Sb.m.eq(c, b) == False{} : Bool}, also: {Sb.m.eq(p, b) == False{} : Bool}, apart: {Sb.m.eq(p, c) == False{} : Bool}) -> {Sb.One{p, True{}} == Sb.merge1(p, b, c) : Sb.One}:
  %Equal.sym(Bool, Sb.m.eq(c, b), False{}, moved) : {Sb.One{p, True{}} == Sb.merge.at(Bool.not(_), Bool.not(Sb.m.eq(p, b)), Sb.m.eq(p, c), p, c) : Sb.One}
  %Equal.sym(Bool, Sb.m.eq(p, b), False{}, also) : {Sb.One{p, True{}} == Sb.merge.at(True{}, Bool.not(_), Sb.m.eq(p, c), p, c) : Sb.One}
  %Equal.sym(Bool, Sb.m.eq(p, c), False{}, apart) : {Sb.One{p, True{}} == Sb.merge.at(True{}, True{}, _, p, c) : Sb.One}
  {==}

def px.real_go(x: Bool, y: Bool, z: Bool, +p: Maybe<&2, Nat>, +c: Maybe<&2, Nat>, h: {Sb.One.clash(Sb.merge.at(Bool.not(x), Bool.not(y), z, p, c)) == True{} : Bool}) -> {Bool.or(Bool.or(x, y), z) == False{} : Bool}:
  match x y z:
    case True{} _ _:
      px.absurdF({Bool.or(Bool.or(True{}, y), z) == False{} : Bool}, h)
    case False{} True{} _:
      px.absurdF({Bool.or(Bool.or(False{}, True{}), z) == False{} : Bool}, h)
    case False{} False{} True{}:
      px.absurdF({Bool.or(Bool.or(False{}, False{}), True{}) == False{} : Bool}, h)
    case False{} False{} False{}:
      {==}

# a merge that clashes saw both sides change, apart
def px.real(+p: Maybe<&2, Nat>, +b: Maybe<&2, Nat>, +c: Maybe<&2, Nat>, h: {Sb.One.clash(Sb.merge1(p, b, c)) == True{} : Bool}) -> {Bool.or(Bool.or(Sb.m.eq(c, b), Sb.m.eq(p, b)), Sb.m.eq(p, c)) == False{} : Bool}:
  px.real_go(Sb.m.eq(c, b), Sb.m.eq(p, b), Sb.m.eq(p, c), p, c, h)

# The laws
# --------

def px.cow_keeps_parent(+ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, listed: {Sb.elem(ks, k) == True{} : Bool}, calm: {Sb.m.eq(Sb.read(child, k), Sb.read(base, k)) == True{} : Bool}) -> {Sb.read(Sb.Back.ws(Sb.back(ks, par, base, child)), k) == Sb.read(par, k) : Maybe<&2, Nat>}:
  %px.read_back(ks, par, base, child, k) : {_ == Sb.read(par, k) : Maybe<&2, Nat>}
  %Equal.sym(Bool, Sb.elem(ks, k), True{}, listed) : {px.sel(_, Sb.One.body(px.mk(par, base, child, k))) == Sb.read(par, k) : Maybe<&2, Nat>}
  %px.keep_body(Sb.read(par, k), Sb.read(base, k), Sb.read(child, k), calm) : {_ == Sb.read(par, k) : Maybe<&2, Nat>}
  {==}

def px.cow_takes_child(+ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, listed: {Sb.elem(ks, k) == True{} : Bool}, moved: {Sb.m.eq(Sb.read(child, k), Sb.read(base, k)) == False{} : Bool}, still: {Sb.m.eq(Sb.read(par, k), Sb.read(base, k)) == True{} : Bool}) -> {Sb.read(Sb.Back.ws(Sb.back(ks, par, base, child)), k) == Sb.read(child, k) : Maybe<&2, Nat>}:
  %px.read_back(ks, par, base, child, k) : {_ == Sb.read(child, k) : Maybe<&2, Nat>}
  %Equal.sym(Bool, Sb.elem(ks, k), True{}, listed) : {px.sel(_, Sb.One.body(px.mk(par, base, child, k))) == Sb.read(child, k) : Maybe<&2, Nat>}
  %px.take_body(Sb.read(par, k), Sb.read(base, k), Sb.read(child, k), moved, still) : {_ == Sb.read(child, k) : Maybe<&2, Nat>}
  {==}

def px.cow_conflict_reported(+ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, listed: {Sb.elem(ks, k) == True{} : Bool}, moved: {Sb.m.eq(Sb.read(child, k), Sb.read(base, k)) == False{} : Bool}, also: {Sb.m.eq(Sb.read(par, k), Sb.read(base, k)) == False{} : Bool}, apart: {Sb.m.eq(Sb.read(par, k), Sb.read(child, k)) == False{} : Bool}) -> {Bool.and(Sb.m.eq(Sb.read(Sb.Back.ws(Sb.back(ks, par, base, child)), k), Sb.read(par, k)), Sb.elem(Sb.Back.clashes(Sb.back(ks, par, base, child)), k)) == True{} : Bool}:
  %px.read_back(ks, par, base, child, k) : {Bool.and(Sb.m.eq(_, Sb.read(par, k)), Sb.elem(Sb.Back.clashes(Sb.back(ks, par, base, child)), k)) == True{} : Bool}
  %px.cl_back(ks, par, base, child, k) : {Bool.and(Sb.m.eq(px.sel(Sb.elem(ks, k), Sb.One.body(px.mk(par, base, child, k))), Sb.read(par, k)), _) == True{} : Bool}
  %Equal.sym(Bool, Sb.elem(ks, k), True{}, listed) : {Bool.and(Sb.m.eq(px.sel(_, Sb.One.body(px.mk(par, base, child, k))), Sb.read(par, k)), Bool.and(_, Sb.One.clash(px.mk(par, base, child, k)))) == True{} : Bool}
  %px.clash_one(Sb.read(par, k), Sb.read(base, k), Sb.read(child, k), moved, also, apart) : {Bool.and(Sb.m.eq(Sb.One.body(_), Sb.read(par, k)), Sb.One.clash(_)) == True{} : Bool}
  %px.meq_refl(Sb.read(par, k)) : {Bool.and(_, True{}) == True{} : Bool}
  {==}

def px.cow_conflict_is_real(+ks: List<&2, Nat>, +par: List<&2, Sb.Doc>, +base: List<&2, Sb.Doc>, +child: List<&2, Sb.Doc>, +k: Nat, clash: {Sb.elem(Sb.Back.clashes(Sb.back(ks, par, base, child)), k) == True{} : Bool}) -> {Bool.or(Bool.or(Sb.m.eq(Sb.read(child, k), Sb.read(base, k)), Sb.m.eq(Sb.read(par, k), Sb.read(base, k))), Sb.m.eq(Sb.read(par, k), Sb.read(child, k))) == False{} : Bool}:
  +M = px.mk(par, base, child, k)
  +both = Equal.trans(Bool, Bool.and(Sb.elem(ks, k), Sb.One.clash(M)), Sb.elem(Sb.Back.clashes(Sb.back(ks, par, base, child)), k), True{}, px.cl_back(ks, par, base, child, k), clash)
  px.real(Sb.read(par, k), Sb.read(base, k), Sb.read(child, k), px.and_r(Sb.elem(ks, k), Sb.One.clash(M), both))

# ---- cvar ----

# proof_cvar: the S4 laws (docs/control.md) of the cvar model in
# bend/cvar.bend.
#
# A layer of sets is read one set at a time (`pv.layer_cons`), so a set
# appended last acts on the value of the sets before it
# (`pv.layer_snoc`): a hit gives its value, a miss keeps the value.
# The registry adds a declaration only when its id is free and its
# default is well typed, which keeps it unique and typed; a hit is a
# valid set of the found declaration, so every layer keeps the type of
# the default. A set of a Global cvar never hits in an agent layer. The
# cfg an agent writes drops only sets that miss its persisted cvar. A
# toggle's set of x hits or misses the same way whatever its Bool, so
# a second toggle undoes the first. Expansion leaves only plain
# commands, and its depth bound turns a self-running alias into a
# cycle.

# Logic
# -----

def cvar.pv.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def cvar.pv.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : cvar.pv.BD(_, Unit, A)
  Unit{}

def pv.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : cvar.pv.BD(_, A, Unit)
  Unit{}

def cvar.pv.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pv.absurdF({False{} == True{} : Bool}, h)

def cvar.pv.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pv.absurdF({b == True{} : Bool}, h)

def pv.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pv.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      pv.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pv.not_f(+b: Bool, h: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  %Equal.sym(Bool, b, False{}, h) : {Bool.not(_) == True{} : Bool}
  {==}

def pv.not_not(b: Bool) -> {Bool.not(Bool.not(b)) == b : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pv.MD(m: Maybe<&2, Cv.Decl>, n: Type, s: Type) -> Type:
  match m:
    case None{}:
      n
    case Some{x}:
      s

def pv.none_some(-A: Type, -d: Cv.Decl, e: {None{} == Some{d} : Maybe<&2, Cv.Decl>}) -> A:
  %e : pv.MD(_, Unit, A)
  Unit{}

def pv.some_inj(-a: Cv.Decl, -b: Cv.Decl, e: {Some{a} == Some{b} : Maybe<&2, Cv.Decl>}) -> {a == b : Cv.Decl}:
  Equal.cong(Maybe<&2, Cv.Decl>, Cv.Decl, m => Maybe.default(&2, Cv.Decl, m, a), Some{a}, Some{b}, e)

# Numbers and types
# -----------------

def cvar.pv.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      cvar.pv.eq_refl(p)

def pv.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pv.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pv.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pv.eq_true(p, q, h))

def pv.eq_comm(a: Nat, b: Nat) -> {Nat.is_eq(a, b) == Nat.is_eq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pv.eq_comm(p, q)

def pv.ne_comm(+a: Nat, +b: Nat, h: {Nat.is_eq(a, b) == False{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  %pv.eq_comm(a, b) : {_ == False{} : Bool}
  h

def pv.ty_refl(t: Cv.Ty) -> {Cv.Ty.eq(t, t) == True{} : Bool}:
  match t:
    case Cv.TNat{}:
      {==}
    case Cv.TBool{}:
      {==}

def pv.ty_true(a: Cv.Ty, b: Cv.Ty, h: {Cv.Ty.eq(a, b) == True{} : Bool}) -> {a == b : Cv.Ty}:
  match a b:
    case Cv.TNat{} Cv.TNat{}:
      {==}
    case Cv.TNat{} Cv.TBool{}:
      pv.absurdF({Cv.TNat{} == Cv.TBool{} : Cv.Ty}, h)
    case Cv.TBool{} Cv.TNat{}:
      pv.absurdF({Cv.TBool{} == Cv.TNat{} : Cv.Ty}, h)
    case Cv.TBool{} Cv.TBool{}:
      {==}

# Lists
# -----

def pv.app_nil(xs: List<&2, Cv.Cmd>) -> {List.append(&2, Cv.Cmd, xs, Nil{}) == xs : List<&2, Cv.Cmd>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      Equal.cong(List<&2, Cv.Cmd>, List<&2, Cv.Cmd>, z => h <> z, List.append(&2, Cv.Cmd, t, Nil{}), t, pv.app_nil(t))

# The registry
# ------------

# a lookup that misses a list misses its head
def pv.find_ne(b: Bool, +h: Cv.Decl, +r: List<&2, Cv.Decl>, +y: Nat, nf: {Maybe.is_some(&2, Cv.Decl, Cv.find.go(h <> r, y, b)) == False{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      nf
    case False{}:
      {==}

# a lookup that misses a list misses its tail
def pv.find_tail(b: Bool, +h: Cv.Decl, +r: List<&2, Cv.Decl>, +y: Nat, nf: {Maybe.is_some(&2, Cv.Decl, Cv.find.go(h <> r, y, b)) == False{} : Bool}) -> {Maybe.is_some(&2, Cv.Decl, Cv.find(r, y)) == False{} : Bool}:
  match b:
    case True{}:
      cvar.pv.absurd({Maybe.is_some(&2, Cv.Decl, Cv.find(r, y)) == False{} : Bool}, nf)
    case False{}:
      nf

# a lookup that misses ds misses ds with another id appended
def pv.find_snoc(r: List<&2, Cv.Decl>, +d: Cv.Decl, +y: Nat, b: Bool, eb: {Cv.id.at(r, y) == b : Bool}, h1: {Maybe.is_some(&2, Cv.Decl, Cv.find.go(r, y, b)) == False{} : Bool}, h2: {Nat.is_eq(Cv.Decl.id(d), y) == False{} : Bool}) -> {Maybe.is_some(&2, Cv.Decl, Cv.find(List.append(&2, Cv.Decl, r, [d]), y)) == False{} : Bool}:
  match r:
    case Nil{}:
      %Equal.sym(Bool, Nat.is_eq(Cv.Decl.id(d), y), False{}, h2) : {Maybe.is_some(&2, Cv.Decl, Cv.find.go([d], y, _)) == False{} : Bool}
      {==}
    case +h <> +t:
      match b:
        case True{}:
          cvar.pv.absurd({Maybe.is_some(&2, Cv.Decl, Cv.find(h <> List.append(&2, Cv.Decl, t, [d]), y)) == False{} : Bool}, h1)
        case False{}:
          %Equal.sym(Bool, Nat.is_eq(Cv.Decl.id(h), y), False{}, eb) : {Maybe.is_some(&2, Cv.Decl, Cv.find.go(h <> List.append(&2, Cv.Decl, t, [d]), y, _)) == False{} : Bool}
          pv.find_snoc(t, d, y, Cv.id.at(t, y), {==}, h1, h2)

def pv.unique_snoc(ds: List<&2, Cv.Decl>, +d: Cv.Decl, +h: {Cv.unique(ds) == True{} : Bool}, +nf: {Maybe.is_some(&2, Cv.Decl, Cv.find(ds, Cv.Decl.id(d))) == False{} : Bool}) -> {Cv.unique(List.append(&2, Cv.Decl, ds, [d])) == True{} : Bool}:
  match ds:
    case Nil{}:
      {==}
    case +x <> +r:
      +nx = Bool.not(Maybe.is_some(&2, Cv.Decl, Cv.find(r, Cv.Decl.id(x))))
      +ne = pv.find_ne(Nat.is_eq(Cv.Decl.id(x), Cv.Decl.id(d)), x, r, Cv.Decl.id(d), nf)
      +nr = pv.find_tail(Nat.is_eq(Cv.Decl.id(x), Cv.Decl.id(d)), x, r, Cv.Decl.id(d), nf)
      +hx = pv.not_t(Maybe.is_some(&2, Cv.Decl, Cv.find(r, Cv.Decl.id(x))), cvar.pv.and_l(nx, Cv.unique(r), h))
      +hr = cvar.pv.and_r(nx, Cv.unique(r), h)
      +rd = List.append(&2, Cv.Decl, r, [d])
      +fs = pv.find_snoc(r, d, Cv.Decl.id(x), Cv.id.at(r, Cv.Decl.id(x)), {==}, hx, pv.ne_comm(Cv.Decl.id(x), Cv.Decl.id(d), ne))
      pv.and_t(Bool.not(Maybe.is_some(&2, Cv.Decl, Cv.find(rd, Cv.Decl.id(x)))), Cv.unique(rd), pv.not_f(Maybe.is_some(&2, Cv.Decl, Cv.find(rd, Cv.Decl.id(x))), fs), pv.unique_snoc(r, d, hr, nr))

def pv.declare_unique(t: Bool, g: Bool, +ds: List<&2, Cv.Decl>, +d: Cv.Decl, et: {Maybe.is_some(&2, Cv.Decl, Cv.find(ds, Cv.Decl.id(d))) == t : Bool}, h: {Cv.unique(ds) == True{} : Bool}) -> {Cv.unique(Cv.declare.at(t, g, ds, d)) == True{} : Bool}:
  match t:
    case True{}:
      h
    case False{}:
      match g:
        case True{}:
          pv.unique_snoc(ds, d, h, et)
        case False{}:
          h

def pv.reg_unique(xs: List<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, h: {Cv.unique(ds) == True{} : Bool}) -> {Cv.unique(Cv.registry.go(xs, ds)) == True{} : Bool}:
  match xs:
    case Nil{}:
      h
    case +d <> rest:
      pv.reg_unique(rest, Cv.declare(ds, d), pv.declare_unique(Maybe.is_some(&2, Cv.Decl, Cv.find(ds, Cv.Decl.id(d))), Cv.Decl.typed(d), ds, d, {==}, h))

def pv.all_typed_snoc(ds: List<&2, Cv.Decl>, +d: Cv.Decl, +h: {Cv.all_typed(ds) == True{} : Bool}, g: {Cv.Decl.typed(d) == True{} : Bool}) -> {Cv.all_typed(List.append(&2, Cv.Decl, ds, [d])) == True{} : Bool}:
  match ds:
    case Nil{}:
      %Equal.sym(Bool, Cv.Decl.typed(d), True{}, g) : {Bool.and(_, True{}) == True{} : Bool}
      {==}
    case +x <> +r:
      pv.and_t(Cv.Decl.typed(x), Cv.all_typed(List.append(&2, Cv.Decl, r, [d])), cvar.pv.and_l(Cv.Decl.typed(x), Cv.all_typed(r), h), pv.all_typed_snoc(r, d, cvar.pv.and_r(Cv.Decl.typed(x), Cv.all_typed(r), h), g))

def pv.declare_typed(t: Bool, g: Bool, +ds: List<&2, Cv.Decl>, +d: Cv.Decl, eg: {Cv.Decl.typed(d) == g : Bool}, h: {Cv.all_typed(ds) == True{} : Bool}) -> {Cv.all_typed(Cv.declare.at(t, g, ds, d)) == True{} : Bool}:
  match t:
    case True{}:
      h
    case False{}:
      match g:
        case True{}:
          pv.all_typed_snoc(ds, d, h, eg)
        case False{}:
          h

def pv.reg_typed(xs: List<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, h: {Cv.all_typed(ds) == True{} : Bool}) -> {Cv.all_typed(Cv.registry.go(xs, ds)) == True{} : Bool}:
  match xs:
    case Nil{}:
      h
    case +d <> rest:
      pv.reg_typed(rest, Cv.declare(ds, d), pv.declare_typed(Maybe.is_some(&2, Cv.Decl, Cv.find(ds, Cv.Decl.id(d))), Cv.Decl.typed(d), ds, d, {==}, h))

# the declaration found in a typed list is typed
def pv.find_typed(ds: List<&2, Cv.Decl>, +x: Nat, b: Bool, +d: Cv.Decl, em: {Cv.find.go(ds, x, b) == Some{d} : Maybe<&2, Cv.Decl>}, +at: {Cv.all_typed(ds) == True{} : Bool}) -> {Cv.Decl.typed(d) == True{} : Bool}:
  match ds:
    case Nil{}:
      pv.none_some({Cv.Decl.typed(d) == True{} : Bool}, d, em)
    case +h <> +r:
      match b:
        case True{}:
          %pv.some_inj(h, d, em) : {Cv.Decl.typed(_) == True{} : Bool}
          cvar.pv.and_l(Cv.Decl.typed(h), Cv.all_typed(r), at)
        case False{}:
          pv.find_typed(r, x, Cv.id.at(r, x), d, em, cvar.pv.and_r(Cv.Decl.typed(h), Cv.all_typed(r), at))

def pv.init_ty(d: Cv.Decl, h: {Cv.Decl.typed(d) == True{} : Bool}) -> {Cv.Val.ty(Cv.Decl.init(d)) == Cv.Decl.ty(d) : Cv.Ty}:
  match d:
    case Cv.Decl{i, t, s, p, r, v}:
      pv.ty_true(Cv.Val.ty(v), t, h)

# Layers
# ------

def pv.layer_cons_go(b: Bool, +s: Cv.Bind, +r: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +cur: Maybe<&2, Cv.Val>) -> {Cv.layer.go(s <> r, ds, l, x, cur, b) == Cv.layer(r, ds, l, x, Cv.layer.go([s], ds, l, x, cur, b)) : Maybe<&2, Cv.Val>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# a layer reads its first set, then the rest
def pv.layer_cons(+s: Cv.Bind, +r: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +cur: Maybe<&2, Cv.Val>) -> {Cv.layer(s <> r, ds, l, x, cur) == Cv.layer(r, ds, l, x, Cv.layer([s], ds, l, x, cur)) : Maybe<&2, Cv.Val>}:
  pv.layer_cons_go(Cv.hit.at([s], ds, l, x), s, r, ds, l, x, cur)

# a layer reads its last set on the value of the sets before it
def pv.layer_snoc(ss: List<&2, Cv.Bind>, +s: Cv.Bind, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +cur: Maybe<&2, Cv.Val>) -> {Cv.layer(List.append(&2, Cv.Bind, ss, [s]), ds, l, x, cur) == Cv.layer([s], ds, l, x, Cv.layer(ss, ds, l, x, cur)) : Maybe<&2, Cv.Val>}:
  match ss:
    case Nil{}:
      {==}
    case +h <> +r:
      +c1 = Cv.layer([h], ds, l, x, cur)
      +rs = List.append(&2, Cv.Bind, r, [s])
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(h <> r, ds, l, x, cur), Cv.layer(r, ds, l, x, c1), pv.layer_cons(h, r, ds, l, x, cur)) : {Cv.layer(h <> rs, ds, l, x, cur) == Cv.layer([s], ds, l, x, _) : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(h <> rs, ds, l, x, cur), Cv.layer(rs, ds, l, x, c1), pv.layer_cons(h, rs, ds, l, x, cur)) : {_ == Cv.layer([s], ds, l, x, Cv.layer(r, ds, l, x, c1)) : Maybe<&2, Cv.Val>}
      pv.layer_snoc(r, s, ds, l, x, c1)

def pv.layer_hit(+s: Cv.Bind, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +cur: Maybe<&2, Cv.Val>, h: {Cv.hit.at([s], ds, l, x) == True{} : Bool}) -> {Cv.layer([s], ds, l, x, cur) == Some{Cv.Bind.val(s)} : Maybe<&2, Cv.Val>}:
  %Equal.sym(Bool, Cv.hit.at([s], ds, l, x), True{}, h) : {Cv.layer.go([s], ds, l, x, cur, _) == Some{Cv.Bind.val(s)} : Maybe<&2, Cv.Val>}
  {==}

def pv.layer_miss(+s: Cv.Bind, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +cur: Maybe<&2, Cv.Val>, h: {Cv.hit.at([s], ds, l, x) == False{} : Bool}) -> {Cv.layer([s], ds, l, x, cur) == cur : Maybe<&2, Cv.Val>}:
  %Equal.sym(Bool, Cv.hit.at([s], ds, l, x), False{}, h) : {Cv.layer.go([s], ds, l, x, cur, _) == cur : Maybe<&2, Cv.Val>}
  {==}

# a valid set of x is valid under the declaration found for x
def pv.valid_m(+ds: List<&2, Cv.Decl>, l: Cv.Layer, +s: Cv.Bind, +x: Nat, m: Maybe<&2, Cv.Decl>, em: {Cv.find(ds, x) == m : Maybe<&2, Cv.Decl>}, ex: {Cv.Bind.id(s) == x : Nat}, h: {Cv.valid(ds, l, s) == True{} : Bool}) -> {Cv.valid.at(m, l, s) == True{} : Bool}:
  %em : {Cv.valid.at(_, l, s) == True{} : Bool}
  %ex : {Cv.valid.at(Cv.find(ds, _), l, s) == True{} : Bool}
  h

def pv.valid_ty(l: Cv.Layer, +d: Cv.Decl, +s: Cv.Bind, h: {Cv.valid.at(Some{d}, l, s) == True{} : Bool}) -> {Cv.Ty.eq(Cv.Val.ty(Cv.Bind.val(s)), Cv.Decl.ty(d)) == True{} : Bool}:
  match l:
    case Cv.Config{}:
      h
    case Cv.Agent{}:
      cvar.pv.and_r(Cv.Decl.local(d), Cv.Ty.eq(Cv.Val.ty(Cv.Bind.val(s)), Cv.Decl.ty(d)), h)

# a set that hits x has the type of x's declaration
def pv.hit_ty(+s: Cv.Bind, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +d: Cv.Decl, em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +h: {Cv.hit.at([s], ds, l, x) == True{} : Bool}) -> {Cv.Ty.eq(Cv.Val.ty(Cv.Bind.val(s)), Cv.Decl.ty(d)) == True{} : Bool}:
  +ex = pv.eq_true(Cv.Bind.id(s), x, cvar.pv.and_l(Nat.is_eq(Cv.Bind.id(s), x), Cv.valid(ds, l, s), h))
  +hv = cvar.pv.and_r(Nat.is_eq(Cv.Bind.id(s), x), Cv.valid(ds, l, s), h)
  pv.valid_ty(l, d, s, pv.valid_m(ds, l, s, x, Some{d}, em, ex, hv))

# the value is absent or has type t
def pv.mty(m: Maybe<&2, Cv.Val>, t: Cv.Ty) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{y}:
      Cv.Ty.eq(Cv.Val.ty(y), t)

def pv.step_ty(b: Bool, +s: Cv.Bind, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +d: Cv.Decl, +cur: Maybe<&2, Cv.Val>, em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, eb: {Cv.hit.at([s], ds, l, x) == b : Bool}, hc: {pv.mty(cur, Cv.Decl.ty(d)) == True{} : Bool}) -> {pv.mty(Cv.layer.go([s], ds, l, x, cur, b), Cv.Decl.ty(d)) == True{} : Bool}:
  match b:
    case True{}:
      pv.hit_ty(s, ds, l, x, d, em, eb)
    case False{}:
      hc

# every layer keeps the type of x's declaration
def pv.layer_ty(ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +l: Cv.Layer, +x: Nat, +d: Cv.Decl, +cur: Maybe<&2, Cv.Val>, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, hc: {pv.mty(cur, Cv.Decl.ty(d)) == True{} : Bool}) -> {pv.mty(Cv.layer(ss, ds, l, x, cur), Cv.Decl.ty(d)) == True{} : Bool}:
  match ss:
    case Nil{}:
      hc
    case +s <> +r:
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(s <> r, ds, l, x, cur), Cv.layer(r, ds, l, x, Cv.layer([s], ds, l, x, cur)), pv.layer_cons(s, r, ds, l, x, cur)) : {pv.mty(_, Cv.Decl.ty(d)) == True{} : Bool}
      pv.layer_ty(r, ds, l, x, d, Cv.layer([s], ds, l, x, cur), em, pv.step_ty(Cv.hit.at([s], ds, l, x), s, ds, l, x, d, cur, em, {==}, hc))

def pv.def_ty(m: Maybe<&2, Cv.Val>, +b: Cv.Val, +t: Cv.Ty, hm: {pv.mty(m, t) == True{} : Bool}, hb: {Cv.Val.ty(b) == t : Cv.Ty}) -> {Cv.Val.ty(Maybe.default(&2, Cv.Val, m, b)) == t : Cv.Ty}:
  match m:
    case None{}:
      hb
    case Some{y}:
      pv.ty_true(Cv.Val.ty(y), t, hm)

def pv.over_ty(+ds: List<&2, Cv.Decl>, +a: Cv.Ag, +x: Nat, +d: Cv.Decl, +b: Cv.Val, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, hb: {Cv.Val.ty(b) == Cv.Decl.ty(d) : Cv.Ty}) -> {Cv.Val.ty(Cv.over(ds, a, x, b)) == Cv.Decl.ty(d) : Cv.Ty}:
  +q = Cv.layer(Cv.Ag.profile(a), ds, Cv.Agent{}, x, None{})
  +hq = pv.layer_ty(Cv.Ag.profile(a), ds, Cv.Agent{}, x, d, None{}, em, {==})
  pv.def_ty(Cv.layer(Cv.Ag.sets(a), ds, Cv.Agent{}, x, q), b, Cv.Decl.ty(d), pv.layer_ty(Cv.Ag.sets(a), ds, Cv.Agent{}, x, d, q, em, hq), hb)

def pv.chain_ty(fam: List<&2, Cv.Ag>, +ds: List<&2, Cv.Decl>, +x: Nat, +d: Cv.Decl, +b: Cv.Val, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, hb: {Cv.Val.ty(b) == Cv.Decl.ty(d) : Cv.Ty}) -> {Cv.Val.ty(Cv.chain(fam, ds, x, b)) == Cv.Decl.ty(d) : Cv.Ty}:
  match fam:
    case Nil{}:
      hb
    case +a <> r:
      pv.chain_ty(r, ds, x, d, Cv.over(ds, a, x, b), em, pv.over_ty(ds, a, x, d, b, em, hb))

def pv.vt_m(m: Maybe<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat, +em: {Cv.find(ds, x) == m : Maybe<&2, Cv.Decl>}, at: {Cv.all_typed(ds) == True{} : Bool}) -> {Cv.typed.at(m, Cv.value.at(m, ds, cfg, fam, x)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+d}:
      +r = Cv.root.val(ds, cfg, x, d)
      +hi = pv.init_ty(d, pv.find_typed(ds, x, Cv.id.at(ds, x), d, em, at))
      +hr = pv.def_ty(Cv.layer(cfg, ds, Cv.Config{}, x, None{}), Cv.Decl.init(d), Cv.Decl.ty(d), pv.layer_ty(cfg, ds, Cv.Config{}, x, d, None{}, em, {==}), hi)
      +hc = pv.chain_ty(fam, ds, x, d, r, em, hr)
      %Equal.sym(Cv.Ty, Cv.Val.ty(Cv.chain(fam, ds, x, r)), Cv.Decl.ty(d), hc) : {Cv.Ty.eq(_, Cv.Decl.ty(d)) == True{} : Bool}
      pv.ty_refl(Cv.Decl.ty(d))

# Chains
# ------

def pv.chain_snoc(fam: List<&2, Cv.Ag>, +a: Cv.Ag, +ds: List<&2, Cv.Decl>, +x: Nat, +b: Cv.Val) -> {Cv.chain(List.append(&2, Cv.Ag, fam, [a]), ds, x, b) == Cv.over(ds, a, x, Cv.chain(fam, ds, x, b)) : Cv.Val}:
  match fam:
    case Nil{}:
      {==}
    case +h <> r:
      pv.chain_snoc(r, a, ds, x, Cv.over(ds, h, x, b))

def pv.inh_m(m: Maybe<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat) -> {Cv.value.at(m, ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{Nil{}, Nil{}}]), x) == Cv.value.at(m, ds, cfg, fam, x) : Maybe<&2, Cv.Val>}:
  match m:
    case None{}:
      {==}
    case Some{+d}:
      +r = Cv.root.val(ds, cfg, x, d)
      Equal.cong(Cv.Val, Maybe<&2, Cv.Val>, y => Some{y}, Cv.chain(List.append(&2, Cv.Ag, fam, [Cv.Ag{Nil{}, Nil{}}]), ds, x, r), Cv.chain(fam, ds, x, r), pv.chain_snoc(fam, Cv.Ag{Nil{}, Nil{}}, ds, x, r))

# the set of x to v hits x when it is valid
def pv.hit_self(+ds: List<&2, Cv.Decl>, +x: Nat, +v: Cv.Val, ok: {Cv.valid(ds, Cv.Agent{}, Cv.Bind{x, v}) == True{} : Bool}) -> {Cv.hit.at([Cv.Bind{x, v}], ds, Cv.Agent{}, x) == True{} : Bool}:
  %cvar.pv.eq_refl(x) : {Bool.and(_, Cv.valid(ds, Cv.Agent{}, Cv.Bind{x, v})) == True{} : Bool}
  ok

def pv.sw_m(m: Maybe<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, +v: Cv.Val, em: {Cv.find(ds, x) == m : Maybe<&2, Cv.Decl>}, +ok: {Cv.valid(ds, Cv.Agent{}, Cv.Bind{x, v}) == True{} : Bool}) -> {Cv.value.at(m, ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{p, List.append(&2, Cv.Bind, ss, [Cv.Bind{x, v}])}]), x) == Some{v} : Maybe<&2, Cv.Val>}:
  match m:
    case None{}:
      pv.absurdF({None{} == Some{v} : Maybe<&2, Cv.Val>}, pv.valid_m(ds, Cv.Agent{}, Cv.Bind{x, v}, x, None{}, em, {==}, ok))
    case Some{+d}:
      +r = Cv.root.val(ds, cfg, x, d)
      +ag = {Cv.Ag{p, List.append(&2, Cv.Bind, ss, [Cv.Bind{x, v}])} : Cv.Ag}
      +c = Cv.chain(fam, ds, x, r)
      +lp = Cv.layer(p, ds, Cv.Agent{}, x, None{})
      +q = Cv.layer(ss, ds, Cv.Agent{}, x, lp)
      %Equal.sym(Cv.Val, Cv.chain(List.append(&2, Cv.Ag, fam, [ag]), ds, x, r), Cv.over(ds, ag, x, c), pv.chain_snoc(fam, ag, ds, x, r)) : {Some{_} == Some{v} : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(List.append(&2, Cv.Bind, ss, [Cv.Bind{x, v}]), ds, Cv.Agent{}, x, lp), Cv.layer([Cv.Bind{x, v}], ds, Cv.Agent{}, x, q), pv.layer_snoc(ss, Cv.Bind{x, v}, ds, Cv.Agent{}, x, lp)) : {Some{Maybe.default(&2, Cv.Val, _, c)} == Some{v} : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer([Cv.Bind{x, v}], ds, Cv.Agent{}, x, q), Some{v}, pv.layer_hit(Cv.Bind{x, v}, ds, Cv.Agent{}, x, q, pv.hit_self(ds, x, v, ok))) : {Some{Maybe.default(&2, Cv.Val, _, c)} == Some{v} : Maybe<&2, Cv.Val>}
      {==}

# Global cvars
# ------------

def pv.global_miss(b: Bool, +s: Cv.Bind, +ds: List<&2, Cv.Decl>, +x: Nat, +d: Cv.Decl, eb: {Nat.is_eq(Cv.Bind.id(s), x) == b : Bool}, em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, gl: {Cv.Decl.local(d) == False{} : Bool}) -> {Bool.and(b, Cv.valid(ds, Cv.Agent{}, s)) == False{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, Cv.Bind.id(s), x, pv.eq_true(Cv.Bind.id(s), x, eb)) : {Cv.valid.at(Cv.find(ds, _), Cv.Agent{}, s) == False{} : Bool}
      %Equal.sym(Maybe<&2, Cv.Decl>, Cv.find(ds, x), Some{d}, em) : {Cv.valid.at(_, Cv.Agent{}, s) == False{} : Bool}
      %Equal.sym(Bool, Cv.Decl.local(d), False{}, gl) : {Bool.and(_, Cv.Ty.eq(Cv.Val.ty(Cv.Bind.val(s)), Cv.Decl.ty(d))) == False{} : Bool}
      {==}
    case False{}:
      {==}

# no agent layer changes a Global cvar
def pv.layer_global(ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +x: Nat, +d: Cv.Decl, +cur: Maybe<&2, Cv.Val>, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +gl: {Cv.Decl.local(d) == False{} : Bool}) -> {Cv.layer(ss, ds, Cv.Agent{}, x, cur) == cur : Maybe<&2, Cv.Val>}:
  match ss:
    case Nil{}:
      {==}
    case +s <> +r:
      +c1 = Cv.layer([s], ds, Cv.Agent{}, x, cur)
      +miss = pv.global_miss(Nat.is_eq(Cv.Bind.id(s), x), s, ds, x, d, {==}, em, gl)
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(s <> r, ds, Cv.Agent{}, x, cur), Cv.layer(r, ds, Cv.Agent{}, x, c1), pv.layer_cons(s, r, ds, Cv.Agent{}, x, cur)) : {_ == cur : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, c1, cur, pv.layer_miss(s, ds, Cv.Agent{}, x, cur, miss)) : {Cv.layer(r, ds, Cv.Agent{}, x, _) == cur : Maybe<&2, Cv.Val>}
      pv.layer_global(r, ds, x, d, cur, em, gl)

def pv.over_global(+ds: List<&2, Cv.Decl>, +a: Cv.Ag, +x: Nat, +d: Cv.Decl, +b: Cv.Val, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +gl: {Cv.Decl.local(d) == False{} : Bool}) -> {Cv.over(ds, a, x, b) == b : Cv.Val}:
  +lp = Cv.layer(Cv.Ag.profile(a), ds, Cv.Agent{}, x, None{})
  %Equal.sym(Maybe<&2, Cv.Val>, lp, None{}, pv.layer_global(Cv.Ag.profile(a), ds, x, d, None{}, em, gl)) : {Maybe.default(&2, Cv.Val, Cv.layer(Cv.Ag.sets(a), ds, Cv.Agent{}, x, _), b) == b : Cv.Val}
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(Cv.Ag.sets(a), ds, Cv.Agent{}, x, None{}), None{}, pv.layer_global(Cv.Ag.sets(a), ds, x, d, None{}, em, gl)) : {Maybe.default(&2, Cv.Val, _, b) == b : Cv.Val}
  {==}

def pv.chain_global(fam: List<&2, Cv.Ag>, +ds: List<&2, Cv.Decl>, +x: Nat, +d: Cv.Decl, +b: Cv.Val, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +gl: {Cv.Decl.local(d) == False{} : Bool}) -> {Cv.chain(fam, ds, x, b) == b : Cv.Val}:
  match fam:
    case Nil{}:
      {==}
    case +a <> r:
      Equal.trans(Cv.Val, Cv.chain(r, ds, x, Cv.over(ds, a, x, b)), Cv.over(ds, a, x, b), b, pv.chain_global(r, ds, x, d, Cv.over(ds, a, x, b), em, gl), pv.over_global(ds, a, x, d, b, em, gl))

def pv.gu(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat, +d: Cv.Decl, +found: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +gl: {Cv.Decl.local(d) == False{} : Bool}) -> {Cv.value(ds, cfg, fam, x) == Some{Cv.root.val(ds, cfg, x, d)} : Maybe<&2, Cv.Val>}:
  +r = Cv.root.val(ds, cfg, x, d)
  %Equal.sym(Maybe<&2, Cv.Decl>, Cv.find(ds, x), Some{d}, found) : {Cv.value.at(_, ds, cfg, fam, x) == Some{r} : Maybe<&2, Cv.Val>}
  Equal.cong(Cv.Val, Maybe<&2, Cv.Val>, y => Some{y}, Cv.chain(fam, ds, x, r), r, pv.chain_global(fam, ds, x, d, r, found, gl))

# Written sets
# ------------

def pv.wf(ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +f: Cv.Flag, hit: Bool, eh: {Cv.out.at(ss, ds, f) == hit : Bool}) -> {Cv.all_flag(Cv.written.go(ss, ds, f, hit), ds, f) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case +s <> +rest:
      match hit:
        case True{}:
          +w = Cv.written.go(rest, ds, f, Cv.out.at(rest, ds, f))
          +fl = Cv.flag.at(Cv.find(ds, Cv.Bind.id(s)), f)
          pv.and_t(fl, Cv.all_flag(w, ds, f), cvar.pv.and_l(fl, Cv.valid(ds, Cv.Agent{}, s), eh), pv.wf(rest, ds, f, Cv.out.at(rest, ds, f), {==}))
        case False{}:
          pv.wf(rest, ds, f, Cv.out.at(rest, ds, f), {==})

def pv.wf_top(+ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +f: Cv.Flag) -> {Cv.all_flag(Cv.written(ss, ds, f), ds, f) == True{} : Bool}:
  pv.wf(ss, ds, f, Cv.out.at(ss, ds, f), {==})

# a set that hits a persisted cvar is written
def pv.out_hit(+s: Cv.Bind, +ds: List<&2, Cv.Decl>, +x: Nat, keeps: {Cv.flag.at(Cv.find(ds, x), Cv.Persist{}) == True{} : Bool}, +h: {Cv.hit.at([s], ds, Cv.Agent{}, x) == True{} : Bool}) -> {Cv.out.at([s], ds, Cv.Persist{}) == True{} : Bool}:
  +ex = pv.eq_true(Cv.Bind.id(s), x, cvar.pv.and_l(Nat.is_eq(Cv.Bind.id(s), x), Cv.valid(ds, Cv.Agent{}, s), h))
  +hv = cvar.pv.and_r(Nat.is_eq(Cv.Bind.id(s), x), Cv.valid(ds, Cv.Agent{}, s), h)
  %Equal.sym(Nat, Cv.Bind.id(s), x, ex) : {Bool.and(Cv.flag.at(Cv.find(ds, _), Cv.Persist{}), Cv.valid(ds, Cv.Agent{}, s)) == True{} : Bool}
  pv.and_t(Cv.flag.at(Cv.find(ds, x), Cv.Persist{}), Cv.valid(ds, Cv.Agent{}, s), keeps, hv)

# a set that is not written misses a persisted cvar
def pv.out_miss(b: Bool, +s: Cv.Bind, +ds: List<&2, Cv.Decl>, +x: Nat, keeps: {Cv.flag.at(Cv.find(ds, x), Cv.Persist{}) == True{} : Bool}, eb: {Cv.hit.at([s], ds, Cv.Agent{}, x) == b : Bool}, ho: {Cv.out.at([s], ds, Cv.Persist{}) == False{} : Bool}) -> {Cv.hit.at([s], ds, Cv.Agent{}, x) == False{} : Bool}:
  match b:
    case True{}:
      cvar.pv.absurd({Cv.hit.at([s], ds, Cv.Agent{}, x) == False{} : Bool}, Equal.trans(Bool, True{}, Cv.out.at([s], ds, Cv.Persist{}), False{}, Equal.sym(Bool, Cv.out.at([s], ds, Cv.Persist{}), True{}, pv.out_hit(s, ds, x, keeps, eb)), ho))
    case False{}:
      eb

# the written sets give every persisted cvar the value of all sets
def pv.persist_go(ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +x: Nat, +keeps: {Cv.flag.at(Cv.find(ds, x), Cv.Persist{}) == True{} : Bool}, +cur: Maybe<&2, Cv.Val>, ho: Bool, eho: {Cv.out.at(ss, ds, Cv.Persist{}) == ho : Bool}) -> {Cv.layer(Cv.written.go(ss, ds, Cv.Persist{}, ho), ds, Cv.Agent{}, x, cur) == Cv.layer(ss, ds, Cv.Agent{}, x, cur) : Maybe<&2, Cv.Val>}:
  match ss:
    case Nil{}:
      {==}
    case +s <> +rest:
      match ho:
        case True{}:
          +w = Cv.written.go(rest, ds, Cv.Persist{}, Cv.out.at(rest, ds, Cv.Persist{}))
          +c1 = Cv.layer([s], ds, Cv.Agent{}, x, cur)
          %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(s <> rest, ds, Cv.Agent{}, x, cur), Cv.layer(rest, ds, Cv.Agent{}, x, c1), pv.layer_cons(s, rest, ds, Cv.Agent{}, x, cur)) : {Cv.layer(s <> w, ds, Cv.Agent{}, x, cur) == _ : Maybe<&2, Cv.Val>}
          %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(s <> w, ds, Cv.Agent{}, x, cur), Cv.layer(w, ds, Cv.Agent{}, x, c1), pv.layer_cons(s, w, ds, Cv.Agent{}, x, cur)) : {_ == Cv.layer(rest, ds, Cv.Agent{}, x, c1) : Maybe<&2, Cv.Val>}
          pv.persist_go(rest, ds, x, keeps, c1, Cv.out.at(rest, ds, Cv.Persist{}), {==})
        case False{}:
          +w = Cv.written.go(rest, ds, Cv.Persist{}, Cv.out.at(rest, ds, Cv.Persist{}))
          +c1 = Cv.layer([s], ds, Cv.Agent{}, x, cur)
          +miss = pv.out_miss(Cv.hit.at([s], ds, Cv.Agent{}, x), s, ds, x, keeps, {==}, eho)
          %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(s <> rest, ds, Cv.Agent{}, x, cur), Cv.layer(rest, ds, Cv.Agent{}, x, c1), pv.layer_cons(s, rest, ds, Cv.Agent{}, x, cur)) : {Cv.layer(w, ds, Cv.Agent{}, x, cur) == _ : Maybe<&2, Cv.Val>}
          %Equal.sym(Maybe<&2, Cv.Val>, c1, cur, pv.layer_miss(s, ds, Cv.Agent{}, x, cur, miss)) : {Cv.layer(w, ds, Cv.Agent{}, x, cur) == Cv.layer(rest, ds, Cv.Agent{}, x, _) : Maybe<&2, Cv.Val>}
          pv.persist_go(rest, ds, x, keeps, cur, Cv.out.at(rest, ds, Cv.Persist{}), {==})

def pv.pr_m(m: Maybe<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, keeps: {Cv.flag.at(Cv.find(ds, x), Cv.Persist{}) == True{} : Bool}) -> {Cv.value.at(m, ds, cfg, [Cv.Ag{Cv.written(ss, ds, Cv.Persist{}), Nil{}}], x) == Cv.value.at(m, ds, cfg, [Cv.Ag{Nil{}, ss}], x) : Maybe<&2, Cv.Val>}:
  match m:
    case None{}:
      {==}
    case Some{+d}:
      +r = Cv.root.val(ds, cfg, x, d)
      Equal.cong(Maybe<&2, Cv.Val>, Maybe<&2, Cv.Val>, z => Some{Maybe.default(&2, Cv.Val, z, r)}, Cv.layer(Cv.written(ss, ds, Cv.Persist{}), ds, Cv.Agent{}, x, None{}), Cv.layer(ss, ds, Cv.Agent{}, x, None{}), pv.persist_go(ss, ds, x, keeps, None{}, Cv.out.at(ss, ds, Cv.Persist{}), {==}))

# Toggle
# ------

def pv.G_some(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +a: Cv.Ag, +x: Nat, +d: Cv.Decl, em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) == Some{Cv.over(ds, a, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d)))} : Maybe<&2, Cv.Val>}:
  +r = Cv.root.val(ds, cfg, x, d)
  %Equal.sym(Maybe<&2, Cv.Decl>, Cv.find(ds, x), Some{d}, em) : {Cv.value.at(_, ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) == Some{Cv.over(ds, a, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d)))} : Maybe<&2, Cv.Val>}
  Equal.cong(Cv.Val, Maybe<&2, Cv.Val>, y => Some{y}, Cv.chain(List.append(&2, Cv.Ag, fam, [a]), ds, x, r), Cv.over(ds, a, x, Cv.chain(fam, ds, x, r)), pv.chain_snoc(fam, a, ds, x, r))

def pv.T_eq(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +a: Cv.Ag, +x: Nat, +d: Cv.Decl, em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +y: Cv.Val, ey: {Cv.over(ds, a, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))) == y : Cv.Val}) -> {Cv.toggle(ds, cfg, fam, a, x) == Cv.add(a, Cv.flip(x, Some{y})) : Cv.Ag}:
  +o = Cv.over(ds, a, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d)))
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x), Some{o}, pv.G_some(ds, cfg, fam, a, x, d, em)) : {Cv.add(a, Cv.flip(x, _)) == Cv.add(a, Cv.flip(x, Some{y})) : Cv.Ag}
  %Equal.sym(Cv.Val, o, y, ey) : {Cv.add(a, Cv.flip(x, Some{_})) == Cv.add(a, Cv.flip(x, Some{y})) : Cv.Ag}
  {==}

def pv.O_snoc_miss(+ds: List<&2, Cv.Decl>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +s: Cv.Bind, +x: Nat, +r: Cv.Val, h: {Cv.hit.at([s], ds, Cv.Agent{}, x) == False{} : Bool}) -> {Cv.over(ds, Cv.Ag{p, List.append(&2, Cv.Bind, ss, [s])}, x, r) == Cv.over(ds, Cv.Ag{p, ss}, x, r) : Cv.Val}:
  +q = Cv.layer(p, ds, Cv.Agent{}, x, None{})
  +c = Cv.layer(ss, ds, Cv.Agent{}, x, q)
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(List.append(&2, Cv.Bind, ss, [s]), ds, Cv.Agent{}, x, q), Cv.layer([s], ds, Cv.Agent{}, x, c), pv.layer_snoc(ss, s, ds, Cv.Agent{}, x, q)) : {Maybe.default(&2, Cv.Val, _, r) == Cv.over(ds, Cv.Ag{p, ss}, x, r) : Cv.Val}
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer([s], ds, Cv.Agent{}, x, c), c, pv.layer_miss(s, ds, Cv.Agent{}, x, c, h)) : {Maybe.default(&2, Cv.Val, _, r) == Cv.over(ds, Cv.Ag{p, ss}, x, r) : Cv.Val}
  {==}

def pv.O_snoc_hit(+ds: List<&2, Cv.Decl>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +s: Cv.Bind, +x: Nat, +r: Cv.Val, h: {Cv.hit.at([s], ds, Cv.Agent{}, x) == True{} : Bool}) -> {Cv.over(ds, Cv.Ag{p, List.append(&2, Cv.Bind, ss, [s])}, x, r) == Cv.Bind.val(s) : Cv.Val}:
  +q = Cv.layer(p, ds, Cv.Agent{}, x, None{})
  +c = Cv.layer(ss, ds, Cv.Agent{}, x, q)
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer(List.append(&2, Cv.Bind, ss, [s]), ds, Cv.Agent{}, x, q), Cv.layer([s], ds, Cv.Agent{}, x, c), pv.layer_snoc(ss, s, ds, Cv.Agent{}, x, q)) : {Maybe.default(&2, Cv.Val, _, r) == Cv.Bind.val(s) : Cv.Val}
  %Equal.sym(Maybe<&2, Cv.Val>, Cv.layer([s], ds, Cv.Agent{}, x, c), Some{Cv.Bind.val(s)}, pv.layer_hit(s, ds, Cv.Agent{}, x, c, h)) : {Maybe.default(&2, Cv.Val, _, r) == Cv.Bind.val(s) : Cv.Val}
  {==}

# a Bool set of x is valid whatever its Bool
def pv.vb_at(m: Maybe<&2, Cv.Decl>, +x: Nat, +c1: Bool, +c2: Bool) -> {Cv.valid.at(m, Cv.Agent{}, Cv.Bind{x, Cv.VBool{c1}}) == Cv.valid.at(m, Cv.Agent{}, Cv.Bind{x, Cv.VBool{c2}}) : Bool}:
  match m:
    case None{}:
      {==}
    case Some{d}:
      {==}

def pv.vb_hit(+ds: List<&2, Cv.Decl>, +x: Nat, +c1: Bool, +c2: Bool) -> {Cv.hit.at([Cv.Bind{x, Cv.VBool{c1}}], ds, Cv.Agent{}, x) == Cv.hit.at([Cv.Bind{x, Cv.VBool{c2}}], ds, Cv.Agent{}, x) : Bool}:
  Equal.cong(Bool, Bool, z => Bool.and(Nat.is_eq(x, x), z), Cv.valid.at(Cv.find(ds, x), Cv.Agent{}, Cv.Bind{x, Cv.VBool{c1}}), Cv.valid.at(Cv.find(ds, x), Cv.Agent{}, Cv.Bind{x, Cv.VBool{c2}}), pv.vb_at(Cv.find(ds, x), x, c1, c2))

# the second toggle of a Bool cvar, after the first hit or missed
def pv.tog_b(w: Bool, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, +d: Cv.Decl, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +b: Bool, +ew: {Cv.hit.at([Cv.Bind{x, Cv.VBool{Bool.not(b)}}], ds, Cv.Agent{}, x) == w : Bool}, +ey: {Cv.over(ds, Cv.Ag{p, ss}, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))) == Cv.VBool{b} : Cv.Val}) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, Cv.Ag{p, List.append(&2, Cv.Bind, ss, [Cv.Bind{x, Cv.VBool{Bool.not(b)}}])}, x)]), x) == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}:
  match w:
    case True{}:
      +r = Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))
      +b1 = {Cv.Bind{x, Cv.VBool{Bool.not(b)}} : Cv.Bind}
      +b2 = {Cv.Bind{x, Cv.VBool{Bool.not(Bool.not(b))}} : Cv.Bind}
      +s1 = List.append(&2, Cv.Bind, ss, [b1])
      +a1 = {Cv.Ag{p, s1} : Cv.Ag}
      +a2 = {Cv.Ag{p, List.append(&2, Cv.Bind, s1, [b2])} : Cv.Ag}
      +e2 = pv.T_eq(ds, cfg, fam, a1, x, d, em, Cv.VBool{Bool.not(b)}, pv.O_snoc_hit(ds, p, ss, b1, x, r, ew))
      +h2 = Equal.trans(Bool, Cv.hit.at([b2], ds, Cv.Agent{}, x), Cv.hit.at([b1], ds, Cv.Agent{}, x), True{}, pv.vb_hit(ds, x, Bool.not(Bool.not(b)), Bool.not(b)), ew)
      %Equal.sym(Cv.Ag, Cv.toggle(ds, cfg, fam, a1, x), a2, e2) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [_]), x) == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a2]), x), Some{Cv.over(ds, a2, x, r)}, pv.G_some(ds, cfg, fam, a2, x, d, em)) : {_ == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      %Equal.sym(Cv.Val, Cv.over(ds, a2, x, r), Cv.Bind.val(b2), pv.O_snoc_hit(ds, p, s1, b2, x, r, h2)) : {Some{_} == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      %Equal.sym(Bool, Bool.not(Bool.not(b)), b, pv.not_not(b)) : {Some{Cv.VBool{_}} == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      {==}
    case False{}:
      +r = Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))
      +b1 = {Cv.Bind{x, Cv.VBool{Bool.not(b)}} : Cv.Bind}
      +s1 = List.append(&2, Cv.Bind, ss, [b1])
      +a1 = {Cv.Ag{p, s1} : Cv.Ag}
      +a2 = {Cv.Ag{p, List.append(&2, Cv.Bind, s1, [b1])} : Cv.Ag}
      +o1 = Equal.trans(Cv.Val, Cv.over(ds, a1, x, r), Cv.over(ds, Cv.Ag{p, ss}, x, r), Cv.VBool{b}, pv.O_snoc_miss(ds, p, ss, b1, x, r, ew), ey)
      +e2 = pv.T_eq(ds, cfg, fam, a1, x, d, em, Cv.VBool{b}, o1)
      +o2 = Equal.trans(Cv.Val, Cv.over(ds, a2, x, r), Cv.over(ds, a1, x, r), Cv.VBool{b}, pv.O_snoc_miss(ds, p, s1, b1, x, r, ew), o1)
      %Equal.sym(Cv.Ag, Cv.toggle(ds, cfg, fam, a1, x), a2, e2) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [_]), x) == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a2]), x), Some{Cv.over(ds, a2, x, r)}, pv.G_some(ds, cfg, fam, a2, x, d, em)) : {_ == Some{Cv.VBool{b}} : Maybe<&2, Cv.Val>}
      Equal.cong(Cv.Val, Maybe<&2, Cv.Val>, y => Some{y}, Cv.over(ds, a2, x, r), Cv.VBool{b}, o2)

# two toggles of a declared cvar, by the type of its value
def pv.tog_y(y: Cv.Val, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, +d: Cv.Decl, +em: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, +ey: {Cv.over(ds, Cv.Ag{p, ss}, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))) == y : Cv.Val}) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, Cv.toggle(ds, cfg, fam, Cv.Ag{p, ss}, x), x)]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{p, ss}]), x) : Maybe<&2, Cv.Val>}:
  match y:
    case Cv.VNat{+n}:
      +a = {Cv.Ag{p, ss} : Cv.Ag}
      +e1 = pv.T_eq(ds, cfg, fam, a, x, d, em, Cv.VNat{n}, ey)
      %Equal.sym(Cv.Ag, Cv.toggle(ds, cfg, fam, a, x), a, e1) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, _, x)]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) : Maybe<&2, Cv.Val>}
      %Equal.sym(Cv.Ag, Cv.toggle(ds, cfg, fam, a, x), a, e1) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [_]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) : Maybe<&2, Cv.Val>}
      {==}
    case Cv.VBool{+b}:
      +a = {Cv.Ag{p, ss} : Cv.Ag}
      +r = Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))
      +a1 = {Cv.Ag{p, List.append(&2, Cv.Bind, ss, [Cv.Bind{x, Cv.VBool{Bool.not(b)}}])} : Cv.Ag}
      +e1 = pv.T_eq(ds, cfg, fam, a, x, d, em, Cv.VBool{b}, ey)
      %Equal.sym(Cv.Ag, Cv.toggle(ds, cfg, fam, a, x), a1, e1) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, _, x)]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) : Maybe<&2, Cv.Val>}
      %Equal.sym(Maybe<&2, Cv.Val>, Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x), Some{Cv.over(ds, a, x, r)}, pv.G_some(ds, cfg, fam, a, x, d, em)) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, a1, x)]), x) == _ : Maybe<&2, Cv.Val>}
      %Equal.sym(Cv.Val, Cv.over(ds, a, x, r), Cv.VBool{b}, ey) : {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, a1, x)]), x) == Some{_} : Maybe<&2, Cv.Val>}
      pv.tog_b(Cv.hit.at([Cv.Bind{x, Cv.VBool{Bool.not(b)}}], ds, Cv.Agent{}, x), ds, cfg, fam, p, ss, x, d, em, b, {==}, ey)

def pv.tog_m(m: Maybe<&2, Cv.Decl>, +ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, +em: {Cv.find(ds, x) == m : Maybe<&2, Cv.Decl>}) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, Cv.toggle(ds, cfg, fam, Cv.Ag{p, ss}, x), x)]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{p, ss}]), x) : Maybe<&2, Cv.Val>}:
  match m:
    case None{}:
      %Equal.sym(Maybe<&2, Cv.Decl>, Cv.find(ds, x), None{}, em) : {Cv.value.at(_, ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, Cv.toggle(ds, cfg, fam, Cv.Ag{p, ss}, x), x)]), x) == Cv.value.at(_, ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{p, ss}]), x) : Maybe<&2, Cv.Val>}
      {==}
    case Some{+d}:
      pv.tog_y(Cv.over(ds, Cv.Ag{p, ss}, x, Cv.chain(fam, ds, x, Cv.root.val(ds, cfg, x, d))), ds, cfg, fam, p, ss, x, d, em, {==})

# Aliases
# -------

def pv.plain_app(xs: List<&2, Cv.Cmd>, +ys: List<&2, Cv.Cmd>, hx: {Cv.plain(xs) == True{} : Bool}, hy: {Cv.plain(ys) == True{} : Bool}) -> {Cv.plain(List.append(&2, Cv.Cmd, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hy
    case c <> rest:
      match c:
        case Cv.CSet{i, v}:
          pv.plain_app(rest, ys, hx, hy)
        case Cv.CToggle{i}:
          pv.plain_app(rest, ys, hx, hy)
        case Cv.CRun{n}:
          hx
        case Cv.CGone{n}:
          hx

def pv.plain_cat(a: Cv.Exp, b: Cv.Exp, ha: {Cv.Exp.plain(a) == True{} : Bool}, hb: {Cv.Exp.plain(b) == True{} : Bool}) -> {Cv.Exp.plain(Cv.cat(a, b)) == True{} : Bool}:
  match a:
    case Cv.Flat{x}:
      match b:
        case Cv.Flat{y}:
          pv.plain_app(x, y, ha, hb)
        case Cv.Cycle{}:
          {==}
        case Cv.Unknown{}:
          {==}
    case Cv.Cycle{}:
      {==}
    case Cv.Unknown{}:
      {==}

def pv.ex_plain(d: Nat, cs: List<&2, Cv.Cmd>, +as: List<&2, Cv.Alias>) -> {Cv.Exp.plain(Cv.expand.go(d, cs, as)) == True{} : Bool}:
  match d:
    case 0n:
      match cs:
        case Nil{}:
          {==}
        case c <> +rest:
          match c:
            case Cv.CSet{i, v}:
              pv.plain_cat(Cv.Flat{[Cv.CSet{i, v}]}, Cv.expand.go(0n, rest, as), {==}, pv.ex_plain(0n, rest, as))
            case Cv.CToggle{i}:
              pv.plain_cat(Cv.Flat{[Cv.CToggle{i}]}, Cv.expand.go(0n, rest, as), {==}, pv.ex_plain(0n, rest, as))
            case Cv.CRun{n}:
              {==}
            case Cv.CGone{n}:
              {==}
    case 1n+(+e):
      match cs:
        case Nil{}:
          {==}
        case c <> +rest:
          match c:
            case Cv.CSet{i, v}:
              pv.plain_cat(Cv.Flat{[Cv.CSet{i, v}]}, Cv.expand.go(1n+e, rest, as), {==}, pv.ex_plain(1n+e, rest, as))
            case Cv.CToggle{i}:
              pv.plain_cat(Cv.Flat{[Cv.CToggle{i}]}, Cv.expand.go(1n+e, rest, as), {==}, pv.ex_plain(1n+e, rest, as))
            case Cv.CRun{+n}:
              pv.plain_cat(Cv.expand.go(e, Cv.body(as, n), as), Cv.expand.go(1n+e, rest, as), pv.ex_plain(e, Cv.body(as, n), as), pv.ex_plain(1n+e, rest, as))
            case Cv.CGone{n}:
              {==}

def pv.body_head(+n: Nat, +b: List<&2, Cv.Cmd>, +as: List<&2, Cv.Alias>) -> {Cv.body(Cv.Alias{n, b} <> as, n) == b : List<&2, Cv.Cmd>}:
  %cvar.pv.eq_refl(n) : {Cv.body.go(Cv.Alias{n, b} <> as, n, _) == b : List<&2, Cv.Cmd>}
  {==}

def pv.self(k: Nat, +n: Nat, +as: List<&2, Cv.Alias>) -> {Cv.expand.go(k, [Cv.CRun{n}], Cv.Alias{n, [Cv.CRun{n}]} <> as) == Cv.Cycle{} : Cv.Exp}:
  match k:
    case 0n:
      {==}
    case 1n+e:
      +t = {Cv.Alias{n, [Cv.CRun{n}]} <> as : List<&2, Cv.Alias>}
      %Equal.sym(List<&2, Cv.Cmd>, Cv.body(t, n), [Cv.CRun{n}], pv.body_head(n, [Cv.CRun{n}], as)) : {Cv.cat(Cv.expand.go(e, _, t), Cv.Flat{Nil{}}) == Cv.Cycle{} : Cv.Exp}
      %Equal.sym(Cv.Exp, Cv.expand.go(e, [Cv.CRun{n}], t), Cv.Cycle{}, pv.self(e, n, as)) : {Cv.cat(_, Cv.Flat{Nil{}}) == Cv.Cycle{} : Cv.Exp}
      {==}

def pv.gone(k: Nat, +n: Nat, +as: List<&2, Cv.Alias>) -> {Cv.cat(Cv.expand.go(k, [Cv.CGone{n}], as), Cv.Flat{Nil{}}) == Cv.Unknown{} : Cv.Exp}:
  match k:
    case 0n:
      {==}
    case 1n+e:
      {==}

# a plain list expands to itself at any depth
def pv.flat(b: List<&2, Cv.Cmd>, k: Nat, +as: List<&2, Cv.Alias>, h: {Cv.plain(b) == True{} : Bool}) -> {Cv.expand.go(k, b, as) == Cv.Flat{b} : Cv.Exp}:
  match b:
    case Nil{}:
      match k:
        case 0n:
          {==}
        case 1n+e:
          {==}
    case c <> +rest:
      match c:
        case Cv.CSet{+i, +v}:
          match k:
            case 0n:
              %Equal.sym(Cv.Exp, Cv.expand.go(0n, rest, as), Cv.Flat{rest}, pv.flat(rest, 0n, as, h)) : {Cv.cat(Cv.Flat{[Cv.CSet{i, v}]}, _) == Cv.Flat{Cv.CSet{i, v} <> rest} : Cv.Exp}
              {==}
            case 1n+(+e):
              %Equal.sym(Cv.Exp, Cv.expand.go(1n+e, rest, as), Cv.Flat{rest}, pv.flat(rest, 1n+e, as, h)) : {Cv.cat(Cv.Flat{[Cv.CSet{i, v}]}, _) == Cv.Flat{Cv.CSet{i, v} <> rest} : Cv.Exp}
              {==}
        case Cv.CToggle{+i}:
          match k:
            case 0n:
              %Equal.sym(Cv.Exp, Cv.expand.go(0n, rest, as), Cv.Flat{rest}, pv.flat(rest, 0n, as, h)) : {Cv.cat(Cv.Flat{[Cv.CToggle{i}]}, _) == Cv.Flat{Cv.CToggle{i} <> rest} : Cv.Exp}
              {==}
            case 1n+(+e):
              %Equal.sym(Cv.Exp, Cv.expand.go(1n+e, rest, as), Cv.Flat{rest}, pv.flat(rest, 1n+e, as, h)) : {Cv.cat(Cv.Flat{[Cv.CToggle{i}]}, _) == Cv.Flat{Cv.CToggle{i} <> rest} : Cv.Exp}
              {==}
        case Cv.CRun{n}:
          pv.absurdF({Cv.expand.go(k, Cv.CRun{n} <> rest, as) == Cv.Flat{Cv.CRun{n} <> rest} : Cv.Exp}, h)
        case Cv.CGone{n}:
          pv.absurdF({Cv.expand.go(k, Cv.CGone{n} <> rest, as) == Cv.Flat{Cv.CGone{n} <> rest} : Cv.Exp}, h)

# The laws
# --------

def pv.cvar_registry_unique(xs: List<&2, Cv.Decl>) -> {Cv.unique(Cv.registry(xs)) == True{} : Bool}:
  pv.reg_unique(xs, Nil{}, {==})

def pv.cvar_registry_typed(xs: List<&2, Cv.Decl>) -> {Cv.all_typed(Cv.registry(xs)) == True{} : Bool}:
  pv.reg_typed(xs, Nil{}, {==})

def pv.cvar_value_typed(+xs: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat) -> {Cv.typed.at(Cv.find(Cv.registry(xs), x), Cv.value(Cv.registry(xs), cfg, fam, x)) == True{} : Bool}:
  pv.vt_m(Cv.find(Cv.registry(xs), x), Cv.registry(xs), cfg, fam, x, {==}, pv.cvar_registry_typed(xs))

def pv.cvar_inherits(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{Nil{}, Nil{}}]), x) == Cv.value(ds, cfg, fam, x) : Maybe<&2, Cv.Val>}:
  pv.inh_m(Cv.find(ds, x), ds, cfg, fam, x)

def pv.cvar_set_wins(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +p: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, +v: Cv.Val, ok: {Cv.valid(ds, Cv.Agent{}, Cv.Bind{x, v}) == True{} : Bool}) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.Ag{p, List.append(&2, Cv.Bind, ss, [Cv.Bind{x, v}])}]), x) == Some{v} : Maybe<&2, Cv.Val>}:
  pv.sw_m(Cv.find(ds, x), ds, cfg, fam, p, ss, x, v, {==}, ok)

def pv.cvar_global_uniform(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +x: Nat, +d: Cv.Decl, found: {Cv.find(ds, x) == Some{d} : Maybe<&2, Cv.Decl>}, global: {Cv.Decl.local(d) == False{} : Bool}) -> {Cv.value(ds, cfg, fam, x) == Some{Cv.root.val(ds, cfg, x, d)} : Maybe<&2, Cv.Val>}:
  pv.gu(ds, cfg, fam, x, d, found, global)

def pv.cvar_written_flagged(ss: List<&2, Cv.Bind>, +ds: List<&2, Cv.Decl>, +f: Cv.Flag) -> {Cv.all_flag(Cv.written(ss, ds, f), ds, f) == True{} : Bool}:
  pv.wf_top(ss, ds, f)

def pv.cvar_persist_roundtrip(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +ss: List<&2, Cv.Bind>, +x: Nat, keeps: {Cv.flag.at(Cv.find(ds, x), Cv.Persist{}) == True{} : Bool}) -> {Cv.value(ds, cfg, [Cv.Ag{Cv.written(ss, ds, Cv.Persist{}), Nil{}}], x) == Cv.value(ds, cfg, [Cv.Ag{Nil{}, ss}], x) : Maybe<&2, Cv.Val>}:
  pv.pr_m(Cv.find(ds, x), ds, cfg, ss, x, keeps)

def pv.cvar_toggle_twice(+ds: List<&2, Cv.Decl>, +cfg: List<&2, Cv.Bind>, +fam: List<&2, Cv.Ag>, +a: Cv.Ag, +x: Nat) -> {Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [Cv.toggle(ds, cfg, fam, Cv.toggle(ds, cfg, fam, a, x), x)]), x) == Cv.value(ds, cfg, List.append(&2, Cv.Ag, fam, [a]), x) : Maybe<&2, Cv.Val>}:
  match a:
    case Cv.Ag{p, ss}:
      pv.tog_m(Cv.find(ds, x), ds, cfg, fam, p, ss, x, {==})

def pv.alias_expands_fully(cs: List<&2, Cv.Cmd>, +as: List<&2, Cv.Alias>) -> {Cv.Exp.plain(Cv.expand(cs, as)) == True{} : Bool}:
  pv.ex_plain(1n+List.length(&2, Cv.Alias, as), cs, as)

def pv.alias_self_cycle(+n: Nat, +as: List<&2, Cv.Alias>) -> {Cv.expand([Cv.CRun{n}], Cv.Alias{n, [Cv.CRun{n}]} <> as) == Cv.Cycle{} : Cv.Exp}:
  pv.self(1n+List.length(&2, Cv.Alias, Cv.Alias{n, [Cv.CRun{n}]} <> as), n, as)

def pv.alias_unknown_reported(+n: Nat, +as: List<&2, Cv.Alias>, gone: {Cv.body(as, n) == [Cv.CGone{n}] : List<&2, Cv.Cmd>}) -> {Cv.expand([Cv.CRun{n}], as) == Cv.Unknown{} : Cv.Exp}:
  %Equal.sym(List<&2, Cv.Cmd>, Cv.body(as, n), [Cv.CGone{n}], gone) : {Cv.cat(Cv.expand.go(List.length(&2, Cv.Alias, as), _, as), Cv.Flat{Nil{}}) == Cv.Unknown{} : Cv.Exp}
  pv.gone(List.length(&2, Cv.Alias, as), n, as)

def pv.alias_runs_body(+n: Nat, +b: List<&2, Cv.Cmd>, +as: List<&2, Cv.Alias>, flat: {Cv.plain(b) == True{} : Bool}) -> {Cv.expand([Cv.CRun{n}], Cv.Alias{n, b} <> as) == Cv.Flat{b} : Cv.Exp}:
  +t = {Cv.Alias{n, b} <> as : List<&2, Cv.Alias>}
  +k = List.length(&2, Cv.Alias, t)
  %Equal.sym(List<&2, Cv.Cmd>, Cv.body(t, n), b, pv.body_head(n, b, as)) : {Cv.cat(Cv.expand.go(k, _, t), Cv.Flat{Nil{}}) == Cv.Flat{b} : Cv.Exp}
  %Equal.sym(Cv.Exp, Cv.expand.go(k, b, t), Cv.Flat{b}, pv.flat(b, k, t, flat)) : {Cv.cat(_, Cv.Flat{Nil{}}) == Cv.Flat{b} : Cv.Exp}
  Equal.cong(List<&2, Cv.Cmd>, Cv.Exp, z => Cv.Flat{z}, List.append(&2, Cv.Cmd, b, Nil{}), b, pv.app_nil(b))

def pv.bind_press_plain(+bs: List<&2, Cv.KeyBind>, +k: Nat, +as: List<&2, Cv.Alias>) -> {Cv.Exp.plain(Cv.press(bs, k, as)) == True{} : Bool}:
  pv.ex_plain(1n+List.length(&2, Cv.Alias, as), Cv.bound(bs, k), as)

def pv.bind_unbound_runs_nothing(+bs: List<&2, Cv.KeyBind>, +k: Nat, +as: List<&2, Cv.Alias>, free: {Cv.bound(bs, k) == Nil{} : List<&2, Cv.Cmd>}) -> {Cv.press(bs, k, as) == Cv.Flat{Nil{}} : Cv.Exp}:
  %Equal.sym(List<&2, Cv.Cmd>, Cv.bound(bs, k), Nil{}, free) : {Cv.expand(_, as) == Cv.Flat{Nil{}} : Cv.Exp}
  {==}

def pv.bind_first_wins(+k: Nat, +c: List<&2, Cv.Cmd>, +rest: List<&2, Cv.KeyBind>, +as: List<&2, Cv.Alias>) -> {Cv.press(Cv.KeyBind{k, c} <> rest, k, as) == Cv.expand(c, as) : Cv.Exp}:
  %cvar.pv.eq_refl(k) : {Cv.expand(Cv.bound.go(Cv.KeyBind{k, c} <> rest, k, _), as) == Cv.expand(c, as) : Cv.Exp}
  {==}

# ---- director ----

# proof_director: the Director stack laws (S5), about bend/director.bend.
#
# The bound: a decision under `above` layers keeps above + len(stack) at
# most cap (`pd.go_bounded`). A layer that keeps its place keeps the
# length; a deferring layer goes back on the stack of the layers below
# (`pd.under_ok`), which is bounded under one more layer; a Leave drops
# it (`pd.le_pred`); a Stack checks room in the whole stack (`pd.push_ok`).
# Each loop step is one decision (`pd.tick_bounded`).
#
# The loop: `pd.ok(l, k)` says the loop has ended, or has fewer than k
# global steps left. A tick takes one step off (`pd.tick_ok`), so after k
# steps the loop has ended (`pd.ends_go`). An ended loop never changes.
#
# The tree: layer i of a stack (0 = bottom) is the nodes 2i + 1 and
# 2i + 2, appended after the nodes of the layers below. So every key of
# encode(s) is at most 2 len(s) (`pd.enc_lt`), the nodes stay sorted
# (`pd.enc_sorted`), and each kind node hangs under the root or the kind
# node of the layer below (`pd.parent_ok`), each budget node under its
# kind node (`pd.enc_rooted`). decode reads the pairs back in order
# (`pd.dec_go`), and a rewind reaches the encoded tree (proof_tree's
# `rewind_reaches`), so it restores the stack.

# Numbers
# -------

def pd.lt_succ(n: Nat) -> {Nat.is_lt(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pd.lt_succ(p)

def pd.lt_add2(n: Nat) -> {Nat.is_lt(n, 2n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pd.lt_add2(p)

# Lists
# -----

def pd.app_nil(-A: Data, xs: List<&2, A>) -> {List.append(&2, A, xs, Nil{}) == xs : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> r:
      %pd.app_nil(A, r) : {h <> List.append(&2, A, r, Nil{}) == h <> _ : List<&2, A>}
      {==}

def pd.app_assoc(-A: Data, xs: List<&2, A>, +ys: List<&2, A>, +zs: List<&2, A>) -> {List.append(&2, A, List.append(&2, A, xs, ys), zs) == List.append(&2, A, xs, List.append(&2, A, ys, zs)) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> r:
      %pd.app_assoc(A, r, ys, zs) : {h <> List.append(&2, A, List.append(&2, A, r, ys), zs) == h <> _ : List<&2, A>}
      {==}

# The loop
# --------

# the loop has ended, or has fewer than k steps left
def pd.ok(l: Dr.Loop, k: Nat) -> Bool:
  match l:
    case Dr.Loop{n, s, e}:
      match e:
        case None{}:
          Nat.is_lt(n, k)
        case Some{x}:
          True{}

def pd.cont_ok(n: Nat, +s: List<&2, Dr.Layer>, +k: Nat, h: {Nat.is_lt(n, 1n+k) == True{} : Bool}) -> {pd.ok(Dr.cont(n, s), k) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      h

def pd.after_ok(+n: Nat, d: Dr.Dec, +k: Nat, h: {Nat.is_lt(n, 1n+k) == True{} : Bool}) -> {pd.ok(Dr.after(n, d), k) == True{} : Bool}:
  match d:
    case Dr.Dec{o, s}:
      match o:
        case Dr.Cont{}:
          pd.cont_ok(n, s, k, h)
        case Dr.Hand{}:
          {==}
        case Dr.Failed{}:
          {==}

# a tick takes one step off the loop
def pd.tick_ok(+cap: Nat, l: Dr.Loop, vs: List<&2, Dr.Verdict>, +k: Nat, h: {pd.ok(l, 1n+k) == True{} : Bool}) -> {pd.ok(Dr.tick(cap, l, vs), k) == True{} : Bool}:
  match l:
    case Dr.Loop{+n, s, e}:
      match e:
        case None{}:
          pd.after_ok(n, Dr.decide(s, vs, cap), k, h)
        case Some{x}:
          {==}

def pd.ok_zero(l: Dr.Loop, h: {pd.ok(l, 0n) == True{} : Bool}) -> {Dr.ended(l) == True{} : Bool}:
  match l:
    case Dr.Loop{+n, +s, e}:
      match e:
        case None{}:
          pt.lt_zero({Dr.ended(Dr.Loop{n, s, None{}}) == True{} : Bool}, n, h)
        case Some{x}:
          {==}

# a loop with fewer steps left than verdict lists has ended after them
def pd.ends_go(vss: List<&2, List<&2, Dr.Verdict>>, +cap: Nat, +l: Dr.Loop, h: {pd.ok(l, List.length(&2, List<&2, Dr.Verdict>, vss)) == True{} : Bool}) -> {Dr.ended(Dr.run(vss, cap, l)) == True{} : Bool}:
  match vss:
    case Nil{}:
      pd.ok_zero(l, h)
    case +vs <> +rest:
      pd.ends_go(rest, cap, Dr.tick(cap, l, vs), pd.tick_ok(cap, l, vs, List.length(&2, List<&2, Dr.Verdict>, rest), h))

def pd.lt_len(+n: Nat, +k: Nat, e: {k == 1n+n : Nat}) -> {Nat.is_lt(n, k) == True{} : Bool}:
  %Equal.sym(Nat, k, 1n+n, e) : {Nat.is_lt(n, _) == True{} : Bool}
  pd.lt_succ(n)

def pd.dir_loop_ends(+n: Nat, +s: List<&2, Dr.Layer>, +vss: List<&2, List<&2, Dr.Verdict>>, +cap: Nat, long: {List.length(&2, List<&2, Dr.Verdict>, vss) == 1n+n : Nat}) -> {Dr.ended(Dr.run(vss, cap, Dr.Loop{n, s, None{}})) == True{} : Bool}:
  pd.ends_go(vss, cap, Dr.Loop{n, s, None{}}, pd.lt_len(n, List.length(&2, List<&2, Dr.Verdict>, vss), long))

def pd.dir_end_is_final(+cap: Nat, +l: Dr.Loop, done: {Dr.ended(l) == True{} : Bool}, vs: List<&2, Dr.Verdict>) -> {Dr.tick(cap, l, vs) == l : Dr.Loop}:
  match l:
    case Dr.Loop{n, s, e}:
      match e:
        case None{}:
          tree.pt.absurdF({Dr.tick(cap, Dr.Loop{n, s, None{}}, vs) == Dr.Loop{n, s, None{}} : Dr.Loop}, done)
        case Some{x}:
          {==}

# The stack in the tree: order
# ----------------------------

# every key of t is less than m
def pd.lt_all(t: List<&2, Tr.Ent>, +m: Nat) -> Bool:
  match t:
    case Nil{}:
      True{}
    case e <> rest:
      Bool.and(Nat.is_lt(Tr.Ent.k(e), m), pd.lt_all(rest, m))

def pd.lt_all_app(A: List<&2, Tr.Ent>, +B: List<&2, Tr.Ent>, +m: Nat, +ha: {pd.lt_all(A, m) == True{} : Bool}, hb: {pd.lt_all(B, m) == True{} : Bool}) -> {pd.lt_all(List.append(&2, Tr.Ent, A, B), m) == True{} : Bool}:
  match A:
    case Nil{}:
      hb
    case +e <> +r:
      tree.pt.and_t(Nat.is_lt(Tr.Ent.k(e), m), pd.lt_all(List.append(&2, Tr.Ent, r, B), m), tree.pt.and_l(Nat.is_lt(Tr.Ent.k(e), m), pd.lt_all(r, m), ha), pd.lt_all_app(r, B, m, tree.pt.and_r(Nat.is_lt(Tr.Ent.k(e), m), pd.lt_all(r, m), ha), hb))

# every key of encode(s) is at most twice the layers of s
def pd.enc_lt(s: List<&2, Dr.Layer>, +m: Nat, +h: {Nat.is_lt(Nat.double(List.length(&2, Dr.Layer, s)), m) == True{} : Bool}) -> {pd.lt_all(Dr.encode(s), m) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case l <> +rest:
      match l:
        case Dr.Layer{+k, +b}:
          +n = List.length(&2, Dr.Layer, rest)
          +x = {Tr.Ent{1n+Nat.double(n), Dr.kind.parent(n), k} : Tr.Ent}
          +y = {Tr.Ent{2n+Nat.double(n), 1n+Nat.double(n), b} : Tr.Ent}
          +hr = pt.lt_trans(Nat.double(n), 2n+Nat.double(n), m, pd.lt_add2(Nat.double(n)), h)
          +hx = pt.lt_trans(1n+Nat.double(n), 2n+Nat.double(n), m, pd.lt_succ(1n+Nat.double(n)), h)
          +hxy = tree.pt.and_t(Nat.is_lt(1n+Nat.double(n), m), Bool.and(Nat.is_lt(2n+Nat.double(n), m), True{}), hx, tree.pt.and_t(Nat.is_lt(2n+Nat.double(n), m), True{}, h, {==}))
          pd.lt_all_app(Dr.encode(rest), [x, y], m, pd.enc_lt(rest, m, hr), hxy)

def pd.above_app(+e: Tr.Ent, r: List<&2, Tr.Ent>, +x: Tr.Ent, +C: List<&2, Tr.Ent>, sa: {Tr.sorted(e <> r) == True{} : Bool}, la: {pd.lt_all(e <> r, Tr.Ent.k(x)) == True{} : Bool}) -> {Tr.above(Tr.Ent.k(e), List.append(&2, Tr.Ent, r, x <> C)) == True{} : Bool}:
  match r:
    case Nil{}:
      tree.pt.and_l(Nat.is_lt(Tr.Ent.k(e), Tr.Ent.k(x)), True{}, la)
    case +h <> +t:
      tree.pt.and_l(Tr.above(Tr.Ent.k(e), h <> t), Tr.sorted(h <> t), sa)

# a sorted list, then sorted nodes above all its keys, is sorted
def pd.sorted_snoc(A: List<&2, Tr.Ent>, +x: Tr.Ent, +C: List<&2, Tr.Ent>, +sa: {Tr.sorted(A) == True{} : Bool}, sc: {Tr.sorted(x <> C) == True{} : Bool}, +la: {pd.lt_all(A, Tr.Ent.k(x)) == True{} : Bool}) -> {Tr.sorted(List.append(&2, Tr.Ent, A, x <> C)) == True{} : Bool}:
  match A:
    case Nil{}:
      sc
    case +e <> +r:
      +sr = tree.pt.and_r(Tr.above(Tr.Ent.k(e), r), Tr.sorted(r), sa)
      +lr = tree.pt.and_r(Nat.is_lt(Tr.Ent.k(e), Tr.Ent.k(x)), pd.lt_all(r, Tr.Ent.k(x)), la)
      tree.pt.and_t(Tr.above(Tr.Ent.k(e), List.append(&2, Tr.Ent, r, x <> C)), Tr.sorted(List.append(&2, Tr.Ent, r, x <> C)), pd.above_app(e, r, x, C, sa, la), pd.sorted_snoc(r, x, C, sr, sc, lr))

def pd.enc_sorted(s: List<&2, Dr.Layer>) -> {Tr.sorted(Dr.encode(s)) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case l <> +rest:
      match l:
        case Dr.Layer{+k, +b}:
          +n = List.length(&2, Dr.Layer, rest)
          +x = {Tr.Ent{1n+Nat.double(n), Dr.kind.parent(n), k} : Tr.Ent}
          +y = {Tr.Ent{2n+Nat.double(n), 1n+Nat.double(n), b} : Tr.Ent}
          +sxy = tree.pt.and_t(Nat.is_lt(1n+Nat.double(n), 2n+Nat.double(n)), Tr.sorted([y]), pd.lt_succ(1n+Nat.double(n)), {==})
          pd.sorted_snoc(Dr.encode(rest), x, [y], pd.enc_sorted(rest), sxy, pd.enc_lt(rest, 1n+Nat.double(n), pd.lt_succ(Nat.double(n))))

# The stack in the tree: parents
# ------------------------------

def pd.or_has_app(c: Bool, +all: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +p: Nat, o: {Bool.or(c, Tr.has(all, p)) == True{} : Bool}) -> {Bool.or(c, Tr.has(List.append(&2, Tr.Ent, all, C), p)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      pt.has_app_l(all, C, p, o)

# a parent stays a parent when nodes come after
def pd.ok_app(+all: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +k: Nat, +p: Nat, +h: {Tr.ok(all, k, p) == True{} : Bool}) -> {Tr.ok(List.append(&2, Tr.Ent, all, C), k, p) == True{} : Bool}:
  +o = tree.pt.and_r(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(all, p)), h)
  tree.pt.and_t(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(List.append(&2, Tr.Ent, all, C), p)), tree.pt.and_l(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(all, p)), h), pd.or_has_app(Nat.is_eq(p, 0n), all, C, p, o))

def pd.rooted_app_all(s: List<&2, Tr.Ent>, +all: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +rs: {Tr.rooted.go(s, all) == True{} : Bool}) -> {Tr.rooted.go(s, List.append(&2, Tr.Ent, all, C)) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case +e <> +r:
      +he = tree.pt.and_l(Tr.ok(all, Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(r, all), rs)
      +hr = tree.pt.and_r(Tr.ok(all, Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(r, all), rs)
      tree.pt.and_t(Tr.ok(List.append(&2, Tr.Ent, all, C), Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(r, List.append(&2, Tr.Ent, all, C)), pd.ok_app(all, C, Tr.Ent.k(e), Tr.Ent.p(e), he), pd.rooted_app_all(r, all, C, hr))

def pd.rooted_go_app(A: List<&2, Tr.Ent>, +B: List<&2, Tr.Ent>, +all: List<&2, Tr.Ent>, +ra: {Tr.rooted.go(A, all) == True{} : Bool}, rb: {Tr.rooted.go(B, all) == True{} : Bool}) -> {Tr.rooted.go(List.append(&2, Tr.Ent, A, B), all) == True{} : Bool}:
  match A:
    case Nil{}:
      rb
    case +e <> +r:
      +he = tree.pt.and_l(Tr.ok(all, Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(r, all), ra)
      +hr = tree.pt.and_r(Tr.ok(all, Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(r, all), ra)
      tree.pt.and_t(Tr.ok(all, Tr.Ent.k(e), Tr.Ent.p(e)), Tr.rooted.go(List.append(&2, Tr.Ent, r, B), all), he, pd.rooted_go_app(r, B, all, hr, rb))

# the kind node of the layer above rest hangs under the root (no layer
# below) or the kind node of the layer below
def pd.parent_ok(rest: List<&2, Dr.Layer>, +C: List<&2, Tr.Ent>) -> {Tr.ok(List.append(&2, Tr.Ent, Dr.encode(rest), C), Dr.kind.key(List.length(&2, Dr.Layer, rest)), Dr.kind.parent(List.length(&2, Dr.Layer, rest))) == True{} : Bool}:
  match rest:
    case Nil{}:
      {==}
    case l2 <> +r2:
      match l2:
        case Dr.Layer{+k2, +b2}:
          +m = List.length(&2, Dr.Layer, r2)
          +E2 = Dr.encode(r2)
          +x2 = {Tr.Ent{1n+Nat.double(m), Dr.kind.parent(m), k2} : Tr.Ent}
          +y2 = {Tr.Ent{2n+Nat.double(m), 1n+Nat.double(m), b2} : Tr.Ent}
          +X2 = {[x2, y2] : List<&2, Tr.Ent>}
          +hh = pt.has_app_l(List.append(&2, Tr.Ent, E2, X2), C, 1n+Nat.double(m), pt.has_app_r(E2, X2, 1n+Nat.double(m), pt.has_head(x2, [y2])))
          tree.pt.and_t(Nat.is_lt(1n+Nat.double(m), 3n+Nat.double(m)), Bool.or(Nat.is_eq(1n+Nat.double(m), 0n), Tr.has(List.append(&2, Tr.Ent, List.append(&2, Tr.Ent, E2, X2), C), 1n+Nat.double(m))), pd.lt_add2(1n+Nat.double(m)), pt.or_tr(Nat.is_eq(1n+Nat.double(m), 0n), Tr.has(List.append(&2, Tr.Ent, List.append(&2, Tr.Ent, E2, X2), C), 1n+Nat.double(m)), hh))

def pd.enc_rooted(s: List<&2, Dr.Layer>) -> {Tr.rooted(Dr.encode(s)) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case l <> +rest:
      match l:
        case Dr.Layer{+k, +b}:
          +n = List.length(&2, Dr.Layer, rest)
          +E = Dr.encode(rest)
          +x = {Tr.Ent{1n+Nat.double(n), Dr.kind.parent(n), k} : Tr.Ent}
          +y = {Tr.Ent{2n+Nat.double(n), 1n+Nat.double(n), b} : Tr.Ent}
          +X = {[x, y] : List<&2, Tr.Ent>}
          +T = List.append(&2, Tr.Ent, E, X)
          +ra = pd.rooted_app_all(E, E, X, pd.enc_rooted(rest))
          +hy = tree.pt.and_t(Nat.is_lt(1n+Nat.double(n), 2n+Nat.double(n)), Bool.or(Nat.is_eq(1n+Nat.double(n), 0n), Tr.has(T, 1n+Nat.double(n))), pd.lt_succ(1n+Nat.double(n)), pt.or_tr(Nat.is_eq(1n+Nat.double(n), 0n), Tr.has(T, 1n+Nat.double(n)), pt.has_app_r(E, X, 1n+Nat.double(n), pt.has_head(x, [y]))))
          +rb = tree.pt.and_t(Tr.ok(T, 1n+Nat.double(n), Dr.kind.parent(n)), Bool.and(Tr.ok(T, 2n+Nat.double(n), 1n+Nat.double(n)), True{}), pd.parent_ok(rest, X), tree.pt.and_t(Tr.ok(T, 2n+Nat.double(n), 1n+Nat.double(n)), True{}, hy, {==}))
          pd.rooted_go_app(E, X, T, ra, rb)

def pd.dir_encode_sound(+s: List<&2, Dr.Layer>) -> {Tr.sound(Dr.encode(s)) == True{} : Bool}:
  tree.pt.and_t(Tr.sorted(Dr.encode(s)), Tr.rooted(Dr.encode(s)), pd.enc_sorted(s), pd.enc_rooted(s))

# Resume and rewind
# -----------------

# decode reads the layers of encode(s) back onto acc, then goes on
def pd.dec_go(s: List<&2, Dr.Layer>, +B: List<&2, Tr.Ent>, +acc: List<&2, Dr.Layer>) -> {Dr.decode.go(List.append(&2, Tr.Ent, Dr.encode(s), B), acc) == Dr.decode.go(B, List.append(&2, Dr.Layer, s, acc)) : List<&2, Dr.Layer>}:
  match s:
    case Nil{}:
      {==}
    case l <> +rest:
      match l:
        case Dr.Layer{+k, +b}:
          +n = List.length(&2, Dr.Layer, rest)
          +x = {Tr.Ent{1n+Nat.double(n), Dr.kind.parent(n), k} : Tr.Ent}
          +y = {Tr.Ent{2n+Nat.double(n), 1n+Nat.double(n), b} : Tr.Ent}
          +E = Dr.encode(rest)
          %Equal.sym(List<&2, Tr.Ent>, List.append(&2, Tr.Ent, List.append(&2, Tr.Ent, E, [x, y]), B), List.append(&2, Tr.Ent, E, x <> y <> B), pd.app_assoc(Tr.Ent, E, [x, y], B)) : {Dr.decode.go(_, acc) == Dr.decode.go(B, Dr.Layer{k, b} <> List.append(&2, Dr.Layer, rest, acc)) : List<&2, Dr.Layer>}
          pd.dec_go(rest, x <> y <> B, acc)

def pd.dir_resume_restores(+s: List<&2, Dr.Layer>) -> {Dr.decode(Dr.encode(s)) == s : List<&2, Dr.Layer>}:
  %pd.app_nil(Tr.Ent, Dr.encode(s)) : {Dr.decode.go(_, Nil{}) == s : List<&2, Dr.Layer>}
  %pd.app_nil(Dr.Layer, s) : {Dr.decode.go(List.append(&2, Tr.Ent, Dr.encode(s), Nil{}), Nil{}) == _ : List<&2, Dr.Layer>}
  pd.dec_go(s, Nil{}, Nil{})

def pd.dir_rewind_restores(+a: List<&2, Tr.Ent>, +s: List<&2, Dr.Layer>, good: {Tr.sound(a) == True{} : Bool}) -> {Dr.decode(Tr.apply(a, Tr.Rewind{Tr.diff(a, Dr.encode(s))})) == s : List<&2, Dr.Layer>}:
  %Equal.sym(List<&2, Tr.Ent>, Tr.apply(a, Tr.Rewind{Tr.diff(a, Dr.encode(s))}), Dr.encode(s), rewind_reaches(a, Dr.encode(s), good, pd.dir_encode_sound(s))) : {Dr.decode(_) == s : List<&2, Dr.Layer>}
  pd.dir_resume_restores(s)

# The bound
# ---------

def pd.add_succ(a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pd.add_succ(p, b) : {1n+Nat.add(p, 1n+b) == 1n+_ : Nat}
      {==}

def pd.le_zero(q: Nat) -> {Nat.is_le(0n, q) == True{} : Bool}:
  match q:
    case 0n:
      {==}
    case 1n+r:
      {==}

def pd.le_pred(x: Nat, cap: Nat, h: {Nat.is_le(1n+x, cap) == True{} : Bool}) -> {Nat.is_le(x, cap) == True{} : Bool}:
  match x cap:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      tree.pt.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pd.le_pred(p, q, h)

def pd.lt_le(x: Nat, cap: Nat, h: {Nat.is_lt(x, cap) == True{} : Bool}) -> {Nat.is_le(1n+x, cap) == True{} : Bool}:
  match x cap:
    case 0n 0n:
      tree.pt.absurdF({Nat.is_le(1n, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      pd.le_zero(q)
    case 1n+p 0n:
      tree.pt.absurdF({Nat.is_le(2n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pd.lt_le(p, q, h)

# one more layer above, one fewer below
def pd.shift(+above: Nat, +r: Nat, +cap: Nat, h: {Nat.is_le(Nat.add(above, 1n+r), cap) == True{} : Bool}) -> {Nat.is_le(Nat.add(1n+above, r), cap) == True{} : Bool}:
  %pd.add_succ(above, r) : {Nat.is_le(_, cap) == True{} : Bool}
  h

# a layer put back on the stack below it
def pd.under_ok(+l: Dr.Layer, d: Dr.Dec, +above: Nat, +cap: Nat, ih: {Nat.is_le(Nat.add(1n+above, List.length(&2, Dr.Layer, Dr.Dec.stack(d))), cap) == True{} : Bool}) -> {Nat.is_le(Nat.add(above, List.length(&2, Dr.Layer, Dr.Dec.stack(Dr.under(l, d)))), cap) == True{} : Bool}:
  match d:
    case Dr.Dec{o, +s}:
      +r = List.length(&2, Dr.Layer, s)
      %Equal.sym(Nat, Nat.add(above, 1n+r), 1n+Nat.add(above, r), pd.add_succ(above, r)) : {Nat.is_le(_, cap) == True{} : Bool}
      ih

# a Stack with room adds one layer to a stack with room for it
def pd.push_ok(+cap: Nat, +above: Nat, +rest: List<&2, Dr.Layer>, room: Bool, er: {Nat.is_lt(Nat.add(above, 1n+List.length(&2, Dr.Layer, rest)), cap) == room : Bool}, +l: Dr.Layer, +n: Dr.Layer, h: {Nat.is_le(Nat.add(above, 1n+List.length(&2, Dr.Layer, rest)), cap) == True{} : Bool}) -> {Nat.is_le(Nat.add(above, List.length(&2, Dr.Layer, Dr.Dec.stack(Dr.push.at(room, l, n, rest)))), cap) == True{} : Bool}:
  match room:
    case True{}:
      +r = List.length(&2, Dr.Layer, rest)
      %Equal.sym(Nat, Nat.add(above, 2n+r), 1n+Nat.add(above, 1n+r), pd.add_succ(above, 1n+r)) : {Nat.is_le(_, cap) == True{} : Bool}
      pd.lt_le(Nat.add(above, 1n+r), cap, er)
    case False{}:
      h

def pd.pick_ok(v: Dr.Verdict, +l: Dr.Layer, +rest: List<&2, Dr.Layer>, +cap: Nat, +above: Nat, d: Dr.Dec, +h: {Nat.is_le(Nat.add(above, 1n+List.length(&2, Dr.Layer, rest)), cap) == True{} : Bool}, ih: {Nat.is_le(Nat.add(1n+above, List.length(&2, Dr.Layer, Dr.Dec.stack(d))), cap) == True{} : Bool}) -> {Nat.is_le(Nat.add(above, List.length(&2, Dr.Layer, Dr.Dec.stack(Dr.pick(v, l, rest, cap, above, d)))), cap) == True{} : Bool}:
  match v:
    case Dr.Defer{}:
      pd.under_ok(l, d, above, cap, ih)
    case Dr.Again{}:
      match l:
        case Dr.Layer{k, b}:
          match b:
            case 0n:
              h
            case 1n+c:
              h
    case Dr.Yield{}:
      h
    case Dr.Stack{n}:
      match l:
        case Dr.Layer{+k, b}:
          match b:
            case 0n:
              h
            case 1n+c:
              pd.push_ok(cap, above, rest, Nat.is_lt(Nat.add(above, 1n+List.length(&2, Dr.Layer, rest)), cap), {==}, Dr.Layer{k, c}, n, h)
    case Dr.Leave{}:
      pd.le_pred(Nat.add(above, List.length(&2, Dr.Layer, Dr.Dec.stack(d))), cap, ih)
    case Dr.Abort{}:
      h

# a decision under `above` layers keeps above + len(stack) within cap
def pd.go_bounded(s: List<&2, Dr.Layer>, vs: List<&2, Dr.Verdict>, +cap: Nat, +above: Nat, +h: {Nat.is_le(Nat.add(above, List.length(&2, Dr.Layer, s)), cap) == True{} : Bool}) -> {Nat.is_le(Nat.add(above, List.length(&2, Dr.Layer, Dr.Dec.stack(Dr.decide.go(s, vs, cap, above)))), cap) == True{} : Bool}:
  match s:
    case Nil{}:
      h
    case +l <> +rest:
      match vs:
        case Nil{}:
          pd.under_ok(l, Dr.decide.go(rest, Nil{}, cap, 1n+above), above, cap, pd.go_bounded(rest, Nil{}, cap, 1n+above, pd.shift(above, List.length(&2, Dr.Layer, rest), cap, h)))
        case +v <> +vr:
          pd.pick_ok(v, l, rest, cap, above, Dr.decide.go(rest, vr, cap, 1n+above), h, pd.go_bounded(rest, vr, cap, 1n+above, pd.shift(above, List.length(&2, Dr.Layer, rest), cap, h)))

def pd.dir_stack_bounded(+s: List<&2, Dr.Layer>, vs: List<&2, Dr.Verdict>, +cap: Nat, fits: {Nat.is_le(List.length(&2, Dr.Layer, s), cap) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Dr.Layer, Dr.Dec.stack(Dr.decide(s, vs, cap))), cap) == True{} : Bool}:
  pd.go_bounded(s, vs, cap, 0n, fits)

def pd.cont_bounded(n: Nat, +s: List<&2, Dr.Layer>, +cap: Nat, h: {Nat.is_le(List.length(&2, Dr.Layer, s), cap) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(Dr.cont(n, s))), cap) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+m:
      h

def pd.after_bounded(+n: Nat, d: Dr.Dec, +cap: Nat, h: {Nat.is_le(List.length(&2, Dr.Layer, Dr.Dec.stack(d)), cap) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(Dr.after(n, d))), cap) == True{} : Bool}:
  match d:
    case Dr.Dec{o, +s}:
      match o:
        case Dr.Cont{}:
          pd.cont_bounded(n, s, cap, h)
        case Dr.Hand{}:
          h
        case Dr.Failed{}:
          h

# one loop step keeps the stack within cap
def pd.tick_bounded(+cap: Nat, l: Dr.Loop, +vs: List<&2, Dr.Verdict>, h: {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(l)), cap) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(Dr.tick(cap, l, vs))), cap) == True{} : Bool}:
  match l:
    case Dr.Loop{+n, +s, e}:
      match e:
        case None{}:
          pd.after_bounded(n, Dr.decide(s, vs, cap), cap, pd.dir_stack_bounded(s, vs, cap, h))
        case Some{x}:
          h

def pd.dir_loop_stack_bounded(vss: List<&2, List<&2, Dr.Verdict>>, +cap: Nat, +l: Dr.Loop, fits: {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(l)), cap) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Dr.Layer, Dr.Loop.stack(Dr.run(vss, cap, l))), cap) == True{} : Bool}:
  match vss:
    case Nil{}:
      fits
    case +vs <> rest:
      pd.dir_loop_stack_bounded(rest, cap, Dr.tick(cap, l, vs), pd.tick_bounded(cap, l, vs, fits))

# ---- infer ----

# proof_infer: the inference layer laws of S6 (forced calls, the strict
# schema budget, the repetition guard, early compaction), about
# bend/infer.bend.
#
# A forced call: by induction on the replies and the retries; a retry's
# tries all carry the provider's support (`pi.flags_sup`). The budget:
# a take and its drop split every count (`pi.count_split`), ranking keeps
# every count (`pi.count_rank`) and sorts by priority (`pi.sorted_rank`),
# and a sorted list's take dominates its drop (`pi.dom_split`). The guard:
# the counter of period p is at least m exactly when the first m chunks
# each equal the chunk p before them (`pi.each_cycle`), so the guard fires
# exactly at a periodic window (`pi.fires_periodic`, `pi.cut_go`,
# `pi.keep_go`), and k equal chunks in a row end in one (`pi.run_loops`,
# `pi.rep_go`). Compaction:
# while below the threshold the next size stays within the limit
# (`pi.compact_go`).

# Logic
# -----

def pi.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pi.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pi.BD(_, Unit, A)
  Unit{}

def pi.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pi.BD(_, A, Unit)
  Unit{}

def pi.void(-A: Type, e: Empty) -> A:
  match e:

def pi.flip(-a: Bool, h: {a == True{} : Bool}, g: {a == False{} : Bool}) -> Empty:
  pi.absurd(Empty, Equal.trans(Bool, True{}, a, False{}, Equal.sym(Bool, a, True{}, h), g))

def pi.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pi.absurdF({False{} == True{} : Bool}, h)

def pi.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pi.absurdF({b == True{} : Bool}, h)

def pi.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pi.or_l(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      pi.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pi.or_r(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      pi.absurd({b == False{} : Bool}, h)
    case False{}:
      h

# Forced calls
# ------------

def pi.fst_next(-t: If.Try, p: List<&2, If.Try> & If.Forced) -> {t <> Pair.fst(List<&2, If.Try>, If.Forced, p) == Pair.fst(List<&2, If.Try>, If.Forced, If.force.next(t, p)) : List<&2, If.Try>}:
  (ts, o) = p
  {==}

def pi.snd_next(-t: If.Try, p: List<&2, If.Try> & If.Forced) -> {Pair.snd(List<&2, If.Try>, If.Forced, p) == Pair.snd(List<&2, If.Try>, If.Forced, If.force.next(t, p)) : If.Forced}:
  (ts, o) = p
  {==}

def pi.le0(n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pi.bounded_go(+replies: List<&2, Bool>, +r: Nat, +flag: Bool, +sup: Bool) -> {Nat.is_le(List.length(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(replies, r, flag, sup))), 1n+r) == True{} : Bool}:
  match replies:
    case Nil{}:
      pi.le0(r)
    case c <> rest:
      match c:
        case True{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              {==}
        case False{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              %pi.fst_next(If.Try{flag}, If.force.go(rest, q, sup, sup)) : {Nat.is_le(List.length(&2, If.Try, _), 2n+q) == True{} : Bool}
              pi.bounded_go(rest, q, sup, sup)

def pi.first_go(+replies: List<&2, Bool>, +r: Nat, +flag: Bool, +sup: Bool) -> {List.head(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(replies, r, flag, sup))) == Some{If.Try{flag}} : Maybe<&2, If.Try>}:
  match replies:
    case Nil{}:
      {==}
    case c <> rest:
      match c:
        case True{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              {==}
        case False{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              %pi.fst_next(If.Try{flag}, If.force.go(rest, q, sup, sup)) : {List.head(&2, If.Try, _) == Some{If.Try{flag}} : Maybe<&2, If.Try>}
              {==}

def pi.nxx(f: Bool) -> {True{} == Bool.not(Bool.xor(f, f)) : Bool}:
  match f:
    case True{}:
      {==}
    case False{}:
      {==}

# every try of a retry carries the provider's support
def pi.flags_sup(+replies: List<&2, Bool>, +r: Nat, +f: Bool) -> {If.flags(Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(replies, r, f, f)), f) == True{} : Bool}:
  match replies:
    case Nil{}:
      %pi.nxx(f) : {Bool.and(_, True{}) == True{} : Bool}
      {==}
    case c <> rest:
      match c:
        case True{}:
          match r:
            case 0n:
              %pi.nxx(f) : {Bool.and(_, True{}) == True{} : Bool}
              {==}
            case 1n+q:
              %pi.nxx(f) : {Bool.and(_, True{}) == True{} : Bool}
              {==}
        case False{}:
          match r:
            case 0n:
              %pi.nxx(f) : {Bool.and(_, True{}) == True{} : Bool}
              {==}
            case 1n+q:
              -F = Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(rest, q, f, f))
              %pi.fst_next(If.Try{f}, If.force.go(rest, q, f, f)) : {If.flags(_, f) == True{} : Bool}
              %pi.nxx(f) : {Bool.and(_, If.flags(F, f)) == True{} : Bool}
              pi.flags_sup(rest, q, f)

def pi.drop0(xs: List<&2, If.Try>) -> {xs == List.drop(&2, If.Try, xs, 0n) : List<&2, If.Try>}:
  match xs:
    case Nil{}:
      {==}
    case h <> t:
      {==}

def pi.retry_go(+replies: List<&2, Bool>, +r: Nat, +flag: Bool, +sup: Bool) -> {If.flags(List.drop(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(replies, r, flag, sup)), 1n), sup) == True{} : Bool}:
  match replies:
    case Nil{}:
      {==}
    case c <> rest:
      match c:
        case True{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              {==}
        case False{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              %pi.fst_next(If.Try{flag}, If.force.go(rest, q, sup, sup)) : {If.flags(List.drop(&2, If.Try, _, 1n), sup) == True{} : Bool}
              %pi.drop0(Pair.fst(List<&2, If.Try>, If.Forced, If.force.go(rest, q, sup, sup))) : {If.flags(_, sup) == True{} : Bool}
              pi.flags_sup(rest, q, sup)

def pi.reports_go(+replies: List<&2, Bool>, +r: Nat, +flag: Bool, +sup: Bool) -> {If.Forced.called(Pair.snd(List<&2, If.Try>, If.Forced, If.force.go(replies, r, flag, sup))) == If.called_within(1n+r, replies) : Bool}:
  match replies:
    case Nil{}:
      {==}
    case c <> rest:
      match c:
        case True{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              {==}
        case False{}:
          match r:
            case 0n:
              {==}
            case 1n+q:
              %pi.snd_next(If.Try{flag}, If.force.go(rest, q, sup, sup)) : {If.Forced.called(_) == If.called_within(1n+q, rest) : Bool}
              pi.reports_go(rest, q, sup, sup)

def pi.force_bounded(+r: Nat, +replies: List<&2, Bool>, +sup: Bool, +free: Bool) -> {Nat.is_le(List.length(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force(r, replies, sup, free))), 1n+r) == True{} : Bool}:
  pi.bounded_go(replies, r, Bool.and(sup, free), sup)

def pi.force_first_flag(+r: Nat, +replies: List<&2, Bool>, +sup: Bool, +free: Bool) -> {List.head(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force(r, replies, sup, free))) == Some{If.Try{Bool.and(sup, free)}} : Maybe<&2, If.Try>}:
  pi.first_go(replies, r, Bool.and(sup, free), sup)

def pi.force_retry_flag(+r: Nat, +replies: List<&2, Bool>, +sup: Bool, +free: Bool) -> {If.flags(List.drop(&2, If.Try, Pair.fst(List<&2, If.Try>, If.Forced, If.force(r, replies, sup, free)), 1n), sup) == True{} : Bool}:
  pi.retry_go(replies, r, Bool.and(sup, free), sup)

def pi.force_reports(+r: Nat, +replies: List<&2, Bool>, +sup: Bool, +free: Bool) -> {If.Forced.called(Pair.snd(List<&2, If.Try>, If.Forced, If.force(r, replies, sup, free))) == If.called_within(1n+r, replies) : Bool}:
  pi.reports_go(replies, r, Bool.and(sup, free), sup)

# Numbers
# -------

def pi.le_trans(a: Nat, b: Nat, c: Nat, +ab: {Nat.is_le(a, b) == True{} : Bool}, +bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      pi.le0(c)
    case 1n+p 0n _:
      pi.absurdF({Nat.is_le(1n+p, c) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      pi.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      pi.le_trans(p, q, r, ab, bc)

def pi.lt_le(a: Nat, b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      pi.absurdF({True{} == True{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      pi.absurdF({False{} == True{} : Bool}, h)
    case 1n+p 1n+q:
      pi.lt_le(p, q, h)

def pi.nle_le(a: Nat, b: Nat, +h: {Nat.is_le(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      pi.absurd({True{} == True{} : Bool}, h)
    case 0n 1n+q:
      pi.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pi.nle_le(p, q, h)

# The strict schema budget
# ------------------------

def pi.take_len(xs: List<&2, If.Tool>, n: Nat) -> {Nat.is_le(List.length(&2, If.Tool, List.take(&2, If.Tool, xs, n)), n) == True{} : Bool}:
  match xs n:
    case Nil{} _:
      pi.le0(n)
    case h <> t 0n:
      {==}
    case h <> t 1n+p:
      pi.take_len(t, p)

def pi.strict_within_cap(+cap: Nat, +ts: List<&2, If.Tool>) -> {Nat.is_le(List.length(&2, If.Tool, Pair.fst(List<&2, If.Tool>, List<&2, If.Tool>, If.strict(cap, ts))), cap) == True{} : Bool}:
  pi.take_len(If.rank(ts), cap)

# a count, with one more when b
def pi.cnt(b: Bool, n: Nat) -> Nat:
  match b:
    case True{}:
      1n+n
    case False{}:
      n

def pi.count_go(b: Bool, +h: If.Tool, +X: List<&2, If.Tool>, +i: Nat) -> {pi.cnt(b, If.count(X, i)) == If.count.go(h <> X, i, b) : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pi.count_cons(+h: If.Tool, +X: List<&2, If.Tool>, +i: Nat) -> {pi.cnt(Nat.is_eq(If.Tool.id(h), i), If.count(X, i)) == If.count(h <> X, i) : Nat}:
  pi.count_go(Nat.is_eq(If.Tool.id(h), i), h, X, i)

def pi.cnt_add(b: Bool, +x: Nat, +y: Nat) -> {pi.cnt(b, Nat.add(x, y)) == Nat.add(pi.cnt(b, x), y) : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pi.cnt_comm(a: Bool, b: Bool, +n: Nat) -> {pi.cnt(a, pi.cnt(b, n)) == pi.cnt(b, pi.cnt(a, n)) : Nat}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# a take and its drop split every count
def pi.count_split(+xs: List<&2, If.Tool>, +n: Nat, +i: Nat) -> {Nat.add(If.count(List.take(&2, If.Tool, xs, n), i), If.count(List.drop(&2, If.Tool, xs, n), i)) == If.count(xs, i) : Nat}:
  match xs n:
    case Nil{} _:
      {==}
    case h <> t 0n:
      {==}
    case h <> t 1n+p:
      +b = Nat.is_eq(If.Tool.id(h), i)
      +T = List.take(&2, If.Tool, t, p)
      +D = If.count(List.drop(&2, If.Tool, t, p), i)
      %pi.count_cons(h, T, i) : {Nat.add(_, D) == If.count(h <> t, i) : Nat}
      %pi.count_cons(h, t, i) : {Nat.add(pi.cnt(b, If.count(T, i)), D) == _ : Nat}
      %pi.cnt_add(b, If.count(T, i), D) : {_ == pi.cnt(b, If.count(t, i)) : Nat}
      Equal.cong(Nat, Nat, k => pi.cnt(b, k), Nat.add(If.count(T, i), D), If.count(t, i), pi.count_split(t, p, i))

def pi.count_ins_go(+xs: List<&2, If.Tool>, +t: If.Tool, hit: Bool, +i: Nat) -> {If.count(t <> xs, i) == If.count(If.ins.go(xs, t, hit), i) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case u <> rest:
      match hit:
        case True{}:
          {==}
        case False{}:
          +bu = Nat.is_eq(If.Tool.id(u), i)
          +bt = Nat.is_eq(If.Tool.id(t), i)
          +I = If.ins.go(rest, t, If.low.at(rest, t))
          %pi.count_cons(u, I, i) : {If.count(t <> u <> rest, i) == _ : Nat}
          %pi.count_ins_go(rest, t, If.low.at(rest, t), i) : {If.count(t <> u <> rest, i) == pi.cnt(bu, _) : Nat}
          %pi.count_cons(t, rest, i) : {If.count(t <> u <> rest, i) == pi.cnt(bu, _) : Nat}
          %pi.count_cons(t, u <> rest, i) : {_ == pi.cnt(bu, pi.cnt(bt, If.count(rest, i))) : Nat}
          %pi.count_cons(u, rest, i) : {pi.cnt(bt, _) == pi.cnt(bu, pi.cnt(bt, If.count(rest, i))) : Nat}
          pi.cnt_comm(bt, bu, If.count(rest, i))

# ranking keeps every count
def pi.count_rank(+ts: List<&2, If.Tool>, +i: Nat) -> {If.count(ts, i) == If.count(If.rank(ts), i) : Nat}:
  match ts:
    case Nil{}:
      {==}
    case t <> rest:
      +R = If.rank(rest)
      %pi.count_ins_go(R, t, If.low.at(R, t), i) : {If.count(t <> rest, i) == _ : Nat}
      %pi.count_cons(t, R, i) : {If.count(t <> rest, i) == _ : Nat}
      %pi.count_cons(t, rest, i) : {_ == pi.cnt(Nat.is_eq(If.Tool.id(t), i), If.count(R, i)) : Nat}
      %pi.count_rank(rest, i) : {pi.cnt(Nat.is_eq(If.Tool.id(t), i), If.count(rest, i)) == pi.cnt(Nat.is_eq(If.Tool.id(t), i), _) : Nat}
      {==}

def pi.strict_keeps_every_tool(+cap: Nat, +ts: List<&2, If.Tool>, +i: Nat) -> {Nat.add(If.count(Pair.fst(List<&2, If.Tool>, List<&2, If.Tool>, If.strict(cap, ts)), i), If.count(Pair.snd(List<&2, If.Tool>, List<&2, If.Tool>, If.strict(cap, ts)), i)) == If.count(ts, i) : Nat}:
  +R = If.rank(ts)
  Equal.trans(Nat, Nat.add(If.count(List.take(&2, If.Tool, R, cap), i), If.count(List.drop(&2, If.Tool, R, cap), i)), If.count(R, i), If.count(ts, i), pi.count_split(R, cap, i), Equal.sym(Nat, If.count(ts, i), If.count(R, i), pi.count_rank(ts, i)))

# every tool of ys has a priority of at most p
def pi.below(ys: List<&2, If.Tool>, +p: Nat) -> Bool:
  match ys:
    case Nil{}:
      True{}
    case +y <> rest:
      Bool.and(Nat.is_le(If.Tool.prio(y), p), pi.below(rest, p))

# priorities never rise along xs
def pi.sorted(xs: List<&2, If.Tool>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case +x <> +rest:
      Bool.and(pi.below(rest, If.Tool.prio(x)), pi.sorted(rest))

def pi.below_mono(+ys: List<&2, If.Tool>, +p: Nat, +q: Nat, +b: {pi.below(ys, p) == True{} : Bool}, +le: {Nat.is_le(p, q) == True{} : Bool}) -> {pi.below(ys, q) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case y <> rest:
      +a = Nat.is_le(If.Tool.prio(y), p)
      pi.and_t(Nat.is_le(If.Tool.prio(y), q), pi.below(rest, q), pi.le_trans(If.Tool.prio(y), p, q, pi.and_l(a, pi.below(rest, p), b), le), pi.below_mono(rest, p, q, pi.and_r(a, pi.below(rest, p), b), le))

def pi.below_ins_go(+xs: List<&2, If.Tool>, +t: If.Tool, hit: Bool, +P: Nat, +b: {pi.below(xs, P) == True{} : Bool}, +lt: {Nat.is_le(If.Tool.prio(t), P) == True{} : Bool}) -> {pi.below(If.ins.go(xs, t, hit), P) == True{} : Bool}:
  match xs:
    case Nil{}:
      pi.and_t(Nat.is_le(If.Tool.prio(t), P), True{}, lt, {==})
    case u <> rest:
      match hit:
        case True{}:
          pi.and_t(Nat.is_le(If.Tool.prio(t), P), pi.below(u <> rest, P), lt, b)
        case False{}:
          +a = Nat.is_le(If.Tool.prio(u), P)
          +I = If.ins.go(rest, t, If.low.at(rest, t))
          pi.and_t(a, pi.below(I, P), pi.and_l(a, pi.below(rest, P), b), pi.below_ins_go(rest, t, If.low.at(rest, t), P, pi.and_r(a, pi.below(rest, P), b), lt))

def pi.sorted_ins_go(+xs: List<&2, If.Tool>, +t: If.Tool, hit: Bool, +eh: {If.low.at(xs, t) == hit : Bool}, +s: {pi.sorted(xs) == True{} : Bool}) -> {pi.sorted(If.ins.go(xs, t, hit)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case u <> rest:
      match hit:
        case True{}:
          +pu = If.Tool.prio(u)
          +pt = If.Tool.prio(t)
          +le = eh
          +bu = pi.and_t(Nat.is_le(pu, pt), pi.below(rest, pt), le, pi.below_mono(rest, pu, pt, pi.and_l(pi.below(rest, pu), pi.sorted(rest), s), le))
          pi.and_t(pi.below(u <> rest, pt), pi.sorted(u <> rest), bu, s)
        case False{}:
          +pu = If.Tool.prio(u)
          +pt = If.Tool.prio(t)
          +I = If.ins.go(rest, t, If.low.at(rest, t))
          +bi = pi.below_ins_go(rest, t, If.low.at(rest, t), pu, pi.and_l(pi.below(rest, pu), pi.sorted(rest), s), pi.nle_le(pu, pt, eh))
          pi.and_t(pi.below(I, pu), pi.sorted(I), bi, pi.sorted_ins_go(rest, t, If.low.at(rest, t), {==}, pi.and_r(pi.below(rest, pu), pi.sorted(rest), s)))

# ranking sorts by priority
def pi.sorted_rank(+ts: List<&2, If.Tool>) -> {pi.sorted(If.rank(ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case t <> rest:
      +R = If.rank(rest)
      pi.sorted_ins_go(R, t, If.low.at(R, t), {==}, pi.sorted_rank(rest))

def pi.dom_nil(+ys: List<&2, If.Tool>) -> {If.dominates(Nil{}, ys) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case y <> rest:
      pi.dom_nil(rest)

def pi.dom_cons(+h: If.Tool, +X: List<&2, If.Tool>, +Y: List<&2, If.Tool>, +d: {If.dominates(X, Y) == True{} : Bool}, +b: {pi.below(Y, If.Tool.prio(h)) == True{} : Bool}) -> {If.dominates(h <> X, Y) == True{} : Bool}:
  match Y:
    case Nil{}:
      {==}
    case y <> rest:
      +py = If.Tool.prio(y)
      +ph = If.Tool.prio(h)
      +le = pi.and_l(Nat.is_le(py, ph), pi.below(rest, ph), b)
      +ag = pi.and_l(If.all_ge(X, py), If.dominates(X, rest), d)
      pi.and_t(If.all_ge(h <> X, py), If.dominates(h <> X, rest), pi.and_t(Nat.is_le(py, ph), If.all_ge(X, py), le, ag), pi.dom_cons(h, X, rest, pi.and_r(If.all_ge(X, py), If.dominates(X, rest), d), pi.and_r(Nat.is_le(py, ph), pi.below(rest, ph), b)))

def pi.below_drop(+xs: List<&2, If.Tool>, +n: Nat, +p: Nat, +b: {pi.below(xs, p) == True{} : Bool}) -> {pi.below(List.drop(&2, If.Tool, xs, n), p) == True{} : Bool}:
  match xs n:
    case Nil{} _:
      {==}
    case h <> t 0n:
      b
    case h <> t 1n+q:
      pi.below_drop(t, q, p, pi.and_r(Nat.is_le(If.Tool.prio(h), p), pi.below(t, p), b))

# a sorted list's take dominates its drop
def pi.dom_split(+xs: List<&2, If.Tool>, +n: Nat, +s: {pi.sorted(xs) == True{} : Bool}) -> {If.dominates(List.take(&2, If.Tool, xs, n), List.drop(&2, If.Tool, xs, n)) == True{} : Bool}:
  match xs n:
    case Nil{} _:
      {==}
    case h <> t 0n:
      pi.dom_nil(h <> t)
    case h <> t 1n+q:
      +ph = If.Tool.prio(h)
      pi.dom_cons(h, List.take(&2, If.Tool, t, q), List.drop(&2, If.Tool, t, q), pi.dom_split(t, q, pi.and_r(pi.below(t, ph), pi.sorted(t), s)), pi.below_drop(t, q, ph, pi.and_l(pi.below(t, ph), pi.sorted(t), s)))

def pi.strict_by_priority(+cap: Nat, +ts: List<&2, If.Tool>) -> {If.dominates(Pair.fst(List<&2, If.Tool>, List<&2, If.Tool>, If.strict(cap, ts)), Pair.snd(List<&2, If.Tool>, List<&2, If.Tool>, If.strict(cap, ts))) == True{} : Bool}:
  pi.dom_split(If.rank(ts), cap, pi.sorted_rank(ts))

# More numbers
# ------------

def pi.eq_true(+a: Nat, +b: Nat, +h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pi.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pi.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pi.eq_true(p, q, h))

def pi.add_zero(+a: Nat) -> {a == Nat.add(a, 0n) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, n => 1n+n, p, Nat.add(p, 0n), pi.add_zero(p))

def pi.add_succ(+a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, n => 1n+n, Nat.add(p, 1n+b), 1n+Nat.add(p, b), pi.add_succ(p, b))

def pi.le_refl(+a: Nat) -> {Nat.is_le(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pi.le_refl(p)

def pi.le_succ_r(+a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n _:
      {==}
    case 1n+p 0n:
      pi.absurdF({Nat.is_le(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pi.le_succ_r(p, q, h)

def pi.le_add(+a: Nat, +s: Nat) -> {Nat.is_le(a, Nat.add(a, s)) == True{} : Bool}:
  match a:
    case 0n:
      pi.le0(s)
    case 1n+p:
      pi.le_add(p, s)

def pi.le_add_r(+r: Nat, +s: Nat) -> {Nat.is_le(s, Nat.add(r, s)) == True{} : Bool}:
  match r:
    case 0n:
      pi.le_refl(s)
    case 1n+p:
      pi.le_succ_r(s, Nat.add(p, s), pi.le_add_r(p, s))

def pi.nle_lt(+a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == False{} : Bool}) -> {Nat.is_lt(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      pi.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      pi.absurd({Nat.is_lt(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pi.nle_lt(p, q, h)

def pi.lt_nle(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(b, a) == False{} : Bool}:
  match a b:
    case 0n 0n:
      pi.absurdF({Nat.is_le(0n, 0n) == False{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      pi.absurdF({Nat.is_le(0n, 1n+p) == False{} : Bool}, h)
    case 1n+p 1n+q:
      pi.lt_nle(p, q, h)

def pi.lt_zero(+a: Nat, +h: {Nat.is_lt(a, 0n) == True{} : Bool}) -> Empty:
  match a:
    case 0n:
      pi.absurdF(Empty, h)
    case 1n+p:
      pi.absurdF(Empty, h)

def pi.lt_succ(+a: Nat) -> {Nat.is_lt(a, 1n+a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pi.lt_succ(p)

def pi.lt_succ_r(+a: Nat, +b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      pi.absurdF({Nat.is_lt(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pi.lt_succ_r(p, q, h)

def pi.or_r_true(a: Bool, +b: Bool, +h: {Bool.or(a, b) == True{} : Bool}, +ea: {a == False{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      pi.absurd({b == True{} : Bool}, ea)
    case False{}:
      h

# The repetition guard
# --------------------

def pi.or_tl(a: Bool, +b: Bool, h: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pi.absurdF({Bool.or(False{}, b) == True{} : Bool}, h)

def pi.or_tr(a: Bool, +b: Bool, h: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

# one chunk more: each and the counter take the same step
def pi.each_step(b: Bool, +x: Nat, +rest: List<&2, Nat>, +q: Nat, +n: Nat, +ih: {If.each(rest, q, n) == Nat.is_le(n, If.cycle(rest, q)) : Bool}) -> {Bool.and(b, If.each(rest, q, n)) == Nat.is_le(1n+n, If.cycle.go(x <> rest, q, b)) : Bool}:
  match b:
    case True{}:
      ih
    case False{}:
      {==}

# the first m chunks each equal the chunk 1+q before them exactly when the
# counter of period 1+q is at least m
def pi.each_cycle(+s: List<&2, Nat>, +q: Nat, +m: Nat) -> {If.each(s, q, m) == Nat.is_le(m, If.cycle(s, q)) : Bool}:
  match s m:
    case _ 0n:
      Equal.sym(Bool, Nat.is_le(0n, If.cycle(s, q)), True{}, pi.le0(If.cycle(s, q)))
    case Nil{} 1n+n:
      {==}
    case x <> rest 1n+n:
      pi.each_step(If.back(rest, q, x), x, rest, q, n, pi.each_cycle(rest, q, n))

# the counters fire exactly when the window is periodic
def pi.fires_periodic(+s: List<&2, Nat>, +k: Nat, +n: Nat) -> {If.fires.go(s, k, n) == If.periodic.go(s, k, n) : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+q:
      %pi.each_cycle(s, q, Nat.sub(k, 1n+q)) : {Bool.or(_, If.fires.go(s, k, q)) == Bool.or(If.each(s, q, Nat.sub(k, 1n+q)), If.periodic.go(s, k, q)) : Bool}
      %Equal.sym(Bool, If.fires.go(s, k, q), If.periodic.go(s, k, q), pi.fires_periodic(s, k, q)) : {Bool.or(If.each(s, q, Nat.sub(k, 1n+q)), _) == Bool.or(If.each(s, q, Nat.sub(k, 1n+q)), If.periodic.go(s, k, q)) : Bool}
      {==}

# a guard that has not cut yet cuts a stream with a periodic window
def pi.cut_go(+xs: List<&2, Nat>, +k: Nat, +seen: List<&2, Nat>, +n: Nat, hit: Bool, +eh: {If.fire.at(xs, k, seen) == hit : Bool}, +lp: {If.loops.go(xs, k, seen) == True{} : Bool}) -> {If.Cut.cut(If.guard.go(xs, k, seen, n, hit)) == True{} : Bool}:
  match xs:
    case Nil{}:
      pi.absurdF({If.Cut.cut(If.guard.go(Nil{}, k, seen, n, hit)) == True{} : Bool}, lp)
    case x <> rest:
      match hit:
        case True{}:
          {==}
        case False{}:
          +ep = Equal.trans(Bool, If.periodic(x <> seen, k), If.fires(x <> seen, k), False{}, Equal.sym(Bool, If.fires(x <> seen, k), If.periodic(x <> seen, k), pi.fires_periodic(x <> seen, k, If.periods(k))), eh)
          pi.cut_go(rest, k, x <> seen, 1n+n, If.fire.at(rest, k, x <> seen), {==}, pi.or_r_true(If.periodic(x <> seen, k), If.loops.go(rest, k, x <> seen), lp, ep))

# a guard on a stream with no periodic window never cuts
def pi.keep_go(+xs: List<&2, Nat>, +k: Nat, +seen: List<&2, Nat>, +n: Nat, hit: Bool, +eh: {If.fire.at(xs, k, seen) == hit : Bool}, +calm: {If.loops.go(xs, k, seen) == False{} : Bool}) -> {If.guard.go(xs, k, seen, n, hit) == If.Whole{} : If.Cut}:
  match xs:
    case Nil{}:
      {==}
    case x <> rest:
      match hit:
        case True{}:
          +cp = pi.or_l(If.periodic(x <> seen, k), If.loops.go(rest, k, x <> seen), calm)
          +fp = Equal.trans(Bool, If.fires(x <> seen, k), If.periodic(x <> seen, k), False{}, pi.fires_periodic(x <> seen, k, If.periods(k)), cp)
          pi.void({If.CutAt{1n+n} == If.Whole{} : If.Cut}, pi.flip(If.fires(x <> seen, k), eh, fp))
        case False{}:
          pi.keep_go(rest, k, x <> seen, 1n+n, If.fire.at(rest, k, x <> seen), {==}, pi.or_r(If.periodic(x <> seen, k), If.loops.go(rest, k, x <> seen), calm))

# period 1 is always checked
def pi.periodic_ge1(+s: List<&2, Nat>, +k: Nat, +r: Nat, +e: {If.each(s, 0n, Nat.sub(k, 1n)) == True{} : Bool}) -> {If.periodic.go(s, k, 1n+r) == True{} : Bool}:
  match r:
    case 0n:
      pi.or_tl(If.each(s, 0n, Nat.sub(k, 1n)), If.periodic.go(s, k, 0n), e)
    case 1n+t:
      pi.or_tr(If.each(s, 1n+t, Nat.sub(k, 2n+t)), If.periodic.go(s, k, 1n+t), pi.periodic_ge1(s, k, t, e))

def pi.periodic_one(+s: List<&2, Nat>, +k: Nat, q: Nat, +e: {If.each(s, 0n, Nat.sub(k, 1n)) == True{} : Bool}) -> {If.periodic.go(s, k, If.periods.of(q)) == True{} : Bool}:
  match q:
    case 0n:
      pi.periodic_ge1(s, k, 0n, e)
    case 1n+r:
      pi.periodic_ge1(s, k, r, e)

def pi.sub1_le(+k: Nat, +s: Nat, +h: {Nat.is_le(k, 1n+s) == True{} : Bool}) -> {Nat.is_le(Nat.sub(k, 1n), s) == True{} : Bool}:
  match k:
    case 0n:
      pi.le0(s)
    case 1n+j:
      match j:
        case 0n:
          pi.le0(s)
        case 1n+i:
          h

def pi.le_add0(+k: Nat, +run: Nat, +h: {Nat.is_le(k, Nat.add(run, 0n)) == True{} : Bool}) -> {Nat.is_le(k, run) == True{} : Bool}:
  %Equal.sym(Nat, run, Nat.add(run, 0n), pi.add_zero(run)) : {Nat.is_le(k, _) == True{} : Bool}
  h

# a run that reaches k - 1 with what continues it: one chunk more
def pi.run_h(e: Bool, +y: Nat, +r2: List<&2, Nat>, +x: Nat, +s: List<&2, Nat>, +K: Nat, +ee: {Nat.is_eq(y, x) == e : Bool}, +h: {Nat.is_le(K, Nat.add(If.cycle(x <> s, 0n), If.same_run.go(y <> r2, x, e))) == True{} : Bool}, +lt: {Nat.is_le(K, If.cycle(x <> s, 0n)) == False{} : Bool}) -> {Nat.is_le(K, Nat.add(If.cycle.go(y <> x <> s, 0n, e), If.same_run(r2, y))) == True{} : Bool}:
  match e:
    case True{}:
      %Equal.sym(Nat, y, x, pi.eq_true(y, x, ee)) : {Nat.is_le(K, 1n+Nat.add(If.cycle(x <> s, 0n), If.same_run(r2, _))) == True{} : Bool}
      %pi.add_succ(If.cycle(x <> s, 0n), If.same_run(r2, x)) : {Nat.is_le(K, _) == True{} : Bool}
      h
    case False{}:
      pi.void({Nat.is_le(K, Nat.add(If.cycle.go(y <> x <> s, 0n, False{}), If.same_run(r2, y))) == True{} : Bool}, pi.flip(Nat.is_le(K, If.cycle(x <> s, 0n)), pi.le_add0(K, If.cycle(x <> s, 0n), h), lt))

# a run of x whose counter of period 1, with the chunks that continue it,
# reaches k - 1 ends in a periodic window
def pi.run_loops(+rest: List<&2, Nat>, +k: Nat, +x: Nat, +s: List<&2, Nat>, c: Bool, +ec: {Nat.is_le(Nat.sub(k, 1n), If.cycle(x <> s, 0n)) == c : Bool}, +h: {Nat.is_le(Nat.sub(k, 1n), Nat.add(If.cycle(x <> s, 0n), If.same_run(rest, x))) == True{} : Bool}) -> {Bool.or(If.periodic(x <> s, k), If.loops.go(rest, k, x <> s)) == True{} : Bool}:
  match rest:
    case Nil{}:
      match c:
        case True{}:
          +e = Equal.trans(Bool, If.each(x <> s, 0n, Nat.sub(k, 1n)), Nat.is_le(Nat.sub(k, 1n), If.cycle(x <> s, 0n)), True{}, pi.each_cycle(x <> s, 0n, Nat.sub(k, 1n)), ec)
          pi.or_tl(If.periodic(x <> s, k), If.loops.go(Nil{}, k, x <> s), pi.periodic_one(x <> s, k, If.quarter(k), e))
        case False{}:
          pi.void({Bool.or(If.periodic(x <> s, k), If.loops.go(Nil{}, k, x <> s)) == True{} : Bool}, pi.flip(Nat.is_le(Nat.sub(k, 1n), If.cycle(x <> s, 0n)), pi.le_add0(Nat.sub(k, 1n), If.cycle(x <> s, 0n), h), ec))
    case y <> r2:
      match c:
        case True{}:
          +e = Equal.trans(Bool, If.each(x <> s, 0n, Nat.sub(k, 1n)), Nat.is_le(Nat.sub(k, 1n), If.cycle(x <> s, 0n)), True{}, pi.each_cycle(x <> s, 0n, Nat.sub(k, 1n)), ec)
          pi.or_tl(If.periodic(x <> s, k), If.loops.go(y <> r2, k, x <> s), pi.periodic_one(x <> s, k, If.quarter(k), e))
        case False{}:
          +h2 = pi.run_h(Nat.is_eq(y, x), y, r2, x, s, Nat.sub(k, 1n), {==}, h, ec)
          +r = pi.run_loops(r2, k, y, x <> s, Nat.is_le(Nat.sub(k, 1n), If.cycle(y <> x <> s, 0n)), {==}, h2)
          pi.or_tr(If.periodic(x <> s, k), If.loops.go(y <> r2, k, x <> s), r)

# a run that reaches k after its first chunk
def pi.rhead(xs: List<&2, Nat>, +k: Nat) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case x <> +rest:
      Nat.is_le(k, 1n+If.same_run(rest, x))

# a stream that repeats a chunk k times in a row has a periodic window
# (period 1)
def pi.rep_go(+xs: List<&2, Nat>, +k: Nat, +seen: List<&2, Nat>, c: Bool, +ec: {pi.rhead(xs, k) == c : Bool}, +rep: {If.repeats(xs, k) == True{} : Bool}) -> {If.loops.go(xs, k, seen) == True{} : Bool}:
  match xs:
    case Nil{}:
      pi.absurdF({If.loops.go(Nil{}, k, seen) == True{} : Bool}, rep)
    case x <> rest:
      match c:
        case True{}:
          +S = If.same_run(rest, x)
          +C = If.cycle(x <> seen, 0n)
          +h = pi.le_trans(Nat.sub(k, 1n), S, Nat.add(C, S), pi.sub1_le(k, S, ec), pi.le_add_r(C, S))
          pi.run_loops(rest, k, x, seen, Nat.is_le(Nat.sub(k, 1n), C), {==}, h)
        case False{}:
          +rr = pi.or_r_true(Nat.is_le(k, 1n+If.same_run(rest, x)), If.repeats(rest, k), rep, ec)
          pi.or_tr(If.periodic(x <> seen, k), If.loops.go(rest, k, x <> seen), pi.rep_go(rest, k, x <> seen, pi.rhead(rest, k), {==}, rr))

def pi.guard_cuts_loops(+xs: List<&2, Nat>, +k: Nat, lp: {If.loops(xs, k) == True{} : Bool}) -> {If.Cut.cut(If.guard(xs, k)) == True{} : Bool}:
  pi.cut_go(xs, k, Nil{}, 0n, If.fire.at(xs, k, Nil{}), {==}, lp)

def pi.guard_cuts_repeats(+xs: List<&2, Nat>, +k: Nat, rep: {If.repeats(xs, k) == True{} : Bool}) -> {If.Cut.cut(If.guard(xs, k)) == True{} : Bool}:
  pi.cut_go(xs, k, Nil{}, 0n, If.fire.at(xs, k, Nil{}), {==}, pi.rep_go(xs, k, Nil{}, pi.rhead(xs, k), {==}, rep))

def pi.guard_keeps_others(+xs: List<&2, Nat>, +k: Nat, calm: {If.loops(xs, k) == False{} : Bool}) -> {If.guard(xs, k) == If.Whole{} : If.Cut}:
  pi.keep_go(xs, k, Nil{}, 0n, If.fire.at(xs, k, Nil{}), {==}, calm)

# Early compaction
# ----------------

def pi.le_succ_false(+x: Nat, +lim: Nat, +h: {Nat.is_le(x, lim) == True{} : Bool}) -> {Nat.is_le(1n+lim, x) == False{} : Bool}:
  match x lim:
    case 0n _:
      {==}
    case 1n+p 0n:
      pi.absurdF({Nat.is_le(1n, 1n+p) == False{} : Bool}, h)
    case 1n+p 1n+q:
      pi.le_succ_false(p, q, h)

def pi.lt_sub(+x: Nat, +lim: Nat, +m: Nat, +h: {Nat.is_lt(x, Nat.sub(lim, m)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(x, m), lim) == True{} : Bool}:
  match lim m:
    case 0n _:
      pi.void({Nat.is_lt(Nat.add(x, m), 0n) == True{} : Bool}, pi.lt_zero(x, h))
    case 1n+a 0n:
      %pi.add_zero(x) : {Nat.is_lt(_, 1n+a) == True{} : Bool}
      h
    case 1n+a 1n+b:
      %Equal.sym(Nat, Nat.add(x, 1n+b), 1n+Nat.add(x, b), pi.add_succ(x, b)) : {Nat.is_lt(_, 1n+a) == True{} : Bool}
      pi.lt_sub(x, a, b, h)

# an index past i: the first reach from j > i
def pi.later(+xs: List<&2, Nat>, +t: Nat, +j: Nat, hit: Bool, +i: Nat, +lt: {Nat.is_lt(i, j) == True{} : Bool}) -> {If.m.lt(Some{i}, If.first_at.go(xs, t, j, hit)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case x <> rest:
      match hit:
        case True{}:
          lt
        case False{}:
          pi.later(rest, t, 1n+j, If.reach.at(rest, t), i, pi.lt_succ_r(i, j, lt))

# below the threshold, the next size stays within the limit
def pi.compact_go(+xs: List<&2, Nat>, +m: Nat, +lim: Nat, +prev: Nat, +i: Nat, hit: Bool, +eh: {If.reach.at(xs, Nat.sub(lim, m)) == hit : Bool}, +inv: {Nat.is_le(Nat.add(prev, m), lim) == True{} : Bool}, +st: {If.steps_le(xs, m, prev) == True{} : Bool}) -> {If.m.lt(If.first_at.go(xs, Nat.sub(lim, m), i, hit), If.first_at.go(xs, 1n+lim, i, If.reach.at(xs, 1n+lim))) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case x <> rest:
      match hit:
        case True{}:
          +xle = pi.le_trans(x, Nat.add(prev, m), lim, pi.and_l(Nat.is_le(x, Nat.add(prev, m)), If.steps_le(rest, m, x), st), inv)
          %Equal.sym(Bool, Nat.is_le(1n+lim, x), False{}, pi.le_succ_false(x, lim, xle)) : {If.m.lt(Some{i}, If.first_at.go(x <> rest, 1n+lim, i, _)) == True{} : Bool}
          pi.later(rest, 1n+lim, 1n+i, If.reach.at(rest, 1n+lim), i, pi.lt_succ(i))
        case False{}:
          +T = Nat.sub(lim, m)
          +xle = pi.le_trans(x, Nat.add(prev, m), lim, pi.and_l(Nat.is_le(x, Nat.add(prev, m)), If.steps_le(rest, m, x), st), inv)
          %Equal.sym(Bool, Nat.is_le(1n+lim, x), False{}, pi.le_succ_false(x, lim, xle)) : {If.m.lt(If.first_at.go(rest, T, 1n+i, If.reach.at(rest, T)), If.first_at.go(x <> rest, 1n+lim, i, _)) == True{} : Bool}
          +inv2 = pi.lt_le(Nat.add(x, m), lim, pi.lt_sub(x, lim, m, pi.nle_lt(T, x, eh)))
          pi.compact_go(rest, m, lim, x, 1n+i, If.reach.at(rest, T), {==}, inv2, pi.and_r(Nat.is_le(x, Nat.add(prev, m)), If.steps_le(rest, m, x), st))

def pi.compact_starts_early(+xs: List<&2, Nat>, +m: Nat, +lim: Nat, small: {Nat.is_le(m, lim) == True{} : Bool}, steps: {If.steps_le(xs, m, 0n) == True{} : Bool}) -> {If.m.lt(If.first_at(xs, Nat.sub(lim, m), 0n), If.first_at(xs, 1n+lim, 0n)) == True{} : Bool}:
  pi.compact_go(xs, m, lim, 0n, 0n, If.reach.at(xs, Nat.sub(lim, m)), {==}, small, steps)

# ---- effort ----

# proof_effort: the S10 laws (docs/inference.md) of the reasoning-depth
# model in bend/effort.bend.
#
# The offered levels are a filter of the ladder: a level that the filter
# drops (a null entry, a missing xhigh or max) is never in the result, a
# level in the result passes the filter, and a filter keeps the strict
# ascent of the ladder. A clamp keeps a level of the list and else finds
# one in the list, or the head of the list: so it lands in a non-empty
# list, and a second clamp keeps it. A cycle step enters at an offered
# level of a list of two or more; in an ascending list, the scan meets
# that level exactly once, so forward gives the level after it (the head
# after the last) and backward the level before it (the last before the
# head). Every offered level splits the list as pre ++ [l] ++ post, and
# these four steps undo each other. The session stores only fitted
# levels, and a fitted level fits to itself: what the session stores is
# what it sends and shows.
#
# A recursive proof takes the test of the head as a parameter (Bend
# matches only parameters); `pe.kat` computes the filter's test.

# Logic
# -----

def pe.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pe.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pe.BD(_, Unit, A)
  Unit{}

def pe.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pe.BD(_, A, Unit)
  Unit{}

def pe.void(-A: Type, e: Empty) -> A:
  match e:

def pe.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pe.absurdF({False{} == True{} : Bool}, h)

def pe.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pe.absurdF({b == True{} : Bool}, h)

def pe.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pe.or_r(x: Bool, +a: Bool, h: {a == True{} : Bool}) -> {Bool.or(x, a) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      h

# or(c, d) holds and c fails: d holds
def pe.or_l_false(c: Bool, +d: Bool, ec: {c == False{} : Bool}, h: {Bool.or(c, d) == True{} : Bool}) -> {d == True{} : Bool}:
  match c:
    case True{}:
      pe.absurd({d == True{} : Bool}, ec)
    case False{}:
      h

def pe.or_false_l(c: Bool, +d: Bool, h: {Bool.or(c, d) == False{} : Bool}) -> {c == False{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      {==}

def pe.or_false_r(c: Bool, +d: Bool, h: {Bool.or(c, d) == False{} : Bool}) -> {d == False{} : Bool}:
  match c:
    case True{}:
      pe.absurd({d == False{} : Bool}, h)
    case False{}:
      h

def pe.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      pe.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

# Numbers and levels
# ------------------

def pe.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pe.eq_refl(p)

def pe.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pe.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pe.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pe.eq_true(p, q, h))

# a number below another is not it
def pe.lt_ne(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      pe.absurdF({Nat.is_eq(0n, 0n) == False{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pe.lt_ne(p, q, h)

# the level at a ladder index
def pe.of(n: Nat) -> Ef.Lv:
  match n:
    case 0n:
      Ef.Off{}
    case 1n+a:
      match a:
        case 0n:
          Ef.Minimal{}
        case 1n+b:
          match b:
            case 0n:
              Ef.Low{}
            case 1n+c:
              match c:
                case 0n:
                  Ef.Medium{}
                case 1n+d:
                  match d:
                    case 0n:
                      Ef.High{}
                    case 1n+e:
                      match e:
                        case 0n:
                          Ef.Xhigh{}
                        case 1n+f:
                          Ef.Max{}

def pe.of_idx(l: Ef.Lv) -> {pe.of(Ef.Lv.idx(l)) == l : Ef.Lv}:
  match l:
    case Ef.Off{}:
      {==}
    case Ef.Minimal{}:
      {==}
    case Ef.Low{}:
      {==}
    case Ef.Medium{}:
      {==}
    case Ef.High{}:
      {==}
    case Ef.Xhigh{}:
      {==}
    case Ef.Max{}:
      {==}

def pe.lv_refl(+l: Ef.Lv) -> {True{} == Ef.Lv.eq(l, l) : Bool}:
  pe.eq_refl(Ef.Lv.idx(l))

def pe.lv_true(+a: Ef.Lv, +b: Ef.Lv, h: {Ef.Lv.eq(a, b) == True{} : Bool}) -> {a == b : Ef.Lv}:
  %pe.of_idx(b) : {a == _ : Ef.Lv}
  %pe.eq_true(Ef.Lv.idx(a), Ef.Lv.idx(b), h) : {a == pe.of(_) : Ef.Lv}
  Equal.sym(Ef.Lv, pe.of(Ef.Lv.idx(a)), a, pe.of_idx(a))

# Lists of levels
# ---------------

def pe.has_mid(pre: List<&2, Ef.Lv>, +a: Ef.Lv, +s: List<&2, Ef.Lv>) -> {Ef.has(List.append(&2, Ef.Lv, pre, a <> s), a) == True{} : Bool}:
  match pre:
    case Nil{}:
      %pe.lv_refl(a) : {Bool.or(_, Ef.has(s, a)) == True{} : Bool}
      {==}
    case +x <> +r:
      pe.or_r(Ef.Lv.eq(x, a), Ef.has(List.append(&2, Ef.Lv, r, a <> s), a), pe.has_mid(r, a, s))

def pe.has_app(pre: List<&2, Ef.Lv>, +s: List<&2, Ef.Lv>, +b: Ef.Lv, h: {Ef.has(s, b) == True{} : Bool}) -> {Ef.has(List.append(&2, Ef.Lv, pre, s), b) == True{} : Bool}:
  match pre:
    case Nil{}:
      h
    case +x <> +r:
      pe.or_r(Ef.Lv.eq(x, b), Ef.has(List.append(&2, Ef.Lv, r, s), b), pe.has_app(r, s, b, h))

# a level of ys is above index k when every level of ys is
def pe.above_in(+k: Nat, ys: List<&2, Ef.Lv>, +b: Ef.Lv, c: Bool, ec: {Ef.at(ys, b) == c : Bool}, +ha: {Ef.above(k, ys) == True{} : Bool}, hb: {Ef.has(ys, b) == True{} : Bool}) -> {Nat.is_lt(k, Ef.Lv.idx(b)) == True{} : Bool}:
  match ys:
    case Nil{}:
      pe.absurdF({Nat.is_lt(k, Ef.Lv.idx(b)) == True{} : Bool}, hb)
    case +y <> +r:
      match c:
        case True{}:
          %pe.lv_true(y, b, ec) : {Nat.is_lt(k, Ef.Lv.idx(_)) == True{} : Bool}
          pe.and_l(Nat.is_lt(k, Ef.Lv.idx(y)), Ef.above(k, r), ha)
        case False{}:
          pe.above_in(k, r, b, Ef.at(r, b), {==}, pe.and_r(Nat.is_lt(k, Ef.Lv.idx(y)), Ef.above(k, r), ha), pe.or_l_false(Ef.Lv.eq(y, b), Ef.has(r, b), ec, hb))

# in an ascending pre ++ s, no level of s is in pre
def pe.asc_notin(pre: List<&2, Ef.Lv>, +s: List<&2, Ef.Lv>, +b: Ef.Lv, +h: {Ef.asc(List.append(&2, Ef.Lv, pre, s)) == True{} : Bool}, +hb: {Ef.has(s, b) == True{} : Bool}) -> {Ef.has(pre, b) == False{} : Bool}:
  match pre:
    case Nil{}:
      {==}
    case +x <> +r:
      +rs = List.append(&2, Ef.Lv, r, s)
      +lt = pe.above_in(Ef.Lv.idx(x), rs, b, Ef.at(rs, b), {==}, pe.and_l(Ef.above(Ef.Lv.idx(x), rs), Ef.asc(rs), h), pe.has_app(r, s, b, hb))
      %Equal.sym(Bool, Ef.Lv.eq(x, b), False{}, pe.lt_ne(Ef.Lv.idx(x), Ef.Lv.idx(b), lt)) : {Bool.or(_, Ef.has(r, b)) == False{} : Bool}
      pe.asc_notin(r, s, b, pe.and_r(Ef.above(Ef.Lv.idx(x), rs), Ef.asc(rs), h), hb)

# a suffix of an ascending list ascends
def pe.asc_suf(pre: List<&2, Ef.Lv>, +s: List<&2, Ef.Lv>, h: {Ef.asc(List.append(&2, Ef.Lv, pre, s)) == True{} : Bool}) -> {Ef.asc(s) == True{} : Bool}:
  match pre:
    case Nil{}:
      h
    case +x <> +r:
      +rs = List.append(&2, Ef.Lv, r, s)
      pe.asc_suf(r, s, pe.and_r(Ef.above(Ef.Lv.idx(x), rs), Ef.asc(rs), h))

def pe.asc_tr(-xs: List<&2, Ef.Lv>, -ys: List<&2, Ef.Lv>, e: {xs == ys : List<&2, Ef.Lv>}, h: {Ef.asc(xs) == True{} : Bool}) -> {Ef.asc(ys) == True{} : Bool}:
  %e : {Ef.asc(_) == True{} : Bool}
  h

def pe.last_snoc(xs: List<&2, Ef.Lv>, +l: Ef.Lv, d: Ef.Lv) -> {Ef.last(List.append(&2, Ef.Lv, xs, [l]), d) == l : Ef.Lv}:
  match xs:
    case Nil{}:
      {==}
    case x <> r:
      pe.last_snoc(r, l, x)

def pe.app_snoc(xs: List<&2, Ef.Lv>, +a: Ef.Lv, +ys: List<&2, Ef.Lv>) -> {List.append(&2, Ef.Lv, List.append(&2, Ef.Lv, xs, [a]), ys) == List.append(&2, Ef.Lv, xs, a <> ys) : List<&2, Ef.Lv>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      Equal.cong(List<&2, Ef.Lv>, List<&2, Ef.Lv>, zs => x <> zs, List.append(&2, Ef.Lv, List.append(&2, Ef.Lv, r, [a]), ys), List.append(&2, Ef.Lv, r, a <> ys), pe.app_snoc(r, a, ys))

# x <> r without its last level
def pe.init(r: List<&2, Ef.Lv>, x: Ef.Lv) -> List<&2, Ef.Lv>:
  match r:
    case Nil{}:
      Nil{}
    case y <> s:
      x <> pe.init(s, y)

def pe.init_last(r: List<&2, Ef.Lv>, +x: Ef.Lv) -> {x <> r == List.append(&2, Ef.Lv, pe.init(r, x), [Ef.last(r, x)]) : List<&2, Ef.Lv>}:
  match r:
    case Nil{}:
      {==}
    case +y <> +s:
      Equal.cong(List<&2, Ef.Lv>, List<&2, Ef.Lv>, zs => x <> zs, y <> s, List.append(&2, Ef.Lv, pe.init(s, y), [Ef.last(s, y)]), pe.init_last(s, y))

# The offered levels
# ------------------

# the filter's test of the head of xs
def pe.kat(+map: Ef.LvMap, xs: List<&2, Ef.Lv>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case x <> rest:
      Ef.keep(map, x)

# a level the filter drops is not in its result
def pe.offer_out(+map: Ef.LvMap, xs: List<&2, Ef.Lv>, +l: Ef.Lv, b: Bool, eb: {pe.kat(map, xs) == b : Bool}, c: Bool, ec: {Ef.at(xs, l) == c : Bool}, +nk: {Ef.keep(map, l) == False{} : Bool}) -> {Ef.has(Ef.offer(map, xs), l) == False{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      match b:
        case True{}:
          match c:
            case True{}:
              +same = Equal.cong(Ef.Lv, Bool, v => Ef.keep(map, v), x, l, pe.lv_true(x, l, ec))
              pe.absurd({Ef.has(Ef.offer(map, x <> r), l) == False{} : Bool}, Equal.trans(Bool, True{}, Ef.keep(map, l), False{}, Equal.trans(Bool, True{}, Ef.keep(map, x), Ef.keep(map, l), Equal.sym(Bool, Ef.keep(map, x), True{}, eb), same), nk))
            case False{}:
              %Equal.sym(Bool, Ef.keep(map, x), True{}, eb) : {Ef.has(Ef.cons_if(_, x, Ef.offer(map, r)), l) == False{} : Bool}
              %Equal.sym(Bool, Ef.Lv.eq(x, l), False{}, ec) : {Bool.or(_, Ef.has(Ef.offer(map, r), l)) == False{} : Bool}
              pe.offer_out(map, r, l, pe.kat(map, r), {==}, Ef.at(r, l), {==}, nk)
        case False{}:
          %Equal.sym(Bool, Ef.keep(map, x), False{}, eb) : {Ef.has(Ef.cons_if(_, x, Ef.offer(map, r)), l) == False{} : Bool}
          pe.offer_out(map, r, l, pe.kat(map, r), {==}, Ef.at(r, l), {==}, nk)

# a level in the filter's result passes the filter
def pe.offer_in.at(+map: Ef.LvMap, +xs: List<&2, Ef.Lv>, +l: Ef.Lv, k: Bool, ek: {Ef.keep(map, l) == k : Bool}, h: {Ef.has(Ef.offer(map, xs), l) == True{} : Bool}) -> {Ef.keep(map, l) == True{} : Bool}:
  match k:
    case True{}:
      ek
    case False{}:
      +out = pe.offer_out(map, xs, l, pe.kat(map, xs), {==}, Ef.at(xs, l), {==}, ek)
      pe.absurd({Ef.keep(map, l) == True{} : Bool}, Equal.trans(Bool, True{}, Ef.has(Ef.offer(map, xs), l), False{}, Equal.sym(Bool, Ef.has(Ef.offer(map, xs), l), True{}, h), out))

def pe.offer_in(+map: Ef.LvMap, +xs: List<&2, Ef.Lv>, +l: Ef.Lv, h: {Ef.has(Ef.offer(map, xs), l) == True{} : Bool}) -> {Ef.keep(map, l) == True{} : Bool}:
  pe.offer_in.at(map, xs, l, Ef.keep(map, l), {==}, h)

def pe.offer_above(+k: Nat, +map: Ef.LvMap, xs: List<&2, Ef.Lv>, b: Bool, eb: {pe.kat(map, xs) == b : Bool}, +ha: {Ef.above(k, xs) == True{} : Bool}) -> {Ef.above(k, Ef.offer(map, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      match b:
        case True{}:
          %Equal.sym(Bool, Ef.keep(map, x), True{}, eb) : {Ef.above(k, Ef.cons_if(_, x, Ef.offer(map, r))) == True{} : Bool}
          +ih = pe.offer_above(k, map, r, pe.kat(map, r), {==}, pe.and_r(Nat.is_lt(k, Ef.Lv.idx(x)), Ef.above(k, r), ha))
          pe.and_t(Nat.is_lt(k, Ef.Lv.idx(x)), Ef.above(k, Ef.offer(map, r)), pe.and_l(Nat.is_lt(k, Ef.Lv.idx(x)), Ef.above(k, r), ha), ih)
        case False{}:
          %Equal.sym(Bool, Ef.keep(map, x), False{}, eb) : {Ef.above(k, Ef.cons_if(_, x, Ef.offer(map, r))) == True{} : Bool}
          pe.offer_above(k, map, r, pe.kat(map, r), {==}, pe.and_r(Nat.is_lt(k, Ef.Lv.idx(x)), Ef.above(k, r), ha))

def pe.offer_asc(+map: Ef.LvMap, xs: List<&2, Ef.Lv>, b: Bool, eb: {pe.kat(map, xs) == b : Bool}, +h: {Ef.asc(xs) == True{} : Bool}) -> {Ef.asc(Ef.offer(map, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      match b:
        case True{}:
          %Equal.sym(Bool, Ef.keep(map, x), True{}, eb) : {Ef.asc(Ef.cons_if(_, x, Ef.offer(map, r))) == True{} : Bool}
          +ih = pe.offer_asc(map, r, pe.kat(map, r), {==}, pe.and_r(Ef.above(Ef.Lv.idx(x), r), Ef.asc(r), h))
          +ab = pe.offer_above(Ef.Lv.idx(x), map, r, pe.kat(map, r), {==}, pe.and_l(Ef.above(Ef.Lv.idx(x), r), Ef.asc(r), h))
          pe.and_t(Ef.above(Ef.Lv.idx(x), Ef.offer(map, r)), Ef.asc(Ef.offer(map, r)), ab, ih)
        case False{}:
          %Equal.sym(Bool, Ef.keep(map, x), False{}, eb) : {Ef.asc(Ef.cons_if(_, x, Ef.offer(map, r))) == True{} : Bool}
          pe.offer_asc(map, r, pe.kat(map, r), {==}, pe.and_r(Ef.above(Ef.Lv.idx(x), r), Ef.asc(r), h))

# a level of xs that passes the filter is in its result
def pe.offer_keep(+map: Ef.LvMap, xs: List<&2, Ef.Lv>, +l: Ef.Lv, b: Bool, eb: {pe.kat(map, xs) == b : Bool}, c: Bool, +ec: {Ef.at(xs, l) == c : Bool}, +k: {Ef.keep(map, l) == True{} : Bool}, in: {Ef.has(xs, l) == True{} : Bool}) -> {Ef.has(Ef.offer(map, xs), l) == True{} : Bool}:
  match xs:
    case Nil{}:
      pe.absurdF({Ef.has(Nil{}, l) == True{} : Bool}, in)
    case +x <> +r:
      match b:
        case True{}:
          match c:
            case True{}:
              %Equal.sym(Bool, Ef.keep(map, x), True{}, eb) : {Ef.has(Ef.cons_if(_, x, Ef.offer(map, r)), l) == True{} : Bool}
              %Equal.sym(Bool, Ef.Lv.eq(x, l), True{}, ec) : {Bool.or(_, Ef.has(Ef.offer(map, r), l)) == True{} : Bool}
              {==}
            case False{}:
              %Equal.sym(Bool, Ef.keep(map, x), True{}, eb) : {Ef.has(Ef.cons_if(_, x, Ef.offer(map, r)), l) == True{} : Bool}
              %Equal.sym(Bool, Ef.Lv.eq(x, l), False{}, ec) : {Bool.or(_, Ef.has(Ef.offer(map, r), l)) == True{} : Bool}
              pe.offer_keep(map, r, l, pe.kat(map, r), {==}, Ef.at(r, l), {==}, k, pe.or_l_false(Ef.Lv.eq(x, l), Ef.has(r, l), ec, in))
        case False{}:
          match c:
            case True{}:
              +same = Equal.cong(Ef.Lv, Bool, v => Ef.keep(map, v), x, l, pe.lv_true(x, l, ec))
              pe.absurdF({Ef.has(Ef.offer(map, x <> r), l) == True{} : Bool}, Equal.trans(Bool, False{}, Ef.keep(map, l), True{}, Equal.trans(Bool, False{}, Ef.keep(map, x), Ef.keep(map, l), Equal.sym(Bool, Ef.keep(map, x), False{}, eb), same), k))
            case False{}:
              %Equal.sym(Bool, Ef.keep(map, x), False{}, eb) : {Ef.has(Ef.cons_if(_, x, Ef.offer(map, r)), l) == True{} : Bool}
              pe.offer_keep(map, r, l, pe.kat(map, r), {==}, Ef.at(r, l), {==}, k, pe.or_l_false(Ef.Lv.eq(x, l), Ef.has(r, l), ec, in))

# every level is on the ladder
def pe.on_ladder(l: Ef.Lv) -> {Ef.has(Ef.ladder(), l) == True{} : Bool}:
  match l:
    case Ef.Off{}:
      {==}
    case Ef.Minimal{}:
      {==}
    case Ef.Low{}:
      {==}
    case Ef.Medium{}:
      {==}
    case Ef.High{}:
      {==}
    case Ef.Xhigh{}:
      {==}
    case Ef.Max{}:
      {==}

# a level kept with entry e that is xhigh or max has a wire entry
def pe.wire(+l: Ef.Lv, e: Ef.Ent, x: {Ef.ext(l) == True{} : Bool}, k: {Ef.keep.e(l, e) == True{} : Bool}) -> {e == Ef.Wire{} : Ef.Ent}:
  match e:
    case Ef.Missing{}:
      +nx = pe.not_t(Ef.ext(l), k)
      pe.absurd({Ef.Missing{} == Ef.Wire{} : Ef.Ent}, Equal.trans(Bool, True{}, Ef.ext(l), False{}, Equal.sym(Bool, Ef.ext(l), True{}, x), nx))
    case Ef.Null{}:
      pe.absurdF({Ef.Null{} == Ef.Wire{} : Ef.Ent}, k)
    case Ef.Wire{}:
      {==}

def pe.or_false_t(c: Bool, h: {Bool.or(c, False{}) == True{} : Bool}) -> {c == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      h

# The clamp
# ---------

def pe.first_in(lad: List<&2, Ef.Lv>, ne: {Ef.empty(lad) == False{} : Bool}) -> {Ef.has(lad, Ef.first(lad, Ef.Off{})) == True{} : Bool}:
  match lad:
    case Nil{}:
      pe.absurd({Ef.has(Nil{}, Ef.Off{}) == True{} : Bool}, ne)
    case +h <> t:
      %pe.lv_refl(h) : {Bool.or(_, Ef.has(t, h)) == True{} : Bool}
      {==}

def pe.find_in(xs: List<&2, Ef.Lv>, +lad: List<&2, Ef.Lv>, +d: Ef.Lv, hit: Bool, eh: {Ef.in.at(xs, lad) == hit : Bool}, hd: {Ef.has(lad, d) == True{} : Bool}) -> {Ef.has(lad, Ef.find.go(xs, lad, d, hit)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hd
    case +x <> +r:
      match hit:
        case True{}:
          eh
        case False{}:
          pe.find_in(r, lad, d, Ef.in.at(r, lad), {==}, hd)

def pe.find_nil(xs: List<&2, Ef.Lv>, +d: Ef.Lv, hit: Bool, eh: {Ef.in.at(xs, Nil{}) == hit : Bool}) -> {Ef.find.go(xs, Nil{}, d, hit) == d : Ef.Lv}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      match hit:
        case True{}:
          pe.absurdF({x == d : Ef.Lv}, eh)
        case False{}:
          pe.find_nil(r, d, Ef.in.at(r, Nil{}), {==})

def pe.clamp_in.at(b: Bool, +lad: List<&2, Ef.Lv>, +l: Ef.Lv, eb: {Ef.has(lad, l) == b : Bool}, ne: {Ef.empty(lad) == False{} : Bool}) -> {Ef.has(lad, Ef.clamp.at(b, l, lad)) == True{} : Bool}:
  match b:
    case True{}:
      eb
    case False{}:
      pe.find_in(Ef.scan(l), lad, Ef.first(lad, Ef.Off{}), Ef.in.at(Ef.scan(l), lad), {==}, pe.first_in(lad, ne))

def pe.clamp_in(+lad: List<&2, Ef.Lv>, +l: Ef.Lv, ne: {Ef.empty(lad) == False{} : Bool}) -> {Ef.has(lad, Ef.clamp.in(lad, l)) == True{} : Bool}:
  pe.clamp_in.at(Ef.has(lad, l), lad, l, {==}, ne)

def pe.clamp_keep(+lad: List<&2, Ef.Lv>, +l: Ef.Lv, in: {Ef.has(lad, l) == True{} : Bool}) -> {Ef.clamp.in(lad, l) == l : Ef.Lv}:
  %Equal.sym(Bool, Ef.has(lad, l), True{}, in) : {Ef.clamp.at(_, l, lad) == l : Ef.Lv}
  {==}

def pe.clamp_nil(+l: Ef.Lv) -> {Ef.clamp.in(Nil{}, l) == Ef.Off{} : Ef.Lv}:
  pe.find_nil(Ef.scan(l), Ef.Off{}, Ef.in.at(Ef.scan(l), Nil{}), {==})

def pe.clamp_idem(lad: List<&2, Ef.Lv>, +l: Ef.Lv) -> {Ef.clamp.in(lad, Ef.clamp.in(lad, l)) == Ef.clamp.in(lad, l) : Ef.Lv}:
  match lad:
    case Nil{}:
      %Equal.sym(Ef.Lv, Ef.clamp.in(Nil{}, l), Ef.Off{}, pe.clamp_nil(l)) : {Ef.clamp.in(Nil{}, _) == _ : Ef.Lv}
      pe.clamp_nil(Ef.Off{})
    case +h <> +t:
      pe.clamp_keep(h <> t, Ef.clamp.in(h <> t, l), pe.clamp_in(h <> t, l, {==}))

# The cycle
# ---------

def pe.two_app(+x: Ef.Lv, r: List<&2, Ef.Lv>, +a: Ef.Lv, +s: List<&2, Ef.Lv>) -> {Ef.two(x <> List.append(&2, Ef.Lv, r, a <> s)) == True{} : Bool}:
  match r:
    case Nil{}:
      {==}
    case y <> q:
      {==}

def pe.two_mid(pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>) -> {Ef.two(List.append(&2, Ef.Lv, pre, a <> b <> post)) == True{} : Bool}:
  match pre:
    case Nil{}:
      {==}
    case x <> r:
      pe.two_app(x, r, a, b <> post)

# a step of a list of two or more from a level of the list starts there
def pe.enter(+lad: List<&2, Ef.Lv>, +c: Ef.Lv, +d: Ef.Dir, tw: {Ef.two(lad) == True{} : Bool}, in: {Ef.has(lad, c) == True{} : Bool}) -> {Ef.cycle.in(lad, c, d) == Ef.move(d, lad, c) : Maybe<&2, Ef.Lv>}:
  %Equal.sym(Bool, Ef.two(lad), True{}, tw) : {Ef.cycle.at(_, lad, c, d) == Ef.move(d, lad, c) : Maybe<&2, Ef.Lv>}
  %Equal.sym(Ef.Lv, Ef.clamp.in(lad, c), c, pe.clamp_keep(lad, c, in)) : {Ef.move(d, lad, _) == Ef.move(d, lad, c) : Maybe<&2, Ef.Lv>}
  {==}

# forward from a, which pre lacks, gives the level after it
def pe.fwd_go(pre: List<&2, Ef.Lv>, +a: Ef.Lv, +post: List<&2, Ef.Lv>, +top: Ef.Lv, hit: Bool, eh: {Ef.at(List.append(&2, Ef.Lv, pre, a <> post), a) == hit : Bool}, out: {Ef.has(pre, a) == False{} : Bool}) -> {Ef.fwd.go(List.append(&2, Ef.Lv, pre, a <> post), a, top, hit) == Some{Ef.first(post, top)} : Maybe<&2, Ef.Lv>}:
  match pre:
    case Nil{}:
      match hit:
        case True{}:
          {==}
        case False{}:
          pe.absurd({Ef.fwd.go(a <> post, a, top, False{}) == Some{Ef.first(post, top)} : Maybe<&2, Ef.Lv>}, Equal.trans(Bool, True{}, Ef.Lv.eq(a, a), False{}, pe.lv_refl(a), eh))
    case +x <> +r:
      match hit:
        case True{}:
          +nx = pe.or_false_l(Ef.Lv.eq(x, a), Ef.has(r, a), out)
          pe.absurd({Ef.fwd.go(x <> List.append(&2, Ef.Lv, r, a <> post), a, top, True{}) == Some{Ef.first(post, top)} : Maybe<&2, Ef.Lv>}, Equal.trans(Bool, True{}, Ef.Lv.eq(x, a), False{}, Equal.sym(Bool, Ef.Lv.eq(x, a), True{}, eh), nx))
        case False{}:
          pe.fwd_go(r, a, post, top, Ef.at(List.append(&2, Ef.Lv, r, a <> post), a), {==}, pe.or_false_r(Ef.Lv.eq(x, a), Ef.has(r, a), out))

# backward from b, which pre lacks, right after a, gives a
def pe.bwd_go(pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>, prev: Ef.Lv, hit: Bool, eh: {Ef.at(List.append(&2, Ef.Lv, pre, a <> b <> post), b) == hit : Bool}, out: {Ef.has(pre, b) == False{} : Bool}, +ne: {Ef.Lv.eq(a, b) == False{} : Bool}) -> {Ef.bwd.go(List.append(&2, Ef.Lv, pre, a <> b <> post), b, prev, hit) == Some{a} : Maybe<&2, Ef.Lv>}:
  match pre:
    case Nil{}:
      match hit:
        case True{}:
          pe.absurd({Ef.bwd.go(a <> b <> post, b, prev, True{}) == Some{a} : Maybe<&2, Ef.Lv>}, Equal.trans(Bool, True{}, Ef.Lv.eq(a, b), False{}, Equal.sym(Bool, Ef.Lv.eq(a, b), True{}, eh), ne))
        case False{}:
          %pe.lv_refl(b) : {Ef.bwd.go(b <> post, b, a, _) == Some{a} : Maybe<&2, Ef.Lv>}
          {==}
    case +x <> +r:
      match hit:
        case True{}:
          +nx = pe.or_false_l(Ef.Lv.eq(x, b), Ef.has(r, b), out)
          pe.absurd({Ef.bwd.go(x <> List.append(&2, Ef.Lv, r, a <> b <> post), b, prev, True{}) == Some{a} : Maybe<&2, Ef.Lv>}, Equal.trans(Bool, True{}, Ef.Lv.eq(x, b), False{}, Equal.sym(Bool, Ef.Lv.eq(x, b), True{}, eh), nx))
        case False{}:
          pe.bwd_go(r, a, b, post, x, Ef.at(List.append(&2, Ef.Lv, r, a <> b <> post), b), {==}, pe.or_false_r(Ef.Lv.eq(x, b), Ef.has(r, b), out), ne)

# in an ascending pre ++ [a, b] ++ post, forward from a gives b
def pe.next(+pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>, h: {Ef.asc(List.append(&2, Ef.Lv, pre, a <> b <> post)) == True{} : Bool}) -> {Ef.cycle.in(List.append(&2, Ef.Lv, pre, a <> b <> post), a, Ef.Forward{}) == Some{b} : Maybe<&2, Ef.Lv>}:
  +lad = List.append(&2, Ef.Lv, pre, a <> b <> post)
  +out = pe.asc_notin(pre, a <> b <> post, a, h, pe.has_mid(Nil{}, a, b <> post))
  Equal.trans(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, a, Ef.Forward{}), Ef.move(Ef.Forward{}, lad, a), Some{b}, pe.enter(lad, a, Ef.Forward{}, pe.two_mid(pre, a, b, post), pe.has_mid(pre, a, b <> post)), pe.fwd_go(pre, a, b <> post, Ef.first(lad, Ef.Off{}), Ef.at(lad, a), {==}, out))

# in an ascending pre ++ [a, b] ++ post, backward from b gives a
def pe.prev(+pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>, +h: {Ef.asc(List.append(&2, Ef.Lv, pre, a <> b <> post)) == True{} : Bool}) -> {Ef.cycle.in(List.append(&2, Ef.Lv, pre, a <> b <> post), b, Ef.Backward{}) == Some{a} : Maybe<&2, Ef.Lv>}:
  +lad = List.append(&2, Ef.Lv, pre, a <> b <> post)
  +hb = pe.or_r(Ef.Lv.eq(a, b), Ef.has(b <> post, b), pe.has_mid(Nil{}, b, post))
  +out = pe.asc_notin(pre, a <> b <> post, b, h, hb)
  +sa = pe.asc_suf(pre, a <> b <> post, h)
  +ab = pe.and_l(Ef.above(Ef.Lv.idx(a), b <> post), Ef.asc(b <> post), sa)
  +ne = pe.lt_ne(Ef.Lv.idx(a), Ef.Lv.idx(b), pe.and_l(Nat.is_lt(Ef.Lv.idx(a), Ef.Lv.idx(b)), Ef.above(Ef.Lv.idx(a), post), ab))
  Equal.trans(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, b, Ef.Backward{}), Ef.move(Ef.Backward{}, lad, b), Some{a}, pe.enter(lad, b, Ef.Backward{}, pe.two_mid(pre, a, b, post), pe.has_app(pre, a <> b <> post, b, hb)), pe.bwd_go(pre, a, b, post, Ef.last(lad, Ef.Off{}), Ef.at(lad, b), {==}, out, ne))

# in an ascending (h0 <> pre) ++ [z], forward from z gives h0
def pe.wrap(+h0: Ef.Lv, +pre: List<&2, Ef.Lv>, +z: Ef.Lv, h: {Ef.asc(List.append(&2, Ef.Lv, h0 <> pre, [z])) == True{} : Bool}) -> {Ef.cycle.in(List.append(&2, Ef.Lv, h0 <> pre, [z]), z, Ef.Forward{}) == Some{h0} : Maybe<&2, Ef.Lv>}:
  +lad = List.append(&2, Ef.Lv, h0 <> pre, [z])
  +out = pe.asc_notin(h0 <> pre, [z], z, h, pe.has_mid(Nil{}, z, Nil{}))
  Equal.trans(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, z, Ef.Forward{}), Ef.move(Ef.Forward{}, lad, z), Some{h0}, pe.enter(lad, z, Ef.Forward{}, pe.two_app(h0, pre, z, Nil{}), pe.has_mid(h0 <> pre, z, Nil{})), pe.fwd_go(h0 <> pre, z, Nil{}, Ef.first(lad, Ef.Off{}), Ef.at(lad, z), {==}, out))

def pe.head_go(+h0: Ef.Lv, +rest: List<&2, Ef.Lv>) -> {Ef.bwd.go(h0 <> rest, h0, Ef.last(rest, h0), Ef.Lv.eq(h0, h0)) == Some{Ef.last(rest, h0)} : Maybe<&2, Ef.Lv>}:
  %pe.lv_refl(h0) : {Ef.bwd.go(h0 <> rest, h0, Ef.last(rest, h0), _) == Some{Ef.last(rest, h0)} : Maybe<&2, Ef.Lv>}
  {==}

# in (h0 <> pre) ++ [z], backward from h0 gives z
def pe.wrap_back(+h0: Ef.Lv, +pre: List<&2, Ef.Lv>, +z: Ef.Lv) -> {Ef.cycle.in(List.append(&2, Ef.Lv, h0 <> pre, [z]), h0, Ef.Backward{}) == Some{z} : Maybe<&2, Ef.Lv>}:
  +lad = List.append(&2, Ef.Lv, h0 <> pre, [z])
  +rest = List.append(&2, Ef.Lv, pre, [z])
  +go = Equal.trans(Maybe<&2, Ef.Lv>, Ef.move(Ef.Backward{}, lad, h0), Some{Ef.last(rest, h0)}, Some{z}, pe.head_go(h0, rest), Equal.cong(Ef.Lv, Maybe<&2, Ef.Lv>, v => Some{v}, Ef.last(rest, h0), z, pe.last_snoc(pre, z, h0)))
  Equal.trans(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, h0, Ef.Backward{}), Ef.move(Ef.Backward{}, lad, h0), Some{z}, pe.enter(lad, h0, Ef.Backward{}, pe.two_app(h0, pre, z, Nil{}), pe.has_mid(Nil{}, h0, rest)), go)

# Inverse steps
# -------------

# one cycle step along lad from x, x itself when the step changes nothing
def pe.tl(+lad: List<&2, Ef.Lv>, +x: Ef.Lv, d: Ef.Dir) -> Ef.Lv:
  Maybe.default(&2, Ef.Lv, Ef.cycle.in(lad, x, d), x)

def pe.tl_two(+lad: List<&2, Ef.Lv>, +x: Ef.Lv, +y: Ef.Lv, +d1: Ef.Dir, +d2: Ef.Dir, e1: {Ef.cycle.in(lad, x, d1) == Some{y} : Maybe<&2, Ef.Lv>}, e2: {Ef.cycle.in(lad, y, d2) == Some{x} : Maybe<&2, Ef.Lv>}) -> {pe.tl(lad, pe.tl(lad, x, d1), d2) == x : Ef.Lv}:
  %Equal.sym(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, x, d1), Some{y}, e1) : {Maybe.default(&2, Ef.Lv, Ef.cycle.in(lad, Maybe.default(&2, Ef.Lv, _, x), d2), Maybe.default(&2, Ef.Lv, _, x)) == x : Ef.Lv}
  %Equal.sym(Maybe<&2, Ef.Lv>, Ef.cycle.in(lad, y, d2), Some{x}, e2) : {Maybe.default(&2, Ef.Lv, _, y) == x : Ef.Lv}
  {==}

# backward undoes forward on an ascending pre ++ [l] ++ post
def pe.bf(pre: List<&2, Ef.Lv>, +l: Ef.Lv, post: List<&2, Ef.Lv>, +h: {Ef.asc(List.append(&2, Ef.Lv, pre, l <> post)) == True{} : Bool}) -> {pe.tl(List.append(&2, Ef.Lv, pre, l <> post), pe.tl(List.append(&2, Ef.Lv, pre, l <> post), l, Ef.Forward{}), Ef.Backward{}) == l : Ef.Lv}:
  match pre:
    case Nil{}:
      match post:
        case Nil{}:
          {==}
        case +b <> +q:
          pe.tl_two(l <> b <> q, l, b, Ef.Forward{}, Ef.Backward{}, pe.next(Nil{}, l, b, q, h), pe.prev(Nil{}, l, b, q, h))
    case +x <> +r:
      match post:
        case Nil{}:
          pe.tl_two(List.append(&2, Ef.Lv, x <> r, [l]), l, x, Ef.Forward{}, Ef.Backward{}, pe.wrap(x, r, l, h), pe.wrap_back(x, r, l))
        case +b <> +q:
          pe.tl_two(List.append(&2, Ef.Lv, x <> r, l <> b <> q), l, b, Ef.Forward{}, Ef.Backward{}, pe.next(x <> r, l, b, q, h), pe.prev(x <> r, l, b, q, h))

# forward undoes backward on an ascending pre ++ [l] ++ post
def pe.fb(pre: List<&2, Ef.Lv>, +l: Ef.Lv, +post: List<&2, Ef.Lv>, +h: {Ef.asc(List.append(&2, Ef.Lv, pre, l <> post)) == True{} : Bool}) -> {pe.tl(List.append(&2, Ef.Lv, pre, l <> post), pe.tl(List.append(&2, Ef.Lv, pre, l <> post), l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}:
  match pre:
    case Nil{}:
      match post:
        case Nil{}:
          {==}
        case +p <> +ps:
          +i = pe.init(ps, p)
          +z = Ef.last(ps, p)
          +e = pe.init_last(ps, p)
          %Equal.sym(List<&2, Ef.Lv>, p <> ps, List.append(&2, Ef.Lv, i, [z]), e) : {pe.tl(l <> _, pe.tl(l <> _, l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}
          +h2 = pe.asc_tr(l <> p <> ps, l <> List.append(&2, Ef.Lv, i, [z]), Equal.cong(List<&2, Ef.Lv>, List<&2, Ef.Lv>, ys => l <> ys, p <> ps, List.append(&2, Ef.Lv, i, [z]), e), h)
          pe.tl_two(List.append(&2, Ef.Lv, l <> i, [z]), l, z, Ef.Backward{}, Ef.Forward{}, pe.wrap_back(l, i, z), pe.wrap(l, i, z, h2))
    case +x <> +r:
      +i = pe.init(r, x)
      +a = Ef.last(r, x)
      +tail = {l <> post : List<&2, Ef.Lv>}
      +c1 = Equal.cong(List<&2, Ef.Lv>, List<&2, Ef.Lv>, ys => List.append(&2, Ef.Lv, ys, tail), x <> r, List.append(&2, Ef.Lv, i, [a]), pe.init_last(r, x))
      +e = Equal.trans(List<&2, Ef.Lv>, List.append(&2, Ef.Lv, x <> r, tail), List.append(&2, Ef.Lv, List.append(&2, Ef.Lv, i, [a]), tail), List.append(&2, Ef.Lv, i, a <> tail), c1, pe.app_snoc(i, a, tail))
      %Equal.sym(List<&2, Ef.Lv>, List.append(&2, Ef.Lv, x <> r, tail), List.append(&2, Ef.Lv, i, a <> tail), e) : {pe.tl(_, pe.tl(_, l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}
      +h2 = pe.asc_tr(List.append(&2, Ef.Lv, x <> r, tail), List.append(&2, Ef.Lv, i, a <> tail), e, h)
      pe.tl_two(List.append(&2, Ef.Lv, i, a <> l <> post), l, a, Ef.Backward{}, Ef.Forward{}, pe.prev(i, a, l, post, h2), pe.next(i, a, l, post, h2))

# the levels of xs before its first l
def pe.spre(xs: List<&2, Ef.Lv>, +l: Ef.Lv, hit: Bool) -> List<&2, Ef.Lv>:
  match xs:
    case Nil{}:
      Nil{}
    case x <> +r:
      match hit:
        case True{}:
          Nil{}
        case False{}:
          x <> pe.spre(r, l, Ef.at(r, l))

# the levels of xs after its first l
def pe.spost(xs: List<&2, Ef.Lv>, +l: Ef.Lv, hit: Bool) -> List<&2, Ef.Lv>:
  match xs:
    case Nil{}:
      Nil{}
    case x <> +r:
      match hit:
        case True{}:
          r
        case False{}:
          pe.spost(r, l, Ef.at(r, l))

# a list that has l splits at its first l
def pe.split(xs: List<&2, Ef.Lv>, +l: Ef.Lv, hit: Bool, eh: {Ef.at(xs, l) == hit : Bool}, in: {Ef.has(xs, l) == True{} : Bool}) -> {xs == List.append(&2, Ef.Lv, pe.spre(xs, l, hit), l <> pe.spost(xs, l, hit)) : List<&2, Ef.Lv>}:
  match xs:
    case Nil{}:
      pe.absurdF({Nil{} == [l] : List<&2, Ef.Lv>}, in)
    case +x <> +r:
      match hit:
        case True{}:
          %pe.lv_true(x, l, eh) : {x <> r == _ <> r : List<&2, Ef.Lv>}
          {==}
        case False{}:
          +ih = pe.split(r, l, Ef.at(r, l), {==}, pe.or_l_false(Ef.Lv.eq(x, l), Ef.has(r, l), eh, in))
          Equal.cong(List<&2, Ef.Lv>, List<&2, Ef.Lv>, ys => x <> ys, r, List.append(&2, Ef.Lv, pe.spre(r, l, Ef.at(r, l)), l <> pe.spost(r, l, Ef.at(r, l))), ih)

def pe.bf_any(+lad: List<&2, Ef.Lv>, +l: Ef.Lv, h: {Ef.asc(lad) == True{} : Bool}, in: {Ef.has(lad, l) == True{} : Bool}) -> {pe.tl(lad, pe.tl(lad, l, Ef.Forward{}), Ef.Backward{}) == l : Ef.Lv}:
  +pre = pe.spre(lad, l, Ef.at(lad, l))
  +post = pe.spost(lad, l, Ef.at(lad, l))
  +e = pe.split(lad, l, Ef.at(lad, l), {==}, in)
  %Equal.sym(List<&2, Ef.Lv>, lad, List.append(&2, Ef.Lv, pre, l <> post), e) : {pe.tl(_, pe.tl(_, l, Ef.Forward{}), Ef.Backward{}) == l : Ef.Lv}
  pe.bf(pre, l, post, pe.asc_tr(lad, List.append(&2, Ef.Lv, pre, l <> post), e, h))

def pe.fb_any(+lad: List<&2, Ef.Lv>, +l: Ef.Lv, h: {Ef.asc(lad) == True{} : Bool}, in: {Ef.has(lad, l) == True{} : Bool}) -> {pe.tl(lad, pe.tl(lad, l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}:
  +pre = pe.spre(lad, l, Ef.at(lad, l))
  +post = pe.spost(lad, l, Ef.at(lad, l))
  +e = pe.split(lad, l, Ef.at(lad, l), {==}, in)
  %Equal.sym(List<&2, Ef.Lv>, lad, List.append(&2, Ef.Lv, pre, l <> post), e) : {pe.tl(_, pe.tl(_, l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}
  pe.fb(pre, l, post, pe.asc_tr(lad, List.append(&2, Ef.Lv, pre, l <> post), e, h))

# The session
# -----------

# the session holds a level that fits to itself
def pe.Fixed(s: Ef.Sess) -> Type:
  match s:
    case Ef.Sess{mo, st}:
      match st:
        case None{}:
          Empty
        case Some{l}:
          {Ef.fit(mo, l) == l : Ef.Lv}

def pe.fit_idem(mo: Maybe<&2, Ef.Mdl>, +l: Ef.Lv) -> {Ef.fit(mo, Ef.fit(mo, l)) == Ef.fit(mo, l) : Ef.Lv}:
  match mo:
    case None{}:
      {==}
    case Some{+m}:
      pe.clamp_idem(Ef.offered(m), l)

def pe.open_fix(s: Ef.Sess, +dflt: Ef.Lv) -> pe.Fixed(Ef.open(s, dflt)):
  match s:
    case Ef.Sess{+mo, st}:
      pe.fit_idem(mo, Maybe.default(&2, Ef.Lv, st, dflt))

def pe.step_fix(+m: Ef.Mdl, r: Maybe<&2, Ef.Lv>, +l: Ef.Lv, fx: {Ef.clamp(m, l) == l : Ef.Lv}) -> {Ef.clamp(m, Ef.step.set(m, r, l)) == Ef.step.set(m, r, l) : Ef.Lv}:
  match r:
    case None{}:
      fx
    case Some{k}:
      pe.clamp_idem(Ef.offered(m), k)

def pe.steplv_fix(mo: Maybe<&2, Ef.Mdl>, +l: Ef.Lv, +d: Ef.Dir, fx: {Ef.fit(mo, l) == l : Ef.Lv}) -> {Ef.fit(mo, Ef.step.lv(mo, l, d)) == Ef.step.lv(mo, l, d) : Ef.Lv}:
  match mo:
    case None{}:
      {==}
    case Some{+m}:
      pe.step_fix(m, Ef.cycle(m, l, d), l, fx)

def pe.actset_fix(a: Ef.Act, +mo: Maybe<&2, Ef.Mdl>, +l: Ef.Lv, fx: {Ef.fit(mo, l) == l : Ef.Lv}) -> pe.Fixed(Ef.act.set(a, mo, l)):
  match a:
    case Ef.Switch{+m}:
      pe.clamp_idem(Ef.offered(m), l)
    case Ef.SetLevel{k}:
      pe.fit_idem(mo, k)
    case Ef.Step{d}:
      pe.steplv_fix(mo, l, d, fx)

def pe.act_fix(s: Ef.Sess, a: Ef.Act, f: pe.Fixed(s)) -> pe.Fixed(Ef.act(a, s)):
  match s:
    case Ef.Sess{mo, st}:
      match st:
        case None{}:
          pe.void(pe.Fixed(Ef.act(a, Ef.Sess{mo, None{}})), f)
        case Some{l}:
          pe.actset_fix(a, mo, l, f)

def pe.run_fix(acts: List<&2, Ef.Act>, +s: Ef.Sess, f: pe.Fixed(s)) -> pe.Fixed(Ef.run(acts, s)):
  match acts:
    case Nil{}:
      f
    case +a <> rest:
      pe.run_fix(rest, Ef.act(a, s), pe.act_fix(s, a, f))

def pe.fix_sent(t: Ef.Sess, f: pe.Fixed(t)) -> {Ef.Sess.stored(t) == Some{Ef.sent(t)} : Maybe<&2, Ef.Lv>}:
  match t:
    case Ef.Sess{+mo, st}:
      match st:
        case None{}:
          pe.void({Ef.Sess.stored(Ef.Sess{mo, None{}}) == Some{Ef.sent(Ef.Sess{mo, None{}})} : Maybe<&2, Ef.Lv>}, f)
        case Some{+l}:
          Equal.cong(Ef.Lv, Maybe<&2, Ef.Lv>, v => Some{v}, l, Ef.fit(mo, l), Equal.sym(Ef.Lv, Ef.fit(mo, l), l, f))

def pe.fix_shown(t: Ef.Sess, f: pe.Fixed(t)) -> {Ef.shown(t) == Ef.Level{Ef.sent(t)} : Ef.Shown}:
  match t:
    case Ef.Sess{+mo, st}:
      match st:
        case None{}:
          pe.void({Ef.shown(Ef.Sess{mo, None{}}) == Ef.Level{Ef.sent(Ef.Sess{mo, None{}})} : Ef.Shown}, f)
        case Some{+l}:
          {==}

# The laws
# --------

def pe.effort_offered_plain(+map: Ef.LvMap) -> {Ef.offered(Ef.Mdl{False{}, map}) == [Ef.Off{}] : List<&2, Ef.Lv>}:
  {==}

def pe.effort_offered_null(+map: Ef.LvMap, +l: Ef.Lv, null: {Ef.entry(l, map) == Ef.Null{} : Ef.Ent}) -> {Ef.has(Ef.offered(Ef.Mdl{True{}, map}), l) == False{} : Bool}:
  +ladder = Ef.ladder()
  +nk = Equal.cong(Ef.Ent, Bool, e => Ef.keep.e(l, e), Ef.entry(l, map), Ef.Null{}, null)
  pe.offer_out(map, ladder, l, pe.kat(map, ladder), {==}, Ef.at(ladder, l), {==}, nk)

def pe.effort_offered_ext(r: Bool, +map: Ef.LvMap, +l: Ef.Lv, x: {Ef.ext(l) == True{} : Bool}, in: {Ef.has(Ef.offered(Ef.Mdl{r, map}), l) == True{} : Bool}) -> {Ef.entry(l, map) == Ef.Wire{} : Ef.Ent}:
  match r:
    case True{}:
      pe.wire(l, Ef.entry(l, map), x, pe.offer_in(map, Ef.ladder(), l, in))
    case False{}:
      +same = Equal.cong(Ef.Lv, Bool, v => Ef.ext(v), Ef.Off{}, l, pe.lv_true(Ef.Off{}, l, pe.or_false_t(Ef.Lv.eq(Ef.Off{}, l), in)))
      pe.absurdF({Ef.entry(l, map) == Ef.Wire{} : Ef.Ent}, Equal.trans(Bool, False{}, Ef.ext(l), True{}, same, x))

def pe.effort_offered_kept(+map: Ef.LvMap, +l: Ef.Lv, k: {Ef.keep(map, l) == True{} : Bool}) -> {Ef.has(Ef.offered(Ef.Mdl{True{}, map}), l) == True{} : Bool}:
  +ladder = Ef.ladder()
  pe.offer_keep(map, ladder, l, pe.kat(map, ladder), {==}, Ef.at(ladder, l), {==}, k, pe.on_ladder(l))

def pe.effort_offered_asc(m: Ef.Mdl) -> {Ef.asc(Ef.offered(m)) == True{} : Bool}:
  match m:
    case Ef.Mdl{r, +map}:
      match r:
        case True{}:
          pe.offer_asc(map, Ef.ladder(), pe.kat(map, Ef.ladder()), {==}, {==})
        case False{}:
          {==}

def pe.effort_clamp_offered(+m: Ef.Mdl, +l: Ef.Lv, ne: {Ef.empty(Ef.offered(m)) == False{} : Bool}) -> {Ef.has(Ef.offered(m), Ef.clamp(m, l)) == True{} : Bool}:
  pe.clamp_in(Ef.offered(m), l, ne)

def pe.effort_clamp_keeps(+m: Ef.Mdl, +l: Ef.Lv, in: {Ef.has(Ef.offered(m), l) == True{} : Bool}) -> {Ef.clamp(m, l) == l : Ef.Lv}:
  pe.clamp_keep(Ef.offered(m), l, in)

def pe.effort_clamp_idem(+m: Ef.Mdl, +l: Ef.Lv) -> {Ef.clamp(m, Ef.clamp(m, l)) == Ef.clamp(m, l) : Ef.Lv}:
  pe.clamp_idem(Ef.offered(m), l)

def pe.effort_cycle_still(+m: Ef.Mdl, +l: Ef.Lv, +d: Ef.Dir, few: {Ef.two(Ef.offered(m)) == False{} : Bool}) -> {Ef.cycle(m, l, d) == None{} : Maybe<&2, Ef.Lv>}:
  %Equal.sym(Bool, Ef.two(Ef.offered(m)), False{}, few) : {Ef.cycle.at(_, Ef.offered(m), l, d) == None{} : Maybe<&2, Ef.Lv>}
  {==}

def pe.effort_cycle_next(+m: Ef.Mdl, +pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>, +split: {Ef.offered(m) == List.append(&2, Ef.Lv, pre, a <> b <> post) : List<&2, Ef.Lv>}) -> {Ef.cycle(m, a, Ef.Forward{}) == Some{b} : Maybe<&2, Ef.Lv>}:
  %Equal.sym(List<&2, Ef.Lv>, Ef.offered(m), List.append(&2, Ef.Lv, pre, a <> b <> post), split) : {Ef.cycle.in(_, a, Ef.Forward{}) == Some{b} : Maybe<&2, Ef.Lv>}
  pe.next(pre, a, b, post, pe.asc_tr(Ef.offered(m), List.append(&2, Ef.Lv, pre, a <> b <> post), split, pe.effort_offered_asc(m)))

def pe.effort_cycle_wrap(+m: Ef.Mdl, +h: Ef.Lv, +pre: List<&2, Ef.Lv>, +z: Ef.Lv, +split: {Ef.offered(m) == List.append(&2, Ef.Lv, h <> pre, [z]) : List<&2, Ef.Lv>}) -> {Ef.cycle(m, z, Ef.Forward{}) == Some{h} : Maybe<&2, Ef.Lv>}:
  %Equal.sym(List<&2, Ef.Lv>, Ef.offered(m), List.append(&2, Ef.Lv, h <> pre, [z]), split) : {Ef.cycle.in(_, z, Ef.Forward{}) == Some{h} : Maybe<&2, Ef.Lv>}
  pe.wrap(h, pre, z, pe.asc_tr(Ef.offered(m), List.append(&2, Ef.Lv, h <> pre, [z]), split, pe.effort_offered_asc(m)))

def pe.effort_cycle_prev(+m: Ef.Mdl, +pre: List<&2, Ef.Lv>, +a: Ef.Lv, +b: Ef.Lv, +post: List<&2, Ef.Lv>, +split: {Ef.offered(m) == List.append(&2, Ef.Lv, pre, a <> b <> post) : List<&2, Ef.Lv>}) -> {Ef.cycle(m, b, Ef.Backward{}) == Some{a} : Maybe<&2, Ef.Lv>}:
  %Equal.sym(List<&2, Ef.Lv>, Ef.offered(m), List.append(&2, Ef.Lv, pre, a <> b <> post), split) : {Ef.cycle.in(_, b, Ef.Backward{}) == Some{a} : Maybe<&2, Ef.Lv>}
  pe.prev(pre, a, b, post, pe.asc_tr(Ef.offered(m), List.append(&2, Ef.Lv, pre, a <> b <> post), split, pe.effort_offered_asc(m)))

def pe.effort_cycle_wrap_back(+m: Ef.Mdl, +h: Ef.Lv, +pre: List<&2, Ef.Lv>, +z: Ef.Lv, split: {Ef.offered(m) == List.append(&2, Ef.Lv, h <> pre, [z]) : List<&2, Ef.Lv>}) -> {Ef.cycle(m, h, Ef.Backward{}) == Some{z} : Maybe<&2, Ef.Lv>}:
  %Equal.sym(List<&2, Ef.Lv>, Ef.offered(m), List.append(&2, Ef.Lv, h <> pre, [z]), split) : {Ef.cycle.in(_, h, Ef.Backward{}) == Some{z} : Maybe<&2, Ef.Lv>}
  pe.wrap_back(h, pre, z)

def pe.effort_cycle_inverse(+m: Ef.Mdl, +l: Ef.Lv, in: {Ef.has(Ef.offered(m), l) == True{} : Bool}) -> {Ef.turn(m, Ef.turn(m, l, Ef.Forward{}), Ef.Backward{}) == l : Ef.Lv}:
  pe.bf_any(Ef.offered(m), l, pe.effort_offered_asc(m), in)

def pe.effort_cycle_inverse_back(+m: Ef.Mdl, +l: Ef.Lv, in: {Ef.has(Ef.offered(m), l) == True{} : Bool}) -> {Ef.turn(m, Ef.turn(m, l, Ef.Backward{}), Ef.Forward{}) == l : Ef.Lv}:
  pe.fb_any(Ef.offered(m), l, pe.effort_offered_asc(m), in)

def pe.effort_unset_default(+mo: Maybe<&2, Ef.Mdl>) -> {Ef.shown(Ef.Sess{mo, None{}}) == Ef.Default{} : Ef.Shown}:
  {==}

def pe.effort_settle_offered(+m: Ef.Mdl, +st: Maybe<&2, Ef.Lv>, +dflt: Ef.Lv, +k: Ef.Lv, ne: {Ef.empty(Ef.offered(m)) == False{} : Bool}, settled: {Ef.Sess.stored(Ef.open(Ef.Sess{Some{m}, st}, dflt)) == Some{k} : Maybe<&2, Ef.Lv>}) -> {Ef.has(Ef.offered(m), k) == True{} : Bool}:
  +x = Maybe.default(&2, Ef.Lv, st, dflt)
  +e = Equal.cong(Maybe<&2, Ef.Lv>, Ef.Lv, v => Maybe.default(&2, Ef.Lv, v, Ef.Off{}), Some{Ef.clamp(m, x)}, Some{k}, settled)
  %e : {Ef.has(Ef.offered(m), _) == True{} : Bool}
  pe.clamp_in(Ef.offered(m), x, ne)

def pe.effort_stored_is_sent(+s: Ef.Sess, +dflt: Ef.Lv, +acts: List<&2, Ef.Act>) -> {Ef.Sess.stored(Ef.run(acts, Ef.open(s, dflt))) == Some{Ef.sent(Ef.run(acts, Ef.open(s, dflt)))} : Maybe<&2, Ef.Lv>}:
  pe.fix_sent(Ef.run(acts, Ef.open(s, dflt)), pe.run_fix(acts, Ef.open(s, dflt), pe.open_fix(s, dflt)))

def pe.effort_shown_is_sent(+s: Ef.Sess, +dflt: Ef.Lv, +acts: List<&2, Ef.Act>) -> {Ef.shown(Ef.run(acts, Ef.open(s, dflt))) == Ef.Level{Ef.sent(Ef.run(acts, Ef.open(s, dflt)))} : Ef.Shown}:
  pe.fix_shown(Ef.run(acts, Ef.open(s, dflt)), pe.run_fix(acts, Ef.open(s, dflt), pe.open_fix(s, dflt)))

# ---- quirks ----

# proof_quirks: the quirks rulebook laws of S6, about bend/infer.bend.
#
# Compile: an unknown directive fails known_all (`pq.ka_app`); a clash
# makes the rulebook ambiguous (`pq.amb_app`); a swap of two neighbours
# changes neither known_all (`pq.ka_swap`) nor ambiguous (`pq.amb_swap`,
# clash is symmetric).
# Lookup: with no rule that applies the scan keeps None (`pq.none_go`);
# once a rule applies the best stays Some (`pq.stay_k`). Two rules that
# both apply and do not clash give the same best in either order
# (`pq.better_swap`: at one rank they agree on the value). In a rulebook
# that compiles, before r the best is below r's rank or equal to r
# (`pq.pre_ok`), and from r on it is r's rank and value (`pq.good`).
# The thinking ladder: the chosen ladder is a plain case split
# (reflexivity). A level is in the offer of a map exactly when the map
# keeps it (`pq.lad_has_keep`, from the S10 filter lemmas), and the filled
# map keeps a level exactly when the ladder rule does (`pq.lad_fill_keep`).
# With the shipped default ladders the ladder rule keeps what the S10
# rule keeps (`pq.lad_ship_e`), so the offers agree (`pq.lad_offer_fill`,
# by induction on the list).

# Logic
# -----

def pq.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pq.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pq.BD(_, Unit, A)
  Unit{}

def pq.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pq.BD(_, A, Unit)
  Unit{}

def pq.flip(-A: Type, -a: Bool, h: {a == True{} : Bool}, g: {a == False{} : Bool}) -> A:
  pq.absurd(A, Equal.trans(Bool, True{}, a, False{}, Equal.sym(Bool, a, True{}, h), g))

def pq.and_l(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pq.absurdF({False{} == True{} : Bool}, h)

def pq.and_r(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pq.absurdF({b == True{} : Bool}, h)

def pq.and_t(-a: Bool, -b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pq.and_f(a: Bool) -> {Bool.and(a, False{}) == False{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

# the right side of a false and whose left side holds
def pq.and_tf(a: Bool, -b: Bool, h: {Bool.and(a, b) == False{} : Bool}, ha: {a == True{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pq.absurdF({b == False{} : Bool}, ha)

def pq.or_l(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      pq.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pq.or_r(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      pq.absurd({b == False{} : Bool}, h)
    case False{}:
      h

def pq.or_tl(-a: Bool, -b: Bool, ha: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.or(_, b) == True{} : Bool}
  {==}

def pq.or_tr(a: Bool, -b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

# the right side of a true or whose left side fails
def pq.or_fl(a: Bool, -b: Bool, h: {Bool.or(a, b) == True{} : Bool}, na: {a == False{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      pq.absurd({b == True{} : Bool}, na)
    case False{}:
      h

def pq.or_and_f(c: Bool, -y: Bool, -z: Bool, h: {Bool.or(Bool.and(c, y), z) == True{} : Bool}, nc: {c == False{} : Bool}) -> {z == True{} : Bool}:
  match c:
    case True{}:
      pq.absurd({z == True{} : Bool}, nc)
    case False{}:
      h

def pq.not_f(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      pq.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pq.and_swap(a: Bool, b: Bool, +c: Bool) -> {Bool.and(a, Bool.and(b, c)) == Bool.and(b, Bool.and(a, c)) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def pq.or_swap(a: Bool, b: Bool, +c: Bool) -> {Bool.or(a, Bool.or(b, c)) == Bool.or(b, Bool.or(a, c)) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def pq.or4(c: Bool, +x: Bool, +y: Bool, +z: Bool) -> {Bool.or(Bool.or(c, x), Bool.or(y, z)) == Bool.or(Bool.or(c, y), Bool.or(x, z)) : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      pq.or_swap(x, y, z)

# x, y hold and and(x, and(y, not z)) fails: z holds
def pq.ncv(x: Bool, y: Bool, z: Bool, nc: {Bool.and(x, Bool.and(y, Bool.not(z))) == False{} : Bool}, hx: {x == True{} : Bool}, hy: {y == True{} : Bool}) -> {z == True{} : Bool}:
  match x y z:
    case False{} _ _:
      pq.absurdF({z == True{} : Bool}, hx)
    case True{} False{} _:
      pq.absurdF({z == True{} : Bool}, hy)
    case True{} True{} True{}:
      {==}
    case True{} True{} False{}:
      pq.absurd({False{} == True{} : Bool}, nc)

# Numbers
# -------

def pq.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pq.eq_refl(p)

def pq.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pq.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pq.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pq.eq_true(p, q, h))

def pq.eq_comm(a: Nat, b: Nat) -> {Nat.is_eq(a, b) == Nat.is_eq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pq.eq_comm(p, q)

def pq.eq_of(+a: Nat, +b: Nat, ab: {a == b : Nat}) -> {Nat.is_eq(a, b) == True{} : Bool}:
  %ab : {Nat.is_eq(a, _) == True{} : Bool}
  Equal.sym(Bool, True{}, Nat.is_eq(a, a), pq.eq_refl(a))

def pq.eq_tr(+x: Nat, +y: Nat, +z: Nat, xz: {Nat.is_eq(x, z) == True{} : Bool}, yz: {Nat.is_eq(y, z) == True{} : Bool}) -> {Nat.is_eq(x, y) == True{} : Bool}:
  %Equal.sym(Nat, y, z, pq.eq_true(y, z, yz)) : {Nat.is_eq(x, _) == True{} : Bool}
  xz

def pq.lt_irrefl(k: Nat) -> {Nat.is_lt(k, k) == False{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pq.lt_irrefl(p)

def pq.lt_trans(a: Nat, b: Nat, c: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  match a b c:
    case _ 0n _:
      pq.absurdF({Nat.is_lt(a, c) == True{} : Bool}, ab)
    case _ 1n+q 0n:
      pq.absurdF({Nat.is_lt(a, 0n) == True{} : Bool}, bc)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 1n+q 1n+r:
      pq.lt_trans(p, q, r, ab, bc)

# neither below the other: equal
def pq.tri(x: Nat, y: Nat, n1: {Nat.is_lt(y, x) == False{} : Bool}, n2: {Nat.is_lt(x, y) == False{} : Bool}) -> {Nat.is_eq(x, y) == True{} : Bool}:
  match x y:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pq.absurd({Nat.is_eq(0n, 1n+q) == True{} : Bool}, n2)
    case 1n+p 0n:
      pq.absurd({Nat.is_eq(1n+p, 0n) == True{} : Bool}, n1)
    case 1n+p 1n+q:
      pq.tri(p, q, n1, n2)

def pq.le0(n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pq.lt_le(a: Nat, b: Nat) -> {Nat.is_lt(a, b) == Nat.is_le(1n+a, b) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Equal.sym(Bool, Nat.is_le(0n, q), True{}, pq.le0(q))
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pq.lt_le(p, q)

def pq.lt_at(-k: Nat, -x: Nat, -y: Nat, e: {k == x : Nat}, h: {Nat.is_lt(x, y) == False{} : Bool}) -> {Nat.is_lt(k, y) == False{} : Bool}:
  %Equal.sym(Nat, k, x, e) : {Nat.is_lt(_, y) == False{} : Bool}
  h

# k below x and not below y: x is not below y
def pq.lt_gap(+k: Nat, +x: Nat, +y: Nat, c: Bool, ec: {Nat.is_lt(x, y) == c : Bool}, kx: {Nat.is_lt(k, x) == True{} : Bool}, ky: {Nat.is_lt(k, y) == False{} : Bool}) -> {Nat.is_lt(x, y) == False{} : Bool}:
  match c:
    case True{}:
      pq.flip({Nat.is_lt(x, y) == False{} : Bool}, Nat.is_lt(k, y), pq.lt_trans(k, x, y, kx, ec), ky)
    case False{}:
      ec

# Compiling
# ---------

def pq.ka_app(pre: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, +known: List<&2, Nat>, bad: {If.elem(known, If.Rule.dir(r)) == False{} : Bool}) -> {If.known_all(List.append(&2, If.Rule, pre, r <> post), known) == False{} : Bool}:
  match pre:
    case Nil{}:
      %Equal.sym(Bool, If.elem(known, If.Rule.dir(r)), False{}, bad) : {Bool.and(_, If.known_all(post, known)) == False{} : Bool}
      {==}
    case +h <> +t:
      %Equal.sym(Bool, If.known_all(List.append(&2, If.Rule, t, r <> post), known), False{}, pq.ka_app(t, r, post, known, bad)) : {Bool.and(If.elem(known, If.Rule.dir(h)), _) == False{} : Bool}
      pq.and_f(If.elem(known, If.Rule.dir(h)))

def pq.quirk_unknown_rejected(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, bad: {If.elem(known, If.Rule.dir(r)) == False{} : Bool}) -> {If.compiles(known, List.append(&2, If.Rule, pre, r <> post)) == False{} : Bool}:
  %Equal.sym(Bool, If.known_all(List.append(&2, If.Rule, pre, r <> post), known), False{}, pq.ka_app(pre, r, post, known, bad)) : {Bool.and(_, Bool.not(If.ambiguous(List.append(&2, If.Rule, pre, r <> post)))) == False{} : Bool}
  {==}

def pq.clashes_app(+a: If.Rule, mid: List<&2, If.Rule>, +b: If.Rule, +post: List<&2, If.Rule>, both: {If.clash(a, b) == True{} : Bool}) -> {If.clashes(a, List.append(&2, If.Rule, mid, b <> post)) == True{} : Bool}:
  match mid:
    case Nil{}:
      pq.or_tl(If.clash(a, b), If.clashes(a, post), both)
    case +s <> +t:
      pq.or_tr(If.clash(a, s), If.clashes(a, List.append(&2, If.Rule, t, b <> post)), pq.clashes_app(a, t, b, post, both))

def pq.amb_app(pre: List<&2, If.Rule>, +a: If.Rule, +mid: List<&2, If.Rule>, +b: If.Rule, +post: List<&2, If.Rule>, both: {If.clash(a, b) == True{} : Bool}) -> {If.ambiguous(List.append(&2, If.Rule, pre, a <> List.append(&2, If.Rule, mid, b <> post))) == True{} : Bool}:
  match pre:
    case Nil{}:
      +X = List.append(&2, If.Rule, mid, b <> post)
      pq.or_tl(If.clashes(a, X), If.ambiguous(X), pq.clashes_app(a, mid, b, post, both))
    case +h <> +t:
      +X = List.append(&2, If.Rule, t, a <> List.append(&2, If.Rule, mid, b <> post))
      pq.or_tr(If.clashes(h, X), If.ambiguous(X), pq.amb_app(t, a, mid, b, post, both))

def pq.quirk_clash_rejected(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +a: If.Rule, +mid: List<&2, If.Rule>, +b: If.Rule, +post: List<&2, If.Rule>, both: {If.clash(a, b) == True{} : Bool}) -> {If.compiles(known, List.append(&2, If.Rule, pre, a <> List.append(&2, If.Rule, mid, b <> post))) == False{} : Bool}:
  +L = List.append(&2, If.Rule, pre, a <> List.append(&2, If.Rule, mid, b <> post))
  %Equal.sym(Bool, If.ambiguous(L), True{}, pq.amb_app(pre, a, mid, b, post, both)) : {Bool.and(If.known_all(L, known), Bool.not(_)) == False{} : Bool}
  pq.and_f(If.known_all(L, known))

def pq.ka_swap(pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>, +known: List<&2, Nat>) -> {If.known_all(List.append(&2, If.Rule, pre, b <> a <> post), known) == If.known_all(List.append(&2, If.Rule, pre, a <> b <> post), known) : Bool}:
  match pre:
    case Nil{}:
      pq.and_swap(If.elem(known, If.Rule.dir(b)), If.elem(known, If.Rule.dir(a)), If.known_all(post, known))
    case +h <> +t:
      %pq.ka_swap(t, a, b, post, known) : {Bool.and(If.elem(known, If.Rule.dir(h)), If.known_all(List.append(&2, If.Rule, t, b <> a <> post), known)) == Bool.and(If.elem(known, If.Rule.dir(h)), _) : Bool}
      {==}

def pq.cl_app_swap(+s: If.Rule, pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>) -> {If.clashes(s, List.append(&2, If.Rule, pre, b <> a <> post)) == If.clashes(s, List.append(&2, If.Rule, pre, a <> b <> post)) : Bool}:
  match pre:
    case Nil{}:
      pq.or_swap(If.clash(s, b), If.clash(s, a), If.clashes(s, post))
    case +h <> +t:
      %pq.cl_app_swap(s, t, a, b, post) : {Bool.or(If.clash(s, h), If.clashes(s, List.append(&2, If.Rule, t, b <> a <> post))) == Bool.or(If.clash(s, h), _) : Bool}
      {==}

def pq.clash_sym(a: If.Rule, b: If.Rule) -> {If.clash(a, b) == If.clash(b, a) : Bool}:
  match a b:
    case If.Rule{+la, +ta, +da, +va} If.Rule{+lb, +tb, +db, +vb}:
      +ka = If.Lay.rank(la)
      +kb = If.Lay.rank(lb)
      +C = If.clash(If.Rule{la, ta, da, va}, If.Rule{lb, tb, db, vb})
      %pq.eq_comm(ka, kb) : {C == Bool.and(_, Bool.and(Nat.is_eq(tb, ta), Bool.and(Nat.is_eq(db, da), Bool.not(Nat.is_eq(vb, va))))) : Bool}
      %pq.eq_comm(ta, tb) : {C == Bool.and(Nat.is_eq(ka, kb), Bool.and(_, Bool.and(Nat.is_eq(db, da), Bool.not(Nat.is_eq(vb, va))))) : Bool}
      %pq.eq_comm(da, db) : {C == Bool.and(Nat.is_eq(ka, kb), Bool.and(Nat.is_eq(ta, tb), Bool.and(_, Bool.not(Nat.is_eq(vb, va))))) : Bool}
      %pq.eq_comm(va, vb) : {C == Bool.and(Nat.is_eq(ka, kb), Bool.and(Nat.is_eq(ta, tb), Bool.and(Nat.is_eq(da, db), Bool.not(_)))) : Bool}
      {==}

def pq.amb_swap(pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>) -> {If.ambiguous(List.append(&2, If.Rule, pre, b <> a <> post)) == If.ambiguous(List.append(&2, If.Rule, pre, a <> b <> post)) : Bool}:
  match pre:
    case Nil{}:
      %pq.clash_sym(a, b) : {Bool.or(Bool.or(_, If.clashes(b, post)), Bool.or(If.clashes(a, post), If.ambiguous(post))) == Bool.or(Bool.or(If.clash(a, b), If.clashes(a, post)), Bool.or(If.clashes(b, post), If.ambiguous(post))) : Bool}
      pq.or4(If.clash(a, b), If.clashes(b, post), If.clashes(a, post), If.ambiguous(post))
    case +h <> +t:
      +X1 = List.append(&2, If.Rule, t, b <> a <> post)
      +X2 = List.append(&2, If.Rule, t, a <> b <> post)
      %pq.cl_app_swap(h, t, a, b, post) : {Bool.or(If.clashes(h, X1), If.ambiguous(X1)) == Bool.or(_, If.ambiguous(X2)) : Bool}
      %pq.amb_swap(t, a, b, post) : {Bool.or(If.clashes(h, X1), If.ambiguous(X1)) == Bool.or(If.clashes(h, X1), _) : Bool}
      {==}

def pq.quirk_compile_order_free(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>) -> {If.compiles(known, List.append(&2, If.Rule, pre, b <> a <> post)) == If.compiles(known, List.append(&2, If.Rule, pre, a <> b <> post)) : Bool}:
  +L1 = List.append(&2, If.Rule, pre, b <> a <> post)
  +L2 = List.append(&2, If.Rule, pre, a <> b <> post)
  %pq.ka_swap(pre, a, b, post, known) : {Bool.and(If.known_all(L1, known), Bool.not(If.ambiguous(L1))) == Bool.and(_, Bool.not(If.ambiguous(L2))) : Bool}
  %pq.amb_swap(pre, a, b, post) : {Bool.and(If.known_all(L1, known), Bool.not(If.ambiguous(L1))) == Bool.and(If.known_all(L1, known), Bool.not(_)) : Bool}
  {==}

# Lookup: none and some
# ---------------------

def pq.none_go(rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, +b: Maybe<&2, If.Best>, hit: Bool, eh: {If.use.at(rs, q, d) == hit : Bool}, none: {If.any_at(rs, q, d, 0n) == False{} : Bool}) -> {If.look.go(rs, q, d, b, hit) == b : Maybe<&2, If.Best>}:
  match rs:
    case Nil{}:
      {==}
    case +r <> +rest:
      match hit:
        case True{}:
          +H = Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), d))
          +z = Nat.is_le(0n, If.Rule.rank(r))
          +le = pq.and_tf(H, z, pq.or_l(Bool.and(H, z), If.any_at(rest, q, d, 0n), none), eh)
          pq.flip({If.look.go(r <> rest, q, d, b, True{}) == b : Maybe<&2, If.Best>}, z, pq.le0(If.Rule.rank(r)), le)
        case False{}:
          +H = Bool.and(Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), d)), Nat.is_le(0n, If.Rule.rank(r)))
          pq.none_go(rest, q, d, b, If.use.at(rest, q, d), {==}, pq.or_r(H, If.any_at(rest, q, d, 0n), none))

def pq.quirk_unknown_when_none(+rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, none: {If.any_at(rs, q, d, 0n) == False{} : Bool}) -> {If.lookup(rs, q, d) == If.Unknown{} : If.Ans}:
  %Equal.sym(Maybe<&2, If.Best>, If.look.go(rs, q, d, None{}, If.use.at(rs, q, d)), None{}, pq.none_go(rs, q, d, None{}, If.use.at(rs, q, d), {==}, none)) : {If.ans(_) == If.Unknown{} : If.Ans}
  {==}

def pq.better_at_k(c: Bool, x: If.Best, +r: If.Rule) -> {If.is_known(If.ans(If.better.at(c, x, r))) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      match x:
        case If.Best{k, v}:
          {==}

def pq.better_k(b: Maybe<&2, If.Best>, +r: If.Rule) -> {If.is_known(If.ans(If.better(b, r))) == True{} : Bool}:
  match b:
    case None{}:
      {==}
    case Some{+x}:
      pq.better_at_k(Nat.is_lt(If.Best.rank(x), If.Rule.rank(r)), x, r)

def pq.stay_k(rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, +b: Maybe<&2, If.Best>, hit: Bool, pb: {If.is_known(If.ans(b)) == True{} : Bool}) -> {If.is_known(If.ans(If.look.go(rs, q, d, b, hit))) == True{} : Bool}:
  match rs:
    case Nil{}:
      pb
    case +r <> +rest:
      match hit:
        case True{}:
          pq.stay_k(rest, q, d, If.better(b, r), If.use.at(rest, q, d), pq.better_k(b, r))
        case False{}:
          pq.stay_k(rest, q, d, b, If.use.at(rest, q, d), pb)

def pq.found_k(rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, +b: Maybe<&2, If.Best>, hit: Bool, eh: {If.use.at(rs, q, d) == hit : Bool}, some: {If.any_at(rs, q, d, 0n) == True{} : Bool}) -> {If.is_known(If.ans(If.look.go(rs, q, d, b, hit))) == True{} : Bool}:
  match rs:
    case Nil{}:
      pq.absurdF({If.is_known(If.ans(b)) == True{} : Bool}, some)
    case +r <> +rest:
      match hit:
        case True{}:
          pq.stay_k(rest, q, d, If.better(b, r), If.use.at(rest, q, d), pq.better_k(b, r))
        case False{}:
          +z = pq.or_and_f(Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), d)), Nat.is_le(0n, If.Rule.rank(r)), If.any_at(rest, q, d, 0n), some, eh)
          pq.found_k(rest, q, d, b, If.use.at(rest, q, d), {==}, z)

def pq.quirk_known_when_some(+rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, some: {If.any_at(rs, q, d, 0n) == True{} : Bool}) -> {If.is_known(If.lookup(rs, q, d)) == True{} : Bool}:
  pq.found_k(rs, q, d, None{}, If.use.at(rs, q, d), {==}, some)

# Two rules that apply
# --------------------

def pq.val_of(+ta: Nat, +tb: Nat, +da: Nat, +db: Nat, +va: Nat, +vb: Nat, +f: Nat, +d: Nat, nc: {Bool.and(Nat.is_eq(ta, tb), Bool.and(Nat.is_eq(da, db), Bool.not(Nat.is_eq(va, vb)))) == False{} : Bool}, af: {Nat.is_eq(ta, f) == True{} : Bool}, bf: {Nat.is_eq(tb, f) == True{} : Bool}, ad: {Nat.is_eq(da, d) == True{} : Bool}, bd: {Nat.is_eq(db, d) == True{} : Bool}) -> {va == vb : Nat}:
  pq.eq_true(va, vb, pq.ncv(Nat.is_eq(ta, tb), Nat.is_eq(da, db), Nat.is_eq(va, vb), nc, pq.eq_tr(ta, tb, f, af, bf), pq.eq_tr(da, db, d, ad, bd)))

# two rules of one rank that apply with one directive and do not clash
# have one value
def pq.same_val(+q: If.Query, +a: If.Rule, +b: If.Rule, +d: Nat, nc: {If.clash(a, b) == False{} : Bool}, +ha: {Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d)) == True{} : Bool}, +hb: {Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d)) == True{} : Bool}, er: {Nat.is_eq(If.Rule.rank(a), If.Rule.rank(b)) == True{} : Bool}) -> {If.Rule.val(a) == If.Rule.val(b) : Nat}:
  match q a b:
    case If.Query{+f, m, h} If.Rule{If.Fam{}, +ta, +da, +va} If.Rule{If.Fam{}, +tb, +db, +vb}:
      pq.val_of(ta, tb, da, db, va, vb, f, d, nc, pq.and_l(Nat.is_eq(ta, f), Nat.is_eq(da, d), ha), pq.and_l(Nat.is_eq(tb, f), Nat.is_eq(db, d), hb), pq.and_r(Nat.is_eq(ta, f), Nat.is_eq(da, d), ha), pq.and_r(Nat.is_eq(tb, f), Nat.is_eq(db, d), hb))
    case If.Query{f, +m, h} If.Rule{If.Mod{}, +ta, +da, +va} If.Rule{If.Mod{}, +tb, +db, +vb}:
      pq.val_of(ta, tb, da, db, va, vb, m, d, nc, pq.and_l(Nat.is_eq(ta, m), Nat.is_eq(da, d), ha), pq.and_l(Nat.is_eq(tb, m), Nat.is_eq(db, d), hb), pq.and_r(Nat.is_eq(ta, m), Nat.is_eq(da, d), ha), pq.and_r(Nat.is_eq(tb, m), Nat.is_eq(db, d), hb))
    case If.Query{f, m, +h} If.Rule{If.Host{}, +ta, +da, +va} If.Rule{If.Host{}, +tb, +db, +vb}:
      pq.val_of(ta, tb, da, db, va, vb, h, d, nc, pq.and_l(Nat.is_eq(ta, h), Nat.is_eq(da, d), ha), pq.and_l(Nat.is_eq(tb, h), Nat.is_eq(db, d), hb), pq.and_r(Nat.is_eq(ta, h), Nat.is_eq(da, d), ha), pq.and_r(Nat.is_eq(tb, h), Nat.is_eq(db, d), hb))
    case If.Query{f, m, h} If.Rule{If.Fam{}, ta, da, va} If.Rule{If.Mod{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)
    case If.Query{f, m, h} If.Rule{If.Fam{}, ta, da, va} If.Rule{If.Host{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)
    case If.Query{f, m, h} If.Rule{If.Mod{}, ta, da, va} If.Rule{If.Fam{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)
    case If.Query{f, m, h} If.Rule{If.Mod{}, ta, da, va} If.Rule{If.Host{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)
    case If.Query{f, m, h} If.Rule{If.Host{}, ta, da, va} If.Rule{If.Fam{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)
    case If.Query{f, m, h} If.Rule{If.Host{}, ta, da, va} If.Rule{If.Mod{}, tb, db, vb}:
      pq.absurdF({va == vb : Nat}, er)

# the best of a then b is the best of b then a, from None
def pq.pair_swap(+a: If.Rule, +b: If.Rule, +q: If.Query, +d: Nat, c1: Bool, +e1: {Nat.is_lt(If.Rule.rank(b), If.Rule.rank(a)) == c1 : Bool}, c2: Bool, +e2: {Nat.is_lt(If.Rule.rank(a), If.Rule.rank(b)) == c2 : Bool}, nc: {If.clash(a, b) == False{} : Bool}, ha: {Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d)) == True{} : Bool}, hb: {Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d)) == True{} : Bool}) -> {If.better.at(c1, If.Best{If.Rule.rank(b), If.Rule.val(b)}, a) == If.better.at(c2, If.Best{If.Rule.rank(a), If.Rule.val(a)}, b) : Maybe<&2, If.Best>}:
  match c1 c2:
    case True{} True{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      pq.flip({If.better.at(True{}, If.Best{RB, If.Rule.val(b)}, a) == If.better.at(True{}, If.Best{RA, If.Rule.val(a)}, b) : Maybe<&2, If.Best>}, Nat.is_lt(RA, RA), pq.lt_trans(RA, RB, RA, e2, e1), pq.lt_irrefl(RA))
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      +VA = If.Rule.val(a)
      +VB = If.Rule.val(b)
      +er = pq.tri(RA, RB, e1, e2)
      +ev = pq.same_val(q, a, b, d, nc, ha, hb, er)
      +ek = pq.eq_true(RA, RB, er)
      %ek : {Some{If.Best{_, VB}} == Some{If.Best{RA, VA}} : Maybe<&2, If.Best>}
      %ev : {Some{If.Best{RA, _}} == Some{If.Best{RA, VA}} : Maybe<&2, If.Best>}
      {==}

# the same, from Some{Best{k, v}}
def pq.some_swap(+k: Nat, +v: Nat, +a: If.Rule, +b: If.Rule, +q: If.Query, +d: Nat, ca: Bool, +ea: {Nat.is_lt(k, If.Rule.rank(a)) == ca : Bool}, cb: Bool, +eb: {Nat.is_lt(k, If.Rule.rank(b)) == cb : Bool}, nc: {If.clash(a, b) == False{} : Bool}, ha: {Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d)) == True{} : Bool}, hb: {Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d)) == True{} : Bool}) -> {If.better(If.better.at(cb, If.Best{k, v}, b), a) == If.better(If.better.at(ca, If.Best{k, v}, a), b) : Maybe<&2, If.Best>}:
  match ca cb:
    case True{} True{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      pq.pair_swap(a, b, q, d, Nat.is_lt(RB, RA), {==}, Nat.is_lt(RA, RB), {==}, nc, ha, hb)
    case True{} False{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      +VA = If.Rule.val(a)
      %Equal.sym(Bool, Nat.is_lt(k, RA), True{}, ea) : {If.better.at(_, If.Best{k, v}, a) == If.better.at(Nat.is_lt(RA, RB), If.Best{RA, VA}, b) : Maybe<&2, If.Best>}
      %Equal.sym(Bool, Nat.is_lt(RA, RB), False{}, pq.lt_gap(k, RA, RB, Nat.is_lt(RA, RB), {==}, ea, eb)) : {If.better.at(True{}, If.Best{k, v}, a) == If.better.at(_, If.Best{RA, VA}, b) : Maybe<&2, If.Best>}
      {==}
    case False{} True{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      +VB = If.Rule.val(b)
      %Equal.sym(Bool, Nat.is_lt(RB, RA), False{}, pq.lt_gap(k, RB, RA, Nat.is_lt(RB, RA), {==}, eb, ea)) : {If.better.at(_, If.Best{RB, VB}, a) == If.better.at(Nat.is_lt(k, RB), If.Best{k, v}, b) : Maybe<&2, If.Best>}
      %Equal.sym(Bool, Nat.is_lt(k, RB), True{}, eb) : {If.better.at(False{}, If.Best{RB, VB}, a) == If.better.at(_, If.Best{k, v}, b) : Maybe<&2, If.Best>}
      {==}
    case False{} False{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      %Equal.sym(Bool, Nat.is_lt(k, RA), False{}, ea) : {If.better.at(_, If.Best{k, v}, a) == If.better.at(Nat.is_lt(k, RB), If.Best{k, v}, b) : Maybe<&2, If.Best>}
      %Equal.sym(Bool, Nat.is_lt(k, RB), False{}, eb) : {If.better.at(False{}, If.Best{k, v}, a) == If.better.at(_, If.Best{k, v}, b) : Maybe<&2, If.Best>}
      {==}

# two rules that apply and do not clash give one best in either order
def pq.better_swap(s: Maybe<&2, If.Best>, +a: If.Rule, +b: If.Rule, +q: If.Query, +d: Nat, nc: {If.clash(a, b) == False{} : Bool}, ha: {Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d)) == True{} : Bool}, hb: {Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d)) == True{} : Bool}) -> {If.better(If.better(s, b), a) == If.better(If.better(s, a), b) : Maybe<&2, If.Best>}:
  match s:
    case None{}:
      +RA = If.Rule.rank(a)
      +RB = If.Rule.rank(b)
      pq.pair_swap(a, b, q, d, Nat.is_lt(RB, RA), {==}, Nat.is_lt(RA, RB), {==}, nc, ha, hb)
    case Some{x}:
      match x:
        case If.Best{+k, +v}:
          pq.some_swap(k, v, a, b, q, d, Nat.is_lt(k, If.Rule.rank(a)), {==}, Nat.is_lt(k, If.Rule.rank(b)), {==}, nc, ha, hb)

def pq.swap_go(pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>, +q: If.Query, +d: Nat, +s: Maybe<&2, If.Best>, h1: Bool, h2: Bool, +e1: {If.use.at(List.append(&2, If.Rule, pre, b <> a <> post), q, d) == h1 : Bool}, +e2: {If.use.at(List.append(&2, If.Rule, pre, a <> b <> post), q, d) == h2 : Bool}, +nc: {If.clash(a, b) == False{} : Bool}) -> {If.look.go(List.append(&2, If.Rule, pre, b <> a <> post), q, d, s, h1) == If.look.go(List.append(&2, If.Rule, pre, a <> b <> post), q, d, s, h2) : Maybe<&2, If.Best>}:
  match pre:
    case Nil{}:
      match h1 h2:
        case True{} True{}:
          +Ha = Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d))
          +Hb = Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d))
          +U = If.use.at(post, q, d)
          %Equal.sym(Bool, Ha, True{}, e2) : {If.look.go(a <> post, q, d, If.better(s, b), _) == If.look.go(b <> post, q, d, If.better(s, a), Hb) : Maybe<&2, If.Best>}
          %Equal.sym(Bool, Hb, True{}, e1) : {If.look.go(a <> post, q, d, If.better(s, b), True{}) == If.look.go(b <> post, q, d, If.better(s, a), _) : Maybe<&2, If.Best>}
          %pq.better_swap(s, a, b, q, d, nc, e2, e1) : {If.look.go(post, q, d, If.better(If.better(s, b), a), U) == If.look.go(post, q, d, _, U) : Maybe<&2, If.Best>}
          {==}
        case True{} False{}:
          +Ha = Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d))
          +Hb = Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d))
          %Equal.sym(Bool, Ha, False{}, e2) : {If.look.go(a <> post, q, d, If.better(s, b), _) == If.look.go(b <> post, q, d, s, Hb) : Maybe<&2, If.Best>}
          %Equal.sym(Bool, Hb, True{}, e1) : {If.look.go(a <> post, q, d, If.better(s, b), False{}) == If.look.go(b <> post, q, d, s, _) : Maybe<&2, If.Best>}
          {==}
        case False{} True{}:
          +Ha = Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d))
          +Hb = Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d))
          %Equal.sym(Bool, Ha, True{}, e2) : {If.look.go(a <> post, q, d, s, _) == If.look.go(b <> post, q, d, If.better(s, a), Hb) : Maybe<&2, If.Best>}
          %Equal.sym(Bool, Hb, False{}, e1) : {If.look.go(a <> post, q, d, s, True{}) == If.look.go(b <> post, q, d, If.better(s, a), _) : Maybe<&2, If.Best>}
          {==}
        case False{} False{}:
          +Ha = Bool.and(If.applies(q, a), Nat.is_eq(If.Rule.dir(a), d))
          +Hb = Bool.and(If.applies(q, b), Nat.is_eq(If.Rule.dir(b), d))
          %Equal.sym(Bool, Ha, False{}, e2) : {If.look.go(a <> post, q, d, s, _) == If.look.go(b <> post, q, d, s, Hb) : Maybe<&2, If.Best>}
          %Equal.sym(Bool, Hb, False{}, e1) : {If.look.go(a <> post, q, d, s, False{}) == If.look.go(b <> post, q, d, s, _) : Maybe<&2, If.Best>}
          {==}
    case +h <> +t:
      match h1 h2:
        case True{} True{}:
          pq.swap_go(t, a, b, post, q, d, If.better(s, h), If.use.at(List.append(&2, If.Rule, t, b <> a <> post), q, d), If.use.at(List.append(&2, If.Rule, t, a <> b <> post), q, d), {==}, {==}, nc)
        case False{} False{}:
          pq.swap_go(t, a, b, post, q, d, s, If.use.at(List.append(&2, If.Rule, t, b <> a <> post), q, d), If.use.at(List.append(&2, If.Rule, t, a <> b <> post), q, d), {==}, {==}, nc)
        case True{} False{}:
          +X1 = List.append(&2, If.Rule, t, b <> a <> post)
          +X2 = List.append(&2, If.Rule, t, a <> b <> post)
          pq.flip({If.look.go(h <> X1, q, d, s, True{}) == If.look.go(h <> X2, q, d, s, False{}) : Maybe<&2, If.Best>}, Bool.and(If.applies(q, h), Nat.is_eq(If.Rule.dir(h), d)), e1, e2)
        case False{} True{}:
          +X1 = List.append(&2, If.Rule, t, b <> a <> post)
          +X2 = List.append(&2, If.Rule, t, a <> b <> post)
          pq.flip({If.look.go(h <> X1, q, d, s, False{}) == If.look.go(h <> X2, q, d, s, True{}) : Maybe<&2, If.Best>}, Bool.and(If.applies(q, h), Nat.is_eq(If.Rule.dir(h), d)), e2, e1)

def pq.amb_tail(pre: List<&2, If.Rule>, +X: List<&2, If.Rule>, h: {If.ambiguous(List.append(&2, If.Rule, pre, X)) == False{} : Bool}) -> {If.ambiguous(X) == False{} : Bool}:
  match pre:
    case Nil{}:
      h
    case +s <> +t:
      +Y = List.append(&2, If.Rule, t, X)
      pq.amb_tail(t, X, pq.or_r(If.clashes(s, Y), If.ambiguous(Y), h))

def pq.quirk_order_free(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +a: If.Rule, +b: If.Rule, +post: List<&2, If.Rule>, +q: If.Query, +d: Nat, ok: {If.compiles(known, List.append(&2, If.Rule, pre, a <> b <> post)) == True{} : Bool}) -> {If.lookup(List.append(&2, If.Rule, pre, b <> a <> post), q, d) == If.lookup(List.append(&2, If.Rule, pre, a <> b <> post), q, d) : If.Ans}:
  +L1 = List.append(&2, If.Rule, pre, b <> a <> post)
  +L2 = List.append(&2, If.Rule, pre, a <> b <> post)
  +am = pq.not_f(If.ambiguous(L2), pq.and_r(If.known_all(L2, known), Bool.not(If.ambiguous(L2)), ok))
  +ab = pq.amb_tail(pre, a <> b <> post, am)
  +nc = pq.or_l(If.clash(a, b), If.clashes(a, post), pq.or_l(Bool.or(If.clash(a, b), If.clashes(a, post)), If.ambiguous(b <> post), ab))
  +sw = pq.swap_go(pre, a, b, post, q, d, None{}, If.use.at(L1, q, d), If.use.at(L2, q, d), {==}, {==}, nc)
  Equal.cong(Maybe<&2, If.Best>, If.Ans, m => If.ans(m), If.look.go(L1, q, d, None{}, If.use.at(L1, q, d)), If.look.go(L2, q, d, None{}, If.use.at(L2, q, d)), sw)

# The highest layer wins
# ----------------------

# before r: the best is below r's rank, or at it with r's value
def pq.pre_ok(b: Maybe<&2, If.Best>, +r: If.Rule) -> Bool:
  match b:
    case None{}:
      True{}
    case Some{x}:
      match x:
        case If.Best{+k, v}:
          Bool.or(Nat.is_lt(k, If.Rule.rank(r)), Bool.and(Nat.is_eq(k, If.Rule.rank(r)), Nat.is_eq(v, If.Rule.val(r))))

# from r on: the best is at r's rank with r's value
def pq.good(b: Maybe<&2, If.Best>, +r: If.Rule) -> Bool:
  match b:
    case None{}:
      False{}
    case Some{x}:
      match x:
        case If.Best{k, v}:
          Bool.and(Nat.is_eq(k, If.Rule.rank(r)), Nat.is_eq(v, If.Rule.val(r)))

def pq.good_ans(b: Maybe<&2, If.Best>, +r: If.Rule, g: {pq.good(b, r) == True{} : Bool}) -> {If.ans(b) == If.Known{If.Rule.val(r)} : If.Ans}:
  match b:
    case None{}:
      pq.absurdF({If.ans(None{}) == If.Known{If.Rule.val(r)} : If.Ans}, g)
    case Some{x}:
      match x:
        case If.Best{+k, +v}:
          +ev = pq.eq_true(v, If.Rule.val(r), pq.and_r(Nat.is_eq(k, If.Rule.rank(r)), Nat.is_eq(v, If.Rule.val(r)), g))
          Equal.cong(Nat, If.Ans, z => If.Known{z}, v, If.Rule.val(r), ev)

def pq.good_fresh(+r: If.Rule) -> {pq.good(Some{If.Best{If.Rule.rank(r), If.Rule.val(r)}}, r) == True{} : Bool}:
  +R = If.Rule.rank(r)
  +V = If.Rule.val(r)
  %pq.eq_refl(R) : {Bool.and(_, Nat.is_eq(V, V)) == True{} : Bool}
  %pq.eq_refl(V) : {Bool.and(True{}, _) == True{} : Bool}
  {==}

def pq.post_step(b: Maybe<&2, If.Best>, +s: If.Rule, +r: If.Rule, +gb: {pq.good(b, r) == True{} : Bool}, ns: {Nat.is_lt(If.Rule.rank(r), If.Rule.rank(s)) == False{} : Bool}) -> {pq.good(If.better(b, s), r) == True{} : Bool}:
  match b:
    case None{}:
      pq.absurdF({pq.good(If.better(None{}, s), r) == True{} : Bool}, gb)
    case Some{x}:
      match x:
        case If.Best{+k, +v}:
          +R = If.Rule.rank(r)
          +ek = pq.eq_true(k, R, pq.and_l(Nat.is_eq(k, R), Nat.is_eq(v, If.Rule.val(r)), gb))
          +lk = pq.lt_at(k, R, If.Rule.rank(s), ek, ns)
          %Equal.sym(Bool, Nat.is_lt(k, If.Rule.rank(s)), False{}, lk) : {pq.good(If.better.at(_, If.Best{k, v}, s), r) == True{} : Bool}
          gb

def pq.post_go(rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, +r: If.Rule, +b: Maybe<&2, If.Best>, hit: Bool, eh: {If.use.at(rs, q, d) == hit : Bool}, gb: {pq.good(b, r) == True{} : Bool}, +top: {If.any_at(rs, q, d, 1n+If.Rule.rank(r)) == False{} : Bool}) -> {pq.good(If.look.go(rs, q, d, b, hit), r) == True{} : Bool}:
  match rs:
    case Nil{}:
      gb
    case +s <> +rest:
      match hit:
        case True{}:
          +R = If.Rule.rank(r)
          +H = Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), d))
          +z = Nat.is_le(1n+R, If.Rule.rank(s))
          +le = pq.and_tf(H, z, pq.or_l(Bool.and(H, z), If.any_at(rest, q, d, 1n+R), top), eh)
          +ns = Equal.trans(Bool, Nat.is_lt(R, If.Rule.rank(s)), z, False{}, pq.lt_le(R, If.Rule.rank(s)), le)
          pq.post_go(rest, q, d, r, If.better(b, s), If.use.at(rest, q, d), {==}, pq.post_step(b, s, r, gb, ns), pq.or_r(Bool.and(H, z), If.any_at(rest, q, d, 1n+R), top))
        case False{}:
          +R = If.Rule.rank(r)
          +H = Bool.and(Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), d)), Nat.is_le(1n+R, If.Rule.rank(s)))
          pq.post_go(rest, q, d, r, b, If.use.at(rest, q, d), {==}, gb, pq.or_r(H, If.any_at(rest, q, d, 1n+R), top))

def pq.at_r_go(+k: Nat, +v: Nat, +r: If.Rule, c: Bool, ec: {Nat.is_lt(k, If.Rule.rank(r)) == c : Bool}, pb: {pq.pre_ok(Some{If.Best{k, v}}, r) == True{} : Bool}) -> {pq.good(If.better.at(c, If.Best{k, v}, r), r) == True{} : Bool}:
  match c:
    case True{}:
      pq.good_fresh(r)
    case False{}:
      pq.or_fl(Nat.is_lt(k, If.Rule.rank(r)), Bool.and(Nat.is_eq(k, If.Rule.rank(r)), Nat.is_eq(v, If.Rule.val(r))), pb, ec)

# at r: the best becomes r's rank and value
def pq.at_r(b: Maybe<&2, If.Best>, +r: If.Rule, pb: {pq.pre_ok(b, r) == True{} : Bool}) -> {pq.good(If.better(b, r), r) == True{} : Bool}:
  match b:
    case None{}:
      pq.good_fresh(r)
    case Some{x}:
      match x:
        case If.Best{+k, +v}:
          pq.at_r_go(k, v, r, Nat.is_lt(k, If.Rule.rank(r)), {==}, pb)

# a rule s before r that applies keeps the best within r
def pq.fresh_ok(+s: If.Rule, +r: If.Rule, +q: If.Query, c: Bool, +ec: {Nat.is_lt(If.Rule.rank(s), If.Rule.rank(r)) == c : Bool}, hs: {Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), If.Rule.dir(r))) == True{} : Bool}, hr: {Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), If.Rule.dir(r))) == True{} : Bool}, nc: {If.clash(s, r) == False{} : Bool}, ts: {Nat.is_lt(If.Rule.rank(r), If.Rule.rank(s)) == False{} : Bool}) -> {pq.pre_ok(Some{If.Best{If.Rule.rank(s), If.Rule.val(s)}}, r) == True{} : Bool}:
  match c:
    case True{}:
      +RS = If.Rule.rank(s)
      +R = If.Rule.rank(r)
      %Equal.sym(Bool, Nat.is_lt(RS, R), True{}, ec) : {Bool.or(_, Bool.and(Nat.is_eq(RS, R), Nat.is_eq(If.Rule.val(s), If.Rule.val(r)))) == True{} : Bool}
      {==}
    case False{}:
      +RS = If.Rule.rank(s)
      +R = If.Rule.rank(r)
      +VS = If.Rule.val(s)
      +V = If.Rule.val(r)
      +er = pq.tri(RS, R, ts, ec)
      +ev = pq.same_val(q, s, r, If.Rule.dir(r), nc, hs, hr, er)
      %Equal.sym(Bool, Nat.is_lt(RS, R), False{}, ec) : {Bool.or(_, Bool.and(Nat.is_eq(RS, R), Nat.is_eq(VS, V))) == True{} : Bool}
      pq.and_t(Nat.is_eq(RS, R), Nat.is_eq(VS, V), er, pq.eq_of(VS, V, ev))

def pq.pre_at(+k: Nat, +v: Nat, +s: If.Rule, +r: If.Rule, +q: If.Query, c: Bool, pb: {pq.pre_ok(Some{If.Best{k, v}}, r) == True{} : Bool}, hs: {Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), If.Rule.dir(r))) == True{} : Bool}, hr: {Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), If.Rule.dir(r))) == True{} : Bool}, nc: {If.clash(s, r) == False{} : Bool}, ts: {Nat.is_lt(If.Rule.rank(r), If.Rule.rank(s)) == False{} : Bool}) -> {pq.pre_ok(If.better.at(c, If.Best{k, v}, s), r) == True{} : Bool}:
  match c:
    case True{}:
      pq.fresh_ok(s, r, q, Nat.is_lt(If.Rule.rank(s), If.Rule.rank(r)), {==}, hs, hr, nc, ts)
    case False{}:
      pb

def pq.pre_step(b: Maybe<&2, If.Best>, +s: If.Rule, +r: If.Rule, +q: If.Query, pb: {pq.pre_ok(b, r) == True{} : Bool}, hs: {Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), If.Rule.dir(r))) == True{} : Bool}, hr: {Bool.and(If.applies(q, r), Nat.is_eq(If.Rule.dir(r), If.Rule.dir(r))) == True{} : Bool}, nc: {If.clash(s, r) == False{} : Bool}, ts: {Nat.is_lt(If.Rule.rank(r), If.Rule.rank(s)) == False{} : Bool}) -> {pq.pre_ok(If.better(b, s), r) == True{} : Bool}:
  match b:
    case None{}:
      pq.fresh_ok(s, r, q, Nat.is_lt(If.Rule.rank(s), If.Rule.rank(r)), {==}, hs, hr, nc, ts)
    case Some{x}:
      match x:
        case If.Best{+k, +v}:
          pq.pre_at(k, v, s, r, q, Nat.is_lt(k, If.Rule.rank(s)), pb, hs, hr, nc, ts)

def pq.clashes_mem(+s: If.Rule, t: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, h: {If.clashes(s, List.append(&2, If.Rule, t, r <> post)) == False{} : Bool}) -> {If.clash(s, r) == False{} : Bool}:
  match t:
    case Nil{}:
      pq.or_l(If.clash(s, r), If.clashes(s, post), h)
    case +u <> +t2:
      pq.clashes_mem(s, t2, r, post, pq.or_r(If.clash(s, u), If.clashes(s, List.append(&2, If.Rule, t2, r <> post)), h))

def pq.pre_go(pre: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, +q: If.Query, +b: Maybe<&2, If.Best>, hit: Bool, +eh: {If.use.at(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r)) == hit : Bool}, pb: {pq.pre_ok(b, r) == True{} : Bool}, +top: {If.any_at(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r), 1n+If.Rule.rank(r)) == False{} : Bool}, +am: {If.ambiguous(List.append(&2, If.Rule, pre, r <> post)) == False{} : Bool}, +hr: {If.applies(q, r) == True{} : Bool}) -> {pq.good(If.look.go(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r), b, hit), r) == True{} : Bool}:
  match pre:
    case Nil{}:
      match hit:
        case True{}:
          +D = If.Rule.dir(r)
          +R = If.Rule.rank(r)
          +H = Bool.and(Bool.and(If.applies(q, r), Nat.is_eq(D, D)), Nat.is_le(1n+R, R))
          pq.post_go(post, q, D, r, If.better(b, r), If.use.at(post, q, D), {==}, pq.at_r(b, r, pb), pq.or_r(H, If.any_at(post, q, D, 1n+R), top))
        case False{}:
          +D = If.Rule.dir(r)
          +hr2 = pq.and_t(If.applies(q, r), Nat.is_eq(D, D), hr, Equal.sym(Bool, True{}, Nat.is_eq(D, D), pq.eq_refl(D)))
          pq.flip({pq.good(If.look.go(r <> post, q, D, b, False{}), r) == True{} : Bool}, Bool.and(If.applies(q, r), Nat.is_eq(D, D)), hr2, eh)
    case +s <> +t:
      match hit:
        case True{}:
          +D = If.Rule.dir(r)
          +R = If.Rule.rank(r)
          +RS = If.Rule.rank(s)
          +X = List.append(&2, If.Rule, t, r <> post)
          +H = Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), D))
          +z = Nat.is_le(1n+R, RS)
          +le = pq.and_tf(H, z, pq.or_l(Bool.and(H, z), If.any_at(X, q, D, 1n+R), top), eh)
          +ts = Equal.trans(Bool, Nat.is_lt(R, RS), z, False{}, pq.lt_le(R, RS), le)
          +nc = pq.clashes_mem(s, t, r, post, pq.or_l(If.clashes(s, X), If.ambiguous(X), am))
          +hr2 = pq.and_t(If.applies(q, r), Nat.is_eq(D, D), hr, Equal.sym(Bool, True{}, Nat.is_eq(D, D), pq.eq_refl(D)))
          +pb2 = pq.pre_step(b, s, r, q, pb, eh, hr2, nc, ts)
          pq.pre_go(t, r, post, q, If.better(b, s), If.use.at(X, q, D), {==}, pb2, pq.or_r(Bool.and(H, z), If.any_at(X, q, D, 1n+R), top), pq.or_r(If.clashes(s, X), If.ambiguous(X), am), hr)
        case False{}:
          +D = If.Rule.dir(r)
          +R = If.Rule.rank(r)
          +X = List.append(&2, If.Rule, t, r <> post)
          +H = Bool.and(Bool.and(If.applies(q, s), Nat.is_eq(If.Rule.dir(s), D)), Nat.is_le(1n+R, If.Rule.rank(s)))
          pq.pre_go(t, r, post, q, b, If.use.at(X, q, D), {==}, pb, pq.or_r(H, If.any_at(X, q, D, 1n+R), top), pq.or_r(If.clashes(s, X), If.ambiguous(X), am), hr)

def pq.quirk_highest_wins(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, +q: If.Query, ok: {If.compiles(known, List.append(&2, If.Rule, pre, r <> post)) == True{} : Bool}, hit: {If.applies(q, r) == True{} : Bool}, top: {If.any_at(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r), 1n+If.Rule.rank(r)) == False{} : Bool}) -> {If.lookup(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r)) == If.Known{If.Rule.val(r)} : If.Ans}:
  +L = List.append(&2, If.Rule, pre, r <> post)
  +D = If.Rule.dir(r)
  +am = pq.not_f(If.ambiguous(L), pq.and_r(If.known_all(L, known), Bool.not(If.ambiguous(L)), ok))
  +g = pq.pre_go(pre, r, post, q, None{}, If.use.at(L, q, D), {==}, {==}, top, am, hit)
  pq.good_ans(If.look.go(L, q, D, None{}, If.use.at(L, q, D)), r, g)

# The thinking ladder
# -------------------

def pq.quirk_ladder_explicit_first(+e: Ef.LvMap, +rule: Maybe<&2, Ef.LvMap>) -> {If.lad.chosen(Some{e}, rule) == e : Ef.LvMap}:
  {==}

def pq.quirk_ladder_rule_second(+l: Ef.LvMap) -> {If.lad.chosen(None{}, Some{l}) == l : Ef.LvMap}:
  {==}

def pq.quirk_ladder_default_last() -> {If.lad.chosen(None{}, None{}) == Ef.LvMap.none() : Ef.LvMap}:
  {==}

def pq.lad_kb(+l: Ef.Lv, b: Bool) -> {Ef.keep.e(l, If.lad.ent(b)) == b : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pq.lad_kf(+l: Ef.Lv, e: Ef.Ent, +dl: List<&2, Ef.Lv>) -> {Ef.keep.e(l, If.lad.fill.e(l, e, dl)) == If.lad.keep(l, e, dl) : Bool}:
  match e:
    case Ef.Missing{}:
      pq.lad_kb(l, Ef.has(dl, l))
    case Ef.Null{}:
      {==}
    case Ef.Wire{}:
      {==}

# the filled map keeps a level exactly when the ladder rule does
def pq.lad_fill_keep(map: Ef.LvMap, +dl: List<&2, Ef.Lv>, l: Ef.Lv) -> {Ef.keep(If.lad.fill(map, dl), l) == If.lad.keep(l, Ef.entry(l, map), dl) : Bool}:
  match map:
    case Ef.LvMap{o, mi, lo, me, hi, xh, mx}:
      match l:
        case Ef.Off{}:
          pq.lad_kf(Ef.Off{}, o, dl)
        case Ef.Minimal{}:
          pq.lad_kf(Ef.Minimal{}, mi, dl)
        case Ef.Low{}:
          pq.lad_kf(Ef.Low{}, lo, dl)
        case Ef.Medium{}:
          pq.lad_kf(Ef.Medium{}, me, dl)
        case Ef.High{}:
          pq.lad_kf(Ef.High{}, hi, dl)
        case Ef.Xhigh{}:
          pq.lad_kf(Ef.Xhigh{}, xh, dl)
        case Ef.Max{}:
          pq.lad_kf(Ef.Max{}, mx, dl)

def pq.lad_has_keep.at(+map: Ef.LvMap, +l: Ef.Lv, b: Bool, eb: {Ef.keep(map, l) == b : Bool}) -> {Ef.has(Ef.offer(map, Ef.ladder()), l) == b : Bool}:
  match b:
    case True{}:
      pe.effort_offered_kept(map, l, eb)
    case False{}:
      pe.offer_out(map, Ef.ladder(), l, pe.kat(map, Ef.ladder()), {==}, Ef.at(Ef.ladder(), l), {==}, eb)

# a level is in the offer of a map exactly when the map keeps it
def pq.lad_has_keep(+map: Ef.LvMap, +l: Ef.Lv) -> {Ef.has(Ef.offer(map, Ef.ladder()), l) == Ef.keep(map, l) : Bool}:
  pq.lad_has_keep.at(map, l, Ef.keep(map, l), {==})

def pq.quirk_ladder_offered_exact(+explicit: Maybe<&2, Ef.LvMap>, +rule: Maybe<&2, Ef.LvMap>, +d: If.Defaults, +l: Ef.Lv) -> {Ef.has(If.lad.offered(True{}, explicit, rule, d), l) == If.lad.keep(l, Ef.entry(l, If.lad.chosen(explicit, rule)), If.Defaults.reasoning(d)) : Bool}:
  +C = If.lad.chosen(explicit, rule)
  +D = If.Defaults.reasoning(d)
  +F = If.lad.fill(C, D)
  Equal.trans(Bool, Ef.has(Ef.offer(F, Ef.ladder()), l), Ef.keep(F, l), If.lad.keep(l, Ef.entry(l, C), D), pq.lad_has_keep(F, l), pq.lad_fill_keep(C, D, l))

# a map with no entry leaves every level to the default ladder
def pq.lad_none(l: Ef.Lv, +dl: List<&2, Ef.Lv>) -> {If.lad.keep(l, Ef.entry(l, Ef.LvMap.none()), dl) == Ef.has(dl, l) : Bool}:
  match l:
    case Ef.Off{}:
      {==}
    case Ef.Minimal{}:
      {==}
    case Ef.Low{}:
      {==}
    case Ef.Medium{}:
      {==}
    case Ef.High{}:
      {==}
    case Ef.Xhigh{}:
      {==}
    case Ef.Max{}:
      {==}

def pq.quirk_ladder_plain_exact(+explicit: Maybe<&2, Ef.LvMap>, +rule: Maybe<&2, Ef.LvMap>, +d: If.Defaults, +l: Ef.Lv) -> {Ef.has(If.lad.offered(False{}, explicit, rule, d), l) == Ef.has(If.Defaults.plain(d), l) : Bool}:
  +P = If.Defaults.plain(d)
  +N = Ef.LvMap.none()
  +F = If.lad.fill(N, P)
  +k = Equal.trans(Bool, Ef.keep(F, l), If.lad.keep(l, Ef.entry(l, N), P), Ef.has(P, l), pq.lad_fill_keep(N, P, l), pq.lad_none(l, P))
  Equal.trans(Bool, Ef.has(Ef.offer(F, Ef.ladder()), l), Ef.keep(F, l), Ef.has(P, l), pq.lad_has_keep(F, l), k)

# with the shipped default ladder, the ladder rule keeps what S10 keeps
def pq.lad_ship_e(e: Ef.Ent, l: Ef.Lv) -> {If.lad.keep(l, e, If.Defaults.reasoning(If.lad.shipped())) == Ef.keep.e(l, e) : Bool}:
  match e l:
    case Ef.Null{} _:
      {==}
    case Ef.Wire{} _:
      {==}
    case Ef.Missing{} Ef.Off{}:
      {==}
    case Ef.Missing{} Ef.Minimal{}:
      {==}
    case Ef.Missing{} Ef.Low{}:
      {==}
    case Ef.Missing{} Ef.Medium{}:
      {==}
    case Ef.Missing{} Ef.High{}:
      {==}
    case Ef.Missing{} Ef.Xhigh{}:
      {==}
    case Ef.Missing{} Ef.Max{}:
      {==}

def pq.lad_ks(+map: Ef.LvMap, +l: Ef.Lv) -> {Ef.keep(If.lad.fill(map, If.Defaults.reasoning(If.lad.shipped())), l) == Ef.keep(map, l) : Bool}:
  +S = If.Defaults.reasoning(If.lad.shipped())
  Equal.trans(Bool, Ef.keep(If.lad.fill(map, S), l), If.lad.keep(l, Ef.entry(l, map), S), Ef.keep(map, l), pq.lad_fill_keep(map, S, l), pq.lad_ship_e(Ef.entry(l, map), l))

def pq.lad_offer_fill(+map: Ef.LvMap, xs: List<&2, Ef.Lv>) -> {Ef.offer(If.lad.fill(map, If.Defaults.reasoning(If.lad.shipped())), xs) == Ef.offer(map, xs) : List<&2, Ef.Lv>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> rest:
      +F = If.lad.fill(map, If.Defaults.reasoning(If.lad.shipped()))
      %pq.lad_ks(map, x) : {Ef.cons_if(Ef.keep(F, x), x, Ef.offer(F, rest)) == Ef.cons_if(_, x, Ef.offer(map, rest)) : List<&2, Ef.Lv>}
      %pq.lad_offer_fill(map, rest) : {Ef.cons_if(Ef.keep(F, x), x, Ef.offer(F, rest)) == Ef.cons_if(Ef.keep(F, x), x, _) : List<&2, Ef.Lv>}
      {==}

def pq.quirk_ladder_shipped_is_s10(r: Bool, +map: Ef.LvMap) -> {If.lad.offered.of(r, map, If.lad.shipped()) == Ef.offered(Ef.Mdl{r, map}) : List<&2, Ef.Lv>}:
  match r:
    case True{}:
      pq.lad_offer_fill(map, Ef.ladder())
    case False{}:
      {==}

# ---- tools ----

# proof_tools: the S7 laws (docs/tools.md) of the tool surface model in
# bend/tools.bend. An event never touches the roster, and a turn sends
# the session's roster (`pl.sent_go`, by induction on the events). A join
# appends to `dyn`; a quit drops every copy (`pl.drop_go`, with the head
# test as a parameter). `build` adds the intent parameter only when it is
# missing, and lifts the version to at least 1. A walk keeps its depth
# equal to the names it holds (`pl.esc`, `pl.ins`). The gate lemmas speak
# of `exec.go` at any head test: what ran is a prefix, a gated step that
# ran used one approval, a denial stops at the denied step, and a script
# that finished ran every step.

# Logic
# -----

def tools.pl.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def tools.pl.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : tools.pl.BD(_, Unit, A)
  Unit{}

def tools.pl.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : tools.pl.BD(_, A, Unit)
  Unit{}

def pl.ND(n: Nat, z: Type, s: Type) -> Type:
  match n:
    case 0n:
      z
    case 1n+p:
      s

def pl.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      tools.pl.absurdF({False{} == True{} : Bool}, h)

def pl.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      tools.pl.absurdF({b == True{} : Bool}, h)

def pl.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pl.or_tr(a: Bool, +b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

def tools.pl.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      tools.pl.eq_refl(p)

def pl.le0(t: Nat) -> {Nat.is_le(0n, t) == True{} : Bool}:
  match t:
    case 0n:
      {==}
    case 1n+q:
      {==}

# 1. The roster
# -------------

def pl.roster_step(s: Tl.Sess, e: Tl.Ev) -> {Tl.Sess.roster(Tl.step(s, e)) == Tl.Sess.roster(s) : List<&2, Nat>}:
  match s:
    case Tl.Sess{r, d, x}:
      match e:
        case Tl.Join{t}:
          {==}
        case Tl.Quit{t}:
          {==}
        case Tl.Turn{}:
          {==}

def pl.roster_fixed(es: List<&2, Tl.Ev>, +s: Tl.Sess) -> {Tl.Sess.roster(Tl.run(es, s)) == Tl.Sess.roster(s) : List<&2, Nat>}:
  match es:
    case Nil{}:
      {==}
    case +e <> rest:
      Equal.trans(List<&2, Nat>, Tl.Sess.roster(Tl.run(rest, Tl.step(s, e))), Tl.Sess.roster(Tl.step(s, e)), Tl.Sess.roster(s), pl.roster_fixed(rest, Tl.step(s, e)), pl.roster_step(s, e))

def pl.ids_refl(r: List<&2, Nat>) -> {Tl.ids.eq(r, r) == True{} : Bool}:
  match r:
    case Nil{}:
      {==}
    case +y <> yr:
      %tools.pl.eq_refl(y) : {Bool.and(_, Tl.ids.eq(yr, yr)) == True{} : Bool}
      pl.ids_refl(yr)

# a turn sends r after rosters that are all r
def pl.all_snoc(x: List<&2, List<&2, Nat>>, +r: List<&2, Nat>, +h: {Tl.all_eq(x, r) == True{} : Bool}) -> {Tl.all_eq(List.append(&2, List<&2, Nat>, x, [r]), r) == True{} : Bool}:
  match x:
    case Nil{}:
      %Equal.sym(Bool, Tl.ids.eq(r, r), True{}, pl.ids_refl(r)) : {Bool.and(_, True{}) == True{} : Bool}
      {==}
    case +y <> +rest:
      pl.and_t(Tl.ids.eq(y, r), Tl.all_eq(List.append(&2, List<&2, Nat>, rest, [r]), r), pl.and_l(Tl.ids.eq(y, r), Tl.all_eq(rest, r), h), pl.all_snoc(rest, r, pl.and_r(Tl.ids.eq(y, r), Tl.all_eq(rest, r), h)))

def pl.sent_go(es: List<&2, Tl.Ev>, +r: List<&2, Nat>, +d: List<&2, Nat>, +x: List<&2, List<&2, Nat>>, +h: {Tl.all_eq(x, r) == True{} : Bool}) -> {Tl.all_eq(Tl.Sess.sent(Tl.run(es, Tl.Sess{r, d, x})), r) == True{} : Bool}:
  match es:
    case Nil{}:
      h
    case +e <> rest:
      match e:
        case Tl.Join{+t}:
          pl.sent_go(rest, r, List.append(&2, Nat, d, [t]), x, h)
        case Tl.Quit{+t}:
          pl.sent_go(rest, r, Tl.drop(d, t), x, h)
        case Tl.Turn{}:
          pl.sent_go(rest, r, d, List.append(&2, List<&2, Nat>, x, [r]), pl.all_snoc(x, r, h))

def pl.roster_sent_fixed(es: List<&2, Tl.Ev>, +r: List<&2, Nat>, d: List<&2, Nat>) -> {Tl.all_eq(Tl.Sess.sent(Tl.run(es, Tl.Sess{r, d, Nil{}})), r) == True{} : Bool}:
  pl.sent_go(es, r, d, Nil{}, {==})

def pl.elem_snoc(d: List<&2, Nat>, +t: Nat) -> {Tl.elem(List.append(&2, Nat, d, [t]), t) == True{} : Bool}:
  match d:
    case Nil{}:
      %tools.pl.eq_refl(t) : {Bool.or(_, False{}) == True{} : Bool}
      {==}
    case +y <> +rest:
      pl.or_tr(Nat.is_eq(y, t), Tl.elem(List.append(&2, Nat, rest, [t]), t), pl.elem_snoc(rest, t))

def pl.dyn_reaches_joined(+s: Tl.Sess, +t: Nat) -> {Tl.dyn_call(Tl.step(s, Tl.Join{t}), t) == True{} : Bool}:
  match s:
    case Tl.Sess{r, d, x}:
      pl.elem_snoc(d, t)

# a drop leaves no copy of t; hit is the head test
def pl.drop_go(xs: List<&2, Nat>, +t: Nat, hit: Bool, e: {Tl.is.at(xs, t) == hit : Bool}) -> {Tl.elem(Tl.drop.go(xs, t, hit), t) == False{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +y <> +rest:
      match hit:
        case True{}:
          pl.drop_go(rest, t, Tl.is.at(rest, t), {==})
        case False{}:
          %Equal.sym(Bool, Nat.is_eq(y, t), False{}, e) : {Bool.or(_, Tl.elem(Tl.drop.go(rest, t, Tl.is.at(rest, t)), t)) == False{} : Bool}
          pl.drop_go(rest, t, Tl.is.at(rest, t), {==})

def pl.dyn_drops_quit(+s: Tl.Sess, +t: Nat) -> {Tl.dyn_call(Tl.step(s, Tl.Quit{t}), t) == False{} : Bool}:
  match s:
    case Tl.Sess{r, +d, x}:
      pl.drop_go(d, t, Tl.is.at(d, t), {==})

# 2. The schema
# -------------

def pl.add_has(b: Bool, +ps: List<&2, Nat>, e: {Tl.elem(ps, Tl.intent()) == b : Bool}) -> {Tl.elem(Tl.add_intent(b, ps), Tl.intent()) == True{} : Bool}:
  match b:
    case True{}:
      e
    case False{}:
      {==}

def pl.schema_has_intent(s: Tl.Schema) -> {Tl.elem(Tl.Schema.params(Tl.build(s)), Tl.intent()) == True{} : Bool}:
  match s:
    case Tl.Schema{+ps, v}:
      pl.add_has(Tl.elem(ps, Tl.intent()), ps, {==})

def pl.ver(v: Nat) -> {Nat.is_le(1n, Nat.max(v, 1n)) == True{} : Bool}:
  match v:
    case 0n:
      {==}
    case 1n+p:
      pl.le0(Nat.max(p, 0n))

def pl.schema_versioned(s: Tl.Schema) -> {Nat.is_le(1n, Tl.Schema.version(Tl.build(s))) == True{} : Bool}:
  match s:
    case Tl.Schema{ps, v}:
      pl.ver(v)

def tools.pl.keep(b: Bool, +ps: List<&2, Nat>, +x: Nat, has: {Tl.elem(ps, x) == True{} : Bool}) -> {Tl.elem(Tl.add_intent(b, ps), x) == True{} : Bool}:
  match b:
    case True{}:
      has
    case False{}:
      pl.or_tr(Nat.is_eq(Tl.intent(), x), Tl.elem(ps, x), has)

def pl.schema_keeps_params(+s: Tl.Schema, +x: Nat, has: {Tl.elem(Tl.Schema.params(s), x) == True{} : Bool}) -> {Tl.elem(Tl.Schema.params(Tl.build(s)), x) == True{} : Bool}:
  match s:
    case Tl.Schema{+ps, v}:
      tools.pl.keep(Tl.elem(ps, Tl.intent()), ps, x, has)

def pl.max0(p: Nat) -> {Nat.max(p, 0n) == Nat.max(Nat.max(p, 0n), 0n) : Nat}:
  match p:
    case 0n:
      {==}
    case 1n+q:
      {==}

def pl.max1(v: Nat) -> {Nat.max(v, 1n) == Nat.max(Nat.max(v, 1n), 1n) : Nat}:
  match v:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, n => 1n+n, Nat.max(p, 0n), Nat.max(Nat.max(p, 0n), 0n), pl.max0(p))

def pl.schema_build_idempotent(+s: Tl.Schema) -> {Tl.build(Tl.build(s)) == Tl.build(s) : Tl.Schema}:
  match s:
    case Tl.Schema{+ps, +v}:
      +p = Tl.add_intent(Tl.elem(ps, Tl.intent()), ps)
      %Equal.sym(Bool, Tl.elem(p, Tl.intent()), True{}, pl.add_has(Tl.elem(ps, Tl.intent()), ps, {==})) : {Tl.Schema{Tl.add_intent(_, p), Nat.max(Nat.max(v, 1n), 1n)} == Tl.Schema{p, Nat.max(v, 1n)} : Tl.Schema}
      %pl.max1(v) : {Tl.Schema{Tl.add_intent(True{}, p), _} == Tl.Schema{p, Nat.max(v, 1n)} : Tl.Schema}
      {==}

# 3. A path
# ---------

def pl.len(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case y <> rest:
      1n+pl.len(rest)

# a walk that goes above its root, from the names at, is None
def pl.esc(segs: List<&2, Tl.Seg>, at: List<&2, Nat>, h: {Tl.stays(segs, pl.len(at)) == False{} : Bool}) -> {Tl.walk(segs, at) == None{} : Maybe<&2, List<&2, Nat>>}:
  match segs:
    case Nil{}:
      tools.pl.absurd({Tl.walk(Nil{}, at) == None{} : Maybe<&2, List<&2, Nat>>}, h)
    case s <> rest:
      match s:
        case Tl.Name{n}:
          pl.esc(rest, n <> at, h)
        case Tl.Here{}:
          pl.esc(rest, at, h)
        case Tl.Up{}:
          match at:
            case Nil{}:
              {==}
            case a <> above:
              pl.esc(rest, above, h)

def pl.path_rejects_escape(+segs: List<&2, Tl.Seg>, out: {Tl.stays(segs, 0n) == False{} : Bool}) -> {Tl.resolve(segs) == None{} : Maybe<&2, List<&2, Nat>>}:
  pl.esc(segs, Nil{}, out)

# a walk that stays under its root, from the names at, is Some
def pl.ins(segs: List<&2, Tl.Seg>, at: List<&2, Nat>, h: {Tl.stays(segs, pl.len(at)) == True{} : Bool}) -> {Maybe.is_some(&2, List<&2, Nat>, Tl.walk(segs, at)) == True{} : Bool}:
  match segs:
    case Nil{}:
      {==}
    case s <> rest:
      match s:
        case Tl.Name{n}:
          pl.ins(rest, n <> at, h)
        case Tl.Here{}:
          pl.ins(rest, at, h)
        case Tl.Up{}:
          match at:
            case Nil{}:
              tools.pl.absurdF({Maybe.is_some(&2, List<&2, Nat>, Tl.walk(Tl.Up{} <> rest, Nil{})) == True{} : Bool}, h)
            case a <> above:
              pl.ins(rest, above, h)

def pl.path_resolves_inside(+segs: List<&2, Tl.Seg>, inside: {Tl.stays(segs, 0n) == True{} : Bool}) -> {Maybe.is_some(&2, List<&2, Nat>, Tl.resolve(segs)) == True{} : Bool}:
  pl.ins(segs, Nil{}, inside)

# 4. The approval gate
# --------------------

def pl.steps_add(+s: Tl.Step, r: Tl.Ran) -> {s <> Tl.Ran.steps(r) == Tl.Ran.steps(Tl.ran.add(s, r)) : List<&2, Tl.Step>}:
  match r:
    case Tl.Ran{ss, e}:
      {==}

def pl.fin_add(+s: Tl.Step, r: Tl.Ran, h: {Tl.End.finished(Tl.Ran.end(Tl.ran.add(s, r))) == True{} : Bool}) -> {Tl.End.finished(Tl.Ran.end(r)) == True{} : Bool}:
  match r:
    case Tl.Ran{ss, e}:
      h

# a denied step runs nothing
def pl.gate_no(s: Tl.Step, r: Tl.Ran) -> {Nil{} == Tl.Ran.steps(Tl.gate(False{}, s, r)) : List<&2, Tl.Step>}:
  match s:
    case Tl.Step{i, f}:
      {==}

def pl.gate_den(s: Tl.Step, r: Tl.Ran) -> {Tl.gate(False{}, s, r) == Tl.Ran{Nil{}, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}:
  match s:
    case Tl.Step{i, f}:
      {==}

def pl.gate_no_fin(-A: Type, s: Tl.Step, r: Tl.Ran, h: {Tl.End.finished(Tl.Ran.end(Tl.gate(False{}, s, r))) == True{} : Bool}) -> A:
  match s:
    case Tl.Step{i, f}:
      tools.pl.absurdF(A, h)

def pl.step_refl(s: Tl.Step) -> {Tl.step.eq(s, s) == True{} : Bool}:
  match s:
    case Tl.Step{+i, +f}:
      %tools.pl.eq_refl(i) : {Bool.and(_, Tl.ids.eq(f, f)) == True{} : Bool}
      pl.ids_refl(f)

def pl.prefix_cons(+s: Tl.Step, xs: List<&2, Tl.Step>, ys: List<&2, Tl.Step>, h: {Tl.prefix(xs, ys) == True{} : Bool}) -> {Tl.prefix(s <> xs, s <> ys) == True{} : Bool}:
  %Equal.sym(Bool, Tl.step.eq(s, s), True{}, pl.step_refl(s)) : {Bool.and(_, Tl.prefix(xs, ys)) == True{} : Bool}
  h

# what ran is a prefix of the script, at any head test
def pl.prefix_go(ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, free: Bool, +ans: List<&2, Bool>) -> {Tl.prefix(Tl.Ran.steps(Tl.exec.go(ss, auto, free, ans)), ss) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case +s <> +rest:
      match free:
        case True{}:
          %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)) : {Tl.prefix(_, s <> rest) == True{} : Bool}
          pl.prefix_cons(s, Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)), rest, pl.prefix_go(rest, auto, Tl.free.at(rest, auto), ans))
        case False{}:
          match ans:
            case Nil{}:
              %pl.gate_no(s, Tl.Ran{Nil{}, Tl.Finished{}}) : {Tl.prefix(_, s <> rest) == True{} : Bool}
              {==}
            case +a <> +more:
              match a:
                case True{}:
                  %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)) : {Tl.prefix(_, s <> rest) == True{} : Bool}
                  pl.prefix_cons(s, Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)), rest, pl.prefix_go(rest, auto, Tl.free.at(rest, auto), more))
                case False{}:
                  %pl.gate_no(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)) : {Tl.prefix(_, s <> rest) == True{} : Bool}
                  {==}

def pl.gate_prefix(+ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, ans: List<&2, Bool>) -> {Tl.prefix(Tl.Ran.steps(Tl.exec(ss, auto, ans)), ss) == True{} : Bool}:
  pl.prefix_go(ss, auto, Tl.free.at(ss, auto), ans)

# every gated step that ran used one approval; free is the head test
def pl.yes_go(ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, free: Bool, +ans: List<&2, Bool>, e: {Tl.free.at(ss, auto) == free : Bool}) -> {Nat.is_le(Tl.gated(Tl.Ran.steps(Tl.exec.go(ss, auto, free, ans)), auto), Tl.yeses(ans)) == True{} : Bool}:
  match ss:
    case Nil{}:
      pl.le0(Tl.yeses(ans))
    case +s <> +rest:
      match free:
        case True{}:
          %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)) : {Nat.is_le(Tl.gated(_, auto), Tl.yeses(ans)) == True{} : Bool}
          %Equal.sym(Bool, Tl.auto.at(auto, s), True{}, e) : {Nat.is_le(Nat.add(Tl.gated.one(_), Tl.gated(Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)), auto)), Tl.yeses(ans)) == True{} : Bool}
          pl.yes_go(rest, auto, Tl.free.at(rest, auto), ans, {==})
        case False{}:
          match ans:
            case Nil{}:
              %pl.gate_no(s, Tl.Ran{Nil{}, Tl.Finished{}}) : {Nat.is_le(Tl.gated(_, auto), Tl.yeses(Nil{})) == True{} : Bool}
              {==}
            case +a <> +more:
              match a:
                case True{}:
                  %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)) : {Nat.is_le(Tl.gated(_, auto), Tl.yeses(True{} <> more)) == True{} : Bool}
                  %Equal.sym(Bool, Tl.auto.at(auto, s), False{}, e) : {Nat.is_le(Nat.add(Tl.gated.one(_), Tl.gated(Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)), auto)), Tl.yeses(True{} <> more)) == True{} : Bool}
                  pl.yes_go(rest, auto, Tl.free.at(rest, auto), more, {==})
                case False{}:
                  %pl.gate_no(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)) : {Nat.is_le(Tl.gated(_, auto), Tl.yeses(False{} <> more)) == True{} : Bool}
                  pl.le0(Tl.yeses(more))

def pl.gate_needs_yes(+ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, +ans: List<&2, Bool>) -> {Nat.is_le(Tl.gated(Tl.Ran.steps(Tl.exec(ss, auto, ans)), auto), Tl.yeses(ans)) == True{} : Bool}:
  pl.yes_go(ss, auto, Tl.free.at(ss, auto), ans, {==})

# a free head adds no gated step
def pl.one_zero(b: Bool, -g: Nat, h: {Nat.add(Tl.gated.one(b), g) == 0n : Nat}, hb: {b == True{} : Bool}) -> {g == 0n : Nat}:
  match b:
    case True{}:
      h
    case False{}:
      tools.pl.absurdF({g == 0n : Nat}, hb)

# a held head adds a gated step
def pl.one_nz(-A: Type, b: Bool, -g: Nat, h: {Nat.add(Tl.gated.one(b), g) == 0n : Nat}, hb: {b == False{} : Bool}) -> A:
  match b:
    case True{}:
      tools.pl.absurd(A, hb)
    case False{}:
      %h : pl.ND(_, A, Unit)
      Unit{}

# free steps run through to the held step s, which a denial stops
def pl.deny_go(pre: List<&2, Tl.Step>, +s: Tl.Step, +post: List<&2, Tl.Step>, +auto: List<&2, Nat>, +ans: List<&2, Bool>, free: Bool, e: {Tl.free.at(List.append(&2, Tl.Step, pre, s <> post), auto) == free : Bool}, gf: {Tl.gated(pre, auto) == 0n : Nat}, held: {Tl.auto.at(auto, s) == False{} : Bool}) -> {Tl.exec.go(List.append(&2, Tl.Step, pre, s <> post), auto, free, False{} <> ans) == Tl.Ran{pre, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}:
  match pre:
    case Nil{}:
      match free:
        case True{}:
          tools.pl.absurd({Tl.exec.go(s <> post, auto, True{}, False{} <> ans) == Tl.Ran{Nil{}, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}, Equal.trans(Bool, True{}, Tl.auto.at(auto, s), False{}, Equal.sym(Bool, Tl.auto.at(auto, s), True{}, e), held))
        case False{}:
          pl.gate_den(s, Tl.exec.go(post, auto, Tl.free.at(post, auto), ans))
    case +p <> +prest:
      match free:
        case True{}:
          Equal.cong(Tl.Ran, Tl.Ran, r => Tl.ran.add(p, r), Tl.exec.go(List.append(&2, Tl.Step, prest, s <> post), auto, Tl.free.at(List.append(&2, Tl.Step, prest, s <> post), auto), False{} <> ans), Tl.Ran{prest, Tl.Denied{Tl.Step.id(s)}}, pl.deny_go(prest, s, post, auto, ans, Tl.free.at(List.append(&2, Tl.Step, prest, s <> post), auto), {==}, pl.one_zero(Tl.auto.at(auto, p), Tl.gated(prest, auto), gf, e), held))
        case False{}:
          pl.one_nz({Tl.exec.go(p <> List.append(&2, Tl.Step, prest, s <> post), auto, False{}, False{} <> ans) == Tl.Ran{p <> prest, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}, Tl.auto.at(auto, p), Tl.gated(prest, auto), gf, e)

def pl.gate_deny_stops(+pre: List<&2, Tl.Step>, +s: Tl.Step, +post: List<&2, Tl.Step>, +auto: List<&2, Nat>, ans: List<&2, Bool>, free: {Tl.gated(pre, auto) == 0n : Nat}, held: {Tl.auto.at(auto, s) == False{} : Bool}) -> {Tl.exec(List.append(&2, Tl.Step, pre, s <> post), auto, False{} <> ans) == Tl.Ran{pre, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}:
  pl.deny_go(pre, s, post, auto, ans, Tl.free.at(List.append(&2, Tl.Step, pre, s <> post), auto), {==}, free, held)

# a run that finished ran every step, at any head test
def pl.fin_go(ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, free: Bool, +ans: List<&2, Bool>, h: {Tl.End.finished(Tl.Ran.end(Tl.exec.go(ss, auto, free, ans))) == True{} : Bool}) -> {Tl.Ran.steps(Tl.exec.go(ss, auto, free, ans)) == ss : List<&2, Tl.Step>}:
  match ss:
    case Nil{}:
      {==}
    case +s <> +rest:
      match free:
        case True{}:
          %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)) : {_ == s <> rest : List<&2, Tl.Step>}
          Equal.cong(List<&2, Tl.Step>, List<&2, Tl.Step>, xs => s <> xs, Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans)), rest, pl.fin_go(rest, auto, Tl.free.at(rest, auto), ans, pl.fin_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), ans), h)))
        case False{}:
          match ans:
            case Nil{}:
              pl.gate_no_fin({Tl.Ran.steps(Tl.gate(False{}, s, Tl.Ran{Nil{}, Tl.Finished{}})) == s <> rest : List<&2, Tl.Step>}, s, Tl.Ran{Nil{}, Tl.Finished{}}, h)
            case +a <> +more:
              match a:
                case True{}:
                  %pl.steps_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)) : {_ == s <> rest : List<&2, Tl.Step>}
                  Equal.cong(List<&2, Tl.Step>, List<&2, Tl.Step>, xs => s <> xs, Tl.Ran.steps(Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more)), rest, pl.fin_go(rest, auto, Tl.free.at(rest, auto), more, pl.fin_add(s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more), h)))
                case False{}:
                  pl.gate_no_fin({Tl.Ran.steps(Tl.gate(False{}, s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more))) == s <> rest : List<&2, Tl.Step>}, s, Tl.exec.go(rest, auto, Tl.free.at(rest, auto), more), h)

def pl.gate_finish_runs_all(+ss: List<&2, Tl.Step>, +auto: List<&2, Nat>, +ans: List<&2, Bool>, fin: {Tl.End.finished(Tl.Ran.end(Tl.exec(ss, auto, ans))) == True{} : Bool}) -> {Tl.Ran.steps(Tl.exec(ss, auto, ans)) == ss : List<&2, Tl.Step>}:
  pl.fin_go(ss, auto, Tl.free.at(ss, auto), ans, fin)

# ---- screen ----

# proof_screen: the S8 laws (docs/interface.md) of the interface model in
# bend/screen.bend: the scrollback has no gap and only grows, a resize and
# a flush keep it in order, the pacer never runs ahead nor back and drains
# a backlog, only checked frames reach the terminal, and a vertical stack
# keeps its children inside the viewport, apart, and whole when they fit.

# Logic
# -----

def screen.ps.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def screen.ps.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : screen.ps.BD(_, A, Unit)
  Unit{}

def screen.ps.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      screen.ps.absurdF({False{} == True{} : Bool}, h)

def screen.ps.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      screen.ps.absurdF({b == True{} : Bool}, h)

def screen.ps.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def screen.ps.or_tr(a: Bool, +b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

# Numbers
# -------

def screen.ps.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      screen.ps.eq_refl(p)

def ps.le0(t: Nat) -> {Nat.is_le(0n, t) == True{} : Bool}:
  match t:
    case 0n:
      {==}
    case 1n+q:
      {==}

def screen.ps.le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      screen.ps.le_refl(p)

def screen.ps.le_succ(n: Nat) -> {Nat.is_le(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      screen.ps.le_succ(p)

def screen.ps.le_trans(a: Nat, b: Nat, c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      ps.le0(c)
    case 1n+ap 0n _:
      screen.ps.absurdF({Nat.is_le(1n+ap, c) == True{} : Bool}, ab)
    case 1n+ap 1n+bp 0n:
      screen.ps.absurdF({Nat.is_le(1n+ap, 0n) == True{} : Bool}, bc)
    case 1n+ap 1n+bp 1n+cp:
      screen.ps.le_trans(ap, bp, cp, ab, bc)

# s is at most s + x
def ps.le_add_self(s: Nat, +x: Nat) -> {Nat.is_le(s, Nat.add(s, x)) == True{} : Bool}:
  match s:
    case 0n:
      ps.le0(x)
    case 1n+p:
      ps.le_add_self(p, x)

def ps.le_add_r(s: Nat, r: Nat, +n: Nat, h: {Nat.is_le(s, r) == True{} : Bool}) -> {Nat.is_le(s, Nat.add(r, n)) == True{} : Bool}:
  match s r:
    case 0n _:
      ps.le0(Nat.add(r, n))
    case 1n+sp 0n:
      screen.ps.absurdF({Nat.is_le(1n+sp, Nat.add(0n, n)) == True{} : Bool}, h)
    case 1n+sp 1n+rp:
      ps.le_add_r(sp, rp, n, h)

def screen.ps.le_add_l(y: Nat, +a: Nat, +b: Nat, h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.add(y, a), Nat.add(y, b)) == True{} : Bool}:
  match y:
    case 0n:
      h
    case 1n+p:
      screen.ps.le_add_l(p, a, b, h)

def ps.le_assoc(y: Nat, +h: Nat, +s: Nat, rows: Nat, f: {Nat.is_le(Nat.add(y, Nat.add(h, s)), rows) == True{} : Bool}) -> {Nat.is_le(Nat.add(Nat.add(y, h), s), rows) == True{} : Bool}:
  match y rows:
    case 0n _:
      f
    case 1n+p 0n:
      screen.ps.absurdF({Nat.is_le(Nat.add(Nat.add(1n+p, h), s), 0n) == True{} : Bool}, f)
    case 1n+p 1n+rp:
      ps.le_assoc(p, h, s, rp, f)

def ps.le_addl(n: Nat, +p: Nat, m: Nat, h: {Nat.is_le(Nat.add(n, p), m) == True{} : Bool}) -> {Nat.is_le(n, m) == True{} : Bool}:
  match n m:
    case 0n _:
      ps.le0(m)
    case 1n+np 0n:
      screen.ps.absurdF({Nat.is_le(1n+np, 0n) == True{} : Bool}, h)
    case 1n+np 1n+mp:
      ps.le_addl(np, p, mp, h)

def ps.le_sub(n: Nat, +p: Nat, m: Nat, h: {Nat.is_le(Nat.add(n, p), m) == True{} : Bool}) -> {Nat.is_le(p, Nat.sub(m, n)) == True{} : Bool}:
  match n m:
    case 0n 0n:
      h
    case 0n 1n+mp:
      h
    case 1n+np 0n:
      screen.ps.absurdF({Nat.is_le(p, 0n) == True{} : Bool}, h)
    case 1n+np 1n+mp:
      ps.le_sub(np, p, mp, h)

def ps.sub_le(+n: Nat, +m: Nat) -> {Nat.is_le(Nat.sub(n, m), n) == True{} : Bool}:
  match n m:
    case 0n _:
      {==}
    case 1n+np 0n:
      screen.ps.le_refl(1n+np)
    case 1n+np 1n+mp:
      screen.ps.le_trans(Nat.sub(np, mp), np, 1n+np, ps.sub_le(np, mp), screen.ps.le_succ(np))

def ps.sub_sub(c: Nat, k: Nat, +n: Nat) -> {Nat.sub(Nat.sub(c, k), n) == Nat.sub(c, Nat.add(k, n)) : Nat}:
  match c k:
    case 0n _:
      {==}
    case 1n+cp 0n:
      {==}
    case 1n+cp 1n+kp:
      ps.sub_sub(cp, kp, n)

def ps.min_le_l(n: Nat, m: Nat) -> {Nat.is_le(Nat.min(n, m), n) == True{} : Bool}:
  match n m:
    case 0n _:
      {==}
    case 1n+np 0n:
      {==}
    case 1n+np 1n+mp:
      ps.min_le_l(np, mp)

def ps.min_le_r(n: Nat, m: Nat) -> {Nat.is_le(Nat.min(n, m), m) == True{} : Bool}:
  match n m:
    case 0n _:
      ps.le0(m)
    case 1n+np 0n:
      {==}
    case 1n+np 1n+mp:
      ps.min_le_r(np, mp)

def ps.min_of_le(n: Nat, m: Nat, h: {Nat.is_le(n, m) == True{} : Bool}) -> {Nat.min(n, m) == n : Nat}:
  match n m:
    case 0n _:
      {==}
    case 1n+np 0n:
      screen.ps.absurdF({Nat.min(1n+np, 0n) == 1n+np : Nat}, h)
    case 1n+np 1n+mp:
      %ps.min_of_le(np, mp, h) : {1n+Nat.min(np, mp) == 1n+_ : Nat}
      {==}

# a maximum with a positive side is positive
def ps.max_ge(min: Nat, x: Nat, one: {Nat.is_le(1n, min) == True{} : Bool}) -> {Nat.is_le(1n, Nat.max(min, x)) == True{} : Bool}:
  match min x:
    case 0n _:
      screen.ps.absurdF({Nat.is_le(1n, Nat.max(0n, x)) == True{} : Bool}, one)
    case 1n+mp 0n:
      ps.le0(mp)
    case 1n+mp 1n+xp:
      ps.le0(Nat.max(mp, xp))

def ps.eq_of(s: Nat, r: Nat, h1: {Nat.is_le(s, r) == True{} : Bool}, h2: {Nat.is_le(Nat.sub(r, s), 0n) == True{} : Bool}) -> {s == r : Nat}:
  match s r:
    case 0n 0n:
      {==}
    case 0n 1n+rp:
      screen.ps.absurdF({0n == 1n+rp : Nat}, h2)
    case 1n+sp 0n:
      screen.ps.absurdF({1n+sp == 0n : Nat}, h1)
    case 1n+sp 1n+rp:
      %ps.eq_of(sp, rp, h1, h2) : {1n+sp == 1n+_ : Nat}
      {==}

# 1. The transcript
# -----------------

def ps.lcons(-x: Sc.Line, -a: List<&2, Sc.Line>, -b: List<&2, Sc.Line>, e: {a == b : List<&2, Sc.Line>}) -> {x <> a == x <> b : List<&2, Sc.Line>}:
  %e : {x <> a == x <> _ : List<&2, Sc.Line>}
  {==}

def ps.run_app(pre: List<&2, Sc.Ev>, -post: List<&2, Sc.Ev>, +t: Sc.Tx) -> {Sc.run(post, Sc.run(pre, t)) == Sc.run(List.append(&2, Sc.Ev, pre, post), t) : Sc.Tx}:
  match pre:
    case Nil{}:
      {==}
    case +e <> rest:
      ps.run_app(rest, post, Sc.step(t, e))

# a new active block at the end changes no gap
def ps.gapp(bs: List<&2, Sc.Blk>, +i: Nat, +l: Nat, +seen: Bool) -> {Sc.gapless.go(bs, seen) == Sc.gapless.go(List.append(&2, Sc.Blk, bs, [Sc.Blk{i, Sc.Active{}, l}]), seen) : Bool}:
  match bs:
    case Nil{}:
      {==}
    case b <> rest:
      match b:
        case Sc.Blk{bi, s, bl}:
          match s:
            case Sc.Comm{}:
              match seen:
                case True{}:
                  {==}
                case False{}:
                  ps.gapp(rest, i, l, False{})
            case Sc.Final{}:
              ps.gapp(rest, i, l, True{})
            case Sc.Active{}:
              ps.gapp(rest, i, l, True{})

# a growth or a final changes no gap
def ps.gedit(bs: List<&2, Sc.Blk>, +x: Nat, hit: Bool, +g: Maybe<&2, Nat>, +seen: Bool) -> {Sc.gapless.go(bs, seen) == Sc.gapless.go(Sc.edit.go(bs, x, g, hit), seen) : Bool}:
  match bs:
    case Nil{}:
      {==}
    case b <> +rest:
      match b:
        case Sc.Blk{i, s, l}:
          match s:
            case Sc.Comm{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      match seen:
                        case True{}:
                          {==}
                        case False{}:
                          ps.gedit(rest, x, Sc.bid.at(rest, x), None{}, False{})
                    case Some{n}:
                      match seen:
                        case True{}:
                          {==}
                        case False{}:
                          ps.gedit(rest, x, Sc.bid.at(rest, x), Some{n}, False{})
                case False{}:
                  match seen:
                    case True{}:
                      {==}
                    case False{}:
                      ps.gedit(rest, x, Sc.bid.at(rest, x), g, False{})
            case Sc.Final{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      ps.gedit(rest, x, Sc.bid.at(rest, x), None{}, True{})
                    case Some{n}:
                      ps.gedit(rest, x, Sc.bid.at(rest, x), Some{n}, True{})
                case False{}:
                  ps.gedit(rest, x, Sc.bid.at(rest, x), g, True{})
            case Sc.Active{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      ps.gedit(rest, x, Sc.bid.at(rest, x), None{}, True{})
                    case Some{n}:
                      ps.gedit(rest, x, Sc.bid.at(rest, x), Some{n}, True{})
                case False{}:
                  ps.gedit(rest, x, Sc.bid.at(rest, x), g, True{})

# a flush of blocks without a gap after `seen` leaves no gap
def ps.gflush(bs: List<&2, Sc.Blk>, seen: Bool, h: {Sc.gapless.go(bs, seen) == True{} : Bool}) -> {Sc.gapless.go(Sc.flush(bs), False{}) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case b <> rest:
      match b:
        case Sc.Blk{i, s, l}:
          match s:
            case Sc.Comm{}:
              match seen:
                case True{}:
                  screen.ps.absurdF({Sc.gapless.go(Sc.flush(Sc.Blk{i, Sc.Comm{}, l} <> rest), False{}) == True{} : Bool}, h)
                case False{}:
                  ps.gflush(rest, False{}, h)
            case Sc.Final{}:
              ps.gflush(rest, True{}, h)
            case Sc.Active{}:
              h

def ps.gstep(+t: Sc.Tx, +e: Sc.Ev, h: {Sc.gapless(Sc.Tx.blocks(t)) == True{} : Bool}) -> {Sc.gapless(Sc.Tx.blocks(Sc.step(t, e))) == True{} : Bool}:
  match t:
    case Sc.Tx{+bs, +n, w}:
      match e:
        case Sc.Open{}:
          %ps.gapp(bs, n, 0n, False{}) : {_ == True{} : Bool}
          h
        case Sc.Grow{+x, k}:
          %ps.gedit(bs, x, Sc.bid.at(bs, x), Some{k}, False{}) : {_ == True{} : Bool}
          h
        case Sc.Fin{+x}:
          %ps.gedit(bs, x, Sc.bid.at(bs, x), None{}, False{}) : {_ == True{} : Bool}
          h
        case Sc.Flush{}:
          ps.gflush(bs, False{}, h)
        case Sc.Resize{v}:
          h

def ps.grun(es: List<&2, Sc.Ev>, +t: Sc.Tx, h: {Sc.gapless(Sc.Tx.blocks(t)) == True{} : Bool}) -> {Sc.gapless(Sc.Tx.blocks(Sc.run(es, t))) == True{} : Bool}:
  match es:
    case Nil{}:
      h
    case +e <> rest:
      ps.grun(rest, Sc.step(t, e), ps.gstep(t, e, h))

def ps.tx_gapless(es: List<&2, Sc.Ev>, +w: Nat) -> {Sc.gapless(Sc.Tx.blocks(Sc.run(es, Sc.Tx{Nil{}, 0n, w}))) == True{} : Bool}:
  ps.grun(es, Sc.Tx{Nil{}, 0n, w}, {==})

# a new active block at the end changes no scrollback
def ps.sapp(bs: List<&2, Sc.Blk>, +i: Nat, +l: Nat) -> {Sc.scroll(bs) == Sc.scroll(List.append(&2, Sc.Blk, bs, [Sc.Blk{i, Sc.Active{}, l}])) : List<&2, Sc.Line>}:
  match bs:
    case Nil{}:
      {==}
    case b <> rest:
      match b:
        case Sc.Blk{+bi, s, +bl}:
          match s:
            case Sc.Comm{}:
              ps.lcons(Sc.Line{bi, bl}, Sc.scroll(rest), Sc.scroll(List.append(&2, Sc.Blk, rest, [Sc.Blk{i, Sc.Active{}, l}])), ps.sapp(rest, i, l))
            case Sc.Final{}:
              {==}
            case Sc.Active{}:
              {==}

# a growth or a final changes no scrollback
def ps.sedit(bs: List<&2, Sc.Blk>, +x: Nat, hit: Bool, +g: Maybe<&2, Nat>) -> {Sc.scroll(bs) == Sc.scroll(Sc.edit.go(bs, x, g, hit)) : List<&2, Sc.Line>}:
  match bs:
    case Nil{}:
      {==}
    case b <> +rest:
      match b:
        case Sc.Blk{+i, s, +l}:
          match s:
            case Sc.Comm{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      ps.lcons(Sc.Line{i, l}, Sc.scroll(rest), Sc.scroll(Sc.edit.go(rest, x, None{}, Sc.bid.at(rest, x))), ps.sedit(rest, x, Sc.bid.at(rest, x), None{}))
                    case Some{+n}:
                      ps.lcons(Sc.Line{i, l}, Sc.scroll(rest), Sc.scroll(Sc.edit.go(rest, x, Some{n}, Sc.bid.at(rest, x))), ps.sedit(rest, x, Sc.bid.at(rest, x), Some{n}))
                case False{}:
                  ps.lcons(Sc.Line{i, l}, Sc.scroll(rest), Sc.scroll(Sc.edit.go(rest, x, g, Sc.bid.at(rest, x))), ps.sedit(rest, x, Sc.bid.at(rest, x), g))
            case Sc.Final{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      {==}
                    case Some{n}:
                      {==}
                case False{}:
                  {==}
            case Sc.Active{}:
              match hit:
                case True{}:
                  match g:
                    case None{}:
                      {==}
                    case Some{n}:
                      {==}
                case False{}:
                  {==}

# a flush keeps every prefix of the scrollback
def ps.flush_pre(bs: List<&2, Sc.Blk>, X: List<&2, Sc.Line>, +h: {Sc.pre(X, Sc.scroll(bs)) == True{} : Bool}) -> {Sc.pre(X, Sc.scroll(Sc.flush(bs))) == True{} : Bool}:
  match bs:
    case Nil{}:
      h
    case b <> +rest:
      match b:
        case Sc.Blk{+i, s, +l}:
          match s:
            case Sc.Comm{}:
              match X:
                case Nil{}:
                  {==}
                case Sc.Line{+a, +c} <> +xr:
                  +q = Bool.and(Nat.is_eq(a, i), Nat.is_eq(c, l))
                  screen.ps.and_t(q, Sc.pre(xr, Sc.scroll(Sc.flush(rest))), screen.ps.and_l(q, Sc.pre(xr, Sc.scroll(rest)), h), ps.flush_pre(rest, xr, screen.ps.and_r(q, Sc.pre(xr, Sc.scroll(rest)), h)))
            case Sc.Final{}:
              match X:
                case Nil{}:
                  {==}
                case Sc.Line{a, c} <> xr:
                  screen.ps.absurdF({Sc.pre(Sc.Line{a, c} <> xr, Sc.scroll(Sc.flush(Sc.Blk{i, Sc.Final{}, l} <> rest))) == True{} : Bool}, h)
            case Sc.Active{}:
              h

def ps.sstep(+t: Sc.Tx, +e: Sc.Ev, +X: List<&2, Sc.Line>, h: {Sc.pre(X, Sc.scroll(Sc.Tx.blocks(t))) == True{} : Bool}) -> {Sc.pre(X, Sc.scroll(Sc.Tx.blocks(Sc.step(t, e)))) == True{} : Bool}:
  match t:
    case Sc.Tx{+bs, +n, w}:
      match e:
        case Sc.Open{}:
          %ps.sapp(bs, n, 0n) : {Sc.pre(X, _) == True{} : Bool}
          h
        case Sc.Grow{+x, k}:
          %ps.sedit(bs, x, Sc.bid.at(bs, x), Some{k}) : {Sc.pre(X, _) == True{} : Bool}
          h
        case Sc.Fin{+x}:
          %ps.sedit(bs, x, Sc.bid.at(bs, x), None{}) : {Sc.pre(X, _) == True{} : Bool}
          h
        case Sc.Flush{}:
          ps.flush_pre(bs, X, h)
        case Sc.Resize{v}:
          h

def ps.srun(post: List<&2, Sc.Ev>, +t: Sc.Tx, +X: List<&2, Sc.Line>, h: {Sc.pre(X, Sc.scroll(Sc.Tx.blocks(t))) == True{} : Bool}) -> {Sc.pre(X, Sc.scroll(Sc.Tx.blocks(Sc.run(post, t)))) == True{} : Bool}:
  match post:
    case Nil{}:
      h
    case +e <> rest:
      ps.srun(rest, Sc.step(t, e), X, ps.sstep(t, e, X, h))

def ps.pre_refl(X: List<&2, Sc.Line>) -> {Sc.pre(X, X) == True{} : Bool}:
  match X:
    case Nil{}:
      {==}
    case Sc.Line{+a, +c} <> +xr:
      %screen.ps.eq_refl(a) : {Bool.and(Bool.and(_, Nat.is_eq(c, c)), Sc.pre(xr, xr)) == True{} : Bool}
      %screen.ps.eq_refl(c) : {Bool.and(Bool.and(True{}, _), Sc.pre(xr, xr)) == True{} : Bool}
      ps.pre_refl(xr)

def ps.tx_scrollback_append_only(+pre: List<&2, Sc.Ev>, post: List<&2, Sc.Ev>, +w: Nat) -> {Sc.pre(Sc.scroll(Sc.Tx.blocks(Sc.run(pre, Sc.Tx{Nil{}, 0n, w}))), Sc.scroll(Sc.Tx.blocks(Sc.run(List.append(&2, Sc.Ev, pre, post), Sc.Tx{Nil{}, 0n, w})))) == True{} : Bool}:
  +t = Sc.run(pre, Sc.Tx{Nil{}, 0n, w})
  +X = Sc.scroll(Sc.Tx.blocks(t))
  %ps.run_app(pre, post, Sc.Tx{Nil{}, 0n, w}) : {Sc.pre(X, Sc.scroll(Sc.Tx.blocks(_))) == True{} : Bool}
  ps.srun(post, t, X, ps.pre_refl(X))

def ps.tx_resize_keeps(+t: Sc.Tx, +w: Nat) -> {Sc.Tx.blocks(Sc.step(t, Sc.Resize{w})) == Sc.Tx.blocks(t) : List<&2, Sc.Blk>}:
  match t:
    case Sc.Tx{bs, n, v}:
      {==}

def ps.flushed_flush(bs: List<&2, Sc.Blk>) -> {Sc.flushed(Sc.flush(bs)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case b <> rest:
      match b:
        case Sc.Blk{i, s, l}:
          match s:
            case Sc.Comm{}:
              ps.flushed_flush(rest)
            case Sc.Final{}:
              ps.flushed_flush(rest)
            case Sc.Active{}:
              {==}

def ps.tx_flush_settles(+t: Sc.Tx) -> {Sc.flushed(Sc.Tx.blocks(Sc.step(t, Sc.Flush{}))) == True{} : Bool}:
  match t:
    case Sc.Tx{bs, n, w}:
      ps.flushed_flush(bs)

# 2. Pacing
# ---------

# a frame shows no more than the backlog
def ps.bound(s: Nat, r: Nat, +x: Nat, h: {Nat.is_le(s, r) == True{} : Bool}) -> {Nat.is_le(Nat.add(s, Nat.min(Nat.sub(r, s), x)), r) == True{} : Bool}:
  match s r:
    case 0n 0n:
      {==}
    case 0n 1n+rp:
      ps.min_le_l(1n+rp, x)
    case 1n+sp 0n:
      screen.ps.absurdF({Nat.is_le(Nat.add(1n+sp, Nat.min(Nat.sub(0n, 1n+sp), x)), 0n) == True{} : Bool}, h)
    case 1n+sp 1n+rp:
      ps.bound(sp, rp, x, h)

def ps.step_ahead(+min: Nat, +k: Nat, p: Sc.Pace, e: Sc.PEv, h: {Nat.is_le(Sc.Pace.shown(p), Sc.Pace.recv(p)) == True{} : Bool}) -> {Nat.is_le(Sc.Pace.shown(Sc.pace.step(min, k, p, e)), Sc.Pace.recv(Sc.pace.step(min, k, p, e))) == True{} : Bool}:
  match p:
    case Sc.Pace{+r, +s}:
      match e:
        case Sc.Chunk{n}:
          ps.le_add_r(s, r, n, h)
        case Sc.Frame{}:
          ps.bound(s, r, Nat.max(min, Nat.div(Nat.sub(r, s), 1n+k)), h)

def ps.run_ahead(es: List<&2, Sc.PEv>, +min: Nat, +k: Nat, +p: Sc.Pace, h: {Nat.is_le(Sc.Pace.shown(p), Sc.Pace.recv(p)) == True{} : Bool}) -> {Nat.is_le(Sc.Pace.shown(Sc.pace.run(es, min, k, p)), Sc.Pace.recv(Sc.pace.run(es, min, k, p))) == True{} : Bool}:
  match es:
    case Nil{}:
      h
    case +e <> rest:
      ps.run_ahead(rest, min, k, Sc.pace.step(min, k, p, e), ps.step_ahead(min, k, p, e, h))

def ps.pace_never_ahead(es: List<&2, Sc.PEv>, +min: Nat, +k: Nat) -> {Nat.is_le(Sc.Pace.shown(Sc.pace.run(es, min, k, Sc.Pace{0n, 0n})), Sc.Pace.recv(Sc.pace.run(es, min, k, Sc.Pace{0n, 0n}))) == True{} : Bool}:
  ps.run_ahead(es, min, k, Sc.Pace{0n, 0n}, {==})

def ps.pace_never_back(+min: Nat, +k: Nat, +p: Sc.Pace, e: Sc.PEv) -> {Nat.is_le(Sc.Pace.shown(p), Sc.Pace.shown(Sc.pace.step(min, k, p, e))) == True{} : Bool}:
  match p:
    case Sc.Pace{+r, +s}:
      match e:
        case Sc.Chunk{n}:
          screen.ps.le_refl(s)
        case Sc.Frame{}:
          ps.le_add_self(s, Sc.reveal(min, k, Nat.sub(r, s)))

# a frame with a positive step takes at least one character off a
# backlog of at most 1 + m
def ps.drop(+b: Nat, +m: Nat, +x: Nat, hb: {Nat.is_le(b, 1n+m) == True{} : Bool}, hx: {Nat.is_le(1n, x) == True{} : Bool}) -> {Nat.is_le(Nat.sub(b, Nat.min(b, x)), m) == True{} : Bool}:
  match b x:
    case 0n _:
      ps.le0(m)
    case 1n+bp 0n:
      screen.ps.absurdF({Nat.is_le(Nat.sub(1n+bp, Nat.min(1n+bp, 0n)), m) == True{} : Bool}, hx)
    case 1n+bp 1n+xp:
      screen.ps.le_trans(Nat.sub(bp, Nat.min(bp, xp)), bp, m, ps.sub_le(bp, Nat.min(bp, xp)), hb)

def ps.drop_after(+r: Nat, +s: Nat, +m: Nat, +x: Nat, hb: {Nat.is_le(Nat.sub(r, s), 1n+m) == True{} : Bool}, hx: {Nat.is_le(1n, x) == True{} : Bool}) -> {Nat.is_le(Nat.sub(r, Nat.add(s, Nat.min(Nat.sub(r, s), x))), m) == True{} : Bool}:
  %ps.sub_sub(r, s, Nat.min(Nat.sub(r, s), x)) : {Nat.is_le(_, m) == True{} : Bool}
  ps.drop(Nat.sub(r, s), m, x, hb, hx)

def ps.drains_go(+n: Nat, +min: Nat, +k: Nat, +p: Sc.Pace, +one: {Nat.is_le(1n, min) == True{} : Bool}, behind: {Nat.is_le(Sc.Pace.shown(p), Sc.Pace.recv(p)) == True{} : Bool}, enough: {Nat.is_le(Nat.sub(Sc.Pace.recv(p), Sc.Pace.shown(p)), n) == True{} : Bool}) -> {Sc.Pace.shown(Sc.pace.run(Sc.frames(n), min, k, p)) == Sc.Pace.recv(p) : Nat}:
  match n:
    case 0n:
      match p:
        case Sc.Pace{r, s}:
          ps.eq_of(s, r, behind, enough)
    case 1n+m:
      match p:
        case Sc.Pace{+r, +s}:
          +x = Nat.max(min, Nat.div(Nat.sub(r, s), 1n+k))
          ps.drains_go(m, min, k, Sc.Pace{r, Nat.add(s, Nat.min(Nat.sub(r, s), x))}, one, ps.bound(s, r, x, behind), ps.drop_after(r, s, m, x, enough, ps.max_ge(min, Nat.div(Nat.sub(r, s), 1n+k), one)))

def ps.pace_drains(+min: Nat, +k: Nat, +p: Sc.Pace, +n: Nat, one: {Nat.is_le(1n, min) == True{} : Bool}, behind: {Nat.is_le(Sc.Pace.shown(p), Sc.Pace.recv(p)) == True{} : Bool}, enough: {Nat.is_le(Nat.sub(Sc.Pace.recv(p), Sc.Pace.shown(p)), n) == True{} : Bool}) -> {Sc.Pace.shown(Sc.pace.run(Sc.frames(n), min, k, p)) == Sc.Pace.recv(p) : Nat}:
  ps.drains_go(n, min, k, p, one, behind, enough)

# 3. Off-screen verification
# --------------------------

def ps.verify_only_checked(f: Nat, g: Nat, +ok1: Bool, +ok2: Bool) -> {Sc.checked(Sc.present(f, g, ok1, ok2), ok1, ok2) == True{} : Bool}:
  match ok1:
    case True{}:
      {==}
    case False{}:
      match ok2:
        case True{}:
          {==}
        case False{}:
          {==}

# 4. Layout
# ---------

# one child placed at row y ends inside the viewport, or is not shown
def ps.inside_one(+y: Nat, +rows: Nat, +h: Nat) -> {Bool.or(Nat.is_eq(Nat.min(h, Nat.sub(rows, y)), 0n), Nat.is_le(Nat.add(y, Nat.min(h, Nat.sub(rows, y))), rows)) == True{} : Bool}:
  match y rows:
    case 0n 0n:
      match h:
        case 0n:
          {==}
        case 1n+hp:
          {==}
    case 0n 1n+rp:
      screen.ps.or_tr(Nat.is_eq(Nat.min(h, 1n+rp), 0n), Nat.is_le(Nat.min(h, 1n+rp), 1n+rp), ps.min_le_r(h, 1n+rp))
    case 1n+yp 0n:
      match h:
        case 0n:
          {==}
        case 1n+hp:
          {==}
    case 1n+yp 1n+rp:
      ps.inside_one(yp, rp, h)

def ps.layout_inside(hs: List<&2, Nat>, +y: Nat, +rows: Nat) -> {Sc.inside(Sc.vstack(hs, y, rows), rows) == True{} : Bool}:
  match hs:
    case Nil{}:
      {==}
    case +h <> +rest:
      +m = Nat.min(h, Nat.sub(rows, y))
      screen.ps.and_t(Bool.or(Nat.is_eq(m, 0n), Nat.is_le(Nat.add(y, m), rows)), Sc.inside(Sc.vstack(rest, Nat.add(y, h), rows), rows), ps.inside_one(y, rows, h), ps.layout_inside(rest, Nat.add(y, h), rows))

# children placed from row y keep apart from any row z at or above y
def ps.apart_go(hs: List<&2, Nat>, +y: Nat, +rows: Nat, +z: Nat, hz: {Nat.is_le(z, y) == True{} : Bool}) -> {Sc.apart(Sc.vstack(hs, y, rows), z) == True{} : Bool}:
  match hs:
    case Nil{}:
      {==}
    case +h <> +rest:
      +m = Nat.min(h, Nat.sub(rows, y))
      screen.ps.and_t(Nat.is_le(z, y), Sc.apart(Sc.vstack(rest, Nat.add(y, h), rows), Nat.add(y, m)), hz, ps.apart_go(rest, Nat.add(y, h), rows, Nat.add(y, m), screen.ps.le_add_l(y, m, h, ps.min_le_l(h, Nat.sub(rows, y)))))

def ps.layout_apart(hs: List<&2, Nat>, +y: Nat, +rows: Nat) -> {Sc.apart(Sc.vstack(hs, y, rows), y) == True{} : Bool}:
  ps.apart_go(hs, y, rows, y, screen.ps.le_refl(y))

def ps.ncons(-a: Nat, -b: Nat, -xs: List<&2, Nat>, -ys: List<&2, Nat>, e1: {a == b : Nat}, e2: {xs == ys : List<&2, Nat>}) -> {a <> xs == b <> ys : List<&2, Nat>}:
  %e1 : {a <> xs == _ <> ys : List<&2, Nat>}
  %e2 : {a <> xs == a <> _ : List<&2, Nat>}
  {==}

def ps.layout_whole_when_room(+hs: List<&2, Nat>, +y: Nat, +rows: Nat, fits: {Nat.is_le(Nat.add(y, Sc.sum(hs)), rows) == True{} : Bool}) -> {Sc.heights(Sc.vstack(hs, y, rows)) == hs : List<&2, Nat>}:
  match hs:
    case Nil{}:
      {==}
    case +h <> +rest:
      +f2 = ps.le_assoc(y, h, Sc.sum(rest), rows, fits)
      +hl = ps.le_sub(y, h, rows, ps.le_addl(Nat.add(y, h), Sc.sum(rest), rows, f2))
      ps.ncons(Nat.min(h, Nat.sub(rows, y)), h, Sc.heights(Sc.vstack(rest, Nat.add(y, h), rows)), rest, ps.min_of_le(h, Nat.sub(rows, y), hl), ps.layout_whole_when_room(rest, Nat.add(y, h), rows, f2))

# ---- tiny ----

# proof_tiny: the S9 laws (docs/inference.md) of the tiny-model model in
# bend/tiny.bend.
#
# A pick scans its chain with the test of the head as a parameter: a hit
# gives the head, which is in the chain and available; a miss moves on
# to the rest, so the first available model wins and a chain with none
# available ends in Unavailable. Every event's need lists exactly one
# outcome and an exit none, so the outcomes count the needs. A worker's
# tag after one event is the tag of that need (a join keeps a worker of
# the same tag) or none after an exit, which carries the last tag along
# the events.

# Logic
# -----

def tiny.pn.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pn.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : tiny.pn.BD(_, Unit, A)
  Unit{}

def tiny.pn.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : tiny.pn.BD(_, A, Unit)
  Unit{}

def tiny.pn.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      tiny.pn.absurdF({False{} == True{} : Bool}, h)

def tiny.pn.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      tiny.pn.absurdF({b == True{} : Bool}, h)

def tiny.pn.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pn.or_r(x: Bool, +a: Bool, h: {a == True{} : Bool}) -> {Bool.or(x, a) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      h

def pn.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      tiny.pn.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

# Numbers
# -------

def pn.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pn.eq_refl(p)

def pn.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      tiny.pn.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      tiny.pn.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pn.eq_true(p, q, h))

# Picks
# -----

def pn.PD(p: Tn.Pick, u: Type, n: Type) -> Type:
  match p:
    case Tn.Use{m}:
      u
    case Tn.Unavailable{}:
      n

def pn.un_use(-A: Type, -m: Nat, e: {Tn.Unavailable{} == Tn.Use{m} : Tn.Pick}) -> A:
  %e : pn.PD(_, A, Unit)
  Unit{}

def pn.use_m(p: Tn.Pick) -> Nat:
  match p:
    case Tn.Use{m}:
      m
    case Tn.Unavailable{}:
      0n

def pn.use_inj(-a: Nat, -b: Nat, e: {Tn.Use{a} == Tn.Use{b} : Tn.Pick}) -> {a == b : Nat}:
  Equal.cong(Tn.Pick, Nat, p => pn.use_m(p), Tn.Use{a}, Tn.Use{b}, e)

# a scan that uses m found it in the chain and available
def pn.go_in(chain: List<&2, Nat>, +up: List<&2, Nat>, +m: Nat, hit: Bool, eh: {Tn.up.at(chain, up) == hit : Bool}, used: {Tn.pick.go(chain, up, hit) == Tn.Use{m} : Tn.Pick}) -> {Bool.and(Tn.elem(chain, m), Tn.elem(up, m)) == True{} : Bool}:
  match chain:
    case Nil{}:
      pn.un_use({Bool.and(False{}, Tn.elem(up, m)) == True{} : Bool}, m, used)
    case +h <> +rest:
      match hit:
        case True{}:
          %pn.use_inj(h, m, used) : {Bool.and(Tn.elem(h <> rest, _), Tn.elem(up, _)) == True{} : Bool}
          %pn.eq_refl(h) : {Bool.and(Bool.or(_, Tn.elem(rest, h)), Tn.elem(up, h)) == True{} : Bool}
          eh
        case False{}:
          +ih = pn.go_in(rest, up, m, Tn.up.at(rest, up), {==}, used)
          +hr = tiny.pn.and_l(Tn.elem(rest, m), Tn.elem(up, m), ih)
          +hu = tiny.pn.and_r(Tn.elem(rest, m), Tn.elem(up, m), ih)
          tiny.pn.and_t(Bool.or(Nat.is_eq(h, m), Tn.elem(rest, m)), Tn.elem(up, m), pn.or_r(Nat.is_eq(h, m), Tn.elem(rest, m), hr), hu)

# a scan with no model of the chain available ends in Unavailable
def pn.go_un(chain: List<&2, Nat>, +up: List<&2, Nat>, hit: Bool, eh: {Tn.up.at(chain, up) == hit : Bool}, none: {Tn.none_up(chain, up) == True{} : Bool}) -> {Tn.pick.go(chain, up, hit) == Tn.Unavailable{} : Tn.Pick}:
  match chain:
    case Nil{}:
      {==}
    case +x <> +rest:
      match hit:
        case True{}:
          +nx = pn.not_t(Tn.elem(up, x), tiny.pn.and_l(Bool.not(Tn.elem(up, x)), Tn.none_up(rest, up), none))
          pn.absurd({Tn.Use{x} == Tn.Unavailable{} : Tn.Pick}, Equal.trans(Bool, True{}, Tn.elem(up, x), False{}, Equal.sym(Bool, Tn.elem(up, x), True{}, eh), nx))
        case False{}:
          pn.go_un(rest, up, Tn.up.at(rest, up), {==}, tiny.pn.and_r(Bool.not(Tn.elem(up, x)), Tn.none_up(rest, up), none))

# a scan past models that are not available reaches the next one
def pn.first(pre: List<&2, Nat>, +m: Nat, +post: List<&2, Nat>, +up: List<&2, Nat>, +before: {Tn.none_up(pre, up) == True{} : Bool}, here: {Tn.elem(up, m) == True{} : Bool}) -> {Tn.pick(List.append(&2, Nat, pre, m <> post), up) == Tn.Use{m} : Tn.Pick}:
  match pre:
    case Nil{}:
      %Equal.sym(Bool, Tn.elem(up, m), True{}, here) : {Tn.pick.go(m <> post, up, _) == Tn.Use{m} : Tn.Pick}
      {==}
    case +x <> +r:
      +nx = pn.not_t(Tn.elem(up, x), tiny.pn.and_l(Bool.not(Tn.elem(up, x)), Tn.none_up(r, up), before))
      %Equal.sym(Bool, Tn.elem(up, x), False{}, nx) : {Tn.pick.go(x <> List.append(&2, Nat, r, m <> post), up, _) == Tn.Use{m} : Tn.Pick}
      pn.first(r, m, post, up, tiny.pn.and_r(Bool.not(Tn.elem(up, x)), Tn.none_up(r, up), before), here)

# Workers
# -------

# a need leaves a worker with its own tag: a join keeps a worker of
# the same tag, a replace starts one with the need's tag
def pn.need_tag(b: Bool, +p: Nat, +tag: Nat, +o: Nat, +t: Nat, eb: {Nat.is_eq(t, tag) == b : Bool}) -> {Tn.W.tag(Tn.need.w(b, p, tag, Tn.Worker{o, t})) == Some{tag} : Maybe<&2, Nat>}:
  match b:
    case True{}:
      Equal.cong(Nat, Maybe<&2, Nat>, n => Some{n}, t, tag, pn.eq_true(t, tag, eb))
    case False{}:
      {==}

# the worker's tag after events is the last tag along them
def pn.cur(es: List<&2, Tn.Ev>, +w: Tn.W) -> {Tn.W.tag(Tn.run(es, w)) == Tn.last_tag(es, Tn.W.tag(w)) : Maybe<&2, Nat>}:
  match es:
    case Nil{}:
      {==}
    case +e <> +rest:
      match e:
        case Tn.Gone{}:
          match w:
            case Tn.NoWorker{}:
              pn.cur(rest, Tn.NoWorker{})
            case Tn.Worker{o, t}:
              pn.cur(rest, Tn.NoWorker{})
        case Tn.Need{+p, +tag}:
          match w:
            case Tn.NoWorker{}:
              pn.cur(rest, Tn.Worker{p, tag})
            case Tn.Worker{+o, +t}:
              +s = Tn.need.w(Nat.is_eq(t, tag), p, tag, Tn.Worker{o, t})
              %pn.need_tag(Nat.is_eq(t, tag), p, tag, o, t, {==}) : {Tn.W.tag(Tn.run(rest, s)) == Tn.last_tag(rest, _) : Maybe<&2, Nat>}
              pn.cur(rest, s)

# The laws
# --------

def pn.tiny_pick_in_chain(+chain: List<&2, Nat>, +up: List<&2, Nat>, +m: Nat, used: {Tn.pick(chain, up) == Tn.Use{m} : Tn.Pick}) -> {Bool.and(Tn.elem(chain, m), Tn.elem(up, m)) == True{} : Bool}:
  pn.go_in(chain, up, m, Tn.up.at(chain, up), {==}, used)

def pn.tiny_pick_first(+pre: List<&2, Nat>, +m: Nat, +post: List<&2, Nat>, +up: List<&2, Nat>, before: {Tn.none_up(pre, up) == True{} : Bool}, here: {Tn.elem(up, m) == True{} : Bool}) -> {Tn.pick(List.append(&2, Nat, pre, m <> post), up) == Tn.Use{m} : Tn.Pick}:
  pn.first(pre, m, post, up, before, here)

def pn.tiny_pick_unavailable(+chain: List<&2, Nat>, +up: List<&2, Nat>, none: {Tn.none_up(chain, up) == True{} : Bool}) -> {Tn.pick(chain, up) == Tn.Unavailable{} : Tn.Pick}:
  pn.go_un(chain, up, Tn.up.at(chain, up), {==}, none)

def pn.tiny_every_need_served(+es: List<&2, Tn.Ev>, +w: Tn.W) -> {List.length(&2, Tn.Got, Tn.gots(es, w)) == Tn.needs(es) : Nat}:
  match es:
    case Nil{}:
      {==}
    case +e <> +rest:
      match e:
        case Tn.Gone{}:
          match w:
            case Tn.NoWorker{}:
              pn.tiny_every_need_served(rest, Tn.NoWorker{})
            case Tn.Worker{o, t}:
              pn.tiny_every_need_served(rest, Tn.NoWorker{})
        case Tn.Need{+p, +tag}:
          match w:
            case Tn.NoWorker{}:
              Equal.cong(Nat, Nat, n => 1n+n, List.length(&2, Tn.Got, Tn.gots(rest, Tn.Worker{p, tag})), Tn.needs(rest), pn.tiny_every_need_served(rest, Tn.Worker{p, tag}))
            case Tn.Worker{+o, +t}:
              +s = Tn.need.w(Nat.is_eq(t, tag), p, tag, Tn.Worker{o, t})
              Equal.cong(Nat, Nat, n => 1n+n, List.length(&2, Tn.Got, Tn.gots(rest, s)), Tn.needs(rest), pn.tiny_every_need_served(rest, s))

def pn.tiny_worker_current(+es: List<&2, Tn.Ev>) -> {Tn.W.tag(Tn.run(es, Tn.NoWorker{})) == Tn.last_tag(es, None{}) : Maybe<&2, Nat>}:
  pn.cur(es, Tn.NoWorker{})

def pn.tiny_same_tag_joins(+o: Nat, +t: Nat, +p: Nat) -> {Tn.got(Tn.Worker{o, t}, Tn.Need{p, t}) == [Tn.Joined{}] : List<&2, Tn.Got>}:
  %pn.eq_refl(t) : {[Tn.need.g(_)] == [Tn.Joined{}] : List<&2, Tn.Got>}
  {==}

# ---- semver ----

# proof_semver: the R1 laws (LAWS.bend section release, release versions) of the
# model in bend/semver.bend.
#
# Numbers: incrementing the digits adds one to their value, so the digits
# Num.dec writes for n have the value n; Num.read takes them back, as they
# are the digits of their own value. Num.str writes digits that Sym.of
# reads back as those digits, so reading Ver.show(v) gives back the three
# fields of v. The order compares major, then minor, then patch: each
# level is reflexive, transitive, total and antisymmetric when the level
# below it is. The next release takes 1 + a patch at least as high as the
# patch of each tag of the series, under the same major and minor, so it
# is newer than each; a tag of another series never names it, and adds no
# patch to the highest one. A release passed its guard: it is newer than
# every version tag; with only tags of the series, the guard passes.
#
# A recursive proof takes the value it inspects as a parameter (Bend
# matches only parameters), with an equation that names it.

# Logic
# -----

def semver.ps.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def semver.ps.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : semver.ps.BD(_, Unit, A)
  Unit{}

def semver.ps.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : semver.ps.BD(_, A, Unit)
  Unit{}

def semver.ps.MD(m: Maybe<&2, Sv.Ver>, t: Type, f: Type) -> Type:
  match m:
    case None{}:
      t
    case Some{v}:
      f

# None is no Some
def semver.ps.none_some(-A: Type, -r: Sv.Ver, e: {None{} == Some{r} : Maybe<&2, Sv.Ver>}) -> A:
  %e : semver.ps.MD(_, Unit, A)
  Unit{}

def semver.ps.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      semver.ps.absurdF({False{} == True{} : Bool}, h)

def semver.ps.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      semver.ps.absurdF({b == True{} : Bool}, h)

def semver.ps.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      semver.ps.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def semver.ps.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      semver.ps.eq_refl(p)

def semver.ps.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      semver.ps.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      semver.ps.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, semver.ps.eq_true(p, q, h))

# Numbers
# -------

def ps.app_nil(ds: List<&2, Sv.Dig>) -> {ds == List.append(&2, Sv.Dig, ds, Nil{}) : List<&2, Sv.Dig>}:
  match ds:
    case Nil{}:
      {==}
    case +d <> +r:
      Equal.cong(List<&2, Sv.Dig>, List<&2, Sv.Dig>, xs => d <> xs, r, List.append(&2, Sv.Dig, r, Nil{}), ps.app_nil(r))

# incrementing the digits adds one to their value
def ps.val_inc(ds: List<&2, Sv.Dig>) -> {1n+Sv.Num.val(ds) == Sv.Num.val(Sv.Num.inc(ds)) : Nat}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Sv.D0{}:
          {==}
        case Sv.D1{}:
          {==}
        case Sv.D2{}:
          {==}
        case Sv.D3{}:
          {==}
        case Sv.D4{}:
          {==}
        case Sv.D5{}:
          {==}
        case Sv.D6{}:
          {==}
        case Sv.D7{}:
          {==}
        case Sv.D8{}:
          {==}
        case Sv.D9{}:
          %ps.val_inc(rest) : {1n+Nat.add(9n, Sv.Num.ten(Sv.Num.val(rest))) == Sv.Num.ten(_) : Nat}
          {==}

# the digits of n have the value n
def ps.val_dec(+n: Nat) -> {n == Sv.Num.val(Sv.Num.dec(n)) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %ps.val_inc(Sv.Num.dec(p)) : {1n+p == _ : Nat}
      %ps.val_dec(p) : {1n+p == 1n+_ : Nat}
      {==}

def ps.digs_refl(+ds: List<&2, Sv.Dig>) -> {True{} == Sv.Num.digs_eq(ds, ds) : Bool}:
  match ds:
    case Nil{}:
      {==}
    case d <> r:
      %semver.ps.eq_refl(Sv.Dig.val(d)) : {True{} == Bool.and(_, Sv.Num.digs_eq(r, r)) : Bool}
      ps.digs_refl(r)

# Num.read takes back the digits Num.dec writes
def ps.read_dec(+n: Nat) -> {Some{n} == Sv.Num.read(Sv.Num.dec(n)) : Maybe<&2, Nat>}:
  %ps.val_dec(n) : {Some{n} == Sv.Num.read.ok(_, Sv.Num.digs_eq(Sv.Num.dec(_), Sv.Num.dec(n))) : Maybe<&2, Nat>}
  %ps.digs_refl(Sv.Num.dec(n)) : {Some{n} == Sv.Num.read.ok(n, _) : Maybe<&2, Nat>}
  {==}

# Reading
# -------

def ps.sym_chr(d: Sv.Dig) -> {Sv.Sym.of(Sv.Dig.chr(d)) == Sv.Digit{d} : Sv.Sym}:
  match d:
    case Sv.D0{}:
      {==}
    case Sv.D1{}:
      {==}
    case Sv.D2{}:
      {==}
    case Sv.D3{}:
      {==}
    case Sv.D4{}:
      {==}
    case Sv.D5{}:
      {==}
    case Sv.D6{}:
      {==}
    case Sv.D7{}:
      {==}
    case Sv.D8{}:
      {==}
    case Sv.D9{}:
      {==}

# reading the digits Num.str writes before s adds them to the field
def ps.str_read(+ds: List<&2, Sv.Dig>, +s: String, +cur: List<&2, Sv.Dig>, +fs: List<&2, List<&2, Sv.Dig>>) -> {Sv.Ver.fields(Sv.Sym.list(s), List.append(&2, Sv.Dig, ds, cur), fs) == Sv.Ver.fields(Sv.Sym.list(Sv.Num.str(ds, s)), cur, fs) : Maybe<&2, List<&2, List<&2, Sv.Dig>>>}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      %ps.sym_chr(d) : {Sv.Ver.fields(_ <> Sv.Sym.list(s), List.append(&2, Sv.Dig, rest, cur), fs) == Sv.Ver.fields(Sv.Sym.list(Sv.Num.str(rest, SCon{Sv.Dig.chr(d), s})), cur, fs) : Maybe<&2, List<&2, List<&2, Sv.Dig>>>}
      ps.str_read(rest, SCon{Sv.Dig.chr(d), s}, cur, fs)

# parse(show(v)) is v
def ps.roundtrip(v: Sv.Ver) -> {Sv.Ver.parse(Sv.Ver.show(v)) == Some{v} : Maybe<&2, Sv.Ver>}:
  match v:
    case Sv.Ver{+a, +b, +c}:
      %ps.str_read(Sv.Num.dec(a), SCon{'.', Sv.Num.str(Sv.Num.dec(b), SCon{'.', Sv.Num.str(Sv.Num.dec(c), SNil{})})}, Nil{}, Nil{}) : {Sv.Ver.of_fields(_) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.str_read(Sv.Num.dec(b), SCon{'.', Sv.Num.str(Sv.Num.dec(c), SNil{})}, Nil{}, [List.append(&2, Sv.Dig, Sv.Num.dec(a), Nil{})]) : {Sv.Ver.of_fields(_) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.str_read(Sv.Num.dec(c), SNil{}, Nil{}, [List.append(&2, Sv.Dig, Sv.Num.dec(b), Nil{}), List.append(&2, Sv.Dig, Sv.Num.dec(a), Nil{})]) : {Sv.Ver.of_fields(_) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.app_nil(Sv.Num.dec(a)) : {Sv.Ver.of3(Sv.Num.read(_), Sv.Num.read(List.append(&2, Sv.Dig, Sv.Num.dec(b), Nil{})), Sv.Num.read(List.append(&2, Sv.Dig, Sv.Num.dec(c), Nil{}))) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.app_nil(Sv.Num.dec(b)) : {Sv.Ver.of3(Sv.Num.read(Sv.Num.dec(a)), Sv.Num.read(_), Sv.Num.read(List.append(&2, Sv.Dig, Sv.Num.dec(c), Nil{}))) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.app_nil(Sv.Num.dec(c)) : {Sv.Ver.of3(Sv.Num.read(Sv.Num.dec(a)), Sv.Num.read(Sv.Num.dec(b)), Sv.Num.read(_)) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.read_dec(a) : {Sv.Ver.of3(_, Sv.Num.read(Sv.Num.dec(b)), Sv.Num.read(Sv.Num.dec(c))) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.read_dec(b) : {Sv.Ver.of3(Some{a}, _, Sv.Num.read(Sv.Num.dec(c))) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      %ps.read_dec(c) : {Sv.Ver.of3(Some{a}, Some{b}, _) == Some{Sv.Ver{a, b, c}} : Maybe<&2, Sv.Ver>}
      {==}

# The order
# ---------

def ps.num_refl(a: Nat) -> {Sv.Num.le(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      ps.num_refl(p)

def ps.num_trans(a: Nat, b: Nat, c: Nat, h1: {Sv.Num.le(a, b) == True{} : Bool}, h2: {Sv.Num.le(b, c) == True{} : Bool}) -> {Sv.Num.le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      {==}
    case 1n+p 0n _:
      semver.ps.absurdF({Sv.Num.le(1n+p, c) == True{} : Bool}, h1)
    case 1n+p 1n+q 0n:
      semver.ps.absurdF({False{} == True{} : Bool}, h2)
    case 1n+p 1n+q 1n+r:
      ps.num_trans(p, q, r, h1, h2)

def ps.num_total(a: Nat, b: Nat) -> {Bool.or(Sv.Num.le(a, b), Sv.Num.le(b, a)) == True{} : Bool}:
  match a b:
    case 0n _:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      ps.num_total(p, q)

def ps.num_anti(a: Nat, b: Nat, h1: {Sv.Num.le(a, b) == True{} : Bool}, h2: {Sv.Num.le(b, a) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      semver.ps.absurdF({0n == 1n+q : Nat}, h2)
    case 1n+p 0n:
      semver.ps.absurdF({1n+p == 0n : Nat}, h1)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, ps.num_anti(p, q, h1, h2))

def ps.bminor(v: Sv.Ver) -> Sv.Ver:
  match v:
    case Sv.Ver{a, b, c}:
      Sv.Ver{a, 1n+b, c}

def ps.bmajor(v: Sv.Ver) -> Sv.Ver:
  match v:
    case Sv.Ver{a, b, c}:
      Sv.Ver{1n+a, b, c}

def ps.le2_refl(b: Nat, +c: Nat) -> {Sv.Ver.le2(b, b, c, c) == True{} : Bool}:
  match b:
    case 0n:
      ps.num_refl(c)
    case 1n+p:
      ps.le2_refl(p, c)

def ps.le2_trans(b1: Nat, b2: Nat, b3: Nat, +c1: Nat, +c2: Nat, +c3: Nat, h1: {Sv.Ver.le2(b1, b2, c1, c2) == True{} : Bool}, h2: {Sv.Ver.le2(b2, b3, c2, c3) == True{} : Bool}) -> {Sv.Ver.le2(b1, b3, c1, c3) == True{} : Bool}:
  match b1 b2 b3:
    case 0n 0n 0n:
      ps.num_trans(c1, c2, c3, h1, h2)
    case 0n 0n 1n+r:
      {==}
    case 0n 1n+q 0n:
      semver.ps.absurdF({Sv.Num.le(c1, c3) == True{} : Bool}, h2)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 0n _:
      semver.ps.absurdF({Sv.Ver.le2(1n+p, b3, c1, c3) == True{} : Bool}, h1)
    case 1n+p 1n+q 0n:
      semver.ps.absurdF({False{} == True{} : Bool}, h2)
    case 1n+p 1n+q 1n+r:
      ps.le2_trans(p, q, r, c1, c2, c3, h1, h2)

def ps.le2_total(b1: Nat, b2: Nat, +c1: Nat, +c2: Nat) -> {Bool.or(Sv.Ver.le2(b1, b2, c1, c2), Sv.Ver.le2(b2, b1, c2, c1)) == True{} : Bool}:
  match b1 b2:
    case 0n 0n:
      ps.num_total(c1, c2)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      ps.le2_total(p, q, c1, c2)

def ps.le2_anti(-a: Nat, b1: Nat, b2: Nat, +c1: Nat, +c2: Nat, h1: {Sv.Ver.le2(b1, b2, c1, c2) == True{} : Bool}, h2: {Sv.Ver.le2(b2, b1, c2, c1) == True{} : Bool}) -> {Sv.Ver{a, b1, c1} == Sv.Ver{a, b2, c2} : Sv.Ver}:
  match b1 b2:
    case 0n 0n:
      Equal.cong(Nat, Sv.Ver, x => Sv.Ver{a, 0n, x}, c1, c2, ps.num_anti(c1, c2, h1, h2))
    case 0n 1n+q:
      semver.ps.absurdF({Sv.Ver{a, 0n, c1} == Sv.Ver{a, 1n+q, c2} : Sv.Ver}, h2)
    case 1n+p 0n:
      semver.ps.absurdF({Sv.Ver{a, 1n+p, c1} == Sv.Ver{a, 0n, c2} : Sv.Ver}, h1)
    case 1n+p 1n+q:
      Equal.cong(Sv.Ver, Sv.Ver, ps.bminor, Sv.Ver{a, p, c1}, Sv.Ver{a, q, c2}, ps.le2_anti(a, p, q, c1, c2, h1, h2))

def ps.le3_refl(a: Nat, +b: Nat, +c: Nat) -> {Sv.Ver.le3(a, a, b, b, c, c) == True{} : Bool}:
  match a:
    case 0n:
      ps.le2_refl(b, c)
    case 1n+p:
      ps.le3_refl(p, b, c)

def ps.le3_trans(a1: Nat, a2: Nat, a3: Nat, +b1: Nat, +b2: Nat, +b3: Nat, +c1: Nat, +c2: Nat, +c3: Nat, h1: {Sv.Ver.le3(a1, a2, b1, b2, c1, c2) == True{} : Bool}, h2: {Sv.Ver.le3(a2, a3, b2, b3, c2, c3) == True{} : Bool}) -> {Sv.Ver.le3(a1, a3, b1, b3, c1, c3) == True{} : Bool}:
  match a1 a2 a3:
    case 0n 0n 0n:
      ps.le2_trans(b1, b2, b3, c1, c2, c3, h1, h2)
    case 0n 0n 1n+r:
      {==}
    case 0n 1n+q 0n:
      semver.ps.absurdF({Sv.Ver.le2(b1, b3, c1, c3) == True{} : Bool}, h2)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 0n _:
      semver.ps.absurdF({Sv.Ver.le3(1n+p, a3, b1, b3, c1, c3) == True{} : Bool}, h1)
    case 1n+p 1n+q 0n:
      semver.ps.absurdF({False{} == True{} : Bool}, h2)
    case 1n+p 1n+q 1n+r:
      ps.le3_trans(p, q, r, b1, b2, b3, c1, c2, c3, h1, h2)

def ps.le3_total(a1: Nat, a2: Nat, +b1: Nat, +b2: Nat, +c1: Nat, +c2: Nat) -> {Bool.or(Sv.Ver.le3(a1, a2, b1, b2, c1, c2), Sv.Ver.le3(a2, a1, b2, b1, c2, c1)) == True{} : Bool}:
  match a1 a2:
    case 0n 0n:
      ps.le2_total(b1, b2, c1, c2)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      ps.le3_total(p, q, b1, b2, c1, c2)

def ps.le3_anti(a1: Nat, a2: Nat, +b1: Nat, +b2: Nat, +c1: Nat, +c2: Nat, h1: {Sv.Ver.le3(a1, a2, b1, b2, c1, c2) == True{} : Bool}, h2: {Sv.Ver.le3(a2, a1, b2, b1, c2, c1) == True{} : Bool}) -> {Sv.Ver{a1, b1, c1} == Sv.Ver{a2, b2, c2} : Sv.Ver}:
  match a1 a2:
    case 0n 0n:
      ps.le2_anti(0n, b1, b2, c1, c2, h1, h2)
    case 0n 1n+q:
      semver.ps.absurdF({Sv.Ver{0n, b1, c1} == Sv.Ver{1n+q, b2, c2} : Sv.Ver}, h2)
    case 1n+p 0n:
      semver.ps.absurdF({Sv.Ver{1n+p, b1, c1} == Sv.Ver{0n, b2, c2} : Sv.Ver}, h1)
    case 1n+p 1n+q:
      Equal.cong(Sv.Ver, Sv.Ver, ps.bmajor, Sv.Ver{p, b1, c1}, Sv.Ver{q, b2, c2}, ps.le3_anti(p, q, b1, b2, c1, c2, h1, h2))

def semver.ps.le_refl(v: Sv.Ver) -> {Sv.Ver.le(v, v) == True{} : Bool}:
  match v:
    case Sv.Ver{+a, +b, +c}:
      ps.le3_refl(a, b, c)

def semver.ps.le_trans(u: Sv.Ver, v: Sv.Ver, w: Sv.Ver, h1: {Sv.Ver.le(u, v) == True{} : Bool}, h2: {Sv.Ver.le(v, w) == True{} : Bool}) -> {Sv.Ver.le(u, w) == True{} : Bool}:
  match u v w:
    case Sv.Ver{a1, b1, c1} Sv.Ver{a2, b2, c2} Sv.Ver{a3, b3, c3}:
      ps.le3_trans(a1, a2, a3, b1, b2, b3, c1, c2, c3, h1, h2)

def ps.le_total(u: Sv.Ver, v: Sv.Ver) -> {Bool.or(Sv.Ver.le(u, v), Sv.Ver.le(v, u)) == True{} : Bool}:
  match u v:
    case Sv.Ver{a1, b1, c1} Sv.Ver{a2, b2, c2}:
      ps.le3_total(a1, a2, b1, b2, c1, c2)

def ps.le_anti(u: Sv.Ver, v: Sv.Ver, h1: {Sv.Ver.le(u, v) == True{} : Bool}, h2: {Sv.Ver.le(v, u) == True{} : Bool}) -> {u == v : Sv.Ver}:
  match u v:
    case Sv.Ver{a1, b1, c1} Sv.Ver{a2, b2, c2}:
      ps.le3_anti(a1, a2, b1, b2, c1, c2, h1, h2)

# no version is newer than itself
def ps.lt_irrefl(+v: Sv.Ver) -> {False{} == Sv.Ver.lt(v, v) : Bool}:
  %Equal.sym(Bool, Sv.Ver.le(v, v), True{}, semver.ps.le_refl(v)) : {False{} == Bool.not(_) : Bool}
  {==}

# a version newer than u is not u
def ps.lt_ne(+u: Sv.Ver, -w: Sv.Ver, h: {Sv.Ver.lt(u, w) == True{} : Bool}, e: {u == w : Sv.Ver}) -> Empty:
  +self = Equal.cong(Sv.Ver, Bool, x => Sv.Ver.lt(u, x), u, w, e)
  semver.ps.absurdF(Empty, Equal.trans(Bool, False{}, Sv.Ver.lt(u, w), True{}, Equal.trans(Bool, False{}, Sv.Ver.lt(u, u), Sv.Ver.lt(u, w), ps.lt_irrefl(u), self), h))

# The next release
# ----------------

def ps.app_snoc(xs: List<&2, String>, +a: String, +ys: List<&2, String>) -> {List.append(&2, String, List.append(&2, String, xs, [a]), ys) == List.append(&2, String, xs, a <> ys) : List<&2, String>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +r:
      Equal.cong(List<&2, String>, List<&2, String>, zs => x <> zs, List.append(&2, String, List.append(&2, String, r, [a]), ys), List.append(&2, String, r, a <> ys), ps.app_snoc(r, a, ys))

# m names a number of at least p
def ps.atl(p: Nat, m: Maybe<&2, Nat>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{q}:
      Sv.Num.le(p, q)

def ps.le_max_l(a: Nat, b: Nat) -> {Sv.Num.le(a, Sv.Num.max(a, b)) == True{} : Bool}:
  match a b:
    case 0n _:
      {==}
    case 1n+p 0n:
      ps.num_refl(p)
    case 1n+p 1n+q:
      ps.le_max_l(p, q)

def ps.le_max_r(a: Nat, b: Nat) -> {Sv.Num.le(b, Sv.Num.max(a, b)) == True{} : Bool}:
  match a b:
    case 0n _:
      ps.num_refl(b)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      ps.le_max_r(p, q)

def ps.atl_max(+p: Nat, acc: Maybe<&2, Nat>) -> {ps.atl(p, Sv.Rel.max(p, acc)) == True{} : Bool}:
  match acc:
    case None{}:
      ps.num_refl(p)
    case Some{q}:
      ps.le_max_l(p, q)

def ps.atl_keep(+p: Nat, b: Bool, +q: Nat, acc: Maybe<&2, Nat>, h: {ps.atl(p, acc) == True{} : Bool}) -> {ps.atl(p, Sv.Rel.keep(b, q, acc)) == True{} : Bool}:
  match b:
    case True{}:
      match acc:
        case None{}:
          semver.ps.absurdF({ps.atl(p, Sv.Rel.max(q, None{})) == True{} : Bool}, h)
        case Some{+r}:
          ps.num_trans(p, r, Sv.Num.max(q, r), h, ps.le_max_r(q, r))
    case False{}:
      h

def ps.atl_add(+p: Nat, +s: Sv.Ver, m: Maybe<&2, Sv.Ver>, acc: Maybe<&2, Nat>, h: {ps.atl(p, acc) == True{} : Bool}) -> {ps.atl(p, Sv.Rel.add(s, m, acc)) == True{} : Bool}:
  match m:
    case None{}:
      h
    case Some{+v}:
      ps.atl_keep(p, Sv.Ver.in_series(s, v), Sv.Ver.patch(v), acc, h)

# with tag t of the series among the tags, the highest patch is at least
# the patch of t
def ps.top_mid(+s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, +v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}, ins: {Sv.Ver.in_series(s, v) == True{} : Bool}) -> {ps.atl(Sv.Ver.patch(v), Sv.Rel.top(s, List.append(&2, String, xs, t <> ys))) == True{} : Bool}:
  match xs:
    case Nil{}:
      %Equal.sym(Maybe<&2, Sv.Ver>, Sv.Tag.ver(t), Some{v}, parsed) : {ps.atl(Sv.Ver.patch(v), Sv.Rel.add(s, _, Sv.Rel.top(s, ys))) == True{} : Bool}
      %Equal.sym(Bool, Sv.Ver.in_series(s, v), True{}, ins) : {ps.atl(Sv.Ver.patch(v), Sv.Rel.keep(_, Sv.Ver.patch(v), Sv.Rel.top(s, ys))) == True{} : Bool}
      ps.atl_max(Sv.Ver.patch(v), Sv.Rel.top(s, ys))
    case +x <> +r:
      ps.atl_add(Sv.Ver.patch(v), s, Sv.Tag.ver(x), Sv.Rel.top(s, List.append(&2, String, r, t <> ys)), ps.top_mid(s, r, t, ys, v, parsed, ins))

def semver.ps.le_succ(p: Nat, q: Nat, h: {Sv.Num.le(p, q) == True{} : Bool}) -> {Sv.Num.le(1n+q, p) == False{} : Bool}:
  match p q:
    case 0n _:
      {==}
    case 1n+a 0n:
      semver.ps.absurdF({Sv.Num.le(1n+0n, 1n+a) == False{} : Bool}, h)
    case 1n+a 1n+b:
      semver.ps.le_succ(a, b, h)

def ps.after_gt(+p: Nat, m: Maybe<&2, Nat>, h: {ps.atl(p, m) == True{} : Bool}) -> {Sv.Num.le(Sv.Rel.after(m), p) == False{} : Bool}:
  match m:
    case None{}:
      semver.ps.absurdF({Sv.Num.le(0n, p) == False{} : Bool}, h)
    case Some{q}:
      semver.ps.le_succ(p, q, h)

def ps.le2_same(b: Nat, +x: Nat, +y: Nat) -> {Sv.Num.le(x, y) == Sv.Ver.le2(b, b, x, y) : Bool}:
  match b:
    case 0n:
      {==}
    case 1n+p:
      ps.le2_same(p, x, y)

def ps.le3_same(a: Nat, +b: Nat, +x: Nat, +y: Nat) -> {Sv.Num.le(x, y) == Sv.Ver.le3(a, a, b, b, x, y) : Bool}:
  match a:
    case 0n:
      ps.le2_same(b, x, y)
    case 1n+p:
      ps.le3_same(p, b, x, y)

# the next release is newer than each tag of the series
def ps.next_newer(s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}, +ins: {Sv.Ver.in_series(s, v) == True{} : Bool}) -> {Sv.Ver.lt(v, Sv.Rel.next(s, List.append(&2, String, xs, t <> ys))) == True{} : Bool}:
  match s v:
    case Sv.Ver{+a, +b, +c} Sv.Ver{+va, +vb, +vc}:
      %semver.ps.eq_true(a, va, semver.ps.and_l(Nat.is_eq(a, va), Nat.is_eq(b, vb), ins)) : {Bool.not(Sv.Ver.le3(a, _, b, vb, Sv.Rel.after(Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, t <> ys))), vc)) == True{} : Bool}
      %semver.ps.eq_true(b, vb, semver.ps.and_r(Nat.is_eq(a, va), Nat.is_eq(b, vb), ins)) : {Bool.not(Sv.Ver.le3(a, a, b, _, Sv.Rel.after(Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, t <> ys))), vc)) == True{} : Bool}
      %ps.le3_same(a, b, Sv.Rel.after(Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, t <> ys))), vc) : {Bool.not(_) == True{} : Bool}
      %Equal.sym(Bool, Sv.Num.le(Sv.Rel.after(Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, t <> ys))), vc), False{}, ps.after_gt(vc, Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, t <> ys)), ps.top_mid(Sv.Ver{a, b, c}, xs, t, ys, Sv.Ver{va, vb, vc}, parsed, ins))) : {Bool.not(_) == True{} : Bool}
      {==}

# the next release is of the series
def ps.series_next(s: Sv.Ver, tags: List<&2, String>) -> {Sv.Ver.in_series(s, Sv.Rel.next(s, tags)) == True{} : Bool}:
  match s:
    case Sv.Ver{+a, +b, c}:
      %semver.ps.eq_refl(a) : {Bool.and(_, Nat.is_eq(b, b)) == True{} : Bool}
      Equal.sym(Bool, True{}, Nat.is_eq(b, b), semver.ps.eq_refl(b))

def ps.next_ne.go(+s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, +v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}, b: Bool, eb: {Sv.Ver.in_series(s, v) == b : Bool}, e: {v == Sv.Rel.next(s, List.append(&2, String, xs, t <> ys)) : Sv.Ver}) -> Empty:
  match b:
    case True{}:
      ps.lt_ne(v, Sv.Rel.next(s, List.append(&2, String, xs, t <> ys)), ps.next_newer(s, xs, t, ys, v, parsed, eb), e)
    case False{}:
      +same = Equal.cong(Sv.Ver, Bool, x => Sv.Ver.in_series(s, x), v, Sv.Rel.next(s, List.append(&2, String, xs, t <> ys)), e)
      +into = Equal.trans(Bool, Sv.Ver.in_series(s, v), Sv.Ver.in_series(s, Sv.Rel.next(s, List.append(&2, String, xs, t <> ys))), True{}, same, ps.series_next(s, List.append(&2, String, xs, t <> ys)))
      semver.ps.absurdF(Empty, Equal.trans(Bool, False{}, Sv.Ver.in_series(s, v), True{}, Equal.sym(Bool, Sv.Ver.in_series(s, v), False{}, eb), into))

# no version tag names the next release
def ps.next_ne(+s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, +v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}) -> {v != Sv.Rel.next(s, List.append(&2, String, xs, t <> ys)) : Sv.Ver}:
  e => ps.next_ne.go(s, xs, t, ys, v, parsed, Sv.Ver.in_series(s, v), {==}, e)

def ps.tag_new.go(+s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, e: {Sv.Tag.of(Sv.Rel.next(s, List.append(&2, String, xs, t <> ys))) == t : String}) -> Empty:
  +n = Sv.Rel.next(s, List.append(&2, String, xs, t <> ys))
  +back = Equal.cong(String, Maybe<&2, Sv.Ver>, Sv.Tag.ver, Sv.Tag.of(n), t, e)
  +parsed = Equal.trans(Maybe<&2, Sv.Ver>, Sv.Tag.ver(t), Sv.Tag.ver(Sv.Tag.of(n)), Some{n}, Equal.sym(Maybe<&2, Sv.Ver>, Sv.Tag.ver(Sv.Tag.of(n)), Sv.Tag.ver(t), back), ps.roundtrip(n))
  ps.next_ne(s, xs, t, ys, n, parsed)({==})

# no tag is the tag of the next release
def ps.tag_new(+s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>) -> {Sv.Tag.of(Sv.Rel.next(s, List.append(&2, String, xs, t <> ys))) != t : String}:
  e => ps.tag_new.go(s, xs, t, ys, e)

# a fresh series starts at patch 0
def ps.add_skip(+s: Sv.Ver, m: Maybe<&2, Sv.Ver>, +acc: Maybe<&2, Nat>, h: {Sv.Rel.ofs.of(s, m) == False{} : Bool}) -> {acc == Sv.Rel.add(s, m, acc) : Maybe<&2, Nat>}:
  match m:
    case None{}:
      {==}
    case Some{+w}:
      %Equal.sym(Bool, Sv.Ver.in_series(s, w), False{}, h) : {acc == Sv.Rel.keep(_, Sv.Ver.patch(w), acc) : Maybe<&2, Nat>}
      {==}

def ps.top_none(+s: Sv.Ver, tags: List<&2, String>, +h: {Sv.Rel.none(s, tags) == True{} : Bool}) -> {None{} == Sv.Rel.top(s, tags) : Maybe<&2, Nat>}:
  match tags:
    case Nil{}:
      {==}
    case +t <> +r:
      %ps.top_none(s, r, semver.ps.and_r(Bool.not(Sv.Rel.ofs(s, t)), Sv.Rel.none(s, r), h)) : {None{} == Sv.Rel.add(s, Sv.Tag.ver(t), _) : Maybe<&2, Nat>}
      ps.add_skip(s, Sv.Tag.ver(t), None{}, semver.ps.not_t(Sv.Rel.ofs(s, t), semver.ps.and_l(Bool.not(Sv.Rel.ofs(s, t)), Sv.Rel.none(s, r), h)))

def ps.fresh(+a: Nat, +b: Nat, +c: Nat, +tags: List<&2, String>, none: {Sv.Rel.none(Sv.Ver{a, b, c}, tags) == True{} : Bool}) -> {Sv.Rel.next(Sv.Ver{a, b, c}, tags) == Sv.Ver{a, b, 0n} : Sv.Ver}:
  %ps.top_none(Sv.Ver{a, b, c}, tags, none) : {Sv.Ver{a, b, Sv.Rel.after(_)} == Sv.Ver{a, b, 0n} : Sv.Ver}
  {==}

# a tag of another series changes nothing
def ps.top_skip(+s: Sv.Ver, xs: List<&2, String>, +t: String, +ys: List<&2, String>, h: {Sv.Rel.ofs(s, t) == False{} : Bool}) -> {Sv.Rel.top(s, List.append(&2, String, xs, ys)) == Sv.Rel.top(s, List.append(&2, String, xs, t <> ys)) : Maybe<&2, Nat>}:
  match xs:
    case Nil{}:
      ps.add_skip(s, Sv.Tag.ver(t), Sv.Rel.top(s, ys), h)
    case x <> r:
      %ps.top_skip(s, r, t, ys, h) : {Sv.Rel.add(s, Sv.Tag.ver(x), Sv.Rel.top(s, List.append(&2, String, r, ys))) == Sv.Rel.add(s, Sv.Tag.ver(x), _) : Maybe<&2, Nat>}
      {==}

def ps.other(s: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, h: {Sv.Rel.ofs(s, t) == False{} : Bool}) -> {Sv.Rel.next(s, List.append(&2, String, xs, t <> ys)) == Sv.Rel.next(s, List.append(&2, String, xs, ys)) : Sv.Ver}:
  match s:
    case Sv.Ver{+a, +b, +c}:
      %ps.top_skip(Sv.Ver{a, b, c}, xs, t, ys, h) : {Sv.Ver{a, b, Sv.Rel.after(_)} == Sv.Ver{a, b, Sv.Rel.after(Sv.Rel.top(Sv.Ver{a, b, c}, List.append(&2, String, xs, ys)))} : Sv.Ver}
      {==}

# A release
# ---------

def ps.guard_ok(ok: Bool, -n: Sv.Ver, -r: Sv.Ver, h: {Sv.Rel.guard(ok, n) == Some{r} : Maybe<&2, Sv.Ver>}) -> {ok == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      semver.ps.none_some({False{} == True{} : Bool}, r, h)

def ps.guard_val(ok: Bool, +n: Sv.Ver, -r: Sv.Ver, h: {Sv.Rel.guard(ok, n) == Some{r} : Maybe<&2, Sv.Ver>}) -> {n == r : Sv.Ver}:
  match ok:
    case True{}:
      Equal.cong(Maybe<&2, Sv.Ver>, Sv.Ver, m => Maybe.default(&2, Sv.Ver, m, n), Some{n}, Some{r}, h)
    case False{}:
      semver.ps.none_some({n == r : Sv.Ver}, r, h)

def ps.newest_mid(+n: Sv.Ver, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, h: {Sv.Rel.newest(n, List.append(&2, String, xs, t <> ys)) == True{} : Bool}) -> {Sv.Rel.older(n, Sv.Tag.ver(t)) == True{} : Bool}:
  match xs:
    case Nil{}:
      semver.ps.and_l(Sv.Rel.older(n, Sv.Tag.ver(t)), Sv.Rel.newest(n, ys), h)
    case +x <> +r:
      ps.newest_mid(n, r, t, ys, semver.ps.and_r(Sv.Rel.older(n, Sv.Tag.ver(x)), Sv.Rel.newest(n, List.append(&2, String, r, t <> ys)), h))

# a release is newer than every version tag
def ps.release_newest(m: Maybe<&2, Sv.Ver>, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, -r: Sv.Ver, +rel: {Sv.Rel.release.of(m, List.append(&2, String, xs, t <> ys)) == Some{r} : Maybe<&2, Sv.Ver>}, +v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}) -> {Sv.Ver.lt(v, r) == True{} : Bool}:
  match m:
    case None{}:
      semver.ps.none_some({Sv.Ver.lt(v, r) == True{} : Bool}, r, rel)
    case Some{w}:
      match w:
        case Sv.Ver{+a, +b, c}:
          match c:
            case 0n:
              +n = Sv.Rel.next(Sv.Ver{a, b, 0n}, List.append(&2, String, xs, t <> ys))
              +ok = ps.guard_ok(Sv.Rel.newest(n, List.append(&2, String, xs, t <> ys)), n, r, rel)
              %ps.guard_val(Sv.Rel.newest(n, List.append(&2, String, xs, t <> ys)), n, r, rel) : {Sv.Ver.lt(v, _) == True{} : Bool}
              %parsed : {Sv.Rel.older(n, _) == True{} : Bool}
              ps.newest_mid(n, xs, t, ys, ok)
            case 1n+p:
              semver.ps.none_some({Sv.Ver.lt(v, r) == True{} : Bool}, r, rel)

def ps.release_newest_of(c: String, +xs: List<&2, String>, +t: String, +ys: List<&2, String>, -r: Sv.Ver, rel: {Sv.Rel.release(c, List.append(&2, String, xs, t <> ys)) == Some{r} : Maybe<&2, Sv.Ver>}, +v: Sv.Ver, parsed: {Sv.Tag.ver(t) == Some{v} : Maybe<&2, Sv.Ver>}) -> {Sv.Ver.lt(v, r) == True{} : Bool}:
  ps.release_newest(Sv.Ver.parse(c), xs, t, ys, r, rel, v, parsed)

def ps.older_of(+s: Sv.Ver, +pre: List<&2, String>, +t: String, +r: List<&2, String>, m: Maybe<&2, Sv.Ver>, em: {Sv.Tag.ver(t) == m : Maybe<&2, Sv.Ver>}, h: {Sv.Rel.only.of(s, m) == True{} : Bool}) -> {True{} == Sv.Rel.older(Sv.Rel.next(s, List.append(&2, String, pre, t <> r)), m) : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+v}:
      Equal.sym(Bool, Sv.Ver.lt(v, Sv.Rel.next(s, List.append(&2, String, pre, t <> r))), True{}, ps.next_newer(s, pre, t, r, v, em, h))

def ps.newest_only(rest: List<&2, String>, +s: Sv.Ver, +pre: List<&2, String>, +h: {Sv.Rel.only(s, rest) == True{} : Bool}) -> {True{} == Sv.Rel.newest(Sv.Rel.next(s, List.append(&2, String, pre, rest)), rest) : Bool}:
  match rest:
    case Nil{}:
      {==}
    case +t <> +r:
      %ps.older_of(s, pre, t, r, Sv.Tag.ver(t), {==}, semver.ps.and_l(Sv.Rel.only.of(s, Sv.Tag.ver(t)), Sv.Rel.only(s, r), h)) : {True{} == Bool.and(_, Sv.Rel.newest(Sv.Rel.next(s, List.append(&2, String, pre, t <> r)), r)) : Bool}
      %ps.app_snoc(pre, t, r) : {True{} == Sv.Rel.newest(Sv.Rel.next(s, _), r) : Bool}
      ps.newest_only(r, s, List.append(&2, String, pre, [t]), semver.ps.and_r(Sv.Rel.only.of(s, Sv.Tag.ver(t)), Sv.Rel.only(s, r), h))

# with only tags of the series, the workspace version X.Y.0 releases the
# next release
def ps.progress(c: String, +a: Nat, +b: Nat, +tags: List<&2, String>, parsed: {Sv.Ver.parse(c) == Some{Sv.Ver{a, b, 0n}} : Maybe<&2, Sv.Ver>}, only: {Sv.Rel.only(Sv.Ver{a, b, 0n}, tags) == True{} : Bool}) -> {Sv.Rel.release(c, tags) == Some{Sv.Rel.next(Sv.Ver{a, b, 0n}, tags)} : Maybe<&2, Sv.Ver>}:
  %Equal.sym(Maybe<&2, Sv.Ver>, Sv.Ver.parse(c), Some{Sv.Ver{a, b, 0n}}, parsed) : {Sv.Rel.release.of(_, tags) == Some{Sv.Rel.next(Sv.Ver{a, b, 0n}, tags)} : Maybe<&2, Sv.Ver>}
  %ps.newest_only(tags, Sv.Ver{a, b, 0n}, Nil{}, only) : {Sv.Rel.guard(_, Sv.Rel.next(Sv.Ver{a, b, 0n}, tags)) == Some{Sv.Rel.next(Sv.Ver{a, b, 0n}, tags)} : Maybe<&2, Sv.Ver>}
  {==}

# a workspace version X.Y.(1+z) releases nothing
def ps.refuse_patch(c: String, +a: Nat, +b: Nat, +z: Nat, +tags: List<&2, String>, parsed: {Sv.Ver.parse(c) == Some{Sv.Ver{a, b, 1n+z}} : Maybe<&2, Sv.Ver>}) -> {Sv.Rel.release(c, tags) == None{} : Maybe<&2, Sv.Ver>}:
  %Equal.sym(Maybe<&2, Sv.Ver>, Sv.Ver.parse(c), Some{Sv.Ver{a, b, 1n+z}}, parsed) : {Sv.Rel.release.of(_, tags) == None{} : Maybe<&2, Sv.Ver>}
  {==}

# a workspace version that is no version releases nothing
def ps.refuse_unparsed(c: String, +tags: List<&2, String>, unparsed: {Sv.Ver.parse(c) == None{} : Maybe<&2, Sv.Ver>}) -> {Sv.Rel.release(c, tags) == None{} : Maybe<&2, Sv.Ver>}:
  %Equal.sym(Maybe<&2, Sv.Ver>, Sv.Ver.parse(c), None{}, unparsed) : {Sv.Rel.release.of(_, tags) == None{} : Maybe<&2, Sv.Ver>}
  {==}

# Decimal writing (semver_show_decimal): the spec's writer of the law file
# and the model's Num.str agree.

# digits written before x ++ acc: the digits before x, then acc
def ps.str_app(ds: List<&2, Sv.Dig>, x: String, acc: String) -> {Sv.Num.str(ds, String.append(x, acc)) == String.append(Sv.Num.str(ds, x), acc) : String}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      ps.str_app(rest, SCon{Sv.Dig.chr(d), x}, acc)

# reversing onto acc, then reversing that, gives acc reversed onto s
def ps.rev_rev(s: String, acc: String) -> {String.reverse.go(String.reverse.go(s, acc), SNil{}) == String.reverse.go(acc, s) : String}:
  match s:
    case SNil{}:
      {==}
    case SCon{h, t}:
      ps.rev_rev(t, SCon{h, acc})

# the digits as text, last digit first
def ps.lsf(ds: List<&2, Sv.Dig>) -> String:
  match ds:
    case Nil{}:
      SNil{}
    case d <> rest:
      SCon{Sv.Dig.chr(d), ps.lsf(rest)}

# writing digits before acc is reversing their text onto acc
def ps.str_rev(ds: List<&2, Sv.Dig>, acc: String) -> {Sv.Num.str(ds, acc) == String.reverse.go(ps.lsf(ds), acc) : String}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      ps.str_rev(rest, SCon{Sv.Dig.chr(d), acc})

# raising the text of digits is the text of the next number's digits
def ps.raise_inc(ds: List<&2, Sv.Dig>) -> {Laws.dec_raise(ps.lsf(ds)) == ps.lsf(Sv.Num.inc(ds)) : String}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Sv.D0{}:
          {==}
        case Sv.D1{}:
          {==}
        case Sv.D2{}:
          {==}
        case Sv.D3{}:
          {==}
        case Sv.D4{}:
          {==}
        case Sv.D5{}:
          {==}
        case Sv.D6{}:
          {==}
        case Sv.D7{}:
          {==}
        case Sv.D8{}:
          {==}
        case Sv.D9{}:
          Equal.cong(String, String, s => SCon{'0', s}, Laws.dec_raise(ps.lsf(rest)), ps.lsf(Sv.Num.inc(rest)), ps.raise_inc(rest))

# the spec's decimal text of n is the text Num.str writes for n's digits
def ps.dec_spec_str(n: Nat) -> {Laws.dec_spec(n) == Sv.Num.str(Sv.Num.dec(n), SNil{}) : String}:
  match n:
    case 0n:
      {==}
    case 1n+(+p):
      %Equal.sym(String, Laws.dec_spec(p), Sv.Num.str(Sv.Num.dec(p), SNil{}), ps.dec_spec_str(p)) : {String.reverse(Laws.dec_raise(String.reverse(_))) == Sv.Num.str(Sv.Num.inc(Sv.Num.dec(p)), SNil{}) : String}
      %Equal.sym(String, Sv.Num.str(Sv.Num.dec(p), SNil{}), String.reverse.go(ps.lsf(Sv.Num.dec(p)), SNil{}), ps.str_rev(Sv.Num.dec(p), SNil{})) : {String.reverse(Laws.dec_raise(String.reverse(_))) == Sv.Num.str(Sv.Num.inc(Sv.Num.dec(p)), SNil{}) : String}
      %Equal.sym(String, String.reverse.go(String.reverse.go(ps.lsf(Sv.Num.dec(p)), SNil{}), SNil{}), String.reverse.go(SNil{}, ps.lsf(Sv.Num.dec(p))), ps.rev_rev(ps.lsf(Sv.Num.dec(p)), SNil{})) : {String.reverse(Laws.dec_raise(_)) == Sv.Num.str(Sv.Num.inc(Sv.Num.dec(p)), SNil{}) : String}
      %Equal.sym(String, Laws.dec_raise(ps.lsf(Sv.Num.dec(p))), ps.lsf(Sv.Num.inc(Sv.Num.dec(p))), ps.raise_inc(Sv.Num.dec(p))) : {String.reverse(_) == Sv.Num.str(Sv.Num.inc(Sv.Num.dec(p)), SNil{}) : String}
      Equal.sym(String, Sv.Num.str(Sv.Num.inc(Sv.Num.dec(p)), SNil{}), String.reverse.go(ps.lsf(Sv.Num.inc(Sv.Num.dec(p))), SNil{}), ps.str_rev(Sv.Num.inc(Sv.Num.dec(p)), SNil{}))

# a version is written as its three numbers in decimal, joined by dots
def ps.show_decimal(+a: Nat, +b: Nat, +c: Nat) -> {Sv.Ver.show(Sv.Ver{a, b, c}) == String.append(Laws.dec_spec(a), SCon{'.', String.append(Laws.dec_spec(b), SCon{'.', Laws.dec_spec(c)})}) : String}:
  %Equal.sym(String, Laws.dec_spec(a), Sv.Num.str(Sv.Num.dec(a), SNil{}), ps.dec_spec_str(a)) : {Sv.Ver.show(Sv.Ver{a, b, c}) == String.append(_, SCon{'.', String.append(Laws.dec_spec(b), SCon{'.', Laws.dec_spec(c)})}) : String}
  %Equal.sym(String, Laws.dec_spec(b), Sv.Num.str(Sv.Num.dec(b), SNil{}), ps.dec_spec_str(b)) : {Sv.Ver.show(Sv.Ver{a, b, c}) == String.append(Sv.Num.str(Sv.Num.dec(a), SNil{}), SCon{'.', String.append(_, SCon{'.', Laws.dec_spec(c)})}) : String}
  %Equal.sym(String, Laws.dec_spec(c), Sv.Num.str(Sv.Num.dec(c), SNil{}), ps.dec_spec_str(c)) : {Sv.Ver.show(Sv.Ver{a, b, c}) == String.append(Sv.Num.str(Sv.Num.dec(a), SNil{}), SCon{'.', String.append(Sv.Num.str(Sv.Num.dec(b), SNil{}), SCon{'.', _})}) : String}
  %ps.str_app(Sv.Num.dec(b), SNil{}, SCon{'.', Sv.Num.str(Sv.Num.dec(c), SNil{})}) : {Sv.Ver.show(Sv.Ver{a, b, c}) == String.append(Sv.Num.str(Sv.Num.dec(a), SNil{}), SCon{'.', _}) : String}
  ps.str_app(Sv.Num.dec(a), SNil{}, SCon{'.', Sv.Num.str(Sv.Num.dec(b), SCon{'.', Sv.Num.str(Sv.Num.dec(c), SNil{})})})

# ---- auth_flight ----

# proof_auth_flight: the laws of LAWS.bend section auth_flight (A1). Every event
# keeps an invariant of the reachable states (`pf.Inv`): the callers that
# lead a flight are as many as the flights in flight (one or none); a
# leader leads the flight that lands next; a leader about to land a
# credential finds it stored, or a newer one; and a finished caller of a
# flight holds the outcome that flight landed with. The laws follow from
# it.

# Logic and numbers
# -----------------

def auth_flight.pf.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pf.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : auth_flight.pf.BD(_, Unit, A)
  Unit{}

def auth_flight.pf.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : auth_flight.pf.BD(_, A, Unit)
  Unit{}

def pf.ND(n: Nat, z: Type, s: Type) -> Type:
  match n:
    case 0n:
      z
    case 1n+p:
      s

def pf.succ_ne_zero(-A: Type, -n: Nat, e: {1n+n == 0n : Nat}) -> A:
  %e : pf.ND(_, A, Unit)
  Unit{}

def pf.pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def pf.succ_inj(-a: Nat, -b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, x => pf.pred(x), 1n+a, 1n+b, e)

def pf.MD(-A: Data, m: Maybe<&2, A>, n: Type, s: Type) -> Type:
  match m:
    case None{}:
      n
    case Some{x}:
      s

def pf.none_some(-A: Data, -B: Type, -x: A, e: {None{} == Some{x} : Maybe<&2, A>}) -> B:
  %e : pf.MD(A, _, Unit, B)
  Unit{}

def pf.some_inj(-A: Data, +d: A, -x: A, -y: A, e: {Some{x} == Some{y} : Maybe<&2, A>}) -> {x == y : A}:
  Equal.cong(Maybe<&2, A>, A, m => Maybe.default(&2, A, m, d), Some{x}, Some{y}, e)

# a + b == 0: both are 0
def auth_flight.pf.add_zero(a: Nat, -b: Nat, e: {Nat.add(a, b) == 0n : Nat}) -> ({a == 0n : Nat} & {b == 0n : Nat}):
  match a:
    case 0n:
      ({==}, e)
    case 1n+p:
      pf.succ_ne_zero(({1n+p == 0n : Nat} & {b == 0n : Nat}), Nat.add(p, b), e)

def pf.add_succ_ne_zero(-A: Type, a: Nat, -b: Nat, e: {Nat.add(a, 1n+b) == 0n : Nat}) -> A:
  match a:
    case 0n:
      pf.succ_ne_zero(A, b, e)
    case 1n+p:
      pf.succ_ne_zero(A, Nat.add(p, 1n+b), e)

# a + (1 + b) == 1: both are 0
def pf.add_one(a: Nat, -b: Nat, e: {Nat.add(a, 1n+b) == 1n : Nat}) -> ({a == 0n : Nat} & {b == 0n : Nat}):
  match a:
    case 0n:
      ({==}, pf.succ_inj(b, 0n, e))
    case 1n+p:
      pf.add_succ_ne_zero(({1n+p == 0n : Nat} & {b == 0n : Nat}), p, b, pf.succ_inj(Nat.add(p, 1n+b), 0n, e))

def pf.add_zero_r(a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pf.add_zero_r(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def pf.add_assoc(a: Nat, -b: Nat, -c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pf.add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

def auth_flight.pf.le_refl(n: Nat) -> {F.le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      auth_flight.pf.le_refl(p)

def auth_flight.pf.le_succ(a: Nat, b: Nat, h: {F.le(a, b) == True{} : Bool}) -> {F.le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n _:
      {==}
    case 1n+p 0n:
      auth_flight.pf.absurdF({F.le(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      auth_flight.pf.le_succ(p, q, h)

def pf.fst(-A: Type, -B: Type, p: (A & B)) -> A:
  (a, b) = p
  a

def pf.snd(-A: Type, -B: Type, p: (A & B)) -> B:
  (a, b) = p
  b

# Lists
# -----

def pf.drop_zero(-A: Data, xs: List<&2, A>) -> {xs == List.drop(&2, A, xs, 0n) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case h <> t:
      {==}

def pf.get_snoc(-A: Data, xs: List<&2, A>, +x: A) -> {List.get(&2, A, List.append(&2, A, xs, [x]), List.length(&2, A, xs)) == Some{x} : Maybe<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case h <> t:
      pf.get_snoc(A, t, x)

def pf.get_append(-A: Data, xs: List<&2, A>, k: Nat, -x: A, +ys: List<&2, A>, g: {List.get(&2, A, xs, k) == Some{x} : Maybe<&2, A>}) -> {List.get(&2, A, List.append(&2, A, xs, ys), k) == Some{x} : Maybe<&2, A>}:
  match xs k:
    case Nil{} _:
      pf.none_some(A, {List.get(&2, A, ys, k) == Some{x} : Maybe<&2, A>}, x, g)
    case h <> t 0n:
      g
    case h <> t 1n+p:
      pf.get_append(A, t, p, x, ys, g)

# a list is the items before k, item k, and the items after it
def pf.split(-A: Data, +d: A, xs: List<&2, A>, k: Nat, -x: A, g: {List.get(&2, A, xs, k) == Some{x} : Maybe<&2, A>}) -> {xs == List.append(&2, A, List.take(&2, A, xs, k), x <> List.drop(&2, A, xs, 1n+k)) : List<&2, A>}:
  match xs k:
    case Nil{} _:
      pf.none_some(A, {Nil{} == List.append(&2, A, List.take(&2, A, Nil{}, k), x <> List.drop(&2, A, Nil{}, 1n+k)) : List<&2, A>}, x, g)
    case +h <> +t 0n:
      %pf.some_inj(A, d, h, x, g) : {h <> t == _ <> List.drop(&2, A, t, 0n) : List<&2, A>}
      %pf.drop_zero(A, t) : {h <> t == h <> _ : List<&2, A>}
      {==}
    case +h <> +t 1n+p:
      %pf.split(A, d, t, p, x, g) : {h <> t == h <> _ : List<&2, A>}
      {==}

# item k of the list with item k replaced is the new item
def pf.get_put(-A: Data, xs: List<&2, A>, k: Nat, -x: A, +y: A, g: {List.get(&2, A, xs, k) == Some{x} : Maybe<&2, A>}) -> {List.get(&2, A, List.append(&2, A, List.take(&2, A, xs, k), y <> List.drop(&2, A, xs, 1n+k)), k) == Some{y} : Maybe<&2, A>}:
  match xs k:
    case Nil{} _:
      pf.none_some(A, {List.get(&2, A, List.append(&2, A, List.take(&2, A, Nil{}, k), y <> List.drop(&2, A, Nil{}, 1n+k)), k) == Some{y} : Maybe<&2, A>}, x, g)
    case h <> t 0n:
      {==}
    case h <> t 1n+p:
      pf.get_put(A, t, p, x, y, g)

# The invariant
# -------------

# 1 for a caller that leads a flight
def pf.lead(l: F.Leg) -> Nat:
  match l:
    case F.Load{}:
      0n
    case F.Board{}:
      0n
    case F.Check{f}:
      1n
    case F.Fetch{f}:
      1n
    case F.Store{f, c}:
      1n
    case F.Land{f, o}:
      1n
    case F.Waiting{f}:
      0n
    case F.Served{v, o}:
      0n

# the callers that lead a flight
def pf.leads(cs: List<&2, F.Leg>) -> Nat:
  match cs:
    case Nil{}:
      0n
    case l <> t:
      Nat.add(pf.lead(l), pf.leads(t))

# the flights in flight
def pf.holds(b: Bool) -> Nat:
  match b:
    case True{}:
      1n
    case False{}:
      0n

# a leader leads the flight in flight, the one that lands next
def pf.Lead(+fl: Bool, +ld: List<&2, F.Out>, f: Nat) -> Type:
  ({fl == True{} : Bool} & {f == List.length(&2, F.Out, ld) : Nat})

# a credential about to land is stored, or a newer one
def pf.Kept(o: F.Out, +s: F.Sto) -> Type:
  match o:
    case F.Ok{c}:
      {F.le(c, F.Sto.c(s)) == True{} : Bool}
    case F.Err{e}:
      Unit

# a finished caller of flight f holds f's outcome
def pf.Got(+ld: List<&2, F.Out>, v: Maybe<&2, Nat>, o: F.Out) -> Type:
  match v:
    case None{}:
      Unit
    case Some{f}:
      {List.get(&2, F.Out, ld, f) == Some{o} : Maybe<&2, F.Out>}

def pf.Good(w: F.W, l: F.Leg) -> Type:
  match w:
    case F.W{+s, +fl, +ld, n}:
      match l:
        case F.Load{}:
          Unit
        case F.Board{}:
          Unit
        case F.Check{f}:
          pf.Lead(fl, ld, f)
        case F.Fetch{f}:
          pf.Lead(fl, ld, f)
        case F.Store{f, c}:
          pf.Lead(fl, ld, f)
        case F.Land{f, o}:
          (pf.Lead(fl, ld, f) & pf.Kept(o, s))
        case F.Waiting{f}:
          Unit
        case F.Served{v, o}:
          pf.Got(ld, v, o)

def pf.All(+w: F.W, cs: List<&2, F.Leg>) -> Type:
  match cs:
    case Nil{}:
      Unit
    case l <> t:
      (pf.Good(w, l) & pf.All(w, t))

def auth_flight.pf.Inv(s: F.St) -> Type:
  match s:
    case F.St{+w, +cs}:
      ({pf.leads(cs) == pf.holds(F.W.fl(w)) : Nat} & pf.All(w, cs))

# Counting and splitting the callers
# ----------------------------------

def pf.leads_append(xs: List<&2, F.Leg>, +ys: List<&2, F.Leg>) -> {pf.leads(List.append(&2, F.Leg, xs, ys)) == Nat.add(pf.leads(xs), pf.leads(ys)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      %Equal.sym(Nat, Nat.add(Nat.add(pf.lead(h), pf.leads(t)), pf.leads(ys)), Nat.add(pf.lead(h), Nat.add(pf.leads(t), pf.leads(ys))), pf.add_assoc(pf.lead(h), pf.leads(t), pf.leads(ys))) : {Nat.add(pf.lead(h), pf.leads(List.append(&2, F.Leg, t, ys))) == _ : Nat}
      %pf.leads_append(t, ys) : {Nat.add(pf.lead(h), pf.leads(List.append(&2, F.Leg, t, ys))) == Nat.add(pf.lead(h), _) : Nat}
      {==}

def pf.all_split.cons(+w: F.W, -h: F.Leg, -t: List<&2, F.Leg>, -l: F.Leg, -post: List<&2, F.Leg>, gh: pf.Good(w, h), r: (pf.All(w, t) & (pf.Good(w, l) & pf.All(w, post)))) -> (pf.All(w, h <> t) & (pf.Good(w, l) & pf.All(w, post))):
  (ap, rest) = r
  ((gh, ap), rest)

def pf.all_split(+w: F.W, pre: List<&2, F.Leg>, -l: F.Leg, -post: List<&2, F.Leg>, a: pf.All(w, List.append(&2, F.Leg, pre, l <> post))) -> (pf.All(w, pre) & (pf.Good(w, l) & pf.All(w, post))):
  match pre:
    case Nil{}:
      (Unit{}, a)
    case h <> t:
      (gh, at) = a
      pf.all_split.cons(w, h, t, l, post, gh, pf.all_split(w, t, l, post, at))

def pf.all_join(+w: F.W, pre: List<&2, F.Leg>, -l: F.Leg, -post: List<&2, F.Leg>, ap: pf.All(w, pre), gl: pf.Good(w, l), aq: pf.All(w, post)) -> pf.All(w, List.append(&2, F.Leg, pre, l <> post)):
  match pre:
    case Nil{}:
      (gl, aq)
    case h <> t:
      (gh, at) = ap
      (gh, pf.all_join(w, t, l, post, at, gl, aq))

def pf.all_get(+w: F.W, cs: List<&2, F.Leg>, k: Nat, -x: F.Leg, g: {List.get(&2, F.Leg, cs, k) == Some{x} : Maybe<&2, F.Leg>}, a: pf.All(w, cs)) -> pf.Good(w, x):
  match cs k:
    case Nil{} _:
      pf.none_some(F.Leg, pf.Good(w, x), x, g)
    case +h <> t 0n:
      (gh, at) = a
      %pf.some_inj(F.Leg, F.Load{}, h, x, g) : pf.Good(w, _)
      gh
    case h <> t 1n+p:
      (gh, at) = a
      pf.all_get(w, t, p, x, g, at)

# the invariant of a world and callers that are one list split at a leg
def pf.inv_of(+w: F.W, +pre: List<&2, F.Leg>, +l: F.Leg, +post: List<&2, F.Leg>, n: {Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))) == pf.holds(F.W.fl(w)) : Nat}, ap: pf.All(w, pre), gl: pf.Good(w, l), aq: pf.All(w, post)) -> auth_flight.pf.Inv(F.St{w, List.append(&2, F.Leg, pre, l <> post)}):
  (Equal.trans(Nat, pf.leads(List.append(&2, F.Leg, pre, l <> post)), Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))), pf.holds(F.W.fl(w)), pf.leads_append(pre, l <> post), n), pf.all_join(w, pre, l, post, ap, gl, aq))

# Frames: what a step leaves of the other callers
# ------------------------------------------------

# a flight starts: no leader was in flight
def pf.good_flon(+s: F.Sto, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, g: pf.Good(F.W{s, False{}, ld, n}, l)) -> pf.Good(F.W{s, True{}, ld, n}, l):
  match l:
    case F.Load{}:
      Unit{}
    case F.Board{}:
      Unit{}
    case F.Check{f}:
      (e, _) = g
      auth_flight.pf.absurdF(pf.Lead(True{}, ld, f), e)
    case F.Fetch{f}:
      (e, _) = g
      auth_flight.pf.absurdF(pf.Lead(True{}, ld, f), e)
    case F.Store{f, c}:
      (e, _) = g
      auth_flight.pf.absurdF(pf.Lead(True{}, ld, f), e)
    case F.Land{f, o}:
      (lead, _) = g
      (e, _) = lead
      auth_flight.pf.absurdF((pf.Lead(True{}, ld, f) & pf.Kept(o, s)), e)
    case F.Waiting{f}:
      Unit{}
    case F.Served{v, o}:
      g

def pf.all_flon(+s: F.Sto, +ld: List<&2, F.Out>, +n: Nat, cs: List<&2, F.Leg>, a: pf.All(F.W{s, False{}, ld, n}, cs)) -> pf.All(F.W{s, True{}, ld, n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case h <> t:
      (gh, at) = a
      (pf.good_flon(s, ld, n, h, gh), pf.all_flon(s, ld, n, t, at))

# a fetch counts: no leg depends on the count
def pf.good_fetch(+s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, g: pf.Good(F.W{s, fl, ld, n}, l)) -> pf.Good(F.W{s, fl, ld, 1n+n}, l):
  match l:
    case F.Load{}:
      g
    case F.Board{}:
      g
    case F.Check{f}:
      g
    case F.Fetch{f}:
      g
    case F.Store{f, c}:
      g
    case F.Land{f, o}:
      g
    case F.Waiting{f}:
      g
    case F.Served{v, o}:
      g

def pf.all_fetch(+s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, cs: List<&2, F.Leg>, a: pf.All(F.W{s, fl, ld, n}, cs)) -> pf.All(F.W{s, fl, ld, 1n+n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case h <> t:
      (gh, at) = a
      (pf.good_fetch(s, fl, ld, n, h, gh), pf.all_fetch(s, fl, ld, n, t, at))

# the leader stores: no other caller leads
def pf.good_store(+s1: F.Sto, +s2: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, z: {pf.lead(l) == 0n : Nat}, g: pf.Good(F.W{s1, fl, ld, n}, l)) -> pf.Good(F.W{s2, fl, ld, n}, l):
  match l:
    case F.Load{}:
      Unit{}
    case F.Board{}:
      Unit{}
    case F.Check{f}:
      pf.succ_ne_zero(pf.Lead(fl, ld, f), 0n, z)
    case F.Fetch{f}:
      pf.succ_ne_zero(pf.Lead(fl, ld, f), 0n, z)
    case F.Store{f, c}:
      pf.succ_ne_zero(pf.Lead(fl, ld, f), 0n, z)
    case F.Land{f, o}:
      pf.succ_ne_zero((pf.Lead(fl, ld, f) & pf.Kept(o, s2)), 0n, z)
    case F.Waiting{f}:
      Unit{}
    case F.Served{v, o}:
      g

def pf.all_store(+s1: F.Sto, +s2: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, cs: List<&2, F.Leg>, +z: {pf.leads(cs) == 0n : Nat}, a: pf.All(F.W{s1, fl, ld, n}, cs)) -> pf.All(F.W{s2, fl, ld, n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case +h <> +t:
      (gh, at) = a
      (pf.good_store(s1, s2, fl, ld, n, h, pf.fst({pf.lead(h) == 0n : Nat}, {pf.leads(t) == 0n : Nat}, auth_flight.pf.add_zero(pf.lead(h), pf.leads(t), z)), gh), pf.all_store(s1, s2, fl, ld, n, t, pf.snd({pf.lead(h) == 0n : Nat}, {pf.leads(t) == 0n : Nat}, auth_flight.pf.add_zero(pf.lead(h), pf.leads(t), z)), at))

# the leader lands: no other caller leads, and the landed outcomes only grow
def pf.got_land(+ld: List<&2, F.Out>, +o: F.Out, v: Maybe<&2, Nat>, +o2: F.Out, g: pf.Got(ld, v, o2)) -> pf.Got(List.append(&2, F.Out, ld, [o]), v, o2):
  match v:
    case None{}:
      Unit{}
    case Some{f}:
      pf.get_append(F.Out, ld, f, o2, [o], g)

def pf.good_land(+s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +o: F.Out, +n: Nat, l: F.Leg, z: {pf.lead(l) == 0n : Nat}, g: pf.Good(F.W{s, fl, ld, n}, l)) -> pf.Good(F.W{s, False{}, List.append(&2, F.Out, ld, [o]), n}, l):
  match l:
    case F.Load{}:
      Unit{}
    case F.Board{}:
      Unit{}
    case F.Check{f}:
      pf.succ_ne_zero(pf.Lead(False{}, List.append(&2, F.Out, ld, [o]), f), 0n, z)
    case F.Fetch{f}:
      pf.succ_ne_zero(pf.Lead(False{}, List.append(&2, F.Out, ld, [o]), f), 0n, z)
    case F.Store{f, c}:
      pf.succ_ne_zero(pf.Lead(False{}, List.append(&2, F.Out, ld, [o]), f), 0n, z)
    case F.Land{f, o3}:
      pf.succ_ne_zero((pf.Lead(False{}, List.append(&2, F.Out, ld, [o]), f) & pf.Kept(o3, s)), 0n, z)
    case F.Waiting{f}:
      Unit{}
    case F.Served{v, o2}:
      pf.got_land(ld, o, v, o2, g)

def pf.all_land(+s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +o: F.Out, +n: Nat, cs: List<&2, F.Leg>, +z: {pf.leads(cs) == 0n : Nat}, a: pf.All(F.W{s, fl, ld, n}, cs)) -> pf.All(F.W{s, False{}, List.append(&2, F.Out, ld, [o]), n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case +h <> +t:
      (gh, at) = a
      (pf.good_land(s, fl, ld, o, n, h, pf.fst({pf.lead(h) == 0n : Nat}, {pf.leads(t) == 0n : Nat}, auth_flight.pf.add_zero(pf.lead(h), pf.leads(t), z)), gh), pf.all_land(s, fl, ld, o, n, t, pf.snd({pf.lead(h) == 0n : Nat}, {pf.leads(t) == 0n : Nat}, auth_flight.pf.add_zero(pf.lead(h), pf.leads(t), z)), at))

# a peer stores a newer credential
def pf.kept_peer(o: F.Out, +c: Nat, +fr: Bool, k: pf.Kept(o, F.Sto{c, fr})) -> pf.Kept(o, F.Sto{1n+c, True{}}):
  match o:
    case F.Ok{c2}:
      auth_flight.pf.le_succ(c2, c, k)
    case F.Err{e}:
      Unit{}

def pf.good_peer(+c: Nat, +fr: Bool, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, g: pf.Good(F.W{F.Sto{c, fr}, fl, ld, n}, l)) -> pf.Good(F.W{F.Sto{1n+c, True{}}, fl, ld, n}, l):
  match l:
    case F.Load{}:
      Unit{}
    case F.Board{}:
      Unit{}
    case F.Check{f}:
      g
    case F.Fetch{f}:
      g
    case F.Store{f, c2}:
      g
    case F.Land{f, o}:
      (lead, k) = g
      (lead, pf.kept_peer(o, c, fr, k))
    case F.Waiting{f}:
      Unit{}
    case F.Served{v, o}:
      g

def pf.all_peer(+c: Nat, +fr: Bool, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, cs: List<&2, F.Leg>, a: pf.All(F.W{F.Sto{c, fr}, fl, ld, n}, cs)) -> pf.All(F.W{F.Sto{1n+c, True{}}, fl, ld, n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case h <> t:
      (gh, at) = a
      (pf.good_peer(c, fr, fl, ld, n, h, gh), pf.all_peer(c, fr, fl, ld, n, t, at))

# the stored credential expires: it stays the stored one
def pf.kept_expire(o: F.Out, +c: Nat, +fr: Bool, k: pf.Kept(o, F.Sto{c, fr})) -> pf.Kept(o, F.Sto{c, False{}}):
  match o:
    case F.Ok{c2}:
      k
    case F.Err{e}:
      Unit{}

def pf.good_expire(+c: Nat, +fr: Bool, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, g: pf.Good(F.W{F.Sto{c, fr}, fl, ld, n}, l)) -> pf.Good(F.W{F.Sto{c, False{}}, fl, ld, n}, l):
  match l:
    case F.Load{}:
      Unit{}
    case F.Board{}:
      Unit{}
    case F.Check{f}:
      g
    case F.Fetch{f}:
      g
    case F.Store{f, c2}:
      g
    case F.Land{f, o}:
      (lead, k) = g
      (lead, pf.kept_expire(o, c, fr, k))
    case F.Waiting{f}:
      Unit{}
    case F.Served{v, o}:
      g

def pf.all_expire(+c: Nat, +fr: Bool, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, cs: List<&2, F.Leg>, a: pf.All(F.W{F.Sto{c, fr}, fl, ld, n}, cs)) -> pf.All(F.W{F.Sto{c, False{}}, fl, ld, n}, cs):
  match cs:
    case Nil{}:
      Unit{}
    case h <> t:
      (gh, at) = a
      (pf.good_expire(c, fr, fl, ld, n, h, gh), pf.all_expire(c, fr, fl, ld, n, t, at))

# A step keeps the invariant
# --------------------------

def pf.zero_sum(-a: Nat, -b: Nat, za: {a == 0n : Nat}, zb: {b == 0n : Nat}) -> {Nat.add(a, b) == 0n : Nat}:
  %Equal.sym(Nat, a, 0n, za) : {Nat.add(_, b) == 0n : Nat}
  zb

def pf.core.start.count(-a: Nat, -b: Nat, za: {a == 0n : Nat}, zb: {b == 0n : Nat}) -> {Nat.add(a, 1n+b) == 1n : Nat}:
  %Equal.sym(Nat, a, 0n, za) : {Nat.add(_, 1n+b) == 1n : Nat}
  %Equal.sym(Nat, b, 0n, zb) : {1n+_ == 1n : Nat}
  {==}

# a caller boards and no flight is in flight: it starts the next flight
def pf.core.start(+s: F.Sto, +ld: List<&2, F.Out>, +n: Nat, +pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, +i: {Nat.add(pf.leads(pre), pf.leads(post)) == 0n : Nat}, ap: pf.All(F.W{s, False{}, ld, n}, pre), aq: pf.All(F.W{s, False{}, ld, n}, post)) -> auth_flight.pf.Inv(F.St{F.W{s, True{}, ld, n}, List.append(&2, F.Leg, pre, F.Check{List.length(&2, F.Out, ld)} <> post)}):
  +zp = pf.fst({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, auth_flight.pf.add_zero(pf.leads(pre), pf.leads(post), i))
  +zq = pf.snd({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, auth_flight.pf.add_zero(pf.leads(pre), pf.leads(post), i))
  pf.inv_of(F.W{s, True{}, ld, n}, pre, F.Check{List.length(&2, F.Out, ld)}, post, pf.core.start.count(pf.leads(pre), pf.leads(post), zp, zq), pf.all_flon(s, ld, n, pre, ap), ({==}, {==}), pf.all_flon(s, ld, n, post, aq))

def pf.core.land.got(-f: Nat, +ld: List<&2, F.Out>, +o: F.Out, ef: {f == List.length(&2, F.Out, ld) : Nat}) -> {List.get(&2, F.Out, List.append(&2, F.Out, ld, [o]), f) == Some{o} : Maybe<&2, F.Out>}:
  %Equal.sym(Nat, f, List.length(&2, F.Out, ld), ef) : {List.get(&2, F.Out, List.append(&2, F.Out, ld, [o]), _) == Some{o} : Maybe<&2, F.Out>}
  pf.get_snoc(F.Out, ld, o)

# the leader stores the fetched credential: no other caller leads
def pf.core.store(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, +f: Nat, +c: Nat, +x: Nat, fl: Bool, +ld: List<&2, F.Out>, +n: Nat, +i: {Nat.add(pf.leads(pre), 1n+pf.leads(post)) == pf.holds(fl) : Nat}, ap: pf.All(F.W{F.Sto{x, False{}}, fl, ld, n}, pre), gl: pf.Lead(fl, ld, f), aq: pf.All(F.W{F.Sto{x, False{}}, fl, ld, n}, post)) -> auth_flight.pf.Inv(F.St{F.W{F.Sto{c, True{}}, fl, ld, n}, List.append(&2, F.Leg, pre, F.Land{f, F.Ok{c}} <> post)}):
  match fl:
    case True{}:
      +zp = pf.fst({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, pf.add_one(pf.leads(pre), pf.leads(post), i))
      +zq = pf.snd({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, pf.add_one(pf.leads(pre), pf.leads(post), i))
      pf.inv_of(F.W{F.Sto{c, True{}}, True{}, ld, n}, pre, F.Land{f, F.Ok{c}}, post, i, pf.all_store(F.Sto{x, False{}}, F.Sto{c, True{}}, True{}, ld, n, pre, zp, ap), (gl, auth_flight.pf.le_refl(c)), pf.all_store(F.Sto{x, False{}}, F.Sto{c, True{}}, True{}, ld, n, post, zq, aq))
    case False{}:
      (e, _) = gl
      auth_flight.pf.absurdF(auth_flight.pf.Inv(F.St{F.W{F.Sto{c, True{}}, False{}, ld, n}, List.append(&2, F.Leg, pre, F.Land{f, F.Ok{c}} <> post)}), e)

# the leader lands: no other caller leads, and no flight is in flight
def pf.core.land(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, +f: Nat, +o: F.Out, +s: F.Sto, fl: Bool, +ld: List<&2, F.Out>, +n: Nat, +i: {Nat.add(pf.leads(pre), 1n+pf.leads(post)) == pf.holds(fl) : Nat}, ap: pf.All(F.W{s, fl, ld, n}, pre), gl: (pf.Lead(fl, ld, f) & pf.Kept(o, s)), aq: pf.All(F.W{s, fl, ld, n}, post)) -> auth_flight.pf.Inv(F.St{F.W{s, False{}, List.append(&2, F.Out, ld, [o]), n}, List.append(&2, F.Leg, pre, F.Served{Some{f}, o} <> post)}):
  match fl:
    case True{}:
      (lead, kept) = gl
      (efl, ef) = lead
      +zp = pf.fst({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, pf.add_one(pf.leads(pre), pf.leads(post), i))
      +zq = pf.snd({pf.leads(pre) == 0n : Nat}, {pf.leads(post) == 0n : Nat}, pf.add_one(pf.leads(pre), pf.leads(post), i))
      pf.inv_of(F.W{s, False{}, List.append(&2, F.Out, ld, [o]), n}, pre, F.Served{Some{f}, o}, post, pf.zero_sum(pf.leads(pre), pf.leads(post), zp, zq), pf.all_land(s, True{}, ld, o, n, pre, zp, ap), pf.core.land.got(f, ld, o, ef), pf.all_land(s, True{}, ld, o, n, post, zq, aq))
    case False{}:
      (lead, kept) = gl
      (e, _) = lead
      auth_flight.pf.absurdF(auth_flight.pf.Inv(F.St{F.W{s, False{}, List.append(&2, F.Out, ld, [o]), n}, List.append(&2, F.Leg, pre, F.Served{Some{f}, o} <> post)}), e)

# a caller that joined a flight takes its outcome once it landed
def pf.core.wait(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, +f: Nat, +s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, m: Maybe<&2, F.Out>, e: {List.get(&2, F.Out, ld, f) == m : Maybe<&2, F.Out>}, i: {Nat.add(pf.leads(pre), pf.leads(post)) == pf.holds(fl) : Nat}, ap: pf.All(F.W{s, fl, ld, n}, pre), aq: pf.All(F.W{s, fl, ld, n}, post)) -> auth_flight.pf.Inv(F.St{F.Adv.w(F.adv.wait.got(f, m, F.W{s, fl, ld, n})), List.append(&2, F.Leg, pre, F.Adv.l(F.adv.wait.got(f, m, F.W{s, fl, ld, n})) <> post)}):
  match m:
    case None{}:
      pf.inv_of(F.W{s, fl, ld, n}, pre, F.Waiting{f}, post, i, ap, Unit{}, aq)
    case Some{+o}:
      pf.inv_of(F.W{s, fl, ld, n}, pre, F.Served{Some{f}, o}, post, i, ap, e, aq)

# one caller's step, between the callers before it and after it
def pf.core(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, l: F.Leg, w: F.W, ok: Bool, i: {Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))) == pf.holds(F.W.fl(w)) : Nat}, ap: pf.All(w, pre), gl: pf.Good(w, l), aq: pf.All(w, post)) -> auth_flight.pf.Inv(F.St{F.Adv.w(F.adv(l, ok, w)), List.append(&2, F.Leg, pre, F.Adv.l(F.adv(l, ok, w)) <> post)}):
  match l:
    case F.Load{}:
      match w:
        case F.W{s, +fl, +ld, +n}:
          match s:
            case F.Sto{+c, fr}:
              match fr:
                case True{}:
                  pf.inv_of(F.W{F.Sto{c, True{}}, fl, ld, n}, pre, F.Served{None{}, F.Ok{c}}, post, i, ap, Unit{}, aq)
                case False{}:
                  pf.inv_of(F.W{F.Sto{c, False{}}, fl, ld, n}, pre, F.Board{}, post, i, ap, Unit{}, aq)
    case F.Board{}:
      match w:
        case F.W{+s, fl, +ld, +n}:
          match fl:
            case True{}:
              pf.inv_of(F.W{s, True{}, ld, n}, pre, F.Waiting{List.length(&2, F.Out, ld)}, post, i, ap, Unit{}, aq)
            case False{}:
              pf.core.start(s, ld, n, pre, post, i, ap, aq)
    case F.Check{+f}:
      match w:
        case F.W{s, +fl, +ld, +n}:
          match s:
            case F.Sto{+c, fr}:
              match fr:
                case True{}:
                  pf.inv_of(F.W{F.Sto{c, True{}}, fl, ld, n}, pre, F.Land{f, F.Ok{c}}, post, i, ap, (gl, auth_flight.pf.le_refl(c)), aq)
                case False{}:
                  pf.inv_of(F.W{F.Sto{c, False{}}, fl, ld, n}, pre, F.Fetch{f}, post, i, ap, gl, aq)
    case F.Fetch{+f}:
      match w:
        case F.W{+s, +fl, +ld, +n}:
          match ok:
            case True{}:
              pf.inv_of(F.W{s, fl, ld, 1n+n}, pre, F.Store{f, 1n+n}, post, i, pf.all_fetch(s, fl, ld, n, pre, ap), gl, pf.all_fetch(s, fl, ld, n, post, aq))
            case False{}:
              pf.inv_of(F.W{s, fl, ld, 1n+n}, pre, F.Land{f, F.Err{1n+n}}, post, i, pf.all_fetch(s, fl, ld, n, pre, ap), (gl, Unit{}), pf.all_fetch(s, fl, ld, n, post, aq))
    case F.Store{+f, +c}:
      match w:
        case F.W{s, fl, +ld, +n}:
          match s:
            case F.Sto{+p, fr}:
              match fr:
                case True{}:
                  pf.inv_of(F.W{F.Sto{p, True{}}, fl, ld, n}, pre, F.Land{f, F.Ok{p}}, post, i, ap, (gl, auth_flight.pf.le_refl(p)), aq)
                case False{}:
                  pf.core.store(pre, post, f, c, p, fl, ld, n, i, ap, gl, aq)
    case F.Land{+f, +o}:
      match w:
        case F.W{+s, fl, +ld, +n}:
          pf.core.land(pre, post, f, o, s, fl, ld, n, i, ap, gl, aq)
    case F.Waiting{+f}:
      match w:
        case F.W{+s, +fl, +ld, +n}:
          pf.core.wait(pre, post, f, s, fl, ld, n, List.get(&2, F.Out, ld, f), {==}, i, ap, aq)
    case F.Served{+v, +o}:
      pf.inv_of(w, pre, F.Served{v, o}, post, i, ap, gl, aq)

def pf.inv_cs(+w: F.W, -cs: List<&2, F.Leg>, -xs: List<&2, F.Leg>, e: {cs == xs : List<&2, F.Leg>}, inv: auth_flight.pf.Inv(F.St{w, cs})) -> auth_flight.pf.Inv(F.St{w, xs}):
  %e : auth_flight.pf.Inv(F.St{w, _})
  inv

def pf.inv_core.parts(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, l: F.Leg, w: F.W, ok: Bool, i: {Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))) == pf.holds(F.W.fl(w)) : Nat}, parts: (pf.All(w, pre) & (pf.Good(w, l) & pf.All(w, post)))) -> auth_flight.pf.Inv(F.St{F.Adv.w(F.adv(l, ok, w)), List.append(&2, F.Leg, pre, F.Adv.l(F.adv(l, ok, w)) <> post)}):
  (ap, rest) = parts
  (gl, aq) = rest
  pf.core(pre, post, l, w, ok, i, ap, gl, aq)

def pf.inv_core(+pre: List<&2, F.Leg>, +post: List<&2, F.Leg>, +l: F.Leg, +w: F.W, ok: Bool, inv: auth_flight.pf.Inv(F.St{w, List.append(&2, F.Leg, pre, l <> post)})) -> auth_flight.pf.Inv(F.St{F.Adv.w(F.adv(l, ok, w)), List.append(&2, F.Leg, pre, F.Adv.l(F.adv(l, ok, w)) <> post)}):
  (cnt, all) = inv
  pf.inv_core.parts(pre, post, l, w, ok, Equal.trans(Nat, Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))), pf.leads(List.append(&2, F.Leg, pre, l <> post)), pf.holds(F.W.fl(w)), Equal.sym(Nat, pf.leads(List.append(&2, F.Leg, pre, l <> post)), Nat.add(pf.leads(pre), Nat.add(pf.lead(l), pf.leads(post))), pf.leads_append(pre, l <> post)), cnt), pf.all_split(w, pre, l, post, all))

def pf.put_eta(+k: Nat, a: F.Adv, +cs: List<&2, F.Leg>) -> {F.St{F.Adv.w(a), List.append(&2, F.Leg, List.take(&2, F.Leg, cs, k), F.Adv.l(a) <> List.drop(&2, F.Leg, cs, 1n+k))} == F.put(k, a, cs) : F.St}:
  match a:
    case F.Adv{l, w}:
      {==}

def pf.inv_at(m: Maybe<&2, F.Leg>, +k: Nat, +ok: Bool, +w: F.W, +cs: List<&2, F.Leg>, g: {List.get(&2, F.Leg, cs, k) == m : Maybe<&2, F.Leg>}, inv: auth_flight.pf.Inv(F.St{w, cs})) -> auth_flight.pf.Inv(F.step.at(m, k, ok, w, cs)):
  match m:
    case None{}:
      inv
    case Some{+l}:
      %pf.put_eta(k, F.adv(l, ok, w), cs) : auth_flight.pf.Inv(_)
      pf.inv_core(List.take(&2, F.Leg, cs, k), List.drop(&2, F.Leg, cs, 1n+k), l, w, ok, pf.inv_cs(w, cs, List.append(&2, F.Leg, List.take(&2, F.Leg, cs, k), l <> List.drop(&2, F.Leg, cs, 1n+k)), pf.split(F.Leg, F.Load{}, cs, k, l, g), inv))

def pf.inv_step(s: F.St, e: F.Ev, inv: auth_flight.pf.Inv(s)) -> auth_flight.pf.Inv(F.step(s, e)):
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{sto, +fl, +ld, +n}:
          match sto:
            case F.Sto{+c, +fr}:
              match e:
                case F.Arrive{}:
                  (cnt, all) = inv
                  (Equal.trans(Nat, pf.leads(List.append(&2, F.Leg, cs, [F.Load{}])), pf.leads(cs), pf.holds(fl), Equal.trans(Nat, pf.leads(List.append(&2, F.Leg, cs, [F.Load{}])), Nat.add(pf.leads(cs), 0n), pf.leads(cs), pf.leads_append(cs, [F.Load{}]), pf.add_zero_r(pf.leads(cs))), cnt), pf.all_join(F.W{F.Sto{c, fr}, fl, ld, n}, cs, F.Load{}, Nil{}, all, Unit{}, Unit{}))
                case F.Step{+k, ok}:
                  pf.inv_at(List.get(&2, F.Leg, cs, k), k, ok, F.W{F.Sto{c, fr}, fl, ld, n}, cs, {==}, inv)
                case F.Peer{}:
                  (cnt, all) = inv
                  (cnt, pf.all_peer(c, fr, fl, ld, n, cs, all))
                case F.Expire{}:
                  (cnt, all) = inv
                  (cnt, pf.all_expire(c, fr, fl, ld, n, cs, all))

def pf.inv_go(evs: List<&2, F.Ev>, +s: F.St, inv: auth_flight.pf.Inv(s)) -> auth_flight.pf.Inv(F.go(evs, s)):
  match evs:
    case Nil{}:
      inv
    case +e <> rest:
      pf.inv_go(rest, F.step(s, e), pf.inv_step(s, e, inv))

def pf.inv_run(evs: List<&2, F.Ev>) -> auth_flight.pf.Inv(F.run(evs)):
  pf.inv_go(evs, F.St.new(), ({==}, Unit{}))

# The laws
# --------

def pf.zero_fetching(cs: List<&2, F.Leg>, z: {pf.leads(cs) == 0n : Nat}) -> {F.fetching(cs) == 0n : Nat}:
  match cs:
    case Nil{}:
      {==}
    case l <> t:
      match l:
        case F.Load{}:
          pf.zero_fetching(t, z)
        case F.Board{}:
          pf.zero_fetching(t, z)
        case F.Check{f}:
          pf.succ_ne_zero({F.fetching(t) == 0n : Nat}, pf.leads(t), z)
        case F.Fetch{f}:
          pf.succ_ne_zero({1n+F.fetching(t) == 0n : Nat}, pf.leads(t), z)
        case F.Store{f, c}:
          pf.succ_ne_zero({F.fetching(t) == 0n : Nat}, pf.leads(t), z)
        case F.Land{f, o}:
          pf.succ_ne_zero({F.fetching(t) == 0n : Nat}, pf.leads(t), z)
        case F.Waiting{f}:
          pf.zero_fetching(t, z)
        case F.Served{v, o}:
          pf.zero_fetching(t, z)

# one leader and a flight in flight: no other caller leads
def pf.one_holds(b: Bool, -x: Nat, e: {1n+x == pf.holds(b) : Nat}) -> {x == 0n : Nat}:
  match b:
    case True{}:
      pf.succ_inj(x, 0n, e)
    case False{}:
      pf.succ_ne_zero({x == 0n : Nat}, x, e)

def pf.le_zero_fetching(+t: List<&2, F.Leg>, +b: Bool, e: {1n+pf.leads(t) == pf.holds(b) : Nat}, +n: Nat) -> {F.le(F.fetching(t), n) == True{} : Bool}:
  %Equal.sym(Nat, F.fetching(t), 0n, pf.zero_fetching(t, pf.one_holds(b, pf.leads(t), e))) : {F.le(_, n) == True{} : Bool}
  {==}

def pf.fetch_le(cs: List<&2, F.Leg>, +b: Bool, e: {pf.leads(cs) == pf.holds(b) : Nat}) -> {F.le(F.fetching(cs), 1n) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case l <> +t:
      match l:
        case F.Load{}:
          pf.fetch_le(t, b, e)
        case F.Board{}:
          pf.fetch_le(t, b, e)
        case F.Check{f}:
          pf.le_zero_fetching(t, b, e, 1n)
        case F.Fetch{f}:
          pf.le_zero_fetching(t, b, e, 0n)
        case F.Store{f, c}:
          pf.le_zero_fetching(t, b, e, 1n)
        case F.Land{f, o}:
          pf.le_zero_fetching(t, b, e, 1n)
        case F.Waiting{f}:
          pf.fetch_le(t, b, e)
        case F.Served{v, o}:
          pf.fetch_le(t, b, e)

def pf.one_fetch(s: F.St, inv: auth_flight.pf.Inv(s)) -> {F.le(F.fetching(F.St.cs(s)), 1n) == True{} : Bool}:
  match s:
    case F.St{+w, +cs}:
      (cnt, all) = inv
      pf.fetch_le(cs, F.W.fl(w), cnt)

# the flight a caller leads is the flight in flight
def pf.led_lead(+s: F.Sto, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, l: F.Leg, +f: Nat, e: {F.led(l) == Some{f} : Maybe<&2, Nat>}, g: pf.Good(F.W{s, fl, ld, n}, l)) -> pf.Lead(fl, ld, f):
  match l:
    case F.Load{}:
      pf.none_some(Nat, pf.Lead(fl, ld, f), f, e)
    case F.Board{}:
      pf.none_some(Nat, pf.Lead(fl, ld, f), f, e)
    case F.Check{+f2}:
      %pf.some_inj(Nat, 0n, f2, f, e) : pf.Lead(fl, ld, _)
      g
    case F.Fetch{+f2}:
      %pf.some_inj(Nat, 0n, f2, f, e) : pf.Lead(fl, ld, _)
      g
    case F.Store{+f2, c}:
      %pf.some_inj(Nat, 0n, f2, f, e) : pf.Lead(fl, ld, _)
      g
    case F.Land{+f2, o}:
      (lead, kept) = g
      %pf.some_inj(Nat, 0n, f2, f, e) : pf.Lead(fl, ld, _)
      lead
    case F.Waiting{f2}:
      pf.none_some(Nat, pf.Lead(fl, ld, f), f, e)
    case F.Served{v, o}:
      pf.none_some(Nat, pf.Lead(fl, ld, f), f, e)

def pf.joins.go(+c: Nat, +fr: Bool, fl: Bool, +ld: List<&2, F.Out>, +n: Nat, +cs: List<&2, F.Leg>, +f: Nat, +k: Nat, +ok: Bool, lead: pf.Lead(fl, ld, f), +boards: {List.get(&2, F.Leg, cs, k) == Some{F.Board{}} : Maybe<&2, F.Leg>}) -> {List.get(&2, F.Leg, F.St.cs(F.step(F.St{F.W{F.Sto{c, fr}, fl, ld, n}, cs}, F.Step{k, ok})), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}:
  match fl:
    case True{}:
      (efl, ef) = lead
      %Equal.sym(Maybe<&2, F.Leg>, List.get(&2, F.Leg, cs, k), Some{F.Board{}}, boards) : {List.get(&2, F.Leg, F.St.cs(F.step.at(_, k, ok, F.W{F.Sto{c, fr}, True{}, ld, n}, cs)), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}
      %Equal.sym(Nat, f, List.length(&2, F.Out, ld), ef) : {List.get(&2, F.Leg, List.append(&2, F.Leg, List.take(&2, F.Leg, cs, k), F.Waiting{List.length(&2, F.Out, ld)} <> List.drop(&2, F.Leg, cs, 1n+k)), k) == Some{F.Waiting{_}} : Maybe<&2, F.Leg>}
      pf.get_put(F.Leg, cs, k, F.Board{}, F.Waiting{List.length(&2, F.Out, ld)}, boards)
    case False{}:
      (efl, ef) = lead
      auth_flight.pf.absurdF({List.get(&2, F.Leg, F.St.cs(F.step(F.St{F.W{F.Sto{c, fr}, False{}, ld, n}, cs}, F.Step{k, ok})), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}, efl)

def pf.joins(s: F.St, inv: auth_flight.pf.Inv(s), +j: Nat, +lj: F.Leg, +f: Nat, leads: {List.get(&2, F.Leg, F.St.cs(s), j) == Some{lj} : Maybe<&2, F.Leg>}, flight: {F.led(lj) == Some{f} : Maybe<&2, Nat>}, +k: Nat, +ok: Bool, boards: {List.get(&2, F.Leg, F.St.cs(s), k) == Some{F.Board{}} : Maybe<&2, F.Leg>}) -> {List.get(&2, F.Leg, F.St.cs(F.step(s, F.Step{k, ok})), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}:
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{sto, +fl, +ld, +n}:
          match sto:
            case F.Sto{+c, +fr}:
              (cnt, all) = inv
              pf.joins.go(c, fr, fl, ld, n, cs, f, k, ok, pf.led_lead(F.Sto{c, fr}, fl, ld, n, lj, f, flight, pf.all_get(F.W{F.Sto{c, fr}, fl, ld, n}, cs, j, lj, leads, all)), boards)

def pf.got(s: F.St, inv: auth_flight.pf.Inv(s), +k: Nat, +f: Nat, +o: F.Out, served: {List.get(&2, F.Leg, F.St.cs(s), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}) -> {List.get(&2, F.Out, F.W.landed(F.St.w(s)), f) == Some{o} : Maybe<&2, F.Out>}:
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{+sto, +fl, +ld, +n}:
          (cnt, all) = inv
          pf.all_get(F.W{sto, fl, ld, n}, cs, k, F.Served{Some{f}, o}, served, all)

def pf.landed_serves(s: F.St, +k: Nat, +f: Nat, +o: F.Out, +ok: Bool, +waits: {List.get(&2, F.Leg, F.St.cs(s), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}, landed: {List.get(&2, F.Out, F.W.landed(F.St.w(s)), f) == Some{o} : Maybe<&2, F.Out>}) -> {List.get(&2, F.Leg, F.St.cs(F.step(s, F.Step{k, ok})), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}:
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{sto, +fl, +ld, +n}:
          match sto:
            case F.Sto{+c, +fr}:
              %Equal.sym(Maybe<&2, F.Leg>, List.get(&2, F.Leg, cs, k), Some{F.Waiting{f}}, waits) : {List.get(&2, F.Leg, F.St.cs(F.step.at(_, k, ok, F.W{F.Sto{c, fr}, fl, ld, n}, cs)), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}
              %Equal.sym(Maybe<&2, F.Out>, List.get(&2, F.Out, ld, f), Some{o}, landed) : {List.get(&2, F.Leg, F.St.cs(F.put(k, F.adv.wait.got(f, _, F.W{F.Sto{c, fr}, fl, ld, n}), cs)), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}
              pf.get_put(F.Leg, cs, k, F.Waiting{f}, F.Served{Some{f}, o}, waits)

def pf.stored(s: F.St, inv: auth_flight.pf.Inv(s), +k: Nat, +f: Nat, +c: Nat, +lands: {List.get(&2, F.Leg, F.St.cs(s), k) == Some{F.Land{f, F.Ok{c}}} : Maybe<&2, F.Leg>}, +ok: Bool) -> {F.le(c, F.Sto.c(F.W.sto(F.St.w(F.step(s, F.Step{k, ok}))))) == True{} : Bool}:
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{sto, +fl, +ld, +n}:
          match sto:
            case F.Sto{+c2, +fr}:
              (cnt, all) = inv
              %Equal.sym(Maybe<&2, F.Leg>, List.get(&2, F.Leg, cs, k), Some{F.Land{f, F.Ok{c}}}, lands) : {F.le(c, F.Sto.c(F.W.sto(F.St.w(F.step.at(_, k, ok, F.W{F.Sto{c2, fr}, fl, ld, n}, cs))))) == True{} : Bool}
              pf.snd(pf.Lead(fl, ld, f), pf.Kept(F.Ok{c}, F.Sto{c2, fr}), pf.all_get(F.W{F.Sto{c2, fr}, fl, ld, n}, cs, k, F.Land{f, F.Ok{c}}, lands, all))

def pf.after_of.load(+c2: Nat, +fl: Bool, +ld: List<&2, F.Out>, +n: Nat, +cs: List<&2, F.Leg>, +ok: Bool) -> {List.get(&2, F.Leg, F.St.cs(F.step.at(List.get(&2, F.Leg, List.append(&2, F.Leg, cs, [F.Load{}]), List.length(&2, F.Leg, cs)), List.length(&2, F.Leg, cs), ok, F.W{F.Sto{c2, True{}}, fl, ld, n}, List.append(&2, F.Leg, cs, [F.Load{}]))), List.length(&2, F.Leg, cs)) == Some{F.Served{None{}, F.Ok{c2}}} : Maybe<&2, F.Leg>}:
  %Equal.sym(Maybe<&2, F.Leg>, List.get(&2, F.Leg, List.append(&2, F.Leg, cs, [F.Load{}]), List.length(&2, F.Leg, cs)), Some{F.Load{}}, pf.get_snoc(F.Leg, cs, F.Load{})) : {List.get(&2, F.Leg, F.St.cs(F.step.at(_, List.length(&2, F.Leg, cs), ok, F.W{F.Sto{c2, True{}}, fl, ld, n}, List.append(&2, F.Leg, cs, [F.Load{}]))), List.length(&2, F.Leg, cs)) == Some{F.Served{None{}, F.Ok{c2}}} : Maybe<&2, F.Leg>}
  pf.get_put(F.Leg, List.append(&2, F.Leg, cs, [F.Load{}]), List.length(&2, F.Leg, cs), F.Load{}, F.Served{None{}, F.Ok{c2}}, pf.get_snoc(F.Leg, cs, F.Load{}))

# a caller that arrives while the store is fresh is served it
def pf.after_of(+c: Nat, s: F.St, +ok: Bool, fresh: {F.Sto.fresh(F.W.sto(F.St.w(s))) == True{} : Bool}, kept: {F.le(c, F.Sto.c(F.W.sto(F.St.w(s)))) == True{} : Bool}) -> F.After(c, s, ok):
  match s:
    case F.St{w, +cs}:
      match w:
        case F.W{sto, +fl, +ld, +n}:
          match sto:
            case F.Sto{+c2, fr}:
              match fr:
                case True{}:
                  (pf.after_of.load(c2, fl, ld, n, cs, ok), kept)
                case False{}:
                  auth_flight.pf.absurdF(F.After(c, F.St{F.W{F.Sto{c2, False{}}, fl, ld, n}, cs}, ok), fresh)

# The laws, for PROOF.bend
# ------------------------

def pf.flight_one_fetch(+evs: List<&2, F.Ev>) -> {F.le(F.fetching(F.St.cs(F.run(evs))), 1n) == True{} : Bool}:
  pf.one_fetch(F.run(evs), pf.inv_run(evs))

def pf.flight_board_joins(+evs: List<&2, F.Ev>, +j: Nat, +lj: F.Leg, +f: Nat, leads: {List.get(&2, F.Leg, F.St.cs(F.run(evs)), j) == Some{lj} : Maybe<&2, F.Leg>}, flight: {F.led(lj) == Some{f} : Maybe<&2, Nat>}, +k: Nat, +ok: Bool, boards: {List.get(&2, F.Leg, F.St.cs(F.run(evs)), k) == Some{F.Board{}} : Maybe<&2, F.Leg>}) -> {List.get(&2, F.Leg, F.St.cs(F.step(F.run(evs), F.Step{k, ok})), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}:
  pf.joins(F.run(evs), pf.inv_run(evs), j, lj, f, leads, flight, k, ok, boards)

def pf.flight_callers_get_its_outcome(+evs: List<&2, F.Ev>, +k: Nat, +f: Nat, +o: F.Out, served: {List.get(&2, F.Leg, F.St.cs(F.run(evs)), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}) -> {List.get(&2, F.Out, F.W.landed(F.St.w(F.run(evs))), f) == Some{o} : Maybe<&2, F.Out>}:
  pf.got(F.run(evs), pf.inv_run(evs), k, f, o, served)

def pf.flight_landed_serves(+s: F.St, +k: Nat, +f: Nat, +o: F.Out, +ok: Bool, waits: {List.get(&2, F.Leg, F.St.cs(s), k) == Some{F.Waiting{f}} : Maybe<&2, F.Leg>}, landed: {List.get(&2, F.Out, F.W.landed(F.St.w(s)), f) == Some{o} : Maybe<&2, F.Out>}) -> {List.get(&2, F.Leg, F.St.cs(F.step(s, F.Step{k, ok})), k) == Some{F.Served{Some{f}, o}} : Maybe<&2, F.Leg>}:
  pf.landed_serves(s, k, f, o, ok, waits, landed)

def pf.flight_after_end_stored(+evs: List<&2, F.Ev>, +k: Nat, +f: Nat, +c: Nat, lands: {List.get(&2, F.Leg, F.St.cs(F.run(evs)), k) == Some{F.Land{f, F.Ok{c}}} : Maybe<&2, F.Leg>}, +ok: Bool) -> {F.le(c, F.Sto.c(F.W.sto(F.St.w(F.step(F.run(evs), F.Step{k, ok}))))) == True{} : Bool}:
  pf.stored(F.run(evs), pf.inv_run(evs), k, f, c, lands, ok)

def pf.flight_after_end_served(+evs: List<&2, F.Ev>, +k: Nat, +f: Nat, +c: Nat, lands: {List.get(&2, F.Leg, F.St.cs(F.run(evs)), k) == Some{F.Land{f, F.Ok{c}}} : Maybe<&2, F.Leg>}, +ok: Bool, +ok2: Bool, fresh: {F.Sto.fresh(F.W.sto(F.St.w(F.step(F.run(evs), F.Step{k, ok})))) == True{} : Bool}) -> F.After(c, F.step(F.run(evs), F.Step{k, ok}), ok2):
  pf.after_of(c, F.step(F.run(evs), F.Step{k, ok}), ok2, fresh, pf.stored(F.run(evs), pf.inv_run(evs), k, f, c, lands, ok))

# ---- themes ----

# proof_themes: the T1 laws (docs/interface.md Themes) of the theme model
# in bend/theme.bend.
#
# Resolution scans the candidates in order: a candidate that does not
# resolve the name passes the scan on, so before the first one that does
# the scan finds nothing, and with none at all it ends at the default
# theme with a warning. A loaded file passed the validity check. The
# validity check asks of each token what its fill needs, so the fill of
# every token of a valid file has a value. The mode and the palette read
# only the colors and the export page, never the name. The shipped
# themes' contrasts and 256-color indices are finite: the checker
# computes them.

# Logic
# -----

def themes.pt.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def themes.pt.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : themes.pt.BD(_, A, Unit)
  Unit{}

def themes.pt.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      themes.pt.absurdF({False{} == True{} : Bool}, h)

def themes.pt.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      themes.pt.absurdF({b == True{} : Bool}, h)

def themes.pt.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pt.or_false_l(c: Bool, +d: Bool, h: {Bool.or(c, d) == False{} : Bool}) -> {c == False{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      {==}

def themes.pt.or_false_r(c: Bool, +d: Bool, h: {Bool.or(c, d) == False{} : Bool}) -> {d == False{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(Bool, True{}, False{}, h) : themes.pt.BD(_, {d == False{} : Bool}, Unit)
      Unit{}
    case False{}:
      h

# Resolution
# ----------

# a scan of candidates none of which resolves n ends at the default theme,
# with a warning
def pt.find_miss(+src: List<&2, T.Cand>, +n: String, +miss: {T.hit(src, n) == False{} : Bool}) -> {T.find(src, n) == T.Res{T.dflt(), True{}} : T.Res}:
  match src:
    case Nil{}:
      {==}
    case Con{T.Cand{nm, v, id}, rest}:
      +here = pt.or_false_l(T.names(T.Cand{nm, v, id}, n), T.hit(rest, n), miss)
      %Equal.sym(Bool, T.names(T.Cand{nm, v, id}, n), False{}, here) : {T.find.pick(_, id, T.find(rest, n)) == T.Res{T.dflt(), True{}} : T.Res}
      pt.find_miss(rest, n, themes.pt.or_false_r(T.names(T.Cand{nm, v, id}, n), T.hit(rest, n), miss))

# a scan whose candidates before c do not resolve n finds c
def pt.find_first(+pre: List<&2, T.Cand>, +nm: String, +id: U32, +post: List<&2, T.Cand>, +n: String, +miss: {T.hit(pre, n) == False{} : Bool}, same: {String.eq(nm, n) == True{} : Bool})
  -> {T.find(List.append(&2, T.Cand, pre, T.Cand{nm, True{}, id} <> post), n) == T.Res{id, False{}} : T.Res}:
  match pre:
    case Nil{}:
      %Equal.sym(Bool, String.eq(nm, n), True{}, same) : {T.find.pick(Bool.and(True{}, _), id, T.find(post, n)) == T.Res{id, False{}} : T.Res}
      {==}
    case Con{T.Cand{pn, pv, pid}, rest}:
      +here = pt.or_false_l(T.names(T.Cand{pn, pv, pid}, n), T.hit(rest, n), miss)
      %Equal.sym(Bool, T.names(T.Cand{pn, pv, pid}, n), False{}, here) : {T.find.pick(_, pid, T.find(List.append(&2, T.Cand, rest, T.Cand{nm, True{}, id} <> post), n)) == T.Res{id, False{}} : T.Res}
      pt.find_first(rest, nm, id, post, n, themes.pt.or_false_r(T.names(T.Cand{pn, pv, pid}, n), T.hit(rest, n), miss), same)

def theme_resolve_empty(src: List<&2, T.Cand>) -> {T.resolve.name(src, "") == T.Res{T.dflt(), False{}} : T.Res}:
  {==}

def theme_resolve_first(+pre: List<&2, T.Cand>, +nm: String, +id: U32, +post: List<&2, T.Cand>, +n: String, ne: {String.is_empty(n) == False{} : Bool}, miss: {T.hit(pre, n) == False{} : Bool}, same: {String.eq(nm, n) == True{} : Bool})
  -> {T.resolve.name(List.append(&2, T.Cand, pre, T.Cand{nm, True{}, id} <> post), n) == T.Res{id, False{}} : T.Res}:
  %Equal.sym(Bool, String.is_empty(n), False{}, ne) : {T.resolve.name.pick(_, List.append(&2, T.Cand, pre, T.Cand{nm, True{}, id} <> post), n) == T.Res{id, False{}} : T.Res}
  pt.find_first(pre, nm, id, post, n, miss, same)

def theme_resolve_missing(+src: List<&2, T.Cand>, +n: String, ne: {String.is_empty(n) == False{} : Bool}, miss: {T.hit(src, n) == False{} : Bool})
  -> {T.resolve.name(src, n) == T.Res{T.dflt(), True{}} : T.Res}:
  %Equal.sym(Bool, String.is_empty(n), False{}, ne) : {T.resolve.name.pick(_, src, n) == T.Res{T.dflt(), True{}} : T.Res}
  pt.find_miss(src, n, miss)

# Loading and completion
# ----------------------

def themes.pt.some_inj(-A: Data, -a: A, -b: A, e: {Some{a} == Some{b} : Maybe<&2, A>}) -> {a == b : A}:
  Equal.cong(Maybe<&2, A>, A, m => T.or_else(A, m, a), Some{a}, Some{b}, e)

def themes.pt.none_some(-A: Type, -B: Data, -b: B, e: {None{} == Some{b} : Maybe<&2, B>}) -> A:
  %e : themes.pt.BD(Maybe.is_some(&2, B, _), A, Unit)
  Unit{}

def pt.keep(ok: Bool, +g: T.Th, -f: T.Th, eo: {T.valid(g) == ok : Bool}, h: {T.load.keep(ok, g) == Some{f} : Maybe<&2, T.Th>}) -> {T.valid(f) == True{} : Bool}:
  match ok:
    case True{}:
      %themes.pt.some_inj(T.Th, g, f, h) : {T.valid(_) == True{} : Bool}
      eo
    case False{}:
      themes.pt.none_some({T.valid(f) == True{} : Bool}, T.Th, f, h)

def pt.check(+name: String, +cs: Maybe<&2, List<&2, T.Ent>>, +pg: Maybe<&2, Maybe<&2, Co.Rgb>>, -f: T.Th, h: {T.load.check(name, cs, pg) == Some{f} : Maybe<&2, T.Th>}) -> {T.valid(f) == True{} : Bool}:
  match cs pg:
    case Some{c} Some{p}:
      pt.keep(T.valid(T.Th{name, c, p}), T.Th{name, c, p}, f, {==}, h)
    case Some{c} None{}:
      themes.pt.none_some({T.valid(f) == True{} : Bool}, T.Th, f, h)
    case None{} Some{p}:
      themes.pt.none_some({T.valid(f) == True{} : Bool}, T.Th, f, h)
    case None{} None{}:
      themes.pt.none_some({T.valid(f) == True{} : Bool}, T.Th, f, h)

def theme_load_valid(r: T.RFile, -f: T.Th, loaded: {T.load(r) == Some{f} : Maybe<&2, T.Th>}) -> {T.valid(f) == True{} : Bool}:
  match r:
    case T.RFile{name, +vars, cols, page}:
      pt.check(name, T.resolve.cols(vars, cols), T.load.page(vars, page), f, loaded)

def pt.or_some(a: Maybe<&2, T.Val>, +b: Maybe<&2, T.Val>, h: {Bool.or(Maybe.is_some(&2, T.Val, a), Maybe.is_some(&2, T.Val, b)) == True{} : Bool})
  -> {Maybe.is_some(&2, T.Val, T.or(T.Val, a, b)) == True{} : Bool}:
  match a:
    case None{}:
      h
    case Some{x}:
      {==}

def pt.fill_some(k: T.Role, +cols: List<&2, T.Ent>, +bg: Co.Rgb, +t: U32, h: {T.ok.k(k, cols, t) == True{} : Bool})
  -> {Maybe.is_some(&2, T.Val, T.fill.k(k, cols, bg, t)) == True{} : Bool}:
  match k:
    case T.Req{}:
      h
    case T.MdBody{}:
      pt.or_some(T.get(cols, t), T.get(cols, 9), h)
    case T.RefHeader{}:
      {==}
    case T.RefSummary{}:
      {==}
    case T.Background{}:
      {==}
    case T.Foreground{}:
      {==}

def pt.complete(+cols: List<&2, T.Ent>, +bg: Co.Rgb, +ts: List<&2, U32>, +h: {T.valid.go(cols, ts) == True{} : Bool})
  -> {T.complete(T.fill.map(cols, bg, ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+t, rest}:
      +here = pt.fill_some(T.kind(t), cols, bg, t, themes.pt.and_l(T.ok(cols, t), T.valid.go(cols, rest), h))
      +more = pt.complete(cols, bg, rest, themes.pt.and_r(T.ok(cols, t), T.valid.go(cols, rest), h))
      themes.pt.and_t(Maybe.is_some(&2, T.Val, T.fill(cols, bg, t)), T.complete(T.fill.map(cols, bg, rest)), here, more)

def theme_tokens_complete(f: T.Th, v: {T.valid(f) == True{} : Bool}) -> {T.complete(T.palette(f)) == True{} : Bool}:
  match f:
    case T.Th{name, +cols, +page}:
      pt.complete(cols, T.background(cols, page), T.toks(), v)

# Modes and names
# ---------------

def pt.light_bg(f: T.Th) -> {T.light(f) == Co.light(T.bg(f)) : Bool}:
  match f:
    case T.Th{name, cols, page}:
      {==}

def theme_mode_background(f: T.Th, g: T.Th, same: {T.bg(f) == T.bg(g) : Co.Rgb}) -> {T.light(f) == T.light(g) : Bool}:
  +lf = pt.light_bg(f)
  +lg = pt.light_bg(g)
  %Equal.sym(Bool, T.light(f), Co.light(T.bg(f)), lf) : {_ == T.light(g) : Bool}
  %Equal.sym(Bool, T.light(g), Co.light(T.bg(g)), lg) : {Co.light(T.bg(f)) == _ : Bool}
  Equal.cong(Co.Rgb, Bool, c => Co.light(c), T.bg(f), T.bg(g), same)

def theme_palette_name_free(f: T.Th, n: String) -> {T.palette(T.rename(f, n)) == T.palette(f) : List<&2, Maybe<&2, T.Val>>}:
  match f:
    case T.Th{name, cols, page}:
      {==}

def theme_mode_name_free(f: T.Th, n: String) -> {T.light(T.rename(f, n)) == T.light(f) : Bool}:
  match f:
    case T.Th{name, cols, page}:
      {==}

# Shipped themes
# --------------

def theme_shipped_legible(s: T.Shipped) -> {T.legible(T.table(s)) == True{} : Bool}:
  match s:
    case T.Eukhe{}:
      {==}
    case T.Dark{}:
      {==}
    case T.Light{}:
      {==}

def theme_shipped_status_distinct(s: T.Shipped) -> {T.status_distinct(T.table(s)) == True{} : Bool}:
  match s:
    case T.Eukhe{}:
      {==}
    case T.Dark{}:
      {==}
    case T.Light{}:
      {==}

# ---- tokens ----

# proof_tokens: the T2 laws (docs/dashboard.md "Tokens") of the token
# model in bend/tokens.bend.
#
# The tables are constants, so each claim about them computes: the
# lookup of every tone in each mode, the readable test of the pair list
# in each mode (bend/color.bend's exact contrast), and the ascent of each
# scale. A pair taken from the list (pairs = pre ++ [p] ++ post) is
# readable because the whole list is: `pt.pick` walks pre.

# Logic
# -----

def tokens.pt.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def tokens.pt.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : tokens.pt.BD(_, A, Unit)
  Unit{}

def tokens.pt.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      tokens.pt.absurdF({False{} == True{} : Bool}, h)

def tokens.pt.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      tokens.pt.absurdF({b == True{} : Bool}, h)

# The palette
# -----------

def pt.paired_light(t: Tk.Tone) -> {Maybe.is_some(&2, Tk.Col, Tk.find(t, Tk.palette(Tk.Light{}))) == True{} : Bool}:
  match t:
    case Tk.Bg{}:
      {==}
    case Tk.Sidebar{}:
      {==}
    case Tk.Raised{}:
      {==}
    case Tk.Surface{}:
      {==}
    case Tk.Hover{}:
      {==}
    case Tk.Primary{}:
      {==}
    case Tk.Secondary{}:
      {==}
    case Tk.Tertiary{}:
      {==}
    case Tk.Hairline{}:
      {==}
    case Tk.Scrim{}:
      {==}
    case Tk.Danger{}:
      {==}
    case Tk.Selection{}:
      {==}
    case Tk.Scrollbar{}:
      {==}
    case Tk.ShadowNear{}:
      {==}
    case Tk.ShadowFar{}:
      {==}
    case Tk.ShadowDrawer{}:
      {==}
    case Tk.ShadowLatest{}:
      {==}

def pt.paired_dark(t: Tk.Tone) -> {Maybe.is_some(&2, Tk.Col, Tk.find(t, Tk.palette(Tk.Dark{}))) == True{} : Bool}:
  match t:
    case Tk.Bg{}:
      {==}
    case Tk.Sidebar{}:
      {==}
    case Tk.Raised{}:
      {==}
    case Tk.Surface{}:
      {==}
    case Tk.Hover{}:
      {==}
    case Tk.Primary{}:
      {==}
    case Tk.Secondary{}:
      {==}
    case Tk.Tertiary{}:
      {==}
    case Tk.Hairline{}:
      {==}
    case Tk.Scrim{}:
      {==}
    case Tk.Danger{}:
      {==}
    case Tk.Selection{}:
      {==}
    case Tk.Scrollbar{}:
      {==}
    case Tk.ShadowNear{}:
      {==}
    case Tk.ShadowFar{}:
      {==}
    case Tk.ShadowDrawer{}:
      {==}
    case Tk.ShadowLatest{}:
      {==}

def tokens_paired(t: Tk.Tone, m: Tk.Mode) -> {Maybe.is_some(&2, Tk.Col, Tk.find(t, Tk.palette(m))) == True{} : Bool}:
  match m:
    case Tk.Light{}:
      pt.paired_light(t)
    case Tk.Dark{}:
      pt.paired_dark(t)

# Legibility
# ----------

# every pair of the list is readable, in each mode
def pt.all_readable(m: Tk.Mode) -> {Tk.readable.all(m, Tk.pairs()) == True{} : Bool}:
  match m:
    case Tk.Light{}:
      {==}
    case Tk.Dark{}:
      {==}

# a pair of a readable list is readable
def tokens.pt.pick(+m: Tk.Mode, +pre: List<&2, Tk.Ink>, +p: Tk.Ink, +post: List<&2, Tk.Ink>, h: {Tk.readable.all(m, List.append(&2, Tk.Ink, pre, p <> post)) == True{} : Bool}) -> {Tk.readable(m, p) == True{} : Bool}:
  match pre:
    case Nil{}:
      tokens.pt.and_l(Tk.readable(m, p), Tk.readable.all(m, post), h)
    case Con{+q, +rest}:
      tokens.pt.pick(m, rest, p, post, tokens.pt.and_r(Tk.readable(m, q), Tk.readable.all(m, List.append(&2, Tk.Ink, rest, p <> post)), h))

# the split list is the pair list, which is readable
def pt.whole(+m: Tk.Mode, -pre: List<&2, Tk.Ink>, -p: Tk.Ink, -post: List<&2, Tk.Ink>, split: {Tk.pairs() == List.append(&2, Tk.Ink, pre, p <> post) : List<&2, Tk.Ink>}) -> {Tk.readable.all(m, List.append(&2, Tk.Ink, pre, p <> post)) == True{} : Bool}:
  %split : {Tk.readable.all(m, _) == True{} : Bool}
  pt.all_readable(m)

def tokens_legible(m: Tk.Mode, +pre: List<&2, Tk.Ink>, p: Tk.Ink, +post: List<&2, Tk.Ink>, split: {Tk.pairs() == List.append(&2, Tk.Ink, pre, p <> post) : List<&2, Tk.Ink>}) -> {Tk.readable(m, p) == True{} : Bool}:
  +m1 = m
  +p1 = p
  tokens.pt.pick(m1, pre, p1, post, pt.whole(m1, pre, p1, post, split))

# The scales
# ----------

def tokens_layers_ordered() -> {Tk.ascends(Tk.layers()) == True{} : Bool}:
  {==}

def tokens_space_ascends() -> {Tk.ascends(Tk.space()) == True{} : Bool}:
  {==}

def tokens_type_ascends() -> {Bool.and(Tk.ascends(Tk.sizes()), Tk.ascends(Tk.lines())) == True{} : Bool}:
  {==}

# ---- progress ----

# proof_progress: the progress laws (LAWS.bend section progress) of the model in
# bend/progress.bend.
#
# The ledger only adds an act it does not hold. So reading an act it holds
# changes nothing, every act read is held, and the ledger never shrinks.
# Reading acts the session did before keeps the work (`pp.repeat`);
# reading an act the session never did grows it (`pp.grows`). The goal's
# check sees no growth in a run of repeats, so the count of continuations
# with no new work grows by one at each, and the goal stops at the cap
# (`pp.stops`). The watch reads the same token at each poll of a looping
# child, so each poll is a quiet poll of bend/child.bend, and quiet polls
# end the watch in time (`pc.stalls_in_time`).
#
# A recursive proof takes the value it inspects as a parameter (Bend
# matches only parameters); a split on a computed test goes to a helper
# that takes the test as a parameter, with the recursive result passed in.

# Logic
# -----

def progress.pp.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pp.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : progress.pp.BD(_, Unit, A)
  Unit{}

def pp.or_true_r(a: Bool) -> {Bool.or(a, True{}) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pp.or_ff_l(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      pp.absurdT({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pp.or_ff_r(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      pp.absurdT({b == False{} : Bool}, h)
    case False{}:
      h

# Numbers
# -------

def pp.lt_self(+n: Nat) -> {Nat.is_le(1n+n, n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pp.lt_self(p)

def pp.add_zero(+a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, Nat.add(p, 0n), p, pp.add_zero(p)) : {1n+_ == 1n+p : Nat}
      {==}

def pp.add_succ(+a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, Nat.add(p, 1n+b), 1n+Nat.add(p, b), pp.add_succ(p, b)) : {1n+_ == 2n+Nat.add(p, b) : Nat}
      {==}

# b is not a: a test that sees b at least 1 above a sees them differ
def pp.ne.at(c: Bool, +a: Nat, +b: Nat, e: {Nat.is_eq(a, b) == c : Bool}, lt: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Bool.not(c) == True{} : Bool}:
  match c:
    case True{}:
      pc.lt_ne({Bool.not(True{}) == True{} : Bool}, a, b, lt, e)
    case False{}:
      {==}

def pp.ne(+a: Nat, +b: Nat, lt: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Bool.not(Nat.is_eq(a, b)) == True{} : Bool}:
  pp.ne.at(Nat.is_eq(a, b), a, b, {==}, lt)

# The ledger
# ----------

def pp.app_ledger(a: List<&2, Nat>, +b: List<&2, Nat>, +s: List<&2, Nat>) -> {Pr.ledger(List.append(&2, Nat, a, b), s) == Pr.ledger(b, Pr.ledger(a, s)) : List<&2, Nat>}:
  match a:
    case Nil{}:
      {==}
    case +h <> +t:
      pp.app_ledger(t, b, Pr.add(s, h))

# adding an act the ledger holds changes nothing
def pp.add_hit(+s: List<&2, Nat>, +x: Nat, m: {Pr.mem(x, s) == True{} : Bool}) -> {Pr.add(s, x) == s : List<&2, Nat>}:
  %Equal.sym(Bool, Pr.mem(x, s), True{}, m) : {Pr.add.put(_, x, s) == s : List<&2, Nat>}
  {==}

# adding an act the ledger does not hold puts it in front
def pp.add_new(+s: List<&2, Nat>, +x: Nat, m: {Pr.mem(x, s) == False{} : Bool}) -> {Pr.add(s, x) == x <> s : List<&2, Nat>}:
  %Equal.sym(Bool, Pr.mem(x, s), False{}, m) : {Pr.add.put(_, x, s) == x <> s : List<&2, Nat>}
  {==}

# every act of xs is held by s
def pp.Held(xs: List<&2, Nat>, +s: List<&2, Nat>) -> Type:
  match xs:
    case Nil{}:
      Unit
    case +h <> +t:
      {Pr.mem(h, s) == True{} : Bool} & pp.Held(t, s)

# reading acts the ledger holds changes nothing
def pp.ledger_held(xs: List<&2, Nat>, +s: List<&2, Nat>, held: pp.Held(xs, s)) -> {Pr.ledger(xs, s) == s : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      (m, rest) = held
      %Equal.sym(List<&2, Nat>, Pr.add(s, h), s, pp.add_hit(s, h, m)) : {Pr.ledger(t, _) == s : List<&2, Nat>}
      pp.ledger_held(t, s, rest)

def pp.mem_put(b: Bool, +s: List<&2, Nat>, +x: Nat, +y: Nat, m: {Pr.mem(y, s) == True{} : Bool}) -> {Pr.mem(y, Pr.add.put(b, x, s)) == True{} : Bool}:
  match b:
    case True{}:
      m
    case False{}:
      %Equal.sym(Bool, Pr.mem(y, s), True{}, m) : {Bool.or(Nat.is_eq(x, y), _) == True{} : Bool}
      pp.or_true_r(Nat.is_eq(x, y))

# an act the ledger holds stays held after reading xs
def pp.mem_ledger(xs: List<&2, Nat>, +s: List<&2, Nat>, +y: Nat, m: {Pr.mem(y, s) == True{} : Bool}) -> {Pr.mem(y, Pr.ledger(xs, s)) == True{} : Bool}:
  match xs:
    case Nil{}:
      m
    case +h <> +t:
      pp.mem_ledger(t, Pr.add(s, h), y, pp.mem_put(Pr.mem(h, s), s, h, y, m))

def pp.mem_self.at(b: Bool, +s: List<&2, Nat>, +x: Nat, e: {Pr.mem(x, s) == b : Bool}) -> {Pr.mem(x, Pr.add.put(b, x, s)) == True{} : Bool}:
  match b:
    case True{}:
      e
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(x, x), True{}, child.pc.eq_refl(x)) : {Bool.or(_, Pr.mem(x, s)) == True{} : Bool}
      {==}

# an act read is held
def pp.in_ledger(xs: List<&2, Nat>, +s: List<&2, Nat>, +x: Nat, i: Pr.In(x, xs)) -> {Pr.mem(x, Pr.ledger(xs, s)) == True{} : Bool}:
  match xs:
    case Nil{}:
      match i:
    case +h <> +t:
      match i:
        case Inl{eq}:
          %Equal.sym(Nat, x, h, eq) : {Pr.mem(_, Pr.ledger(t, Pr.add(s, h))) == True{} : Bool}
          pp.mem_ledger(t, Pr.add(s, h), h, pp.mem_self.at(Pr.mem(h, s), s, h, {==}))
        case Inr{it}:
          pp.in_ledger(t, Pr.add(s, h), x, it)

# the acts of a list within seen are held by the ledger of seen
def pp.held_of(xs: List<&2, Nat>, +seen: List<&2, Nat>, w: Pr.Within(xs, seen)) -> pp.Held(xs, Pr.ledger(seen, Nil{})):
  match xs:
    case Nil{}:
      Unit{}
    case +h <> +t:
      (i, rest) = w
      (pp.in_ledger(seen, Nil{}, h, i), pp.held_of(t, seen, rest))

# reading again acts the session did before keeps its work
def pp.repeat(+seen: List<&2, Nat>, +loop: List<&2, Nat>, w: Pr.Within(loop, seen)) -> {Pr.work(List.append(&2, Nat, seen, loop)) == Pr.work(seen) : Nat}:
  +l = Pr.ledger(seen, Nil{})
  %Equal.sym(List<&2, Nat>, Pr.ledger(List.append(&2, Nat, seen, loop), Nil{}), Pr.ledger(loop, l), pp.app_ledger(seen, loop, Nil{})) : {List.length(&2, Nat, _) == List.length(&2, Nat, l) : Nat}
  %Equal.sym(List<&2, Nat>, Pr.ledger(loop, l), l, pp.ledger_held(loop, l, pp.held_of(loop, seen, w))) : {List.length(&2, Nat, _) == List.length(&2, Nat, l) : Nat}
  {==}

# Growth
# ------

def pp.len_put(b: Bool, +s: List<&2, Nat>, +x: Nat) -> {Nat.is_le(List.length(&2, Nat, s), List.length(&2, Nat, Pr.add.put(b, x, s))) == True{} : Bool}:
  match b:
    case True{}:
      child.pc.le_refl(List.length(&2, Nat, s))
    case False{}:
      pc.le_succ(List.length(&2, Nat, s), List.length(&2, Nat, s), child.pc.le_refl(List.length(&2, Nat, s)))

# the ledger never shrinks
def pp.len_ledger(xs: List<&2, Nat>, +s: List<&2, Nat>) -> {Nat.is_le(List.length(&2, Nat, s), List.length(&2, Nat, Pr.ledger(xs, s))) == True{} : Bool}:
  match xs:
    case Nil{}:
      child.pc.le_refl(List.length(&2, Nat, s))
    case +h <> +t:
      +a = Pr.add(s, h)
      child.pc.le_trans(List.length(&2, Nat, s), List.length(&2, Nat, a), List.length(&2, Nat, Pr.ledger(t, a)), pp.len_put(Pr.mem(h, s), s, h), pp.len_ledger(t, a))

# x is held by s, or reading xs grows the ledger past s
def pp.Grown(+x: Nat, +s: List<&2, Nat>, +r: List<&2, Nat>) -> Type:
  Or({Pr.mem(x, s) == True{} : Bool}, {Nat.is_le(1n+List.length(&2, Nat, s), List.length(&2, Nat, r)) == True{} : Bool})

# x is the act h read now: held before, or new and so the ledger grows
def pp.grown_now.at(b: Bool, +x: Nat, +s: List<&2, Nat>, +r: List<&2, Nat>, e: {Pr.mem(x, s) == b : Bool}, le: {Nat.is_le(List.length(&2, Nat, Pr.add.put(b, x, s)), List.length(&2, Nat, r)) == True{} : Bool}) -> pp.Grown(x, s, r):
  match b:
    case True{}:
      Inl{e}
    case False{}:
      Inr{le}

# x was held by the ledger after h; then it was held before, or it is h
def pp.grown_was.eq(c: Bool, +x: Nat, +h: Nat, +s: List<&2, Nat>, +r: List<&2, Nat>, e: {Nat.is_eq(h, x) == c : Bool}, m: {Bool.or(c, Pr.mem(x, s)) == True{} : Bool}, le: {Nat.is_le(List.length(&2, Nat, h <> s), List.length(&2, Nat, r)) == True{} : Bool}) -> pp.Grown(x, s, r):
  match c:
    case True{}:
      Inr{le}
    case False{}:
      Inl{m}

def pp.grown_was.at(b: Bool, +x: Nat, +h: Nat, +s: List<&2, Nat>, +r: List<&2, Nat>, m: {Pr.mem(x, Pr.add.put(b, h, s)) == True{} : Bool}, le: {Nat.is_le(List.length(&2, Nat, Pr.add.put(b, h, s)), List.length(&2, Nat, r)) == True{} : Bool}) -> pp.Grown(x, s, r):
  match b:
    case True{}:
      Inl{m}
    case False{}:
      pp.grown_was.eq(Nat.is_eq(h, x), x, h, s, r, {==}, m, le)

# the ledger after h grew past r, so past s
def pp.grown_past(+x: Nat, +s: List<&2, Nat>, +a: List<&2, Nat>, +r: List<&2, Nat>, sa: {Nat.is_le(List.length(&2, Nat, s), List.length(&2, Nat, a)) == True{} : Bool}, g: pp.Grown(x, a, r), back: {Pr.mem(x, a) == True{} : Bool} -> pp.Grown(x, s, r)) -> pp.Grown(x, s, r):
  match g:
    case Inl{m}:
      back(m)
    case Inr{le}:
      Inr{child.pc.le_trans(1n+List.length(&2, Nat, s), 1n+List.length(&2, Nat, a), List.length(&2, Nat, r), sa, le)}

# an act x of xs is held by s, or reading xs grows the ledger past s
def pp.grows(xs: List<&2, Nat>, +s: List<&2, Nat>, +x: Nat, i: Pr.In(x, xs)) -> pp.Grown(x, s, Pr.ledger(xs, s)):
  match xs:
    case Nil{}:
      match i:
    case +h <> +t:
      match i:
        case Inl{eq}:
          %Equal.sym(Nat, x, h, eq) : pp.Grown(_, s, Pr.ledger(t, Pr.add(s, h)))
          pp.grown_now.at(Pr.mem(h, s), h, s, Pr.ledger(t, Pr.add(s, h)), {==}, pp.len_ledger(t, Pr.add(s, h)))
        case Inr{it}:
          pp.grown_past(x, s, Pr.add(s, h), Pr.ledger(t, Pr.add(s, h)), pp.len_put(Pr.mem(h, s), s, h), pp.grows(t, Pr.add(s, h), x, it), m => pp.grown_was.at(Pr.mem(h, s), x, h, s, Pr.ledger(t, Pr.add(s, h)), m, pp.len_ledger(t, Pr.add(s, h))))

# a grown ledger past a ledger that does not hold x
def pp.grown_fresh(+x: Nat, +s: List<&2, Nat>, +r: List<&2, Nat>, fresh: {Pr.mem(x, s) == False{} : Bool}, g: pp.Grown(x, s, r)) -> {Nat.is_le(1n+List.length(&2, Nat, s), List.length(&2, Nat, r)) == True{} : Bool}:
  match g:
    case Inl{m}:
      pp.absurdT({Nat.is_le(1n+List.length(&2, Nat, s), List.length(&2, Nat, r)) == True{} : Bool}, Equal.trans(Bool, True{}, Pr.mem(x, s), False{}, Equal.sym(Bool, Pr.mem(x, s), True{}, m), fresh))
    case Inr{le}:
      le

# an act of seg that seen does not hold grows the work
def pp.more(+seen: List<&2, Nat>, +seg: List<&2, Nat>, +x: Nat, fresh: {Pr.mem(x, Pr.ledger(seen, Nil{})) == False{} : Bool}, i: Pr.In(x, seg)) -> {Nat.is_le(1n+Pr.work(seen), Pr.work(List.append(&2, Nat, seen, seg))) == True{} : Bool}:
  +l = Pr.ledger(seen, Nil{})
  %Equal.sym(List<&2, Nat>, Pr.ledger(List.append(&2, Nat, seen, seg), Nil{}), Pr.ledger(seg, l), pp.app_ledger(seen, seg, Nil{})) : {Nat.is_le(1n+List.length(&2, Nat, l), List.length(&2, Nat, _)) == True{} : Bool}
  pp.grown_fresh(x, l, Pr.ledger(seg, l), fresh, pp.grows(seg, l, x, i))

# a fresh act is not held by the ledger
def pp.nmem_put(b: Bool, +s: List<&2, Nat>, +h: Nat, +x: Nat, ne: {Nat.is_eq(h, x) == False{} : Bool}, m: {Pr.mem(x, s) == False{} : Bool}) -> {Pr.mem(x, Pr.add.put(b, h, s)) == False{} : Bool}:
  match b:
    case True{}:
      m
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(h, x), False{}, ne) : {Bool.or(_, Pr.mem(x, s)) == False{} : Bool}
      m

def pp.nmem_ledger(xs: List<&2, Nat>, +s: List<&2, Nat>, +x: Nat, +n: {Pr.mem(x, xs) == False{} : Bool}, m: {Pr.mem(x, s) == False{} : Bool}) -> {Pr.mem(x, Pr.ledger(xs, s)) == False{} : Bool}:
  match xs:
    case Nil{}:
      m
    case +h <> +t:
      pp.nmem_ledger(t, Pr.add(s, h), x, pp.or_ff_r(Nat.is_eq(h, x), Pr.mem(x, t), n), pp.nmem_put(Pr.mem(h, s), s, h, x, pp.or_ff_l(Nat.is_eq(h, x), Pr.mem(x, t), n), m))

# an act of seg the session never did grows the work
def pp.new_work(+seen: List<&2, Nat>, +seg: List<&2, Nat>, +x: Nat, fresh: {Pr.mem(x, seen) == False{} : Bool}, i: Pr.In(x, seg)) -> {Nat.is_le(1n+Pr.work(seen), Pr.work(List.append(&2, Nat, seen, seg))) == True{} : Bool}:
  pp.more(seen, seg, x, pp.nmem_ledger(seen, Nil{}, x, fresh, {==}), i)

# Appending
# ---------

def pp.in_app(+x: Nat, xs: List<&2, Nat>, +more: List<&2, Nat>, i: Pr.In(x, xs)) -> Pr.In(x, List.append(&2, Nat, xs, more)):
  match xs:
    case Nil{}:
      match i:
    case +h <> +t:
      match i:
        case Inl{eq}:
          Inl{eq}
        case Inr{it}:
          Inr{pp.in_app(x, t, more, it)}

def pp.within_app(xs: List<&2, Nat>, +hist: List<&2, Nat>, +more: List<&2, Nat>, w: Pr.Within(xs, hist)) -> Pr.Within(xs, List.append(&2, Nat, hist, more)):
  match xs:
    case Nil{}:
      Unit{}
    case +h <> +t:
      (i, rest) = w
      (pp.in_app(h, hist, more, i), pp.within_app(t, hist, more, rest))

def pp.repeats_app(segs: List<&2, List<&2, Nat>>, +hist: List<&2, Nat>, +more: List<&2, Nat>, r: Pr.Repeats(segs, hist)) -> Pr.Repeats(segs, List.append(&2, Nat, hist, more)):
  match segs:
    case Nil{}:
      Unit{}
    case +seg <> +rest:
      (w, rr) = r
      (pp.within_app(seg, hist, more, w), pp.repeats_app(rest, hist, more, rr))

def pp.loops_app(ps: List<&2, Pr.Peek>, +hist: List<&2, Nat>, +more: List<&2, Nat>, l: Pr.Loops(ps, hist)) -> Pr.Loops(ps, List.append(&2, Nat, hist, more)):
  match ps:
    case Nil{}:
      Unit{}
    case p <> +rest:
      match p:
        case Pr.Peek{+seg, +dt}:
          (w, lr) = l
          (pp.within_app(seg, hist, more, w), pp.loops_app(rest, hist, more, lr))

# The goal's progress check
# -------------------------

# a run of repeats does not grow the work
def pp.grew_no(+hist: List<&2, Nat>, +seg: List<&2, Nat>, w: Pr.Within(seg, hist)) -> {Pr.grew(hist, seg) == False{} : Bool}:
  %Equal.sym(Nat, Pr.work(List.append(&2, Nat, hist, seg)), Pr.work(hist), pp.repeat(hist, seg, w)) : {Nat.is_le(1n+Pr.work(hist), _) == False{} : Bool}
  pp.lt_self(Pr.work(hist))

# new work clears the count
def pp.grew_yes(+cap: Nat, +s: Nat, +hist: List<&2, Nat>, +seg: List<&2, Nat>, +x: Nat, fresh: {Pr.mem(x, hist) == False{} : Bool}, i: Pr.In(x, seg)) -> {Pr.check(cap, s, Pr.grew(hist, seg)) == Pr.Go{0n} : Pr.Goal}:
  %Equal.sym(Bool, Pr.grew(hist, seg), True{}, pp.new_work(hist, seg, x, fresh, i)) : {Pr.check(cap, s, _) == Pr.Go{0n} : Pr.Goal}
  {==}

# the last check: the stalls reach the cap, so the goal stops
def pp.last.at(b: Bool, +cap: Nat, +s: Nat, +h: List<&2, Nat>, e: {Nat.is_le(cap, 1n+s) == b : Bool}, long: {Nat.is_le(cap, 1n+s) == True{} : Bool}) -> {Pr.Goal.stopped(Pr.goal(Nil{}, cap, h, Pr.strike.put(b, 1n+s))) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      pp.absurdT({Pr.Goal.stopped(Pr.goal(Nil{}, cap, h, Pr.Go{1n+s})) == True{} : Bool}, Equal.trans(Bool, True{}, Nat.is_le(cap, 1n+s), False{}, Equal.sym(Bool, Nat.is_le(cap, 1n+s), True{}, long), e))

# a check before the last: the goal stops now, or the next checks stop it
def pp.next.at(b: Bool, +cap: Nat, +s: Nat, +h: List<&2, Nat>, +seg: List<&2, Nat>, +rest: List<&2, List<&2, Nat>>, ih: {Pr.Goal.stopped(Pr.goal(seg <> rest, cap, h, Pr.Go{1n+s})) == True{} : Bool}) -> {Pr.Goal.stopped(Pr.goal(seg <> rest, cap, h, Pr.strike.put(b, 1n+s))) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      ih

# the bound at the last check
def pp.long_last(+cap: Nat, +s: Nat, long: {Nat.is_le(cap, Nat.add(1n+s, 0n)) == True{} : Bool}) -> {Nat.is_le(cap, 1n+s) == True{} : Bool}:
  %pp.add_zero(1n+s) : {Nat.is_le(cap, _) == True{} : Bool}
  long

# the bound after one more check
def pp.long_next(+cap: Nat, +s: Nat, +l: Nat, long: {Nat.is_le(cap, Nat.add(1n+s, 1n+l)) == True{} : Bool}) -> {Nat.is_le(cap, Nat.add(2n+s, l)) == True{} : Bool}:
  %pp.add_succ(s, l) : {Nat.is_le(cap, 1n+_) == True{} : Bool}
  long

# from Go{s}, checks of repeats stop the goal once s + their number
# reaches the cap
def pp.stops(rest: List<&2, List<&2, Nat>>, +seg: List<&2, Nat>, +cap: Nat, +s: Nat, +hist: List<&2, Nat>, r: Pr.Repeats(seg <> rest, hist), long: {Nat.is_le(cap, Nat.add(1n+s, List.length(&2, List<&2, Nat>, rest))) == True{} : Bool}) -> {Pr.Goal.stopped(Pr.goal(seg <> rest, cap, hist, Pr.Go{s})) == True{} : Bool}:
  match rest:
    case Nil{}:
      (w, rr) = r
      %Equal.sym(Bool, Pr.grew(hist, seg), False{}, pp.grew_no(hist, seg, w)) : {Pr.Goal.stopped(Pr.goal(Nil{}, cap, List.append(&2, Nat, hist, seg), Pr.check(cap, s, _))) == True{} : Bool}
      pp.last.at(Nat.is_le(cap, 1n+s), cap, s, List.append(&2, Nat, hist, seg), {==}, pp.long_last(cap, s, long))
    case +seg2 <> +rest2:
      (w, rr) = r
      +h = List.append(&2, Nat, hist, seg)
      %Equal.sym(Bool, Pr.grew(hist, seg), False{}, pp.grew_no(hist, seg, w)) : {Pr.Goal.stopped(Pr.goal(seg2 <> rest2, cap, h, Pr.check(cap, s, _))) == True{} : Bool}
      pp.next.at(Nat.is_le(cap, 1n+s), cap, s, h, seg2, rest2, pp.stops(rest2, seg2, cap, 1n+s, h, pp.repeats_app(seg2 <> rest2, hist, seg, rr), pp.long_next(cap, s, List.length(&2, List<&2, Nat>, rest2), long)))

def pp.goal_stops(+cap: Nat, +s: Nat, +hist: List<&2, Nat>, +seg: List<&2, Nat>, +segs: List<&2, List<&2, Nat>>, r: Pr.Repeats(seg <> segs, hist), long: {Nat.is_le(cap, List.length(&2, List<&2, Nat>, seg <> segs)) == True{} : Bool}) -> {Pr.Goal.stopped(Pr.goal(seg <> segs, cap, hist, Pr.Go{s})) == True{} : Bool}:
  +l = List.length(&2, List<&2, Nat>, segs)
  pp.stops(segs, seg, cap, s, hist, r, child.pc.le_trans(cap, 1n+l, Nat.add(1n+s, l), long, child.pc.le_add(s, l)))

# The subagent watch
# ------------------

# the quiet polls a list of polls is, for bend/child.bend
def pp.sames(ps: List<&2, Pr.Peek>) -> List<&2, Ch.Hush>:
  match ps:
    case Nil{}:
      Nil{}
    case p <> +rest:
      match p:
        case Pr.Peek{seg, dt}:
          Ch.Same{dt} <> pp.sames(rest)

def pp.len_sames(ps: List<&2, Pr.Peek>) -> {List.length(&2, Ch.Hush, pp.sames(ps)) == List.length(&2, Pr.Peek, ps) : Nat}:
  match ps:
    case Nil{}:
      {==}
    case p <> +rest:
      match p:
        case Pr.Peek{seg, dt}:
          %Equal.sym(Nat, List.length(&2, Ch.Hush, pp.sames(rest)), List.length(&2, Pr.Peek, rest), pp.len_sames(rest)) : {1n+_ == 1n+List.length(&2, Pr.Peek, rest) : Nat}
          {==}

# a watching verdict holds token t
def pp.Keep(x: Ch.Next, +t: Maybe<&2, Nat>) -> Data:
  match x:
    case Ch.Watch{w}:
      {Ch.W.tok(w) == t : Maybe<&2, Nat>}
    case Ch.Owe{k}:
      Unit
    case Ch.Quiet{}:
      Unit

def pp.spend_keeps(r: Nat, +tok: Maybe<&2, Nat>, +n: Nat) -> pp.Keep(Ch.spend(r, tok, n), tok):
  match r:
    case 0n:
      Unit{}
    case 1n+p:
      {==}

# a poll that reads the token the watch holds keeps it
def pp.same_keeps(+cfg: Ch.Cfg, w: Ch.W, +e: Nat) -> pp.Keep(Ch.look(cfg, w, e, Ch.Busy{Ch.W.tok(w)}), Ch.W.tok(w)):
  match w:
    case Ch.W{+tok, +l, +n}:
      %pc.moved_self(tok) : pp.Keep(Ch.busy(_, cfg, Ch.W{tok, l, n}, tok, e), tok)
      pp.spend_keeps(Nat.sub(l, e), tok, Ch.Cfg.fails(cfg))

def pp.keep_eq(x: Ch.Next, +a: Maybe<&2, Nat>, +b: Maybe<&2, Nat>, e: {a == b : Maybe<&2, Nat>}, k: pp.Keep(x, a)) -> pp.Keep(x, b):
  %e : pp.Keep(x, _)
  k

# the watch over the polls of a looping child is the watch over quiet polls
def pp.watch_hush(ps: List<&2, Pr.Peek>, +cfg: Ch.Cfg, +hist: List<&2, Nat>, x: Ch.Next, l: Pr.Loops(ps, hist), +inv: pp.Keep(x, Some{Pr.work(hist)})) -> {Pr.watch(ps, cfg, hist, x) == Ch.hush(pp.sames(ps), cfg, x) : Ch.Next}:
  match ps:
    case Nil{}:
      {==}
    case p <> +rest:
      match p:
        case Pr.Peek{+seg, +dt}:
          match x:
            case Ch.Watch{+v}:
              (w, lr) = l
              +h = List.append(&2, Nat, hist, seg)
              +same = pp.repeat(hist, seg, w)
              %Equal.sym(Nat, Pr.work(h), Pr.work(hist), same) : {Pr.watch(rest, cfg, h, Ch.look(cfg, v, 1n+dt, Ch.Busy{Some{_}})) == Ch.hush(pp.sames(rest), cfg, Ch.look(cfg, v, 1n+dt, Ch.Busy{Ch.W.tok(v)})) : Ch.Next}
              %inv : {Pr.watch(rest, cfg, h, Ch.look(cfg, v, 1n+dt, Ch.Busy{_})) == Ch.hush(pp.sames(rest), cfg, Ch.look(cfg, v, 1n+dt, Ch.Busy{Ch.W.tok(v)})) : Ch.Next}
              +next = Ch.look(cfg, v, 1n+dt, Ch.Busy{Ch.W.tok(v)})
              +moved = Equal.trans(Maybe<&2, Nat>, Ch.W.tok(v), Some{Pr.work(hist)}, Some{Pr.work(h)}, inv, Equal.cong(Nat, Maybe<&2, Nat>, n => Some{n}, Pr.work(hist), Pr.work(h), Equal.sym(Nat, Pr.work(h), Pr.work(hist), same)))
              pp.watch_hush(rest, cfg, h, next, pp.loops_app(rest, hist, seg, lr), pp.keep_eq(next, Ch.W.tok(v), Some{Pr.work(h)}, moved, pp.same_keeps(cfg, v, 1n+dt)))
            case Ch.Owe{+k}:
              (w, lr) = l
              pp.watch_hush(rest, cfg, List.append(&2, Nat, hist, seg), Ch.Owe{k}, pp.loops_app(rest, hist, seg, lr), Unit{})
            case Ch.Quiet{}:
              (w, lr) = l
              pp.watch_hush(rest, cfg, List.append(&2, Nat, hist, seg), Ch.Quiet{}, pp.loops_app(rest, hist, seg, lr), Unit{})

# the bound over the quiet polls the polls are
def pp.long_sames(+w: Ch.W, +ps: List<&2, Pr.Peek>, long: {Nat.is_le(Ch.W.left(w), 1n+List.length(&2, Pr.Peek, ps)) == True{} : Bool}) -> {Nat.is_le(Ch.W.left(w), 1n+List.length(&2, Ch.Hush, pp.sames(ps))) == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, Ch.Hush, pp.sames(ps)), List.length(&2, Pr.Peek, ps), pp.len_sames(ps)) : {Nat.is_le(Ch.W.left(w), 1n+_) == True{} : Bool}
  long

def pp.loop_stalls(+cfg: Ch.Cfg, +w: Ch.W, +hist: List<&2, Nat>, p: Pr.Peek, +ps: List<&2, Pr.Peek>, l: Pr.Loops(p <> ps, hist), tok: {Ch.W.tok(w) == Some{Pr.work(hist)} : Maybe<&2, Nat>}, long: {Nat.is_le(Ch.W.left(w), List.length(&2, Pr.Peek, p <> ps)) == True{} : Bool}) -> {Ch.Next.watching(Pr.watch(p <> ps, cfg, hist, Ch.Watch{w})) == False{} : Bool}:
  match p:
    case Pr.Peek{+seg, +dt}:
      +q = {Pr.Peek{seg, dt} : Pr.Peek}
      %Equal.sym(Ch.Next, Pr.watch(q <> ps, cfg, hist, Ch.Watch{w}), Ch.hush(pp.sames(q <> ps), cfg, Ch.Watch{w}), pp.watch_hush(q <> ps, cfg, hist, Ch.Watch{w}, l, tok)) : {Ch.Next.watching(_) == False{} : Bool}
      pc.stalls_in_time(cfg, w, Ch.Same{dt}, pp.sames(ps), pp.long_sames(w, ps, long))

# a poll that reads more work than the watch holds is progress
def pp.news(+w: Ch.W, +a: Nat, +b: Nat, tok: {Ch.W.tok(w) == Some{a} : Maybe<&2, Nat>}, lt: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Ch.moved(Ch.W.tok(w), Some{b}) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Nat>, Ch.W.tok(w), Some{a}, tok) : {Ch.moved(_, Some{b}) == True{} : Bool}
  pp.ne(a, b, lt)

def pp.new_work_moves(+cfg: Ch.Cfg, +w: Ch.W, +e: Nat, +seen: List<&2, Nat>, +seg: List<&2, Nat>, +x: Nat, fresh: {Pr.mem(x, seen) == False{} : Bool}, i: Pr.In(x, seg), tok: {Ch.W.tok(w) == Some{Pr.work(seen)} : Maybe<&2, Nat>}) -> {Ch.look(cfg, w, e, Ch.Busy{Some{Pr.work(List.append(&2, Nat, seen, seg))}}) == Ch.Watch{Ch.W.fresh(cfg, Some{Pr.work(List.append(&2, Nat, seen, seg))})} : Ch.Next}:
  +b = Pr.work(List.append(&2, Nat, seen, seg))
  pc.progress_is_not_a_stall(cfg, w, e, b, pp.news(w, Pr.work(seen), b, tok, pp.new_work(seen, seg, x, fresh, i)))

# ---- progress_report ----

# proof_progress_report: lemmas for the laws that a harness failure is
# reported (LAWS.bend section progress): the auxiliary-model fallback of
# bend/aux_fallback.bend and the skill and template loading of
# bend/skill_load.bend.
#
# Fallbacks. The events of a session come from one pass at a time
# (`Af.go`), so each law is an induction over the passes with any set of
# shown keys. A substitution event of key k comes with a notice of k
# unless the session showed k before; a key joins the shown set only with
# its notice. So every substituted key is shown or noticed, and from an
# empty set, noticed. The other way is simpler: a notice of k comes only
# right after the substitution event of k.
#
# Loading. Each candidate file adds its path to the loaded list when it is
# good, and a diagnostic with its path when it is not. So each candidate's
# path is on one of the two lists. A loaded path and a reported path are
# each the path of some candidate; when no two candidates share a path, no
# path is on both.
#
# A recursive proof takes the value it inspects as a parameter (Bend
# matches only parameters), with an equation that names it.

# Logic
# -----

def ppr.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def ppr.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : ppr.BD(_, Unit, A)
  Unit{}

def ppr.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : ppr.BD(_, A, Unit)
  Unit{}

def ppr.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      ppr.absurdF({False{} == True{} : Bool}, h)

def ppr.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      ppr.absurdF({b == True{} : Bool}, h)

# a true right side makes the or true
def ppr.or_r(a: Bool, +b: Bool, h: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def ppr.or_l(a: Bool, b: Bool, h: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      ppr.absurdF({b == True{} : Bool}, h)

def ppr.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      ppr.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def ppr.nat_eq_refl(n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      ppr.nat_eq_refl(p)

def ppr.nat_eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      ppr.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      ppr.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, ppr.nat_eq_true(p, q, h))

# Fallbacks
# ---------

def ppr.key_eq_true(a: Af.Key, b: Af.Key, +h: {Af.Key.eq(a, b) == True{} : Bool}) -> {a == b : Af.Key}:
  match a b:
    case Af.K{+ap, +as1, +ar} Af.K{+bp, +bs1, +br}:
      +i = Bool.and(Nat.is_eq(as1, bs1), Nat.is_eq(ar, br))
      +ep = ppr.nat_eq_true(ap, bp, ppr.and_l(Nat.is_eq(ap, bp), i, h))
      +hs = ppr.and_r(Nat.is_eq(ap, bp), i, h)
      +es = ppr.nat_eq_true(as1, bs1, ppr.and_l(Nat.is_eq(as1, bs1), Nat.is_eq(ar, br), hs))
      +er = ppr.nat_eq_true(ar, br, ppr.and_r(Nat.is_eq(as1, bs1), Nat.is_eq(ar, br), hs))
      %ep : {Af.K{ap, as1, ar} == Af.K{_, bs1, br} : Af.Key}
      %es : {Af.K{ap, as1, ar} == Af.K{ap, _, br} : Af.Key}
      %er : {Af.K{ap, as1, ar} == Af.K{ap, as1, _} : Af.Key}
      {==}

# a fallback the session showed before, of a key c says is k: k is shown
def ppr.rep_seen(c: Bool, +sh: List<&2, Af.Key>, +kk: Af.Key, +k: Af.Key, +t: List<&2, Af.Ev>, +ec: {Af.Key.eq(kk, k) == c : Bool}, es: {Af.listed(sh, kk) == True{} : Bool}, ih: {Af.listed(Af.subs(t), k) == True{} : Bool} -> {Bool.or(Af.listed(sh, k), Af.listed(Af.notes(t), k)) == True{} : Bool}, h: {Bool.or(c, Af.listed(Af.subs(t), k)) == True{} : Bool}) -> {Bool.or(Af.listed(sh, k), Af.listed(Af.notes(t), k)) == True{} : Bool}:
  match c:
    case True{}:
      %ppr.key_eq_true(kk, k, ec) : {Bool.or(Af.listed(sh, _), Af.listed(Af.notes(t), _)) == True{} : Bool}
      %Equal.sym(Bool, Af.listed(sh, kk), True{}, es) : {Bool.or(_, Af.listed(Af.notes(t), kk)) == True{} : Bool}
      {==}
    case False{}:
      ih(h)

# a fallback the session had not shown, of a key c says is k: k is
# noticed now, or later
def ppr.rep_new(c: Bool, +sh: List<&2, Af.Key>, +k: Af.Key, +t: List<&2, Af.Ev>, ih: {Af.listed(Af.subs(t), k) == True{} : Bool} -> {Bool.or(Bool.or(c, Af.listed(sh, k)), Af.listed(Af.notes(t), k)) == True{} : Bool}, h: {Bool.or(c, Af.listed(Af.subs(t), k)) == True{} : Bool}) -> {Bool.or(Af.listed(sh, k), Bool.or(c, Af.listed(Af.notes(t), k))) == True{} : Bool}:
  match c:
    case True{}:
      ppr.or_r(Af.listed(sh, k), Bool.or(True{}, Af.listed(Af.notes(t), k)), {==})
    case False{}:
      ih(h)

# one fallback of key kk, the session having shown kk or not (seen)
def ppr.rep_fb(seen: Bool, +sh: List<&2, Af.Key>, +kk: Af.Key, +k: Af.Key, +t: List<&2, Af.Ev>, +es: {Af.listed(sh, kk) == seen : Bool}, ih: {Af.listed(Af.subs(t), k) == True{} : Bool} -> {Bool.or(Af.listed(Af.shown(seen, kk, sh), k), Af.listed(Af.notes(t), k)) == True{} : Bool}, h: {Bool.or(Af.Key.eq(kk, k), Af.listed(Af.subs(Af.noted(seen, kk, t)), k)) == True{} : Bool}) -> {Bool.or(Af.listed(sh, k), Af.listed(Af.notes(Af.noted(seen, kk, t)), k)) == True{} : Bool}:
  match seen:
    case True{}:
      ppr.rep_seen(Af.Key.eq(kk, k), sh, kk, k, t, {==}, es, ih, h)
    case False{}:
      ppr.rep_new(Af.Key.eq(kk, k), sh, k, t, ih, h)

# one pass routed r: a substituted key of its events, or of the events t
# after it, is shown or noticed
def ppr.rep_put(r: Af.Route, +sh: List<&2, Af.Key>, +k: Af.Key, +t: List<&2, Af.Ev>, ih: {Af.listed(Af.subs(t), k) == True{} : Bool} -> {Bool.or(Af.listed(Af.after(r, sh), k), Af.listed(Af.notes(t), k)) == True{} : Bool}, h: {Af.listed(Af.subs(Af.put(r, sh, t)), k) == True{} : Bool}) -> {Bool.or(Af.listed(sh, k), Af.listed(Af.notes(Af.put(r, sh, t)), k)) == True{} : Bool}:
  match r:
    case Af.Session{}:
      ih(h)
    case Af.Routed{}:
      ih(h)
    case Af.Fallback{+kk}:
      ppr.rep_fb(Af.listed(sh, kk), sh, kk, k, t, {==}, ih, h)

# every substituted key of a session that has shown sh is in sh or
# noticed
def ppr.rep_go(ps: List<&2, Af.Pass>, +sh: List<&2, Af.Key>, +k: Af.Key) -> {Af.listed(Af.subs(Af.go(ps, sh)), k) == True{} : Bool} -> {Bool.or(Af.listed(sh, k), Af.listed(Af.notes(Af.go(ps, sh)), k)) == True{} : Bool}:
  match ps:
    case Nil{}:
      h => ppr.absurdF({Bool.or(Af.listed(sh, k), False{}) == True{} : Bool}, h)
    case +x <> +rest:
      +sh2 = Af.after(Af.decide(x), sh)
      ih = ppr.rep_go(rest, sh2, k)
      h => ppr.rep_put(Af.decide(x), sh, k, Af.go(rest, sh2), ih, h)

# a notice of c's key comes with its substitution
def ppr.quiet_new(c: Bool, +k: Af.Key, +t: List<&2, Af.Ev>, ih: {Af.listed(Af.notes(t), k) == True{} : Bool} -> {Af.listed(Af.subs(t), k) == True{} : Bool}, h: {Bool.or(c, Af.listed(Af.notes(t), k)) == True{} : Bool}) -> {Bool.or(c, Af.listed(Af.subs(t), k)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      ih(h)

# one fallback of key kk: a notice of k is in its events only with the
# substitution of k
def ppr.quiet_fb(seen: Bool, +kk: Af.Key, +k: Af.Key, +t: List<&2, Af.Ev>, ih: {Af.listed(Af.notes(t), k) == True{} : Bool} -> {Af.listed(Af.subs(t), k) == True{} : Bool}, h: {Af.listed(Af.notes(Af.noted(seen, kk, t)), k) == True{} : Bool}) -> {Bool.or(Af.Key.eq(kk, k), Af.listed(Af.subs(Af.noted(seen, kk, t)), k)) == True{} : Bool}:
  match seen:
    case True{}:
      ppr.or_r(Af.Key.eq(kk, k), Af.listed(Af.subs(t), k), ih(h))
    case False{}:
      ppr.quiet_new(Af.Key.eq(kk, k), k, t, ih, h)

def ppr.quiet_put(r: Af.Route, +sh: List<&2, Af.Key>, +k: Af.Key, +t: List<&2, Af.Ev>, ih: {Af.listed(Af.notes(t), k) == True{} : Bool} -> {Af.listed(Af.subs(t), k) == True{} : Bool}, h: {Af.listed(Af.notes(Af.put(r, sh, t)), k) == True{} : Bool}) -> {Af.listed(Af.subs(Af.put(r, sh, t)), k) == True{} : Bool}:
  match r:
    case Af.Session{}:
      ih(h)
    case Af.Routed{}:
      ih(h)
    case Af.Fallback{+kk}:
      ppr.quiet_fb(Af.listed(sh, kk), kk, k, t, ih, h)

# every noticed key of a session is a substituted key
def ppr.quiet_go(ps: List<&2, Af.Pass>, +sh: List<&2, Af.Key>, +k: Af.Key) -> {Af.listed(Af.notes(Af.go(ps, sh)), k) == True{} : Bool} -> {Af.listed(Af.subs(Af.go(ps, sh)), k) == True{} : Bool}:
  match ps:
    case Nil{}:
      h => h
    case +x <> +rest:
      +sh2 = Af.after(Af.decide(x), sh)
      ih = ppr.quiet_go(rest, sh2, k)
      h => ppr.quiet_put(Af.decide(x), sh, k, Af.go(rest, sh2), ih, h)

# LAW fallback_is_reported: every key the session model was put in place
# of is noticed in the session
def ppr.fallback_is_reported(ps: List<&2, Af.Pass>, +k: Af.Key, h: {Af.listed(Af.subs(Af.run(ps)), k) == True{} : Bool}) -> {Af.listed(Af.notes(Af.run(ps)), k) == True{} : Bool}:
  ppr.rep_go(ps, Nil{}, k)(h)

# LAW fallback_quiet_when_routed: a session notices only keys the session
# model was put in place of
def ppr.fallback_quiet_when_routed(ps: List<&2, Af.Pass>, +k: Af.Key, h: {Af.listed(Af.notes(Af.run(ps)), k) == True{} : Bool}) -> {Af.listed(Af.subs(Af.run(ps)), k) == True{} : Bool}:
  ppr.quiet_go(ps, Nil{}, k)(h)

# LAW fallback_quiet_when_unset: an unset selector keeps the session model
def ppr.fallback_quiet_when_unset(p: Nat, ok: Bool, look: Af.Look, need: Nat) -> {Af.decide(Af.Pass{p, Af.Unset{}, ok, look, need}) == Af.Session{} : Af.Route}:
  {==}

# LAW fallback_quiet_when_same: a selector that names the session model
# keeps the session model
def ppr.fallback_quiet_when_same(p: Nat, ok: Bool, look: Af.Look, need: Nat) -> {Af.decide(Af.Pass{p, Af.Same{}, ok, look, need}) == Af.Session{} : Af.Route}:
  {==}

# Loading
# -------

# a head of a true or keeps it true: or(a, or(A, B)) from or(A, B), in the
# loaded place and in the reported place
def ppr.or_in_l(a: Bool, +x: Bool, +y: Bool, h: {Bool.or(x, y) == True{} : Bool}) -> {Bool.or(Bool.or(a, x), y) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def ppr.or_in_r(a: Bool, x: Bool, +y: Bool, h: {Bool.or(x, y) == True{} : Bool}) -> {Bool.or(x, Bool.or(a, y)) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      ppr.or_r(a, y, h)

# the candidate x is loaded or reported
def ppr.skill_head(+x: Sk.Cand, +rest: List<&2, Sk.Cand>) -> {Bool.or(Sk.listed(Sk.loaded(x <> rest), Sk.Cand.path(x)), Sk.listed(Sk.named(Sk.diags(x <> rest)), Sk.Cand.path(x))) == True{} : Bool}:
  match x:
    case Sk.Cand{+p, o}:
      match o:
        case Sk.Good{}:
          +a = Sk.listed(Sk.loaded(rest), p)
          ppr.or_l(Bool.or(Nat.is_eq(p, p), a), Sk.listed(Sk.named(Sk.diags(rest)), p), ppr.or_l(Nat.is_eq(p, p), a, ppr.nat_eq_refl(p)))
        case Sk.Unreadable{}:
          +b = Sk.listed(Sk.named(Sk.diags(rest)), p)
          ppr.or_r(Sk.listed(Sk.loaded(rest), p), Bool.or(Nat.is_eq(p, p), b), ppr.or_l(Nat.is_eq(p, p), b, ppr.nat_eq_refl(p)))
        case Sk.Malformed{}:
          +b = Sk.listed(Sk.named(Sk.diags(rest)), p)
          ppr.or_r(Sk.listed(Sk.loaded(rest), p), Bool.or(Nat.is_eq(p, p), b), ppr.or_l(Nat.is_eq(p, p), b, ppr.nat_eq_refl(p)))
        case Sk.Incomplete{}:
          +b = Sk.listed(Sk.named(Sk.diags(rest)), p)
          ppr.or_r(Sk.listed(Sk.loaded(rest), p), Bool.or(Nat.is_eq(p, p), b), ppr.or_l(Nat.is_eq(p, p), b, ppr.nat_eq_refl(p)))

# a path loaded or reported in rest stays so with x before rest
def ppr.skill_cons(+x: Sk.Cand, +rest: List<&2, Sk.Cand>, +n: Nat, h: {Bool.or(Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n)) == True{} : Bool}) -> {Bool.or(Sk.listed(Sk.loaded(x <> rest), n), Sk.listed(Sk.named(Sk.diags(x <> rest)), n)) == True{} : Bool}:
  match x:
    case Sk.Cand{+p, o}:
      match o:
        case Sk.Good{}:
          ppr.or_in_l(Nat.is_eq(p, n), Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n), h)
        case Sk.Unreadable{}:
          ppr.or_in_r(Nat.is_eq(p, n), Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n), h)
        case Sk.Malformed{}:
          ppr.or_in_r(Nat.is_eq(p, n), Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n), h)
        case Sk.Incomplete{}:
          ppr.or_in_r(Nat.is_eq(p, n), Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n), h)

# LAW skill_failure_reported: the path of every candidate file is on the
# loaded list or named by a diagnostic
def ppr.skill_failure_reported(cs: List<&2, Sk.Cand>, +c: Sk.Cand, i: Sk.In(c, cs)) -> {Bool.or(Sk.listed(Sk.loaded(cs), Sk.Cand.path(c)), Sk.listed(Sk.named(Sk.diags(cs)), Sk.Cand.path(c))) == True{} : Bool}:
  match cs:
    case Nil{}:
      match i:
    case +x <> +rest:
      match i:
        case Inl{eq}:
          %Equal.sym(Sk.Cand, c, x, eq) : {Bool.or(Sk.listed(Sk.loaded(x <> rest), Sk.Cand.path(_)), Sk.listed(Sk.named(Sk.diags(x <> rest)), Sk.Cand.path(_))) == True{} : Bool}
          ppr.skill_head(x, rest)
        case Inr{it}:
          ppr.skill_cons(x, rest, Sk.Cand.path(c), ppr.skill_failure_reported(rest, c, it))

# a true or with a false-making implication
def ppr.or_mono(a: Bool, +x: Bool, +y: Bool, f: {x == True{} : Bool} -> {y == True{} : Bool}, h: {Bool.or(a, x) == True{} : Bool}) -> {Bool.or(a, y) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      f(h)

# a loaded path is the path of a candidate
def ppr.loaded_sub(cs: List<&2, Sk.Cand>, +q: Nat) -> {Sk.listed(Sk.loaded(cs), q) == True{} : Bool} -> {Sk.listed(Sk.paths(cs), q) == True{} : Bool}:
  match cs:
    case Nil{}:
      h => h
    case x <> +rest:
      match x:
        case Sk.Cand{+p, o}:
          match o:
            case Sk.Good{}:
              h => ppr.or_mono(Nat.is_eq(p, q), Sk.listed(Sk.loaded(rest), q), Sk.listed(Sk.paths(rest), q), ppr.loaded_sub(rest, q), h)
            case Sk.Unreadable{}:
              h => ppr.or_r(Nat.is_eq(p, q), Sk.listed(Sk.paths(rest), q), ppr.loaded_sub(rest, q)(h))
            case Sk.Malformed{}:
              h => ppr.or_r(Nat.is_eq(p, q), Sk.listed(Sk.paths(rest), q), ppr.loaded_sub(rest, q)(h))
            case Sk.Incomplete{}:
              h => ppr.or_r(Nat.is_eq(p, q), Sk.listed(Sk.paths(rest), q), ppr.loaded_sub(rest, q)(h))

# a reported path is the path of a candidate
def ppr.named_sub(cs: List<&2, Sk.Cand>, +q: Nat) -> {Sk.listed(Sk.named(Sk.diags(cs)), q) == True{} : Bool} -> {Sk.listed(Sk.paths(cs), q) == True{} : Bool}:
  match cs:
    case Nil{}:
      h => h
    case x <> +rest:
      match x:
        case Sk.Cand{+p, o}:
          match o:
            case Sk.Good{}:
              h => ppr.or_r(Nat.is_eq(p, q), Sk.listed(Sk.paths(rest), q), ppr.named_sub(rest, q)(h))
            case Sk.Unreadable{}:
              h => ppr.or_mono(Nat.is_eq(p, q), Sk.listed(Sk.named(Sk.diags(rest)), q), Sk.listed(Sk.paths(rest), q), ppr.named_sub(rest, q), h)
            case Sk.Malformed{}:
              h => ppr.or_mono(Nat.is_eq(p, q), Sk.listed(Sk.named(Sk.diags(rest)), q), Sk.listed(Sk.paths(rest), q), ppr.named_sub(rest, q), h)
            case Sk.Incomplete{}:
              h => ppr.or_mono(Nat.is_eq(p, q), Sk.listed(Sk.named(Sk.diags(rest)), q), Sk.listed(Sk.paths(rest), q), ppr.named_sub(rest, q), h)

# a list of paths of rest does not name q when the paths of rest do not
def ppr.not_in(b: Bool, +ns: List<&2, Nat>, +rest: List<&2, Sk.Cand>, +q: Nat, eb: {Sk.listed(ns, q) == b : Bool}, sub: {Sk.listed(ns, q) == True{} : Bool} -> {Sk.listed(Sk.paths(rest), q) == True{} : Bool}, out: {Sk.listed(Sk.paths(rest), q) == False{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      ppr.absurd({True{} == False{} : Bool}, Equal.trans(Bool, True{}, Sk.listed(Sk.paths(rest), q), False{}, Equal.sym(Bool, Sk.listed(Sk.paths(rest), q), True{}, sub(eb)), out))
    case False{}:
      {==}

# a good candidate of path p, c saying whether p is n
def ppr.good_at(c: Bool, +p: Nat, +n: Nat, +rest: List<&2, Sk.Cand>, +ec: {Nat.is_eq(p, n) == c : Bool}, +dp: {Sk.listed(Sk.paths(rest), p) == False{} : Bool}, ih: {Bool.and(Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n)) == False{} : Bool}) -> {Bool.and(Bool.or(c, Sk.listed(Sk.loaded(rest), n)), Sk.listed(Sk.named(Sk.diags(rest)), n)) == False{} : Bool}:
  match c:
    case True{}:
      %ppr.nat_eq_true(p, n, ec) : {Sk.listed(Sk.named(Sk.diags(rest)), _) == False{} : Bool}
      ppr.not_in(Sk.listed(Sk.named(Sk.diags(rest)), p), Sk.named(Sk.diags(rest)), rest, p, {==}, ppr.named_sub(rest, p), dp)
    case False{}:
      ih

# a candidate of path p that does not load, c saying whether p is n
def ppr.bad_at(c: Bool, +p: Nat, +n: Nat, +rest: List<&2, Sk.Cand>, +ec: {Nat.is_eq(p, n) == c : Bool}, +dp: {Sk.listed(Sk.paths(rest), p) == False{} : Bool}, ih: {Bool.and(Sk.listed(Sk.loaded(rest), n), Sk.listed(Sk.named(Sk.diags(rest)), n)) == False{} : Bool}) -> {Bool.and(Sk.listed(Sk.loaded(rest), n), Bool.or(c, Sk.listed(Sk.named(Sk.diags(rest)), n))) == False{} : Bool}:
  match c:
    case True{}:
      +eL = ppr.not_in(Sk.listed(Sk.loaded(rest), p), Sk.loaded(rest), rest, p, {==}, ppr.loaded_sub(rest, p), dp)
      %ppr.nat_eq_true(p, n, ec) : {Bool.and(Sk.listed(Sk.loaded(rest), _), True{}) == False{} : Bool}
      %Equal.sym(Bool, Sk.listed(Sk.loaded(rest), p), False{}, eL) : {Bool.and(_, True{}) == False{} : Bool}
      {==}
    case False{}:
      ih

# LAW skill_loaded_not_failed: when no two candidates share a path, no
# path is both loaded and named by a diagnostic
def ppr.skill_loaded_not_failed(cs: List<&2, Sk.Cand>, +n: Nat, +d: {Sk.distinct(cs) == True{} : Bool}) -> {Bool.and(Sk.listed(Sk.loaded(cs), n), Sk.listed(Sk.named(Sk.diags(cs)), n)) == False{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case x <> +rest:
      match x:
        case Sk.Cand{+p, o}:
          match o:
            case Sk.Good{}:
              +nd = Bool.not(Sk.listed(Sk.paths(rest), p))
              +dp = ppr.not_t(Sk.listed(Sk.paths(rest), p), ppr.and_l(nd, Sk.distinct(rest), d))
              ppr.good_at(Nat.is_eq(p, n), p, n, rest, {==}, dp, ppr.skill_loaded_not_failed(rest, n, ppr.and_r(nd, Sk.distinct(rest), d)))
            case Sk.Unreadable{}:
              +nd = Bool.not(Sk.listed(Sk.paths(rest), p))
              +dp = ppr.not_t(Sk.listed(Sk.paths(rest), p), ppr.and_l(nd, Sk.distinct(rest), d))
              ppr.bad_at(Nat.is_eq(p, n), p, n, rest, {==}, dp, ppr.skill_loaded_not_failed(rest, n, ppr.and_r(nd, Sk.distinct(rest), d)))
            case Sk.Malformed{}:
              +nd = Bool.not(Sk.listed(Sk.paths(rest), p))
              +dp = ppr.not_t(Sk.listed(Sk.paths(rest), p), ppr.and_l(nd, Sk.distinct(rest), d))
              ppr.bad_at(Nat.is_eq(p, n), p, n, rest, {==}, dp, ppr.skill_loaded_not_failed(rest, n, ppr.and_r(nd, Sk.distinct(rest), d)))
            case Sk.Incomplete{}:
              +nd = Bool.not(Sk.listed(Sk.paths(rest), p))
              +dp = ppr.not_t(Sk.listed(Sk.paths(rest), p), ppr.and_l(nd, Sk.distinct(rest), d))
              ppr.bad_at(Nat.is_eq(p, n), p, n, rest, {==}, dp, ppr.skill_loaded_not_failed(rest, n, ppr.and_r(nd, Sk.distinct(rest), d)))

# ---- kernel_local ----

# proof_kernel_local: the K1 laws (LAWS.bend section kernel_local) of the kernel
# setup model in bend/kernel_local.bend.
#
# A setup's plan is a fixed list for each venv found and each setup, so
# the setup laws hold by computation in every case. The tool laws read
# the answer: another tool runs whatever the kernel, and a failed setup
# of a venv that is not current is Missing. The sweep laws go by
# induction on the files: each file is kept exactly when it is not a
# leftover of a dead attempt.

# Logic
# -----

def pk.KD(k: KL.Kernel, u: Type, m: Type) -> Type:
  match k:
    case KL.Up{}:
      u
    case KL.Missing{}:
      m

def pk.up_missing(-A: Type, e: {KL.Up{} == KL.Missing{} : KL.Kernel}) -> A:
  %e : pk.KD(_, Unit, A)
  Unit{}

def pk.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pk.false_true(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pk.BD(_, A, Unit)
  Unit{}

# The setup
# ---------

def pk.session_never_downloads(f: KL.Found) -> {KL.acts.fetching(KL.plan(f, KL.Local{})) == False{} : Bool}:
  match f:
    case KL.Current{}:
      {==}
    case KL.Skills{}:
      {==}
    case KL.Stale{}:
      {==}

def pk.download_only_on_install(f: KL.Found, s: KL.Setup, fetches: {KL.acts.fetching(KL.plan(f, s)) == True{} : Bool}) -> {s == KL.Install{} : KL.Setup}:
  match f s:
    case KL.Current{} KL.Local{}:
      pk.false_true({KL.Local{} == KL.Install{} : KL.Setup}, fetches)
    case KL.Current{} KL.Install{}:
      {==}
    case KL.Skills{} KL.Local{}:
      pk.false_true({KL.Local{} == KL.Install{} : KL.Setup}, fetches)
    case KL.Skills{} KL.Install{}:
      {==}
    case KL.Stale{} KL.Local{}:
      pk.false_true({KL.Local{} == KL.Install{} : KL.Setup}, fetches)
    case KL.Stale{} KL.Install{}:
      {==}

def pk.fetch_verified_before_use(f: KL.Found, s: KL.Setup) -> {KL.acts.verified(KL.plan(f, s), True{}) == True{} : Bool}:
  match f s:
    case KL.Current{} KL.Local{}:
      {==}
    case KL.Current{} KL.Install{}:
      {==}
    case KL.Skills{} KL.Local{}:
      {==}
    case KL.Skills{} KL.Install{}:
      {==}
    case KL.Stale{} KL.Local{}:
      {==}
    case KL.Stale{} KL.Install{}:
      {==}

def pk.setup_runs(f: KL.Found, s: KL.Setup) -> {KL.acts.runs(KL.plan(f, s)) == True{} : Bool}:
  match f s:
    case KL.Current{} KL.Local{}:
      {==}
    case KL.Current{} KL.Install{}:
      {==}
    case KL.Skills{} KL.Local{}:
      {==}
    case KL.Skills{} KL.Install{}:
      {==}
    case KL.Stale{} KL.Local{}:
      {==}
    case KL.Stale{} KL.Install{}:
      {==}

# The session's tools
# -------------------

def pk.missing_spares_tools(n: Nat, f: KL.Found, ok: Bool) -> {KL.answer(KL.Other{n}, KL.start(f, ok)) == KL.Ran{} : KL.Answer}:
  {==}

def pk.missing_names_install(f: KL.Found, failed: {KL.start(f, False{}) == KL.Missing{} : KL.Kernel}) -> {KL.answer(KL.Python{}, KL.start(f, False{})) == KL.NamesInstall{} : KL.Answer}:
  match f:
    case KL.Current{}:
      pk.up_missing({KL.answer(KL.Python{}, KL.Up{}) == KL.NamesInstall{} : KL.Answer}, failed)
    case KL.Skills{}:
      {==}
    case KL.Stale{}:
      {==}

# The bootstrap lock
# ------------------

def pk.attempt_leaves_none(l: KL.Lock) -> {KL.own_left(KL.attempt(l)) == 0n : Nat}:
  match l:
    case KL.Free{}:
      {==}
    case KL.Live{}:
      {==}
    case KL.Gone{}:
      {==}

def pk.sweep_removes_dead(ls: List<&2, KL.Left>) -> {KL.lefts.dead(KL.sweep(ls)) == 0n : Nat}:
  match ls:
    case Nil{}:
      {==}
    case KL.Left{k, o} <> rest:
      match k o:
        case KL.Cand{} KL.Alive{}:
          pk.sweep_removes_dead(rest)
        case KL.Cand{} KL.Dead{}:
          pk.sweep_removes_dead(rest)
        case KL.Aside{} KL.Alive{}:
          pk.sweep_removes_dead(rest)
        case KL.Aside{} KL.Dead{}:
          pk.sweep_removes_dead(rest)
        case KL.Foreign{} KL.Alive{}:
          pk.sweep_removes_dead(rest)
        case KL.Foreign{} KL.Dead{}:
          pk.sweep_removes_dead(rest)

def pk.sweep_keeps_live(ls: List<&2, KL.Left>) -> {KL.lefts.live(KL.sweep(ls)) == KL.lefts.live(ls) : Nat}:
  match ls:
    case Nil{}:
      {==}
    case KL.Left{k, o} <> rest:
      match k o:
        case KL.Cand{} KL.Alive{}:
          %pk.sweep_keeps_live(rest) : {1n+KL.lefts.live(KL.sweep(rest)) == 1n+_ : Nat}
          {==}
        case KL.Cand{} KL.Dead{}:
          pk.sweep_keeps_live(rest)
        case KL.Aside{} KL.Alive{}:
          %pk.sweep_keeps_live(rest) : {1n+KL.lefts.live(KL.sweep(rest)) == 1n+_ : Nat}
          {==}
        case KL.Aside{} KL.Dead{}:
          pk.sweep_keeps_live(rest)
        case KL.Foreign{} KL.Alive{}:
          %pk.sweep_keeps_live(rest) : {1n+KL.lefts.live(KL.sweep(rest)) == 1n+_ : Nat}
          {==}
        case KL.Foreign{} KL.Dead{}:
          %pk.sweep_keeps_live(rest) : {1n+KL.lefts.live(KL.sweep(rest)) == 1n+_ : Nat}
          {==}

# ---- log ----

# proof_log: the commit log laws of LAWS.bend section storage (D2): open reads
# exactly the complete lines, and after any epoch (any commits, any crash
# point, any torn tail, any lost entries) the log is the old log, then the
# acknowledged commits, then maybe more, and only a prefix of the commits.
#
# A helper lemma {s == t} has the simpler side s first: `%lemma : P`
# turns the t in the goal into s.

# Lists
# -----

def pl.app_nil(-A: Data, xs: List<&2, A>) -> {xs == List.append(&2, A, xs, Nil{}) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> rest:
      %pl.app_nil(A, rest) : {x <> rest == x <> _ : List<&2, A>}
      {==}

def pl.assoc(-A: Data, xs: List<&2, A>, +ys: List<&2, A>, +zs: List<&2, A>) -> {List.append(&2, A, xs, List.append(&2, A, ys, zs)) == List.append(&2, A, List.append(&2, A, xs, ys), zs) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> rest:
      %pl.assoc(A, rest, ys, zs) : {x <> List.append(&2, A, rest, List.append(&2, A, ys, zs)) == x <> _ : List<&2, A>}
      {==}

def pl.take0(-A: Data, xs: List<&2, A>) -> {Nil{} == List.take(&2, A, xs, 0n) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case x <> rest:
      {==}

# Parsing
# -------

def pl.parse_data(t: List<&2, Nat>) -> {Lg.P{Nil{}, t} == Lg.parse(Lg.data(t)) : Lg.P}:
  match t:
    case Nil{}:
      {==}
    case +x <> rest:
      %pl.parse_data(rest) : {Lg.P{Nil{}, x <> rest} == Lg.byte(1n+x, _) : Lg.P}
      {==}

def pl.byte0(p: Lg.P) -> {Lg.P{Nil{} <> Lg.P.ls(p), Lg.P.tl(p)} == Lg.byte(0n, p) : Lg.P}:
  match p:
    case Lg.P{ls, t}:
      {==}

def pl.eta(p: Lg.P) -> {Lg.P{Lg.P.ls(p), Lg.P.tl(p)} == p : Lg.P}:
  match p:
    case Lg.P{ls, t}:
      {==}

# a line, its newline, and the bytes y after it
def pl.parse_line(l: List<&2, Nat>, +y: List<&2, Nat>) -> {Lg.P{l <> Lg.P.ls(Lg.parse(y)), Lg.P.tl(Lg.parse(y))} == Lg.parse(List.append(&2, Nat, Lg.data(l), 0n <> y)) : Lg.P}:
  match l:
    case Nil{}:
      pl.byte0(Lg.parse(y))
    case +x <> rest:
      %pl.parse_line(rest, y) : {Lg.P{(x <> rest) <> Lg.P.ls(Lg.parse(y)), Lg.P.tl(Lg.parse(y))} == Lg.byte(1n+x, _) : Lg.P}
      {==}

def pl.parse_render(ls: List<&2, List<&2, Nat>>, +x: List<&2, Nat>) -> {Lg.P{List.append(&2, List<&2, Nat>, ls, Lg.P.ls(Lg.parse(x))), Lg.P.tl(Lg.parse(x))} == Lg.parse(List.append(&2, Nat, Lg.render(ls), x)) : Lg.P}:
  match ls:
    case Nil{}:
      pl.eta(Lg.parse(x))
    case +l <> +rest:
      +y = List.append(&2, Nat, Lg.render(rest), x)
      %pl.assoc(Nat, Lg.line(l), Lg.render(rest), x) : {Lg.P{l <> List.append(&2, List<&2, Nat>, rest, Lg.P.ls(Lg.parse(x))), Lg.P.tl(Lg.parse(x))} == Lg.parse(_) : Lg.P}
      %pl.assoc(Nat, Lg.data(l), [0n], y) : {Lg.P{l <> List.append(&2, List<&2, Nat>, rest, Lg.P.ls(Lg.parse(x))), Lg.P.tl(Lg.parse(x))} == Lg.parse(_) : Lg.P}
      %pl.parse_line(l, y) : {Lg.P{l <> List.append(&2, List<&2, Nat>, rest, Lg.P.ls(Lg.parse(x))), Lg.P.tl(Lg.parse(x))} == _ : Lg.P}
      %pl.parse_render(rest, x) : {Lg.P{l <> List.append(&2, List<&2, Nat>, rest, Lg.P.ls(Lg.parse(x))), Lg.P.tl(Lg.parse(x))} == Lg.P{l <> Lg.P.ls(_), Lg.P.tl(_)} : Lg.P}
      {==}

# open reads the lines of render(ls) and then those of x
def pl.recover_render(+ls: List<&2, List<&2, Nat>>, +x: List<&2, Nat>) -> {List.append(&2, List<&2, Nat>, ls, Lg.recover(x)) == Lg.recover(List.append(&2, Nat, Lg.render(ls), x)) : List<&2, List<&2, Nat>>}:
  %pl.parse_render(ls, x) : {List.append(&2, List<&2, Nat>, ls, Lg.recover(x)) == Lg.P.ls(_) : List<&2, List<&2, Nat>>}
  {==}

# the law log_reads_lines
def pl.reads_lines(+ls: List<&2, List<&2, Nat>>, +t: List<&2, Nat>) -> {Lg.recover(List.append(&2, Nat, Lg.render(ls), Lg.data(t))) == ls : List<&2, List<&2, Nat>>}:
  %pl.recover_render(ls, Lg.data(t)) : {_ == ls : List<&2, List<&2, Nat>>}
  %pl.parse_data(t) : {List.append(&2, List<&2, Nat>, ls, Lg.P.ls(_)) == ls : List<&2, List<&2, Nat>>}
  %pl.app_nil(List<&2, Nat>, ls) : {_ == ls : List<&2, List<&2, Nat>>}
  {==}

# A torn line
# -----------

# the data byte x before the first line, if any
def pl.head(x: Nat, ls: List<&2, List<&2, Nat>>) -> List<&2, List<&2, Nat>>:
  match ls:
    case Nil{}:
      Nil{}
    case l <> rest:
      (x <> l) <> rest

# the lines the first k bytes of the line c give: none, or c
def log.pl.keep(k: Nat, c: List<&2, Nat>) -> List<&2, List<&2, Nat>>:
  match k:
    case 0n:
      Nil{}
    case 1n+j:
      match c:
        case Nil{}:
          [Nil{}]
        case x <> rest:
          pl.head(x, log.pl.keep(j, rest))

def pl.byte_s(x: Nat, p: Lg.P) -> {pl.head(x, Lg.P.ls(p)) == Lg.P.ls(Lg.byte(1n+x, p)) : List<&2, List<&2, Nat>>}:
  match p:
    case Lg.P{ls, t}:
      match ls:
        case Nil{}:
          {==}
        case l <> rest:
          {==}

def pl.torn(+k: Nat, c: List<&2, Nat>) -> {log.pl.keep(k, c) == Lg.recover(List.take(&2, Nat, Lg.line(c), k)) : List<&2, List<&2, Nat>>}:
  match k:
    case 0n:
      match c:
        case Nil{}:
          {==}
        case x <> rest:
          {==}
    case 1n+j:
      match c:
        case Nil{}:
          {==}
        case +x <> +rest:
          %pl.byte_s(x, Lg.parse(List.take(&2, Nat, Lg.line(rest), j))) : {pl.head(x, log.pl.keep(j, rest)) == _ : List<&2, List<&2, Nat>>}
          %pl.torn(j, rest) : {pl.head(x, log.pl.keep(j, rest)) == pl.head(x, _) : List<&2, List<&2, Nat>>}
          {==}

# the head x before a cut of the commits
def pl.head_take(x: Nat, c: List<&2, Nat>, rest: List<&2, List<&2, Nat>>, n: Nat) -> {pl.head(x, List.take(&2, List<&2, Nat>, c <> rest, n)) == List.take(&2, List<&2, Nat>, (x <> c) <> rest, n) : List<&2, List<&2, Nat>>}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      {==}

def pl.head_pair(+x: Nat, +cs: List<&2, Nat>, +rest: List<&2, List<&2, Nat>>, -K: List<&2, List<&2, Nat>>, r: &n: Nat -> {K == List.take(&2, List<&2, Nat>, cs <> rest, n) : List<&2, List<&2, Nat>>}) -> &n: Nat -> {pl.head(x, K) == List.take(&2, List<&2, Nat>, (x <> cs) <> rest, n) : List<&2, List<&2, Nat>>}:
  match r:
    case (+m, e):
      (m, (%Equal.sym(List<&2, List<&2, Nat>>, K, List.take(&2, List<&2, Nat>, cs <> rest, m), e) : {pl.head(x, _) == List.take(&2, List<&2, Nat>, (x <> cs) <> rest, m) : List<&2, List<&2, Nat>>}; pl.head_take(x, cs, rest, m)))

# a torn line is a prefix of the commits from it
def pl.keep_take(k: Nat, c: List<&2, Nat>, +rest: List<&2, List<&2, Nat>>) -> &n: Nat -> {log.pl.keep(k, c) == List.take(&2, List<&2, Nat>, c <> rest, n) : List<&2, List<&2, Nat>>}:
  match k:
    case 0n:
      (0n, {==})
    case 1n+j:
      match c:
        case Nil{}:
          (1n, (%pl.take0(List<&2, Nat>, rest) : {[Nil{}] == Nil{} <> _ : List<&2, List<&2, Nat>>}; {==}))
        case +x <> +cs:
          pl.head_pair(x, cs, rest, log.pl.keep(j, cs), pl.keep_take(j, cs, rest))

# The state
# ---------

def pl.de(s: Lg.St) -> Bool:
  match s:
    case Lg.St{de, fe, log, pend, acked}:
      de

def pl.fe(s: Lg.St) -> Bool:
  match s:
    case Lg.St{de, fe, log, pend, acked}:
      fe

# what an open after a crash that keeps the file reads
def pl.fin(k: Nat, s: Lg.St) -> List<&2, List<&2, Nat>>:
  match s:
    case Lg.St{de, fe, log, pend, acked}:
      Lg.recover(List.append(&2, Nat, Lg.render(log), Lg.cut(k, pend)))

def pl.pick(b: Bool, xs: List<&2, List<&2, Nat>>) -> List<&2, List<&2, Nat>>:
  match b:
    case True{}:
      xs
    case False{}:
      Nil{}

def pl.rl(+xs: List<&2, List<&2, Nat>>) -> {xs == Lg.recover(List.append(&2, Nat, Lg.render(xs), Nil{})) : List<&2, List<&2, Nat>>}:
  Equal.trans(List<&2, List<&2, Nat>>, xs, List.append(&2, List<&2, Nat>, xs, Nil{}), Lg.recover(List.append(&2, Nat, Lg.render(xs), Nil{})), pl.app_nil(List<&2, Nat>, xs), pl.recover_render(xs, Nil{}))

def pl.stays(b: Bool, +bytes: List<&2, Nat>) -> {pl.pick(b, Lg.recover(bytes)) == Lg.Disk.log(Lg.stays(b, bytes)) : List<&2, List<&2, Nat>>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pl.cr(+k: Nat, +drop: Bool, s: Lg.St) -> {pl.pick(Lg.keeps(drop, pl.de(s), pl.fe(s)), pl.fin(k, s)) == Lg.Disk.log(Lg.crash(k, drop, s)) : List<&2, List<&2, Nat>>}:
  match s:
    case Lg.St{+de, +fe, +log, +pend, acked}:
      pl.stays(Lg.keeps(drop, de, fe), List.append(&2, Nat, Lg.render(log), Lg.cut(k, pend)))

# a crash that keeps the file: the disk reads fin
def pl.surv(+k: Nat, +drop: Bool, +s: Lg.St, h: {True{} == Lg.keeps(drop, pl.de(s), pl.fe(s)) : Bool}) -> {pl.fin(k, s) == Lg.Disk.log(Lg.crash(k, drop, s)) : List<&2, List<&2, Nat>>}:
  +f = pl.fin(k, s)
  Equal.trans(List<&2, List<&2, Nat>>, f, pl.pick(Lg.keeps(drop, pl.de(s), pl.fe(s)), f), Lg.Disk.log(Lg.crash(k, drop, s)), (%h : {f == pl.pick(_, f) : List<&2, List<&2, Nat>>}; {==}), pl.cr(k, drop, s))

def pl.kt(drop: Bool) -> {True{} == Lg.keeps(drop, True{}, True{}) : Bool}:
  match drop:
    case True{}:
      {==}
    case False{}:
      {==}

# the commits after the first keep the flags
def pl.md(cs: List<&2, List<&2, Nat>>, +p: Nat, +de: Bool, +fe: Bool, +l: List<&2, List<&2, Nat>>, +a: List<&2, List<&2, Nat>>) -> {de == pl.de(Lg.more(cs, p, Lg.St{de, fe, l, None{}, a})) : Bool}:
  match cs:
    case Nil{}:
      {==}
    case +c <> rest:
      match p:
        case 0n:
          {==}
        case 1n+p1:
          match p1:
            case 0n:
              {==}
            case 1n+p2:
              pl.md(rest, p2, de, fe, List.append(&2, List<&2, Nat>, l, [c]), List.append(&2, List<&2, Nat>, a, [c]))

def pl.me(cs: List<&2, List<&2, Nat>>, +p: Nat, +de: Bool, +fe: Bool, +l: List<&2, List<&2, Nat>>, +a: List<&2, List<&2, Nat>>) -> {fe == pl.fe(Lg.more(cs, p, Lg.St{de, fe, l, None{}, a})) : Bool}:
  match cs:
    case Nil{}:
      {==}
    case +c <> rest:
      match p:
        case 0n:
          {==}
        case 1n+p1:
          match p1:
            case 0n:
              {==}
            case 1n+p2:
              pl.me(rest, p2, de, fe, List.append(&2, List<&2, Nat>, l, [c]), List.append(&2, List<&2, Nat>, a, [c]))

def pl.fd(cs: List<&2, List<&2, Nat>>, +q: Nat, +fe: Bool, +l: List<&2, List<&2, Nat>>) -> {True{} == pl.de(Lg.first(cs, q, Lg.St{True{}, fe, l, None{}, Nil{}})) : Bool}:
  match cs:
    case Nil{}:
      {==}
    case +c <> rest:
      match q:
        case 0n:
          {==}
        case 1n+q1:
          match q1:
            case 0n:
              {==}
            case 1n+q2:
              match q2:
                case 0n:
                  {==}
                case 1n+q3:
                  pl.md(rest, q3, True{}, True{}, List.append(&2, List<&2, Nat>, l, [c]), [c])

def pl.ffe(cs: List<&2, List<&2, Nat>>, +q: Nat, +de: Bool, +l: List<&2, List<&2, Nat>>) -> {True{} == pl.fe(Lg.first(cs, q, Lg.St{de, True{}, l, None{}, Nil{}})) : Bool}:
  match cs:
    case Nil{}:
      {==}
    case +c <> rest:
      match q:
        case 0n:
          {==}
        case 1n+q1:
          match q1:
            case 0n:
              {==}
            case 1n+q2:
              match q2:
                case 0n:
                  {==}
                case 1n+q3:
                  pl.me(rest, q3, de, True{}, List.append(&2, List<&2, Nat>, l, [c]), [c])

# Only a prefix of the commits
# ---------------------------

def pl.ml1_torn(+l: List<&2, List<&2, Nat>>, +c: List<&2, Nat>, +rest: List<&2, List<&2, Nat>>, +k: Nat, r: &n: Nat -> {log.pl.keep(k, c) == List.take(&2, List<&2, Nat>, c <> rest, n) : List<&2, List<&2, Nat>>}) -> &n: Nat -> {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, c <> rest, n)) == Lg.recover(List.append(&2, Nat, Lg.render(l), List.take(&2, Nat, Lg.line(c), k))) : List<&2, List<&2, Nat>>}:
  match r:
    case (+n, e):
      (n, (%pl.recover_render(l, List.take(&2, Nat, Lg.line(c), k)) : {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, c <> rest, n)) == _ : List<&2, List<&2, Nat>>}; %pl.torn(k, c) : {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, c <> rest, n)) == List.append(&2, List<&2, Nat>, l, _) : List<&2, List<&2, Nat>>}; %e : {List.append(&2, List<&2, Nat>, l, _) == List.append(&2, List<&2, Nat>, l, log.pl.keep(k, c)) : List<&2, List<&2, Nat>>}; {==}))

def pl.ml1_step(+l: List<&2, List<&2, Nat>>, +c: List<&2, Nat>, +rest: List<&2, List<&2, Nat>>, -f: List<&2, List<&2, Nat>>, r: &n: Nat -> {List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l, [c]), List.take(&2, List<&2, Nat>, rest, n)) == f : List<&2, List<&2, Nat>>}) -> &n: Nat -> {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, c <> rest, n)) == f : List<&2, List<&2, Nat>>}:
  match r:
    case (+n, e):
      (1n+n, Equal.trans(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, l, c <> List.take(&2, List<&2, Nat>, rest, n)), List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l, [c]), List.take(&2, List<&2, Nat>, rest, n)), f, pl.assoc(List<&2, Nat>, l, [c], List.take(&2, List<&2, Nat>, rest, n)), e))

def pl.ml1(cs: List<&2, List<&2, Nat>>, +p: Nat, +k: Nat, +de: Bool, +fe: Bool, +l: List<&2, List<&2, Nat>>, +a: List<&2, List<&2, Nat>>) -> &n: Nat -> {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, cs, n)) == pl.fin(k, Lg.more(cs, p, Lg.St{de, fe, l, None{}, a})) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      (0n, pl.recover_render(l, Nil{}))
    case +c <> +rest:
      match p:
        case 0n:
          (0n, pl.recover_render(l, Nil{}))
        case 1n+p1:
          match p1:
            case 0n:
              pl.ml1_torn(l, c, rest, k, pl.keep_take(k, c, rest))
            case 1n+p2:
              +l2 = List.append(&2, List<&2, Nat>, l, [c])
              +a2 = List.append(&2, List<&2, Nat>, a, [c])
              pl.ml1_step(l, c, rest, pl.fin(k, Lg.more(rest, p2, Lg.St{de, fe, l2, None{}, a2})), pl.ml1(rest, p2, k, de, fe, l2, a2))

def pl.f1(cs: List<&2, List<&2, Nat>>, +q: Nat, +k: Nat, +fe: Bool, +l: List<&2, List<&2, Nat>>) -> &n: Nat -> {List.append(&2, List<&2, Nat>, l, List.take(&2, List<&2, Nat>, cs, n)) == pl.fin(k, Lg.first(cs, q, Lg.St{True{}, fe, l, None{}, Nil{}})) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      (0n, pl.recover_render(l, Nil{}))
    case +c <> +rest:
      match q:
        case 0n:
          (0n, pl.recover_render(l, Nil{}))
        case 1n+q1:
          match q1:
            case 0n:
              pl.ml1_torn(l, c, rest, k, pl.keep_take(k, c, rest))
            case 1n+q2:
              match q2:
                case 0n:
                  +l2 = List.append(&2, List<&2, Nat>, l, [c])
                  (1n, (%pl.take0(List<&2, Nat>, rest) : {List.append(&2, List<&2, Nat>, l, c <> _) == Lg.recover(List.append(&2, Nat, Lg.render(l2), Nil{})) : List<&2, List<&2, Nat>>}; pl.rl(l2)))
                case 1n+q3:
                  +l2 = List.append(&2, List<&2, Nat>, l, [c])
                  pl.ml1_step(l, c, rest, pl.fin(k, Lg.more(rest, q3, Lg.St{True{}, True{}, l2, None{}, [c]})), pl.ml1(rest, q3, k, True{}, True{}, l2, [c]))

# The acknowledged commits are kept
# ---------------------------------

def pl.ml2(cs: List<&2, List<&2, Nat>>, +p: Nat, +k: Nat, +de: Bool, +fe: Bool, +l0: List<&2, List<&2, Nat>>, +l: List<&2, List<&2, Nat>>, +a: List<&2, List<&2, Nat>>, h: {l == List.append(&2, List<&2, Nat>, l0, a) : List<&2, List<&2, Nat>>}) -> &r: List<&2, List<&2, Nat>> -> {List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l0, Lg.St.acked(Lg.more(cs, p, Lg.St{de, fe, l, None{}, a}))), r) == pl.fin(k, Lg.more(cs, p, Lg.St{de, fe, l, None{}, a})) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      +la = List.append(&2, List<&2, Nat>, l0, a)
      (Nil{}, (%pl.recover_render(l, Nil{}) : {List.append(&2, List<&2, Nat>, la, Nil{}) == _ : List<&2, List<&2, Nat>>}; %h : {List.append(&2, List<&2, Nat>, _, Nil{}) == List.append(&2, List<&2, Nat>, l, Nil{}) : List<&2, List<&2, Nat>>}; {==}))
    case +c <> +rest:
      match p:
        case 0n:
          +la = List.append(&2, List<&2, Nat>, l0, a)
          (Nil{}, (%pl.recover_render(l, Nil{}) : {List.append(&2, List<&2, Nat>, la, Nil{}) == _ : List<&2, List<&2, Nat>>}; %h : {List.append(&2, List<&2, Nat>, _, Nil{}) == List.append(&2, List<&2, Nat>, l, Nil{}) : List<&2, List<&2, Nat>>}; {==}))
        case 1n+p1:
          match p1:
            case 0n:
              +la = List.append(&2, List<&2, Nat>, l0, a)
              (log.pl.keep(k, c), (%pl.recover_render(l, List.take(&2, Nat, Lg.line(c), k)) : {List.append(&2, List<&2, Nat>, la, log.pl.keep(k, c)) == _ : List<&2, List<&2, Nat>>}; %pl.torn(k, c) : {List.append(&2, List<&2, Nat>, la, log.pl.keep(k, c)) == List.append(&2, List<&2, Nat>, l, _) : List<&2, List<&2, Nat>>}; %h : {List.append(&2, List<&2, Nat>, _, log.pl.keep(k, c)) == List.append(&2, List<&2, Nat>, l, log.pl.keep(k, c)) : List<&2, List<&2, Nat>>}; {==}))
            case 1n+p2:
              +la = List.append(&2, List<&2, Nat>, l0, a)
              +a2 = List.append(&2, List<&2, Nat>, a, [c])
              pl.ml2(rest, p2, k, de, fe, l0, List.append(&2, List<&2, Nat>, l, [c]), a2, (%Equal.sym(List<&2, List<&2, Nat>>, l, la, h) : {List.append(&2, List<&2, Nat>, _, [c]) == List.append(&2, List<&2, Nat>, l0, a2) : List<&2, List<&2, Nat>>}; Equal.sym(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, l0, a2), List.append(&2, List<&2, Nat>, la, [c]), pl.assoc(List<&2, Nat>, l0, a, [c]))))

def pl.fa(cs: List<&2, List<&2, Nat>>, +q: Nat, +k: Nat, +fe: Bool, +l: List<&2, List<&2, Nat>>) -> &r: List<&2, List<&2, Nat>> -> {List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l, Lg.St.acked(Lg.first(cs, q, Lg.St{True{}, fe, l, None{}, Nil{}}))), r) == pl.fin(k, Lg.first(cs, q, Lg.St{True{}, fe, l, None{}, Nil{}})) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      pl.ml2(Nil{}, 0n, k, True{}, fe, l, l, Nil{}, pl.app_nil(List<&2, Nat>, l))
    case +c <> +rest:
      match q:
        case 0n:
          pl.ml2(Nil{}, 0n, k, True{}, fe, l, l, Nil{}, pl.app_nil(List<&2, Nat>, l))
        case 1n+q1:
          match q1:
            case 0n:
              pl.ml2([c], 1n, k, True{}, fe, l, l, Nil{}, pl.app_nil(List<&2, Nat>, l))
            case 1n+q2:
              match q2:
                case 0n:
                  +l2 = List.append(&2, List<&2, Nat>, l, [c])
                  ([c], (%pl.app_nil(List<&2, Nat>, l) : {List.append(&2, List<&2, Nat>, _, [c]) == Lg.recover(List.append(&2, Nat, Lg.render(l2), Nil{})) : List<&2, List<&2, Nat>>}; pl.rl(l2)))
                case 1n+q3:
                  +l2 = List.append(&2, List<&2, Nat>, l, [c])
                  pl.ml2(rest, q3, k, True{}, True{}, l, l2, [c], {==})

# The laws
# --------

def pl.oc_lift(-l0: List<&2, List<&2, Nat>>, -cs: List<&2, List<&2, Nat>>, -f: List<&2, List<&2, Nat>>, -d: List<&2, List<&2, Nat>>, r: &n: Nat -> {List.append(&2, List<&2, Nat>, l0, List.take(&2, List<&2, Nat>, cs, n)) == f : List<&2, List<&2, Nat>>}, s: {f == d : List<&2, List<&2, Nat>>}) -> &n: Nat -> {d == List.append(&2, List<&2, Nat>, l0, List.take(&2, List<&2, Nat>, cs, n)) : List<&2, List<&2, Nat>>}:
  match r:
    case (+n, e):
      (n, Equal.sym(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, l0, List.take(&2, List<&2, Nat>, cs, n)), d, Equal.trans(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, l0, List.take(&2, List<&2, Nat>, cs, n)), f, d, e, s)))

def pl.ad_lift(-l0: List<&2, List<&2, Nat>>, -a: List<&2, List<&2, Nat>>, -f: List<&2, List<&2, Nat>>, -d: List<&2, List<&2, Nat>>, r: &x: List<&2, List<&2, Nat>> -> {List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l0, a), x) == f : List<&2, List<&2, Nat>>}, s: {f == d : List<&2, List<&2, Nat>>}) -> &x: List<&2, List<&2, Nat>> -> {d == List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l0, a), x) : List<&2, List<&2, Nat>>}:
  match r:
    case (+x, e):
      (x, Equal.sym(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l0, a), x), d, Equal.trans(List<&2, List<&2, Nat>>, List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, l0, a), x), f, d, e, s)))

# both flags of the more commits after an absent file's first commit
def pl.mt(+drop: Bool, +rest: List<&2, List<&2, Nat>>, +q: Nat, +l: List<&2, List<&2, Nat>>, +a: List<&2, List<&2, Nat>>) -> {True{} == Lg.keeps(drop, pl.de(Lg.more(rest, q, Lg.St{True{}, True{}, l, None{}, a})), pl.fe(Lg.more(rest, q, Lg.St{True{}, True{}, l, None{}, a}))) : Bool}:
  +m = Lg.more(rest, q, Lg.St{True{}, True{}, l, None{}, a})
  %pl.md(rest, q, True{}, True{}, l, a) : {True{} == Lg.keeps(drop, _, pl.fe(m)) : Bool}
  %pl.me(rest, q, True{}, True{}, l, a) : {True{} == Lg.keeps(drop, True{}, _) : Bool}
  pl.kt(drop)

# both flags after a present file's commits
def pl.ft(+drop: Bool, +cs: List<&2, List<&2, Nat>>, +q: Nat, +l: List<&2, List<&2, Nat>>) -> {True{} == Lg.keeps(drop, pl.de(Lg.first(cs, q, Lg.St{True{}, True{}, l, None{}, Nil{}})), pl.fe(Lg.first(cs, q, Lg.St{True{}, True{}, l, None{}, Nil{}}))) : Bool}:
  +m = Lg.first(cs, q, Lg.St{True{}, True{}, l, None{}, Nil{}})
  %pl.fd(cs, q, True{}, l) : {True{} == Lg.keeps(drop, _, pl.fe(m)) : Bool}
  %pl.ffe(cs, q, True{}, l) : {True{} == Lg.keeps(drop, True{}, _) : Bool}
  pl.kt(drop)

# an absent file, a crash that drops the entries
def pl.only_drop(cs: List<&2, List<&2, Nat>>, +q: Nat, +k: Nat) -> &n: Nat -> {Lg.Disk.log(Lg.crash(k, True{}, Lg.first(cs, q, Lg.St{True{}, False{}, Nil{}, None{}, Nil{}}))) == List.take(&2, List<&2, Nat>, cs, n) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      (0n, {==})
    case +c <> +rest:
      match q:
        case 0n:
          (0n, {==})
        case 1n+q1:
          match q1:
            case 0n:
              (0n, {==})
            case 1n+q2:
              match q2:
                case 0n:
                  (0n, {==})
                case 1n+q3:
                  +m = Lg.more(rest, q3, Lg.St{True{}, True{}, [c], None{}, [c]})
                  pl.oc_lift(Nil{}, c <> rest, pl.fin(k, m), Lg.Disk.log(Lg.crash(k, True{}, m)), pl.ml1_step(Nil{}, c, rest, pl.fin(k, m), pl.ml1(rest, q3, k, True{}, True{}, [c], [c])), pl.surv(k, True{}, m, pl.mt(True{}, rest, q3, [c], [c])))

def pl.ack_drop(cs: List<&2, List<&2, Nat>>, +q: Nat, +k: Nat) -> &r: List<&2, List<&2, Nat>> -> {Lg.Disk.log(Lg.crash(k, True{}, Lg.first(cs, q, Lg.St{True{}, False{}, Nil{}, None{}, Nil{}}))) == List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, Nil{}, Lg.St.acked(Lg.first(cs, q, Lg.St{True{}, False{}, Nil{}, None{}, Nil{}}))), r) : List<&2, List<&2, Nat>>}:
  match cs:
    case Nil{}:
      (Nil{}, {==})
    case +c <> +rest:
      match q:
        case 0n:
          (Nil{}, {==})
        case 1n+q1:
          match q1:
            case 0n:
              (Nil{}, {==})
            case 1n+q2:
              match q2:
                case 0n:
                  (Nil{}, {==})
                case 1n+q3:
                  +m = Lg.more(rest, q3, Lg.St{True{}, True{}, [c], None{}, [c]})
                  pl.ad_lift(Nil{}, Lg.St.acked(m), pl.fin(k, m), Lg.Disk.log(Lg.crash(k, True{}, m)), pl.ml2(rest, q3, k, True{}, True{}, Nil{}, [c], [c], {==}), pl.surv(k, True{}, m, pl.mt(True{}, rest, q3, [c], [c])))

# the law log_only_commits
def pl.only(d: Lg.Disk, e: Lg.Epoch) -> &n: Nat -> {Lg.Disk.log(Lg.after(d, e)) == List.append(&2, List<&2, Nat>, Lg.Disk.log(d), List.take(&2, List<&2, Nat>, Lg.Epoch.cs(e), n)) : List<&2, List<&2, Nat>>}:
  match d:
    case Lg.Absent{}:
      match e:
        case Lg.Epoch{+cs, +p, +k, drop}:
          match p:
            case 0n:
              match drop:
                case True{}:
                  (0n, pl.take0(List<&2, Nat>, cs))
                case False{}:
                  (0n, pl.take0(List<&2, Nat>, cs))
            case 1n+q:
              match drop:
                case True{}:
                  pl.only_drop(cs, q, k)
                case False{}:
                  +m = Lg.first(cs, q, Lg.St{True{}, False{}, Nil{}, None{}, Nil{}})
                  pl.oc_lift(Nil{}, cs, pl.fin(k, m), Lg.Disk.log(Lg.crash(k, False{}, m)), pl.f1(cs, q, k, False{}, Nil{}), pl.surv(k, False{}, m, {==}))
    case Lg.Present{+b}:
      match e:
        case Lg.Epoch{+cs, +p, +k, +drop}:
          match p:
            case 0n:
              +r = Lg.recover(b)
              +s = {Lg.St{True{}, True{}, r, None{}, Nil{}} : Lg.St}
              pl.oc_lift(r, cs, pl.fin(k, s), Lg.Disk.log(Lg.crash(k, drop, s)), (0n, (%pl.take0(List<&2, Nat>, cs) : {List.append(&2, List<&2, Nat>, r, _) == pl.fin(k, s) : List<&2, List<&2, Nat>>}; pl.recover_render(r, Nil{}))), pl.surv(k, drop, s, pl.kt(drop)))
            case 1n+q:
              +r = Lg.recover(b)
              +m = Lg.first(cs, q, Lg.St{True{}, True{}, r, None{}, Nil{}})
              pl.oc_lift(r, cs, pl.fin(k, m), Lg.Disk.log(Lg.crash(k, drop, m)), pl.f1(cs, q, k, True{}, r), pl.surv(k, drop, m, pl.ft(drop, cs, q, r)))

# the law log_ack_durable
def pl.ack(d: Lg.Disk, e: Lg.Epoch) -> &x: List<&2, List<&2, Nat>> -> {Lg.Disk.log(Lg.after(d, e)) == List.append(&2, List<&2, Nat>, List.append(&2, List<&2, Nat>, Lg.Disk.log(d), Lg.acked(d, e)), x) : List<&2, List<&2, Nat>>}:
  match d:
    case Lg.Absent{}:
      match e:
        case Lg.Epoch{+cs, +p, +k, drop}:
          match p:
            case 0n:
              match drop:
                case True{}:
                  (Nil{}, {==})
                case False{}:
                  (Nil{}, {==})
            case 1n+q:
              match drop:
                case True{}:
                  pl.ack_drop(cs, q, k)
                case False{}:
                  +m = Lg.first(cs, q, Lg.St{True{}, False{}, Nil{}, None{}, Nil{}})
                  pl.ad_lift(Nil{}, Lg.St.acked(m), pl.fin(k, m), Lg.Disk.log(Lg.crash(k, False{}, m)), pl.fa(cs, q, k, False{}, Nil{}), pl.surv(k, False{}, m, {==}))
    case Lg.Present{+b}:
      match e:
        case Lg.Epoch{+cs, +p, +k, +drop}:
          match p:
            case 0n:
              +r = Lg.recover(b)
              +s = {Lg.St{True{}, True{}, r, None{}, Nil{}} : Lg.St}
              pl.ad_lift(r, Nil{}, pl.fin(k, s), Lg.Disk.log(Lg.crash(k, drop, s)), pl.ml2(Nil{}, 0n, k, True{}, True{}, r, r, Nil{}, pl.app_nil(List<&2, Nat>, r)), pl.surv(k, drop, s, pl.kt(drop)))
            case 1n+q:
              +r = Lg.recover(b)
              +m = Lg.first(cs, q, Lg.St{True{}, True{}, r, None{}, Nil{}})
              pl.ad_lift(r, Lg.St.acked(m), pl.fin(k, m), Lg.Disk.log(Lg.crash(k, drop, m)), pl.fa(cs, q, k, True{}, r), pl.surv(k, drop, m, pl.ft(drop, cs, q, r)))

# ---- staging ----

# proof_staging: the staging, sweep and listing laws of LAWS.bend section storage
# (D2): a publish never takes a name that is taken; a sweep never removes
# a held, young or unreached entry, and removes every stale free leftover
# it reaches; a session is listed once, under the storage it opens as.

# Logic and numbers
# -----------------

def pg.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pg.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pg.BD(_, Unit, A)
  Unit{}

def pg.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pg.absurd({0n == 1n+q : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 0n:
      pg.absurd({1n+p == 0n : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 1n+q:
      %pg.eq_true(p, q, h) : {1n+p == 1n+_ : Nat}
      {==}

def pg.eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pg.eq_refl(p)

def pg.or_t(a: Bool) -> {Bool.or(a, True{}) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pg.or_f(a: Bool) -> {a == Bool.or(a, False{}) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

# Publish
# -------

def pg.publish_taken(+s: Nat, +t: Nat, +es: List<&2, Sg.Entry>, taken: {Sg.has(t, es) == True{} : Bool}) -> {Sg.publish(s, t, es) == Sg.Pub{False{}, es} : Sg.Pub}:
  %Equal.sym(Bool, Sg.has(t, es), True{}, taken) : {Sg.publish.go(s, t, _, es) == Sg.Pub{False{}, es} : Sg.Pub}
  {==}

def pg.publish_free(+s: Nat, +t: Nat, +es: List<&2, Sg.Entry>, free: {Sg.has(t, es) == False{} : Bool}) -> {Sg.Pub.ok(Sg.publish(s, t, es)) == True{} : Bool}:
  %Equal.sym(Bool, Sg.has(t, es), False{}, free) : {Sg.Pub.ok(Sg.publish.go(s, t, _, es)) == True{} : Bool}
  {==}

# Sweep
# -----

def pg.put_app(+n: Sg.Node, a: List<&2, Sg.Node>, +c: List<&2, Sg.Node>, b: Bool) -> {Sg.sweep.put(n, List.append(&2, Sg.Node, a, c), b) == List.append(&2, Sg.Node, Sg.sweep.put(n, a, b), c) : List<&2, Sg.Node>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pg.sweep_app(pre: List<&2, Sg.Node>, +x: List<&2, Sg.Node>) -> {List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(x)) == Sg.sweep(List.append(&2, Sg.Node, pre, x)) : List<&2, Sg.Node>}:
  match pre:
    case Nil{}:
      {==}
    case +n <> +rest:
      %pg.put_app(n, Sg.sweep(rest), Sg.sweep(x), Sg.removes(n)) : {_ == Sg.sweep.put(n, Sg.sweep(List.append(&2, Sg.Node, rest, x)), Sg.removes(n)) : List<&2, Sg.Node>}
      %pg.sweep_app(rest, x) : {Sg.sweep.put(n, List.append(&2, Sg.Node, Sg.sweep(rest), Sg.sweep(x)), Sg.removes(n)) == Sg.sweep.put(n, _, Sg.removes(n)) : List<&2, Sg.Node>}
      {==}

# a node the sweep keeps: the sweep of the whole is the sweep of the parts
def pg.kept(+pre: List<&2, Sg.Node>, +n: Sg.Node, +post: List<&2, Sg.Node>, no: {False{} == Sg.removes(n) : Bool}) -> {Sg.sweep(List.append(&2, Sg.Node, pre, n <> post)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}:
  %pg.sweep_app(pre, n <> post) : {_ == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}
  %no : {List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep.put(n, Sg.sweep(post), _)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}
  {==}

def pg.no_held(+i: Nat, +k: Sg.Sort, +s: Bool, o: Bool) -> {False{} == Sg.removes(Sg.Node{i, k, True{}, s, o}) : Bool}:
  match o:
    case True{}:
      {==}
    case False{}:
      {==}

def pg.no_young(+i: Nat, +k: Sg.Sort, h: Bool, o: Bool) -> {False{} == Sg.removes(Sg.Node{i, k, h, False{}, o}) : Bool}:
  match h o:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def pg.sweep_never_live(+pre: List<&2, Sg.Node>, +i: Nat, +k: Sg.Sort, +s: Bool, +o: Bool, +post: List<&2, Sg.Node>) -> {Sg.sweep(List.append(&2, Sg.Node, pre, Sg.Node{i, k, True{}, s, o} <> post)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}:
  pg.kept(pre, Sg.Node{i, k, True{}, s, o}, post, pg.no_held(i, k, s, o))

def pg.sweep_never_young(+pre: List<&2, Sg.Node>, +i: Nat, +k: Sg.Sort, +h: Bool, +o: Bool, +post: List<&2, Sg.Node>) -> {Sg.sweep(List.append(&2, Sg.Node, pre, Sg.Node{i, k, h, False{}, o} <> post)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}:
  pg.kept(pre, Sg.Node{i, k, h, False{}, o}, post, pg.no_young(i, k, h, o))

def pg.sweep_stays_out(+pre: List<&2, Sg.Node>, +i: Nat, +k: Sg.Sort, +h: Bool, +s: Bool, +post: List<&2, Sg.Node>) -> {Sg.sweep(List.append(&2, Sg.Node, pre, Sg.Node{i, k, h, s, False{}} <> post)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep(post)) : List<&2, Sg.Node>}:
  pg.kept(pre, Sg.Node{i, k, h, s, False{}}, post, {==})

def pg.sweep_reaches(+pre: List<&2, Sg.Node>, +i: Nat, +k: Sg.Sort, +post: List<&2, Sg.Node>, sw: {Sg.Sort.swept(k) == True{} : Bool}) -> {Sg.sweep(List.append(&2, Sg.Node, pre, Sg.Node{i, k, False{}, True{}, True{}} <> post)) == List.append(&2, Sg.Node, Sg.sweep(pre), Sg.Node{i, k, False{}, True{}, True{}} <> Sg.sweep(post)) : List<&2, Sg.Node>}:
  +n = {Sg.Node{i, k, False{}, True{}, True{}} : Sg.Node}
  %pg.sweep_app(pre, n <> post) : {_ == List.append(&2, Sg.Node, Sg.sweep(pre), n <> Sg.sweep(post)) : List<&2, Sg.Node>}
  %Equal.sym(Bool, Sg.Sort.swept(k), True{}, sw) : {List.append(&2, Sg.Node, Sg.sweep(pre), Sg.sweep.put(n, Sg.sweep(post), _)) == List.append(&2, Sg.Node, Sg.sweep(pre), n <> Sg.sweep(post)) : List<&2, Sg.Node>}
  {==}

# Listing
# -------

def pg.or_mono(a: Bool, -x: Bool, -y: Bool, h: {Bool.or(a, x) == True{} : Bool}, f: {x == True{} : Bool} -> {y == True{} : Bool}) -> {Bool.or(a, y) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      f(h)

def pg.or_r(a: Bool, -y: Bool, h: {y == True{} : Bool}) -> {Bool.or(a, y) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

# a storage listed is a directory of that name
def pg.dur_put(+m: Nat, +n: Nat, -d: List<&2, Nat>, -r: List<&2, Sg.Ent>, q: Bool, h: {Sg.mem(n, Sg.keep.put(m, d, q)) == True{} : Bool}, ih: {Sg.mem(n, d) == True{} : Bool} -> {Sg.dirn(n, r) == True{} : Bool}) -> {Bool.or(Nat.is_eq(m, n), Sg.dirn(n, r)) == True{} : Bool}:
  match q:
    case True{}:
      pg.or_mono(Nat.is_eq(m, n), Sg.mem(n, d), Sg.dirn(n, r), h, ih)
    case False{}:
      pg.or_r(Nat.is_eq(m, n), Sg.dirn(n, r), ih(h))

def pg.dur_dirn(+n: Nat, es: List<&2, Sg.Ent>, h: {Sg.mem(n, Sg.durables(es)) == True{} : Bool}) -> {Sg.dirn(n, es) == True{} : Bool}:
  match es:
    case Nil{}:
      pg.absurd({Sg.dirn(n, Nil{}) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case e <> +rest:
      match e:
        case Sg.Dir{+m, a, hd, c}:
          pg.dur_put(m, n, Sg.durables(rest), rest, Bool.and(a, Bool.and(Bool.not(hd), c)), h, hh => pg.dur_dirn(n, rest, hh))
        case Sg.Legacy{s, r}:
          pg.dur_dirn(n, rest, h)

def pg.and_not(r: Bool, d: Bool, h: {Bool.and(r, Bool.not(d)) == True{} : Bool}) -> {d == False{} : Bool}:
  match r d:
    case True{} True{}:
      pg.absurd({True{} == False{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case True{} False{}:
      {==}
    case False{} True{}:
      pg.absurd({True{} == False{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case False{} False{}:
      {==}

def pg.leg_hit(-all: List<&2, Sg.Ent>, +n: Nat, +s: Nat, -l: List<&2, Nat>, b: Bool, eb: {Nat.is_eq(s, n) == b : Bool}, h: {Bool.or(b, Sg.mem(n, l)) == True{} : Bool}, nd: {Sg.dirn(s, all) == False{} : Bool}, ih: {Sg.mem(n, l) == True{} : Bool} -> {Sg.dirn(n, all) == False{} : Bool}) -> {Sg.dirn(n, all) == False{} : Bool}:
  match b:
    case True{}:
      %pg.eq_true(s, n, eb) : {Sg.dirn(_, all) == False{} : Bool}
      nd
    case False{}:
      ih(h)

def pg.leg_put(+all: List<&2, Sg.Ent>, +n: Nat, +s: Nat, +r: Bool, -l: List<&2, Nat>, q: Bool, eq: {Bool.and(r, Bool.not(Sg.dirn(s, all))) == q : Bool}, h: {Sg.mem(n, Sg.keep.put(s, l, q)) == True{} : Bool}, ih: {Sg.mem(n, l) == True{} : Bool} -> {Sg.dirn(n, all) == False{} : Bool}) -> {Sg.dirn(n, all) == False{} : Bool}:
  match q:
    case True{}:
      pg.leg_hit(all, n, s, l, Nat.is_eq(s, n), {==}, h, pg.and_not(r, Sg.dirn(s, all), eq), ih)
    case False{}:
      ih(h)

# a legacy file listed has no directory of its name
def pg.leg_dirn(+all: List<&2, Sg.Ent>, +n: Nat, es: List<&2, Sg.Ent>, h: {Sg.mem(n, Sg.legacies(all, es)) == True{} : Bool}) -> {Sg.dirn(n, all) == False{} : Bool}:
  match es:
    case Nil{}:
      pg.absurd({Sg.dirn(n, all) == False{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case e <> +rest:
      match e:
        case Sg.Dir{m, a, hd, c}:
          pg.leg_dirn(all, n, rest, h)
        case Sg.Legacy{+s, +r}:
          pg.leg_put(all, n, s, r, Sg.legacies(all, rest), Bool.and(r, Bool.not(Sg.dirn(s, all))), {==}, h, hh => pg.leg_dirn(all, n, rest, hh))

def pg.one_go(+es: List<&2, Sg.Ent>, +n: Nat, b1: Bool, e1: {Sg.mem(n, Sg.durables(es)) == b1 : Bool}, b2: Bool, e2: {Sg.mem(n, Sg.legacies(es, es)) == b2 : Bool}) -> {Bool.and(b1, b2) == False{} : Bool}:
  match b1 b2:
    case True{} True{}:
      pg.absurd({True{} == False{} : Bool}, Equal.trans(Bool, True{}, Sg.dirn(n, es), False{}, Equal.sym(Bool, Sg.dirn(n, es), True{}, pg.dur_dirn(n, es, e1)), pg.leg_dirn(es, n, es, e2)))
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# the law list_one_location
def pg.one_location(+es: List<&2, Sg.Ent>, +n: Nat) -> {Bool.and(Sg.mem(n, Sg.durables(es)), Sg.mem(n, Sg.legacies(es, es))) == False{} : Bool}:
  pg.one_go(es, n, Sg.mem(n, Sg.durables(es)), {==}, Sg.mem(n, Sg.legacies(es, es)), {==})

# An import
# ---------

def pg.or_assoc(a: Bool, +b: Bool, +c: Bool) -> {Bool.or(Bool.or(a, b), c) == Bool.or(a, Bool.or(b, c)) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pg.mem_app(+n: Nat, a: List<&2, Nat>, +b: List<&2, Nat>) -> {Bool.or(Sg.mem(n, a), Sg.mem(n, b)) == Sg.mem(n, List.append(&2, Nat, a, b)) : Bool}:
  match a:
    case Nil{}:
      {==}
    case +x <> +rest:
      %pg.mem_app(n, rest, b) : {Bool.or(Bool.or(Nat.is_eq(x, n), Sg.mem(n, rest)), Sg.mem(n, b)) == Bool.or(Nat.is_eq(x, n), _) : Bool}
      pg.or_assoc(Nat.is_eq(x, n), Sg.mem(n, rest), Sg.mem(n, b))

def pg.kput_app(+m: Nat, a: List<&2, Nat>, +c: List<&2, Nat>, q: Bool) -> {Sg.keep.put(m, List.append(&2, Nat, a, c), q) == List.append(&2, Nat, Sg.keep.put(m, a, q), c) : List<&2, Nat>}:
  match q:
    case True{}:
      {==}
    case False{}:
      {==}

def pg.dur_app(es: List<&2, Sg.Ent>, +x: List<&2, Sg.Ent>) -> {List.append(&2, Nat, Sg.durables(es), Sg.durables(x)) == Sg.durables(List.append(&2, Sg.Ent, es, x)) : List<&2, Nat>}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Sg.Dir{+m, +a, +hd, +c}:
          +q = Bool.and(a, Bool.and(Bool.not(hd), c))
          %pg.kput_app(m, Sg.durables(rest), Sg.durables(x), q) : {_ == Sg.keep.put(m, Sg.durables(List.append(&2, Sg.Ent, rest, x)), q) : List<&2, Nat>}
          %pg.dur_app(rest, x) : {Sg.keep.put(m, List.append(&2, Nat, Sg.durables(rest), Sg.durables(x)), q) == Sg.keep.put(m, _, q) : List<&2, Nat>}
          {==}
        case Sg.Legacy{s, r}:
          pg.dur_app(rest, x)

# the law list_import_lists_storage
def pg.import_lists(+es: List<&2, Sg.Ent>, +s: Nat) -> {Sg.mem(s, Sg.durables(Sg.imported(s, es))) == True{} : Bool}:
  +d = {[Sg.Dir{s, True{}, False{}, True{}}] : List<&2, Sg.Ent>}
  %pg.dur_app(es, d) : {Sg.mem(s, _) == True{} : Bool}
  %pg.mem_app(s, Sg.durables(es), [s]) : {_ == True{} : Bool}
  %Equal.sym(Bool, Nat.is_eq(s, s), True{}, pg.eq_refl(s)) : {Bool.or(Sg.mem(s, Sg.durables(es)), Bool.or(_, False{})) == True{} : Bool}
  pg.or_t(Sg.mem(s, Sg.durables(es)))

def pg.dirn_app(+n: Nat, es: List<&2, Sg.Ent>, +x: List<&2, Sg.Ent>) -> {Bool.or(Sg.dirn(n, es), Sg.dirn(n, x)) == Sg.dirn(n, List.append(&2, Sg.Ent, es, x)) : Bool}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Sg.Dir{+m, a, hd, c}:
          %pg.dirn_app(n, rest, x) : {Bool.or(Bool.or(Nat.is_eq(m, n), Sg.dirn(n, rest)), Sg.dirn(n, x)) == Bool.or(Nat.is_eq(m, n), _) : Bool}
          pg.or_assoc(Nat.is_eq(m, n), Sg.dirn(n, rest), Sg.dirn(n, x))
        case Sg.Legacy{st, r}:
          pg.dirn_app(n, rest, x)

# with the directory s added, dirn is the same for a name that is not s
def pg.dirn_other(+n: Nat, +all: List<&2, Sg.Ent>, +s: Nat, ne: {Nat.is_eq(s, n) == False{} : Bool}) -> {Sg.dirn(n, all) == Sg.dirn(n, Sg.imported(s, all)) : Bool}:
  %pg.dirn_app(n, all, [Sg.Dir{s, True{}, False{}, True{}}]) : {Sg.dirn(n, all) == _ : Bool}
  %Equal.sym(Bool, Nat.is_eq(s, n), False{}, ne) : {Sg.dirn(n, all) == Bool.or(Sg.dirn(n, all), Bool.or(_, False{})) : Bool}
  pg.or_f(Sg.dirn(n, all))

def pg.mem_miss(+st: Nat, +n: Nat, +l: List<&2, Nat>, q: Bool, ec: {Nat.is_eq(st, n) == False{} : Bool}) -> {Sg.mem(n, l) == Sg.mem(n, Sg.keep.put(st, l, q)) : Bool}:
  match q:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(st, n), False{}, ec) : {Sg.mem(n, l) == Bool.or(_, Sg.mem(n, l)) : Bool}
      {==}
    case False{}:
      {==}

def pg.mem_same(+n: Nat, +l1: List<&2, Nat>, +l2: List<&2, Nat>, q: Bool, ih: {Sg.mem(n, l1) == Sg.mem(n, l2) : Bool}) -> {Sg.mem(n, Sg.keep.put(n, l1, q)) == Sg.mem(n, Sg.keep.put(n, l2, q)) : Bool}:
  match q:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(n, n), True{}, pg.eq_refl(n)) : {Bool.or(_, Sg.mem(n, l1)) == Bool.or(_, Sg.mem(n, l2)) : Bool}
      {==}
    case False{}:
      ih

def pg.leg_step(c: Bool, +st: Nat, +r: Bool, +n: Nat, +all: List<&2, Sg.Ent>, +s: Nat, +l1: List<&2, Nat>, +l2: List<&2, Nat>, +ec: {Nat.is_eq(st, n) == c : Bool}, ne: {Nat.is_eq(s, n) == False{} : Bool}, ih: {Sg.mem(n, l1) == Sg.mem(n, l2) : Bool}) -> {Sg.mem(n, Sg.keep.put(st, l1, Bool.and(r, Bool.not(Sg.dirn(st, Sg.imported(s, all)))))) == Sg.mem(n, Sg.keep.put(st, l2, Bool.and(r, Bool.not(Sg.dirn(st, all))))) : Bool}:
  match c:
    case True{}:
      %Equal.sym(Nat, st, n, pg.eq_true(st, n, ec)) : {Sg.mem(n, Sg.keep.put(_, l1, Bool.and(r, Bool.not(Sg.dirn(_, Sg.imported(s, all)))))) == Sg.mem(n, Sg.keep.put(_, l2, Bool.and(r, Bool.not(Sg.dirn(_, all))))) : Bool}
      %pg.dirn_other(n, all, s, ne) : {Sg.mem(n, Sg.keep.put(n, l1, Bool.and(r, Bool.not(_)))) == Sg.mem(n, Sg.keep.put(n, l2, Bool.and(r, Bool.not(Sg.dirn(n, all))))) : Bool}
      pg.mem_same(n, l1, l2, Bool.and(r, Bool.not(Sg.dirn(n, all))), ih)
    case False{}:
      %pg.mem_miss(st, n, l1, Bool.and(r, Bool.not(Sg.dirn(st, Sg.imported(s, all)))), ec) : {_ == Sg.mem(n, Sg.keep.put(st, l2, Bool.and(r, Bool.not(Sg.dirn(st, all))))) : Bool}
      %pg.mem_miss(st, n, l2, Bool.and(r, Bool.not(Sg.dirn(st, all))), ec) : {Sg.mem(n, l1) == _ : Bool}
      ih

# the legacy files listed with the directory s added, for a name not s
def pg.leg_other(+all: List<&2, Sg.Ent>, +s: Nat, +n: Nat, ys: List<&2, Sg.Ent>, +ne: {Nat.is_eq(s, n) == False{} : Bool}) -> {Sg.mem(n, Sg.legacies(Sg.imported(s, all), ys)) == Sg.mem(n, Sg.legacies(all, ys)) : Bool}:
  match ys:
    case Nil{}:
      {==}
    case y <> +rest:
      match y:
        case Sg.Dir{m, a, hd, c}:
          pg.leg_other(all, s, n, rest, ne)
        case Sg.Legacy{+st, +r}:
          pg.leg_step(Nat.is_eq(st, n), st, r, n, all, s, Sg.legacies(Sg.imported(s, all), rest), Sg.legacies(all, rest), {==}, ne, pg.leg_other(all, s, n, rest, ne))

def pg.leg_tail(+all: List<&2, Sg.Ent>, es: List<&2, Sg.Ent>, +x: List<&2, Sg.Ent>) -> {List.append(&2, Nat, Sg.legacies(all, es), Sg.legacies(all, x)) == Sg.legacies(all, List.append(&2, Sg.Ent, es, x)) : List<&2, Nat>}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Sg.Dir{m, a, hd, c}:
          pg.leg_tail(all, rest, x)
        case Sg.Legacy{+st, +r}:
          +q = Bool.and(r, Bool.not(Sg.dirn(st, all)))
          %pg.kput_app(st, Sg.legacies(all, rest), Sg.legacies(all, x), q) : {_ == Sg.keep.put(st, Sg.legacies(all, List.append(&2, Sg.Ent, rest, x)), q) : List<&2, Nat>}
          %pg.leg_tail(all, rest, x) : {Sg.keep.put(st, List.append(&2, Nat, Sg.legacies(all, rest), Sg.legacies(all, x)), q) == Sg.keep.put(st, _, q) : List<&2, Nat>}
          {==}

# the law list_import_keeps_others
def pg.app_nil(xs: List<&2, Nat>) -> {xs == List.append(&2, Nat, xs, Nil{}) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> rest:
      %pg.app_nil(rest) : {x <> rest == x <> _ : List<&2, Nat>}
      {==}

def pg.import_keeps(+es: List<&2, Sg.Ent>, +s: Nat, +n: Nat, +ne: {Nat.is_eq(s, n) == False{} : Bool}) -> {Sg.mem(n, Sg.listing(Sg.imported(s, es))) == Sg.mem(n, Sg.listing(es)) : Bool}:
  +d = {[Sg.Dir{s, True{}, False{}, True{}}] : List<&2, Sg.Ent>}
  +all = Sg.imported(s, es)
  +ds = List.append(&2, Nat, Sg.durables(es), [s])
  %pg.dur_app(es, d) : {Sg.mem(n, List.append(&2, Nat, _, Sg.legacies(all, all))) == Sg.mem(n, Sg.listing(es)) : Bool}
  %pg.leg_tail(all, es, d) : {Sg.mem(n, List.append(&2, Nat, ds, _)) == Sg.mem(n, Sg.listing(es)) : Bool}
  %pg.mem_app(n, ds, List.append(&2, Nat, Sg.legacies(all, es), Nil{})) : {_ == Sg.mem(n, Sg.listing(es)) : Bool}
  %pg.app_nil(Sg.legacies(all, es)) : {Bool.or(Sg.mem(n, ds), Sg.mem(n, _)) == Sg.mem(n, Sg.listing(es)) : Bool}
  %pg.mem_app(n, Sg.durables(es), [s]) : {Bool.or(_, Sg.mem(n, Sg.legacies(all, es))) == Sg.mem(n, Sg.listing(es)) : Bool}
  %Equal.sym(Bool, Nat.is_eq(s, n), False{}, ne) : {Bool.or(Bool.or(Sg.mem(n, Sg.durables(es)), Bool.or(_, False{})), Sg.mem(n, Sg.legacies(all, es))) == Sg.mem(n, Sg.listing(es)) : Bool}
  %pg.or_f(Sg.mem(n, Sg.durables(es))) : {Bool.or(_, Sg.mem(n, Sg.legacies(all, es))) == Sg.mem(n, Sg.listing(es)) : Bool}
  %Equal.sym(Bool, Sg.mem(n, Sg.legacies(all, es)), Sg.mem(n, Sg.legacies(es, es)), pg.leg_other(es, s, n, es, ne)) : {Bool.or(Sg.mem(n, Sg.durables(es)), _) == Sg.mem(n, Sg.listing(es)) : Bool}
  pg.mem_app(n, Sg.durables(es), Sg.legacies(es, es))

# ---- recover ----

# proof_recover: the H4.8 recovery laws of LAWS.bend about the
# recoveries (Rec) of bend/run.bend.
#
# - the one-step laws (length, leak, repeat, a user message): by
#   computation, after a rewrite of each cap test with its premise.
# - stuck_gets_help: by computation on each stuck reply and each value
#   of its cap tests: no branch passes the reply on as it is.
# - notes_capped: an invariant of the recoveries, by induction on the
#   replies. A recovery adds a note only under its cap, so the row of
#   the next note is at most the cap of its recovery.
# - never_runs_a_repeat: an invariant, by induction on the replies. Calls
#   run only when the rounds in a row that they make stay below the
#   repeat cap (and a round whose results change starts a new row of 1,
#   which is below the cap too, as the call ran); every other reply keeps
#   the count or clears it.

# Numbers
# -------

def max_zero(n: Nat) -> {Nat.max(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

# m < b, so m < max(b, 1)
def below_max(m: Nat, b: Nat, e: {Rn.below(m, b) == True{} : Bool}) -> {Rn.below(m, Nat.max(b, 1n)) == True{} : Bool}:
  match m b:
    case 0n 0n:
      absurd({Rn.below(0n, Nat.max(0n, 1n)) == True{} : Bool}, e)
    case 1n+p 0n:
      absurd({Rn.below(1n+p, Nat.max(0n, 1n)) == True{} : Bool}, e)
    case m 1n+q:
      %Equal.sym(Nat, Nat.max(q, 0n), q, max_zero(q)) : {Rn.below(m, 1n+_) == True{} : Bool}
      e

def zero_below_max(b: Nat) -> {Rn.below(0n, Nat.max(b, 1n)) == True{} : Bool}:
  match b:
    case 0n:
      {==}
    case 1n+q:
      {==}

# x < q, so 0 < q
def one_below_q(x: Nat, q: Nat, e: {Rn.below(x, q) == True{} : Bool}) -> {Rn.below(0n, q) == True{} : Bool}:
  match x q:
    case 0n 0n:
      absurd({Rn.below(0n, 0n) == True{} : Bool}, e)
    case 1n+p 0n:
      absurd({Rn.below(0n, 0n) == True{} : Bool}, e)
    case x 1n+r:
      {==}

# 0 < m and m < b, so 1 < max(b, 1)
def one_below_max(m: Nat, +b: Nat, pos: {Rn.below(0n, m) == True{} : Bool}, e: {Rn.below(m, b) == True{} : Bool}) -> {Rn.below(1n, Nat.max(b, 1n)) == True{} : Bool}:
  match m b:
    case 0n b:
      absurd({Rn.below(1n, Nat.max(b, 1n)) == True{} : Bool}, pos)
    case 1n+x 0n:
      absurd({Rn.below(1n, Nat.max(0n, 1n)) == True{} : Bool}, e)
    case 1n+x 1n+q:
      %Equal.sym(Nat, Nat.max(q, 0n), q, max_zero(q)) : {Rn.below(1n, 1n+_) == True{} : Bool}
      one_below_q(x, q, e)

def again_eq_pos(b: Bool, k: Nat) -> {Rn.below(0n, Rn.again.eq(b, k)) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# a round makes at least one round in a row
def again_pos(same: Nat, +last: Nat, +h: Nat) -> {Rn.below(0n, Rn.again(same, last, h)) == True{} : Bool}:
  match same:
    case 0n:
      {==}
    case 1n+k:
      again_eq_pos(Nat.is_eq(last, h), k)

# The one-step laws
# -----------------

def length_retries_with_a_note(+rc: Rn.RCfg, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, under: {Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)) == True{} : Bool}) -> {Rn.Rec.step(rc, Rn.Long{}, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Longs{}, 1n+Rn.Rk.longs(k, row), same, last}} : Rn.Dec}:
  %Equal.sym(Bool, Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)), True{}, under) : {Rn.rec.long(_, Rn.Rk.longs(k, row), same, last, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Longs{}, 1n+Rn.Rk.longs(k, row), same, last}} : Rn.Dec}
  {==}

def length_gives_up(+rc: Rn.RCfg, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, over: {Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)) == False{} : Bool}) -> {Rn.Dec.act(Rn.Rec.step(rc, Rn.Long{}, Rn.Rec{k, row, same, last})) == Rn.Quit{} : Rn.Act}:
  %Equal.sym(Bool, Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)), False{}, over) : {Rn.Dec.act(Rn.rec.long(_, Rn.Rk.longs(k, row), same, last, Rn.Rec{k, row, same, last})) == Rn.Quit{} : Rn.Act}
  {==}

def leak_rebuilt_is_calls(+rc: Rn.RCfg, +h: Nat, kept: Bool, r: Rn.Rec) -> {Rn.Rec.step(rc, Rn.Leak{True{}, h, kept}, r) == Rn.Rec.step(rc, Rn.Ran{h, kept}, r) : Rn.Dec}:
  match r:
    case Rn.Rec{k, row, same, last}:
      {==}

def leak_retries_with_a_note(+rc: Rn.RCfg, +h: Nat, kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, under: {Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)) == True{} : Bool}) -> {Rn.Rec.step(rc, Rn.Leak{False{}, h, kept}, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Leaks{}, 1n+Rn.Rk.leaks(k, row), same, last}} : Rn.Dec}:
  %Equal.sym(Bool, Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)), True{}, under) : {Rn.rec.leak(_, Rn.Rk.leaks(k, row), same, last, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Leaks{}, 1n+Rn.Rk.leaks(k, row), same, last}} : Rn.Dec}
  {==}

def leak_stands(+rc: Rn.RCfg, +h: Nat, kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, over: {Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)) == False{} : Bool}) -> {Rn.Dec.act(Rn.Rec.step(rc, Rn.Leak{False{}, h, kept}, Rn.Rec{k, row, same, last})) == Rn.Stand{} : Rn.Act}:
  %Equal.sym(Bool, Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)), False{}, over) : {Rn.Dec.act(Rn.rec.leak(_, Rn.Rk.leaks(k, row), same, last, Rn.Rec{k, row, same, last})) == Rn.Stand{} : Rn.Act}
  {==}

def calls_run(+rc: Rn.RCfg, +h: Nat, +kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, fresh: {Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)) == True{} : Bool}) -> {Rn.Rec.step(rc, Rn.Ran{h, kept}, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Exec{}, Rn.Rec{Rn.Free{}, 0n, Rn.ran.same(kept, Rn.again(same, last, h)), h}} : Rn.Dec}:
  %Equal.sym(Bool, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), True{}, fresh) : {Rn.rec.ran(_, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Exec{}, Rn.Rec{Rn.Free{}, 0n, Rn.ran.same(kept, Rn.again(same, last, h)), h}} : Rn.Dec}
  {==}

# a repeat never runs, under the redirect cap or at it
def repeat_runs_not(u: Bool, -kept: Bool, -m: Nat, -h: Nat, -n: Nat, -same: Nat, -last: Nat, -r: Rn.Rec) -> {Rn.Act.runs(Rn.Dec.act(Rn.rec.ran(False{}, u, kept, m, h, n, same, last, r))) == False{} : Bool}:
  match u:
    case True{}:
      {==}
    case False{}:
      {==}

def repeat_never_runs(+rc: Rn.RCfg, +h: Nat, kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, rep: {Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)) == False{} : Bool}) -> {Rn.Act.runs(Rn.Dec.act(Rn.Rec.step(rc, Rn.Ran{h, kept}, Rn.Rec{k, row, same, last}))) == False{} : Bool}:
  %Equal.sym(Bool, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), False{}, rep) : {Rn.Act.runs(Rn.Dec.act(Rn.rec.ran(_, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}))) == False{} : Bool}
  repeat_runs_not(Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last})

def repeat_redirects(+rc: Rn.RCfg, +h: Nat, kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, rep: {Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)) == False{} : Bool}, under: {Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)) == True{} : Bool}) -> {Rn.Rec.step(rc, Rn.Ran{h, kept}, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Loops{}, 1n+Rn.Rk.loops(k, row), same, last}} : Rn.Dec}:
  %Equal.sym(Bool, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), False{}, rep) : {Rn.rec.ran(_, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Loops{}, 1n+Rn.Rk.loops(k, row), same, last}} : Rn.Dec}
  %Equal.sym(Bool, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), True{}, under) : {Rn.rec.ran(False{}, _, kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}) == Rn.Dec{Rn.Redo{}, Rn.Rec{Rn.Loops{}, 1n+Rn.Rk.loops(k, row), same, last}} : Rn.Dec}
  {==}

def repeat_gives_up(+rc: Rn.RCfg, +h: Nat, kept: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, rep: {Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)) == False{} : Bool}, over: {Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)) == False{} : Bool}) -> {Rn.Dec.act(Rn.Rec.step(rc, Rn.Ran{h, kept}, Rn.Rec{k, row, same, last})) == Rn.Quit{} : Rn.Act}:
  %Equal.sym(Bool, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), False{}, rep) : {Rn.Dec.act(Rn.rec.ran(_, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last})) == Rn.Quit{} : Rn.Act}
  %Equal.sym(Bool, Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), False{}, over) : {Rn.Dec.act(Rn.rec.ran(False{}, _, kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last})) == Rn.Quit{} : Rn.Act}
  {==}

def user_breaks_the_row(+rc: Rn.RCfg, +k: Rn.Rk, +row: Nat, same: Nat, +last: Nat) -> {Rn.Dec.r(Rn.Rec.step(rc, Rn.Said{}, Rn.Rec{k, row, same, last})) == Rn.Rec{k, row, 0n, last} : Rn.Rec}:
  {==}

def redo_is_noted(-pass: Rn.Reply) -> {Rn.Act.reply(Rn.Redo{}, pass) == Rn.Error{False{}, True{}} : Rn.Reply}:
  {==}

def quit_fails(+cfg: Rn.Cfg, -pass: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> {Rn.call(cfg, Rn.Act.reply(Rn.Quit{}, pass), r, c, a, n, p) == Rn.St{Rn.Failed{Rn.Model{}}, r, c, a, n, p} : Rn.St}:
  {==}

# A stuck reply always gets help
# ------------------------------

def help_long(u: Bool, -n: Nat, -same: Nat, -last: Nat, -r: Rn.Rec) -> {Rn.Act.helps(Rn.Dec.act(Rn.rec.long(u, n, same, last, r))) == True{} : Bool}:
  match u:
    case True{}:
      {==}
    case False{}:
      {==}

def help_leak(u: Bool, -n: Nat, -same: Nat, -last: Nat, -r: Rn.Rec) -> {Rn.Act.helps(Rn.Dec.act(Rn.rec.leak(u, n, same, last, r))) == True{} : Bool}:
  match u:
    case True{}:
      {==}
    case False{}:
      {==}

def help_ran(fresh: Bool, u: Bool, -kept: Bool, -m: Nat, -h: Nat, -n: Nat, -same: Nat, -last: Nat, -r: Rn.Rec) -> {Rn.Act.helps(Rn.Dec.act(Rn.rec.ran(fresh, u, kept, m, h, n, same, last, r))) == True{} : Bool}:
  match fresh u:
    case True{} u:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def help_out(+rc: Rn.RCfg, o: Rn.Out, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat) -> {Bool.or(Bool.not(Rn.Out.stuck(o)), Rn.Act.helps(Rn.Dec.act(Rn.rec.go(rc, o, k, row, same, last)))) == True{} : Bool}:
  match o:
    case Rn.Long{}:
      help_long(Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)), Rn.Rk.longs(k, row), same, last, Rn.Rec{k, row, same, last})
    case Rn.Leak{rebuilt, +h, kept}:
      match rebuilt:
        case True{}:
          help_ran(Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last})
        case False{}:
          help_leak(Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)), Rn.Rk.leaks(k, row), same, last, Rn.Rec{k, row, same, last})
    case Rn.Ran{+h, kept}:
      help_ran(Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last})
    case Rn.Noted{}:
      {==}
    case Rn.Said{}:
      {==}
    case Rn.Answer{}:
      {==}
    case Rn.Other{}:
      {==}

def stuck_gets_help(+rc: Rn.RCfg, o: Rn.Out, r: Rn.Rec) -> {Bool.or(Bool.not(Rn.Out.stuck(o)), Rn.Act.helps(Rn.Dec.act(Rn.Rec.step(rc, o, r)))) == True{} : Bool}:
  match r:
    case Rn.Rec{k, row, same, last}:
      help_out(rc, o, k, row, same, last)

# Every recovery stops at its cap
# -------------------------------
# Each lemma takes a cap test u with its equation e, as a match needs a
# parameter.

def cap_long(+rc: Rn.RCfg, u: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, e: {Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)) == u : Bool}, ok: {Rn.Rk.capped(rc, k, row) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Dec.r(Rn.rec.long(u, Rn.Rk.longs(k, row), same, last, Rn.Rec{k, row, same, last}))) == True{} : Bool}:
  match u:
    case True{}:
      e
    case False{}:
      ok

def cap_leak(+rc: Rn.RCfg, u: Bool, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, e: {Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)) == u : Bool}, ok: {Rn.Rk.capped(rc, k, row) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Dec.r(Rn.rec.leak(u, Rn.Rk.leaks(k, row), same, last, Rn.Rec{k, row, same, last}))) == True{} : Bool}:
  match u:
    case True{}:
      e
    case False{}:
      ok

def cap_ran(+rc: Rn.RCfg, fresh: Bool, u: Bool, kept: Bool, +m: Nat, +h: Nat, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, e: {Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)) == u : Bool}, ok: {Rn.Rk.capped(rc, k, row) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Dec.r(Rn.rec.ran(fresh, u, kept, m, h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}))) == True{} : Bool}:
  match fresh u:
    case True{} u:
      {==}
    case False{} True{}:
      e
    case False{} False{}:
      ok

def cap_out(+rc: Rn.RCfg, o: Rn.Out, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, ok: {Rn.Rk.capped(rc, k, row) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Dec.r(Rn.rec.go(rc, o, k, row, same, last))) == True{} : Bool}:
  match o:
    case Rn.Long{}:
      cap_long(rc, Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)), k, row, same, last, {==}, ok)
    case Rn.Leak{rebuilt, +h, kept}:
      match rebuilt:
        case True{}:
          cap_ran(rc, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, k, row, same, last, {==}, ok)
        case False{}:
          cap_leak(rc, Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)), k, row, same, last, {==}, ok)
    case Rn.Ran{+h, kept}:
      cap_ran(rc, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, k, row, same, last, {==}, ok)
    case Rn.Noted{}:
      {==}
    case Rn.Said{}:
      ok
    case Rn.Answer{}:
      {==}
    case Rn.Other{}:
      ok

def cap_step(+rc: Rn.RCfg, o: Rn.Out, r: Rn.Rec, ok: {Rn.Rec.capped(rc, r) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Dec.r(Rn.Rec.step(rc, o, r))) == True{} : Bool}:
  match r:
    case Rn.Rec{k, row, same, last}:
      cap_out(rc, o, k, row, same, last, ok)

def cap_go(os: List<&2, Rn.Out>, +rc: Rn.RCfg, +r: Rn.Rec, ok: {Rn.Rec.capped(rc, r) == True{} : Bool}) -> {Rn.Rec.capped(rc, Rn.Rec.go(os, rc, r)) == True{} : Bool}:
  match os:
    case Nil{}:
      ok
    case +o <> rest:
      cap_go(rest, rc, Rn.Dec.r(Rn.Rec.step(rc, o, r)), cap_step(rc, o, r, ok))

def notes_capped(+rc: Rn.RCfg, +os: List<&2, Rn.Out>) -> {Rn.Rec.capped(rc, Rn.Rec.run(rc, os)) == True{} : Bool}:
  cap_go(os, rc, Rn.Rec.init(), {==})

# No call runs a repeat
# ---------------------

def same_long(u: Bool, -M: Nat, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, ok: {Rn.below(same, M) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Dec.r(Rn.rec.long(u, Rn.Rk.longs(k, row), same, last, Rn.Rec{k, row, same, last}))), M) == True{} : Bool}:
  match u:
    case True{}:
      ok
    case False{}:
      ok

def same_leak(u: Bool, -M: Nat, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, ok: {Rn.below(same, M) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Dec.r(Rn.rec.leak(u, Rn.Rk.leaks(k, row), same, last, Rn.Rec{k, row, same, last}))), M) == True{} : Bool}:
  match u:
    case True{}:
      ok
    case False{}:
      ok

# a round that ran: m < repeat, so whichever row it makes is below the cap
def same_kept(kept: Bool, +m: Nat, +b: Nat, pos: {Rn.below(0n, m) == True{} : Bool}, e: {Rn.below(m, b) == True{} : Bool}) -> {Rn.below(Rn.ran.same(kept, m), Nat.max(b, 1n)) == True{} : Bool}:
  match kept:
    case True{}:
      below_max(m, b, e)
    case False{}:
      one_below_max(m, b, pos, e)

def same_ran(+rc: Rn.RCfg, fresh: Bool, u: Bool, kept: Bool, +m: Nat, +h: Nat, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, pos: {Rn.below(0n, m) == True{} : Bool}, e: {Rn.below(m, Rn.RCfg.repeat(rc)) == fresh : Bool}, ok: {Rn.below(same, Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Dec.r(Rn.rec.ran(fresh, u, kept, m, h, Rn.Rk.loops(k, row), same, last, Rn.Rec{k, row, same, last}))), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}:
  match fresh u:
    case True{} u:
      same_kept(kept, m, Rn.RCfg.repeat(rc), pos, e)
    case False{} True{}:
      ok
    case False{} False{}:
      ok

def same_out(+rc: Rn.RCfg, o: Rn.Out, +k: Rn.Rk, +row: Nat, +same: Nat, +last: Nat, ok: {Rn.below(same, Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Dec.r(Rn.rec.go(rc, o, k, row, same, last))), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}:
  match o:
    case Rn.Long{}:
      same_long(Rn.below(Rn.Rk.longs(k, row), Rn.RCfg.long(rc)), Nat.max(Rn.RCfg.repeat(rc), 1n), k, row, same, last, ok)
    case Rn.Leak{rebuilt, +h, kept}:
      match rebuilt:
        case True{}:
          same_ran(rc, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, k, row, same, last, again_pos(same, last, h), {==}, ok)
        case False{}:
          same_leak(Rn.below(Rn.Rk.leaks(k, row), Rn.RCfg.leak(rc)), Nat.max(Rn.RCfg.repeat(rc), 1n), k, row, same, last, ok)
    case Rn.Ran{+h, kept}:
      same_ran(rc, Rn.below(Rn.again(same, last, h), Rn.RCfg.repeat(rc)), Rn.below(Rn.Rk.loops(k, row), Rn.RCfg.redirect(rc)), kept, Rn.again(same, last, h), h, k, row, same, last, again_pos(same, last, h), {==}, ok)
    case Rn.Noted{}:
      ok
    case Rn.Said{}:
      zero_below_max(Rn.RCfg.repeat(rc))
    case Rn.Answer{}:
      zero_below_max(Rn.RCfg.repeat(rc))
    case Rn.Other{}:
      ok

def same_step(+rc: Rn.RCfg, o: Rn.Out, r: Rn.Rec, ok: {Rn.below(Rn.Rec.same(r), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Dec.r(Rn.Rec.step(rc, o, r))), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}:
  match r:
    case Rn.Rec{k, row, same, last}:
      same_out(rc, o, k, row, same, last, ok)

def same_go(os: List<&2, Rn.Out>, +rc: Rn.RCfg, +r: Rn.Rec, ok: {Rn.below(Rn.Rec.same(r), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}) -> {Rn.below(Rn.Rec.same(Rn.Rec.go(os, rc, r)), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}:
  match os:
    case Nil{}:
      ok
    case +o <> rest:
      same_go(rest, rc, Rn.Dec.r(Rn.Rec.step(rc, o, r)), same_step(rc, o, r, ok))

def never_runs_a_repeat(+rc: Rn.RCfg, +os: List<&2, Rn.Out>) -> {Rn.below(Rn.Rec.same(Rn.Rec.run(rc, os)), Nat.max(Rn.RCfg.repeat(rc), 1n)) == True{} : Bool}:
  same_go(os, rc, Rn.Rec.init(), zero_below_max(Rn.RCfg.repeat(rc)))

# ---- catalog_union ----

# proof_catalog_union: the catalog union laws (LAWS.bend section catalog_union,
# C1), about bend/catalog_union.bend.
#
# One lemma carries them all (`pcu.find_union`): the lookup of a key in
# the union is `pick` of its lookups in the two sources. The bundled part
# answers `pick.b` (`pcu.find_bundled`: a bundled entry keeps its key, so
# its compiled twin is the twin at the key looked up); the compiled part
# answers its lookup unless the bundle has the key (`pcu.find_extra`); an
# append answers the first lookup that hits (`pcu.find_app`). Each law then
# reads `pick` at the lookups it assumes. The count of a key follows the
# same three steps (`pcu.count_app`, `pcu.count_bundled`,
# `pcu.count_extra`): the union lists a key as often as the bundle, or,
# when the bundle lacks it, as often as the compiled catalog.

# Logic
# -----

def pcu.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pcu.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pcu.BD(_, A, Unit)
  Unit{}

def pcu.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pcu.BD(_, Unit, A)
  Unit{}

def pcu.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pcu.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pcu.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, x => 1n+x, p, q, pcu.eq_true(p, q, h))

# What the union answers
# ----------------------

# the bundled part's answer: a bundled entry with its compiled twin
def pcu.pick.b(mb: Maybe<&2, CU.Ent>, +mc: Maybe<&2, CU.Ent>) -> Maybe<&2, CU.Ent>:
  match mb:
    case None{}:
      None{}
    case Some{b}:
      Some{CU.with(b, mc)}

# the compiled part's answer: none when the bundle has the key
def pcu.gate(h: Bool, m: Maybe<&2, CU.Ent>) -> Maybe<&2, CU.Ent>:
  match h:
    case True{}:
      None{}
    case False{}:
      m

# the union's answer
def pcu.pick(mb: Maybe<&2, CU.Ent>, +mc: Maybe<&2, CU.Ent>) -> Maybe<&2, CU.Ent>:
  match mb:
    case None{}:
      mc
    case Some{b}:
      Some{CU.with(b, mc)}

# Lookup
# ------

def pcu.find_app.go(hit: Bool, +e: CU.Ent, +rest: List<&2, CU.Ent>, +ys: List<&2, CU.Ent>, +k: Nat, ih: {CU.find(List.append(&2, CU.Ent, rest, ys), k) == Maybe.or(&2, CU.Ent, CU.find(rest, k), CU.find(ys, k)) : Maybe<&2, CU.Ent>}) -> {CU.find.go(e <> List.append(&2, CU.Ent, rest, ys), k, hit) == Maybe.or(&2, CU.Ent, CU.find.go(e <> rest, k, hit), CU.find(ys, k)) : Maybe<&2, CU.Ent>}:
  match hit:
    case True{}:
      {==}
    case False{}:
      ih

# a lookup in xs ++ ys is the lookup in xs, else in ys
def pcu.find_app(xs: List<&2, CU.Ent>, +ys: List<&2, CU.Ent>, +k: Nat) -> {CU.find(List.append(&2, CU.Ent, xs, ys), k) == Maybe.or(&2, CU.Ent, CU.find(xs, k), CU.find(ys, k)) : Maybe<&2, CU.Ent>}:
  match xs:
    case Nil{}:
      {==}
    case +e <> +rest:
      pcu.find_app.go(Nat.is_eq(CU.Ent.key(e), k), e, rest, ys, k, pcu.find_app(rest, ys, k))

# a bundled entry with its twin keeps its key
def pcu.key_with(b: CU.Ent, m: Maybe<&2, CU.Ent>) -> {CU.Ent.key(CU.with(b, m)) == CU.Ent.key(b) : Nat}:
  match b:
    case CU.Ent{bk, ba, bd, bo}:
      match m:
        case None{}:
          {==}
        case Some{c}:
          match c:
            case CU.Ent{ck, ca, cd, co}:
              {==}

# The bundled part
# ----------------

def pcu.find_bundled.go(hit: Bool, +b: CU.Ent, +rest: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, eq: {Nat.is_eq(CU.Ent.key(b), k) == hit : Bool}, ih: {CU.find(CU.bundled(rest, cs), k) == pcu.pick.b(CU.find(rest, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}) -> {CU.find.go(CU.with(b, CU.find(cs, CU.Ent.key(b))) <> CU.bundled(rest, cs), k, hit) == pcu.pick.b(CU.find.go(b <> rest, k, hit), CU.find(cs, k)) : Maybe<&2, CU.Ent>}:
  match hit:
    case True{}:
      +same = pcu.eq_true(CU.Ent.key(b), k, eq)
      %same : {Some{CU.with(b, CU.find(cs, CU.Ent.key(b)))} == Some{CU.with(b, CU.find(cs, _))} : Maybe<&2, CU.Ent>}
      {==}
    case False{}:
      ih

# a lookup in the bundled part: the bundled entry with its compiled twin
def pcu.find_bundled(bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat) -> {CU.find(CU.bundled(bs, cs), k) == pcu.pick.b(CU.find(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}:
  match bs:
    case Nil{}:
      {==}
    case +b <> +rest:
      +kw = Equal.sym(Nat, CU.Ent.key(CU.with(b, CU.find(cs, CU.Ent.key(b)))), CU.Ent.key(b), pcu.key_with(b, CU.find(cs, CU.Ent.key(b))))
      %kw : {CU.find.go(CU.with(b, CU.find(cs, CU.Ent.key(b))) <> CU.bundled(rest, cs), k, Nat.is_eq(_, k)) == pcu.pick.b(CU.find(b <> rest, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}
      pcu.find_bundled.go(Nat.is_eq(CU.Ent.key(b), k), b, rest, cs, k, {==}, pcu.find_bundled(rest, cs, k))

# The compiled part
# -----------------

def pcu.gate_none(h: Bool) -> {pcu.gate(h, None{}) == None{} : Maybe<&2, CU.Ent>}:
  match h:
    case True{}:
      {==}
    case False{}:
      {==}

# a hit on c: the bundle has k exactly when it has c's key
def pcu.has_at(+bs: List<&2, CU.Ent>, +c: CU.Ent, +k: Nat, +seen: Bool, es: {CU.has(bs, CU.Ent.key(c)) == seen : Bool}, eh: {Nat.is_eq(CU.Ent.key(c), k) == True{} : Bool}) -> {CU.has(bs, k) == seen : Bool}:
  +same = pcu.eq_true(CU.Ent.key(c), k, eh)
  %same : {CU.has(bs, _) == seen : Bool}
  es

def pcu.find_extra.go(seen: Bool, hit: Bool, +c: CU.Ent, +rest: List<&2, CU.Ent>, +bs: List<&2, CU.Ent>, +k: Nat, es: {CU.has(bs, CU.Ent.key(c)) == seen : Bool}, +eh: {Nat.is_eq(CU.Ent.key(c), k) == hit : Bool}, ih: {CU.find(CU.extra(rest, bs), k) == pcu.gate(CU.has(bs, k), CU.find(rest, k)) : Maybe<&2, CU.Ent>}) -> {CU.find(CU.extra.go(c <> rest, bs, seen), k) == pcu.gate(CU.has(bs, k), CU.find.go(c <> rest, k, hit)) : Maybe<&2, CU.Ent>}:
  match seen hit:
    case True{} True{}:
      +hk = Equal.sym(Bool, CU.has(bs, k), True{}, pcu.has_at(bs, c, k, True{}, es, eh))
      %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.extra(rest, bs), k), pcu.gate(CU.has(bs, k), CU.find(rest, k)), ih) : {_ == pcu.gate(CU.has(bs, k), Some{c}) : Maybe<&2, CU.Ent>}
      %hk : {pcu.gate(_, CU.find(rest, k)) == pcu.gate(_, Some{c}) : Maybe<&2, CU.Ent>}
      {==}
    case True{} False{}:
      ih
    case False{} True{}:
      +hk = Equal.sym(Bool, CU.has(bs, k), False{}, pcu.has_at(bs, c, k, False{}, es, eh))
      %hk : {CU.find.go(c <> CU.extra(rest, bs), k, Nat.is_eq(CU.Ent.key(c), k)) == pcu.gate(_, Some{c}) : Maybe<&2, CU.Ent>}
      %Equal.sym(Bool, Nat.is_eq(CU.Ent.key(c), k), True{}, eh) : {CU.find.go(c <> CU.extra(rest, bs), k, _) == Some{c} : Maybe<&2, CU.Ent>}
      {==}
    case False{} False{}:
      %Equal.sym(Bool, Nat.is_eq(CU.Ent.key(c), k), False{}, eh) : {CU.find.go(c <> CU.extra(rest, bs), k, _) == pcu.gate(CU.has(bs, k), CU.find(rest, k)) : Maybe<&2, CU.Ent>}
      ih

# a lookup in the compiled part: the compiled entry, unless the bundle
# has the key
def pcu.find_extra(cs: List<&2, CU.Ent>, +bs: List<&2, CU.Ent>, +k: Nat) -> {CU.find(CU.extra(cs, bs), k) == pcu.gate(CU.has(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}:
  match cs:
    case Nil{}:
      Equal.sym(Maybe<&2, CU.Ent>, pcu.gate(CU.has(bs, k), None{}), None{}, pcu.gate_none(CU.has(bs, k)))
    case +c <> +rest:
      pcu.find_extra.go(CU.has(bs, CU.Ent.key(c)), Nat.is_eq(CU.Ent.key(c), k), c, rest, bs, k, {==}, {==}, pcu.find_extra(rest, bs, k))

# The union
# ---------

def pcu.or_pick(m: Maybe<&2, CU.Ent>, +mc: Maybe<&2, CU.Ent>) -> {Maybe.or(&2, CU.Ent, pcu.pick.b(m, mc), pcu.gate(Maybe.is_some(&2, CU.Ent, m), mc)) == pcu.pick(m, mc) : Maybe<&2, CU.Ent>}:
  match m:
    case None{}:
      {==}
    case Some{b}:
      {==}

# a lookup in the union is pick of the lookups in the two sources
def pcu.find_union(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat) -> {CU.find(CU.union(bs, cs), k) == pcu.pick(CU.find(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}:
  +app = pcu.find_app(CU.bundled(bs, cs), CU.extra(cs, bs), k)
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), Maybe.or(&2, CU.Ent, CU.find(CU.bundled(bs, cs), k), CU.find(CU.extra(cs, bs), k)), app) : {_ == pcu.pick(CU.find(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.bundled(bs, cs), k), pcu.pick.b(CU.find(bs, k), CU.find(cs, k)), pcu.find_bundled(bs, cs, k)) : {Maybe.or(&2, CU.Ent, _, CU.find(CU.extra(cs, bs), k)) == pcu.pick(CU.find(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.extra(cs, bs), k), pcu.gate(CU.has(bs, k), CU.find(cs, k)), pcu.find_extra(cs, bs, k)) : {Maybe.or(&2, CU.Ent, pcu.pick.b(CU.find(bs, k), CU.find(cs, k)), _) == pcu.pick(CU.find(bs, k), CU.find(cs, k)) : Maybe<&2, CU.Ent>}
  pcu.or_pick(CU.find(bs, k), CU.find(cs, k))

# The laws
# --------

def pcu.some_pick(mb: Maybe<&2, CU.Ent>, +mc: Maybe<&2, CU.Ent>) -> {Maybe.is_some(&2, CU.Ent, pcu.pick(mb, mc)) == Bool.or(Maybe.is_some(&2, CU.Ent, mb), Maybe.is_some(&2, CU.Ent, mc)) : Bool}:
  match mb:
    case None{}:
      {==}
    case Some{b}:
      {==}

def pcu.hides_nothing(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat) -> {CU.has(CU.union(bs, cs), k) == Bool.or(CU.has(bs, k), CU.has(cs, k)) : Bool}:
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), pcu.pick(CU.find(bs, k), CU.find(cs, k)), pcu.find_union(bs, cs, k)) : {Maybe.is_some(&2, CU.Ent, _) == Bool.or(CU.has(bs, k), CU.has(cs, k)) : Bool}
  pcu.some_pick(CU.find(bs, k), CU.find(cs, k))

# the union at k from the lookups at k
def pcu.at(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +mb: Maybe<&2, CU.Ent>, +mc: Maybe<&2, CU.Ent>, hb: {CU.find(bs, k) == mb : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == mc : Maybe<&2, CU.Ent>}) -> {CU.find(CU.union(bs, cs), k) == pcu.pick(mb, mc) : Maybe<&2, CU.Ent>}:
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), pcu.pick(CU.find(bs, k), CU.find(cs, k)), pcu.find_union(bs, cs, k)) : {_ == pcu.pick(mb, mc) : Maybe<&2, CU.Ent>}
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(bs, k), mb, hb) : {pcu.pick(_, CU.find(cs, k)) == pcu.pick(mb, mc) : Maybe<&2, CU.Ent>}
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(cs, k), mc, hc) : {pcu.pick(mb, _) == pcu.pick(mb, mc) : Maybe<&2, CU.Ent>}
  {==}

def pcu.bundled_only(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +b: CU.Ent, hb: {CU.find(bs, k) == Some{b} : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == None{} : Maybe<&2, CU.Ent>}) -> {CU.find(CU.union(bs, cs), k) == Some{b} : Maybe<&2, CU.Ent>}:
  pcu.at(bs, cs, k, Some{b}, None{}, hb, hc)

def pcu.compiled_only(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +c: CU.Ent, hb: {CU.find(bs, k) == None{} : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == Some{c} : Maybe<&2, CU.Ent>}) -> {CU.find(CU.union(bs, cs), k) == Some{c} : Maybe<&2, CU.Ent>}:
  pcu.at(bs, cs, k, None{}, Some{c}, hb, hc)

def pcu.both_keeps_bundled(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +b: CU.Ent, +c: CU.Ent, +v: Nat, hb: {CU.find(bs, k) == Some{b} : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == Some{c} : Maybe<&2, CU.Ent>}, hv: {CU.Ent.opt(b) == Some{v} : Maybe<&2, Nat>}) -> {CU.find(CU.union(bs, cs), k) == Some{CU.Ent{CU.Ent.key(b), CU.Ent.api(b), CU.Ent.data(b), Some{v}}} : Maybe<&2, CU.Ent>}:
  match b c:
    case CU.Ent{+bk, +ba, +bd, +bo} CU.Ent{+ck, +ca, +cd, +co}:
      +u = pcu.at(bs, cs, k, Some{CU.Ent{bk, ba, bd, bo}}, Some{CU.Ent{ck, ca, cd, co}}, hb, hc)
      %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), Some{CU.Ent{bk, ba, bd, CU.fill(bo, co, Nat.is_eq(ba, ca))}}, u) : {_ == Some{CU.Ent{bk, ba, bd, Some{v}}} : Maybe<&2, CU.Ent>}
      %Equal.sym(Maybe<&2, Nat>, bo, Some{v}, hv) : {Some{CU.Ent{bk, ba, bd, CU.fill(_, co, Nat.is_eq(ba, ca))}} == Some{CU.Ent{bk, ba, bd, Some{v}}} : Maybe<&2, CU.Ent>}
      {==}

def pcu.both_fills(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +b: CU.Ent, +c: CU.Ent, hb: {CU.find(bs, k) == Some{b} : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == Some{c} : Maybe<&2, CU.Ent>}, hn: {CU.Ent.opt(b) == None{} : Maybe<&2, Nat>}, ha: {Nat.is_eq(CU.Ent.api(b), CU.Ent.api(c)) == True{} : Bool}) -> {CU.find(CU.union(bs, cs), k) == Some{CU.Ent{CU.Ent.key(b), CU.Ent.api(b), CU.Ent.data(b), CU.Ent.opt(c)}} : Maybe<&2, CU.Ent>}:
  match b c:
    case CU.Ent{+bk, +ba, +bd, +bo} CU.Ent{+ck, +ca, +cd, +co}:
      +u = pcu.at(bs, cs, k, Some{CU.Ent{bk, ba, bd, bo}}, Some{CU.Ent{ck, ca, cd, co}}, hb, hc)
      %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), Some{CU.Ent{bk, ba, bd, CU.fill(bo, co, Nat.is_eq(ba, ca))}}, u) : {_ == Some{CU.Ent{bk, ba, bd, co}} : Maybe<&2, CU.Ent>}
      %Equal.sym(Maybe<&2, Nat>, bo, None{}, hn) : {Some{CU.Ent{bk, ba, bd, CU.fill(_, co, Nat.is_eq(ba, ca))}} == Some{CU.Ent{bk, ba, bd, co}} : Maybe<&2, CU.Ent>}
      %Equal.sym(Bool, Nat.is_eq(ba, ca), True{}, ha) : {Some{CU.Ent{bk, ba, bd, CU.fill(None{}, co, _)}} == Some{CU.Ent{bk, ba, bd, co}} : Maybe<&2, CU.Ent>}
      {==}

def pcu.both_other_api(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, +b: CU.Ent, +c: CU.Ent, hb: {CU.find(bs, k) == Some{b} : Maybe<&2, CU.Ent>}, hc: {CU.find(cs, k) == Some{c} : Maybe<&2, CU.Ent>}, hn: {CU.Ent.opt(b) == None{} : Maybe<&2, Nat>}, ha: {Nat.is_eq(CU.Ent.api(b), CU.Ent.api(c)) == False{} : Bool}) -> {CU.find(CU.union(bs, cs), k) == Some{CU.Ent{CU.Ent.key(b), CU.Ent.api(b), CU.Ent.data(b), None{}}} : Maybe<&2, CU.Ent>}:
  match b c:
    case CU.Ent{+bk, +ba, +bd, +bo} CU.Ent{+ck, +ca, +cd, +co}:
      +u = pcu.at(bs, cs, k, Some{CU.Ent{bk, ba, bd, bo}}, Some{CU.Ent{ck, ca, cd, co}}, hb, hc)
      %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(bs, cs), k), Some{CU.Ent{bk, ba, bd, CU.fill(bo, co, Nat.is_eq(ba, ca))}}, u) : {_ == Some{CU.Ent{bk, ba, bd, None{}}} : Maybe<&2, CU.Ent>}
      %Equal.sym(Maybe<&2, Nat>, bo, None{}, hn) : {Some{CU.Ent{bk, ba, bd, CU.fill(_, co, Nat.is_eq(ba, ca))}} == Some{CU.Ent{bk, ba, bd, None{}}} : Maybe<&2, CU.Ent>}
      %Equal.sym(Bool, Nat.is_eq(ba, ca), False{}, ha) : {Some{CU.Ent{bk, ba, bd, CU.fill(None{}, co, _)}} == Some{CU.Ent{bk, ba, bd, None{}}} : Maybe<&2, CU.Ent>}
      {==}

def pcu.order_free(+k: Nat, +xs: List<&2, CU.Ent>, +xs2: List<&2, CU.Ent>, +ys: List<&2, CU.Ent>, +ys2: List<&2, CU.Ent>, sx: {CU.find(xs, k) == CU.find(xs2, k) : Maybe<&2, CU.Ent>}, sy: {CU.find(ys, k) == CU.find(ys2, k) : Maybe<&2, CU.Ent>}) -> {CU.find(CU.read(CU.Cat{CU.Bundled{}, xs}, CU.Cat{CU.Compiled{}, ys}), k) == CU.find(CU.read(CU.Cat{CU.Compiled{}, ys2}, CU.Cat{CU.Bundled{}, xs2}), k) : Maybe<&2, CU.Ent>}:
  %Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(xs, ys), k), pcu.pick(CU.find(xs, k), CU.find(ys, k)), pcu.find_union(xs, ys, k)) : {_ == CU.find(CU.union(xs2, ys2), k) : Maybe<&2, CU.Ent>}
  Equal.sym(Maybe<&2, CU.Ent>, CU.find(CU.union(xs2, ys2), k), pcu.pick(CU.find(xs, k), CU.find(ys, k)), pcu.at(xs2, ys2, k, CU.find(xs, k), CU.find(ys, k), Equal.sym(Maybe<&2, CU.Ent>, CU.find(xs, k), CU.find(xs2, k), sx), Equal.sym(Maybe<&2, CU.Ent>, CU.find(ys, k), CU.find(ys2, k), sy)))

# One model list
# --------------

def pcu.count_app.go(hit: Bool, +e: CU.Ent, +rest: List<&2, CU.Ent>, +ys: List<&2, CU.Ent>, +k: Nat, ih: {CU.count(List.append(&2, CU.Ent, rest, ys), k) == Nat.add(CU.count(rest, k), CU.count(ys, k)) : Nat}) -> {CU.count.go(e <> List.append(&2, CU.Ent, rest, ys), k, hit) == Nat.add(CU.count.go(e <> rest, k, hit), CU.count(ys, k)) : Nat}:
  match hit:
    case True{}:
      Equal.cong(Nat, Nat, x => 1n+x, CU.count(List.append(&2, CU.Ent, rest, ys), k), Nat.add(CU.count(rest, k), CU.count(ys, k)), ih)
    case False{}:
      ih

# the count in xs ++ ys is the count in xs plus the count in ys
def pcu.count_app(xs: List<&2, CU.Ent>, +ys: List<&2, CU.Ent>, +k: Nat) -> {CU.count(List.append(&2, CU.Ent, xs, ys), k) == Nat.add(CU.count(xs, k), CU.count(ys, k)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case +e <> +rest:
      pcu.count_app.go(Nat.is_eq(CU.Ent.key(e), k), e, rest, ys, k, pcu.count_app(rest, ys, k))

def pcu.count_bundled.go(hit: Bool, +b: CU.Ent, +rest: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, ih: {CU.count(CU.bundled(rest, cs), k) == CU.count(rest, k) : Nat}) -> {CU.count.go(CU.with(b, CU.find(cs, CU.Ent.key(b))) <> CU.bundled(rest, cs), k, hit) == CU.count.go(b <> rest, k, hit) : Nat}:
  match hit:
    case True{}:
      Equal.cong(Nat, Nat, x => 1n+x, CU.count(CU.bundled(rest, cs), k), CU.count(rest, k), ih)
    case False{}:
      ih

# the bundled part lists each key as often as the bundle
def pcu.count_bundled(bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat) -> {CU.count(CU.bundled(bs, cs), k) == CU.count(bs, k) : Nat}:
  match bs:
    case Nil{}:
      {==}
    case +b <> +rest:
      +kw = Equal.sym(Nat, CU.Ent.key(CU.with(b, CU.find(cs, CU.Ent.key(b)))), CU.Ent.key(b), pcu.key_with(b, CU.find(cs, CU.Ent.key(b))))
      %kw : {CU.count.go(CU.with(b, CU.find(cs, CU.Ent.key(b))) <> CU.bundled(rest, cs), k, Nat.is_eq(_, k)) == CU.count(b <> rest, k) : Nat}
      pcu.count_bundled.go(Nat.is_eq(CU.Ent.key(b), k), b, rest, cs, k, pcu.count_bundled(rest, cs, k))

# the compiled part's count: none when the bundle has the key
def pcu.gate_n(h: Bool, n: Nat) -> Nat:
  match h:
    case True{}:
      0n
    case False{}:
      n

def pcu.gate_n_zero(h: Bool) -> {pcu.gate_n(h, 0n) == 0n : Nat}:
  match h:
    case True{}:
      {==}
    case False{}:
      {==}

def pcu.count_extra.go(seen: Bool, hit: Bool, +c: CU.Ent, +rest: List<&2, CU.Ent>, +bs: List<&2, CU.Ent>, +k: Nat, es: {CU.has(bs, CU.Ent.key(c)) == seen : Bool}, +eh: {Nat.is_eq(CU.Ent.key(c), k) == hit : Bool}, ih: {CU.count(CU.extra(rest, bs), k) == pcu.gate_n(CU.has(bs, k), CU.count(rest, k)) : Nat}) -> {CU.count(CU.extra.go(c <> rest, bs, seen), k) == pcu.gate_n(CU.has(bs, k), CU.count.go(c <> rest, k, hit)) : Nat}:
  match seen hit:
    case True{} True{}:
      +hk = Equal.sym(Bool, CU.has(bs, k), True{}, pcu.has_at(bs, c, k, True{}, es, eh))
      %Equal.sym(Nat, CU.count(CU.extra(rest, bs), k), pcu.gate_n(CU.has(bs, k), CU.count(rest, k)), ih) : {_ == pcu.gate_n(CU.has(bs, k), 1n+CU.count(rest, k)) : Nat}
      %hk : {pcu.gate_n(_, CU.count(rest, k)) == pcu.gate_n(_, 1n+CU.count(rest, k)) : Nat}
      {==}
    case True{} False{}:
      ih
    case False{} True{}:
      +hk = Equal.sym(Bool, CU.has(bs, k), False{}, pcu.has_at(bs, c, k, False{}, es, eh))
      %Equal.sym(Bool, Nat.is_eq(CU.Ent.key(c), k), True{}, eh) : {CU.count.go(c <> CU.extra(rest, bs), k, _) == pcu.gate_n(CU.has(bs, k), 1n+CU.count(rest, k)) : Nat}
      %Equal.sym(Nat, CU.count(CU.extra(rest, bs), k), pcu.gate_n(CU.has(bs, k), CU.count(rest, k)), ih) : {1n+_ == pcu.gate_n(CU.has(bs, k), 1n+CU.count(rest, k)) : Nat}
      %hk : {1n+pcu.gate_n(_, CU.count(rest, k)) == pcu.gate_n(_, 1n+CU.count(rest, k)) : Nat}
      {==}
    case False{} False{}:
      %Equal.sym(Bool, Nat.is_eq(CU.Ent.key(c), k), False{}, eh) : {CU.count.go(c <> CU.extra(rest, bs), k, _) == pcu.gate_n(CU.has(bs, k), CU.count(rest, k)) : Nat}
      ih

# the compiled part lists a key the bundle lacks as often as the compiled
# catalog, and a key the bundle has never
def pcu.count_extra(cs: List<&2, CU.Ent>, +bs: List<&2, CU.Ent>, +k: Nat) -> {CU.count(CU.extra(cs, bs), k) == pcu.gate_n(CU.has(bs, k), CU.count(cs, k)) : Nat}:
  match cs:
    case Nil{}:
      Equal.sym(Nat, pcu.gate_n(CU.has(bs, k), 0n), 0n, pcu.gate_n_zero(CU.has(bs, k)))
    case +c <> +rest:
      pcu.count_extra.go(CU.has(bs, CU.Ent.key(c)), Nat.is_eq(CU.Ent.key(c), k), c, rest, bs, k, {==}, {==}, pcu.count_extra(rest, bs, k))

# a key the list does not have, it lists never
def pcu.none_count.go(xs: List<&2, CU.Ent>, +k: Nat, hit: Bool, h: {Maybe.is_some(&2, CU.Ent, CU.find.go(xs, k, hit)) == False{} : Bool}) -> {CU.count.go(xs, k, hit) == 0n : Nat}:
  match xs:
    case Nil{}:
      {==}
    case e <> +rest:
      match hit:
        case True{}:
          pcu.absurdT({CU.count.go(e <> rest, k, True{}) == 0n : Nat}, h)
        case False{}:
          pcu.none_count.go(rest, k, CU.key.at(rest, k), h)

def pcu.add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 0n), p, pcu.add_zero(p))

def pcu.once.go(hb: Bool, +bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, eb: {CU.has(bs, k) == hb : Bool}, ub: {Nat.is_le(CU.count(bs, k), 1n) == True{} : Bool}, uc: {Nat.is_le(CU.count(cs, k), 1n) == True{} : Bool}) -> {Nat.is_le(Nat.add(CU.count(bs, k), pcu.gate_n(hb, CU.count(cs, k))), 1n) == True{} : Bool}:
  match hb:
    case True{}:
      %Equal.sym(Nat, Nat.add(CU.count(bs, k), 0n), CU.count(bs, k), pcu.add_zero(CU.count(bs, k))) : {Nat.is_le(_, 1n) == True{} : Bool}
      ub
    case False{}:
      +z = pcu.none_count.go(bs, k, CU.key.at(bs, k), eb)
      %Equal.sym(Nat, CU.count(bs, k), 0n, z) : {Nat.is_le(Nat.add(_, CU.count(cs, k)), 1n) == True{} : Bool}
      uc

# when each source lists a key at most once, so does the union
def pcu.lists_once(+bs: List<&2, CU.Ent>, +cs: List<&2, CU.Ent>, +k: Nat, ub: {Nat.is_le(CU.count(bs, k), 1n) == True{} : Bool}, uc: {Nat.is_le(CU.count(cs, k), 1n) == True{} : Bool}) -> {Nat.is_le(CU.count(CU.union(bs, cs), k), 1n) == True{} : Bool}:
  %Equal.sym(Nat, CU.count(CU.union(bs, cs), k), Nat.add(CU.count(CU.bundled(bs, cs), k), CU.count(CU.extra(cs, bs), k)), pcu.count_app(CU.bundled(bs, cs), CU.extra(cs, bs), k)) : {Nat.is_le(_, 1n) == True{} : Bool}
  %Equal.sym(Nat, CU.count(CU.bundled(bs, cs), k), CU.count(bs, k), pcu.count_bundled(bs, cs, k)) : {Nat.is_le(Nat.add(_, CU.count(CU.extra(cs, bs), k)), 1n) == True{} : Bool}
  %Equal.sym(Nat, CU.count(CU.extra(cs, bs), k), pcu.gate_n(CU.has(bs, k), CU.count(cs, k)), pcu.count_extra(cs, bs, k)) : {Nat.is_le(Nat.add(CU.count(bs, k), _), 1n) == True{} : Bool}
  pcu.once.go(CU.has(bs, k), bs, cs, k, {==}, ub, uc)

# ---- cron ----

# proof_cron: the cron laws of LAWS.bend section cron (D2). Every event keeps an
# invariant of the reachable states, job by job (`pc.G`): at most one
# process runs a job, its run holds the claim on record and its process
# is alive; the occurrences that started fall strictly and lie at or
# before the clock and before the next run; a one-shot that started has
# no next run; the failures in a row match the job's counted results and
# stay under the cap while the job is active; a finished one-shot has no
# run. From it: `cron_fires_once`, `cron_once_finished_after_end` and the
# first part of `cron_backoff_bounded`. The other laws are about one step
# from any state: `cron_never_drops`, `cron_claim_owned`, and the rest of
# `cron_backoff_bounded`.

# Logic and numbers
# -----------------

def cron.pc.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def cron.pc.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : cron.pc.BD(_, Unit, A)
  Unit{}

def cron.pc.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : cron.pc.BD(_, A, Unit)
  Unit{}

def cron.pc.MD(m: Maybe<&2, Nat>, A: Type) -> Type:
  match m:
    case None{}:
      A
    case Some{x}:
      Unit

def pc.some_none(-A: Type, -x: Nat, e: {Some{x} == None{} : Maybe<&2, Nat>}) -> A:
  %e : cron.pc.MD(_, A)
  Unit{}

def cron.pc.le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      cron.pc.le_refl(p)

def cron.pc.le_zero(n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pc.lt_le(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n _:
      cron.pc.le_zero(b)
    case 1n+p 0n:
      cron.pc.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pc.lt_le(p, q, h)

def pc.lt_succ_le(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(1n+a, b) == True{} : Bool}:
  match a b:
    case _ 0n:
      cron.pc.absurdF({Nat.is_le(1n+a, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      cron.pc.le_zero(q)
    case 1n+p 1n+q:
      pc.lt_succ_le(p, q, h)

# x <= c gives x <= c + d
def cron.pc.le_add(x: Nat, c: Nat, +d: Nat, h: {Nat.is_le(x, c) == True{} : Bool}) -> {Nat.is_le(x, Nat.add(c, d)) == True{} : Bool}:
  match x c:
    case 0n _:
      cron.pc.le_zero(Nat.add(c, d))
    case 1n+p 0n:
      cron.pc.absurdF({Nat.is_le(1n+p, Nat.add(0n, d)) == True{} : Bool}, h)
    case 1n+p 1n+q:
      cron.pc.le_add(p, q, d, h)

# x <= c gives x < c + 1 + k
def pc.lt_add(x: Nat, c: Nat, +k: Nat, h: {Nat.is_le(x, c) == True{} : Bool}) -> {Nat.is_lt(x, Nat.add(c, 1n+k)) == True{} : Bool}:
  match x c:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      cron.pc.absurdF({Nat.is_lt(1n+p, Nat.add(0n, 1n+k)) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pc.lt_add(p, q, k, h)

def cron.pc.eq_refl(k: Nat) -> {Nat.is_eq(k, k) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      cron.pc.eq_refl(p)

def cron.pc.eq_of(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      cron.pc.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      cron.pc.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      +e = cron.pc.eq_of(p, q, h)
      %e : {1n+p == 1n+_ : Nat}
      {==}

def cron.pc.or_l(a: Bool, b: Bool, h: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      cron.pc.absurdF({Bool.or(False{}, b) == True{} : Bool}, h)

def cron.pc.or_r(a: Bool, b: Bool, h: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

# The invariant of a job
# ----------------------

# the processes that run the job are alive
def pc.Live(rs: List<&2, Nat>, +dead: List<&2, Nat>) -> Type:
  match rs:
    case Nil{}:
      Unit
    case +o <> t:
      ({Cr.has(o, dead) == False{} : Bool} & pc.Live(t, dead))

def pc.Below(+x: Nat, nx: Maybe<&2, Nat>) -> Type:
  match nx:
    case None{}:
      Unit
    case Some{n}:
      {Nat.is_lt(x, n) == True{} : Bool}

# the newest occurrence that started is at or before the clock and
# before the next run
def pc.Top(ss: List<&2, Nat>, +c: Nat, +nx: Maybe<&2, Nat>) -> Type:
  match ss:
    case Nil{}:
      Unit
    case +x <> t:
      ({Nat.is_le(x, c) == True{} : Bool} & pc.Below(x, nx))

# a one-shot that started has no next run
def pc.OnceG(s: Cr.Sched, ss: List<&2, Nat>, +nx: Maybe<&2, Nat>) -> Type:
  match s:
    case Cr.Once{d}:
      match ss:
        case Nil{}:
          Unit
        case x <> t:
          ({t == Nil{} : List<&2, Nat>} & {nx == None{} : Maybe<&2, Nat>})
    case Cr.Every{q}:
      Unit

def pc.Act2(st: Cr.Status, +k: Nat) -> Data:
  match st:
    case Cr.Active{}:
      {Nat.is_lt(k, Cr.CAP()) == True{} : Bool}
    case Cr.Paused{}:
      {Nat.is_le(k, Cr.CAP()) == True{} : Bool}
    case Cr.Finished{}:
      {Nat.is_le(k, Cr.CAP()) == True{} : Bool}
    case Cr.Cancelled{}:
      {Nat.is_le(k, Cr.CAP()) == True{} : Bool}

# the failures in a row are the counted ones, under the cap while active
def pc.Cnt(+st: Cr.Status, +k: Nat, +h: List<&2, Cr.Mark>) -> Type:
  ({k == Cr.trail(h) : Nat} & pc.Act2(st, k))

def pc.G(+c: Nat, +dead: List<&2, Nat>, j: Cr.Job) -> Type:
  match j:
    case Cr.Job{i, +s, +st, +nx, k, cl, +rs, +ss, h}:
      (Cr.Held(rs, cl) & (pc.Live(rs, dead) & (Cr.Desc(ss) & (pc.Top(ss, c, nx) & (pc.OnceG(s, ss, nx) & (pc.Cnt(st, k, h) & Cr.EndsOf(s, st, rs)))))))

def pc.AllG(+c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>) -> Type:
  match rs:
    case Nil{}:
      Unit
    case r <> t:
      match r:
        case Cr.Known{j}:
          (pc.G(c, dead, j) & pc.AllG(c, dead, t))
        case Cr.Raw{x}:
          pc.AllG(c, dead, t)

def pc.Inv(s: Cr.S) -> Type:
  match s:
    case Cr.S{b, rs, rd, dead, c, n, a}:
      pc.AllG(c, dead, rs)

# What the invariant gives
# ------------------------

def pc.once_once(s: Cr.Sched, ss: List<&2, Nat>, +nx: Maybe<&2, Nat>, o: pc.OnceG(s, ss, nx)) -> Cr.OnceOnce(s, ss):
  match s:
    case Cr.Once{d}:
      match ss:
        case Nil{}:
          Unit{}
        case x <> t:
          (a, b) = o
          a
    case Cr.Every{q}:
      Unit{}

def pc.g_fires(+c: Nat, +dead: List<&2, Nat>, j: Cr.Job, g: pc.G(c, dead, j)) -> Cr.Fires(j):
  match j:
    case Cr.Job{i, +s, +st, +nx, k, +cl, +rs, +ss, h}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h1, (h3, pc.once_once(s, ss, nx, h5)))

def pc.stops_st(st: Cr.Status, +k: Nat, +h: List<&2, Cr.Mark>, ek: {k == Cr.trail(h) : Nat}, +act: pc.Act2(st, k)) -> ({Nat.is_le(Cr.trail(h), Cr.CAP()) == True{} : Bool} & Cr.Act(st, Cr.trail(h))):
  match st:
    case Cr.Active{}:
      %ek : ({Nat.is_le(_, Cr.CAP()) == True{} : Bool} & Cr.Act(Cr.Active{}, _))
      (pc.lt_le(k, Cr.CAP(), act), act)
    case Cr.Paused{}:
      %ek : ({Nat.is_le(_, Cr.CAP()) == True{} : Bool} & Unit)
      (act, Unit{})
    case Cr.Finished{}:
      %ek : ({Nat.is_le(_, Cr.CAP()) == True{} : Bool} & Unit)
      (act, Unit{})
    case Cr.Cancelled{}:
      %ek : ({Nat.is_le(_, Cr.CAP()) == True{} : Bool} & Unit)
      (act, Unit{})

def pc.g_stops(+c: Nat, +dead: List<&2, Nat>, j: Cr.Job, g: pc.G(c, dead, j)) -> Cr.Stops(j):
  match j:
    case Cr.Job{i, +s, +st, +nx, +k, cl, +rs, +ss, +h}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      (ek, act) = h6
      pc.stops_st(st, k, h, ek, act)

def pc.g_ends(+c: Nat, +dead: List<&2, Nat>, j: Cr.Job, g: pc.G(c, dead, j)) -> Cr.Ends(j):
  match j:
    case Cr.Job{i, +s, +st, +nx, k, cl, +rs, +ss, h}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      h7

def pc.all_fires(+c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, g: pc.AllG(c, dead, rs)) -> Cr.FiresAll(rs):
  match rs:
    case Nil{}:
      Unit{}
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = g
          (pc.g_fires(c, dead, j, a), pc.all_fires(c, dead, t, b))
        case Cr.Raw{x}:
          pc.all_fires(c, dead, t, g)

def pc.all_stops(+c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, g: pc.AllG(c, dead, rs)) -> Cr.StopsAll(rs):
  match rs:
    case Nil{}:
      Unit{}
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = g
          (pc.g_stops(c, dead, j, a), pc.all_stops(c, dead, t, b))
        case Cr.Raw{x}:
          pc.all_stops(c, dead, t, g)

def pc.all_ends(+c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, g: pc.AllG(c, dead, rs)) -> Cr.EndsAll(rs):
  match rs:
    case Nil{}:
      Unit{}
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = g
          (pc.g_ends(c, dead, j, a), pc.all_ends(c, dead, t, b))
        case Cr.Raw{x}:
          pc.all_ends(c, dead, t, g)

# A claim keeps the invariant
# ---------------------------

# a next run rolled from c lies after every occurrence at or before c
def pc.below_adv(+s: Cr.Sched, +c: Nat, +x: Nat, +h: {Nat.is_le(x, c) == True{} : Bool}) -> pc.Below(x, Cr.adv(s, c)):
  match s:
    case Cr.Once{d}:
      Unit{}
    case Cr.Every{q}:
      pc.lt_add(x, c, q, h)

def pc.top_pair(+s: Cr.Sched, +c: Nat, +x: Nat, +a: {Nat.is_le(x, c) == True{} : Bool}) -> ({Nat.is_le(x, c) == True{} : Bool} & pc.Below(x, Cr.adv(s, c))):
  (a, pc.below_adv(s, c, x, a))

def pc.top_adv(+ss: List<&2, Nat>, +s: Cr.Sched, +c: Nat, -nx: Maybe<&2, Nat>, t: pc.Top(ss, c, nx)) -> pc.Top(ss, c, Cr.adv(s, c)):
  match ss:
    case Nil{}:
      Unit{}
    case +x <> +u:
      (a, b) = t
      pc.top_pair(s, c, x, a)

def pc.once_adv(+s: Cr.Sched, +ss: List<&2, Nat>, +c: Nat, -nx: Maybe<&2, Nat>, o: pc.OnceG(s, ss, nx)) -> pc.OnceG(s, ss, Cr.adv(s, c)):
  match s:
    case Cr.Once{d}:
      match ss:
        case Nil{}:
          Unit{}
        case +x <> +t:
          (a, b) = o
          (a, {==})
    case Cr.Every{q}:
      Unit{}

def pc.ends_active(+s: Cr.Sched, -rs: List<&2, Nat>) -> Cr.EndsOf(s, Cr.Active{}, rs):
  match s:
    case Cr.Once{d}:
      Unit{}
    case Cr.Every{q}:
      Unit{}

# the new occurrence n lies after every one that started
def pc.desc_push(+ss: List<&2, Nat>, +n: Nat, -c: Nat, d: Cr.Desc(ss), t: pc.Top(ss, c, Some{n})) -> Cr.DescFrom(n, ss):
  match ss:
    case Nil{}:
      Unit{}
    case +y <> +u:
      (a, b) = t
      (b, d)

def pc.once_new(+s: Cr.Sched, +ss: List<&2, Nat>, +n: Nat, +c: Nat, o: pc.OnceG(s, ss, Some{n})) -> pc.OnceG(s, n <> ss, Cr.adv(s, c)):
  match s:
    case Cr.Once{d}:
      match ss:
        case Nil{}:
          ({==}, {==})
        case +x <> +t:
          (a, b) = o
          pc.some_none(({x <> t == Nil{} : List<&2, Nat>} & {None{} == None{} : Maybe<&2, Nat>}), n, b)
    case Cr.Every{q}:
      Unit{}

# a due job with no claim: the claim, the run and the start are p's
def pc.take_new(+p: Nat, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +n: Nat, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +le: {Nat.is_le(n, c) == True{} : Bool}, +al: {Cr.has(p, dead) == False{} : Bool}, g: pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, Some{n}, k, None{}, rs, ss, h})) -> pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, Cr.adv(s, c), k, Some{Cr.Claim{n, p}}, p <> rs, n <> ss, h}):
  match rs:
    case Nil{}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      ({==}, ((al, Unit{}), (pc.desc_push(ss, n, c, h3, h4), (pc.top_pair(s, c, n, le), (pc.once_new(s, ss, n, c, h5), (h6, pc.ends_active(s, [p])))))))
    case +o <> +t:
      match t:
        case Nil{}:
          (h1, g2) = g
          match h1:
        case +x <> +u:
          (h1, g2) = g
          match h1:

# a due job with a claim only rolls its next run
def pc.take_skip(+c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +n: Nat, +k: Nat, +x: Cr.Claim, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, g: pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, Some{n}, k, Some{x}, rs, ss, h})) -> pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, Cr.adv(s, c), k, Some{x}, rs, ss, h}):
  (h1, g2) = g
  (h2, g3) = g2
  (h3, g4) = g3
  (h4, g5) = g4
  (h5, g6) = g5
  (h6, h7) = g6
  (h1, (h2, (h3, (pc.top_adv(ss, s, c, Some{n}, h4), (pc.once_adv(s, ss, c, Some{n}, h5), (h6, h7))))))

def pc.take_due(b: Bool, +p: Nat, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +n: Nat, +k: Nat, +cl: Maybe<&2, Cr.Claim>, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +eq: {Nat.is_le(n, c) == b : Bool}, +al: {Cr.has(p, dead) == False{} : Bool}, g: pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, Some{n}, k, cl, rs, ss, h})) -> pc.G(c, dead, Cr.take.due(b, p, c, i, s, n, k, cl, rs, ss, h)):
  match b:
    case False{}:
      g
    case True{}:
      match cl:
        case None{}:
          pc.take_new(p, c, dead, i, s, n, k, rs, ss, h, eq, al, g)
        case Some{+x}:
          pc.take_skip(c, dead, i, s, n, k, x, rs, ss, h, g)

def pc.take_nx(+nx: Maybe<&2, Nat>, +p: Nat, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +k: Nat, +cl: Maybe<&2, Cr.Claim>, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +al: {Cr.has(p, dead) == False{} : Bool}, g: pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, nx, k, cl, rs, ss, h})) -> pc.G(c, dead, Cr.take.next(p, c, i, s, nx, k, cl, rs, ss, h)):
  match nx:
    case None{}:
      g
    case Some{+n}:
      pc.take_due(Nat.is_le(n, c), p, c, dead, i, s, n, k, cl, rs, ss, h, {==}, al, g)

def pc.g_take(+p: Nat, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, +al: {Cr.has(p, dead) == False{} : Bool}, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.take(p, c, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Active{}:
          pc.take_nx(nx, p, c, dead, i, s, k, cl, rs, ss, h, al, g)
        case Cr.Paused{}:
          g
        case Cr.Finished{}:
          g
        case Cr.Cancelled{}:
          g

def cron.pc.void(-A: Type, e: Empty) -> A:
  match e:

def cron.pc.or_false_r(a: Bool, h: {Bool.or(a, False{}) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def pc.eq_flip(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == False{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  match a b:
    case 0n 0n:
      h
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pc.eq_flip(p, q, h)

# Shapes the invariant keeps
# --------------------------

def pc.top_none(+ss: List<&2, Nat>, +c: Nat, -nx: Maybe<&2, Nat>, t: pc.Top(ss, c, nx)) -> pc.Top(ss, c, None{}):
  match ss:
    case Nil{}:
      Unit{}
    case +x <> +u:
      (a, b) = t
      (a, Unit{})

def pc.once_none(+s: Cr.Sched, +ss: List<&2, Nat>, -nx: Maybe<&2, Nat>, o: pc.OnceG(s, ss, nx)) -> pc.OnceG(s, ss, None{}):
  match s:
    case Cr.Once{d}:
      match ss:
        case Nil{}:
          Unit{}
        case +x <> +t:
          (a, b) = o
          (a, {==})
    case Cr.Every{q}:
      Unit{}

def pc.ends_nil(+s: Cr.Sched, +st: Cr.Status) -> Cr.EndsOf(s, st, Nil{}):
  match s:
    case Cr.Once{d}:
      match st:
        case Cr.Finished{}:
          {==}
        case Cr.Active{}:
          Unit{}
        case Cr.Paused{}:
          Unit{}
        case Cr.Cancelled{}:
          Unit{}
    case Cr.Every{q}:
      Unit{}

def pc.ends_cancel(+s: Cr.Sched, -rs: List<&2, Nat>) -> Cr.EndsOf(s, Cr.Cancelled{}, rs):
  match s:
    case Cr.Once{d}:
      Unit{}
    case Cr.Every{q}:
      Unit{}

# an active job's count holds for any status
def pc.cnt_down(+st: Cr.Status, +k: Nat, +h: List<&2, Cr.Mark>, c6: pc.Cnt(Cr.Active{}, k, h)) -> pc.Cnt(st, k, h):
  match st:
    case Cr.Active{}:
      c6
    case Cr.Paused{}:
      (ek, lt) = c6
      (ek, pc.lt_le(k, Cr.CAP(), lt))
    case Cr.Finished{}:
      (ek, lt) = c6
      (ek, pc.lt_le(k, Cr.CAP(), lt))
    case Cr.Cancelled{}:
      (ek, lt) = c6
      (ek, pc.lt_le(k, Cr.CAP(), lt))

# A recovery keeps the invariant
# ------------------------------

def pc.no_clear(b: Bool, +hd: Bool, live: {hd == False{} : Bool}) -> {Bool.or(Bool.and(b, Bool.not(Bool.or(b, False{}))), hd) == False{} : Bool}:
  match b:
    case True{}:
      live
    case False{}:
      live

def pc.clears_at(+p: Nat, +o: Nat, +w: Nat, +dead: List<&2, Nat>, ow: {o == w : Nat}, nc: {Cr.clears(p, w, [w], dead) == False{} : Bool}) -> {Cr.clears(p, o, [w], dead) == False{} : Bool}:
  %Equal.sym(Nat, o, w, ow) : {Cr.clears(p, _, [w], dead) == False{} : Bool}
  nc

# a claim a recovery clears has no run: the run of an alive process
# holds it, and only its owner runs it
def pc.rec_none(+p: Nat, +o: Nat, +w: Nat, +dead: List<&2, Nat>, ow: {o == w : Nat}, live: {Cr.has(w, dead) == False{} : Bool}, eq: {Cr.clears(p, o, [w], dead) == True{} : Bool}) -> Empty:
  +no = pc.clears_at(p, o, w, dead, ow, pc.no_clear(Nat.is_eq(w, p), Cr.has(w, dead), live))
  cron.pc.absurd(Empty, Equal.trans(Bool, True{}, Cr.clears(p, o, [w], dead), False{}, Equal.sym(Bool, Cr.clears(p, o, [w], dead), True{}, eq), no))

def pc.rec_end(+s: Cr.Sched, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +x: Cr.Claim, g: pc.G(c, dead, Cr.Job{i, s, Cr.Active{}, nx, k, Some{x}, Nil{}, ss, h})) -> pc.G(c, dead, Cr.recover.end(Cr.is_once(s), i, s, nx, k, Nil{}, ss, h)):
  match s:
    case Cr.Once{+d}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      (Unit{}, (Unit{}, (h3, (pc.top_none(ss, c, nx, h4), (pc.once_none(Cr.Once{d}, ss, nx, h5), (pc.cnt_down(Cr.Finished{}, k, h, h6), {==}))))))
    case Cr.Every{q}:
      g

def pc.rec_go(b: Bool, +rs: List<&2, Nat>, +st: Cr.Status, +p: Nat, +o: Nat, +xo: Nat, +dead: List<&2, Nat>, +c: Nat, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, eq: {Cr.clears(p, o, rs, dead) == b : Bool}, g: pc.G(c, dead, Cr.Job{i, s, st, nx, k, Some{Cr.Claim{xo, o}}, rs, ss, h})) -> pc.G(c, dead, Cr.recover.go(b, i, s, st, nx, k, Cr.Claim{xo, o}, rs, ss, h)):
  match b:
    case False{}:
      g
    case True{}:
      match rs:
        case Nil{}:
          match st:
            case Cr.Active{}:
              pc.rec_end(s, c, dead, i, nx, k, ss, h, Cr.Claim{xo, o}, g)
            case Cr.Paused{}:
              g
            case Cr.Finished{}:
              g
            case Cr.Cancelled{}:
              g
        case +w <> +t:
          match t:
            case Nil{}:
              (h1, g2) = g
              (h2, g3) = g2
              (live, u) = h2
              cron.pc.void(pc.G(c, dead, Cr.recover.go(True{}, i, s, st, nx, k, Cr.Claim{xo, o}, [w], ss, h)), pc.rec_none(p, o, w, dead, h1, live, eq))
            case +y <> +v:
              (h1, g2) = g
              match h1:

def pc.g_recover(+p: Nat, +dead: List<&2, Nat>, +c: Nat, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.recover(p, dead, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match cl:
        case None{}:
          g
        case Some{+x}:
          match x:
            case Cr.Claim{+xo, +o}:
              pc.rec_go(Cr.clears(p, o, rs, dead), rs, st, p, o, xo, dead, c, i, s, nx, k, ss, h, {==}, g)

# The finish step keeps the invariant
# -----------------------------------

# a pause lies after the clock: x <= c gives x < c + delay(k)
def pc.lt_delay(+x: Nat, +c: Nat, k: Nat, +le: {Nat.is_le(x, c) == True{} : Bool}) -> {Nat.is_lt(x, Nat.add(c, Cr.delay(k))) == True{} : Bool}:
  match k:
    case 0n:
      pc.lt_add(x, c, 1n, le)
    case 1n+a:
      match a:
        case 0n:
          pc.lt_add(x, c, 1n, le)
        case 1n+b:
          match b:
            case 0n:
              pc.lt_add(x, c, 3n, le)
            case 1n+d:
              match d:
                case 0n:
                  pc.lt_add(x, c, 7n, le)
                case 1n+e:
                  match e:
                    case 0n:
                      pc.lt_add(x, c, 15n, le)
                    case 1n+f:
                      match f:
                        case 0n:
                          pc.lt_add(x, c, 31n, le)
                        case 1n+g:
                          pc.lt_add(x, c, 59n, le)

def pc.lt_pick(b: Bool, +n: Nat, +u: Nat, +x: Nat, ltu: {Nat.is_lt(x, u) == True{} : Bool}, ltn: {Nat.is_lt(x, n) == True{} : Bool}) -> {Nat.is_lt(x, Cr.later.pick(b, n, u)) == True{} : Bool}:
  match b:
    case True{}:
      ltu
    case False{}:
      ltn

# the next run after a failure lies after every start
def pc.lt_later(+nx: Maybe<&2, Nat>, +x: Nat, +u: Nat, ltu: {Nat.is_lt(x, u) == True{} : Bool}, bl: pc.Below(x, nx)) -> {Nat.is_lt(x, Cr.later(nx, u)) == True{} : Bool}:
  match nx:
    case None{}:
      ltu
    case Some{+n}:
      pc.lt_pick(Nat.is_lt(n, u), n, u, x, ltu, bl)

def pc.top_fail2(+x: Nat, +c: Nat, +nx: Maybe<&2, Nat>, +k: Nat, +a: {Nat.is_le(x, c) == True{} : Bool}, bl: pc.Below(x, nx)) -> ({Nat.is_le(x, c) == True{} : Bool} & pc.Below(x, Some{Cr.later(nx, Nat.add(c, Cr.delay(k)))})):
  (a, pc.lt_later(nx, x, Nat.add(c, Cr.delay(k)), pc.lt_delay(x, c, k, a), bl))

def pc.top_fail(+ss: List<&2, Nat>, +c: Nat, +nx: Maybe<&2, Nat>, +k: Nat, t: pc.Top(ss, c, nx)) -> pc.Top(ss, c, Some{Cr.later(nx, Nat.add(c, Cr.delay(k)))}):
  match ss:
    case Nil{}:
      Unit{}
    case +x <> +u:
      (a, b) = t
      pc.top_fail2(x, c, nx, k, a, b)

def pc.fin_fail(b: Bool, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +q: Nat, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +eqb: {Nat.is_lt(1n+k, Cr.CAP()) == b : Bool}, h3: Cr.Desc(ss), h4: pc.Top(ss, c, nx), +ek: {k == Cr.trail(h) : Nat}, +lt: {Nat.is_lt(k, Cr.CAP()) == True{} : Bool}) -> pc.G(c, dead, Cr.finish.fail(b, c, i, Cr.Every{q}, nx, 1n+k, Nil{}, ss, Cr.MLoss{} <> h)):
  match b:
    case True{}:
      (Unit{}, (Unit{}, (h3, (pc.top_fail(ss, c, nx, 1n+k, h4), (Unit{}, ((Equal.cong(Nat, Nat, v => 1n+v, k, Cr.trail(h), ek), eqb), Unit{}))))))
    case False{}:
      (Unit{}, (Unit{}, (h3, (pc.top_none(ss, c, nx, h4), (Unit{}, ((Equal.cong(Nat, Nat, v => 1n+v, k, Cr.trail(h), ek), pc.lt_succ_le(k, Cr.CAP(), lt)), Unit{}))))))

def pc.cnt_fin(+o: Cr.Out, +k: Nat, +h: List<&2, Cr.Mark>, c6: pc.Cnt(Cr.Active{}, k, h)) -> pc.Cnt(Cr.Finished{}, Cr.count.streak(o, k), Cr.count.hist(o, h)):
  match o:
    case Cr.Win{}:
      ({==}, {==})
    case Cr.Loss{}:
      (ek, lt) = c6
      (Equal.cong(Nat, Nat, v => 1n+v, k, Cr.trail(h), ek), pc.lt_succ_le(k, Cr.CAP(), lt))
    case Cr.Skip{}:
      (ek, lt) = c6
      (ek, pc.lt_le(k, Cr.CAP(), lt))

def pc.fin_count(+s: Cr.Sched, +o: Cr.Out, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, h3: Cr.Desc(ss), h4: pc.Top(ss, c, nx), h5: pc.OnceG(s, ss, nx), h6: pc.Cnt(Cr.Active{}, k, h)) -> pc.G(c, dead, Cr.finish.count(Cr.is_once(s), c, o, i, s, nx, k, Nil{}, ss, h)):
  match s:
    case Cr.Once{+d}:
      (Unit{}, (Unit{}, (h3, (pc.top_none(ss, c, nx, h4), (pc.once_none(Cr.Once{d}, ss, nx, h5), (pc.cnt_fin(o, k, h, h6), {==}))))))
    case Cr.Every{+q}:
      match o:
        case Cr.Win{}:
          (Unit{}, (Unit{}, (h3, (h4, (Unit{}, (({==}, {==}), Unit{}))))))
        case Cr.Skip{}:
          (Unit{}, (Unit{}, (h3, (pc.top_adv(ss, Cr.Every{q}, c, nx, h4), (Unit{}, (h6, Unit{}))))))
        case Cr.Loss{}:
          (ek, lt) = h6
          pc.fin_fail(Nat.is_lt(1n+k, Cr.CAP()), c, dead, i, q, nx, k, ss, h, {==}, h3, h4, ek, lt)

def pc.fin_st(+st: Cr.Status, +x: Cr.Claim, +c: Nat, +dead: List<&2, Nat>, +o: Cr.Out, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, h3: Cr.Desc(ss), h4: pc.Top(ss, c, nx), h5: pc.OnceG(s, ss, nx), h6: pc.Cnt(st, k, h)) -> pc.G(c, dead, Cr.finish.own(True{}, x, c, o, i, s, st, nx, k, Nil{}, ss, h)):
  match st:
    case Cr.Active{}:
      pc.fin_count(s, o, c, dead, i, nx, k, ss, h, h3, h4, h5, h6)
    case Cr.Paused{}:
      (Unit{}, (Unit{}, (h3, (h4, (h5, (h6, pc.ends_nil(s, Cr.Paused{})))))))
    case Cr.Finished{}:
      (Unit{}, (Unit{}, (h3, (h4, (h5, (h6, pc.ends_nil(s, Cr.Finished{})))))))
    case Cr.Cancelled{}:
      (Unit{}, (Unit{}, (h3, (h4, (h5, (h6, pc.ends_nil(s, Cr.Cancelled{})))))))

# the run of p is its claim's: releasing it leaves no run
def pc.fin_run(b: Bool, +rs: List<&2, Nat>, +cl: Maybe<&2, Cr.Claim>, +p: Nat, +c: Nat, +o: Cr.Out, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, eq: {Cr.has(p, rs) == b : Bool}, g: pc.G(c, dead, Cr.Job{i, s, st, nx, k, cl, rs, ss, h})) -> pc.G(c, dead, Cr.finish.run(b, p, c, o, i, s, st, nx, k, cl, rs, ss, h)):
  match b:
    case False{}:
      g
    case True{}:
      match rs:
        case Nil{}:
          cron.pc.absurdF(pc.G(c, dead, Cr.finish.run(True{}, p, c, o, i, s, st, nx, k, cl, Nil{}, ss, h)), eq)
        case +w <> +t:
          match t:
            case +y <> +u:
              (h1, g2) = g
              match h1:
            case Nil{}:
              match cl:
                case None{}:
                  (h1, g2) = g
                  match h1:
                case Some{+x}:
                  match x:
                    case Cr.Claim{+xo, +w2}:
                      (h1, g2) = g
                      (h2, g3) = g2
                      (h3, g4) = g3
                      (h4, g5) = g4
                      (h5, g6) = g5
                      (h6, h7) = g6
                      +ewp = cron.pc.eq_of(w, p, cron.pc.or_false_r(Nat.is_eq(w, p), eq))
                      +w2p = Equal.trans(Nat, w2, w, p, h1, ewp)
                      %Equal.sym(Nat, w2, p, w2p) : pc.G(c, dead, Cr.finish.own(Nat.is_eq(_, p), Cr.Claim{xo, _}, c, o, i, s, st, nx, k, Cr.drop(p, [w]), ss, h))
                      %Equal.sym(Nat, w, p, ewp) : pc.G(c, dead, Cr.finish.own(Nat.is_eq(p, p), Cr.Claim{xo, p}, c, o, i, s, st, nx, k, Cr.drop.put(Nat.is_eq(_, p), _, Nil{}), ss, h))
                      %Equal.sym(Bool, Nat.is_eq(p, p), True{}, cron.pc.eq_refl(p)) : pc.G(c, dead, Cr.finish.own(_, Cr.Claim{xo, p}, c, o, i, s, st, nx, k, Cr.drop.put(_, p, Nil{}), ss, h))
                      pc.fin_st(st, Cr.Claim{xo, p}, c, dead, o, i, s, nx, k, ss, h, h3, h4, h5, h6)

def pc.g_finish(+p: Nat, +c: Nat, +o: Cr.Out, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.finish(p, c, o, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      pc.fin_run(Cr.has(p, rs), rs, cl, p, c, o, dead, i, s, st, nx, k, ss, h, {==}, g)

def pc.pick_fin(b: Bool, +p: Nat, +c: Nat, +o: Cr.Out, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.job.pick(b, Cr.finish(p, c, o, j), j)):
  match b:
    case True{}:
      pc.g_finish(p, c, o, dead, j, g)
    case False{}:
      g

# User actions keep the invariant
# -------------------------------

def pc.g_cancel(+c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.cancel(j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Cancelled{}:
          g
        case Cr.Active{}:
          (h1, g2) = g
          (h2, g3) = g2
          (h3, g4) = g3
          (h4, g5) = g4
          (h5, g6) = g5
          (h6, h7) = g6
          (h1, (h2, (h3, (pc.top_none(ss, c, nx, h4), (pc.once_none(s, ss, nx, h5), (pc.cnt_down(Cr.Cancelled{}, k, h, h6), pc.ends_cancel(s, rs)))))))
        case Cr.Paused{}:
          (h1, g2) = g
          (h2, g3) = g2
          (h3, g4) = g3
          (h4, g5) = g4
          (h5, g6) = g5
          (h6, h7) = g6
          (h1, (h2, (h3, (pc.top_none(ss, c, nx, h4), (pc.once_none(s, ss, nx, h5), (h6, pc.ends_cancel(s, rs)))))))
        case Cr.Finished{}:
          (h1, g2) = g
          (h2, g3) = g2
          (h3, g4) = g3
          (h4, g5) = g4
          (h5, g6) = g5
          (h6, h7) = g6
          (h1, (h2, (h3, (pc.top_none(ss, c, nx, h4), (pc.once_none(s, ss, nx, h5), (h6, pc.ends_cancel(s, rs)))))))

def pc.pick_cancel(b: Bool, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.job.pick(b, Cr.cancel(j), j)):
  match b:
    case True{}:
      pc.g_cancel(c, dead, j, g)
    case False{}:
      g

def pc.g_resume(+c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.resume(c, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match s:
        case Cr.Once{+d}:
          g
        case Cr.Every{+q}:
          match st:
            case Cr.Active{}:
              (h1, g2) = g
              (h2, g3) = g2
              (h3, g4) = g3
              (h4, g5) = g4
              (h1, (h2, (h3, (pc.top_adv(ss, Cr.Every{q}, c, nx, h4), (Unit{}, (({==}, {==}), Unit{}))))))
            case Cr.Paused{}:
              (h1, g2) = g
              (h2, g3) = g2
              (h3, g4) = g3
              (h4, g5) = g4
              (h1, (h2, (h3, (pc.top_adv(ss, Cr.Every{q}, c, nx, h4), (Unit{}, (({==}, {==}), Unit{}))))))
            case Cr.Finished{}:
              g
            case Cr.Cancelled{}:
              g

def pc.pick_resume(b: Bool, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.job.pick(b, Cr.resume(c, j), j)):
  match b:
    case True{}:
      pc.g_resume(c, dead, j, g)
    case False{}:
      g

# A pass that unwinds, or a process that dies, keeps the invariant
# ----------------------------------------------------------------

def pc.or_ff(a: Bool, +b: Bool, ha: {a == False{} : Bool}, hb: {b == False{} : Bool}) -> {Bool.or(a, b) == False{} : Bool}:
  match a:
    case True{}:
      cron.pc.absurd({Bool.or(True{}, b) == False{} : Bool}, ha)
    case False{}:
      hb

def pc.abort_one(b: Bool, +w: Nat, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +cl: Maybe<&2, Cr.Claim>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, g: pc.G(c, dead, Cr.Job{i, s, st, nx, k, cl, [w], ss, h})) -> pc.G(c, dead, Cr.Job{i, s, st, nx, k, cl, Cr.drop.put(b, w, Nil{}), ss, h}):
  match b:
    case True{}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      (Unit{}, (Unit{}, (h3, (h4, (h5, (h6, pc.ends_nil(s, st)))))))
    case False{}:
      g

def pc.g_abort(+p: Nat, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, dead, Cr.unrun(p, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match rs:
        case Nil{}:
          g
        case +w <> +t:
          match t:
            case Nil{}:
              pc.abort_one(Nat.is_eq(w, p), w, c, dead, i, s, st, nx, k, cl, ss, h, g)
            case +y <> +u:
              (h1, g2) = g
              match h1:

def pc.die_one(b: Bool, +w: Nat, +p: Nat, +c: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +cl: Maybe<&2, Cr.Claim>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, eqb: {Nat.is_eq(w, p) == b : Bool}, g: pc.G(c, dead, Cr.Job{i, s, st, nx, k, cl, [w], ss, h})) -> pc.G(c, p <> dead, Cr.Job{i, s, st, nx, k, cl, Cr.drop.put(b, w, Nil{}), ss, h}):
  match b:
    case True{}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h5, g6) = g5
      (h6, h7) = g6
      (Unit{}, (Unit{}, (h3, (h4, (h5, (h6, pc.ends_nil(s, st)))))))
    case False{}:
      (h1, g2) = g
      (h2, g3) = g2
      (live, un) = h2
      (h1, ((pc.or_ff(Nat.is_eq(p, w), Cr.has(w, dead), pc.eq_flip(w, p, eqb), live), Unit{}), g3))

def pc.g_die(+p: Nat, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(c, p <> dead, Cr.unrun(p, j)):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      match rs:
        case Nil{}:
          (h1, g2) = g
          (h2, g3) = g2
          (Unit{}, (Unit{}, g3))
        case +w <> +t:
          match t:
            case Nil{}:
              pc.die_one(Nat.is_eq(w, p), w, p, c, dead, i, s, st, nx, k, cl, ss, h, {==}, g)
            case +y <> +u:
              (h1, g2) = g
              match h1:

# Every event keeps the invariant
# -------------------------------

# what an event needs of its process: a claim, that it is alive
def pc.Alive(e: Cr.Ev, +dead: List<&2, Nat>) -> Data:
  match e:
    case Cr.Take{p}:
      {Cr.has(p, dead) == False{} : Bool}
    case Cr.Create{p, s}:
      Unit
    case Cr.Recover{p}:
      Unit
    case Cr.Finish{p, i, o}:
      Unit
    case Cr.Abort{p}:
      Unit
    case Cr.Die{p}:
      Unit
    case Cr.Cancel{p, i}:
      Unit
    case Cr.Resume{p, i}:
      Unit
    case Cr.Tick{d}:
      Unit
    case Cr.RawJob{t}:
      Unit
    case Cr.RawClaim{t}:
      Unit
    case Cr.Corrupt{t}:
      Unit

def pc.dead_after(e: Cr.Ev, +dead: List<&2, Nat>) -> List<&2, Nat>:
  match e:
    case Cr.Die{p}:
      p <> dead
    case Cr.Take{p}:
      dead
    case Cr.Create{p, s}:
      dead
    case Cr.Recover{p}:
      dead
    case Cr.Finish{p, i, o}:
      dead
    case Cr.Abort{p}:
      dead
    case Cr.Cancel{p, i}:
      dead
    case Cr.Resume{p, i}:
      dead
    case Cr.Tick{d}:
      dead
    case Cr.RawJob{t}:
      dead
    case Cr.RawClaim{t}:
      dead
    case Cr.Corrupt{t}:
      dead

def pc.g_job(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, +al: pc.Alive(e, dead), g: pc.G(c, dead, j)) -> pc.G(c, pc.dead_after(e, dead), Cr.job(e, c, dead, j)):
  match e:
    case Cr.Take{+p}:
      pc.g_take(p, c, dead, j, al, g)
    case Cr.Recover{+p}:
      pc.g_recover(p, dead, c, j, g)
    case Cr.Finish{+p, +i, +o}:
      pc.pick_fin(Nat.is_eq(Cr.Job.id(j), i), p, c, o, dead, j, g)
    case Cr.Abort{+p}:
      pc.g_abort(p, c, dead, j, g)
    case Cr.Die{+p}:
      pc.g_die(p, c, dead, j, g)
    case Cr.Cancel{+p, +i}:
      pc.pick_cancel(Nat.is_eq(Cr.Job.id(j), i), c, dead, j, g)
    case Cr.Resume{+p, +i}:
      pc.pick_resume(Nat.is_eq(Cr.Job.id(j), i), c, dead, j, g)
    case Cr.Create{p, s}:
      g
    case Cr.Tick{d}:
      g
    case Cr.RawJob{t}:
      g
    case Cr.RawClaim{t}:
      g
    case Cr.Corrupt{t}:
      g

def pc.all_recs(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, +al: pc.Alive(e, dead), g: pc.AllG(c, dead, rs)) -> pc.AllG(c, pc.dead_after(e, dead), Cr.recs(e, c, dead, rs)):
  match rs:
    case Nil{}:
      Unit{}
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = g
          (pc.g_job(e, c, dead, j, al, a), pc.all_recs(e, c, dead, t, al, b))
        case Cr.Raw{x}:
          pc.all_recs(e, c, dead, t, al, g)

def pc.all_append(+c: Nat, +dead: List<&2, Nat>, xs: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, gx: pc.AllG(c, dead, xs), gy: pc.AllG(c, dead, ys)) -> pc.AllG(c, dead, List.append(&2, Cr.Rec, xs, ys)):
  match xs:
    case Nil{}:
      gy
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = gx
          (a, pc.all_append(c, dead, t, ys, b, gy))
        case Cr.Raw{x}:
          pc.all_append(c, dead, t, ys, gx, gy)

def pc.top_tick(+ss: List<&2, Nat>, +c: Nat, +d: Nat, -nx: Maybe<&2, Nat>, t: pc.Top(ss, c, nx)) -> pc.Top(ss, Nat.add(c, d), nx):
  match ss:
    case Nil{}:
      Unit{}
    case +x <> +u:
      (a, b) = t
      (cron.pc.le_add(x, c, d, a), b)

def pc.g_tick(+c: Nat, +d: Nat, +dead: List<&2, Nat>, +j: Cr.Job, g: pc.G(c, dead, j)) -> pc.G(Nat.add(c, d), dead, j):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      (h1, g2) = g
      (h2, g3) = g2
      (h3, g4) = g3
      (h4, g5) = g4
      (h1, (h2, (h3, (pc.top_tick(ss, c, d, nx, h4), g5))))

def pc.all_tick(+c: Nat, +d: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, g: pc.AllG(c, dead, rs)) -> pc.AllG(Nat.add(c, d), dead, rs):
  match rs:
    case Nil{}:
      Unit{}
    case r <> t:
      match r:
        case Cr.Known{+j}:
          (a, b) = g
          (pc.g_tick(c, d, dead, j, a), pc.all_tick(c, d, dead, t, b))
        case Cr.Raw{x}:
          pc.all_tick(c, d, dead, t, g)

def pc.once_empty(+s: Cr.Sched, -nx: Maybe<&2, Nat>) -> pc.OnceG(s, Nil{}, nx):
  match s:
    case Cr.Once{d}:
      Unit{}
    case Cr.Every{q}:
      Unit{}

def pc.g_new(+c: Nat, +dead: List<&2, Nat>, +n: Nat, +sc: Cr.Sched) -> pc.G(c, dead, Cr.Job{n, sc, Cr.Active{}, Some{Cr.first(sc, c)}, 0n, None{}, Nil{}, Nil{}, Nil{}}):
  (Unit{}, (Unit{}, (Unit{}, (Unit{}, (pc.once_empty(sc, Some{Cr.first(sc, c)}), (({==}, {==}), pc.ends_active(sc, Nil{})))))))

def pc.alive_create(b: Bool, +c: Nat, +dead: List<&2, Nat>, +n: Nat, +sc: Cr.Sched, +rs: List<&2, Cr.Rec>, -bad: Maybe<&2, Nat>, -rd: List<&2, Nat>, -aside: List<&2, Nat>, inv: pc.AllG(c, dead, rs)) -> pc.Inv(Cr.step.alive(b, Cr.S{None{}, List.append(&2, Cr.Rec, rs, [Cr.Known{Cr.Job{n, sc, Cr.Active{}, Some{Cr.first(sc, c)}, 0n, None{}, Nil{}, Nil{}, Nil{}}}]), rd, dead, c, 1n+n, Cr.heal(bad, aside)}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match b:
    case False{}:
      pc.all_append(c, dead, rs, [Cr.Known{Cr.Job{n, sc, Cr.Active{}, Some{Cr.first(sc, c)}, 0n, None{}, Nil{}, Nil{}, Nil{}}}], inv, (pc.g_new(c, dead, n, sc), Unit{}))
    case True{}:
      inv

def pc.alive_take(b: Bool, +p: Nat, +c: Nat, +dead: List<&2, Nat>, +rs: List<&2, Cr.Rec>, -b1: Maybe<&2, Nat>, -rd1: List<&2, Nat>, -n1: Nat, -a1: List<&2, Nat>, -b0: Maybe<&2, Nat>, -rd0: List<&2, Nat>, -n0: Nat, -a0: List<&2, Nat>, eqb: {Cr.has(p, dead) == b : Bool}, inv: pc.AllG(c, dead, rs)) -> pc.Inv(Cr.step.alive(b, Cr.S{b1, Cr.recs(Cr.Take{p}, c, dead, rs), rd1, dead, c, n1, a1}, Cr.S{b0, rs, rd0, dead, c, n0, a0})):
  match b:
    case False{}:
      pc.all_recs(Cr.Take{p}, c, dead, rs, eqb, inv)
    case True{}:
      inv

def pc.alive_recs(b: Bool, +e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +rs: List<&2, Cr.Rec>, -b1: Maybe<&2, Nat>, -rd1: List<&2, Nat>, -n1: Nat, -a1: List<&2, Nat>, -b0: Maybe<&2, Nat>, -rd0: List<&2, Nat>, -n0: Nat, -a0: List<&2, Nat>, +al: pc.Alive(e, dead), de: {pc.dead_after(e, dead) == dead : List<&2, Nat>}, inv: pc.AllG(c, dead, rs)) -> pc.Inv(Cr.step.alive(b, Cr.S{b1, Cr.recs(e, c, dead, rs), rd1, dead, c, n1, a1}, Cr.S{b0, rs, rd0, dead, c, n0, a0})):
  match b:
    case False{}:
      %de : pc.AllG(c, _, Cr.recs(e, c, dead, rs))
      pc.all_recs(e, c, dead, rs, al, inv)
    case True{}:
      inv

def pc.raw_job(bad: Maybe<&2, Nat>, +t: Nat, +c: Nat, +dead: List<&2, Nat>, +rs: List<&2, Cr.Rec>, -rd: List<&2, Nat>, -n: Nat, -aside: List<&2, Nat>, inv: pc.AllG(c, dead, rs)) -> pc.Inv(Cr.step.raw(bad, Cr.S{None{}, List.append(&2, Cr.Rec, rs, [Cr.Raw{t}]), rd, dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      pc.all_append(c, dead, rs, [Cr.Raw{t}], inv, Unit{})
    case Some{x}:
      inv

def pc.raw_claim(bad: Maybe<&2, Nat>, +t: Nat, +c: Nat, +dead: List<&2, Nat>, +rs: List<&2, Cr.Rec>, -rd: List<&2, Nat>, -n: Nat, -aside: List<&2, Nat>, inv: pc.AllG(c, dead, rs)) -> pc.Inv(Cr.step.raw(bad, Cr.S{None{}, rs, List.append(&2, Nat, rd, [t]), dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      inv
    case Some{x}:
      inv

def pc.inv_step(s: Cr.S, +e: Cr.Ev, inv: pc.Inv(s)) -> pc.Inv(Cr.step(s, e)):
  match s:
    case Cr.S{+bad, +rs, +rd, +dead, +c, +n, +aside}:
      match e:
        case Cr.Create{+p, +sc}:
          pc.alive_create(Cr.has(p, dead), c, dead, n, sc, rs, bad, rd, aside, inv)
        case Cr.Take{+p}:
          pc.alive_take(Cr.has(p, dead), p, c, dead, rs, None{}, rd, n, Cr.heal(bad, aside), bad, rd, n, aside, {==}, inv)
        case Cr.Recover{+p}:
          pc.alive_recs(Cr.has(p, dead), Cr.Recover{p}, c, dead, rs, None{}, rd, n, Cr.heal(bad, aside), bad, rd, n, aside, Unit{}, {==}, inv)
        case Cr.Finish{+p, +i, +o}:
          pc.alive_recs(Cr.has(p, dead), Cr.Finish{p, i, o}, c, dead, rs, None{}, rd, n, Cr.heal(bad, aside), bad, rd, n, aside, Unit{}, {==}, inv)
        case Cr.Abort{+p}:
          pc.alive_recs(Cr.has(p, dead), Cr.Abort{p}, c, dead, rs, bad, rd, n, aside, bad, rd, n, aside, Unit{}, {==}, inv)
        case Cr.Die{+p}:
          pc.all_recs(Cr.Die{p}, c, dead, rs, Unit{}, inv)
        case Cr.Cancel{+p, +i}:
          pc.alive_recs(Cr.has(p, dead), Cr.Cancel{p, i}, c, dead, rs, bad, rd, n, aside, bad, rd, n, aside, Unit{}, {==}, inv)
        case Cr.Resume{+p, +i}:
          pc.alive_recs(Cr.has(p, dead), Cr.Resume{p, i}, c, dead, rs, bad, rd, n, aside, bad, rd, n, aside, Unit{}, {==}, inv)
        case Cr.Tick{+d}:
          pc.all_tick(c, d, dead, rs, inv)
        case Cr.RawJob{+t}:
          pc.raw_job(bad, t, c, dead, rs, rd, n, aside, inv)
        case Cr.RawClaim{+t}:
          pc.raw_claim(bad, t, c, dead, rs, rd, n, aside, inv)
        case Cr.Corrupt{t}:
          Unit{}

def pc.inv_go(evs: List<&2, Cr.Ev>, +s: Cr.S, inv: pc.Inv(s)) -> pc.Inv(Cr.go(evs, s)):
  match evs:
    case Nil{}:
      inv
    case +e <> rest:
      pc.inv_go(rest, Cr.step(s, e), pc.inv_step(s, e, inv))

def pc.inv_run(evs: List<&2, Cr.Ev>) -> pc.Inv(Cr.run(evs)):
  pc.inv_go(evs, Cr.S.empty(), Unit{})

def pc.fires_of(s: Cr.S, inv: pc.Inv(s)) -> Cr.FiresAll(Cr.S.recs(s)):
  match s:
    case Cr.S{b, rs, rd, +dead, +c, n, a}:
      pc.all_fires(c, dead, rs, inv)

def pc.ends_of(s: Cr.S, inv: pc.Inv(s)) -> Cr.EndsAll(Cr.S.recs(s)):
  match s:
    case Cr.S{b, rs, rd, +dead, +c, n, a}:
      pc.all_ends(c, dead, rs, inv)

def pc.stops_of(s: Cr.S, inv: pc.Inv(s)) -> Cr.StopsAll(Cr.S.recs(s)):
  match s:
    case Cr.S{b, rs, rd, +dead, +c, n, a}:
      pc.all_stops(c, dead, rs, inv)

# ---- cron_step ----

# proof_cron_step: the cron laws of LAWS.bend section cron (D2) about one step from
# any state (bend/cron.bend): no step but the file's corruption drops a
# record (`cron_never_drops`); a step of p removes the claim of o only when
# o is p or dead (`cron_claim_owned`); a paused job stays paused through
# every step that is not a user action, and the failure backoff never
# shrinks (the rest of `cron_backoff_bounded`). The invariant laws are in
# PROOF.bend section cron.

# Logic, from PROOF.bend section cron
# --------------------------------

def cron_step.pc.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  cron.pc.absurd(A, e)

def cron_step.pc.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  cron.pc.absurdF(A, e)

def cron_step.pc.void(-A: Type, e: Empty) -> A:
  cron.pc.void(A, e)

def cron_step.pc.eq_refl(k: Nat) -> {Nat.is_eq(k, k) == True{} : Bool}:
  cron.pc.eq_refl(k)

def cron_step.pc.eq_of(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  cron.pc.eq_of(a, b, h)

def cron_step.pc.or_l(a: Bool, b: Bool, h: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  cron.pc.or_l(a, b, h)

def cron_step.pc.or_r(a: Bool, b: Bool, h: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  cron.pc.or_r(a, b, h)

def cron_step.pc.le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  cron.pc.le_refl(n)

# Ids stay
# --------

def pc.id_take_due(b: Bool, +p: Nat, +c: Nat, +i: Nat, +s: Cr.Sched, +n: Nat, +k: Nat, cl: Maybe<&2, Cr.Claim>, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.take.due(b, p, c, i, s, n, k, cl, rs, ss, h)) == i : Nat}:
  match b:
    case False{}:
      {==}
    case True{}:
      match cl:
        case None{}:
          {==}
        case Some{x}:
          {==}

def pc.id_take(+p: Nat, +c: Nat, j: Cr.Job) -> {Cr.Job.id(Cr.take(p, c, j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{+i, +s, st, nx, +k, cl, +rs, +ss, +h}:
      match st:
        case Cr.Active{}:
          match nx:
            case None{}:
              {==}
            case Some{+n}:
              pc.id_take_due(Nat.is_le(n, c), p, c, i, s, n, k, cl, rs, ss, h)
        case Cr.Paused{}:
          {==}
        case Cr.Finished{}:
          {==}
        case Cr.Cancelled{}:
          {==}

def pc.id_rec_go(b: Bool, st: Cr.Status, +s: Cr.Sched, +i: Nat, +nx: Maybe<&2, Nat>, +k: Nat, +x: Cr.Claim, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.recover.go(b, i, s, st, nx, k, x, rs, ss, h)) == i : Nat}:
  match b:
    case False{}:
      {==}
    case True{}:
      match st:
        case Cr.Active{}:
          match s:
            case Cr.Once{d}:
              {==}
            case Cr.Every{q}:
              {==}
        case Cr.Paused{}:
          {==}
        case Cr.Finished{}:
          {==}
        case Cr.Cancelled{}:
          {==}

def pc.id_recover(+p: Nat, +dead: List<&2, Nat>, j: Cr.Job) -> {Cr.Job.id(Cr.recover(p, dead, j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, cl, +rs, +ss, +h}:
      match cl:
        case None{}:
          {==}
        case Some{x}:
          match x:
            case Cr.Claim{+xo, +o}:
              pc.id_rec_go(Cr.clears(p, o, rs, dead), st, s, i, nx, k, Cr.Claim{xo, o}, rs, ss, h)

def pc.id_fail(b: Bool, +c: Nat, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.finish.fail(b, c, i, s, nx, k, rs, ss, h)) == i : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pc.id_count(b: Bool, +c: Nat, +o: Cr.Out, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.finish.count(b, c, o, i, s, nx, k, rs, ss, h)) == i : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      match o:
        case Cr.Win{}:
          {==}
        case Cr.Skip{}:
          {==}
        case Cr.Loss{}:
          pc.id_fail(Nat.is_lt(1n+k, Cr.CAP()), c, i, s, nx, 1n+k, rs, ss, Cr.MLoss{} <> h)

def pc.id_own(b: Bool, +x: Cr.Claim, +c: Nat, +o: Cr.Out, +i: Nat, +s: Cr.Sched, st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.finish.own(b, x, c, o, i, s, st, nx, k, rs, ss, h)) == i : Nat}:
  match b:
    case False{}:
      {==}
    case True{}:
      match st:
        case Cr.Active{}:
          pc.id_count(Cr.is_once(s), c, o, i, s, nx, k, rs, ss, h)
        case Cr.Paused{}:
          {==}
        case Cr.Finished{}:
          {==}
        case Cr.Cancelled{}:
          {==}

def pc.id_run(b: Bool, +p: Nat, +c: Nat, +o: Cr.Out, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, cl: Maybe<&2, Cr.Claim>, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> {Cr.Job.id(Cr.finish.run(b, p, c, o, i, s, st, nx, k, cl, rs, ss, h)) == i : Nat}:
  match b:
    case False{}:
      {==}
    case True{}:
      match cl:
        case None{}:
          {==}
        case Some{x}:
          match x:
            case Cr.Claim{+xo, +w}:
              pc.id_own(Nat.is_eq(w, p), Cr.Claim{xo, w}, c, o, i, s, st, nx, k, Cr.drop(p, rs), ss, h)

def pc.id_finish(+p: Nat, +c: Nat, +o: Cr.Out, j: Cr.Job) -> {Cr.Job.id(Cr.finish(p, c, o, j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
      pc.id_run(Cr.has(p, rs), p, c, o, i, s, st, nx, k, cl, rs, ss, h)

def pc.id_cancel(j: Cr.Job) -> {Cr.Job.id(Cr.cancel(j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
      match st:
        case Cr.Cancelled{}:
          {==}
        case Cr.Active{}:
          {==}
        case Cr.Paused{}:
          {==}
        case Cr.Finished{}:
          {==}

def pc.id_resume(+c: Nat, j: Cr.Job) -> {Cr.Job.id(Cr.resume(c, j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
      match s:
        case Cr.Once{d}:
          {==}
        case Cr.Every{q}:
          match st:
            case Cr.Active{}:
              {==}
            case Cr.Paused{}:
              {==}
            case Cr.Finished{}:
              {==}
            case Cr.Cancelled{}:
              {==}

def pc.id_unrun(+p: Nat, j: Cr.Job) -> {Cr.Job.id(Cr.unrun(p, j)) == Cr.Job.id(j) : Nat}:
  match j:
    case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
      {==}

def pc.id_pick(b: Bool, a: Cr.Job, +j: Cr.Job, ea: {Cr.Job.id(a) == Cr.Job.id(j) : Nat}) -> {Cr.Job.id(Cr.job.pick(b, a, j)) == Cr.Job.id(j) : Nat}:
  match b:
    case True{}:
      ea
    case False{}:
      {==}

def pc.id_job(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job) -> {Cr.Job.id(Cr.job(e, c, dead, j)) == Cr.Job.id(j) : Nat}:
  match e:
    case Cr.Take{+p}:
      pc.id_take(p, c, j)
    case Cr.Recover{+p}:
      pc.id_recover(p, dead, j)
    case Cr.Finish{+p, +i, +o}:
      pc.id_pick(Nat.is_eq(Cr.Job.id(j), i), Cr.finish(p, c, o, j), j, pc.id_finish(p, c, o, j))
    case Cr.Abort{+p}:
      pc.id_unrun(p, j)
    case Cr.Die{+p}:
      pc.id_unrun(p, j)
    case Cr.Cancel{+p, +i}:
      pc.id_pick(Nat.is_eq(Cr.Job.id(j), i), Cr.cancel(j), j, pc.id_cancel(j))
    case Cr.Resume{+p, +i}:
      pc.id_pick(Nat.is_eq(Cr.Job.id(j), i), Cr.resume(c, j), j, pc.id_resume(c, j))
    case Cr.Create{p, s}:
      {==}
    case Cr.Tick{d}:
      {==}
    case Cr.RawJob{t}:
      {==}
    case Cr.RawClaim{t}:
      {==}
    case Cr.Corrupt{t}:
      {==}

# Nothing is dropped
# ------------------

def pc.or_mono(a: Bool, b: Bool, -b2: Bool, h: {Bool.or(a, b) == True{} : Bool}, f: {b == True{} : Bool} -> {b2 == True{} : Bool}) -> {Bool.or(a, b2) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      f(h)

def pc.raw_recs(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, +t: Nat, h: {Cr.has_raw(t, rs) == True{} : Bool}) -> {Cr.has_raw(t, Cr.recs(e, c, dead, rs)) == True{} : Bool}:
  match rs:
    case Nil{}:
      h
    case r <> +rest:
      match r:
        case Cr.Raw{+x}:
          pc.or_mono(Nat.is_eq(x, t), Cr.has_raw(t, rest), Cr.has_raw(t, Cr.recs(e, c, dead, rest)), h, q => pc.raw_recs(e, c, dead, rest, t, q))
        case Cr.Known{j}:
          pc.raw_recs(e, c, dead, rest, t, h)

def pc.raw_append(rs: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +t: Nat, h: {Cr.has_raw(t, rs) == True{} : Bool}) -> {Cr.has_raw(t, List.append(&2, Cr.Rec, rs, ys)) == True{} : Bool}:
  match rs:
    case Nil{}:
      cron_step.pc.absurdF({Cr.has_raw(t, ys) == True{} : Bool}, h)
    case r <> +rest:
      match r:
        case Cr.Raw{+x}:
          pc.or_mono(Nat.is_eq(x, t), Cr.has_raw(t, rest), Cr.has_raw(t, List.append(&2, Cr.Rec, rest, ys)), h, q => pc.raw_append(rest, ys, t, q))
        case Cr.Known{j}:
          pc.raw_append(rest, ys, t, h)

def pc.job_recs(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, +i: Nat, h: {Cr.has_job(i, rs) == True{} : Bool}) -> {Cr.has_job(i, Cr.recs(e, c, dead, rs)) == True{} : Bool}:
  match rs:
    case Nil{}:
      h
    case r <> +rest:
      match r:
        case Cr.Raw{x}:
          pc.job_recs(e, c, dead, rest, i, h)
        case Cr.Known{+j}:
          %Equal.sym(Nat, Cr.Job.id(Cr.job(e, c, dead, j)), Cr.Job.id(j), pc.id_job(e, c, dead, j)) : {Bool.or(Nat.is_eq(_, i), Cr.has_job(i, Cr.recs(e, c, dead, rest))) == True{} : Bool}
          pc.or_mono(Nat.is_eq(Cr.Job.id(j), i), Cr.has_job(i, rest), Cr.has_job(i, Cr.recs(e, c, dead, rest)), h, q => pc.job_recs(e, c, dead, rest, i, q))

def pc.job_append(rs: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +i: Nat, h: {Cr.has_job(i, rs) == True{} : Bool}) -> {Cr.has_job(i, List.append(&2, Cr.Rec, rs, ys)) == True{} : Bool}:
  match rs:
    case Nil{}:
      cron_step.pc.absurdF({Cr.has_job(i, ys) == True{} : Bool}, h)
    case r <> +rest:
      match r:
        case Cr.Raw{x}:
          pc.job_append(rest, ys, i, h)
        case Cr.Known{+j}:
          pc.or_mono(Nat.is_eq(Cr.Job.id(j), i), Cr.has_job(i, rest), Cr.has_job(i, List.append(&2, Cr.Rec, rest, ys)), h, q => pc.job_append(rest, ys, i, q))

def pc.has_append(xs: List<&2, Nat>, +ys: List<&2, Nat>, +t: Nat, h: {Cr.has(t, xs) == True{} : Bool}) -> {Cr.has(t, List.append(&2, Nat, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      cron_step.pc.absurdF({Cr.has(t, ys) == True{} : Bool}, h)
    case +x <> +rest:
      pc.or_mono(Nat.is_eq(x, t), Cr.has(t, rest), Cr.has(t, List.append(&2, Nat, rest, ys)), h, q => pc.has_append(rest, ys, t, q))

def cron_step.pc.ND(m: Maybe<&2, Nat>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      Empty

def pc.none_some_t(-t: Nat, h: {None{} == Some{t} : Maybe<&2, Nat>}) -> Empty:
  %h : cron_step.pc.ND(_)
  Unit{}

def pc.MDP(m: Maybe<&2, Nat>) -> Nat:
  match m:
    case None{}:
      0n
    case Some{x}:
      x

# the corrupt file t is moved aside
def pc.heal_has(bad: Maybe<&2, Nat>, +t: Nat, +aside: List<&2, Nat>, h: {bad == Some{t} : Maybe<&2, Nat>}) -> {Cr.has(t, Cr.heal(bad, aside)) == True{} : Bool}:
  match bad:
    case None{}:
      cron_step.pc.void({Cr.has(t, aside) == True{} : Bool}, pc.none_some_t(t, h))
    case Some{+x}:
      +xt = Equal.cong(Maybe<&2, Nat>, Nat, m => pc.MDP(m), Some{x}, Some{t}, h)
      %Equal.sym(Nat, x, t, xt) : {Bool.or(Nat.is_eq(_, t), Cr.has(t, aside)) == True{} : Bool}
      cron_step.pc.or_l(Nat.is_eq(t, t), Cr.has(t, aside), cron_step.pc.eq_refl(t))

def pc.heal_keep(bad: Maybe<&2, Nat>, +t: Nat, +aside: List<&2, Nat>, h: {Cr.has(t, aside) == True{} : Bool}) -> {Cr.has(t, Cr.heal(bad, aside)) == True{} : Bool}:
  match bad:
    case None{}:
      h
    case Some{+x}:
      cron_step.pc.or_r(Nat.is_eq(x, t), Cr.has(t, aside), h)

def pc.keeps_refl(+t: Nat, +i: Nat, +s: Cr.S) -> Cr.Keeps(t, i, s, s):
  (h => h, (h => h, (h => h, (h => Inl{h}, h => h))))

def pc.keeps_alive(b: Bool, +t: Nat, +i: Nat, +s: Cr.S, +a: Cr.S, ka: Cr.Keeps(t, i, s, a)) -> Cr.Keeps(t, i, s, Cr.step.alive(b, a, s)):
  match b:
    case False{}:
      ka
    case True{}:
      pc.keeps_refl(t, i, s)

def pc.keeps_raw_job(bad: Maybe<&2, Nat>, +x: Nat, +t: Nat, +i: Nat, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>) -> Cr.Keeps(t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.step.raw(bad, Cr.S{None{}, List.append(&2, Cr.Rec, rs, [Cr.Raw{x}]), rd, dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      (h => pc.raw_append(rs, [Cr.Raw{x}], t, h), (h => pc.job_append(rs, [Cr.Raw{x}], i, h), (h => h, (h => cron_step.pc.void(Or({None{} == Some{t} : Maybe<&2, Nat>}, {Cr.has(t, aside) == True{} : Bool}), pc.none_some_t(t, h)), h => h))))
    case Some{+y}:
      pc.keeps_refl(t, i, Cr.S{Some{y}, rs, rd, dead, c, n, aside})

def pc.keeps_raw_claim(bad: Maybe<&2, Nat>, +x: Nat, +t: Nat, +i: Nat, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>) -> Cr.Keeps(t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.step.raw(bad, Cr.S{None{}, rs, List.append(&2, Nat, rd, [x]), dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      (h => h, (h => h, (h => pc.has_append(rd, [x], t, h), (h => cron_step.pc.void(Or({None{} == Some{t} : Maybe<&2, Nat>}, {Cr.has(t, aside) == True{} : Bool}), pc.none_some_t(t, h)), h => h))))
    case Some{+y}:
      pc.keeps_refl(t, i, Cr.S{Some{y}, rs, rd, dead, c, n, aside})

def pc.never_drops(s: Cr.S, +e: Cr.Ev, +t: Nat, +i: Nat, nc: {Cr.Ev.is_corrupt(e) == False{} : Bool}) -> Cr.Keeps(t, i, s, Cr.step(s, e)):
  match s:
    case Cr.S{+bad, +rs, +rd, +dead, +c, +n, +aside}:
      match e:
        case Cr.Create{+p, +sc}:
          +new = {[Cr.Known{Cr.Job{n, sc, Cr.Active{}, Some{Cr.first(sc, c)}, 0n, None{}, Nil{}, Nil{}, Nil{}}}] : List<&2, Cr.Rec>}
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, List.append(&2, Cr.Rec, rs, new), rd, dead, c, 1n+n, Cr.heal(bad, aside)}, (h => pc.raw_append(rs, new, t, h), (h => pc.job_append(rs, new, i, h), (h => h, (h => Inr{pc.heal_has(bad, t, aside, h)}, h => pc.heal_keep(bad, t, aside, h))))))
        case Cr.Take{+p}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inr{pc.heal_has(bad, t, aside, h)}, h => pc.heal_keep(bad, t, aside, h))))))
        case Cr.Recover{+p}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inr{pc.heal_has(bad, t, aside, h)}, h => pc.heal_keep(bad, t, aside, h))))))
        case Cr.Finish{+p, +ji, +o}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inr{pc.heal_has(bad, t, aside, h)}, h => pc.heal_keep(bad, t, aside, h))))))
        case Cr.Abort{+p}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inl{h}, h => h)))))
        case Cr.Die{+p}:
          (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inl{h}, h => h))))
        case Cr.Cancel{+p, +ji}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inl{h}, h => h)))))
        case Cr.Resume{+p, +ji}:
          pc.keeps_alive(Cr.has(p, dead), t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, (h => pc.raw_recs(e, c, dead, rs, t, h), (h => pc.job_recs(e, c, dead, rs, i, h), (h => h, (h => Inl{h}, h => h)))))
        case Cr.Tick{+d}:
          (h => h, (h => h, (h => h, (h => Inl{h}, h => h))))
        case Cr.RawJob{+x}:
          pc.keeps_raw_job(bad, x, t, i, rs, rd, dead, c, n, aside)
        case Cr.RawClaim{+x}:
          pc.keeps_raw_claim(bad, x, t, i, rs, rd, dead, c, n, aside)
        case Cr.Corrupt{x}:
          cron_step.pc.absurd(Cr.Keeps(t, i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{Some{x}, Nil{}, Nil{}, dead, c, n, aside}), nc)

# Claims belong to their owners
# -----------------------------

def pc.MCD(m: Maybe<&2, Cr.Claim>, A: Type) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      A

def pc.none_some_c(-A: Type, -x: Cr.Claim, e: {None{} == Some{x} : Maybe<&2, Cr.Claim>}) -> A:
  %e : pc.MCD(_, A)
  Unit{}

def pc.owner_of(m: Maybe<&2, Cr.Claim>) -> Nat:
  match m:
    case None{}:
      0n
    case Some{x}:
      match x:
        case Cr.Claim{q, w}:
          w

# what a step may do to the claim of o on a job
def pc.CK(+e: Cr.Ev, +dead: List<&2, Nat>, j2: Cr.Job, +x: Nat, +o: Nat) -> Type:
  Or({Cr.Job.claim(j2) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, dead) == True{} : Bool}))

def pc.cl_take_due(b: Bool, cl: Maybe<&2, Cr.Claim>, +p: Nat, +c: Nat, +i: Nat, +s: Cr.Sched, +n: Nat, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +x: Nat, +o: Nat, hc: {cl == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> {Cr.Job.claim(Cr.take.due(b, p, c, i, s, n, k, cl, rs, ss, h)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}:
  match b:
    case False{}:
      hc
    case True{}:
      match cl:
        case None{}:
          pc.none_some_c({Cr.Job.claim(Cr.take.due(True{}, p, c, i, s, n, k, None{}, rs, ss, h)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Cr.Claim{x, o}, hc)
        case Some{y}:
          hc

def pc.cl_take(+p: Nat, +c: Nat, j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> {Cr.Job.claim(Cr.take(p, c, j)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}:
  match j:
    case Cr.Job{+i, +s, st, nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Active{}:
          match nx:
            case None{}:
              hc
            case Some{+n}:
              pc.cl_take_due(Nat.is_le(n, c), cl, p, c, i, s, n, k, rs, ss, h, x, o, hc)
        case Cr.Paused{}:
          hc
        case Cr.Finished{}:
          hc
        case Cr.Cancelled{}:
          hc

def pc.why2(a: Bool, -b: Bool, -d: Bool, +o: Nat, +p: Nat, -dead: List<&2, Nat>, ea: {Nat.is_eq(o, p) == a : Bool}, ed: {Cr.has(o, dead) == d : Bool}, h: {Bool.or(Bool.and(a, Bool.not(b)), d) == True{} : Bool}) -> Or({o == p : Nat}, {Cr.has(o, dead) == True{} : Bool}):
  match a:
    case True{}:
      Inl{cron_step.pc.eq_of(o, p, ea)}
    case False{}:
      Inr{Equal.trans(Bool, Cr.has(o, dead), d, True{}, ed, h)}

# a claim a recovery clears is its own, or a dead process's
def pc.clears_why(+p: Nat, +o: Nat, +rs: List<&2, Nat>, +dead: List<&2, Nat>, h: {Cr.clears(p, o, rs, dead) == True{} : Bool}) -> Or({o == p : Nat}, {Cr.has(o, dead) == True{} : Bool}):
  pc.why2(Nat.is_eq(o, p), Cr.has(p, rs), Cr.has(o, dead), o, p, dead, {==}, {==}, h)

def pc.by_from(+p: Nat, +o2: Nat, +o: Nat, +dead: List<&2, Nat>, eo: {o2 == o : Nat}, w: Or({o2 == p : Nat}, {Cr.has(o2, dead) == True{} : Bool})) -> Or({Some{p} == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, dead) == True{} : Bool}):
  match w:
    case Inl{e}:
      +po = Equal.trans(Nat, p, o2, o, Equal.sym(Nat, o2, p, e), eo)
      Inl{Equal.cong(Nat, Maybe<&2, Nat>, v => Some{v}, p, o, po)}
    case Inr{d}:
      %eo : Or({Some{p} == Some{_} : Maybe<&2, Nat>}, {Cr.has(_, dead) == True{} : Bool})
      Inr{d}

def pc.cl_rec_go(b: Bool, +st: Cr.Status, +p: Nat, +o2: Nat, +xo: Nat, +dead: List<&2, Nat>, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +x: Nat, +o: Nat, eq: {Cr.clears(p, o2, rs, dead) == b : Bool}, hc: {Some{Cr.Claim{xo, o2}} == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(Cr.Recover{p}, dead, Cr.recover.go(b, i, s, st, nx, k, Cr.Claim{xo, o2}, rs, ss, h), x, o):
  match b:
    case False{}:
      Inl{hc}
    case True{}:
      +eo = Equal.cong(Maybe<&2, Cr.Claim>, Nat, m => pc.owner_of(m), Some{Cr.Claim{xo, o2}}, Some{Cr.Claim{x, o}}, hc)
      Inr{pc.by_from(p, o2, o, dead, eo, pc.clears_why(p, o2, rs, dead, eq))}

def pc.cl_recover(+p: Nat, +dead: List<&2, Nat>, j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(Cr.Recover{p}, dead, Cr.recover(p, dead, j), x, o):
  match j:
    case Cr.Job{+i, +s, +st, +nx, +k, cl, +rs, +ss, +h}:
      match cl:
        case None{}:
          pc.none_some_c(pc.CK(Cr.Recover{p}, dead, Cr.recover(p, dead, Cr.Job{i, s, st, nx, k, None{}, rs, ss, h}), x, o), Cr.Claim{x, o}, hc)
        case Some{y}:
          match y:
            case Cr.Claim{+xo, +o2}:
              pc.cl_rec_go(Cr.clears(p, o2, rs, dead), st, p, o2, xo, dead, i, s, nx, k, rs, ss, h, x, o, {==}, hc)

def pc.cl_own(b: Bool, +w: Nat, +xo: Nat, +p: Nat, +c: Nat, +out: Cr.Out, +dead: List<&2, Nat>, +ji: Nat, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +x: Nat, +o: Nat, eqb: {Nat.is_eq(w, p) == b : Bool}, hc: {Some{Cr.Claim{xo, w}} == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(Cr.Finish{p, ji, out}, dead, Cr.finish.own(b, Cr.Claim{xo, w}, c, out, i, s, st, nx, k, rs, ss, h), x, o):
  match b:
    case False{}:
      Inl{hc}
    case True{}:
      +wo = Equal.cong(Maybe<&2, Cr.Claim>, Nat, m => pc.owner_of(m), Some{Cr.Claim{xo, w}}, Some{Cr.Claim{x, o}}, hc)
      +po = Equal.trans(Nat, p, w, o, Equal.sym(Nat, w, p, cron_step.pc.eq_of(w, p, eqb)), wo)
      Inr{Inl{Equal.cong(Nat, Maybe<&2, Nat>, v => Some{v}, p, o, po)}}

def pc.cl_run(b: Bool, cl: Maybe<&2, Cr.Claim>, +p: Nat, +c: Nat, +out: Cr.Out, +dead: List<&2, Nat>, +ji: Nat, +i: Nat, +s: Cr.Sched, +st: Cr.Status, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>, +x: Nat, +o: Nat, hc: {cl == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(Cr.Finish{p, ji, out}, dead, Cr.finish.run(b, p, c, out, i, s, st, nx, k, cl, rs, ss, h), x, o):
  match b:
    case False{}:
      Inl{hc}
    case True{}:
      match cl:
        case None{}:
          pc.none_some_c(pc.CK(Cr.Finish{p, ji, out}, dead, Cr.finish.run(True{}, p, c, out, i, s, st, nx, k, None{}, rs, ss, h), x, o), Cr.Claim{x, o}, hc)
        case Some{y}:
          match y:
            case Cr.Claim{+xo, +w}:
              pc.cl_own(Nat.is_eq(w, p), w, xo, p, c, out, dead, ji, i, s, st, nx, k, Cr.drop(p, rs), ss, h, x, o, {==}, hc)

def pc.cl_finish(b: Bool, +p: Nat, +c: Nat, +out: Cr.Out, +dead: List<&2, Nat>, +ji: Nat, +j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(Cr.Finish{p, ji, out}, dead, Cr.job.pick(b, Cr.finish(p, c, out, j), j), x, o):
  match b:
    case False{}:
      Inl{hc}
    case True{}:
      match j:
        case Cr.Job{+i, +s, +st, +nx, +k, +cl, +rs, +ss, +h}:
          pc.cl_run(Cr.has(p, rs), cl, p, c, out, dead, ji, i, s, st, nx, k, rs, ss, h, x, o, hc)

def pc.cl_cancel(b: Bool, j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> {Cr.Job.claim(Cr.job.pick(b, Cr.cancel(j), j)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}:
  match b:
    case False{}:
      hc
    case True{}:
      match j:
        case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
          match st:
            case Cr.Cancelled{}:
              hc
            case Cr.Active{}:
              hc
            case Cr.Paused{}:
              hc
            case Cr.Finished{}:
              hc

def pc.cl_resume(b: Bool, +c: Nat, j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> {Cr.Job.claim(Cr.job.pick(b, Cr.resume(c, j), j)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}:
  match b:
    case False{}:
      hc
    case True{}:
      match j:
        case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
          match s:
            case Cr.Once{d}:
              hc
            case Cr.Every{q}:
              match st:
                case Cr.Active{}:
                  hc
                case Cr.Paused{}:
                  hc
                case Cr.Finished{}:
                  hc
                case Cr.Cancelled{}:
                  hc

def pc.cl_unrun(+p: Nat, j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> {Cr.Job.claim(Cr.unrun(p, j)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}:
  match j:
    case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
      hc

def pc.claim_job(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, +x: Nat, +o: Nat, hc: {Cr.Job.claim(j) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CK(e, dead, Cr.job(e, c, dead, j), x, o):
  match e:
    case Cr.Take{+p}:
      Inl{pc.cl_take(p, c, j, x, o, hc)}
    case Cr.Recover{+p}:
      pc.cl_recover(p, dead, j, x, o, hc)
    case Cr.Finish{+p, +ji, +out}:
      pc.cl_finish(Nat.is_eq(Cr.Job.id(j), ji), p, c, out, dead, ji, j, x, o, hc)
    case Cr.Abort{+p}:
      Inl{pc.cl_unrun(p, j, x, o, hc)}
    case Cr.Die{+p}:
      Inl{pc.cl_unrun(p, j, x, o, hc)}
    case Cr.Cancel{+p, +ji}:
      Inl{pc.cl_cancel(Nat.is_eq(Cr.Job.id(j), ji), j, x, o, hc)}
    case Cr.Resume{+p, +ji}:
      Inl{pc.cl_resume(Nat.is_eq(Cr.Job.id(j), ji), c, j, x, o, hc)}
    case Cr.Create{p, s}:
      Inl{hc}
    case Cr.Tick{d}:
      Inl{hc}
    case Cr.RawJob{t}:
      Inl{hc}
    case Cr.RawClaim{t}:
      Inl{hc}
    case Cr.Corrupt{t}:
      Inl{hc}

# the claim of o on job i after e on the records
def pc.CR(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +rs: List<&2, Cr.Rec>, +i: Nat, +x: Nat, +o: Nat) -> Type:
  Or({Cr.claim_of(i, Cr.recs(e, c, dead, rs)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, dead) == True{} : Bool}))

def pc.claim_pick(b: Bool, +e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, +rest: List<&2, Cr.Rec>, +i: Nat, +x: Nat, +o: Nat, h: {Cr.claim_of.pick(b, Cr.Job.claim(j), Cr.claim_of(i, rest)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, next: {Cr.claim_of(i, rest) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>} -> pc.CR(e, c, dead, rest, i, x, o)) -> Or({Cr.claim_of.pick(b, Cr.Job.claim(Cr.job(e, c, dead, j)), Cr.claim_of(i, Cr.recs(e, c, dead, rest))) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, dead) == True{} : Bool})):
  match b:
    case True{}:
      pc.claim_job(e, c, dead, j, x, o, h)
    case False{}:
      next(h)

def pc.claim_rec(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, +i: Nat, +x: Nat, +o: Nat, h: {Cr.claim_of(i, rs) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CR(e, c, dead, rs, i, x, o):
  match rs:
    case Nil{}:
      pc.none_some_c(pc.CR(e, c, dead, Nil{}, i, x, o), Cr.Claim{x, o}, h)
    case r <> +rest:
      match r:
        case Cr.Raw{y}:
          pc.claim_rec(e, c, dead, rest, i, x, o, h)
        case Cr.Known{+j}:
          %Equal.sym(Nat, Cr.Job.id(Cr.job(e, c, dead, j)), Cr.Job.id(j), pc.id_job(e, c, dead, j)) : Or({Cr.claim_of.pick(Nat.is_eq(_, i), Cr.Job.claim(Cr.job(e, c, dead, j)), Cr.claim_of(i, Cr.recs(e, c, dead, rest))) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, dead) == True{} : Bool}))
          pc.claim_pick(Nat.is_eq(Cr.Job.id(j), i), e, c, dead, j, rest, i, x, o, h, q => pc.claim_rec(e, c, dead, rest, i, x, o, q))

def pc.claim_pick_app(b: Bool, +j: Cr.Job, +rest: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +i: Nat, -m: Maybe<&2, Cr.Claim>, h: {Cr.claim_of.pick(b, Cr.Job.claim(j), Cr.claim_of(i, rest)) == m : Maybe<&2, Cr.Claim>}, next: {Cr.claim_of(i, rest) == m : Maybe<&2, Cr.Claim>} -> {Cr.claim_of(i, List.append(&2, Cr.Rec, rest, ys)) == m : Maybe<&2, Cr.Claim>}) -> {Cr.claim_of.pick(b, Cr.Job.claim(j), Cr.claim_of(i, List.append(&2, Cr.Rec, rest, ys))) == m : Maybe<&2, Cr.Claim>}:
  match b:
    case True{}:
      h
    case False{}:
      next(h)

def pc.claim_append(rs: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +i: Nat, +y: Cr.Claim, h: {Cr.claim_of(i, rs) == Some{y} : Maybe<&2, Cr.Claim>}) -> {Cr.claim_of(i, List.append(&2, Cr.Rec, rs, ys)) == Some{y} : Maybe<&2, Cr.Claim>}:
  match rs:
    case Nil{}:
      pc.none_some_c({Cr.claim_of(i, ys) == Some{y} : Maybe<&2, Cr.Claim>}, y, h)
    case r <> +rest:
      match r:
        case Cr.Raw{z}:
          pc.claim_append(rest, ys, i, y, h)
        case Cr.Known{+j}:
          pc.claim_pick_app(Nat.is_eq(Cr.Job.id(j), i), j, rest, ys, i, Some{y}, h, q => pc.claim_append(rest, ys, i, y, q))

# the claim step law: a step of p removes a claim of o only when o is p or
# dead
def pc.CO(+s: Cr.S, +s2: Cr.S, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat) -> Type:
  Or({Cr.claim_of(i, Cr.S.recs(s2)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, Cr.S.dead(s)) == True{} : Bool}))

def pc.co_alive(b: Bool, +s: Cr.S, +a: Cr.S, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat, h: {Cr.claim_of(i, Cr.S.recs(s)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, ka: pc.CO(s, a, e, i, x, o)) -> pc.CO(s, Cr.step.alive(b, a, s), e, i, x, o):
  match b:
    case False{}:
      ka
    case True{}:
      Inl{h}

def pc.co_raw(bad: Maybe<&2, Nat>, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +rd2: List<&2, Nat>, +ys: List<&2, Cr.Rec>, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat, h: {Cr.claim_of(i, rs) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CO(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.step.raw(bad, Cr.S{None{}, List.append(&2, Cr.Rec, rs, ys), rd2, dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside}), e, i, x, o):
  match bad:
    case None{}:
      Inl{pc.claim_append(rs, ys, i, Cr.Claim{x, o}, h)}
    case Some{z}:
      Inl{h}

def pc.co_raw_claim(bad: Maybe<&2, Nat>, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +t: Nat, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat, h: {Cr.claim_of(i, rs) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CO(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.step.raw(bad, Cr.S{None{}, rs, List.append(&2, Nat, rd, [t]), dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside}), e, i, x, o):
  match bad:
    case None{}:
      Inl{h}
    case Some{z}:
      Inl{h}

def pc.claim_owned(s: Cr.S, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat, nc: {Cr.Ev.is_corrupt(e) == False{} : Bool}, +h: {Cr.claim_of(i, Cr.S.recs(s)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}) -> pc.CO(s, Cr.step(s, e), e, i, x, o):
  match s:
    case Cr.S{+bad, +rs, +rd, +dead, +c, +n, +aside}:
      match e:
        case Cr.Create{+p, +sc}:
          +new = {[Cr.Known{Cr.Job{n, sc, Cr.Active{}, Some{Cr.first(sc, c)}, 0n, None{}, Nil{}, Nil{}, Nil{}}}] : List<&2, Cr.Rec>}
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, List.append(&2, Cr.Rec, rs, new), rd, dead, c, 1n+n, Cr.heal(bad, aside)}, e, i, x, o, h, Inl{pc.claim_append(rs, new, i, Cr.Claim{x, o}, h)})
        case Cr.Take{+p}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Recover{+p}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Finish{+p, +ji, +out}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Abort{+p}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Die{+p}:
          pc.claim_rec(e, c, dead, rs, i, x, o, h)
        case Cr.Cancel{+p, +ji}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Resume{+p, +ji}:
          pc.co_alive(Cr.has(p, dead), Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, e, i, x, o, h, pc.claim_rec(e, c, dead, rs, i, x, o, h))
        case Cr.Tick{+d}:
          Inl{h}
        case Cr.RawJob{+t}:
          pc.co_raw(bad, rs, rd, rd, [Cr.Raw{t}], dead, c, n, aside, e, i, x, o, h)
        case Cr.RawClaim{+t}:
          pc.co_raw_claim(bad, rs, rd, t, dead, c, n, aside, e, i, x, o, h)
        case Cr.Corrupt{t}:
          cron_step.pc.absurd(pc.CO(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{Some{t}, Nil{}, Nil{}, dead, c, n, aside}, e, i, x, o), nc)

# A stopped job stays stopped
# ---------------------------

def pc.PSJ(j: Cr.Job) -> Data:
  {Cr.Job.status(j) == Cr.Paused{} : Cr.Status}

def pc.SDA(st: Cr.Status, A: Type) -> Type:
  match st:
    case Cr.Paused{}:
      A
    case Cr.Active{}:
      Unit
    case Cr.Finished{}:
      Unit
    case Cr.Cancelled{}:
      Unit

# a status other than paused is not paused
def pc.st_absurd(-A: Type, -st: Cr.Status, e: {st == Cr.Paused{} : Cr.Status}, u: pc.SDA(st, A)) -> A:
  %e : pc.SDA(_, A)
  u

def pc.st_take(+p: Nat, +c: Nat, j: Cr.Job, hp: pc.PSJ(j)) -> pc.PSJ(Cr.take(p, c, j)):
  match j:
    case Cr.Job{+i, +s, st, +nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Paused{}:
          {==}
        case Cr.Active{}:
          pc.st_absurd(pc.PSJ(Cr.take(p, c, Cr.Job{i, s, Cr.Active{}, nx, k, cl, rs, ss, h})), Cr.Active{}, hp, Unit{})
        case Cr.Finished{}:
          pc.st_absurd(pc.PSJ(Cr.take(p, c, Cr.Job{i, s, Cr.Finished{}, nx, k, cl, rs, ss, h})), Cr.Finished{}, hp, Unit{})
        case Cr.Cancelled{}:
          pc.st_absurd(pc.PSJ(Cr.take(p, c, Cr.Job{i, s, Cr.Cancelled{}, nx, k, cl, rs, ss, h})), Cr.Cancelled{}, hp, Unit{})

def pc.st_rec_go(b: Bool, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +x: Cr.Claim, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> pc.PSJ(Cr.recover.go(b, i, s, Cr.Paused{}, nx, k, x, rs, ss, h)):
  match b:
    case False{}:
      {==}
    case True{}:
      {==}

def pc.st_recover(+p: Nat, +dead: List<&2, Nat>, j: Cr.Job, hp: pc.PSJ(j)) -> pc.PSJ(Cr.recover(p, dead, j)):
  match j:
    case Cr.Job{+i, +s, st, +nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Paused{}:
          match cl:
            case None{}:
              {==}
            case Some{y}:
              match y:
                case Cr.Claim{+xo, +o}:
                  pc.st_rec_go(Cr.clears(p, o, rs, dead), i, s, nx, k, Cr.Claim{xo, o}, rs, ss, h)
        case Cr.Active{}:
          pc.st_absurd(pc.PSJ(Cr.recover(p, dead, Cr.Job{i, s, Cr.Active{}, nx, k, cl, rs, ss, h})), Cr.Active{}, hp, Unit{})
        case Cr.Finished{}:
          pc.st_absurd(pc.PSJ(Cr.recover(p, dead, Cr.Job{i, s, Cr.Finished{}, nx, k, cl, rs, ss, h})), Cr.Finished{}, hp, Unit{})
        case Cr.Cancelled{}:
          pc.st_absurd(pc.PSJ(Cr.recover(p, dead, Cr.Job{i, s, Cr.Cancelled{}, nx, k, cl, rs, ss, h})), Cr.Cancelled{}, hp, Unit{})

def pc.st_own(b: Bool, +x: Cr.Claim, +c: Nat, +o: Cr.Out, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> pc.PSJ(Cr.finish.own(b, x, c, o, i, s, Cr.Paused{}, nx, k, rs, ss, h)):
  match b:
    case False{}:
      {==}
    case True{}:
      {==}

def pc.st_run(b: Bool, cl: Maybe<&2, Cr.Claim>, +p: Nat, +c: Nat, +o: Cr.Out, +i: Nat, +s: Cr.Sched, +nx: Maybe<&2, Nat>, +k: Nat, +rs: List<&2, Nat>, +ss: List<&2, Nat>, +h: List<&2, Cr.Mark>) -> pc.PSJ(Cr.finish.run(b, p, c, o, i, s, Cr.Paused{}, nx, k, cl, rs, ss, h)):
  match b:
    case False{}:
      {==}
    case True{}:
      match cl:
        case None{}:
          {==}
        case Some{y}:
          match y:
            case Cr.Claim{+xo, +w}:
              pc.st_own(Nat.is_eq(w, p), Cr.Claim{xo, w}, c, o, i, s, nx, k, Cr.drop(p, rs), ss, h)

def pc.st_finish(+p: Nat, +c: Nat, +o: Cr.Out, j: Cr.Job, hp: pc.PSJ(j)) -> pc.PSJ(Cr.finish(p, c, o, j)):
  match j:
    case Cr.Job{+i, +s, st, +nx, +k, +cl, +rs, +ss, +h}:
      match st:
        case Cr.Paused{}:
          pc.st_run(Cr.has(p, rs), cl, p, c, o, i, s, nx, k, rs, ss, h)
        case Cr.Active{}:
          pc.st_absurd(pc.PSJ(Cr.finish(p, c, o, Cr.Job{i, s, Cr.Active{}, nx, k, cl, rs, ss, h})), Cr.Active{}, hp, Unit{})
        case Cr.Finished{}:
          pc.st_absurd(pc.PSJ(Cr.finish(p, c, o, Cr.Job{i, s, Cr.Finished{}, nx, k, cl, rs, ss, h})), Cr.Finished{}, hp, Unit{})
        case Cr.Cancelled{}:
          pc.st_absurd(pc.PSJ(Cr.finish(p, c, o, Cr.Job{i, s, Cr.Cancelled{}, nx, k, cl, rs, ss, h})), Cr.Cancelled{}, hp, Unit{})

def pc.st_pick_fin(b: Bool, +p: Nat, +c: Nat, +o: Cr.Out, +j: Cr.Job, +hp: pc.PSJ(j)) -> pc.PSJ(Cr.job.pick(b, Cr.finish(p, c, o, j), j)):
  match b:
    case True{}:
      pc.st_finish(p, c, o, j, hp)
    case False{}:
      hp

def pc.st_unrun(+p: Nat, j: Cr.Job, hp: pc.PSJ(j)) -> pc.PSJ(Cr.unrun(p, j)):
  match j:
    case Cr.Job{i, s, st, nx, k, cl, rs, ss, h}:
      hp

def pc.paused_job(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, nu: {Cr.Ev.is_user(e) == False{} : Bool}, +hp: pc.PSJ(j)) -> pc.PSJ(Cr.job(e, c, dead, j)):
  match e:
    case Cr.Take{+p}:
      pc.st_take(p, c, j, hp)
    case Cr.Recover{+p}:
      pc.st_recover(p, dead, j, hp)
    case Cr.Finish{+p, +ji, +o}:
      pc.st_pick_fin(Nat.is_eq(Cr.Job.id(j), ji), p, c, o, j, hp)
    case Cr.Abort{+p}:
      pc.st_unrun(p, j, hp)
    case Cr.Die{+p}:
      pc.st_unrun(p, j, hp)
    case Cr.Cancel{+p, +ji}:
      cron_step.pc.absurd(pc.PSJ(Cr.job(Cr.Cancel{p, ji}, c, dead, j)), nu)
    case Cr.Resume{+p, +ji}:
      cron_step.pc.absurd(pc.PSJ(Cr.job(Cr.Resume{p, ji}, c, dead, j)), nu)
    case Cr.Create{+p, +sc}:
      cron_step.pc.absurd(pc.PSJ(Cr.job(Cr.Create{p, sc}, c, dead, j)), nu)
    case Cr.Tick{d}:
      hp
    case Cr.RawJob{t}:
      hp
    case Cr.RawClaim{t}:
      hp
    case Cr.Corrupt{t}:
      hp

def pc.MS(m: Maybe<&2, Cr.Status>) -> Cr.Status:
  match m:
    case None{}:
      Cr.Active{}
    case Some{x}:
      x

def pc.MSD(m: Maybe<&2, Cr.Status>, A: Type) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      A

def pc.none_some_s(-A: Type, e: {None{} == Some{Cr.Paused{}} : Maybe<&2, Cr.Status>}) -> A:
  %e : pc.MSD(_, A)
  Unit{}

def pc.SP() -> Maybe<&2, Cr.Status>:
  Some{Cr.Paused{}}

def pc.status_pick(b: Bool, +e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, +j: Cr.Job, +rest: List<&2, Cr.Rec>, +i: Nat, nu: {Cr.Ev.is_user(e) == False{} : Bool}, h: {Cr.status_of.pick(b, Cr.Job.status(j), Cr.status_of(i, rest)) == pc.SP() : Maybe<&2, Cr.Status>}, next: {Cr.status_of(i, rest) == pc.SP() : Maybe<&2, Cr.Status>} -> {Cr.status_of(i, Cr.recs(e, c, dead, rest)) == pc.SP() : Maybe<&2, Cr.Status>}) -> {Cr.status_of.pick(b, Cr.Job.status(Cr.job(e, c, dead, j)), Cr.status_of(i, Cr.recs(e, c, dead, rest))) == pc.SP() : Maybe<&2, Cr.Status>}:
  match b:
    case True{}:
      +hp = Equal.cong(Maybe<&2, Cr.Status>, Cr.Status, m => pc.MS(m), Some{Cr.Job.status(j)}, Some{Cr.Paused{}}, h)
      Equal.cong(Cr.Status, Maybe<&2, Cr.Status>, v => Some{v}, Cr.Job.status(Cr.job(e, c, dead, j)), Cr.Paused{}, pc.paused_job(e, c, dead, j, nu, hp))
    case False{}:
      next(h)

def pc.status_rec(+e: Cr.Ev, +c: Nat, +dead: List<&2, Nat>, rs: List<&2, Cr.Rec>, +i: Nat, +nu: {Cr.Ev.is_user(e) == False{} : Bool}, h: {Cr.status_of(i, rs) == pc.SP() : Maybe<&2, Cr.Status>}) -> {Cr.status_of(i, Cr.recs(e, c, dead, rs)) == pc.SP() : Maybe<&2, Cr.Status>}:
  match rs:
    case Nil{}:
      pc.none_some_s({Cr.status_of(i, Nil{}) == pc.SP() : Maybe<&2, Cr.Status>}, h)
    case r <> +rest:
      match r:
        case Cr.Raw{y}:
          pc.status_rec(e, c, dead, rest, i, nu, h)
        case Cr.Known{+j}:
          %Equal.sym(Nat, Cr.Job.id(Cr.job(e, c, dead, j)), Cr.Job.id(j), pc.id_job(e, c, dead, j)) : {Cr.status_of.pick(Nat.is_eq(_, i), Cr.Job.status(Cr.job(e, c, dead, j)), Cr.status_of(i, Cr.recs(e, c, dead, rest))) == pc.SP() : Maybe<&2, Cr.Status>}
          pc.status_pick(Nat.is_eq(Cr.Job.id(j), i), e, c, dead, j, rest, i, nu, h, q => pc.status_rec(e, c, dead, rest, i, nu, q))

def pc.status_pick_app(b: Bool, +st: Cr.Status, +rest: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +i: Nat, h: {Cr.status_of.pick(b, st, Cr.status_of(i, rest)) == pc.SP() : Maybe<&2, Cr.Status>}, next: {Cr.status_of(i, rest) == pc.SP() : Maybe<&2, Cr.Status>} -> {Cr.status_of(i, List.append(&2, Cr.Rec, rest, ys)) == pc.SP() : Maybe<&2, Cr.Status>}) -> {Cr.status_of.pick(b, st, Cr.status_of(i, List.append(&2, Cr.Rec, rest, ys))) == pc.SP() : Maybe<&2, Cr.Status>}:
  match b:
    case True{}:
      h
    case False{}:
      next(h)

def pc.status_append(rs: List<&2, Cr.Rec>, +ys: List<&2, Cr.Rec>, +i: Nat, h: {Cr.status_of(i, rs) == pc.SP() : Maybe<&2, Cr.Status>}) -> {Cr.status_of(i, List.append(&2, Cr.Rec, rs, ys)) == pc.SP() : Maybe<&2, Cr.Status>}:
  match rs:
    case Nil{}:
      pc.none_some_s({Cr.status_of(i, ys) == pc.SP() : Maybe<&2, Cr.Status>}, h)
    case r <> +rest:
      match r:
        case Cr.Raw{z}:
          pc.status_append(rest, ys, i, h)
        case Cr.Known{+j}:
          pc.status_pick_app(Nat.is_eq(Cr.Job.id(j), i), Cr.Job.status(j), rest, ys, i, h, q => pc.status_append(rest, ys, i, q))

# what the law asks of the records after a step
def pc.SPO(+i: Nat, +s2: Cr.S) -> Type:
  Or({Cr.status_of(i, Cr.S.recs(s2)) == pc.SP() : Maybe<&2, Cr.Status>}, {Cr.status_of(i, Cr.S.recs(s2)) == None{} : Maybe<&2, Cr.Status>})

def pc.sp_alive(b: Bool, +i: Nat, +s: Cr.S, +a: Cr.S, h: {Cr.status_of(i, Cr.S.recs(s)) == pc.SP() : Maybe<&2, Cr.Status>}, ka: pc.SPO(i, a)) -> pc.SPO(i, Cr.step.alive(b, a, s)):
  match b:
    case False{}:
      ka
    case True{}:
      Inl{h}

def pc.sp_raw(bad: Maybe<&2, Nat>, +i: Nat, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +t: Nat, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>, h: {Cr.status_of(i, rs) == pc.SP() : Maybe<&2, Cr.Status>}) -> pc.SPO(i, Cr.step.raw(bad, Cr.S{None{}, List.append(&2, Cr.Rec, rs, [Cr.Raw{t}]), rd, dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      Inl{pc.status_append(rs, [Cr.Raw{t}], i, h)}
    case Some{z}:
      Inl{h}

def pc.sp_raw_claim(bad: Maybe<&2, Nat>, +i: Nat, +rs: List<&2, Cr.Rec>, +rd: List<&2, Nat>, +t: Nat, +dead: List<&2, Nat>, +c: Nat, +n: Nat, +aside: List<&2, Nat>, h: {Cr.status_of(i, rs) == pc.SP() : Maybe<&2, Cr.Status>}) -> pc.SPO(i, Cr.step.raw(bad, Cr.S{None{}, rs, List.append(&2, Nat, rd, [t]), dead, c, n, aside}, Cr.S{bad, rs, rd, dead, c, n, aside})):
  match bad:
    case None{}:
      Inl{h}
    case Some{z}:
      Inl{h}

def pc.stays(s: Cr.S, +e: Cr.Ev, +i: Nat, +nu: {Cr.Ev.is_user(e) == False{} : Bool}, +h: {Cr.status_of(i, Cr.S.recs(s)) == pc.SP() : Maybe<&2, Cr.Status>}) -> pc.SPO(i, Cr.step(s, e)):
  match s:
    case Cr.S{+bad, +rs, +rd, +dead, +c, +n, +aside}:
      match e:
        case Cr.Create{+p, +sc}:
          cron_step.pc.absurd(pc.SPO(i, Cr.step(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.Create{p, sc})), nu)
        case Cr.Take{+p}:
          pc.sp_alive(Cr.has(p, dead), i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, h, Inl{pc.status_rec(e, c, dead, rs, i, nu, h)})
        case Cr.Recover{+p}:
          pc.sp_alive(Cr.has(p, dead), i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, h, Inl{pc.status_rec(e, c, dead, rs, i, nu, h)})
        case Cr.Finish{+p, +ji, +o}:
          pc.sp_alive(Cr.has(p, dead), i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{None{}, Cr.recs(e, c, dead, rs), rd, dead, c, n, Cr.heal(bad, aside)}, h, Inl{pc.status_rec(e, c, dead, rs, i, nu, h)})
        case Cr.Abort{+p}:
          pc.sp_alive(Cr.has(p, dead), i, Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.S{bad, Cr.recs(e, c, dead, rs), rd, dead, c, n, aside}, h, Inl{pc.status_rec(e, c, dead, rs, i, nu, h)})
        case Cr.Die{+p}:
          Inl{pc.status_rec(e, c, dead, rs, i, nu, h)}
        case Cr.Cancel{+p, +ji}:
          cron_step.pc.absurd(pc.SPO(i, Cr.step(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.Cancel{p, ji})), nu)
        case Cr.Resume{+p, +ji}:
          cron_step.pc.absurd(pc.SPO(i, Cr.step(Cr.S{bad, rs, rd, dead, c, n, aside}, Cr.Resume{p, ji})), nu)
        case Cr.Tick{+d}:
          Inl{h}
        case Cr.RawJob{+t}:
          pc.sp_raw(bad, i, rs, rd, t, dead, c, n, aside, h)
        case Cr.RawClaim{+t}:
          pc.sp_raw_claim(bad, i, rs, rd, t, dead, c, n, aside, h)
        case Cr.Corrupt{t}:
          Inr{{==}}

# The pause never shrinks
# -----------------------

def pc.delay_mono(k: Nat) -> {Nat.is_le(Cr.delay(k), Cr.delay(1n+k)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+d:
              match d:
                case 0n:
                  {==}
                case 1n+e:
                  match e:
                    case 0n:
                      {==}
                    case 1n+f:
                      match f:
                        case 0n:
                          {==}
                        case 1n+g:
                          {==}

def pc.not_lt_le(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      cron_step.pc.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pc.not_lt_le(p, q, h)

def pc.ge_pick(b: Bool, +n: Nat, +u: Nat, eq: {Nat.is_lt(n, u) == b : Bool}) -> {Nat.is_le(u, Cr.later.pick(b, n, u)) == True{} : Bool}:
  match b:
    case True{}:
      cron_step.pc.le_refl(u)
    case False{}:
      pc.not_lt_le(n, u, eq)

# a failure never moves the next run before its pause ends
def pc.later_ge(nx: Maybe<&2, Nat>, +u: Nat) -> {Nat.is_le(u, Cr.later(nx, u)) == True{} : Bool}:
  match nx:
    case None{}:
      cron_step.pc.le_refl(u)
    case Some{+n}:
      pc.ge_pick(Nat.is_lt(n, u), n, u, {==})

# The laws
# --------

def pc.cron_fires_once(+evs: List<&2, Cr.Ev>) -> Cr.FiresAll(Cr.S.recs(Cr.run(evs))):
  pc.fires_of(Cr.run(evs), pc.inv_run(evs))

def pc.cron_once_finished_after_end(+evs: List<&2, Cr.Ev>) -> Cr.EndsAll(Cr.S.recs(Cr.run(evs))):
  pc.ends_of(Cr.run(evs), pc.inv_run(evs))

def pc.cron_never_drops(+s: Cr.S, +e: Cr.Ev, +t: Nat, +i: Nat) -> {Cr.Ev.is_corrupt(e) == False{} : Bool} -> Cr.Keeps(t, i, s, Cr.step(s, e)):
  nc => pc.never_drops(s, e, t, i, nc)

def pc.cron_claim_owned(+s: Cr.S, +e: Cr.Ev, +i: Nat, +x: Nat, +o: Nat) -> {Cr.Ev.is_corrupt(e) == False{} : Bool} -> {Cr.claim_of(i, Cr.S.recs(s)) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>} -> Or({Cr.claim_of(i, Cr.S.recs(Cr.step(s, e))) == Some{Cr.Claim{x, o}} : Maybe<&2, Cr.Claim>}, Or({Cr.Ev.by(e) == Some{o} : Maybe<&2, Nat>}, {Cr.has(o, Cr.S.dead(s)) == True{} : Bool})):
  nc => h => pc.claim_owned(s, e, i, x, o, nc, h)

def pc.cron_backoff_bounded(+evs: List<&2, Cr.Ev>, +s: Cr.S, +e: Cr.Ev, +i: Nat, +k: Nat, +c: Nat, +nx: Maybe<&2, Nat>) -> (Cr.StopsAll(Cr.S.recs(Cr.run(evs))) & (({Cr.Ev.is_user(e) == False{} : Bool} -> Cr.StaysPaused(i, s, Cr.step(s, e))) & ({Nat.is_le(Cr.delay(k), Cr.delay(1n+k)) == True{} : Bool} & {Nat.is_le(Nat.add(c, Cr.delay(k)), Cr.later(nx, Nat.add(c, Cr.delay(k)))) == True{} : Bool}))):
  (pc.stops_of(Cr.run(evs), pc.inv_run(evs)), (nu => h => pc.stays(s, e, i, nu, h), (pc.delay_mono(k), pc.later_ge(nx, Nat.add(c, Cr.delay(k))))))

# ---- supervisor ----

# proof_supervisor: the D1 laws of LAWS.bend section supervisor.
#
# - restart_gives_up: the failures of a crash loop stay in the window, so
#   their count only grows (`ps.block`), up to the give-up.
# - timeouts_ordered: each timeout is a sum that contains the timeouts it
#   waits for.
# - revive_after_refresh: the time since the last record stays below the
#   refresh period (`ps.since_lt`), so a boot within the boot window
#   finds the evidence within the max age.
# - orphan_never_aborts_resumable: every exit is sound (`ps.exit_sound`)
#   and an exit is final.
# - idle_shutdown_never_aborts: a closed gate never holds a run
#   (`ps.Inv`), so a commit, which needs every gate closed, stops no run.
# - adopt_same_build: an adoption reads equal build numbers.

# Logic
# -----

def supervisor.ps.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def supervisor.ps.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : supervisor.ps.BD(_, Unit, A)
  Unit{}

def supervisor.ps.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : supervisor.ps.BD(_, A, Unit)
  Unit{}

def supervisor.ps.and_t(a: Bool, -b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      eb
    case False{}:
      supervisor.ps.absurdF({Bool.and(False{}, b) == True{} : Bool}, ea)

# Numbers
# -------

def supervisor.ps.le_refl(a: Nat) -> {Nat.is_le(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      supervisor.ps.le_refl(p)

def ps.le_zero(b: Nat) -> {Nat.is_le(0n, b) == True{} : Bool}:
  match b:
    case 0n:
      {==}
    case 1n+p:
      {==}

def supervisor.ps.le_succ(a: Nat) -> {Nat.is_le(a, 1n+a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      supervisor.ps.le_succ(p)

def supervisor.ps.le_trans(a: Nat, b: Nat, c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      ps.le_zero(c)
    case 1n+p 0n _:
      supervisor.ps.absurdF({Nat.is_le(1n+p, c) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      supervisor.ps.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      supervisor.ps.le_trans(p, q, r, ab, bc)

# a is at most a + b
def ps.le_add(a: Nat, +b: Nat) -> {Nat.is_le(a, Nat.add(a, b)) == True{} : Bool}:
  match a:
    case 0n:
      ps.le_zero(b)
    case 1n+p:
      ps.le_add(p, b)

# x is at most g + x
def supervisor.ps.le_add_l(+g: Nat, +x: Nat) -> {Nat.is_le(x, Nat.add(g, x)) == True{} : Bool}:
  match g:
    case 0n:
      supervisor.ps.le_refl(x)
    case 1n+p:
      supervisor.ps.le_trans(x, Nat.add(p, x), 1n+Nat.add(p, x), supervisor.ps.le_add_l(p, x), supervisor.ps.le_succ(Nat.add(p, x)))

# adding g on the left keeps the order
def ps.le_mono(g: Nat, -a: Nat, -x: Nat, h: {Nat.is_le(a, x) == True{} : Bool}) -> {Nat.is_le(Nat.add(g, a), Nat.add(g, x)) == True{} : Bool}:
  match g:
    case 0n:
      h
    case 1n+p:
      ps.le_mono(p, a, x, h)

# adding b on the right keeps the order
def ps.le_mono_r(a: Nat, h: Nat, +b: Nat, ah: {Nat.is_le(a, h) == True{} : Bool}) -> {Nat.is_le(Nat.add(a, b), Nat.add(h, b)) == True{} : Bool}:
  match a h:
    case 0n _:
      supervisor.ps.le_add_l(h, b)
    case 1n+p 0n:
      supervisor.ps.absurdF({Nat.is_le(Nat.add(1n+p, b), Nat.add(0n, b)) == True{} : Bool}, ah)
    case 1n+p 1n+q:
      ps.le_mono_r(p, q, b, ah)

def ps.le_lt(a: Nat, b: Nat, c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  match a b c:
    case 0n 0n 0n:
      supervisor.ps.absurdF({Nat.is_lt(0n, 0n) == True{} : Bool}, bc)
    case 0n 0n 1n+r:
      {==}
    case 0n 1n+q 0n:
      supervisor.ps.absurdF({Nat.is_lt(0n, 0n) == True{} : Bool}, bc)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 0n _:
      supervisor.ps.absurdF({Nat.is_lt(1n+p, c) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      supervisor.ps.absurdF({Nat.is_lt(1n+p, 0n) == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      ps.le_lt(p, q, r, ab, bc)

def ps.lt_le(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n _:
      ps.le_zero(b)
    case 1n+p 0n:
      supervisor.ps.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      ps.lt_le(p, q, h)

# k + 1 at most n makes k below n
def ps.lt_of_le_succ(k: Nat, n: Nat, h: {Nat.is_le(1n+k, n) == True{} : Bool}) -> {Nat.is_lt(k, n) == True{} : Bool}:
  match k n:
    case 0n 0n:
      supervisor.ps.absurdF({Nat.is_lt(0n, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      supervisor.ps.absurdF({Nat.is_lt(1n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      ps.lt_of_le_succ(p, q, h)

# r below h and r + 1 not h make r + 1 below h
def ps.lt_succ_ne(r: Nat, h: Nat, lt: {Nat.is_lt(r, h) == True{} : Bool}, ne: {Nat.is_eq(1n+r, h) == False{} : Bool}) -> {Nat.is_lt(1n+r, h) == True{} : Bool}:
  match r h:
    case 0n 0n:
      supervisor.ps.absurdF({Nat.is_lt(1n, 0n) == True{} : Bool}, lt)
    case 0n 1n+q:
      match q:
        case 0n:
          supervisor.ps.absurd({Nat.is_lt(1n, 1n) == True{} : Bool}, ne)
        case 1n+s:
          {==}
    case 1n+p 0n:
      supervisor.ps.absurdF({Nat.is_lt(2n+p, 0n) == True{} : Bool}, lt)
    case 1n+p 1n+q:
      ps.lt_succ_ne(p, q, lt, ne)

def ps.add_succ_r(a: Nat, +m: Nat) -> {Nat.add(a, 1n+m) == 1n+Nat.add(a, m) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %ps.add_succ_r(p, m) : {1n+Nat.add(p, 1n+m) == 1n+_ : Nat}
      {==}

def ps.add_zero(a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %ps.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def supervisor.ps.eq_of_is_eq(a: Nat, b: Nat, e: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      supervisor.ps.absurdF({0n == 1n+q : Nat}, e)
    case 1n+p 0n:
      supervisor.ps.absurdF({1n+p == 0n : Nat}, e)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, x => 1n+x, p, q, supervisor.ps.eq_of_is_eq(p, q, e))

# (D1) restart_gives_up
# ---------------------

# the ages of A at most x
def ps.young.put(b: Bool, r: Nat) -> Nat:
  match b:
    case True{}:
      1n+r
    case False{}:
      r

def ps.young(+x: Nat, A: List<&2, Nat>) -> Nat:
  match A:
    case Nil{}:
      0n
    case +a <> t:
      ps.young.put(Nat.is_le(a, x), ps.young(x, t))

def ps.put_ge(b: Bool, +r: Nat) -> {Nat.is_le(r, ps.young.put(b, r)) == True{} : Bool}:
  match b:
    case True{}:
      supervisor.ps.le_succ(r)
    case False{}:
      supervisor.ps.le_refl(r)

def ps.young_len.put(b: Bool, +r: Nat, +l: Nat, h: {Nat.is_le(r, l) == True{} : Bool}) -> {Nat.is_le(ps.young.put(b, r), 1n+l) == True{} : Bool}:
  match b:
    case True{}:
      h
    case False{}:
      supervisor.ps.le_trans(r, l, 1n+l, h, supervisor.ps.le_succ(l))

def ps.young_len(+x: Nat, A: List<&2, Nat>) -> {Nat.is_le(ps.young(x, A), List.length(&2, Nat, A)) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case +a <> +t:
      ps.young_len.put(Nat.is_le(a, x), ps.young(x, t), List.length(&2, Nat, t), ps.young_len(x, t))

# the window keeps every young age g ms later: one age
def ps.keep.at(b1: Bool, +a: Nat, +x: Nat, +g: Nat, +w: Nat, e1: {Nat.is_le(a, x) == b1 : Bool}, b2: Bool, e2: {Nat.is_lt(Nat.add(g, a), w) == b2 : Bool}, lt: {Nat.is_lt(Nat.add(g, x), w) == True{} : Bool}, +y: Nat, +k: List<&2, Nat>, ih: {Nat.is_le(y, ps.young(Nat.add(g, x), k)) == True{} : Bool})
  -> {Nat.is_le(ps.young.put(b1, y), ps.young(Nat.add(g, x), Su.keep.put(b2, Nat.add(g, a), k))) == True{} : Bool}:
  match b1 b2:
    case True{} True{}:
      %Equal.sym(Bool, Nat.is_le(Nat.add(g, a), Nat.add(g, x)), True{}, ps.le_mono(g, a, x, e1)) : {Nat.is_le(1n+y, ps.young.put(_, ps.young(Nat.add(g, x), k))) == True{} : Bool}
      ih
    case True{} False{}:
      supervisor.ps.absurd({Nat.is_le(1n+y, ps.young(Nat.add(g, x), k)) == True{} : Bool}, Equal.trans(Bool, True{}, Nat.is_lt(Nat.add(g, a), w), False{}, Equal.sym(Bool, Nat.is_lt(Nat.add(g, a), w), True{}, ps.le_lt(Nat.add(g, a), Nat.add(g, x), w, ps.le_mono(g, a, x, e1), lt)), e2))
    case False{} True{}:
      supervisor.ps.le_trans(y, ps.young(Nat.add(g, x), k), ps.young.put(Nat.is_le(Nat.add(g, a), Nat.add(g, x)), ps.young(Nat.add(g, x), k)), ih, ps.put_ge(Nat.is_le(Nat.add(g, a), Nat.add(g, x)), ps.young(Nat.add(g, x), k)))
    case False{} False{}:
      ih

# the window keeps every young age g ms later
def ps.keep(+w: Nat, +g: Nat, +x: Nat, A: List<&2, Nat>, +lt: {Nat.is_lt(Nat.add(g, x), w) == True{} : Bool})
  -> {Nat.is_le(ps.young(x, A), ps.young(Nat.add(g, x), Su.keep(w, Su.older(g, A)))) == True{} : Bool}:
  match A:
    case Nil{}:
      {==}
    case +a <> +t:
      ps.keep.at(Nat.is_le(a, x), a, x, g, w, {==}, Nat.is_lt(Nat.add(g, a), w), {==}, lt, ps.young(x, t), Su.keep(w, Su.older(g, t)), ps.keep(w, g, x, t, lt))

# the span from c is at least c
def ps.span_ge(gs: List<&2, Nat>, +c: Nat) -> {Nat.is_le(c, Su.span.go(gs, c)) == True{} : Bool}:
  match gs:
    case Nil{}:
      supervisor.ps.le_refl(c)
    case +g <> +rest:
      supervisor.ps.le_trans(c, Nat.add(g, c), Su.span.go(rest, Nat.add(g, c)), supervisor.ps.le_add_l(g, c), ps.span_ge(rest, Nat.add(g, c)))

# a new failure is young
def ps.young_new(+z: Nat, +k: List<&2, Nat>) -> {ps.young(z, 0n <> k) == 1n+ps.young(z, k) : Nat}:
  %Equal.sym(Bool, Nat.is_le(0n, z), True{}, ps.le_zero(z)) : {ps.young.put(_, ps.young(z, k)) == 1n+ps.young(z, k) : Nat}
  {==}

def ps.block.yo(+z: Nat, +k: List<&2, Nat>, +m: Nat, kept: {Nat.is_le(m, ps.young(z, k)) == True{} : Bool}) -> {Nat.is_le(1n+m, ps.young(z, 0n <> k)) == True{} : Bool}:
  %Equal.sym(Nat, ps.young(z, 0n <> k), 1n+ps.young(z, k), ps.young_new(z, k)) : {Nat.is_le(1n+m, _) == True{} : Bool}
  kept

# from a state with m failures at most x ms old (and n at least m), the
# failures gs inside the window leave at least m + |gs| in the window
def ps.block(+c: Su.Cfg, gs: List<&2, Nat>, s: Su.St, +x: Nat, +m: Nat,
  yo: {Nat.is_le(m, ps.young(x, Su.St.ages(s))) == True{} : Bool},
  nm: {Nat.is_le(m, Su.St.n(s)) == True{} : Bool},
  +sp: {Nat.is_lt(Su.span.go(gs, x), Su.Cfg.w(c)) == True{} : Bool})
  -> {Nat.is_le(Nat.add(List.length(&2, Nat, gs), m), Su.St.n(Su.go(c, gs, s))) == True{} : Bool}:
  match gs:
    case Nil{}:
      nm
    case +g <> +rest:
      match s:
        case Su.St{+a, n}:
          +w = Su.Cfg.w(c)
          +z = Nat.add(g, x)
          +k = Su.kept(c, g, a)
          +lt = ps.le_lt(z, Su.span.go(rest, z), w, ps.span_ge(rest, z), sp)
          +kept = supervisor.ps.le_trans(m, ps.young(x, a), ps.young(z, k), yo, ps.keep(w, g, x, a, lt))
          +yo2 = ps.block.yo(z, k, m, kept)
          +nm2 = supervisor.ps.le_trans(m, ps.young(z, k), List.length(&2, Nat, k), kept, ps.young_len(z, k))
          %ps.add_succ_r(List.length(&2, Nat, rest), m) : {Nat.is_le(_, Su.St.n(Su.go(c, rest, Su.St{0n <> k, 1n+List.length(&2, Nat, k)}))) == True{} : Bool}
          ps.block(c, rest, Su.St{0n <> k, 1n+List.length(&2, Nat, k)}, z, 1n+m, yo2, nm2, sp)

# the first failure of the loop is young
def ps.first_young(+c: Su.Cfg, s: Su.St, +g: Nat) -> {Nat.is_le(1n, ps.young(0n, Su.St.ages(Su.step(c, s, g)))) == True{} : Bool}:
  match s:
    case Su.St{a, n}:
      ps.le_zero(ps.young(0n, Su.kept(c, g, a)))

# and counted
def ps.first_n(+c: Su.Cfg, s: Su.St, +g: Nat) -> {Nat.is_le(1n, Su.St.n(Su.step(c, s, g))) == True{} : Bool}:
  match s:
    case Su.St{a, n}:
      ps.le_zero(List.length(&2, Nat, Su.kept(c, g, a)))

def ps.go_append(+c: Su.Cfg, xs: List<&2, Nat>, +ys: List<&2, Nat>, s: Su.St) -> {Su.go(c, List.append(&2, Nat, xs, ys), s) == Su.go(c, ys, Su.go(c, xs, s)) : Su.St}:
  match xs:
    case Nil{}:
      {==}
    case +x <> rest:
      ps.go_append(c, rest, ys, Su.step(c, s, x))

def ps.gives_up_of(+c: Su.Cfg, +n: Nat, lt: {Nat.is_lt(Su.Cfg.k(c), n) == True{} : Bool}) -> {Su.gives_up(Su.verdict(c, n)) == True{} : Bool}:
  %Equal.sym(Bool, Nat.is_lt(Su.Cfg.k(c), n), True{}, lt) : {Su.gives_up(Su.verdict.put(_, c, n)) == True{} : Bool}
  {==}

def ps.le_k(+l: Nat, +k: Nat, +n: Nat, many: {l == k : Nat}, blk: {Nat.is_le(Nat.add(l, 1n), n) == True{} : Bool}) -> {Nat.is_le(1n+k, n) == True{} : Bool}:
  %many : {Nat.is_le(1n+_, n) == True{} : Bool}
  %ps.add_zero(l) : {Nat.is_le(1n+_, n) == True{} : Bool}
  %ps.add_succ_r(l, 0n) : {Nat.is_le(_, n) == True{} : Bool}
  blk

def ps.restart_gives_up(+c: Su.Cfg, +pre: List<&2, Nat>, +g: Nat, +gs: List<&2, Nat>, many: {List.length(&2, Nat, gs) == Su.Cfg.k(c) : Nat}, fast: {Nat.is_lt(Su.span(gs), Su.Cfg.w(c)) == True{} : Bool})
  -> {Su.gives_up(Su.verdict(c, Su.failures(c, List.append(&2, Nat, pre, g <> gs)))) == True{} : Bool}:
  +s0 = Su.go(c, pre, Su.St.empty())
  +s1 = Su.step(c, s0, g)
  +blk = ps.block(c, gs, s1, 0n, 1n, ps.first_young(c, s0, g), ps.first_n(c, s0, g), fast)
  +n = Su.St.n(Su.go(c, gs, s1))
  +lt = ps.lt_of_le_succ(Su.Cfg.k(c), n, ps.le_k(List.length(&2, Nat, gs), Su.Cfg.k(c), n, many, blk))
  %Equal.sym(Su.St, Su.go(c, List.append(&2, Nat, pre, g <> gs), Su.St.empty()), Su.go(c, g <> gs, s0), ps.go_append(c, pre, g <> gs, Su.St.empty())) : {Su.gives_up(Su.verdict(c, Su.St.n(_))) == True{} : Bool}
  ps.gives_up_of(c, n, lt)

# (D1) timeouts_ordered
# ---------------------

def ps.seen_lost(t: Su.Tm) -> {Nat.is_le(Su.Tm.seen(t), Su.Tm.lost(t)) == True{} : Bool}:
  match t:
    case Su.Tm{snap, host, kstep, kterm, kverify, harness, wterm, wverify, margin, refresh, boot, +relaunch, +startup, +check, +slack, k, bmax, loop, qanswer}:
      ps.le_add(Nat.add(Nat.add(relaunch, startup), check), slack)

def ps.refresh_age(t: Su.Tm) -> {Nat.is_le(Su.Tm.refresh(t), Su.Tm.max_age(t)) == True{} : Bool}:
  match t:
    case Su.Tm{snap, host, kstep, kterm, kverify, harness, wterm, wverify, margin, +refresh, +boot, relaunch, startup, check, slack, k, bmax, loop, qanswer}:
      ps.le_add(refresh, boot)

def ps.timeouts_ordered(+t: Su.Tm) -> {Su.Tm.ordered(t) == True{} : Bool}:
  +window = Nat.is_le(Nat.mul(Su.Tm.k(t), Su.Tm.loop_step(t)), Su.Tm.window(t))
  +hold = Bool.and(Nat.is_le(Su.Tm.qanswer(t), Su.Tm.quiesce_hold(t)), window)
  +age = Bool.and(Nat.is_le(Su.Tm.refresh(t), Su.Tm.max_age(t)), hold)
  +lost = Bool.and(Nat.is_le(Su.Tm.seen(t), Su.Tm.lost(t)), age)
  +child = Bool.and(Nat.is_le(Nat.add(Su.Tm.stop_grace(t), Su.Tm.drain(t)), Su.Tm.child_kill(t)), lost)
  +drain = Bool.and(Nat.is_le(Su.Tm.drain(t), Su.Tm.launcher_wait(t)), child)
  supervisor.ps.and_t(Nat.is_le(Su.Tm.teardown(t), Su.Tm.stop_grace(t)), drain, ps.le_add(Su.Tm.teardown(t), Su.Tm.harness(t)),
    supervisor.ps.and_t(Nat.is_le(Su.Tm.drain(t), Su.Tm.launcher_wait(t)), child, ps.le_add(Su.Tm.drain(t), Su.Tm.margin(t)),
      supervisor.ps.and_t(Nat.is_le(Nat.add(Su.Tm.stop_grace(t), Su.Tm.drain(t)), Su.Tm.child_kill(t)), lost, ps.le_add(Nat.add(Su.Tm.stop_grace(t), Su.Tm.drain(t)), Su.Tm.margin(t)),
        supervisor.ps.and_t(Nat.is_le(Su.Tm.seen(t), Su.Tm.lost(t)), age, ps.seen_lost(t),
          supervisor.ps.and_t(Nat.is_le(Su.Tm.refresh(t), Su.Tm.max_age(t)), hold, ps.refresh_age(t),
            supervisor.ps.and_t(Nat.is_le(Su.Tm.qanswer(t), Su.Tm.quiesce_hold(t)), window, ps.le_add(Su.Tm.qanswer(t), Su.Tm.stop_grace(t)),
              supervisor.ps.le_add_l(Su.Tm.loop_step(t), Nat.mul(Su.Tm.k(t), Su.Tm.loop_step(t)))))))))

# (D1) revive_after_refresh
# -------------------------

def ps.tick_at(b: Bool, +h: Nat, +r: Nat, e: {Nat.is_eq(1n+r, h) == b : Bool}, pos: {Nat.is_lt(0n, h) == True{} : Bool}, lt: {Nat.is_lt(r, h) == True{} : Bool}) -> {Nat.is_lt(Rv.tick.put(b, r), h) == True{} : Bool}:
  match b:
    case True{}:
      pos
    case False{}:
      ps.lt_succ_ne(r, h, lt, e)

# a tick keeps the time since the last record below h
def ps.tick_lt(+h: Nat, +r: Nat, pos: {Nat.is_lt(0n, h) == True{} : Bool}, lt: {Nat.is_lt(r, h) == True{} : Bool}) -> {Nat.is_lt(Rv.tick(h, r), h) == True{} : Bool}:
  ps.tick_at(Nat.is_eq(1n+r, h), h, r, {==}, pos, lt)

# so does a run of any length
def ps.since_lt(c: Nat, +h: Nat, +r: Nat, +pos: {Nat.is_lt(0n, h) == True{} : Bool}, lt: {Nat.is_lt(r, h) == True{} : Bool}) -> {Nat.is_lt(Rv.since(c, h, r), h) == True{} : Bool}:
  match c:
    case 0n:
      lt
    case 1n+p:
      ps.since_lt(p, h, Rv.tick(h, r), pos, ps.tick_lt(h, r, pos, lt))

def ps.revive_after_refresh(+h: Nat, +pos: {Nat.is_lt(0n, h) == True{} : Bool}, +b: Nat, +c: Nat, +d: Nat, soon: {Nat.is_le(d, b) == True{} : Bool}) -> {Rv.fresh(Nat.add(h, b), Rv.age(h, c, d)) == True{} : Bool}:
  +a = Rv.since(c, h, 0n)
  +al = ps.lt_le(a, h, ps.since_lt(c, h, 0n, pos, pos))
  supervisor.ps.le_trans(Nat.add(a, d), Nat.add(a, b), Nat.add(h, b), ps.le_mono(a, d, b, soon), ps.le_mono_r(a, h, b, al))

# (D1) orphan_never_aborts_resumable
# ----------------------------------

def ps.exit_sound(work: Or.Work) -> Or.Sound(Or.Exited{Or.exit.done(Or.orphan_exit(work), work)}):
  match work:
    case Or.Idle{}:
      ({==}, {==})
    case Or.Ongoing{}:
      ({==}, {==})

def ps.check_put(due: Bool, +w: Or.W) -> Or.Sound(Or.check.put(due, w)):
  match due:
    case True{}:
      ps.exit_sound(Or.W.work(w))
    case False{}:
      Unit{}

def ps.check_sound(+window: Nat, +w: Or.W) -> Or.Sound(Or.check(window, w)):
  match w:
    case Or.W{r, q, c, a}:
      ps.check_put(Or.exit_due(window, a, Or.W.work(Or.W{r, q, c, a})), Or.W{r, q, c, a})

def ps.step_sound(+window: Nat, s: Or.St, +e: Or.Ev, ok: Or.Sound(s)) -> Or.Sound(Or.step(window, s, e)):
  match s:
    case Or.Live{w}:
      ps.check_sound(window, Or.apply(w, e))
    case Or.Exited{d}:
      ok

def ps.go_sound(+window: Nat, evs: List<&2, Or.Ev>, +s: Or.St, ok: Or.Sound(s)) -> Or.Sound(Or.go(window, evs, s)):
  match evs:
    case Nil{}:
      ok
    case +e <> rest:
      ps.go_sound(window, rest, Or.step(window, s, e), ps.step_sound(window, s, e, ok))

def ps.orphan_never_aborts_resumable(+window: Nat, +evs: List<&2, Or.Ev>) -> Or.Sound(Or.run(window, evs)):
  ps.go_sound(window, evs, Or.Live{Or.W.empty()}, Unit{})

# (D1) idle_shutdown_never_aborts
# -------------------------------

# a closed gate holds no run
def ps.WOk(w: La.Wk) -> Type:
  match w:
    case La.Wk{b, c}:
      match c:
        case True{}:
          {b == False{} : Bool}
        case False{}:
          Unit

def ps.Inv(ws: List<&2, La.Wk>) -> Type:
  match ws:
    case Nil{}:
      Unit
    case +w <> t:
      (ps.WOk(w) & ps.Inv(t))

# no run aborted, and while the daemon serves, no closed gate holds a run
def ps.Good(s: La.St) -> Type:
  match s:
    case La.St{ws, a, d}:
      match d:
        case True{}:
          {a == 0n : Nat}
        case False{}:
          ({a == 0n : Nat} & ps.Inv(ws))

def ps.prompt_ok(w: La.Wk, ok: ps.WOk(w)) -> ps.WOk(La.prompt(w)):
  match w:
    case La.Wk{b, c}:
      match c:
        case True{}:
          ok
        case False{}:
          Unit{}

def ps.finish_ok(w: La.Wk) -> ps.WOk(La.finish(w)):
  match w:
    case La.Wk{b, c}:
      match c:
        case True{}:
          {==}
        case False{}:
          Unit{}

def ps.quiesce_ok(w: La.Wk, ok: ps.WOk(w)) -> ps.WOk(La.quiesce(w)):
  match w:
    case La.Wk{b, c}:
      match b:
        case True{}:
          ok
        case False{}:
          {==}

def ps.release_ok(w: La.Wk) -> ps.WOk(La.release(w)):
  match w:
    case La.Wk{b, c}:
      Unit{}

def ps.at_prompt(i: Nat, ws: List<&2, La.Wk>, inv: ps.Inv(ws)) -> ps.Inv(La.at(~La.prompt, i, ws)):
  match i:
    case 0n:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (ps.prompt_ok(w, wo), it)
    case 1n+j:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (wo, ps.at_prompt(j, t, it))

def ps.at_finish(i: Nat, ws: List<&2, La.Wk>, inv: ps.Inv(ws)) -> ps.Inv(La.at(~La.finish, i, ws)):
  match i:
    case 0n:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (ps.finish_ok(w), it)
    case 1n+j:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (wo, ps.at_finish(j, t, it))

def ps.at_quiesce(i: Nat, ws: List<&2, La.Wk>, inv: ps.Inv(ws)) -> ps.Inv(La.at(~La.quiesce, i, ws)):
  match i:
    case 0n:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (ps.quiesce_ok(w, wo), it)
    case 1n+j:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (wo, ps.at_quiesce(j, t, it))

def ps.at_release(i: Nat, ws: List<&2, La.Wk>, inv: ps.Inv(ws)) -> ps.Inv(La.at(~La.release, i, ws)):
  match i:
    case 0n:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (ps.release_ok(w), it)
    case 1n+j:
      match ws:
        case Nil{}:
          Unit{}
        case +w <> t:
          (wo, it) = inv
          (wo, ps.at_release(j, t, it))

# every gate closed: no run
def ps.closed_idle(ws: List<&2, La.Wk>, inv: ps.Inv(ws), ac: {La.all_closed(ws) == True{} : Bool}) -> {La.busy_count(ws) == 0n : Nat}:
  match ws:
    case Nil{}:
      {==}
    case w <> t:
      match w:
        case La.Wk{b, c}:
          match b c:
            case True{} False{}:
              supervisor.ps.absurdF({La.busy_count(La.Wk{True{}, False{}} <> t) == 0n : Nat}, ac)
            case False{} False{}:
              supervisor.ps.absurdF({La.busy_count(La.Wk{False{}, False{}} <> t) == 0n : Nat}, ac)
            case True{} True{}:
              (wo, it) = inv
              supervisor.ps.absurd({La.busy_count(La.Wk{True{}, True{}} <> t) == 0n : Nat}, wo)
            case False{} True{}:
              (wo, it) = inv
              ps.closed_idle(t, it, ac)

def ps.commit_good(ok: Bool, +ws: List<&2, La.Wk>, +a: Nat, e: {La.all_closed(ws) == ok : Bool}, ea: {a == 0n : Nat}, inv: ps.Inv(ws)) -> ps.Good(La.commit.put(ok, ws, a)):
  match ok:
    case True{}:
      %Equal.sym(Nat, La.busy_count(ws), 0n, ps.closed_idle(ws, inv, e)) : {Nat.add(_, a) == 0n : Nat}
      ea
    case False{}:
      (ea, inv)

def ps.step_good(s: La.St, +op: La.Op, g: ps.Good(s)) -> ps.Good(La.step(s, op)):
  match s:
    case La.St{+ws, +a, d}:
      match d:
        case True{}:
          g
        case False{}:
          match op:
            case La.Prompt{i}:
              (ea, inv) = g
              (ea, ps.at_prompt(i, ws, inv))
            case La.Finish{i}:
              (ea, inv) = g
              (ea, ps.at_finish(i, ws, inv))
            case La.Quiesce{i}:
              (ea, inv) = g
              (ea, ps.at_quiesce(i, ws, inv))
            case La.Release{i}:
              (ea, inv) = g
              (ea, ps.at_release(i, ws, inv))
            case La.Commit{}:
              (ea, inv) = g
              ps.commit_good(La.all_closed(ws), ws, a, {==}, ea, inv)

def ps.go_good(ops: List<&2, La.Op>, +s: La.St, g: ps.Good(s)) -> ps.Good(La.go(ops, s)):
  match ops:
    case Nil{}:
      g
    case +op <> rest:
      ps.go_good(rest, La.step(s, op), ps.step_good(s, op, g))

def ps.open_inv(bs: List<&2, Bool>) -> ps.Inv(La.open(bs)):
  match bs:
    case Nil{}:
      Unit{}
    case b <> t:
      (Unit{}, ps.open_inv(t))

def ps.aborted_zero(s: La.St, g: ps.Good(s)) -> {La.St.aborted(s) == 0n : Nat}:
  match s:
    case La.St{ws, a, d}:
      match d:
        case True{}:
          g
        case False{}:
          (ea, inv) = g
          ea

def ps.idle_shutdown_never_aborts(+bs: List<&2, Bool>, +ops: List<&2, La.Op>) -> {La.St.aborted(La.run(bs, ops)) == 0n : Nat}:
  ps.aborted_zero(La.run(bs, ops), ps.go_good(ops, La.St{La.open(bs), 0n, False{}}, ({==}, ps.open_inv(bs))))

# (D1) adopt_same_build
# ---------------------

def ps.AD(x: La.Adoption, A: Type) -> Type:
  match x:
    case La.Adopt{}:
      A
    case La.Replace{}:
      Unit

def ps.not_adopted(-A: Type, e: {La.Replace{} == La.Adopt{} : La.Adoption}) -> A:
  %e : ps.AD(_, A)
  Unit{}

def ps.adopt_put(same: Bool, +b: Nat, +sup: Nat, e: {Nat.is_eq(b, sup) == same : Bool}, adopted: {La.adopt.put(same) == La.Adopt{} : La.Adoption}) -> {Some{b} == Some{sup} : Maybe<&2, Nat>}:
  match same:
    case True{}:
      Equal.cong(Nat, Maybe<&2, Nat>, x => Some{x}, b, sup, supervisor.ps.eq_of_is_eq(b, sup, e))
    case False{}:
      ps.not_adopted({Some{b} == Some{sup} : Maybe<&2, Nat>}, adopted)

def ps.adopt_same_build(+sup: Nat, w: Maybe<&2, Nat>, adopted: {La.adoption(sup, w) == La.Adopt{} : La.Adoption}) -> {w == Some{sup} : Maybe<&2, Nat>}:
  match w:
    case None{}:
      ps.not_adopted({None{} == Some{sup} : Maybe<&2, Nat>}, adopted)
    case Some{+b}:
      ps.adopt_put(Nat.is_eq(b, sup), b, sup, {==}, adopted)

# ---- replace ----

# proof_replace: the replacement laws of LAWS.bend section supervisor (D1), on the
# model bend/replace.bend.
#
# - replace_never_downgrades: a start replaces the daemon only with a build
#   of a higher rank (`pr.replace_older`), and the rank order is transitive
#   (`pr.lt_trans`), so the daemon after a start is below no daemon before
#   it (`pr.rising`).
# - replacement_terminates: each replacement moves the daemon to a build of
#   bs of a higher rank, so the count of the builds of bs above the daemon
#   falls by one at least (`pr.above_strict`); the first daemon has at most
#   |bs| - 1 builds of bs above it (`pr.above_member`).
# - background_never_replaces: the verdict of a background start is always
#   a keep.

# Logic
# -----

def replace.pr.and_l(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      e

def replace.pr.and_r(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      e
    case False{}:
      supervisor.ps.absurdF({b == True{} : Bool}, e)

# x cannot be True and False
def pr.clash(-A: Type, -x: Bool, t: {x == True{} : Bool}, f: {x == False{} : Bool}) -> A:
  supervisor.ps.absurdF(A, Equal.trans(Bool, False{}, x, True{}, Equal.sym(Bool, x, False{}, f), t))

def pr.VD(v: Rp.Verdict, A: Type) -> Type:
  match v:
    case Rp.Replace{}:
      A
    case Rp.Keep{r}:
      Unit

def pr.not_replace(-A: Type, -v: Rp.Verdict, e: {v == Rp.Replace{} : Rp.Verdict}, u: pr.VD(v, A)) -> A:
  %e : pr.VD(_, A)
  u

def pr.RD(r: Rp.Rel, A: Type) -> Type:
  match r:
    case Rp.Same{}:
      Unit
    case Rp.Older{}:
      A
    case Rp.Newer{}:
      Unit
    case Rp.Other{}:
      Unit

def pr.not_older(-A: Type, -r: Rp.Rel, e: {r == Rp.Older{} : Rp.Rel}, u: pr.RD(r, A)) -> A:
  %e : pr.RD(_, A)
  u

# The order
# ---------

def pr.lex_same(x: Nat, -t: Bool) -> {Rp.lex(x, x, t) == t : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      pr.lex_same(p, t)

def pr.lt_irrefl(xs: List<&2, Nat>) -> {Rp.lt(xs, xs) == False{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +xr:
      Equal.trans(Bool, Rp.lex(x, x, Rp.lt(xr, xr)), Rp.lt(xr, xr), False{}, pr.lex_same(x, Rp.lt(xr, xr)), pr.lt_irrefl(xr))

def pr.lex_trans(x: Nat, y: Nat, z: Nat, -t1: Bool, -t2: Bool, -t3: Bool, h1: {Rp.lex(x, y, t1) == True{} : Bool}, h2: {Rp.lex(y, z, t2) == True{} : Bool}, k: {t1 == True{} : Bool} -> {t2 == True{} : Bool} -> {t3 == True{} : Bool}) -> {Rp.lex(x, z, t3) == True{} : Bool}:
  match x y z:
    case 0n 0n 0n:
      k(h1, h2)
    case 0n 0n 1n+r:
      {==}
    case 0n 1n+q 0n:
      supervisor.ps.absurdF({Rp.lex(0n, 0n, t3) == True{} : Bool}, h2)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 0n _:
      supervisor.ps.absurdF({Rp.lex(1n+p, z, t3) == True{} : Bool}, h1)
    case 1n+p 1n+q 0n:
      supervisor.ps.absurdF({Rp.lex(1n+p, 0n, t3) == True{} : Bool}, h2)
    case 1n+p 1n+q 1n+r:
      pr.lex_trans(p, q, r, t1, t2, t3, h1, h2, k)

def pr.lt_trans(xs: List<&2, Nat>, ys: List<&2, Nat>, zs: List<&2, Nat>, h1: {Rp.lt(xs, ys) == True{} : Bool}, h2: {Rp.lt(ys, zs) == True{} : Bool}) -> {Rp.lt(xs, zs) == True{} : Bool}:
  match xs ys zs:
    case Nil{} Nil{} _:
      supervisor.ps.absurdF({Rp.lt(Nil{}, zs) == True{} : Bool}, h1)
    case Nil{} y <> yr Nil{}:
      supervisor.ps.absurdF({Rp.lt(Nil{}, Nil{}) == True{} : Bool}, h2)
    case Nil{} y <> yr z <> zr:
      {==}
    case x <> xr Nil{} _:
      supervisor.ps.absurdF({Rp.lt(x <> xr, zs) == True{} : Bool}, h1)
    case x <> xr y <> yr Nil{}:
      supervisor.ps.absurdF({Rp.lt(x <> xr, Nil{}) == True{} : Bool}, h2)
    case x <> +xr y <> +yr z <> +zr:
      pr.lex_trans(x, y, z, Rp.lt(xr, yr), Rp.lt(yr, zr), Rp.lt(xr, zr), h1, h2, a => b => pr.lt_trans(xr, yr, zr, a, b))

def pr.ranks_eq_sound(xs: List<&2, Nat>, ys: List<&2, Nat>, +e: {Rp.ranks_eq(xs, ys) == True{} : Bool}) -> {xs == ys : List<&2, Nat>}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Nil{} y <> yr:
      supervisor.ps.absurdF({Nil{} == y <> yr : List<&2, Nat>}, e)
    case x <> xr Nil{}:
      supervisor.ps.absurdF({x <> xr == Nil{} : List<&2, Nat>}, e)
    case +x <> +xr +y <> +yr:
      %supervisor.ps.eq_of_is_eq(x, y, replace.pr.and_l(Nat.is_eq(x, y), Rp.ranks_eq(xr, yr), e)) : {x <> xr == _ <> yr : List<&2, Nat>}
      %pr.ranks_eq_sound(xr, yr, replace.pr.and_r(Nat.is_eq(x, y), Rp.ranks_eq(xr, yr), e)) : {x <> xr == x <> _ : List<&2, Nat>}
      {==}

def pr.build_eq_rank(a: Rp.Build, b: Rp.Build, e: {Rp.build_eq(a, b) == True{} : Bool}) -> {Rp.Build.rank(a) == Rp.Build.rank(b) : List<&2, Nat>}:
  match a b:
    case Rp.Build{+ra, +ia} Rp.Build{+rb, +ib}:
      pr.ranks_eq_sound(ra, rb, replace.pr.and_r(Nat.is_eq(ia, ib), Rp.ranks_eq(ra, rb), e))

# The verdict
# -----------

def pr.put_replace(r: Rp.Rel, -k: Rp.Caller, e: {Rp.verdict.put(r, k) == Rp.Replace{} : Rp.Verdict}) -> {r == Rp.Older{} : Rp.Rel}:
  match r:
    case Rp.Same{}:
      pr.not_replace({Rp.Same{} == Rp.Older{} : Rp.Rel}, Rp.Keep{Rp.Same{}}, e, Unit{})
    case Rp.Older{}:
      {==}
    case Rp.Newer{}:
      pr.not_replace({Rp.Newer{} == Rp.Older{} : Rp.Rel}, Rp.Keep{Rp.Newer{}}, e, Unit{})
    case Rp.Other{}:
      pr.not_replace({Rp.Other{} == Rp.Older{} : Rp.Rel}, Rp.Keep{Rp.Other{}}, e, Unit{})

def pr.rel_older(same: Bool, older: Bool, newer: Bool, e: {Rp.rel.put(same, older, newer) == Rp.Older{} : Rp.Rel}) -> {older == True{} : Bool}:
  match same:
    case True{}:
      pr.not_older({older == True{} : Bool}, Rp.Same{}, e, Unit{})
    case False{}:
      match older:
        case True{}:
          {==}
        case False{}:
          match newer:
            case True{}:
              pr.not_older({False{} == True{} : Bool}, Rp.Newer{}, e, Unit{})
            case False{}:
              pr.not_older({False{} == True{} : Bool}, Rp.Other{}, e, Unit{})

# a replacement moves the daemon b to a client c of a higher rank
def pr.replace_older(c: Rp.Build, b: Rp.Build, -k: Rp.Caller, e: {Rp.verdict(c, b, k) == Rp.Replace{} : Rp.Verdict}) -> {Rp.lt(Rp.Build.rank(b), Rp.Build.rank(c)) == True{} : Bool}:
  match c b:
    case Rp.Build{+rc, +ic} Rp.Build{+rb, +ib}:
      pr.rel_older(Nat.is_eq(ic, ib), Rp.lt(rb, rc), Rp.lt(rc, rb), pr.put_replace(Rp.rel.put(Nat.is_eq(ic, ib), Rp.lt(rb, rc), Rp.lt(rc, rb)), k, e))

# (D1) replace_never_downgrades
# -----------------------------

def pr.nb_self(-S: List<&2, Rp.Build>, +b: Rp.Build, inv: {Rp.not_below(S, b) == True{} : Bool}) -> {Rp.not_below(b <> S, b) == True{} : Bool}:
  %Equal.sym(Bool, Rp.lt(Rp.Build.rank(b), Rp.Build.rank(b)), False{}, pr.lt_irrefl(Rp.Build.rank(b))) : {Bool.and(Bool.not(_), Rp.not_below(S, b)) == True{} : Bool}
  inv

def pr.lift.put(p: Bool, q: Bool, rb: List<&2, Nat>, rc: List<&2, Nat>, re: List<&2, Nat>, -t1: Bool, -t2: Bool, ep: {Rp.lt(rb, re) == p : Bool}, eq: {Rp.lt(rc, re) == q : Bool}, h: {Rp.lt(rb, rc) == True{} : Bool}, inv: {Bool.and(Bool.not(p), t1) == True{} : Bool}, ih: {t1 == True{} : Bool} -> {t2 == True{} : Bool}) -> {Bool.and(Bool.not(q), t2) == True{} : Bool}:
  match p q:
    case True{} True{}:
      supervisor.ps.absurdF({Bool.and(Bool.not(True{}), t2) == True{} : Bool}, inv)
    case True{} False{}:
      supervisor.ps.absurdF({Bool.and(Bool.not(False{}), t2) == True{} : Bool}, inv)
    case False{} True{}:
      pr.clash({Bool.and(Bool.not(True{}), t2) == True{} : Bool}, Rp.lt(rb, re), pr.lt_trans(rb, rc, re, h, eq), ep)
    case False{} False{}:
      ih(inv)

# b below none of S and c above b: c below none of S
def pr.lift(S: List<&2, Rp.Build>, +b: Rp.Build, +c: Rp.Build, +h: {Rp.lt(Rp.Build.rank(b), Rp.Build.rank(c)) == True{} : Bool}, inv: {Rp.not_below(S, b) == True{} : Bool}) -> {Rp.not_below(S, c) == True{} : Bool}:
  match S:
    case Nil{}:
      {==}
    case +e <> +t:
      pr.lift.put(Rp.lt(Rp.Build.rank(b), Rp.Build.rank(e)), Rp.lt(Rp.Build.rank(c), Rp.Build.rank(e)), Rp.Build.rank(b), Rp.Build.rank(c), Rp.Build.rank(e), Rp.not_below(t, b), Rp.not_below(t, c), {==}, {==}, h, inv, i => pr.lift(t, b, c, h, i))

def pr.next.put(v: Rp.Verdict, +c: Rp.Build, +b: Rp.Build, -k: Rp.Caller, +S: List<&2, Rp.Build>, ev: {Rp.verdict(c, b, k) == v : Rp.Verdict}, inv: {Rp.not_below(S, b) == True{} : Bool}) -> {Rp.not_below(b <> S, Rp.after.put(v, c, b)) == True{} : Bool}:
  match v:
    case Rp.Replace{}:
      pr.lift(b <> S, b, c, pr.replace_older(c, b, k, ev), pr.nb_self(S, b, inv))
    case Rp.Keep{r}:
      pr.nb_self(S, b, inv)

# from the daemon b, below none of S, no daemon goes back
def pr.rising(ss: List<&2, Rp.Start>, +b: Rp.Build, +S: List<&2, Rp.Build>, +inv: {Rp.not_below(S, b) == True{} : Bool}) -> {Rp.never_back.go(Rp.trace.go(ss, Some{b}), b <> S) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case s <> +rest:
      match s:
        case Rp.Start{+c, +k}:
          supervisor.ps.and_t(Rp.not_below(b <> S, Rp.after.put(Rp.verdict(c, b, k), c, b)), Rp.never_back.go(Rp.trace.go(rest, Some{Rp.after.put(Rp.verdict(c, b, k), c, b)}), Rp.after.put(Rp.verdict(c, b, k), c, b) <> (b <> S)), pr.next.put(Rp.verdict(c, b, k), c, b, k, S, {==}, inv), pr.rising(rest, Rp.after.put(Rp.verdict(c, b, k), c, b), b <> S, pr.next.put(Rp.verdict(c, b, k), c, b, k, S, {==}, inv)))

def pr.replace_never_downgrades(ss: List<&2, Rp.Start>) -> {Rp.never_back(Rp.daemons(ss)) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case s <> rest:
      match s:
        case Rp.Start{+c, k}:
          pr.rising(rest, c, Nil{}, {==})

# (D1) replacement_terminates
# ---------------------------

def pr.one(b: Bool) -> Nat:
  match b:
    case True{}:
      1n
    case False{}:
      0n

# the builds of bs above rank r
def pr.above(bs: List<&2, Rp.Build>, +r: List<&2, Nat>) -> Nat:
  match bs:
    case Nil{}:
      0n
    case e <> t:
      Nat.add(pr.one(Rp.lt(r, Rp.Build.rank(e))), pr.above(t, r))

def pr.weak.put(p: Bool, q: Bool, +x: Nat, +y: Nat, rb: List<&2, Nat>, rc: List<&2, Nat>, re: List<&2, Nat>, ep: {Rp.lt(rc, re) == p : Bool}, eq: {Rp.lt(rb, re) == q : Bool}, h: {Rp.lt(rb, rc) == True{} : Bool}, ih: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(Nat.add(pr.one(p), x), Nat.add(pr.one(q), y)) == True{} : Bool}:
  match p q:
    case True{} True{}:
      ih
    case True{} False{}:
      pr.clash({Nat.is_le(Nat.add(1n, x), Nat.add(0n, y)) == True{} : Bool}, Rp.lt(rb, re), pr.lt_trans(rb, rc, re, h, ep), eq)
    case False{} True{}:
      supervisor.ps.le_trans(x, y, 1n+y, ih, supervisor.ps.le_succ(y))
    case False{} False{}:
      ih

# rank rc above rank rb: fewer builds above rc than above rb
def pr.above_weak(bs: List<&2, Rp.Build>, +rb: List<&2, Nat>, +rc: List<&2, Nat>, +h: {Rp.lt(rb, rc) == True{} : Bool}) -> {Nat.is_le(pr.above(bs, rc), pr.above(bs, rb)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case +e <> +t:
      pr.weak.put(Rp.lt(rc, Rp.Build.rank(e)), Rp.lt(rb, Rp.Build.rank(e)), pr.above(t, rc), pr.above(t, rb), rb, rc, Rp.Build.rank(e), {==}, {==}, h, pr.above_weak(t, rb, rc, h))

def pr.strict.put(p: Bool, q: Bool, +x: Nat, +y: Nat, rb: List<&2, Nat>, rc: List<&2, Nat>, re: List<&2, Nat>, ep: {Rp.lt(rc, re) == p : Bool}, eq: {Rp.lt(rb, re) == q : Bool}, h: {Rp.lt(rb, rc) == True{} : Bool}, ih: {Nat.is_le(1n+x, y) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(pr.one(p), x), Nat.add(pr.one(q), y)) == True{} : Bool}:
  match p q:
    case True{} True{}:
      ih
    case True{} False{}:
      pr.clash({Nat.is_le(1n+Nat.add(1n, x), Nat.add(0n, y)) == True{} : Bool}, Rp.lt(rb, re), pr.lt_trans(rb, rc, re, h, ep), eq)
    case False{} True{}:
      supervisor.ps.le_trans(x, 1n+x, y, supervisor.ps.le_succ(x), ih)
    case False{} False{}:
      ih

def pr.member.put(be: Bool, +e: Rp.Build, +t: List<&2, Rp.Build>, +c: Rp.Build, +rb: List<&2, Nat>, ebe: {Rp.build_eq(e, c) == be : Bool}, m: {Bool.or(be, Rp.has(t, c)) == True{} : Bool}, +h: {Rp.lt(rb, Rp.Build.rank(c)) == True{} : Bool}, ih: {Rp.has(t, c) == True{} : Bool} -> {Nat.is_le(1n+pr.above(t, Rp.Build.rank(c)), pr.above(t, rb)) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(pr.one(Rp.lt(Rp.Build.rank(c), Rp.Build.rank(e))), pr.above(t, Rp.Build.rank(c))), Nat.add(pr.one(Rp.lt(rb, Rp.Build.rank(e))), pr.above(t, rb))) == True{} : Bool}:
  match be:
    case True{}:
      %Equal.sym(List<&2, Nat>, Rp.Build.rank(e), Rp.Build.rank(c), pr.build_eq_rank(e, c, ebe)) : {Nat.is_le(1n+Nat.add(pr.one(Rp.lt(Rp.Build.rank(c), _)), pr.above(t, Rp.Build.rank(c))), Nat.add(pr.one(Rp.lt(rb, _)), pr.above(t, rb))) == True{} : Bool}
      %Equal.sym(Bool, Rp.lt(Rp.Build.rank(c), Rp.Build.rank(c)), False{}, pr.lt_irrefl(Rp.Build.rank(c))) : {Nat.is_le(1n+Nat.add(pr.one(_), pr.above(t, Rp.Build.rank(c))), Nat.add(pr.one(Rp.lt(rb, Rp.Build.rank(c))), pr.above(t, rb))) == True{} : Bool}
      %Equal.sym(Bool, Rp.lt(rb, Rp.Build.rank(c)), True{}, h) : {Nat.is_le(1n+Nat.add(pr.one(False{}), pr.above(t, Rp.Build.rank(c))), Nat.add(pr.one(_), pr.above(t, rb))) == True{} : Bool}
      pr.above_weak(t, rb, Rp.Build.rank(c), h)
    case False{}:
      pr.strict.put(Rp.lt(Rp.Build.rank(c), Rp.Build.rank(e)), Rp.lt(rb, Rp.Build.rank(e)), pr.above(t, Rp.Build.rank(c)), pr.above(t, rb), rb, Rp.Build.rank(c), Rp.Build.rank(e), {==}, {==}, h, ih(m))

# a build c of bs above rank rb: c and the builds above it are above rb
def pr.above_strict(bs: List<&2, Rp.Build>, +rb: List<&2, Nat>, +c: Rp.Build, +h: {Rp.lt(rb, Rp.Build.rank(c)) == True{} : Bool}, m: {Rp.has(bs, c) == True{} : Bool}) -> {Nat.is_le(1n+pr.above(bs, Rp.Build.rank(c)), pr.above(bs, rb)) == True{} : Bool}:
  match bs:
    case Nil{}:
      supervisor.ps.absurdF({Nat.is_le(1n+pr.above(Nil{}, Rp.Build.rank(c)), pr.above(Nil{}, rb)) == True{} : Bool}, m)
    case +e <> +t:
      pr.member.put(Rp.build_eq(e, c), e, t, c, rb, {==}, m, h, i => pr.above_strict(t, rb, c, h, i))

def pr.len.put(p: Bool, +x: Nat, +n: Nat, ih: {Nat.is_le(x, n) == True{} : Bool}) -> {Nat.is_le(Nat.add(pr.one(p), x), 1n+n) == True{} : Bool}:
  match p:
    case True{}:
      ih
    case False{}:
      supervisor.ps.le_trans(x, n, 1n+n, ih, supervisor.ps.le_succ(n))

def pr.above_le_len(bs: List<&2, Rp.Build>, +r: List<&2, Nat>) -> {Nat.is_le(pr.above(bs, r), List.length(&2, Rp.Build, bs)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case +e <> +t:
      pr.len.put(Rp.lt(r, Rp.Build.rank(e)), pr.above(t, r), List.length(&2, Rp.Build, t), pr.above_le_len(t, r))

def pr.mlen.put(p: Bool, +x: Nat, +n: Nat, ih: {Nat.is_le(1n+x, n) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(pr.one(p), x), 1n+n) == True{} : Bool}:
  match p:
    case True{}:
      ih
    case False{}:
      supervisor.ps.le_trans(x, 1n+x, n, supervisor.ps.le_succ(x), ih)

def pr.member_len.put(be: Bool, +e: Rp.Build, +t: List<&2, Rp.Build>, +c: Rp.Build, ebe: {Rp.build_eq(e, c) == be : Bool}, m: {Bool.or(be, Rp.has(t, c)) == True{} : Bool}, ih: {Rp.has(t, c) == True{} : Bool} -> {Nat.is_le(1n+pr.above(t, Rp.Build.rank(c)), List.length(&2, Rp.Build, t)) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(pr.one(Rp.lt(Rp.Build.rank(c), Rp.Build.rank(e))), pr.above(t, Rp.Build.rank(c))), 1n+List.length(&2, Rp.Build, t)) == True{} : Bool}:
  match be:
    case True{}:
      %Equal.sym(List<&2, Nat>, Rp.Build.rank(e), Rp.Build.rank(c), pr.build_eq_rank(e, c, ebe)) : {Nat.is_le(1n+Nat.add(pr.one(Rp.lt(Rp.Build.rank(c), _)), pr.above(t, Rp.Build.rank(c))), 1n+List.length(&2, Rp.Build, t)) == True{} : Bool}
      %Equal.sym(Bool, Rp.lt(Rp.Build.rank(c), Rp.Build.rank(c)), False{}, pr.lt_irrefl(Rp.Build.rank(c))) : {Nat.is_le(1n+Nat.add(pr.one(_), pr.above(t, Rp.Build.rank(c))), 1n+List.length(&2, Rp.Build, t)) == True{} : Bool}
      pr.above_le_len(t, Rp.Build.rank(c))
    case False{}:
      pr.mlen.put(Rp.lt(Rp.Build.rank(c), Rp.Build.rank(e)), pr.above(t, Rp.Build.rank(c)), List.length(&2, Rp.Build, t), ih(m))

# a build c of bs: at most |bs| - 1 builds of bs above it
def pr.above_member(bs: List<&2, Rp.Build>, +c: Rp.Build, m: {Rp.has(bs, c) == True{} : Bool}) -> {Nat.is_le(1n+pr.above(bs, Rp.Build.rank(c)), List.length(&2, Rp.Build, bs)) == True{} : Bool}:
  match bs:
    case Nil{}:
      supervisor.ps.absurdF({Nat.is_le(1n+pr.above(Nil{}, Rp.Build.rank(c)), 0n) == True{} : Bool}, m)
    case +e <> +t:
      pr.member_len.put(Rp.build_eq(e, c), e, t, c, {==}, m, i => pr.above_member(t, c, i))

def pr.count.put(v: Rp.Verdict, +c: Rp.Build, +b: Rp.Build, -k: Rp.Caller, +rest: List<&2, Rp.Start>, +bs: List<&2, Rp.Build>, ev: {Rp.verdict(c, b, k) == v : Rp.Verdict}, mc: {Rp.has(bs, c) == True{} : Bool}, ih: @d: Rp.Build -> {Nat.is_le(Rp.replaced.go(rest, Some{d}), pr.above(bs, Rp.Build.rank(d))) == True{} : Bool}) -> {Nat.is_le(Nat.add(Rp.replaces.put(v), Rp.replaced.go(rest, Some{Rp.after.put(v, c, b)})), pr.above(bs, Rp.Build.rank(b))) == True{} : Bool}:
  match v:
    case Rp.Replace{}:
      supervisor.ps.le_trans(1n+Rp.replaced.go(rest, Some{c}), 1n+pr.above(bs, Rp.Build.rank(c)), pr.above(bs, Rp.Build.rank(b)), ih(c), pr.above_strict(bs, Rp.Build.rank(b), c, pr.replace_older(c, b, k, ev), mc))
    case Rp.Keep{r}:
      ih(b)

# from the daemon b, the replacements are at most the builds of bs above b
def pr.count_le(ss: List<&2, Rp.Start>, +bs: List<&2, Rp.Build>, +b: Rp.Build, +cov: {Rp.covers(bs, ss) == True{} : Bool}) -> {Nat.is_le(Rp.replaced.go(ss, Some{b}), pr.above(bs, Rp.Build.rank(b))) == True{} : Bool}:
  match ss:
    case Nil{}:
      ps.le_zero(pr.above(bs, Rp.Build.rank(b)))
    case s <> +rest:
      match s:
        case Rp.Start{+c, +k}:
          pr.count.put(Rp.verdict(c, b, k), c, b, k, rest, bs, {==}, replace.pr.and_l(Rp.has(bs, c), Rp.covers(bs, rest), cov), d => pr.count_le(rest, bs, d, replace.pr.and_r(Rp.has(bs, c), Rp.covers(bs, rest), cov)))

def pr.le_pred(+a: Nat, n: Nat, h: {Nat.is_le(1n+a, n) == True{} : Bool}) -> {Nat.is_le(a, Nat.sub(n, 1n)) == True{} : Bool}:
  match n:
    case 0n:
      supervisor.ps.absurdF({Nat.is_le(a, Nat.sub(0n, 1n)) == True{} : Bool}, h)
    case 1n+m:
      match m:
        case 0n:
          h
        case 1n+j:
          h

def pr.replacement_terminates(+bs: List<&2, Rp.Build>, ss: List<&2, Rp.Start>, +cover: {Rp.covers(bs, ss) == True{} : Bool}) -> {Nat.is_le(Rp.replaced(ss), Nat.sub(List.length(&2, Rp.Build, bs), 1n)) == True{} : Bool}:
  match ss:
    case Nil{}:
      ps.le_zero(Nat.sub(List.length(&2, Rp.Build, bs), 1n))
    case s <> +rest:
      match s:
        case Rp.Start{+c, k}:
          pr.le_pred(Rp.replaced.go(rest, Some{c}), List.length(&2, Rp.Build, bs), supervisor.ps.le_trans(1n+Rp.replaced.go(rest, Some{c}), 1n+pr.above(bs, Rp.Build.rank(c)), List.length(&2, Rp.Build, bs), pr.count_le(rest, bs, c, replace.pr.and_r(Rp.has(bs, c), Rp.covers(bs, rest), cover)), pr.above_member(bs, c, replace.pr.and_l(Rp.has(bs, c), Rp.covers(bs, rest), cover))))

# (D1) background_never_replaces
# ------------------------------

def pr.bg(r: Rp.Rel, -c: Rp.Build, -d: Rp.Build) -> {Rp.after.put(Rp.verdict.put(r, Rp.Background{}), c, d) == d : Rp.Build}:
  match r:
    case Rp.Same{}:
      {==}
    case Rp.Older{}:
      {==}
    case Rp.Newer{}:
      {==}
    case Rp.Other{}:
      {==}

def pr.background_never_replaces(+c: Rp.Build, +d: Rp.Build) -> {Rp.after(Rp.Start{c, Rp.Background{}}, Some{d}) == d : Rp.Build}:
  pr.bg(Rp.relation(c, d), c, d)

# ---- notice ----

# proof_notice: the restore notice laws of LAWS.bend section supervisor (D1).
#
# - notice_shown_once: each stored notice is in one of two states: not
#   in the record and never shown, or in the record and shown once
#   (`pn.ok`). A restore adds a notice in the first state, and an offer
#   (`No.show`) moves a notice to the second state (`pn.show_shown`).
#   So no notice shows more than once.
# - notice_per_restore: an attach offers every stored notice, so after
#   it each one showed exactly once (`pn.full`), and the view stores one
#   notice for each restore (`pn.len_go`).

# Logic
# -----

def notice.pn.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def notice.pn.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : notice.pn.BD(_, A, Unit)
  Unit{}

def notice.pn.and_l(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      notice.pn.absurdF({False{} == True{} : Bool}, h)

def notice.pn.and_r(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      notice.pn.absurdF({b == True{} : Bool}, h)

def notice.pn.and_t(a: Bool, -b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      eb
    case False{}:
      notice.pn.absurdF({Bool.and(False{}, b) == True{} : Bool}, ea)

# Numbers
# -------

def pn.add_zero(a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pn.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def pn.add_succ_r(a: Nat, +m: Nat) -> {Nat.add(a, 1n+m) == 1n+Nat.add(a, m) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pn.add_succ_r(p, m) : {1n+Nat.add(p, 1n+m) == 1n+_ : Nat}
      {==}

# The two states of a notice
# --------------------------

def pn.zero(c: Nat) -> Bool:
  match c:
    case 0n:
      True{}
    case 1n+p:
      False{}

def pn.one(c: Nat) -> Bool:
  match c:
    case 0n:
      False{}
    case 1n+p:
      pn.zero(p)

# not in the record and never shown, or in the record and shown once
def pn.ok(n: No.N) -> Bool:
  match n:
    case No.N{s, c}:
      match s:
        case True{}:
          pn.one(c)
        case False{}:
          pn.zero(c)

def pn.all_ok(ns: List<&2, No.N>) -> Bool:
  match ns:
    case Nil{}:
      True{}
    case n <> t:
      Bool.and(pn.ok(n), pn.all_ok(t))

# an offer leaves a notice in the record, shown once
def pn.show_shown(n: No.N, h: {pn.ok(n) == True{} : Bool}) -> {No.show(n) == No.N{True{}, 1n} : No.N}:
  match n:
    case No.N{s, c}:
      match s:
        case True{}:
          match c:
            case 0n:
              notice.pn.absurdF({No.show(No.N{True{}, 0n}) == No.N{True{}, 1n} : No.N}, h)
            case 1n+p:
              match p:
                case 0n:
                  {==}
                case 1n+q:
                  notice.pn.absurdF({No.show(No.N{True{}, 2n+q}) == No.N{True{}, 1n} : No.N}, h)
        case False{}:
          match c:
            case 0n:
              {==}
            case 1n+p:
              notice.pn.absurdF({No.show(No.N{False{}, 1n+p}) == No.N{True{}, 1n} : No.N}, h)

def pn.ok_show(+n: No.N, h: {pn.ok(n) == True{} : Bool}) -> {pn.ok(No.show(n)) == True{} : Bool}:
  %Equal.sym(No.N, No.show(n), No.N{True{}, 1n}, pn.show_shown(n, h)) : {pn.ok(_) == True{} : Bool}
  {==}

# Every event keeps the two states
# --------------------------------

def pn.ok_rebuild(ns: List<&2, No.N>, +h: {pn.all_ok(ns) == True{} : Bool}) -> {pn.all_ok(No.rebuild(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case +n <> +t:
      notice.pn.and_t(pn.ok(No.show(n)), pn.all_ok(No.rebuild(t)), pn.ok_show(n, notice.pn.and_l(pn.ok(n), pn.all_ok(t), h)), pn.ok_rebuild(t, notice.pn.and_r(pn.ok(n), pn.all_ok(t), h)))

def pn.ok_live_at(t: List<&2, No.N>, +n: No.N, hn: {pn.ok(n) == True{} : Bool}, +ht: {pn.all_ok(t) == True{} : Bool}) -> {pn.all_ok(No.live.at(t, n)) == True{} : Bool}:
  match t:
    case Nil{}:
      notice.pn.and_t(pn.ok(No.show(n)), True{}, pn.ok_show(n, hn), {==})
    case +m <> +u:
      notice.pn.and_t(pn.ok(n), pn.all_ok(No.live.at(u, m)), hn, pn.ok_live_at(u, m, notice.pn.and_l(pn.ok(m), pn.all_ok(u), ht), notice.pn.and_r(pn.ok(m), pn.all_ok(u), ht)))

def pn.ok_live(ns: List<&2, No.N>, +h: {pn.all_ok(ns) == True{} : Bool}) -> {pn.all_ok(No.live(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case +n <> +t:
      pn.ok_live_at(t, n, notice.pn.and_l(pn.ok(n), pn.all_ok(t), h), notice.pn.and_r(pn.ok(n), pn.all_ok(t), h))

def pn.ok_append(ns: List<&2, No.N>, +x: No.N, +h: {pn.all_ok(ns) == True{} : Bool}, hx: {pn.ok(x) == True{} : Bool}) -> {pn.all_ok(List.append(&2, No.N, ns, [x])) == True{} : Bool}:
  match ns:
    case Nil{}:
      notice.pn.and_t(pn.ok(x), True{}, hx, {==})
    case +n <> +t:
      notice.pn.and_t(pn.ok(n), pn.all_ok(List.append(&2, No.N, t, [x])), notice.pn.and_l(pn.ok(n), pn.all_ok(t), h), pn.ok_append(t, x, notice.pn.and_r(pn.ok(n), pn.all_ok(t), h), hx))

def pn.ok_step(+ns: List<&2, No.N>, e: No.Ev, h: {pn.all_ok(ns) == True{} : Bool}) -> {pn.all_ok(No.step(ns, e)) == True{} : Bool}:
  match e:
    case No.Restore{}:
      pn.ok_append(ns, No.N{False{}, 0n}, h, {==})
    case No.Live{}:
      pn.ok_live(ns, h)
    case No.Reconnect{}:
      pn.ok_rebuild(ns, h)

def pn.ok_go(evs: List<&2, No.Ev>, +ns: List<&2, No.N>, h: {pn.all_ok(ns) == True{} : Bool}) -> {pn.all_ok(No.go(evs, ns)) == True{} : Bool}:
  match evs:
    case Nil{}:
      h
    case +e <> +rest:
      pn.ok_go(rest, No.step(ns, e), pn.ok_step(ns, e, h))

# notice_shown_once
# -----------------

def pn.amo(s: Bool, c: Nat, h: {pn.ok(No.N{s, c}) == True{} : Bool}) -> {No.at_most_one(c) == True{} : Bool}:
  match s c:
    case True{} 0n:
      {==}
    case True{} 1n+p:
      match p:
        case 0n:
          {==}
        case 1n+q:
          notice.pn.absurdF({No.at_most_one(2n+q) == True{} : Bool}, h)
    case False{} 0n:
      {==}
    case False{} 1n+p:
      notice.pn.absurdF({No.at_most_one(1n+p) == True{} : Bool}, h)

def pn.once_of_ok(ns: List<&2, No.N>, +h: {pn.all_ok(ns) == True{} : Bool}) -> {No.once(ns) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case n <> +t:
      match n:
        case No.N{+s, +c}:
          notice.pn.and_t(No.at_most_one(c), No.once(t), pn.amo(s, c, notice.pn.and_l(pn.ok(No.N{s, c}), pn.all_ok(t), h)), pn.once_of_ok(t, notice.pn.and_r(pn.ok(No.N{s, c}), pn.all_ok(t), h)))

def pn.notice_shown_once(+evs: List<&2, No.Ev>) -> {No.once(No.run(evs)) == True{} : Bool}:
  pn.once_of_ok(No.run(evs), pn.ok_go(evs, Nil{}, {==}))

# notice_per_restore
# ------------------

def pn.len_snoc(ns: List<&2, No.N>, +x: No.N) -> {List.length(&2, No.N, List.append(&2, No.N, ns, [x])) == 1n+List.length(&2, No.N, ns) : Nat}:
  match ns:
    case Nil{}:
      {==}
    case n <> +t:
      %pn.len_snoc(t, x) : {1n+List.length(&2, No.N, List.append(&2, No.N, t, [x])) == 1n+_ : Nat}
      {==}

def pn.len_live_at(t: List<&2, No.N>, n: No.N) -> {List.length(&2, No.N, No.live.at(t, n)) == 1n+List.length(&2, No.N, t) : Nat}:
  match t:
    case Nil{}:
      {==}
    case +m <> +u:
      %pn.len_live_at(u, m) : {1n+List.length(&2, No.N, No.live.at(u, m)) == 1n+_ : Nat}
      {==}

def pn.len_live(ns: List<&2, No.N>) -> {List.length(&2, No.N, No.live(ns)) == List.length(&2, No.N, ns) : Nat}:
  match ns:
    case Nil{}:
      {==}
    case n <> t:
      pn.len_live_at(t, n)

def pn.len_rebuild(ns: List<&2, No.N>) -> {List.length(&2, No.N, No.rebuild(ns)) == List.length(&2, No.N, ns) : Nat}:
  match ns:
    case Nil{}:
      {==}
    case n <> +t:
      %pn.len_rebuild(t) : {1n+List.length(&2, No.N, No.rebuild(t)) == 1n+_ : Nat}
      {==}

# the view stores one notice for each restore
def pn.len_go(evs: List<&2, No.Ev>, +ns: List<&2, No.N>) -> {List.length(&2, No.N, No.go(evs, ns)) == Nat.add(No.restores(evs), List.length(&2, No.N, ns)) : Nat}:
  match evs:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case No.Restore{}:
          +r = No.restores(rest)
          +l = List.length(&2, No.N, ns)
          +app = List.append(&2, No.N, ns, [No.N{False{}, 0n}])
          %Equal.sym(Nat, List.length(&2, No.N, No.go(rest, app)), Nat.add(r, List.length(&2, No.N, app)), pn.len_go(rest, app)) : {_ == 1n+Nat.add(r, l) : Nat}
          %Equal.sym(Nat, List.length(&2, No.N, app), 1n+l, pn.len_snoc(ns, No.N{False{}, 0n})) : {Nat.add(r, _) == 1n+Nat.add(r, l) : Nat}
          pn.add_succ_r(r, l)
        case No.Live{}:
          +r = No.restores(rest)
          %Equal.sym(Nat, List.length(&2, No.N, No.go(rest, No.live(ns))), Nat.add(r, List.length(&2, No.N, No.live(ns))), pn.len_go(rest, No.live(ns))) : {_ == Nat.add(r, List.length(&2, No.N, ns)) : Nat}
          %pn.len_live(ns) : {Nat.add(r, List.length(&2, No.N, No.live(ns))) == Nat.add(r, _) : Nat}
          {==}
        case No.Reconnect{}:
          +r = No.restores(rest)
          %Equal.sym(Nat, List.length(&2, No.N, No.go(rest, No.rebuild(ns))), Nat.add(r, List.length(&2, No.N, No.rebuild(ns))), pn.len_go(rest, No.rebuild(ns))) : {_ == Nat.add(r, List.length(&2, No.N, ns)) : Nat}
          %pn.len_rebuild(ns) : {Nat.add(r, List.length(&2, No.N, No.rebuild(ns))) == Nat.add(r, _) : Nat}
          {==}

# after an attach, each stored notice showed once
def pn.full(ns: List<&2, No.N>, +h: {pn.all_ok(ns) == True{} : Bool}) -> {No.total(No.rebuild(ns)) == List.length(&2, No.N, ns) : Nat}:
  match ns:
    case Nil{}:
      {==}
    case +n <> +t:
      %Equal.sym(No.N, No.show(n), No.N{True{}, 1n}, pn.show_shown(n, notice.pn.and_l(pn.ok(n), pn.all_ok(t), h))) : {No.total(_ <> No.rebuild(t)) == 1n+List.length(&2, No.N, t) : Nat}
      %pn.full(t, notice.pn.and_r(pn.ok(n), pn.all_ok(t), h)) : {1n+No.total(No.rebuild(t)) == 1n+_ : Nat}
      {==}

# the events, then the last event an attach
def pn.go_snoc(evs: List<&2, No.Ev>, +ns: List<&2, No.N>, +e: No.Ev) -> {No.go(List.append(&2, No.Ev, evs, [e]), ns) == No.step(No.go(evs, ns), e) : List<&2, No.N>}:
  match evs:
    case Nil{}:
      {==}
    case +h <> +t:
      pn.go_snoc(t, No.step(ns, h), e)

def pn.notice_per_restore(+evs: List<&2, No.Ev>) -> {No.total(No.run(List.append(&2, No.Ev, evs, [No.Reconnect{}]))) == No.restores(evs) : Nat}:
  +g = No.go(evs, Nil{})
  %Equal.sym(List<&2, No.N>, No.go(List.append(&2, No.Ev, evs, [No.Reconnect{}]), Nil{}), No.step(g, No.Reconnect{}), pn.go_snoc(evs, Nil{}, No.Reconnect{})) : {No.total(_) == No.restores(evs) : Nat}
  %Equal.sym(Nat, No.total(No.rebuild(g)), List.length(&2, No.N, g), pn.full(g, pn.ok_go(evs, Nil{}, {==}))) : {_ == No.restores(evs) : Nat}
  Equal.trans(Nat, List.length(&2, No.N, g), Nat.add(No.restores(evs), 0n), No.restores(evs), pn.len_go(evs, Nil{}), pn.add_zero(No.restores(evs)))

# ---- gateway_width ----

# The proofs of LAWS.bend section gateway_width (PROOF.bend delegates each law
# Laws.<law> to the def of the same name here): the model of
# bend/gateway_width.bend pads every cell to its column width, and an
# ASCII table measures the same by display width and by glyph count.

def gw.ND(n: Nat, A: Type) -> Type:
  match n:
    case 0n:
      A
    case 1n+p:
      Unit

# 1 + p is not 0
def gw.absurd(-A: Type, -p: Nat, e: {1n+p == 0n : Nat}) -> A:
  %e : gw.ND(_, A)
  Unit{}

# Arithmetic
# ----------
# `a <= b` is `Nat.sub(a, b) == 0n`, as the padding `w - c` reads it.

def gw.sub_self(a: Nat) -> {Nat.sub(a, a) == 0n : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      gw.sub_self(p)

def gw.sub_zero(a: Nat) -> {Nat.sub(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      {==}

def gw.add_zero(a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %gw.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def gw.add_succ(+a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %gw.add_succ(p, b) : {1n+Nat.add(p, 1n+b) == 1n+_ : Nat}
      {==}

# a <= max(a, b)
def gw.le_max_l(+a: Nat, +b: Nat) -> {Nat.sub(a, Nat.max(a, b)) == 0n : Nat}:
  match a b:
    case 0n _:
      {==}
    case 1n+ap 0n:
      gw.sub_self(ap)
    case 1n+ap 1n+bp:
      gw.le_max_l(ap, bp)

# b <= max(a, b)
def gw.le_max_r(+a: Nat, +b: Nat) -> {Nat.sub(b, Nat.max(a, b)) == 0n : Nat}:
  match a b:
    case 0n _:
      gw.sub_self(b)
    case 1n+ap 0n:
      {==}
    case 1n+ap 1n+bp:
      gw.le_max_r(ap, bp)

def gw.le_trans(a: Nat, b: Nat, c: Nat, h1: {Nat.sub(a, b) == 0n : Nat}, h2: {Nat.sub(b, c) == 0n : Nat}) -> {Nat.sub(a, c) == 0n : Nat}:
  match a b c:
    case 0n _ _:
      {==}
    case 1n+ap 0n _:
      gw.absurd({Nat.sub(1n+ap, c) == 0n : Nat}, ap, h1)
    case 1n+ap 1n+bp 0n:
      gw.absurd({Nat.sub(1n+ap, 0n) == 0n : Nat}, bp, h2)
    case 1n+ap 1n+bp 1n+cp:
      gw.le_trans(ap, bp, cp, h1, h2)

# a cell no wider than its column pads to the column width
def gw.pad_fits(c: Nat, w: Nat, h: {Nat.sub(c, w) == 0n : Nat}) -> {Gw.pad(c, w) == w : Nat}:
  match c w:
    case 0n _:
      gw.sub_zero(w)
    case 1n+cp 0n:
      gw.absurd({Gw.pad(1n+cp, 0n) == 0n : Nat}, cp, h)
    case 1n+cp 1n+wp:
      %gw.pad_fits(cp, wp, h) : {1n+Nat.add(cp, Nat.sub(wp, cp)) == 1n+_ : Nat}
      {==}

# The table
# ---------

# a cell of a row is no wider than its column
def gw.cell_fits(pre: List<&2, List<&2, List<&2, Nat>>>, +row: List<&2, List<&2, Nat>>, +post: List<&2, List<&2, List<&2, Nat>>>, +m: Gw.Measure, +i: Nat) -> {Nat.sub(Gw.get.w(row, m, i), Gw.col.w(List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), m, i)) == 0n : Nat}:
  match pre:
    case Nil{}:
      gw.le_max_l(Gw.get.w(row, m, i), Gw.col.w(post, m, i))
    case +r <> +rest:
      +tail = Gw.col.w(List.append(&2, List<&2, List<&2, Nat>>, rest, row <> post), m, i)
      gw.le_trans(Gw.get.w(row, m, i), tail, Nat.max(Gw.get.w(r, m, i), tail), gw.cell_fits(rest, row, post, m, i), gw.le_max_r(Gw.get.w(r, m, i), tail))

# a row from column i: the widths of k columns, then its own cell k + i
def gw.line_aligned(+k: Nat, +m: Gw.Measure, +pre: List<&2, List<&2, List<&2, Nat>>>, +row: List<&2, List<&2, Nat>>, +post: List<&2, List<&2, List<&2, Nat>>>, +i: Nat) -> {Gw.line(k, m, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), row, i) == List.append(&2, Nat, Gw.widths(k, m, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), i), [Gw.get.w(row, m, Nat.add(k, i))]) : List<&2, Nat>}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      +rows = List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post)
      +g = Gw.get.w(row, m, i)
      +c = Gw.col.w(rows, m, i)
      %Equal.sym(Nat, Gw.pad(g, c), c, gw.pad_fits(g, c, gw.cell_fits(pre, row, post, m, i))) : {_ <> Gw.line(p, m, rows, row, 1n+i) == c <> List.append(&2, Nat, Gw.widths(p, m, rows, 1n+i), [Gw.get.w(row, m, 1n+Nat.add(p, i))]) : List<&2, Nat>}
      %gw.add_succ(p, i) : {c <> Gw.line(p, m, rows, row, 1n+i) == c <> List.append(&2, Nat, Gw.widths(p, m, rows, 1n+i), [Gw.get.w(row, m, _)]) : List<&2, Nat>}
      %gw.line_aligned(p, m, pre, row, post, 1n+i) : {c <> Gw.line(p, m, rows, row, 1n+i) == c <> _ : List<&2, Nat>}
      {==}

def table_aligned(+pre: List<&2, List<&2, List<&2, Nat>>>, +row: List<&2, List<&2, Nat>>, +post: List<&2, List<&2, List<&2, Nat>>>) -> {Gw.line(Nat.sub(Gw.cols(List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post)), 1n), Gw.Display{}, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), row, 0n) == List.append(&2, Nat, Gw.widths(Nat.sub(Gw.cols(List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post)), 1n), Gw.Display{}, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), 0n), [Gw.get.w(row, Gw.Display{}, Nat.sub(Gw.cols(List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post)), 1n))]) : List<&2, Nat>}:
  +k = Nat.sub(Gw.cols(List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post)), 1n)
  %gw.add_zero(k) : {Gw.line(k, Gw.Display{}, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), row, 0n) == List.append(&2, Nat, Gw.widths(k, Gw.Display{}, List.append(&2, List<&2, List<&2, Nat>>, pre, row <> post), 0n), [Gw.get.w(row, Gw.Display{}, _)]) : List<&2, Nat>}
  gw.line_aligned(k, Gw.Display{}, pre, row, post, 0n)

# ASCII
# -----

def gw.cell_ascii(c: List<&2, Nat>, ones: Gw.Ones.cell(c)) -> {Gw.cell.sum(c) == List.length(&2, Nat, c) : Nat}:
  match c:
    case Nil{}:
      {==}
    case w <> rest:
      (one, more) = ones
      %Equal.sym(Nat, w, 1n, one) : {Nat.add(_, Gw.cell.sum(rest)) == 1n+List.length(&2, Nat, rest) : Nat}
      %gw.cell_ascii(rest, more) : {1n+Gw.cell.sum(rest) == 1n+_ : Nat}
      {==}

def gw.get_ascii(row: List<&2, List<&2, Nat>>, i: Nat, ones: Gw.Ones.row(row)) -> {Gw.get.w(row, Gw.Display{}, i) == Gw.get.w(row, Gw.Chars{}, i) : Nat}:
  match row:
    case Nil{}:
      {==}
    case c <> rest:
      match i:
        case 0n:
          (oc, orest) = ones
          gw.cell_ascii(c, oc)
        case 1n+p:
          (oc, orest) = ones
          gw.get_ascii(rest, p, orest)
def gw.col_ascii(rows: List<&2, List<&2, List<&2, Nat>>>, +i: Nat, ones: Gw.Ones.rows(rows)) -> {Gw.col.w(rows, Gw.Display{}, i) == Gw.col.w(rows, Gw.Chars{}, i) : Nat}:
  match rows:
    case Nil{}:
      {==}
    case r <> rest:
      (or, orest) = ones
      %gw.get_ascii(r, i, or) : {Nat.max(Gw.get.w(r, Gw.Display{}, i), Gw.col.w(rest, Gw.Display{}, i)) == Nat.max(_, Gw.col.w(rest, Gw.Chars{}, i)) : Nat}
      %gw.col_ascii(rest, i, orest) : {Nat.max(Gw.get.w(r, Gw.Display{}, i), Gw.col.w(rest, Gw.Display{}, i)) == Nat.max(Gw.get.w(r, Gw.Display{}, i), _) : Nat}
      {==}

def gw.line_ascii(+k: Nat, +rows: List<&2, List<&2, List<&2, Nat>>>, +row: List<&2, List<&2, Nat>>, +i: Nat, +orows: Gw.Ones.rows(rows), +orow: Gw.Ones.row(row)) -> {Gw.line(k, Gw.Display{}, rows, row, i) == Gw.line(k, Gw.Chars{}, rows, row, i) : List<&2, Nat>}:
  match k:
    case 0n:
      %gw.get_ascii(row, i, orow) : {[Gw.get.w(row, Gw.Display{}, i)] == [_] : List<&2, Nat>}
      {==}
    case 1n+p:
      %gw.get_ascii(row, i, orow) : {Gw.line(1n+p, Gw.Display{}, rows, row, i) == Gw.pad(_, Gw.col.w(rows, Gw.Chars{}, i)) <> Gw.line(p, Gw.Chars{}, rows, row, 1n+i) : List<&2, Nat>}
      %gw.col_ascii(rows, i, orows) : {Gw.line(1n+p, Gw.Display{}, rows, row, i) == Gw.pad(Gw.get.w(row, Gw.Display{}, i), _) <> Gw.line(p, Gw.Chars{}, rows, row, 1n+i) : List<&2, Nat>}
      %gw.line_ascii(p, rows, row, 1n+i, orows, orow) : {Gw.line(1n+p, Gw.Display{}, rows, row, i) == Gw.pad(Gw.get.w(row, Gw.Display{}, i), Gw.col.w(rows, Gw.Display{}, i)) <> _ : List<&2, Nat>}
      {==}

def gw.table_ascii(rs: List<&2, List<&2, List<&2, Nat>>>, +k: Nat, +rows: List<&2, List<&2, List<&2, Nat>>>, ors: Gw.Ones.rows(rs), +orows: Gw.Ones.rows(rows)) -> {Gw.table.go(rs, k, Gw.Display{}, rows) == Gw.table.go(rs, k, Gw.Chars{}, rows) : List<&2, List<&2, Nat>>}:
  match rs:
    case Nil{}:
      {==}
    case r <> rest:
      (or, orest) = ors
      %gw.line_ascii(k, rows, r, 0n, orows, or) : {Gw.line(k, Gw.Display{}, rows, r, 0n) <> Gw.table.go(rest, k, Gw.Display{}, rows) == _ <> Gw.table.go(rest, k, Gw.Chars{}, rows) : List<&2, List<&2, Nat>>}
      %gw.table_ascii(rest, k, rows, orest, orows) : {Gw.line(k, Gw.Display{}, rows, r, 0n) <> Gw.table.go(rest, k, Gw.Display{}, rows) == Gw.line(k, Gw.Display{}, rows, r, 0n) <> _ : List<&2, List<&2, Nat>>}
      {==}

def ascii_unchanged(+rows: List<&2, List<&2, List<&2, Nat>>>, +ones: Gw.Ones.rows(rows)) -> {Gw.table(Gw.Display{}, rows) == Gw.table(Gw.Chars{}, rows) : List<&2, List<&2, Nat>>}:
  gw.table_ascii(rows, Nat.sub(Gw.cols(rows), 1n), rows, ones, ones)

# ---- tui_color ----

# proof_tui_color: the T3 laws (docs/interface.md "Terminal colors") of
# the model in bend/tui_color.bend.
#
# The division takes n off x while n fits, so n times the quotient is at
# most x, and every q with n * q at most x is at most the quotient. So
# adding d to x never lowers the quotient, and raises it when d is at
# least n. A rung moves each channel from the last rung by such a step:
# the rising channels count the weight up, the falling ones count it
# down. So every channel moves toward the high end, and the widest
# channel, at least n wide, moves at each rung: a rung differs from all
# the rungs after it. A band is reached when w * num <= t * den; more
# tokens keep it reached, and a factor 1 + k on both t and w cancels.

# Logic
# -----

def pu.BD(+b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pu.absurd_ft(-A: Type, +e: {False{} == True{} : Bool}) -> A:
  %e : pu.BD(_, A, Unit)
  Unit{}

def pu.absurd_tf(-A: Type, +e: {True{} == False{} : Bool}) -> A:
  %e : pu.BD(_, Unit, A)
  Unit{}

def pu.and_t(+a: Bool, +b: Bool, +ha: {a == True{} : Bool}, +hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pu.and_l(+a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pu.absurd_ft({False{} == True{} : Bool}, h)

def pu.and_r(+a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pu.absurd_ft({b == True{} : Bool}, h)

# Numbers
# -------

def pu.le_zero(+n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pu.le_refl(+n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pu.le_refl(p)

def pu.le_trans(+a: Nat, +b: Nat, +c: Nat, +ab: {Nat.is_le(a, b) == True{} : Bool}, +bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n q r:
      pu.le_zero(r)
    case 1n+p 0n r:
      pu.absurd_ft({Nat.is_le(1n+p, r) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      pu.absurd_ft({False{} == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      pu.le_trans(p, q, r, ab, bc)

def pu.le_succ_r(+a: Nat, +b: Nat, +e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n q:
      {==}
    case 1n+p 0n:
      pu.absurd_ft({Nat.is_le(1n+p, 1n) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pu.le_succ_r(p, q, e)

def pu.lt_le(+a: Nat, +b: Nat, +e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n q:
      pu.le_zero(q)
    case 1n+p 0n:
      pu.absurd_ft({Nat.is_le(1n+p, 0n) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pu.lt_le(p, q, e)

def pu.lt_of_le_succ(+a: Nat, +b: Nat, +e: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Nat.is_lt(a, b) == True{} : Bool}:
  match a b:
    case p 0n:
      pu.absurd_ft({Nat.is_lt(p, 0n) == True{} : Bool}, e)
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      pu.lt_of_le_succ(p, q, e)

def pu.lt_zero_f(+q: Nat) -> {False{} == Nat.is_lt(q, 0n) : Bool}:
  match q:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pu.le_lt_trans(+a: Nat, +b: Nat, +c: Nat, +ab: {Nat.is_le(a, b) == True{} : Bool}, +bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  match a b c:
    case p q 0n:
      pu.absurd_ft({Nat.is_lt(p, 0n) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(q, 0n), True{}, pu.lt_zero_f(q), bc))
    case 0n q 1n+r:
      {==}
    case 1n+p 0n 1n+r:
      pu.absurd_ft({Nat.is_lt(1n+p, 1n+r) == True{} : Bool}, ab)
    case 1n+p 1n+q 1n+r:
      pu.le_lt_trans(p, q, r, ab, bc)

def pu.lt_ne(+a: Nat, +b: Nat, +e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      pu.absurd_ft({True{} == False{} : Bool}, e)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pu.lt_ne(p, q, e)

def pu.gt_ne(+a: Nat, +b: Nat, +e: {Nat.is_lt(b, a) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      pu.absurd_ft({True{} == False{} : Bool}, e)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pu.gt_ne(p, q, e)

# m <= n + m
def pu.le_add(+n: Nat, +m: Nat) -> {Nat.is_le(m, Nat.add(n, m)) == True{} : Bool}:
  match n:
    case 0n:
      pu.le_refl(m)
    case 1n+p:
      +q = p
      pu.le_succ_r(m, Nat.add(q, m), pu.le_add(q, m))

# a <= a + c
def pu.le_add_r(+a: Nat, +c: Nat) -> {Nat.is_le(a, Nat.add(a, c)) == True{} : Bool}:
  match a:
    case 0n:
      pu.le_zero(c)
    case 1n+p:
      pu.le_add_r(p, c)

def pu.le_add_l(+c: Nat, -x: Nat, -y: Nat, +e: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(Nat.add(c, x), Nat.add(c, y)) == True{} : Bool}:
  match c:
    case 0n:
      e
    case 1n+p:
      pu.le_add_l(p, x, y, e)

def pu.lt_add_l(+c: Nat, -x: Nat, -y: Nat, +e: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_lt(Nat.add(c, x), Nat.add(c, y)) == True{} : Bool}:
  match c:
    case 0n:
      e
    case 1n+p:
      pu.lt_add_l(p, x, y, e)

def pu.le_add_mono_r(+a: Nat, +b: Nat, +d: Nat, +e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.add(a, d), Nat.add(b, d)) == True{} : Bool}:
  match a b:
    case 0n q:
      pu.le_add(q, d)
    case 1n+p 0n:
      pu.absurd_ft({Nat.is_le(Nat.add(1n+p, d), Nat.add(0n, d)) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pu.le_add_mono_r(p, q, d, e)

def pu.le_add_both(+a: Nat, +b: Nat, +c: Nat, +d: Nat, +ab: {Nat.is_le(a, b) == True{} : Bool}, +cd: {Nat.is_le(c, d) == True{} : Bool}) -> {Nat.is_le(Nat.add(a, c), Nat.add(b, d)) == True{} : Bool}:
  pu.le_trans(Nat.add(a, c), Nat.add(a, d), Nat.add(b, d), pu.le_add_l(a, c, d, cd), pu.le_add_mono_r(a, b, d, ab))

# n + (x - n) = x when n <= x
def pu.sub_add(+n: Nat, +x: Nat, +e: {Nat.is_le(n, x) == True{} : Bool}) -> {Nat.add(n, Nat.sub(x, n)) == x : Nat}:
  match n x:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      pu.absurd_ft({Nat.add(1n+p, Nat.sub(0n, 1n+p)) == 0n : Nat}, e)
    case 1n+p 1n+q:
      %pu.sub_add(p, q, e) : {1n+Nat.add(p, Nat.sub(q, p)) == 1n+_ : Nat}
      {==}

# z <= x - n when n + z <= x
def pu.le_sub(+n: Nat, +z: Nat, +x: Nat, +e: {Nat.is_le(Nat.add(n, z), x) == True{} : Bool}) -> {Nat.is_le(z, Nat.sub(x, n)) == True{} : Bool}:
  match n x:
    case 0n 0n:
      e
    case 0n 1n+q:
      e
    case 1n+p 0n:
      pu.absurd_ft({Nat.is_le(z, Nat.sub(0n, 1n+p)) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pu.le_sub(p, z, q, e)

def pu.le_add_left(+n: Nat, +z: Nat, +x: Nat, +e: {Nat.is_le(Nat.add(n, z), x) == True{} : Bool}) -> {Nat.is_le(n, x) == True{} : Bool}:
  pu.le_trans(n, Nat.add(n, z), x, pu.le_add_r(n, z), e)

def pu.sub_le_self(+x: Nat, +n: Nat) -> {Nat.is_le(Nat.sub(x, n), x) == True{} : Bool}:
  match x n:
    case 0n q:
      {==}
    case 1n+p 0n:
      pu.le_refl(1n+p)
    case 1n+p 1n+q:
      pu.le_succ_r(Nat.sub(p, q), p, pu.sub_le_self(p, q))

# x - n <= f when x <= 1 + f and n >= 1
def pu.sub_fuel(+x: Nat, +f: Nat, +n: Nat, +ex: {Nat.is_le(x, 1n+f) == True{} : Bool}, +en: {Nat.is_le(1n, n) == True{} : Bool}) -> {Nat.is_le(Nat.sub(x, n), f) == True{} : Bool}:
  match x n:
    case p 0n:
      pu.absurd_ft({Nat.is_le(Nat.sub(p, 0n), f) == True{} : Bool}, en)
    case 0n 1n+q:
      pu.le_zero(f)
    case 1n+p 1n+q:
      pu.le_trans(Nat.sub(p, q), p, f, pu.sub_le_self(p, q), ex)

# Division
# --------

# n times the quotient is at most x
def pu.dv_low(+fuel: Nat, +ok: Bool, +x: Nat, +n: Nat, +eo: {Nat.is_le(n, x) == ok : Bool}) -> {Nat.is_le(Nat.mul(TC.dv.go(fuel, ok, x, n), n), x) == True{} : Bool}:
  match fuel:
    case 0n:
      pu.le_zero(x)
    case 1n+f:
      match ok:
        case True{}:
          +y = Nat.sub(x, n)
          +q = TC.dv.go(f, Nat.is_le(n, y), y, n)
          +ih = pu.dv_low(f, Nat.is_le(n, y), y, n, {==})
          %pu.sub_add(n, x, eo) : {Nat.is_le(Nat.add(n, Nat.mul(q, n)), _) == True{} : Bool}
          pu.le_add_l(n, Nat.mul(q, n), y, ih)
        case False{}:
          pu.le_zero(x)

# a q with n * q at most x is at most the quotient (n >= 1, x <= fuel)
def pu.dv_max(+fuel: Nat, +ok: Bool, +x: Nat, +n: Nat, +q: Nat, +eo: {Nat.is_le(n, x) == ok : Bool}, +ef: {Nat.is_le(x, fuel) == True{} : Bool}, +en: {Nat.is_le(1n, n) == True{} : Bool}, +eq: {Nat.is_le(Nat.mul(q, n), x) == True{} : Bool}) -> {Nat.is_le(q, TC.dv.go(fuel, ok, x, n)) == True{} : Bool}:
  match fuel:
    case 0n:
      match n:
        case 0n:
          match q:
            case 0n:
              {==}
            case 1n+r:
              pu.absurd_ft({Nat.is_le(1n+r, 0n) == True{} : Bool}, en)
        case 1n+m:
          match q:
            case 0n:
              {==}
            case 1n+r:
              pu.absurd_ft({Nat.is_le(1n+r, 0n) == True{} : Bool}, pu.le_trans(Nat.mul(1n+r, 1n+m), x, 0n, eq, ef))
    case 1n+f:
      match ok:
        case True{}:
          match q:
            case 0n:
              {==}
            case 1n+r:
              +y = Nat.sub(x, n)
              pu.dv_max(f, Nat.is_le(n, y), y, n, r, {==}, pu.sub_fuel(x, f, n, ef, en), en, pu.le_sub(n, Nat.mul(r, n), x, eq))
        case False{}:
          match q:
            case 0n:
              {==}
            case 1n+r:
              +fits = pu.le_add_left(n, Nat.mul(r, n), x, eq)
              pu.absurd_tf({Nat.is_le(1n+r, 0n) == True{} : Bool}, Equal.trans(Bool, True{}, Nat.is_le(n, x), False{}, Equal.sym(Bool, Nat.is_le(n, x), True{}, fits), eo))

# adding d never lowers the quotient
def pu.dv_le_add(+x: Nat, +d: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool}) -> {Nat.is_le(TC.dv(x, n), TC.dv(Nat.add(d, x), n)) == True{} : Bool}:
  +y = Nat.add(d, x)
  +q = TC.dv(x, n)
  +low = pu.le_trans(Nat.mul(q, n), x, y, pu.dv_low(x, Nat.is_le(n, x), x, n, {==}), pu.le_add(d, x))
  pu.dv_max(y, Nat.is_le(n, y), y, n, q, {==}, pu.le_refl(y), en, low)

# adding d >= n raises the quotient
def pu.dv_lt_add(+x: Nat, +d: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool}, +ed: {Nat.is_le(n, d) == True{} : Bool}) -> {Nat.is_lt(TC.dv(x, n), TC.dv(Nat.add(d, x), n)) == True{} : Bool}:
  +y = Nat.add(d, x)
  +q = TC.dv(x, n)
  +low = pu.le_add_both(n, d, Nat.mul(q, n), x, ed, pu.dv_low(x, Nat.is_le(n, x), x, n, {==}))
  pu.lt_of_le_succ(q, TC.dv(y, n), pu.dv_max(y, Nat.is_le(n, y), y, n, 1n+q, {==}, pu.le_refl(y), en, low))

# The effort ramp
# ---------------

# a channel never goes back from rung k to rung k + 1
def pu.chan_le(+u: Bool, +a: Nat, +b: Nat, +k: Nat, +l: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool})
  -> {TC.step.pick(u, TC.chan.pick(u, a, b, k, 1n+l, n), TC.chan.pick(u, a, b, 1n+k, l, n)) == True{} : Bool}:
  match u:
    case True{}:
      +d = Nat.sub(b, a)
      pu.le_add_l(a, TC.dv(Nat.mul(k, d), n), TC.dv(Nat.add(d, Nat.mul(k, d)), n), pu.dv_le_add(Nat.mul(k, d), d, n, en))
    case False{}:
      +d = Nat.sub(a, b)
      pu.le_add_l(b, TC.dv(Nat.mul(l, d), n), TC.dv(Nat.add(d, Nat.mul(l, d)), n), pu.dv_le_add(Nat.mul(l, d), d, n, en))

# x is strictly beyond y toward the high end
def pu.rel(u: Bool, +x: Nat, +y: Nat) -> Bool:
  match u:
    case True{}:
      Nat.is_lt(x, y)
    case False{}:
      Nat.is_lt(y, x)

# a channel at least n wide moves from rung k to rung k + 1
def pu.chan_lt(+u: Bool, +a: Nat, +b: Nat, +k: Nat, +l: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool}, +ed: {Nat.is_le(n, TC.gap.pick(u, a, b)) == True{} : Bool})
  -> {pu.rel(u, TC.chan.pick(u, a, b, k, 1n+l, n), TC.chan.pick(u, a, b, 1n+k, l, n)) == True{} : Bool}:
  match u:
    case True{}:
      +d = Nat.sub(b, a)
      pu.lt_add_l(a, TC.dv(Nat.mul(k, d), n), TC.dv(Nat.add(d, Nat.mul(k, d)), n), pu.dv_lt_add(Nat.mul(k, d), d, n, en, ed))
    case False{}:
      +d = Nat.sub(a, b)
      pu.lt_add_l(b, TC.dv(Nat.mul(l, d), n), TC.dv(Nat.add(d, Nat.mul(l, d)), n), pu.dv_lt_add(Nat.mul(l, d), d, n, en, ed))

# the rungs after rung done move every channel on from it
def pu.ordered_go(+left: Nat, +done: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool})
  -> {TC.ordered.from(TC.ramp.go(left, done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n), TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, done, left, n), TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}) == True{} : Bool}:
  match left:
    case 0n:
      {==}
    case 1n+l:
      +sr = pu.chan_le(Nat.is_le(lr, hr), lr, hr, done, l, n, en)
      +sg = pu.chan_le(Nat.is_le(lg, hg), lg, hg, done, l, n, en)
      +sb = pu.chan_le(Nat.is_le(lb, hb), lb, hb, done, l, n, en)
      +here = pu.and_t(TC.step(lr, hr, TC.chan(lr, hr, done, 1n+l, n), TC.chan(lr, hr, 1n+done, l, n)), Bool.and(TC.step(lg, hg, TC.chan(lg, hg, done, 1n+l, n), TC.chan(lg, hg, 1n+done, l, n)), TC.step(lb, hb, TC.chan(lb, hb, done, 1n+l, n), TC.chan(lb, hb, 1n+done, l, n))), sr, pu.and_t(TC.step(lg, hg, TC.chan(lg, hg, done, 1n+l, n), TC.chan(lg, hg, 1n+done, l, n)), TC.step(lb, hb, TC.chan(lb, hb, done, 1n+l, n), TC.chan(lb, hb, 1n+done, l, n)), sg, sb))
      +more = pu.ordered_go(l, 1n+done, lr, lg, lb, hr, hg, hb, n, en)
      pu.and_t(TC.moves(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, done, 1n+l, n), TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+done, l, n)), TC.ordered.from(TC.ramp.go(l, 1n+done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n), TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+done, l, n), TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}), here, more)

def tui_effort_ramp_ordered(+lo: TC.Px, +hi: TC.Px, +n: Nat) -> {TC.ordered(lo, hi, TC.ramp(lo, hi, n)) == True{} : Bool}:
  match lo hi n:
    case TC.Px{lr, lg, lb} TC.Px{hr, hg, hb} 0n:
      {==}
    case TC.Px{lr, lg, lb} TC.Px{hr, hg, hb} 1n+m:
      pu.ordered_go(m, 1n, lr, lg, lb, hr, hg, hb, 1n+m, pu.le_zero(m))

def pu.length_go(+left: Nat, +done: Nat, +lo: TC.Px, +hi: TC.Px, +n: Nat) -> {List.length(&2, TC.Px, TC.ramp.go(left, done, lo, hi, n)) == left : Nat}:
  match left:
    case 0n:
      {==}
    case 1n+l:
      %pu.length_go(l, 1n+done, lo, hi, n) : {1n+List.length(&2, TC.Px, TC.ramp.go(l, 1n+done, lo, hi, n)) == 1n+_ : Nat}
      {==}

def tui_effort_ramp_length(+lo: TC.Px, +hi: TC.Px, +n: Nat) -> {List.length(&2, TC.Px, TC.ramp(lo, hi, n)) == n : Nat}:
  pu.length_go(n, 0n, lo, hi, n)

type pu.Ch is Data:
  ChR{}
  ChG{}
  ChB{}

def pu.ch(c: pu.Ch, p: TC.Px) -> Nat:
  match c:
    case ChR{}:
      match p:
        case TC.Px{r, g, b}:
          r
    case ChG{}:
      match p:
        case TC.Px{r, g, b}:
          g
    case ChB{}:
      match p:
        case TC.Px{r, g, b}:
          b

# channel c of a rung is the ramp of channel c
def pu.rung_ch(+c: pu.Ch, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +wu: Nat, +wd: Nat, +n: Nat)
  -> {TC.chan(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}), wu, wd, n) == pu.ch(c, TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, wu, wd, n)) : Nat}:
  match c:
    case ChR{}:
      {==}
    case ChG{}:
      {==}
    case ChB{}:
      {==}

def pu.not_and_f(+a: Bool) -> {Bool.not(Bool.and(a, False{})) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pu.not_and2_f(+a: Bool, +b: Bool) -> {Bool.not(Bool.and(a, Bool.and(b, False{}))) == True{} : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} y:
      {==}

# two colors that differ in one channel differ
def pu.ne_px(+c: pu.Ch, +x: TC.Px, +y: TC.Px, +h: {Nat.is_eq(pu.ch(c, x), pu.ch(c, y)) == False{} : Bool}) -> {Bool.not(TC.px.eq(x, y)) == True{} : Bool}:
  match c x y:
    case ChR{} TC.Px{xr, xg, xb} TC.Px{yr, yg, yb}:
      %Equal.sym(Bool, Nat.is_eq(xr, yr), False{}, h) : {Bool.not(Bool.and(_, Bool.and(Nat.is_eq(xg, yg), Nat.is_eq(xb, yb)))) == True{} : Bool}
      {==}
    case ChG{} TC.Px{xr, xg, xb} TC.Px{yr, yg, yb}:
      %Equal.sym(Bool, Nat.is_eq(xg, yg), False{}, h) : {Bool.not(Bool.and(Nat.is_eq(xr, yr), Bool.and(_, Nat.is_eq(xb, yb)))) == True{} : Bool}
      pu.not_and_f(Nat.is_eq(xr, yr))
    case ChB{} TC.Px{xr, xg, xb} TC.Px{yr, yg, yb}:
      %Equal.sym(Bool, Nat.is_eq(xb, yb), False{}, h) : {Bool.not(Bool.and(Nat.is_eq(xr, yr), Bool.and(Nat.is_eq(xg, yg), _))) == True{} : Bool}
      pu.not_and2_f(Nat.is_eq(xr, yr), Nat.is_eq(xg, yg))

def pu.le_succ_of_lt(+a: Nat, +b: Nat, +e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(1n+a, b) == True{} : Bool}:
  match a b:
    case p 0n:
      pu.absurd_ft({Nat.is_le(1n+p, 0n) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(p, 0n), True{}, pu.lt_zero_f(p), e))
    case 0n 1n+q:
      pu.le_zero(q)
    case 1n+p 1n+q:
      pu.le_succ_of_lt(p, q, e)

def pu.lt_le_trans(+a: Nat, +b: Nat, +c: Nat, +ab: {Nat.is_lt(a, b) == True{} : Bool}, +bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  pu.lt_of_le_succ(a, c, pu.le_trans(1n+a, b, c, pu.le_succ_of_lt(a, b, ab), bc))

def pu.rel_trans(+u: Bool, +p: Nat, +q: Nat, +r: Nat, +h1: {TC.step.pick(u, p, q) == True{} : Bool}, +h2: {pu.rel(u, q, r) == True{} : Bool}) -> {pu.rel(u, p, r) == True{} : Bool}:
  match u:
    case True{}:
      pu.le_lt_trans(p, q, r, h1, h2)
    case False{}:
      pu.lt_le_trans(r, q, p, h2, h1)

def pu.rel_ne(+u: Bool, +p: Nat, +r: Nat, +h: {pu.rel(u, p, r) == True{} : Bool}) -> {Nat.is_eq(p, r) == False{} : Bool}:
  match u:
    case True{}:
      pu.lt_ne(p, r, h)
    case False{}:
      pu.gt_ne(p, r, h)

def pu.rel_step(+u: Bool, +p: Nat, +r: Nat, +h: {pu.rel(u, p, r) == True{} : Bool}) -> {TC.step.pick(u, p, r) == True{} : Bool}:
  match u:
    case True{}:
      pu.lt_le(p, r, h)
    case False{}:
      pu.lt_le(r, p, h)

def pu.step_refl(+u: Bool, +p: Nat) -> {TC.step.pick(u, p, p) == True{} : Bool}:
  match u:
    case True{}:
      pu.le_refl(p)
    case False{}:
      pu.le_refl(p)

# a color at or behind rung done in a channel at least n wide is none of
# the rungs after it
def pu.notin_go(+c: pu.Ch, +left: Nat, +done: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +n: Nat, +x: TC.Px, +en: {Nat.is_le(1n, n) == True{} : Bool}, +ed: {Nat.is_le(n, TC.gap(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}))) == True{} : Bool}, +h: {TC.step(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}), pu.ch(c, x), TC.chan(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}), done, left, n)) == True{} : Bool})
  -> {TC.notin(x, TC.ramp.go(left, done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n)) == True{} : Bool}:
  match left:
    case 0n:
      {==}
    case 1n+l:
      +a = pu.ch(c, TC.Px{lr, lg, lb})
      +b = pu.ch(c, TC.Px{hr, hg, hb})
      +u = Nat.is_le(a, b)
      +y = TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+done, l, n)
      +next = TC.chan(a, b, 1n+done, l, n)
      +moved = pu.rel_trans(u, pu.ch(c, x), TC.chan(a, b, done, 1n+l, n), next, h, pu.chan_lt(u, a, b, done, l, n, en, ed))
      +ne = pu.rel_ne(u, pu.ch(c, x), next, moved)
      +ney = {%pu.rung_ch(c, lr, lg, lb, hr, hg, hb, 1n+done, l, n) : {Nat.is_eq(pu.ch(c, x), _) == False{} : Bool}; ne : {Nat.is_eq(pu.ch(c, x), pu.ch(c, y)) == False{} : Bool}}
      +more = pu.notin_go(c, l, 1n+done, lr, lg, lb, hr, hg, hb, n, x, en, ed, pu.rel_step(u, pu.ch(c, x), next, moved))
      pu.and_t(Bool.not(TC.px.eq(x, y)), TC.notin(x, TC.ramp.go(l, 1n+done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n)), pu.ne_px(c, x, y, ney), more)

# the rungs after rung done are distinct in a channel at least n wide
def pu.distinct_go(+c: pu.Ch, +left: Nat, +done: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +n: Nat, +en: {Nat.is_le(1n, n) == True{} : Bool}, +ed: {Nat.is_le(n, TC.gap(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}))) == True{} : Bool})
  -> {TC.distinct(TC.ramp.go(left, done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n)) == True{} : Bool}:
  match left:
    case 0n:
      {==}
    case 1n+l:
      +a = pu.ch(c, TC.Px{lr, lg, lb})
      +b = pu.ch(c, TC.Px{hr, hg, hb})
      +y = TC.rung(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+done, l, n)
      +next = TC.chan(a, b, 1n+done, l, n)
      +at = {%pu.rung_ch(c, lr, lg, lb, hr, hg, hb, 1n+done, l, n) : {TC.step(a, b, _, next) == True{} : Bool}; pu.step_refl(Nat.is_le(a, b), next) : {TC.step(a, b, pu.ch(c, y), next) == True{} : Bool}}
      +first = pu.notin_go(c, l, 1n+done, lr, lg, lb, hr, hg, hb, n, y, en, ed, at)
      +more = pu.distinct_go(c, l, 1n+done, lr, lg, lb, hr, hg, hb, n, en, ed)
      pu.and_t(TC.notin(y, TC.ramp.go(l, 1n+done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n)), TC.distinct(TC.ramp.go(l, 1n+done, TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, n)), first, more)

# n at most the larger of a and b is at most one of them
def pu.max_or(+n: Nat, +a: Nat, +b: Nat, +h: {Nat.is_le(n, Nat.max(a, b)) == True{} : Bool}) -> {Bool.or(Nat.is_le(n, a), Nat.is_le(n, b)) == True{} : Bool}:
  match n a b:
    case 0n p q:
      %Equal.sym(Bool, Nat.is_le(0n, p), True{}, pu.le_zero(p)) : {Bool.or(_, Nat.is_le(0n, q)) == True{} : Bool}
      {==}
    case 1n+m 0n q:
      h
    case 1n+m 1n+p 0n:
      %Equal.sym(Bool, Nat.is_le(1n+m, 1n+p), True{}, h) : {Bool.or(_, Nat.is_le(1n+m, 0n)) == True{} : Bool}
      {==}
    case 1n+m 1n+p 1n+q:
      pu.max_or(m, p, q, h)

def pu.distinct_by(+c: pu.Ch, +m: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +ed: {Nat.is_le(1n+m, TC.gap(pu.ch(c, TC.Px{lr, lg, lb}), pu.ch(c, TC.Px{hr, hg, hb}))) == True{} : Bool})
  -> {TC.distinct(TC.ramp(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+m)) == True{} : Bool}:
  pu.distinct_go(c, 1n+m, 0n, lr, lg, lb, hr, hg, hb, 1n+m, pu.le_zero(m), ed)

def pu.distinct_gb(+xg: Bool, +m: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +eg: {Nat.is_le(1n+m, TC.gap(lg, hg)) == xg : Bool}, +h: {Bool.or(xg, Nat.is_le(1n+m, TC.gap(lb, hb))) == True{} : Bool})
  -> {TC.distinct(TC.ramp(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+m)) == True{} : Bool}:
  match xg:
    case True{}:
      pu.distinct_by(ChG{}, m, lr, lg, lb, hr, hg, hb, eg)
    case False{}:
      pu.distinct_by(ChB{}, m, lr, lg, lb, hr, hg, hb, h)

def pu.distinct_rgb(+xr: Bool, +m: Nat, +lr: Nat, +lg: Nat, +lb: Nat, +hr: Nat, +hg: Nat, +hb: Nat, +er: {Nat.is_le(1n+m, TC.gap(lr, hr)) == xr : Bool}, +h: {Bool.or(xr, Nat.is_le(1n+m, Nat.max(TC.gap(lg, hg), TC.gap(lb, hb)))) == True{} : Bool})
  -> {TC.distinct(TC.ramp(TC.Px{lr, lg, lb}, TC.Px{hr, hg, hb}, 1n+m)) == True{} : Bool}:
  match xr:
    case True{}:
      pu.distinct_by(ChR{}, m, lr, lg, lb, hr, hg, hb, er)
    case False{}:
      pu.distinct_gb(Nat.is_le(1n+m, TC.gap(lg, hg)), m, lr, lg, lb, hr, hg, hb, {==}, pu.max_or(1n+m, TC.gap(lg, hg), TC.gap(lb, hb), h))

def tui_effort_ramp_distinct(+lo: TC.Px, +hi: TC.Px, +n: Nat, +fits: {Nat.is_le(n, TC.span(lo, hi)) == True{} : Bool}) -> {TC.distinct(TC.ramp(lo, hi, n)) == True{} : Bool}:
  match lo hi n:
    case TC.Px{lr, lg, lb} TC.Px{hr, hg, hb} 0n:
      {==}
    case TC.Px{lr, lg, lb} TC.Px{hr, hg, hb} 1n+m:
      +wide = pu.max_or(1n+m, TC.gap(lr, hr), Nat.max(TC.gap(lg, hg), TC.gap(lb, hb)), fits)
      pu.distinct_rgb(Nat.is_le(1n+m, TC.gap(lr, hr)), m, lr, lg, lb, hr, hg, hb, {==}, wide)

# every shipped ramp is wider than the longest ladder
def pu.shipped_wide(s: T.Shipped) -> {Nat.is_le(TC.ladder.max(), TC.span(TC.shipped.lo(s), TC.shipped.hi(s))) == True{} : Bool}:
  match s:
    case T.Eukhe{}:
      {==}
    case T.Dark{}:
      {==}
    case T.Light{}:
      {==}

def tui_effort_shipped_distinct(+s: T.Shipped, +n: Nat, +fits: {Nat.is_le(n, TC.ladder.max()) == True{} : Bool}) -> {TC.distinct(TC.ramp(TC.shipped.lo(s), TC.shipped.hi(s), n)) == True{} : Bool}:
  +lo = TC.shipped.lo(s)
  +hi = TC.shipped.hi(s)
  tui_effort_ramp_distinct(lo, hi, n, pu.le_trans(n, TC.ladder.max(), TC.span(lo, hi), fits, pu.shipped_wide(s)))

# The usage bands
# ---------------

def tui_usage_bands_ascend() -> {TC.ascend(TC.bands()) == True{} : Bool}:
  {==}

# t * den <= (t + e) * den
def pu.mul_le_add(+t: Nat, +e: Nat, +den: Nat) -> {Nat.is_le(Nat.mul(t, den), Nat.mul(Nat.add(t, e), den)) == True{} : Bool}:
  match t:
    case 0n:
      pu.le_zero(Nat.mul(e, den))
    case 1n+p:
      pu.le_add_l(den, Nat.mul(p, den), Nat.mul(Nat.add(p, e), den), pu.mul_le_add(p, e, den))

def pu.one_and(+p: Bool, +x: Bool, +y: Bool, hxy: {x == True{} : Bool} -> {y == True{} : Bool}) -> {Nat.is_le(TC.one(Bool.and(p, x)), TC.one(Bool.and(p, y))) == True{} : Bool}:
  match p:
    case False{}:
      {==}
    case True{}:
      match x:
        case True{}:
          %Equal.sym(Bool, y, True{}, hxy({==})) : {Nat.is_le(1n, TC.one(_)) == True{} : Bool}
          {==}
        case False{}:
          pu.le_zero(TC.one(y))

# a band reached by t tokens stays reached by t + e
def pu.reach_mono(+f: TC.Frac, +t: Nat, +e: Nat, +w: Nat) -> {Nat.is_le(TC.one(TC.reached(f, t, w)), TC.one(TC.reached(f, Nat.add(t, e), w))) == True{} : Bool}:
  match f:
    case TC.Frac{num, den}:
      +lhs = Nat.mul(w, num)
      pu.one_and(Nat.is_lt(0n, w), Nat.is_le(lhs, Nat.mul(t, den)), Nat.is_le(lhs, Nat.mul(Nat.add(t, e), den)), ex => pu.le_trans(lhs, Nat.mul(t, den), Nat.mul(Nat.add(t, e), den), ex, pu.mul_le_add(t, e, den)))

def pu.band_mono(+fs: List<&2, TC.Frac>, +t: Nat, +e: Nat, +w: Nat) -> {Nat.is_le(TC.band.go(fs, t, w), TC.band.go(fs, Nat.add(t, e), w)) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case Con{+f, rest}:
      pu.le_add_both(TC.one(TC.reached(f, t, w)), TC.one(TC.reached(f, Nat.add(t, e), w)), TC.band.go(rest, t, w), TC.band.go(rest, Nat.add(t, e), w), pu.reach_mono(f, t, e, w), pu.band_mono(rest, t, e, w))

def tui_usage_band_monotone(+t: Nat, +e: Nat, +w: Nat) -> {Nat.is_le(TC.band(t, w), TC.band(Nat.add(t, e), w)) == True{} : Bool}:
  pu.band_mono(TC.bands(), t, e, w)

def pu.add_assoc(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pu.add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

def pu.mul_add_r(+x: Nat, +y: Nat, +c: Nat) -> {Nat.mul(Nat.add(x, y), c) == Nat.add(Nat.mul(x, c), Nat.mul(y, c)) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, Nat.mul(Nat.add(p, y), c), Nat.add(Nat.mul(p, c), Nat.mul(y, c)), pu.mul_add_r(p, y, c)) : {Nat.add(c, _) == Nat.add(Nat.add(c, Nat.mul(p, c)), Nat.mul(y, c)) : Nat}
      Equal.sym(Nat, Nat.add(Nat.add(c, Nat.mul(p, c)), Nat.mul(y, c)), Nat.add(c, Nat.add(Nat.mul(p, c), Nat.mul(y, c))), pu.add_assoc(c, Nat.mul(p, c), Nat.mul(y, c)))

def pu.mul_assoc(+a: Nat, +b: Nat, +c: Nat) -> {Nat.mul(Nat.mul(a, b), c) == Nat.mul(a, Nat.mul(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, Nat.mul(Nat.add(b, Nat.mul(p, b)), c), Nat.add(Nat.mul(b, c), Nat.mul(Nat.mul(p, b), c)), pu.mul_add_r(b, Nat.mul(p, b), c)) : {_ == Nat.add(Nat.mul(b, c), Nat.mul(p, Nat.mul(b, c))) : Nat}
      %pu.mul_assoc(p, b, c) : {Nat.add(Nat.mul(b, c), Nat.mul(Nat.mul(p, b), c)) == Nat.add(Nat.mul(b, c), _) : Nat}
      {==}

def pu.mul_zero_r(+k: Nat) -> {Nat.mul(k, 0n) == 0n : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pu.mul_zero_r(p)

def pu.pos(+k: Nat, +w: Nat) -> {Nat.is_lt(0n, Nat.mul(1n+k, w)) == Nat.is_lt(0n, w) : Bool}:
  match w:
    case 0n:
      %Equal.sym(Nat, Nat.mul(k, 0n), 0n, pu.mul_zero_r(k)) : {Nat.is_lt(0n, _) == Nat.is_lt(0n, 0n) : Bool}
      {==}
    case 1n+v:
      {==}

def pu.mul_le_mono_r(+k: Nat, +x: Nat, +y: Nat, +h: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(Nat.mul(k, x), Nat.mul(k, y)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pu.le_add_both(x, y, Nat.mul(p, x), Nat.mul(p, y), h, pu.mul_le_mono_r(p, x, y, h))

def pu.lt_add_both(+a: Nat, +b: Nat, +c: Nat, +d: Nat, +ab: {Nat.is_lt(a, b) == True{} : Bool}, +cd: {Nat.is_le(c, d) == True{} : Bool}) -> {Nat.is_lt(Nat.add(a, c), Nat.add(b, d)) == True{} : Bool}:
  pu.lt_of_le_succ(Nat.add(a, c), Nat.add(b, d), pu.le_add_both(1n+a, b, c, d, pu.le_succ_of_lt(a, b, ab), cd))

def pu.mul_lt_mono(+k: Nat, +x: Nat, +y: Nat, +h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_lt(Nat.mul(1n+k, x), Nat.mul(1n+k, y)) == True{} : Bool}:
  pu.lt_add_both(x, y, Nat.mul(k, x), Nat.mul(k, y), h, pu.mul_le_mono_r(k, x, y, pu.lt_le(x, y, h)))

def pu.not_le_lt(+x: Nat, +y: Nat, +h: {Nat.is_le(x, y) == False{} : Bool}) -> {Nat.is_lt(y, x) == True{} : Bool}:
  match x y:
    case 0n 0n:
      pu.absurd_tf({Nat.is_lt(0n, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      pu.absurd_tf({Nat.is_lt(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pu.not_le_lt(p, q, h)

def pu.lt_not_le(+a: Nat, +b: Nat, +e: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_le(b, a) == False{} : Bool}:
  match a b:
    case 0n 0n:
      pu.absurd_ft({True{} == False{} : Bool}, e)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      pu.absurd_ft({True{} == False{} : Bool}, e)
    case 1n+p 1n+q:
      pu.lt_not_le(p, q, e)

def pu.cancel.pick(+b: Bool, +k: Nat, +x: Nat, +y: Nat, +eb: {Nat.is_le(x, y) == b : Bool}) -> {Nat.is_le(Nat.mul(1n+k, x), Nat.mul(1n+k, y)) == b : Bool}:
  match b:
    case True{}:
      pu.mul_le_mono_r(1n+k, x, y, eb)
    case False{}:
      pu.lt_not_le(Nat.mul(1n+k, y), Nat.mul(1n+k, x), pu.mul_lt_mono(k, y, x, pu.not_le_lt(x, y, eb)))

# a factor 1 + k on both sides of <= cancels
def pu.cancel(+k: Nat, +x: Nat, +y: Nat) -> {Nat.is_le(Nat.mul(1n+k, x), Nat.mul(1n+k, y)) == Nat.is_le(x, y) : Bool}:
  pu.cancel.pick(Nat.is_le(x, y), k, x, y, {==})

# a band is reached by the same fraction of any window
def pu.reach_scale(+f: TC.Frac, +k: Nat, +t: Nat, +w: Nat) -> {TC.reached(f, Nat.mul(1n+k, t), Nat.mul(1n+k, w)) == TC.reached(f, t, w) : Bool}:
  match f:
    case TC.Frac{num, den}:
      +kk = {1n+k : Nat}
      +rhs = Bool.and(Nat.is_lt(0n, w), Nat.is_le(Nat.mul(w, num), Nat.mul(t, den)))
      %Equal.sym(Bool, Nat.is_lt(0n, Nat.mul(kk, w)), Nat.is_lt(0n, w), pu.pos(k, w)) : {Bool.and(_, Nat.is_le(Nat.mul(Nat.mul(kk, w), num), Nat.mul(Nat.mul(kk, t), den))) == rhs : Bool}
      %Equal.sym(Nat, Nat.mul(Nat.mul(kk, w), num), Nat.mul(kk, Nat.mul(w, num)), pu.mul_assoc(kk, w, num)) : {Bool.and(Nat.is_lt(0n, w), Nat.is_le(_, Nat.mul(Nat.mul(kk, t), den))) == rhs : Bool}
      %Equal.sym(Nat, Nat.mul(Nat.mul(kk, t), den), Nat.mul(kk, Nat.mul(t, den)), pu.mul_assoc(kk, t, den)) : {Bool.and(Nat.is_lt(0n, w), Nat.is_le(Nat.mul(kk, Nat.mul(w, num)), _)) == rhs : Bool}
      %Equal.sym(Bool, Nat.is_le(Nat.mul(kk, Nat.mul(w, num)), Nat.mul(kk, Nat.mul(t, den))), Nat.is_le(Nat.mul(w, num), Nat.mul(t, den)), pu.cancel(k, Nat.mul(w, num), Nat.mul(t, den))) : {Bool.and(Nat.is_lt(0n, w), _) == rhs : Bool}
      {==}

def pu.band_scale(+fs: List<&2, TC.Frac>, +k: Nat, +t: Nat, +w: Nat) -> {TC.band.go(fs, Nat.mul(1n+k, t), Nat.mul(1n+k, w)) == TC.band.go(fs, t, w) : Nat}:
  match fs:
    case Nil{}:
      {==}
    case Con{+f, rest}:
      +kt = Nat.mul(1n+k, t)
      +kw = Nat.mul(1n+k, w)
      %pu.band_scale(rest, k, t, w) : {Nat.add(TC.one(TC.reached(f, kt, kw)), TC.band.go(rest, kt, kw)) == Nat.add(TC.one(TC.reached(f, t, w)), _) : Nat}
      %pu.reach_scale(f, k, t, w) : {Nat.add(TC.one(TC.reached(f, kt, kw)), TC.band.go(rest, kt, kw)) == Nat.add(TC.one(_), TC.band.go(rest, kt, kw)) : Nat}
      {==}

def tui_usage_band_fraction(+k: Nat, +t: Nat, +w: Nat) -> {TC.band(Nat.mul(1n+k, t), Nat.mul(1n+k, w)) == TC.band(t, w) : Nat}:
  pu.band_scale(TC.bands(), k, t, w)

# The roles
# ---------

def pu.fill_len(+cols: List<&2, T.Ent>, +bg: Co.Rgb, +ts: List<&2, U32>) -> {List.length(&2, Maybe<&2, T.Val>, T.fill.map(cols, bg, ts)) == List.length(&2, U32, ts) : Nat}:
  match ts:
    case Nil{}:
      {==}
    case Con{t, rest}:
      %pu.fill_len(cols, bg, rest) : {1n+List.length(&2, Maybe<&2, T.Val>, T.fill.map(cols, bg, rest)) == 1n+_ : Nat}
      {==}

def pu.all_lt(rs: List<&2, Nat>, +n: Nat) -> Bool:
  match rs:
    case Nil{}:
      True{}
    case Con{r, rest}:
      Bool.and(Nat.is_lt(r, n), pu.all_lt(rest, n))

# a complete palette has a value at every index below its length
def pu.get_found(+p: List<&2, Maybe<&2, T.Val>>, +r: Nat, +hc: {T.complete(p) == True{} : Bool}, +hl: {Nat.is_lt(r, List.length(&2, Maybe<&2, T.Val>, p)) == True{} : Bool})
  -> {TC.found(T.Val, List.get(&2, Maybe<&2, T.Val>, p, r)) == True{} : Bool}:
  match p r:
    case Nil{} q:
      pu.absurd_ft({TC.found(T.Val, List.get(&2, Maybe<&2, T.Val>, Nil{}, q)) == True{} : Bool}, Equal.trans(Bool, False{}, Nat.is_lt(q, 0n), True{}, pu.lt_zero_f(q), hl))
    case Con{+v, +rest} 0n:
      pu.and_l(Maybe.is_some(&2, T.Val, v), T.complete(rest), hc)
    case Con{+v, +rest} 1n+q:
      pu.get_found(rest, q, pu.and_r(Maybe.is_some(&2, T.Val, v), T.complete(rest), hc), hl)

def pu.resolves_go(+p: List<&2, Maybe<&2, T.Val>>, +rs: List<&2, Nat>, +hc: {T.complete(p) == True{} : Bool}, +hl: {pu.all_lt(rs, List.length(&2, Maybe<&2, T.Val>, p)) == True{} : Bool})
  -> {TC.resolves(p, rs) == True{} : Bool}:
  match rs:
    case Nil{}:
      {==}
    case Con{+r, +rest}:
      +len = List.length(&2, Maybe<&2, T.Val>, p)
      +here = pu.get_found(p, r, hc, pu.and_l(Nat.is_lt(r, len), pu.all_lt(rest, len), hl))
      +more = pu.resolves_go(p, rest, hc, pu.and_r(Nat.is_lt(r, len), pu.all_lt(rest, len), hl))
      pu.and_t(TC.found(T.Val, List.get(&2, Maybe<&2, T.Val>, p, r)), TC.resolves(p, rest), here, more)

def tui_roles_resolve(+f: T.Th, +v: {T.valid(f) == True{} : Bool}) -> {TC.resolves(T.palette(f), TC.roles()) == True{} : Bool}:
  match f:
    case T.Th{name, cols, page}:
      +bg = T.background(cols, page)
      +p = T.fill.map(cols, bg, T.toks())
      +hc = theme_tokens_complete(T.Th{name, cols, page}, v)
      +hl = {%Equal.sym(Nat, List.length(&2, Maybe<&2, T.Val>, p), List.length(&2, U32, T.toks()), pu.fill_len(cols, bg, T.toks())) : {pu.all_lt(TC.roles(), _) == True{} : Bool}; {==} : {pu.all_lt(TC.roles(), List.length(&2, Maybe<&2, T.Val>, p)) == True{} : Bool}}
      pu.resolves_go(p, TC.roles(), hc, hl)

def tui_roles_shipped(s: T.Shipped) -> {TC.paints(T.table(s), TC.roles()) == True{} : Bool}:
  match s:
    case T.Eukhe{}:
      {==}
    case T.Dark{}:
      {==}
    case T.Light{}:
      {==}

# ---- fsmode ----

# proof_fsmode: the laws of LAWS.bend section fsmode over the model in
# bend/fsmode.bend. Each decision is a match on its inputs, so each law
# follows by case analysis; a clash of two constructors is refuted with a
# motive that sends the expected constructor to the goal and the others
# to Unit.

# Clashes
# -------

def pf.VD(v: Fs.Verdict, A: Type) -> Type:
  match v:
    case Fs.Create{m}:
      Unit
    case Fs.Use{}:
      A
    case Fs.Refuse{}:
      Unit

def pf.refuse_use(-A: Type, e: {Fs.Refuse{} == Fs.Use{} : Fs.Verdict}) -> A:
  %e : pf.VD(_, A)
  Unit{}

def pf.create_use(-A: Type, +m: Fs.Mode, e: {Fs.Create{m} == Fs.Use{} : Fs.Verdict}) -> A:
  %e : pf.VD(_, A)
  Unit{}

def pf.PD(v: Fs.Peer, A: Type) -> Type:
  match v:
    case Fs.Accept{}:
      A
    case Fs.Drop{}:
      Unit

def pf.drop_accept(-A: Type, e: {Fs.Drop{} == Fs.Accept{} : Fs.Peer}) -> A:
  %e : pf.PD(_, A)
  Unit{}

def pf.OD(v: Fs.Open, A: Type) -> Type:
  match v:
    case Fs.Opened{p}:
      A
    case Fs.NeedsCwd{}:
      Unit
    case Fs.Gone{p}:
      Unit
    case Fs.NotDir{p}:
      Unit

def pf.needs_opened(-A: Type, +p: Nat, e: {Fs.NeedsCwd{} == Fs.Opened{p} : Fs.Open}) -> A:
  %e : pf.OD(_, A)
  Unit{}

def pf.gone_opened(-A: Type, +q: Nat, +p: Nat, e: {Fs.Gone{q} == Fs.Opened{p} : Fs.Open}) -> A:
  %e : pf.OD(_, A)
  Unit{}

def pf.notdir_opened(-A: Type, +q: Nat, +p: Nat, e: {Fs.NotDir{q} == Fs.Opened{p} : Fs.Open}) -> A:
  %e : pf.OD(_, A)
  Unit{}

def fsmode.pf.BD(b: Bool, A: Type) -> Type:
  match b:
    case True{}:
      A
    case False{}:
      Unit

def fsmode.pf.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : fsmode.pf.BD(_, A)
  Unit{}

# Numbers
# -------

def pf.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pf.eq_refl(p)

def pf.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      fsmode.pf.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      fsmode.pf.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pf.eq_true(p, q, h))

# The socket dir
# --------------

def pf.dir_owned(mine: Bool, loose: Bool, used: {Fs.socket_dir.dir(mine, loose) == Fs.Use{} : Fs.Verdict}) -> {Bool.and(mine, Bool.not(loose)) == True{} : Bool}:
  match mine loose:
    case True{} False{}:
      {==}
    case True{} True{}:
      pf.refuse_use({Bool.and(True{}, Bool.not(True{})) == True{} : Bool}, used)
    case False{} l:
      pf.refuse_use({Bool.and(False{}, Bool.not(l)) == True{} : Bool}, used)

def owned(d: Fs.Seen, used: {Fs.socket_dir(d) == Fs.Use{} : Fs.Verdict}) -> {Fs.Seen.safe(d) == True{} : Bool}:
  match d:
    case Fs.Seen{k, mine, loose}:
      match k:
        case Fs.Missing{}:
          pf.create_use({Fs.Seen.safe(Fs.Seen{Fs.Missing{}, mine, loose}) == True{} : Bool}, Fs.dir_mode(), used)
        case Fs.Dir{}:
          pf.dir_owned(mine, loose, used)
        case Fs.Link{}:
          pf.refuse_use({Fs.Seen.safe(Fs.Seen{Fs.Link{}, mine, loose}) == True{} : Bool}, used)
        case Fs.Other{}:
          pf.refuse_use({Fs.Seen.safe(Fs.Seen{Fs.Other{}, mine, loose}) == True{} : Bool}, used)

def pf.dir_progress(mine: Bool, loose: Bool, safe: {Bool.and(mine, Bool.not(loose)) == True{} : Bool}) -> {Fs.socket_dir.dir(mine, loose) == Fs.Use{} : Fs.Verdict}:
  match mine loose:
    case True{} False{}:
      {==}
    case True{} True{}:
      fsmode.pf.absurdF({Fs.socket_dir.dir(True{}, True{}) == Fs.Use{} : Fs.Verdict}, safe)
    case False{} l:
      fsmode.pf.absurdF({Fs.socket_dir.dir(False{}, l) == Fs.Use{} : Fs.Verdict}, safe)

def progress(d: Fs.Seen, safe: {Fs.Seen.safe(d) == True{} : Bool}) -> {Fs.socket_dir(d) == Fs.Use{} : Fs.Verdict}:
  match d:
    case Fs.Seen{k, mine, loose}:
      match k:
        case Fs.Missing{}:
          fsmode.pf.absurdF({Fs.socket_dir(Fs.Seen{Fs.Missing{}, mine, loose}) == Fs.Use{} : Fs.Verdict}, safe)
        case Fs.Dir{}:
          pf.dir_progress(mine, loose, safe)
        case Fs.Link{}:
          fsmode.pf.absurdF({Fs.socket_dir(Fs.Seen{Fs.Link{}, mine, loose}) == Fs.Use{} : Fs.Verdict}, safe)
        case Fs.Other{}:
          fsmode.pf.absurdF({Fs.socket_dir(Fs.Seen{Fs.Other{}, mine, loose}) == Fs.Use{} : Fs.Verdict}, safe)

def created(mine: Bool, loose: Bool) -> {Fs.socket_dir(Fs.Seen{Fs.Missing{}, mine, loose}) == Fs.Create{Fs.dir_mode()} : Fs.Verdict}:
  {==}

def created_used() -> {Fs.socket_dir(Fs.made(Fs.dir_mode())) == Fs.Use{} : Fs.Verdict}:
  {==}

# Socket peers
# ------------

def pf.peer_at(b: Bool, +p: Nat, +own: Nat, eb: {Nat.is_eq(p, own) == b : Bool}, ok: {Fs.peer.at(b) == Fs.Accept{} : Fs.Peer}) -> {p == own : Nat}:
  match b:
    case True{}:
      pf.eq_true(p, own, eb)
    case False{}:
      pf.drop_accept({p == own : Nat}, ok)

def peer_same(+p: Nat, +own: Nat, ok: {Fs.peer(p, own) == Fs.Accept{} : Fs.Peer}) -> {p == own : Nat}:
  pf.peer_at(Nat.is_eq(p, own), p, own, {==}, ok)

def peer_own(+own: Nat) -> {Fs.peer(own, own) == Fs.Accept{} : Fs.Peer}:
  %pf.eq_refl(own) : {Fs.peer.at(_) == Fs.Accept{} : Fs.Peer}
  {==}

# What eukhe creates
# ------------------

def private(k: Fs.Made) -> {Fs.Mode.loose(Fs.made_mode(k)) == False{} : Bool}:
  match k:
    case Fs.DirMade{}:
      {==}
    case Fs.FileMade{}:
      {==}

# The working dir of a session
# ----------------------------

def pf.opened_p(o: Fs.Open) -> Nat:
  match o:
    case Fs.Opened{p}:
      p
    case Fs.NeedsCwd{}:
      0n
    case Fs.Gone{p}:
      0n
    case Fs.NotDir{p}:
      0n

def explicit(c: Fs.Cwd, +p: Nat, ok: {Fs.open(c) == Fs.Opened{p} : Fs.Open}) -> {c == Fs.DirCwd{p} : Fs.Cwd}:
  match c:
    case Fs.NoCwd{}:
      pf.needs_opened({Fs.NoCwd{} == Fs.DirCwd{p} : Fs.Cwd}, p, ok)
    case Fs.GoneCwd{q}:
      pf.gone_opened({Fs.GoneCwd{q} == Fs.DirCwd{p} : Fs.Cwd}, q, p, ok)
    case Fs.FileCwd{q}:
      pf.notdir_opened({Fs.FileCwd{q} == Fs.DirCwd{p} : Fs.Cwd}, q, p, ok)
    case Fs.DirCwd{q}:
      Equal.cong(Nat, Fs.Cwd, n => Fs.DirCwd{n}, q, p, Equal.cong(Fs.Open, Nat, pf.opened_p, Fs.Opened{q}, Fs.Opened{p}, ok))

# ---- path_policy ----

# proof_path_policy: the (G1) laws (LAWS.bend section path_policy) of the path
# policy model in bend/path_policy.bend.
#
# A resolution keeps its invariant `looped or linkfree(at)`: a name it
# pushes is no link (the link test is the `look` it carries), `..` keeps
# a prefix, and a link's target starts from `/` or from the link's
# directory (`pp.go_lf`). The class picks Secret first and Inside last
# (`pp.pick_inside`, `pp.pick_guarded`); `demote` only moves Inside to
# Outside. A gated effect (outside, protected, secret: code 4 and up) is
# never grantable, so a write that is not Inside, or a read of a secret,
# reduces to the user's answer. A write that runs without a yes is Inside,
# so its real location is not guarded, and a write there leaves every
# guarded cell as it was (`pp.guarded_set`).

# Logic
# -----

def path_policy.pp.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pp.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : path_policy.pp.BD(_, Unit, A)
  Unit{}

def pp.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : path_policy.pp.BD(_, A, Unit)
  Unit{}

# A at Inside, Unit elsewhere: refutes {c == Inside} for c not Inside
def pp.CM(c: Pp.Cls, A: Type) -> Type:
  match c:
    case Pp.Inside{}:
      A
    case Pp.Outside{}:
      Unit
    case Pp.Protected{}:
      Unit
    case Pp.Secret{}:
      Unit

def pp.not_inside(-A: Type, c: Pp.Cls, n: {Pp.Cls.inside(c) == False{} : Bool}, e: {c == Pp.Inside{} : Pp.Cls}) -> A:
  match c:
    case Pp.Inside{}:
      pp.absurd(A, n)
    case Pp.Outside{}:
      %e : pp.CM(_, A)
      Unit{}
    case Pp.Protected{}:
      %e : pp.CM(_, A)
      Unit{}
    case Pp.Secret{}:
      %e : pp.CM(_, A)
      Unit{}

def pp.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pp.absurdF({b == True{} : Bool}, h)

def pp.or_tr(a: Bool, +b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

def pp.or_false_l(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      pp.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pp.or_false_r(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      pp.absurd({b == False{} : Bool}, h)
    case False{}:
      h

def pp.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pp.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      pp.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pp.eq_true(p, q, h))

def pp.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pp.absurdF({False{} == True{} : Bool}, h)

# two lists that ids.eq calls equal are equal
def pp.ids_sound(a: List<&2, Nat>, b: List<&2, Nat>, +h: {Tl.ids.eq(a, b) == True{} : Bool}) -> {a == b : List<&2, Nat>}:
  match a:
    case Nil{}:
      match b:
        case Nil{}:
          {==}
        case y <> yr:
          pp.absurdF({Nil{} == y <> yr : List<&2, Nat>}, h)
    case +x <> +xr:
      match b:
        case Nil{}:
          pp.absurdF({x <> xr == Nil{} : List<&2, Nat>}, h)
        case +y <> +yr:
          %pp.eq_true(x, y, pp.and_l(Nat.is_eq(x, y), Tl.ids.eq(xr, yr), h)) : {x <> xr == _ <> yr : List<&2, Nat>}
          %pp.ids_sound(xr, yr, pp.and_r(Nat.is_eq(x, y), Tl.ids.eq(xr, yr), h)) : {x <> xr == x <> _ : List<&2, Nat>}
          {==}

# 1. The real path
# ----------------

# the invariant of a resolution's result
def pp.ok(+ls: List<&2, Pp.Link>, +r: Pp.Res) -> Bool:
  Bool.or(Pp.Res.looped(r), Pp.linkfree(ls, Pp.Res.at(r)))

# `..` keeps a link-free prefix link-free
def pp.lf_up(+ls: List<&2, Pp.Link>, at: List<&2, Nat>, h: {Pp.linkfree(ls, at) == True{} : Bool}) -> {Pp.linkfree(ls, Pp.up(at)) == True{} : Bool}:
  match at:
    case Nil{}:
      {==}
    case a <> +above:
      pp.and_r(Maybe.is_none(&2, Pp.Link, Pp.link.find(ls, a <> above)), Pp.linkfree(ls, above), h)

def pp.inv_up(looped: Bool, +ls: List<&2, Pp.Link>, +at: List<&2, Nat>, h: {Bool.or(looped, Pp.linkfree(ls, at)) == True{} : Bool}) -> {Bool.or(looped, Pp.linkfree(ls, Pp.up(at))) == True{} : Bool}:
  match looped:
    case True{}:
      {==}
    case False{}:
      pp.lf_up(ls, at, h)

# a name pushed while looped or with no link at it keeps the invariant
def pp.inv_name(looped: Bool, m: Maybe<&2, Pp.Link>, +lf: Bool, h: {Bool.or(looped, lf) == True{} : Bool}) -> {Bool.or(Bool.or(looped, Maybe.is_some(&2, Pp.Link, m)), Bool.and(Maybe.is_none(&2, Pp.Link, m), lf)) == True{} : Bool}:
  match looped:
    case True{}:
      {==}
    case False{}:
      match m:
        case None{}:
          h
        case Some{l}:
          {==}

# a name with no link at it keeps a link-free prefix link-free
def pp.inv_none(+ls: List<&2, Pp.Link>, +n: Nat, +at: List<&2, Nat>, +looped: Bool, e: {None{} == Pp.link.find(ls, n <> at) : Maybe<&2, Pp.Link>}, h: {Bool.or(looped, Pp.linkfree(ls, at)) == True{} : Bool}) -> {Bool.or(looped, Pp.linkfree(ls, n <> at)) == True{} : Bool}:
  %e : {Bool.or(looped, Bool.and(Maybe.is_none(&2, Pp.Link, _), Pp.linkfree(ls, at))) == True{} : Bool}
  h

def pp.go_lf(fuel: Nat, segs: List<&2, Tl.Seg>, +ls: List<&2, Pp.Link>, +at: List<&2, Nat>, +looped: Bool, +look: Maybe<&2, Pp.Link>, +lk: {look == Pp.look.at(ls, segs, at) : Maybe<&2, Pp.Link>}, +h: {Bool.or(looped, Pp.linkfree(ls, at)) == True{} : Bool}) -> {pp.ok(ls, Pp.go(fuel, segs, ls, at, looped, look)) == True{} : Bool}:
  match fuel:
    case 0n:
      match segs:
        case Nil{}:
          h
        case s <> +rest:
          match s:
            case Tl.Name{+n}:
              %Equal.sym(Maybe<&2, Pp.Link>, look, Pp.link.find(ls, n <> at), lk) : {pp.ok(ls, Pp.go(0n, Tl.Name{n} <> rest, ls, at, looped, _)) == True{} : Bool}
              pp.go_lf(0n, rest, ls, n <> at, Bool.or(looped, Maybe.is_some(&2, Pp.Link, Pp.link.find(ls, n <> at))), Pp.look.at(ls, rest, n <> at), {==}, pp.inv_name(looped, Pp.link.find(ls, n <> at), Pp.linkfree(ls, at), h))
            case Tl.Up{}:
              pp.go_lf(0n, rest, ls, Pp.up(at), looped, Pp.look.at(ls, rest, Pp.up(at)), {==}, pp.inv_up(looped, ls, at, h))
            case Tl.Here{}:
              pp.go_lf(0n, rest, ls, at, looped, Pp.look.at(ls, rest, at), {==}, h)
    case 1n+f:
      match segs:
        case Nil{}:
          h
        case s <> +rest:
          match s:
            case Tl.Name{+n}:
              match look:
                case None{}:
                  pp.go_lf(1n+f, rest, ls, n <> at, looped, Pp.look.at(ls, rest, n <> at), {==}, pp.inv_none(ls, n, at, looped, lk, h))
                case Some{l}:
                  match l:
                    case Pp.Link{la, abs, +to}:
                      match abs:
                        case True{}:
                          pp.go_lf(f, List.append(&2, Tl.Seg, to, rest), ls, Nil{}, looped, Pp.look.at(ls, List.append(&2, Tl.Seg, to, rest), Nil{}), {==}, pp.or_tr(looped, True{}, {==}))
                        case False{}:
                          pp.go_lf(f, List.append(&2, Tl.Seg, to, rest), ls, at, looped, Pp.look.at(ls, List.append(&2, Tl.Seg, to, rest), at), {==}, h)
            case Tl.Up{}:
              pp.go_lf(1n+f, rest, ls, Pp.up(at), looped, Pp.look.at(ls, rest, Pp.up(at)), {==}, pp.inv_up(looped, ls, at, h))
            case Tl.Here{}:
              pp.go_lf(1n+f, rest, ls, at, looped, Pp.look.at(ls, rest, at), {==}, h)

def pp.path_real_has_no_link(+ls: List<&2, Pp.Link>, +segs: List<&2, Tl.Seg>) -> {Bool.or(Pp.Res.looped(Pp.real(ls, segs)), Pp.linkfree(ls, Pp.Res.at(Pp.real(ls, segs)))) == True{} : Bool}:
  pp.go_lf(Pp.max_links(), segs, ls, Nil{}, False{}, Pp.look.at(ls, segs, Nil{}), {==}, {==})

# 2. The class
# ------------

def pp.secret_res(+pol: Pp.Pol, r: Pp.Res, hit: {Pp.any_under(Pp.Pol.secret(pol), Pp.Res.at(r)) == True{} : Bool}) -> {Pp.class_res(pol, r) == Pp.Secret{} : Pp.Cls}:
  match r:
    case Pp.Res{+at, looped}:
      %Equal.sym(Bool, Pp.any_under(Pp.Pol.secret(pol), at), True{}, hit) : {Pp.demote(Pp.cls.pick(_, Pp.protects(pol, at), Maybe.is_some(&2, List<&2, Nat>, Pp.root.of(Pp.Pol.roots(pol), at))), looped) == Pp.Secret{} : Pp.Cls}
      {==}

def pp.path_secret_wins(+pol: Pp.Pol, +ls: List<&2, Pp.Link>, +segs: List<&2, Tl.Seg>, hit: {Pp.any_under(Pp.Pol.secret(pol), Pp.Res.at(Pp.real(ls, segs))) == True{} : Bool}) -> {Pp.class(pol, ls, segs) == Pp.Secret{} : Pp.Cls}:
  pp.secret_res(pol, Pp.real(ls, segs), hit)

# Inside exactly when no secret, nothing protects, and a root holds it
def pp.pick_inside(sec: Bool, prot: Bool, ins: Bool) -> {Pp.Cls.inside(Pp.cls.pick(sec, prot, ins)) == Pp.inside_ok(sec, prot, ins) : Bool}:
  match sec:
    case True{}:
      {==}
    case False{}:
      match prot:
        case True{}:
          {==}
        case False{}:
          match ins:
            case True{}:
              {==}
            case False{}:
              {==}

# demote gives Inside only for an Inside that did not loop
def pp.demote_inside(c: Pp.Cls, looped: Bool, h: {Pp.demote(c, looped) == Pp.Inside{} : Pp.Cls}) -> {Bool.and(Bool.not(looped), Pp.Cls.inside(c)) == True{} : Bool}:
  match c:
    case Pp.Inside{}:
      match looped:
        case True{}:
          %h : pp.CM(_, {Bool.and(Bool.not(True{}), True{}) == True{} : Bool})
          Unit{}
        case False{}:
          {==}
    case Pp.Outside{}:
      %h : pp.CM(_, {Bool.and(Bool.not(looped), False{}) == True{} : Bool})
      Unit{}
    case Pp.Protected{}:
      %h : pp.CM(_, {Bool.and(Bool.not(looped), False{}) == True{} : Bool})
      Unit{}
    case Pp.Secret{}:
      %h : pp.CM(_, {Bool.and(Bool.not(looped), False{}) == True{} : Bool})
      Unit{}

def pp.inside_safe(+pol: Pp.Pol, r: Pp.Res, h: {Pp.class_res(pol, r) == Pp.Inside{} : Pp.Cls}) -> {Pp.safe(pol, r) == True{} : Bool}:
  match r:
    case Pp.Res{+at, +looped}:
      %pp.pick_inside(Pp.any_under(Pp.Pol.secret(pol), at), Pp.protects(pol, at), Maybe.is_some(&2, List<&2, Nat>, Pp.root.of(Pp.Pol.roots(pol), at))) : {Bool.and(Bool.not(looped), _) == True{} : Bool}
      pp.demote_inside(Pp.class_of(pol, at), looped, h)

def pp.path_inside_is_safe(+pol: Pp.Pol, +ls: List<&2, Pp.Link>, +segs: List<&2, Tl.Seg>, inside: {Pp.class(pol, ls, segs) == Pp.Inside{} : Pp.Cls}) -> {Pp.safe(pol, Pp.real(ls, segs)) == True{} : Bool}:
  pp.inside_safe(pol, Pp.real(ls, segs), inside)

def pp.pick_guarded(sec: Bool, ins: Bool) -> {Pp.Cls.guarded(Pp.cls.pick(sec, True{}, ins)) == True{} : Bool}:
  match sec:
    case True{}:
      {==}
    case False{}:
      {==}

def pp.demote_guarded(c: Pp.Cls, looped: Bool, h: {Pp.Cls.guarded(c) == True{} : Bool}) -> {Pp.Cls.guarded(Pp.demote(c, looped)) == True{} : Bool}:
  match c:
    case Pp.Inside{}:
      pp.absurdF({Pp.Cls.guarded(Pp.demote(Pp.Inside{}, looped)) == True{} : Bool}, h)
    case Pp.Outside{}:
      pp.absurdF({Pp.Cls.guarded(Pp.demote(Pp.Outside{}, looped)) == True{} : Bool}, h)
    case Pp.Protected{}:
      {==}
    case Pp.Secret{}:
      {==}

def pp.anc_res(+pol: Pp.Pol, r: Pp.Res, anc: {Pp.any_ancestor(List.append(&2, List<&2, Nat>, Pp.entries(Pp.Pol.rules(pol)), Pp.Pol.secret(pol)), Pp.Res.at(r)) == True{} : Bool}) -> {Pp.Cls.guarded(Pp.class_res(pol, r)) == True{} : Bool}:
  match r:
    case Pp.Res{+at, looped}:
      +sec = Pp.any_under(Pp.Pol.secret(pol), at)
      +ins = Maybe.is_some(&2, List<&2, Nat>, Pp.root.of(Pp.Pol.roots(pol), at))
      +hp = pp.or_tr(Pp.any_covers(Pp.Pol.rules(pol), at, Pp.below(at, Pp.root.of(Pp.Pol.roots(pol), at))), Pp.any_ancestor(List.append(&2, List<&2, Nat>, Pp.entries(Pp.Pol.rules(pol)), Pp.Pol.secret(pol)), at), anc)
      +g = pp.pick_guarded(sec, ins)
      %Equal.sym(Bool, Pp.protects(pol, at), True{}, hp) : {Pp.Cls.guarded(Pp.demote(Pp.cls.pick(sec, _, ins), looped)) == True{} : Bool}
      pp.demote_guarded(Pp.cls.pick(sec, True{}, ins), looped, g)

def pp.path_ancestor_guarded(+pol: Pp.Pol, +ls: List<&2, Pp.Link>, +segs: List<&2, Tl.Seg>, anc: {Pp.any_ancestor(List.append(&2, List<&2, Nat>, Pp.entries(Pp.Pol.rules(pol)), Pp.Pol.secret(pol)), Pp.Res.at(Pp.real(ls, segs))) == True{} : Bool}) -> {Pp.Cls.guarded(Pp.class(pol, ls, segs)) == True{} : Bool}:
  pp.anc_res(pol, Pp.real(ls, segs), anc)

# 3. The gate
# -----------

# a yes that is not a yes
def pp.yes_clash(-A: Type, ans: Pp.Ans, ran: {Pp.Ans.yes(ans) == True{} : Bool}, no: {Pp.Ans.yes(ans) == False{} : Bool}) -> A:
  pp.absurd(A, Equal.trans(Bool, True{}, Pp.Ans.yes(ans), False{}, Equal.sym(Bool, Pp.Ans.yes(ans), True{}, ran), no))

def pp.gate_write_auto_only_inside(c: Pp.Cls, +auto: List<&2, Nat>, +ans: Pp.Ans, ran: {Pp.runs(c, Pp.Wr{}, auto, ans) == True{} : Bool}, no: {Pp.Ans.yes(ans) == False{} : Bool}) -> {c == Pp.Inside{} : Pp.Cls}:
  match c:
    case Pp.Inside{}:
      {==}
    case Pp.Outside{}:
      pp.yes_clash({Pp.Outside{} == Pp.Inside{} : Pp.Cls}, ans, ran, no)
    case Pp.Protected{}:
      pp.yes_clash({Pp.Protected{} == Pp.Inside{} : Pp.Cls}, ans, ran, no)
    case Pp.Secret{}:
      pp.yes_clash({Pp.Secret{} == Pp.Inside{} : Pp.Cls}, ans, ran, no)

def pp.gate_secret_read_needs_yes(c: Pp.Cls, a: Pp.Acc, +auto: List<&2, Nat>, +ans: Pp.Ans, s: {Pp.secret_read(c, a) == True{} : Bool}, ran: {Pp.runs(c, a, auto, ans) == True{} : Bool}) -> {Pp.Ans.yes(ans) == True{} : Bool}:
  match c:
    case Pp.Secret{}:
      match a:
        case Pp.Rd{}:
          ran
        case Pp.Ls{}:
          ran
        case Pp.Sr{h}:
          match h:
            case True{}:
              ran
            case False{}:
              ran
        case Pp.Wr{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
    case Pp.Inside{}:
      match a:
        case Pp.Rd{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Ls{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Sr{h}:
          match h:
            case True{}:
              ran
            case False{}:
              pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Wr{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
    case Pp.Outside{}:
      match a:
        case Pp.Rd{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Ls{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Sr{h}:
          match h:
            case True{}:
              ran
            case False{}:
              pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Wr{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
    case Pp.Protected{}:
      match a:
        case Pp.Rd{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Ls{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Sr{h}:
          match h:
            case True{}:
              ran
            case False{}:
              pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)
        case Pp.Wr{}:
          pp.absurdF({Pp.Ans.yes(ans) == True{} : Bool}, s)

def pp.gate_yes_runs(c: Pp.Cls, a: Pp.Acc, +auto: List<&2, Nat>) -> {Pp.runs(c, a, auto, Pp.Yes{}) == True{} : Bool}:
  pp.or_tr(Pp.allows(auto, Pp.effs(c, a)), True{}, {==})

def pp.gate_inside_write_runs(+auto: List<&2, Nat>, +ans: Pp.Ans, w: {Tl.elem(auto, 1n) == True{} : Bool}) -> {Pp.runs(Pp.Inside{}, Pp.Wr{}, auto, ans) == True{} : Bool}:
  %Equal.sym(Bool, Tl.elem(auto, 1n), True{}, w) : {Bool.or(_, Pp.Ans.yes(ans)) == True{} : Bool}
  {==}

# 4. The store
# ------------

def pp.inside_unguarded(c: Pp.Cls, h: {Pp.Cls.inside(c) == True{} : Bool}) -> {Pp.Cls.guarded(c) == False{} : Bool}:
  match c:
    case Pp.Inside{}:
      {==}
    case Pp.Outside{}:
      pp.absurdF({False{} == False{} : Bool}, h)
    case Pp.Protected{}:
      pp.absurdF({True{} == False{} : Bool}, h)
    case Pp.Secret{}:
      pp.absurdF({True{} == False{} : Bool}, h)

# the real location of a path judged Inside is not guarded
def pp.inside_res(+pol: Pp.Pol, r: Pp.Res, h: {Pp.class_res(pol, r) == Pp.Inside{} : Pp.Cls}) -> {Pp.Cls.guarded(Pp.class_of(pol, Pp.Res.at(r))) == False{} : Bool}:
  match r:
    case Pp.Res{+at, +looped}:
      pp.inside_unguarded(Pp.class_of(pol, at), pp.and_r(Bool.not(looped), Pp.Cls.inside(Pp.class_of(pol, at)), pp.demote_inside(Pp.class_of(pol, at), looped, h)))

# one cell of a set, by the head test b
def pp.set_pick(b: Bool, +c: Pp.Cell, +rest: List<&2, Pp.Cell>, +pol: Pp.Pol, +k: List<&2, Nat>, +v: Nat, e: {Tl.ids.eq(Pp.Cell.at(c), k) == b : Bool}, +hk: {Pp.Cls.guarded(Pp.class_of(pol, k)) == False{} : Bool}, ih: {Pp.guarded(Pp.set(rest, k, v), pol) == Pp.guarded(rest, pol) : List<&2, Pp.Cell>}) -> {Pp.guarded(Pp.set.pick(b, c, k, v, rest, Pp.set(rest, k, v)), pol) == Pp.guarded(c <> rest, pol) : List<&2, Pp.Cell>}:
  match b:
    case True{}:
      +same = pp.ids_sound(Pp.Cell.at(c), k, e)
      %Equal.sym(Bool, Pp.Cls.guarded(Pp.class_of(pol, k)), False{}, hk) : {Pp.keep.pick(_, Pp.Cell{k, v}, Pp.guarded(rest, pol)) == Pp.guarded(c <> rest, pol) : List<&2, Pp.Cell>}
      %Equal.sym(List<&2, Nat>, Pp.Cell.at(c), k, same) : {Pp.guarded(rest, pol) == Pp.keep.pick(Pp.Cls.guarded(Pp.class_of(pol, _)), c, Pp.guarded(rest, pol)) : List<&2, Pp.Cell>}
      %Equal.sym(Bool, Pp.Cls.guarded(Pp.class_of(pol, k)), False{}, hk) : {Pp.guarded(rest, pol) == Pp.keep.pick(_, c, Pp.guarded(rest, pol)) : List<&2, Pp.Cell>}
      {==}
    case False{}:
      %Equal.sym(List<&2, Pp.Cell>, Pp.guarded(Pp.set(rest, k, v), pol), Pp.guarded(rest, pol), ih) : {Pp.keep.pick(Pp.Cls.guarded(Pp.class_of(pol, Pp.Cell.at(c))), c, _) == Pp.guarded(c <> rest, pol) : List<&2, Pp.Cell>}
      {==}

# a write at a location that is not guarded keeps every guarded cell
def pp.guarded_set(cs: List<&2, Pp.Cell>, +pol: Pp.Pol, +k: List<&2, Nat>, +v: Nat, +hk: {Pp.Cls.guarded(Pp.class_of(pol, k)) == False{} : Bool}) -> {Pp.guarded(Pp.set(cs, k, v), pol) == Pp.guarded(cs, pol) : List<&2, Pp.Cell>}:
  match cs:
    case Nil{}:
      %Equal.sym(Bool, Pp.Cls.guarded(Pp.class_of(pol, k)), False{}, hk) : {Pp.keep.pick(_, Pp.Cell{k, v}, Nil{}) == Nil{} : List<&2, Pp.Cell>}
      {==}
    case +c <> +rest:
      pp.set_pick(Tl.ids.eq(Pp.Cell.at(c), k), c, rest, pol, k, v, {==}, hk, pp.guarded_set(rest, pol, k, v, hk))

# one write, by the gate's verdict b
def pp.put_keep(b: Bool, +pol: Pp.Pol, +ls: List<&2, Pp.Link>, +auto: List<&2, Nat>, cs: List<&2, Pp.Cell>, +segs: List<&2, Tl.Seg>, +v: Nat, +ans: Pp.Ans, e: {Pp.runs(Pp.class(pol, ls, segs), Pp.Wr{}, auto, ans) == b : Bool}, no: {Pp.Ans.yes(ans) == False{} : Bool}) -> {Pp.guarded(Pp.put.pick(b, cs, Pp.Res.at(Pp.real(ls, segs)), v), pol) == Pp.guarded(cs, pol) : List<&2, Pp.Cell>}:
  match b:
    case True{}:
      +inside = pp.gate_write_auto_only_inside(Pp.class(pol, ls, segs), auto, ans, e, no)
      pp.guarded_set(cs, pol, Pp.Res.at(Pp.real(ls, segs)), v, pp.inside_res(pol, Pp.real(ls, segs), inside))
    case False{}:
      {==}

def pp.config_needs_yes(es: List<&2, Pp.Put>, +pol: Pp.Pol, +ls: List<&2, Pp.Link>, +auto: List<&2, Nat>, +cs: List<&2, Pp.Cell>, +no: {Pp.any_yes(es) == False{} : Bool}) -> {Pp.guarded(Pp.run(es, pol, ls, auto, cs), pol) == Pp.guarded(cs, pol) : List<&2, Pp.Cell>}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Pp.Put{+segs, +v, +ans}:
          +na = pp.or_false_l(Pp.Ans.yes(ans), Pp.any_yes(rest), no)
          +nr = pp.or_false_r(Pp.Ans.yes(ans), Pp.any_yes(rest), no)
          +next = Pp.step(pol, ls, auto, cs, Pp.Put{segs, v, ans})
          Equal.trans(List<&2, Pp.Cell>, Pp.guarded(Pp.run(rest, pol, ls, auto, next), pol), Pp.guarded(next, pol), Pp.guarded(cs, pol), pp.config_needs_yes(rest, pol, ls, auto, next, nr), pp.put_keep(Pp.runs(Pp.class(pol, ls, segs), Pp.Wr{}, auto, ans), pol, ls, auto, cs, segs, v, ans, {==}, na))

# ---- child_env ----

# proof_child_env: the G3 laws (LAWS.bend section child_env, no credential
# reaches a child) of the model in bend/child_env.bend.
#
# The filter keeps a variable exactly when its name passes. So every
# variable of the child passes (`pce.all` holds of the filtered list, and
# a member of a list of which `pce.all` holds passes), and every member of
# the merged list that passes is a member of the child. What remains is
# logic on the test: with an empty keep list a name passes only when it is
# not a credential; a credential name passes only when the keep list holds
# it and it is no provider name; a name that is not a credential passes,
# and so does a kept name that is no provider name.
#
# A recursive proof takes the value it inspects as a parameter (Bend
# matches only parameters), with an equation that names it.

# Logic
# -----

def pce.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pce.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pce.BD(_, Unit, A)
  Unit{}

def pce.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pce.BD(_, A, Unit)
  Unit{}

def pce.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pce.absurdF({False{} == True{} : Bool}, h)

def pce.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pce.absurdF({b == True{} : Bool}, h)

def pce.not_t(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      pce.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pce.or_false(a: Bool, h: {Bool.or(a, False{}) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pce.absurdF({False{} == True{} : Bool}, h)

# The filter
# ----------

# every variable of xs passes
def pce.all(+reg: List<&2, String>, +ks: List<&2, String>, xs: List<&2, Env.Var>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case +v <> rest:
      Bool.and(Env.passes(reg, ks, Env.Var.name(v)), pce.all(reg, ks, rest))

def pce.put_all(+reg: List<&2, String>, +ks: List<&2, String>, b: Bool, +h: Env.Var, +r: List<&2, Env.Var>, e: {Env.passes(reg, ks, Env.Var.name(h)) == b : Bool}, ih: {pce.all(reg, ks, r) == True{} : Bool}) -> {pce.all(reg, ks, Env.keep.put(b, h, r)) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, Env.passes(reg, ks, Env.Var.name(h)), True{}, e) : {Bool.and(_, pce.all(reg, ks, r)) == True{} : Bool}
      ih
    case False{}:
      ih

# every variable the filter keeps passes
def pce.keep_all(+reg: List<&2, String>, +ks: List<&2, String>, xs: List<&2, Env.Var>) -> {pce.all(reg, ks, Env.keep(reg, ks, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      pce.put_all(reg, ks, Env.passes(reg, ks, Env.Var.name(h)), h, Env.keep(reg, ks, t), {==}, pce.keep_all(reg, ks, t))

# a member of a list of which pce.all holds passes
def pce.in_all(+reg: List<&2, String>, +ks: List<&2, String>, xs: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, xs), a: {pce.all(reg, ks, xs) == True{} : Bool}) -> {Env.passes(reg, ks, Env.Var.name(v)) == True{} : Bool}:
  match xs:
    case Nil{}:
      match i:
    case +h <> +t:
      match i:
        case Inl{eq}:
          %Equal.sym(Env.Var, v, h, eq) : {Env.passes(reg, ks, Env.Var.name(_)) == True{} : Bool}
          pce.and_l(Env.passes(reg, ks, Env.Var.name(h)), pce.all(reg, ks, t), a)
        case Inr{it}:
          pce.in_all(reg, ks, t, v, it, pce.and_r(Env.passes(reg, ks, Env.Var.name(h)), pce.all(reg, ks, t), a))

# every variable of the child passes
def pce.child_passes(+reg: List<&2, String>, +ks: List<&2, String>, +xs: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, Env.keep(reg, ks, xs))) -> {Env.passes(reg, ks, Env.Var.name(v)) == True{} : Bool}:
  pce.in_all(reg, ks, Env.keep(reg, ks, xs), v, i, pce.keep_all(reg, ks, xs))

def pce.in_put(b: Bool, +h: Env.Var, +r: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, r)) -> Env.In(v, Env.keep.put(b, h, r)):
  match b:
    case True{}:
      Inr{i}
    case False{}:
      i

# a member of xs that passes is a member of the filtered list
def pce.in_keep(+reg: List<&2, String>, +ks: List<&2, String>, xs: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, xs), p: {Env.passes(reg, ks, Env.Var.name(v)) == True{} : Bool}) -> Env.In(v, Env.keep(reg, ks, xs)):
  match xs:
    case Nil{}:
      match i:
    case +h <> +t:
      match i:
        case Inl{eq}:
          %eq : Env.In(v, Env.keep.put(Env.passes(reg, ks, Env.Var.name(_)), _, Env.keep(reg, ks, t)))
          %Equal.sym(Bool, Env.passes(reg, ks, Env.Var.name(v)), True{}, p) : Env.In(v, Env.keep.put(_, v, Env.keep(reg, ks, t)))
          Inl{{==}}
        case Inr{it}:
          pce.in_put(Env.passes(reg, ks, Env.Var.name(h)), h, Env.keep(reg, ks, t), v, pce.in_keep(reg, ks, t, v, it, p))

# The test
# --------

# a credential name passes only when kept and no provider name
def pce.only(c: Bool, +l: Bool, +r: Bool, e: {c == True{} : Bool}, +p: {Bool.or(Bool.not(c), Bool.and(l, Bool.not(r))) == True{} : Bool}) -> ({l == True{} : Bool} & {r == False{} : Bool}):
  match c:
    case True{}:
      (pce.and_l(l, Bool.not(r), p), pce.not_t(r, pce.and_r(l, Bool.not(r), p)))
    case False{}:
      pce.absurdF(({l == True{} : Bool} & {r == False{} : Bool}), e)

# a name that is not a credential passes
def pce.rest(c: Bool, +x: Bool, e: {c == False{} : Bool}) -> {Bool.or(Bool.not(c), x) == True{} : Bool}:
  match c:
    case True{}:
      pce.absurd({Bool.or(False{}, x) == True{} : Bool}, e)
    case False{}:
      {==}

# a kept name that is no provider name passes
def pce.kept(x: Bool, l: Bool, r: Bool, kl: {l == True{} : Bool}, kr: {r == False{} : Bool}) -> {Bool.or(x, Bool.and(l, Bool.not(r))) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      match l:
        case True{}:
          match r:
            case True{}:
              pce.absurd({Bool.not(True{}) == True{} : Bool}, kr)
            case False{}:
              {==}
        case False{}:
          pce.absurdF({Bool.and(False{}, Bool.not(r)) == True{} : Bool}, kl)

# The laws
# --------

def pce.env_drops_credentials(+reg: List<&2, String>, base: List<&2, Env.Var>, over: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, Env.child(reg, Nil{}, base, over))) -> {Env.cred(reg, Env.Var.name(v)) == False{} : Bool}:
  +n = Env.Var.name(v)
  pce.not_t(Env.cred(reg, n), pce.or_false(Bool.not(Env.cred(reg, n)), pce.child_passes(reg, Nil{}, Env.merge(base, over), v, i)))

def pce.env_kernel_keeps_only_listed(+reg: List<&2, String>, +keep: List<&2, String>, base: List<&2, Env.Var>, over: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, Env.child(reg, keep, base, over)), c: {Env.cred(reg, Env.Var.name(v)) == True{} : Bool}) -> ({Env.listed(keep, Env.Var.name(v)) == True{} : Bool} & {Env.registered(reg, Env.Var.name(v)) == False{} : Bool}):
  +n = Env.Var.name(v)
  pce.only(Env.cred(reg, n), Env.listed(keep, n), Env.registered(reg, n), c, pce.child_passes(reg, keep, Env.merge(base, over), v, i))

def pce.env_keeps_the_rest(+reg: List<&2, String>, +keep: List<&2, String>, base: List<&2, Env.Var>, over: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, Env.merge(base, over)), c: {Env.cred(reg, Env.Var.name(v)) == False{} : Bool}) -> Env.In(v, Env.child(reg, keep, base, over)):
  +n = Env.Var.name(v)
  pce.in_keep(reg, keep, Env.merge(base, over), v, i, pce.rest(Env.cred(reg, n), Bool.and(Env.listed(keep, n), Bool.not(Env.registered(reg, n))), c))

def pce.env_keeps_listed(+reg: List<&2, String>, +keep: List<&2, String>, base: List<&2, Env.Var>, over: List<&2, Env.Var>, +v: Env.Var, i: Env.In(v, Env.merge(base, over)), k: {Env.listed(keep, Env.Var.name(v)) == True{} : Bool}, r: {Env.registered(reg, Env.Var.name(v)) == False{} : Bool}) -> Env.In(v, Env.child(reg, keep, base, over)):
  +n = Env.Var.name(v)
  pce.in_keep(reg, keep, Env.merge(base, over), v, i, pce.kept(Bool.not(Env.cred(reg, n)), Env.listed(keep, n), Env.registered(reg, n), k, r))

# ---- shell ----

# proof_shell: the G2 laws (docs/tools.md S7, shell classification) of
# the gate model in bend/tools.bend part 4. An effect of a part is in the
# join of the parts (`ps.elem_app_l`, `ps.elem_app_r`, by induction on the
# parts before it). A step with one effect that is not within the auto set
# is not within it (`ps.within_out`, by induction on its effects, with the
# head test as a parameter). Codes 4, 5 and 6 are not grantable
# (`ps.big`, four levels of literal match). The gate reads `within` of
# the head step: a rewrite with it runs the step free, or with no answer
# denies it.

# Logic
# -----

def shell.ps.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def shell.ps.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : shell.ps.BD(_, A, Unit)
  Unit{}

def shell.ps.and_f(a: Bool) -> {Bool.and(a, False{}) == False{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def shell.ps.or_tr(a: Bool, +b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

def shell.ps.eq_of_is_eq(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+bp:
      shell.ps.absurdF({0n == 1n+bp : Nat}, h)
    case 1n+ap 0n:
      shell.ps.absurdF({1n+ap == 0n : Nat}, h)
    case 1n+ap 1n+bp:
      %shell.ps.eq_of_is_eq(ap, bp, h) : {1n+ap == 1n+_ : Nat}
      {==}

# A step made of parts
# --------------------

# an element of ys is an element of xs ++ ys
def ps.elem_app_r(xs: List<&2, Nat>, +ys: List<&2, Nat>, +c: Nat, h: {Tl.elem(ys, c) == True{} : Bool}) -> {Tl.elem(List.append(&2, Nat, xs, ys), c) == True{} : Bool}:
  match xs:
    case Nil{}:
      h
    case +x <> +xr:
      shell.ps.or_tr(Nat.is_eq(x, c), Tl.elem(List.append(&2, Nat, xr, ys), c), ps.elem_app_r(xr, ys, c, h))

# the head test b of an element of xs: either b, or c is in the rest
def ps.app_head(b: Bool, +xr: List<&2, Nat>, +ys: List<&2, Nat>, +c: Nat, h: {Bool.or(b, Tl.elem(xr, c)) == True{} : Bool}, ih: {Tl.elem(xr, c) == True{} : Bool} -> {Tl.elem(List.append(&2, Nat, xr, ys), c) == True{} : Bool}) -> {Bool.or(b, Tl.elem(List.append(&2, Nat, xr, ys), c)) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      ih(h)

# an element of xs is an element of xs ++ ys
def ps.elem_app_l(xs: List<&2, Nat>, +ys: List<&2, Nat>, +c: Nat, h: {Tl.elem(xs, c) == True{} : Bool}) -> {Tl.elem(List.append(&2, Nat, xs, ys), c) == True{} : Bool}:
  match xs:
    case Nil{}:
      shell.ps.absurdF({Tl.elem(ys, c) == True{} : Bool}, h)
    case +x <> +xr:
      ps.app_head(Nat.is_eq(x, c), xr, ys, c, h, k => ps.elem_app_l(xr, ys, c, k))

def ps.step_holds_every_part(+pre: List<&2, List<&2, Nat>>, +p: List<&2, Nat>, +post: List<&2, List<&2, Nat>>, +c: Nat, has: {Tl.elem(p, c) == True{} : Bool}) -> {Tl.elem(Tl.join(List.append(&2, List<&2, Nat>, pre, p <> post)), c) == True{} : Bool}:
  match pre:
    case Nil{}:
      ps.elem_app_l(p, Tl.join(post), c, has)
    case q <> pr:
      ps.elem_app_r(q, Tl.join(List.append(&2, List<&2, Nat>, pr, p <> post)), c, ps.step_holds_every_part(pr, p, post, c, has))

# The secret effect
# -----------------

def shell.ps.or_assoc(b: Bool, +p: Bool, +q: Bool) -> {Bool.or(b, Bool.or(p, q)) == Bool.or(Bool.or(b, p), q) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# c is in xs ++ ys exactly when it is in xs or in ys
def ps.elem_app(xs: List<&2, Nat>, +ys: List<&2, Nat>, +c: Nat) -> {Tl.elem(List.append(&2, Nat, xs, ys), c) == Bool.or(Tl.elem(xs, c), Tl.elem(ys, c)) : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +xr:
      %Equal.sym(Bool, Tl.elem(List.append(&2, Nat, xr, ys), c), Bool.or(Tl.elem(xr, c), Tl.elem(ys, c)), ps.elem_app(xr, ys, c)) : {Bool.or(Nat.is_eq(x, c), _) == Bool.or(Bool.or(Nat.is_eq(x, c), Tl.elem(xr, c)), Tl.elem(ys, c)) : Bool}
      shell.ps.or_assoc(Nat.is_eq(x, c), Tl.elem(xr, c), Tl.elem(ys, c))

# the head c of the codes, with test b = Nat.is_eq(c, 6n): a dropped 6
# leaves the rest, a kept code is not 6
def ps.plain_head(b: Bool, +c: Nat, +acc: List<&2, Nat>, e: {Nat.is_eq(c, 6n) == b : Bool}, ih: {Tl.elem(acc, 6n) == False{} : Bool}) -> {Tl.elem(Tl.plain.add(b, c, acc), 6n) == False{} : Bool}:
  match b:
    case True{}:
      ih
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(c, 6n), False{}, e) : {Bool.or(_, Tl.elem(acc, 6n)) == False{} : Bool}
      ih

# the plain codes hold no secret
def ps.plain_no_secret(cs: List<&2, Nat>) -> {Tl.elem(Tl.plain(cs), 6n) == False{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case +c <> +rest:
      ps.plain_head(Nat.is_eq(c, 6n), c, Tl.plain(rest), {==}, ps.plain_no_secret(rest))

# a part has the secret effect exactly when it names a secret path
def ps.part_secret(p: Tl.Part) -> {Tl.elem(Tl.part.effs(p), 6n) == Tl.Part.secret(p) : Bool}:
  match p:
    case Tl.Part{o, s}:
      match s:
        case True{}:
          {==}
        case False{}:
          ps.plain_no_secret(o)

# a step has the secret effect exactly when one of its parts names a
# secret path
def ps.secret_iff(xs: List<&2, Tl.Part>) -> {Tl.elem(Tl.join(Tl.parts.effs(xs)), 6n) == Tl.parts.secret(xs) : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +p <> +rest:
      %Equal.sym(Bool, Tl.elem(List.append(&2, Nat, Tl.part.effs(p), Tl.join(Tl.parts.effs(rest))), 6n), Bool.or(Tl.elem(Tl.part.effs(p), 6n), Tl.elem(Tl.join(Tl.parts.effs(rest)), 6n)), ps.elem_app(Tl.part.effs(p), Tl.join(Tl.parts.effs(rest)), 6n)) : {_ == Bool.or(Tl.Part.secret(p), Tl.parts.secret(rest)) : Bool}
      %Equal.sym(Bool, Tl.elem(Tl.part.effs(p), 6n), Tl.Part.secret(p), ps.part_secret(p)) : {Bool.or(_, Tl.elem(Tl.join(Tl.parts.effs(rest)), 6n)) == Bool.or(Tl.Part.secret(p), Tl.parts.secret(rest)) : Bool}
      %Equal.sym(Bool, Tl.elem(Tl.join(Tl.parts.effs(rest)), 6n), Tl.parts.secret(rest), ps.secret_iff(rest)) : {Bool.or(Tl.Part.secret(p), _) == Bool.or(Tl.Part.secret(p), Tl.parts.secret(rest)) : Bool}
      {==}

def ps.secret_needs_a_secret_path(+xs: List<&2, Tl.Part>, has: {Tl.elem(Tl.join(Tl.parts.effs(xs)), 6n) == True{} : Bool}) -> {Tl.parts.secret(xs) == True{} : Bool}:
  Equal.trans(Bool, Tl.parts.secret(xs), Tl.elem(Tl.join(Tl.parts.effs(xs)), 6n), True{}, Equal.sym(Bool, Tl.elem(Tl.join(Tl.parts.effs(xs)), 6n), Tl.parts.secret(xs), ps.secret_iff(xs)), has)

# a part that names a secret path makes some part of the step name one
def ps.some_secret(+pre: List<&2, Tl.Part>, +p: Tl.Part, +post: List<&2, Tl.Part>, named: {Tl.Part.secret(p) == True{} : Bool}) -> {Tl.parts.secret(List.append(&2, Tl.Part, pre, p <> post)) == True{} : Bool}:
  match pre:
    case Nil{}:
      %Equal.sym(Bool, Tl.Part.secret(p), True{}, named) : {Bool.or(_, Tl.parts.secret(post)) == True{} : Bool}
      {==}
    case q <> pr:
      shell.ps.or_tr(Tl.Part.secret(q), Tl.parts.secret(List.append(&2, Tl.Part, pr, p <> post)), ps.some_secret(pr, p, post, named))

def ps.secret_path_gives_secret(+pre: List<&2, Tl.Part>, +p: Tl.Part, +post: List<&2, Tl.Part>, named: {Tl.Part.secret(p) == True{} : Bool}) -> {Tl.elem(Tl.join(Tl.parts.effs(List.append(&2, Tl.Part, pre, p <> post))), 6n) == True{} : Bool}:
  +all = List.append(&2, Tl.Part, pre, p <> post)
  Equal.trans(Bool, Tl.elem(Tl.join(Tl.parts.effs(all)), 6n), Tl.parts.secret(all), True{}, ps.secret_iff(all), ps.some_secret(pre, p, post, named))

# Within the auto set
# -------------------

# the head x of effs, with test b = Nat.is_eq(x, c): when x is c, x is not
# within; else c is in the rest, which is then not within
def ps.within_head(+x: Nat, +rest: List<&2, Nat>, +auto: List<&2, Nat>, +c: Nat, b: Bool, e: {Nat.is_eq(x, c) == b : Bool}, has: {Bool.or(b, Tl.elem(rest, c)) == True{} : Bool}, out: {Bool.and(Tl.grantable(c), Tl.elem(auto, c)) == False{} : Bool}, ih: {Tl.elem(rest, c) == True{} : Bool} -> {Tl.within(rest, auto) == False{} : Bool}) -> {Bool.and(Bool.and(Tl.grantable(x), Tl.elem(auto, x)), Tl.within(rest, auto)) == False{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, x, c, shell.ps.eq_of_is_eq(x, c, e)) : {Bool.and(Bool.and(Tl.grantable(_), Tl.elem(auto, _)), Tl.within(rest, auto)) == False{} : Bool}
      %Equal.sym(Bool, Bool.and(Tl.grantable(c), Tl.elem(auto, c)), False{}, out) : {Bool.and(_, Tl.within(rest, auto)) == False{} : Bool}
      {==}
    case False{}:
      %Equal.sym(Bool, Tl.within(rest, auto), False{}, ih(has)) : {Bool.and(Bool.and(Tl.grantable(x), Tl.elem(auto, x)), _) == False{} : Bool}
      shell.ps.and_f(Bool.and(Tl.grantable(x), Tl.elem(auto, x)))

# effects with one effect c that is not grantable or not in auto are not
# within auto
def ps.within_out(effs: List<&2, Nat>, +auto: List<&2, Nat>, +c: Nat, has: {Tl.elem(effs, c) == True{} : Bool}, +out: {Bool.and(Tl.grantable(c), Tl.elem(auto, c)) == False{} : Bool}) -> {Tl.within(effs, auto) == False{} : Bool}:
  match effs:
    case Nil{}:
      shell.ps.absurdF({Tl.within(Nil{}, auto) == False{} : Bool}, has)
    case +x <> +rest:
      ps.within_head(x, rest, auto, c, Nat.is_eq(x, c), {==}, has, out, k => ps.within_out(rest, auto, c, k, out))

def ps.auto_needs_every_effect(+s: Tl.Step, +auto: List<&2, Nat>, +c: Nat, has: {Tl.elem(Tl.Step.effs(s), c) == True{} : Bool}, out: {Bool.and(Tl.grantable(c), Tl.elem(auto, c)) == False{} : Bool}) -> {Tl.auto.at(auto, s) == False{} : Bool}:
  ps.within_out(Tl.Step.effs(s), auto, c, has, out)

# codes 4 and above are not grantable
def ps.big(c: Nat, h: {Nat.is_le(4n, c) == True{} : Bool}) -> {Tl.grantable(c) == False{} : Bool}:
  match c:
    case 0n:
      shell.ps.absurdF({Tl.grantable(0n) == False{} : Bool}, h)
    case 1n+a:
      match a:
        case 0n:
          shell.ps.absurdF({Tl.grantable(1n) == False{} : Bool}, h)
        case 1n+b:
          match b:
            case 0n:
              shell.ps.absurdF({Tl.grantable(2n) == False{} : Bool}, h)
            case 1n+d:
              match d:
                case 0n:
                  shell.ps.absurdF({Tl.grantable(3n) == False{} : Bool}, h)
                case 1n+e:
                  {==}

# a code of 4 and above is not within any auto set
def ps.out_big(+c: Nat, +auto: List<&2, Nat>, h: {Nat.is_le(4n, c) == True{} : Bool}) -> {Bool.and(Tl.grantable(c), Tl.elem(auto, c)) == False{} : Bool}:
  %Equal.sym(Bool, Tl.grantable(c), False{}, ps.big(c, h)) : {Bool.and(_, Tl.elem(auto, c)) == False{} : Bool}
  {==}

def ps.auto_never_sensitive(+s: Tl.Step, +auto: List<&2, Nat>, +c: Nat, has: {Tl.elem(Tl.Step.effs(s), c) == True{} : Bool}, held: {Nat.is_le(4n, c) == True{} : Bool}) -> {Tl.auto.at(auto, s) == False{} : Bool}:
  ps.auto_needs_every_effect(s, auto, c, has, ps.out_big(c, auto, held))

def ps.composed_needs_every_part(+i: Nat, +pre: List<&2, List<&2, Nat>>, +p: List<&2, Nat>, +post: List<&2, List<&2, Nat>>, +auto: List<&2, Nat>, +c: Nat, has: {Tl.elem(p, c) == True{} : Bool}, out: {Bool.and(Tl.grantable(c), Tl.elem(auto, c)) == False{} : Bool}) -> {Tl.auto.at(auto, Tl.Step{i, Tl.join(List.append(&2, List<&2, Nat>, pre, p <> post))}) == False{} : Bool}:
  ps.within_out(Tl.join(List.append(&2, List<&2, Nat>, pre, p <> post)), auto, c, ps.step_holds_every_part(pre, p, post, c, has), out)

# The gate reads within
# ---------------------

def ps.auto_runs_within(+s: Tl.Step, +post: List<&2, Tl.Step>, +auto: List<&2, Nat>, ans: List<&2, Bool>, w: {Tl.within(Tl.Step.effs(s), auto) == True{} : Bool}) -> {Tl.exec(s <> post, auto, ans) == Tl.ran.add(s, Tl.exec(post, auto, ans)) : Tl.Ran}:
  %Equal.sym(Bool, Tl.within(Tl.Step.effs(s), auto), True{}, w) : {Tl.exec.go(s <> post, auto, _, ans) == Tl.ran.add(s, Tl.exec(post, auto, ans)) : Tl.Ran}
  {==}

# a denied step runs nothing and names itself
def ps.gate_den(s: Tl.Step, r: Tl.Ran) -> {Tl.gate(False{}, s, r) == Tl.Ran{Nil{}, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}:
  match s:
    case Tl.Step{i, e}:
      {==}

def ps.held_needs_a_yes(+s: Tl.Step, +post: List<&2, Tl.Step>, +auto: List<&2, Nat>, w: {Tl.within(Tl.Step.effs(s), auto) == False{} : Bool}) -> {Tl.exec(s <> post, auto, Nil{}) == Tl.Ran{Nil{}, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}:
  %Equal.sym(Bool, Tl.within(Tl.Step.effs(s), auto), False{}, w) : {Tl.exec.go(s <> post, auto, _, Nil{}) == Tl.Ran{Nil{}, Tl.Denied{Tl.Step.id(s)}} : Tl.Ran}
  ps.gate_den(s, Tl.Ran{Nil{}, Tl.Finished{}})

# ---- runners ----

# proof_runners: the lemmas PROOF.bend proves the (G4) laws with
# (LAWS.bend section runners), about the model in bend/runners.bend.

# Logic
# -----

def pr.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pr.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : pr.BD(_, A, Unit)
  Unit{}

def pr.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pr.BD(_, Unit, A)
  Unit{}

def pr.MD(m: Maybe<&2, Ru.Tool>, n: Type, s: Type) -> Type:
  match m:
    case None{}:
      n
    case Some{x}:
      s

def runners.pr.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pr.absurdF({b == True{} : Bool}, h)

def runners.pr.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pr.absurdF({False{} == True{} : Bool}, h)

def pr.and_f(a: Bool, +b: Bool, h: {b == False{} : Bool}) -> {Bool.and(a, b) == False{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      {==}

# not a or b, and a: b
def pr.imp(a: Bool, +b: Bool, h: {Bool.or(Bool.not(a), b) == True{} : Bool}, ha: {a == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      pr.absurdF({b == True{} : Bool}, ha)

# The registry
# ------------

# every tool of a covered list that runs code is gated
def pr.cover(xs: List<&2, Ru.Tool>, i: Nat, +t: Ru.Tool, cov: {Ru.covered(xs) == True{} : Bool}, at: {List.get(&2, Ru.Tool, xs, i) == Some{t} : Maybe<&2, Ru.Tool>}, runs: {Ru.runs(t) == True{} : Bool}) -> {Ru.gated(t) == True{} : Bool}:
  match xs:
    case Nil{}:
      %at : pr.MD(_, Unit, {Ru.gated(t) == True{} : Bool})
      Unit{}
    case +x <> +rest:
      match i:
        case 0n:
          +same = Equal.cong(Maybe<&2, Ru.Tool>, Ru.Tool, m => Maybe.default(&2, Ru.Tool, m, t), Some{x}, Some{t}, at)
          %same : {Ru.gated(_) == True{} : Bool}
          pr.imp(Ru.runs(x), Ru.gated(x), runners.pr.and_l(Bool.or(Bool.not(Ru.runs(x)), Ru.gated(x)), Ru.covered(rest), cov), Equal.trans(Bool, Ru.runs(x), Ru.runs(t), True{}, Equal.cong(Ru.Tool, Bool, s => Ru.runs(s), x, t, same), runs))
        case 1n+p:
          pr.cover(rest, p, t, runners.pr.and_r(Bool.or(Bool.not(Ru.runs(x)), Ru.gated(x)), Ru.covered(rest), cov), at, runs)

def pr.covers(chat: Bool, i: Nat, +t: Ru.Tool, at: {List.get(&2, Ru.Tool, Ru.registry(chat), i) == Some{t} : Maybe<&2, Ru.Tool>}, runs: {Ru.runs(t) == True{} : Bool}) -> {Ru.gated(t) == True{} : Bool}:
  match chat:
    case True{}:
      pr.cover(Ru.registry(True{}), i, t, {==}, at, runs)
    case False{}:
      pr.cover(Ru.registry(False{}), i, t, {==}, at, runs)

def pr.ipython(chat: Bool) -> {Ru.find(Ru.registry(chat), "ipython") == Some{Ru.Tool{"ipython", [Ru.exec()], Ru.EachCall{}}} : Maybe<&2, Ru.Tool>}:
  match chat:
    case True{}:
      {==}
    case False{}:
      {==}

# The cell gate
# -------------

def pr.go_only(free: Bool, a: Ru.Asker, ran: {Ru.ran(Ru.cell.go(free, a)) == True{} : Bool}) -> {Bool.or(free, Ru.Asker.yes(a)) == True{} : Bool}:
  match free:
    case True{}:
      {==}
    case False{}:
      match a:
        case Ru.NoClient{}:
          pr.absurdF({False{} == True{} : Bool}, ran)
        case Ru.Silent{}:
          pr.absurdF({False{} == True{} : Bool}, ran)
        case Ru.Says{y}:
          match y:
            case True{}:
              {==}
            case False{}:
              pr.absurdF({False{} == True{} : Bool}, ran)

def pr.only(+caps: List<&2, Nat>, +auto: List<&2, Nat>, +a: Ru.Asker, ran: {Ru.ran(Ru.cell(caps, auto, a)) == True{} : Bool}) -> {Bool.or(Ru.within(caps, auto), Ru.Asker.yes(a)) == True{} : Bool}:
  pr.go_only(Ru.within(caps, auto), a, ran)

def pr.unasked(+caps: List<&2, Nat>, +auto: List<&2, Nat>, a: Ru.Asker, free: {Ru.within(caps, auto) == True{} : Bool}) -> {Ru.cell(caps, auto, a) == Ru.Out{False{}, Ru.Ran{Ru.Auto{}}} : Ru.Out}:
  %Equal.sym(Bool, Ru.within(caps, auto), True{}, free) : {Ru.cell.go(_, a) == Ru.Out{False{}, Ru.Ran{Ru.Auto{}}} : Ru.Out}
  {==}

def pr.approved(+caps: List<&2, Nat>, +auto: List<&2, Nat>, held: {Ru.within(caps, auto) == False{} : Bool}) -> {Ru.cell(caps, auto, Ru.Says{True{}}) == Ru.Out{True{}, Ru.Ran{Ru.Approved{}}} : Ru.Out}:
  %Equal.sym(Bool, Ru.within(caps, auto), False{}, held) : {Ru.cell.go(_, Ru.Says{True{}}) == Ru.Out{True{}, Ru.Ran{Ru.Approved{}}} : Ru.Out}
  {==}

def pr.no_yes(a: Ru.Asker, no: {Ru.Asker.yes(a) == False{} : Bool}) -> {Ru.ran(Ru.cell.go(False{}, a)) == False{} : Bool}:
  match a:
    case Ru.NoClient{}:
      {==}
    case Ru.Silent{}:
      {==}
    case Ru.Says{y}:
      match y:
        case True{}:
          pr.absurdT({True{} == False{} : Bool}, no)
        case False{}:
          {==}

def pr.stops(+caps: List<&2, Nat>, +auto: List<&2, Nat>, +a: Ru.Asker, held: {Ru.within(caps, auto) == False{} : Bool}, no: {Ru.Asker.yes(a) == False{} : Bool}) -> {Ru.ran(Ru.cell(caps, auto, a)) == False{} : Bool}:
  %Equal.sym(Bool, Ru.within(caps, auto), False{}, held) : {Ru.ran(Ru.cell.go(_, a)) == False{} : Bool}
  pr.no_yes(a, no)

# a cap list holding exec is not within an auto set without exec
def pr.exec_asks(caps: List<&2, Nat>, +auto: List<&2, Nat>, has: {Ru.elem(caps, Ru.exec()) == True{} : Bool}, lacks: {Ru.elem(auto, Ru.exec()) == False{} : Bool}) -> {Ru.within(caps, auto) == False{} : Bool}:
  match caps:
    case Nil{}:
      pr.absurdF({True{} == False{} : Bool}, has)
    case +c <> +rest:
      match c:
        case 0n:
          pr.and_f(Bool.and(Ru.grantable(0n), Ru.elem(auto, 0n)), Ru.within(rest, auto), pr.exec_asks(rest, auto, has, lacks))
        case 1n+p:
          match p:
            case 0n:
              pr.and_f(Bool.and(Ru.grantable(1n), Ru.elem(auto, 1n)), Ru.within(rest, auto), pr.exec_asks(rest, auto, has, lacks))
            case 1n+q:
              match q:
                case 0n:
                  %Equal.sym(Bool, Ru.elem(auto, 2n), False{}, lacks) : {Bool.and(Bool.and(True{}, _), Ru.within(rest, auto)) == False{} : Bool}
                  {==}
                case 1n+r:
                  pr.and_f(Bool.and(Ru.grantable(3n+r), Ru.elem(auto, 3n+r)), Ru.within(rest, auto), pr.exec_asks(rest, auto, has, lacks))

# ---- approvals ----

# proof_approvals: the lemmas PROOF.bend proves the (G5) laws with
# (LAWS.bend section approvals), about the model in bend/approvals.bend.

# Logic
# -----

def approvals.pa.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def approvals.pa.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : approvals.pa.BD(_, A, Unit)
  Unit{}

def approvals.pa.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : approvals.pa.BD(_, Unit, A)
  Unit{}

# Unanswered{} is A, an answer or a ruling is Unit
def pa.ED(e: Am.End, a: Type, u: Type) -> Type:
  match e:
    case Am.Answered{x, y}:
      u
    case Am.Unanswered{}:
      a
    case Am.Ruled{x}:
      u

def pa.absurdE(-A: Type, -x: Nat, -y: Bool, e: {Am.Answered{x, y} == Am.Unanswered{} : Am.End}) -> A:
  %e : pa.ED(_, A, Unit)
  Unit{}

def pa.absurdR(-A: Type, -x: Nat, e: {Am.Ruled{x} == Am.Unanswered{} : Am.End}) -> A:
  %e : pa.ED(_, A, Unit)
  Unit{}

# Outcomes
# --------

def pa.end_up(o: Am.Out) -> {Am.Out.end(Am.Out.up(o)) == Am.End.up(Am.Out.end(o)) : Am.End}:
  match o:
    case Am.Out{s, e}:
      {==}

def pa.end_first(o: Am.Out) -> {Am.Out.end(Am.Out.first(o)) == Am.Out.end(o) : Am.End}:
  match o:
    case Am.Out{s, e}:
      {==}

# the end of a parent's outcome seen from its child, by the parent's end
def pa.end_up_is(+o: Am.Out, -e: Am.End, h: {Am.Out.end(o) == e : Am.End}) -> {Am.Out.end(Am.Out.up(o)) == Am.End.up(e) : Am.End}:
  Equal.trans(Am.End, Am.Out.end(Am.Out.up(o)), Am.End.up(Am.Out.end(o)), Am.End.up(e), pa.end_up(o), Equal.cong(Am.End, Am.End, x => Am.End.up(x), Am.Out.end(o), e, h))

# so for a session that showed the question first
def pa.end_first_up_is(+o: Am.Out, -e: Am.End, h: {Am.Out.end(o) == e : Am.End}) -> {Am.Out.end(Am.Out.first(Am.Out.up(o))) == Am.End.up(e) : Am.End}:
  Equal.trans(Am.End, Am.Out.end(Am.Out.first(Am.Out.up(o))), Am.Out.end(Am.Out.up(o)), Am.End.up(e), pa.end_first(Am.Out.up(o)), pa.end_up_is(o, e, h))

# a parent's end that is unanswered from its child is unanswered
def pa.up_unanswered(e: Am.End, h: {Am.End.up(e) == Am.Unanswered{} : Am.End}) -> {e == Am.Unanswered{} : Am.End}:
  match e:
    case Am.Answered{x, y}:
      pa.absurdE({Am.Answered{x, y} == Am.Unanswered{} : Am.End}, 1n+x, y, h)
    case Am.Unanswered{}:
      {==}
    case Am.Ruled{x}:
      pa.absurdR({Am.Ruled{x} == Am.Unanswered{} : Am.End}, 1n+x, h)

# The laws
# --------

def pa.nearest(+below: List<&2, Am.Desk>, quiet: {Am.quiet(below) == True{} : Bool}, +yes: Bool, +above: List<&2, Am.Desk>) -> {Am.Out.end(Am.route(List.append(&2, Am.Desk, below, Am.Says{yes} <> above))) == Am.Answered{List.length(&2, Am.Desk, below), yes} : Am.End}:
  match below:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Am.Away{}:
          pa.end_up_is(Am.route(List.append(&2, Am.Desk, rest, Am.Says{yes} <> above)), Am.Answered{List.length(&2, Am.Desk, rest), yes}, pa.nearest(rest, quiet, yes, above))
        case Am.Left{}:
          pa.end_first_up_is(Am.route(List.append(&2, Am.Desk, rest, Am.Says{yes} <> above)), Am.Answered{List.length(&2, Am.Desk, rest), yes}, pa.nearest(rest, quiet, yes, above))
        case Am.Says{z}:
          approvals.pa.absurdF({Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.Says{z} <> rest, Am.Says{yes} <> above))) == Am.Answered{List.length(&2, Am.Desk, Am.Says{z} <> rest), yes} : Am.End}, quiet)
        case Am.Phone{}:
          approvals.pa.absurdF({Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.Phone{} <> rest, Am.Says{yes} <> above))) == Am.Answered{List.length(&2, Am.Desk, Am.Phone{} <> rest), yes} : Am.End}, quiet)
        case Am.PhoneLeft{}:
          approvals.pa.absurdF({Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.PhoneLeft{} <> rest, Am.Says{yes} <> above))) == Am.Answered{List.length(&2, Am.Desk, Am.PhoneLeft{} <> rest), yes} : Am.End}, quiet)

def pa.root(+below: List<&2, Am.Desk>, quiet: {Am.quiet(below) == True{} : Bool}, +yes: Bool) -> {Am.Out.end(Am.route(List.append(&2, Am.Desk, below, [Am.Says{yes}]))) == Am.Answered{List.length(&2, Am.Desk, below), yes} : Am.End}:
  pa.nearest(below, quiet, yes, Nil{})

def pa.only_quiet(+ds: List<&2, Am.Desk>, none: {Am.Out.end(Am.route(ds)) == Am.Unanswered{} : Am.End}) -> {Am.quiet(ds) == True{} : Bool}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Am.Away{}:
          pa.only_quiet(rest, pa.up_unanswered(Am.Out.end(Am.route(rest)), Equal.trans(Am.End, Am.End.up(Am.Out.end(Am.route(rest))), Am.Out.end(Am.Out.up(Am.route(rest))), Am.Unanswered{}, Equal.sym(Am.End, Am.Out.end(Am.Out.up(Am.route(rest))), Am.End.up(Am.Out.end(Am.route(rest))), pa.end_up(Am.route(rest))), none)))
        case Am.Left{}:
          pa.only_quiet(rest, pa.up_unanswered(Am.Out.end(Am.route(rest)), Equal.trans(Am.End, Am.End.up(Am.Out.end(Am.route(rest))), Am.Out.end(Am.Out.first(Am.Out.up(Am.route(rest)))), Am.Unanswered{}, Equal.sym(Am.End, Am.Out.end(Am.Out.first(Am.Out.up(Am.route(rest)))), Am.End.up(Am.Out.end(Am.route(rest))), Equal.trans(Am.End, Am.Out.end(Am.Out.first(Am.Out.up(Am.route(rest)))), Am.Out.end(Am.Out.up(Am.route(rest))), Am.End.up(Am.Out.end(Am.route(rest))), pa.end_first(Am.Out.up(Am.route(rest))), pa.end_up(Am.route(rest)))), none)))
        case Am.Says{y}:
          pa.absurdE({Am.quiet(Am.Says{y} <> rest) == True{} : Bool}, 0n, y, none)
        case Am.Phone{}:
          pa.absurdR({Am.quiet(Am.Phone{} <> rest) == True{} : Bool}, 0n, none)
        case Am.PhoneLeft{}:
          pa.absurdR({Am.quiet(Am.PhoneLeft{} <> rest) == True{} : Bool}, 0n, none)

def pa.quiet_none(+ds: List<&2, Am.Desk>, quiet: {Am.quiet(ds) == True{} : Bool}) -> {Am.Out.end(Am.route(ds)) == Am.Unanswered{} : Am.End}:
  match ds:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Am.Away{}:
          pa.end_up_is(Am.route(rest), Am.Unanswered{}, pa.quiet_none(rest, quiet))
        case Am.Left{}:
          pa.end_first_up_is(Am.route(rest), Am.Unanswered{}, pa.quiet_none(rest, quiet))
        case Am.Says{y}:
          approvals.pa.absurdF({Am.Out.end(Am.route(Am.Says{y} <> rest)) == Am.Unanswered{} : Am.End}, quiet)
        case Am.Phone{}:
          approvals.pa.absurdF({Am.Out.end(Am.route(Am.Phone{} <> rest)) == Am.Unanswered{} : Am.End}, quiet)
        case Am.PhoneLeft{}:
          approvals.pa.absurdF({Am.Out.end(Am.route(Am.PhoneLeft{} <> rest)) == Am.Unanswered{} : Am.End}, quiet)

# The gateway rule
# ----------------

def pa.never_waits(+above: List<&2, Am.Desk>) -> {Am.route(Am.Phone{} <> above) == Am.Out{Nil{}, Am.Ruled{0n}} : Am.Out}:
  {==}

def pa.left_to_gateway(+above: List<&2, Am.Desk>) -> {Am.route(Am.PhoneLeft{} <> above) == Am.Out{[0n], Am.Ruled{0n}} : Am.Out}:
  {==}

# the guard refuses when its first part holds
def pa.guard_first(b1: Bool, b2: Bool, h: {b1 == True{} : Bool}) -> {Am.guard(Bool.or(b1, b2)) == Am.GatewayRefused{} : Am.Fate}:
  match b1:
    case True{}:
      {==}
    case False{}:
      approvals.pa.absurdF({Am.guard(Bool.or(False{}, b2)) == Am.GatewayRefused{} : Am.Fate}, h)

# and when its second part holds
def pa.guard_second(b1: Bool, b2: Bool, h: {b2 == True{} : Bool}) -> {Am.guard(Bool.or(b1, b2)) == Am.GatewayRefused{} : Am.Fate}:
  match b1:
    case True{}:
      {==}
    case False{}:
      match b2:
        case True{}:
          {==}
        case False{}:
          approvals.pa.absurdF({Am.guard(Bool.or(False{}, False{})) == Am.GatewayRefused{} : Am.Fate}, h)

# it lets the step run when neither holds
def pa.guard_neither(b1: Bool, b2: Bool, h1: {b1 == False{} : Bool}, h2: {b2 == False{} : Bool}) -> {Am.guard(Bool.or(b1, b2)) == Am.Runs{} : Am.Fate}:
  match b1:
    case True{}:
      approvals.pa.absurdT({Am.guard(Bool.or(True{}, b2)) == Am.Runs{} : Am.Fate}, h1)
    case False{}:
      match b2:
        case True{}:
          approvals.pa.absurdT({Am.guard(Bool.or(False{}, True{})) == Am.Runs{} : Am.Fate}, h2)
        case False{}:
          {==}

def pa.refuses_protected(+es: List<&2, Nat>, protected: {Tl.elem(es, 5n) == True{} : Bool}, +above: List<&2, Am.Desk>) -> {Am.fate(es, Am.Out.end(Am.route(Am.Phone{} <> above))) == Am.GatewayRefused{} : Am.Fate}:
  pa.guard_first(Tl.elem(es, 5n), Tl.elem(es, 6n), protected)

def pa.refuses_secret(+es: List<&2, Nat>, secret: {Tl.elem(es, 6n) == True{} : Bool}, +above: List<&2, Am.Desk>) -> {Am.fate(es, Am.Out.end(Am.route(Am.Phone{} <> above))) == Am.GatewayRefused{} : Am.Fate}:
  pa.guard_second(Tl.elem(es, 5n), Tl.elem(es, 6n), secret)

def pa.runs_the_rest(+es: List<&2, Nat>, not_protected: {Tl.elem(es, 5n) == False{} : Bool}, not_secret: {Tl.elem(es, 6n) == False{} : Bool}, +above: List<&2, Am.Desk>) -> {Am.fate(es, Am.Out.end(Am.route(Am.Phone{} <> above))) == Am.Runs{} : Am.Fate}:
  pa.guard_neither(Tl.elem(es, 5n), Tl.elem(es, 6n), not_protected, not_secret)

# a step fares the same whichever session's end it is seen from
def pa.fate_up(+es: List<&2, Nat>, e: Am.End) -> {Am.fate(es, Am.End.up(e)) == Am.fate(es, e) : Am.Fate}:
  match e:
    case Am.Answered{a, y}:
      {==}
    case Am.Unanswered{}:
      {==}
    case Am.Ruled{a}:
      {==}

# so for a session that hands the question up
def pa.fate_up_is(+es: List<&2, Nat>, +o: Am.Out, -t: Am.Fate, h: {Am.fate(es, Am.Out.end(o)) == t : Am.Fate}) -> {Am.fate(es, Am.Out.end(Am.Out.up(o))) == t : Am.Fate}:
  match o:
    case Am.Out{s, e}:
      Equal.trans(Am.Fate, Am.fate(es, Am.End.up(e)), Am.fate(es, e), t, pa.fate_up(es, e), h)

# and for one that showed it first
def pa.fate_first_up_is(+es: List<&2, Nat>, +o: Am.Out, -t: Am.Fate, h: {Am.fate(es, Am.Out.end(o)) == t : Am.Fate}) -> {Am.fate(es, Am.Out.end(Am.Out.first(Am.Out.up(o)))) == t : Am.Fate}:
  match o:
    case Am.Out{s, e}:
      Equal.trans(Am.Fate, Am.fate(es, Am.End.up(e)), Am.fate(es, e), t, pa.fate_up(es, e), h)

def pa.subagent(+below: List<&2, Am.Desk>, quiet: {Am.quiet(below) == True{} : Bool}, +es: List<&2, Nat>, +above: List<&2, Am.Desk>) -> {Am.fate(es, Am.Out.end(Am.route(List.append(&2, Am.Desk, below, Am.Phone{} <> above)))) == Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))) : Am.Fate}:
  match below:
    case Nil{}:
      {==}
    case d <> rest:
      match d:
        case Am.Away{}:
          pa.fate_up_is(es, Am.route(List.append(&2, Am.Desk, rest, Am.Phone{} <> above)), Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))), pa.subagent(rest, quiet, es, above))
        case Am.Left{}:
          pa.fate_first_up_is(es, Am.route(List.append(&2, Am.Desk, rest, Am.Phone{} <> above)), Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))), pa.subagent(rest, quiet, es, above))
        case Am.Says{z}:
          approvals.pa.absurdF({Am.fate(es, Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.Says{z} <> rest, Am.Phone{} <> above)))) == Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))) : Am.Fate}, quiet)
        case Am.Phone{}:
          approvals.pa.absurdF({Am.fate(es, Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.Phone{} <> rest, Am.Phone{} <> above)))) == Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))) : Am.Fate}, quiet)
        case Am.PhoneLeft{}:
          approvals.pa.absurdF({Am.fate(es, Am.Out.end(Am.route(List.append(&2, Am.Desk, Am.PhoneLeft{} <> rest, Am.Phone{} <> above)))) == Am.fate(es, Am.Out.end(Am.route([Am.Phone{}]))) : Am.Fate}, quiet)

# The auto set
# ------------

def pa.default_auto(+c: Nat) -> {Tl.elem(Am.default_auto(), c) == Tl.grantable(c) : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+d:
              match d:
                case 0n:
                  {==}
                case 1n+e:
                  {==}

# a step not within the auto set goes its route
def pa.gate_routed(w: Bool, +es: List<&2, Nat>, +ds: List<&2, Am.Desk>, h: {w == False{} : Bool}) -> {Am.gate.by(w, es, ds) == Am.routed(es, Am.route(ds)) : Am.Gated}:
  match w:
    case True{}:
      approvals.pa.absurdT({Am.gate.by(True{}, es, ds) == Am.routed(es, Am.route(ds)) : Am.Gated}, h)
    case False{}:
      {==}

def pa.never_auto(+auto: List<&2, Nat>, +es: List<&2, Nat>, +c: Nat, has: {Tl.elem(es, c) == True{} : Bool}, held: {Nat.is_le(4n, c) == True{} : Bool}, +ds: List<&2, Am.Desk>) -> {Am.gate(auto, es, ds) == Am.routed(es, Am.route(ds)) : Am.Gated}:
  pa.gate_routed(Tl.within(es, auto), es, ds, ps.auto_never_sensitive(Tl.Step{0n, es}, auto, c, has, held))

def pa.never_auto_asks(+auto: List<&2, Nat>, +es: List<&2, Nat>, +c: Nat, has: {Tl.elem(es, c) == True{} : Bool}, held: {Nat.is_le(4n, c) == True{} : Bool}, +yes: Bool, +above: List<&2, Am.Desk>) -> {Am.gate(auto, es, Am.Says{yes} <> above) == Am.Routed{Am.Out{[0n], Am.Answered{0n, yes}}, Am.yes.fate(yes)} : Am.Gated}:
  pa.never_auto(auto, es, c, has, held, Am.Says{yes} <> above)

# the gateway's outcome as the gate gives it
def pa.phone_gate(+auto: List<&2, Nat>, +es: List<&2, Nat>, +above: List<&2, Am.Desk>, -f: Am.Fate, w: {Tl.within(es, auto) == False{} : Bool}, r: {Am.rule(es) == f : Am.Fate}) -> {Am.gate(auto, es, Am.Phone{} <> above) == Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, f} : Am.Gated}:
  Equal.trans(Am.Gated, Am.gate(auto, es, Am.Phone{} <> above), Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, Am.rule(es)}, Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, f}, pa.gate_routed(Tl.within(es, auto), es, Am.Phone{} <> above, w), Equal.cong(Am.Fate, Am.Gated, x => Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, x}, Am.rule(es), f, r))

def pa.outside_by_gateway(+auto: List<&2, Nat>, +es: List<&2, Nat>, outside: {Tl.elem(es, 4n) == True{} : Bool}, not_protected: {Tl.elem(es, 5n) == False{} : Bool}, not_secret: {Tl.elem(es, 6n) == False{} : Bool}, +above: List<&2, Am.Desk>) -> {Am.gate(auto, es, Am.Phone{} <> above) == Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, Am.Runs{}} : Am.Gated}:
  pa.phone_gate(auto, es, above, Am.Runs{}, ps.auto_never_sensitive(Tl.Step{0n, es}, auto, 4n, outside, {==}), pa.guard_neither(Tl.elem(es, 5n), Tl.elem(es, 6n), not_protected, not_secret))

# a guarded step is never within the auto set
def pa.guarded_not_within(+auto: List<&2, Nat>, +es: List<&2, Nat>, b1: Bool, e1: {Tl.elem(es, 5n) == b1 : Bool}, b2: Bool, e2: {Tl.elem(es, 6n) == b2 : Bool}, g: {Bool.or(b1, b2) == True{} : Bool}) -> {Tl.within(es, auto) == False{} : Bool}:
  match b1:
    case True{}:
      ps.auto_never_sensitive(Tl.Step{0n, es}, auto, 5n, e1, {==})
    case False{}:
      match b2:
        case True{}:
          ps.auto_never_sensitive(Tl.Step{0n, es}, auto, 6n, e2, {==})
        case False{}:
          approvals.pa.absurdF({Tl.within(es, auto) == False{} : Bool}, g)

def pa.guard_true(b: Bool, h: {b == True{} : Bool}) -> {Am.guard(b) == Am.GatewayRefused{} : Am.Fate}:
  match b:
    case True{}:
      {==}
    case False{}:
      approvals.pa.absurdF({Am.guard(False{}) == Am.GatewayRefused{} : Am.Fate}, h)

def pa.guarded_from_phone(+auto: List<&2, Nat>, +es: List<&2, Nat>, +guarded: {Bool.or(Tl.elem(es, 5n), Tl.elem(es, 6n)) == True{} : Bool}, +above: List<&2, Am.Desk>) -> {Am.gate(auto, es, Am.Phone{} <> above) == Am.Routed{Am.Out{Nil{}, Am.Ruled{0n}}, Am.GatewayRefused{}} : Am.Gated}:
  pa.phone_gate(auto, es, above, Am.GatewayRefused{}, pa.guarded_not_within(auto, es, Tl.elem(es, 5n), {==}, Tl.elem(es, 6n), {==}, guarded), pa.guard_true(Bool.or(Tl.elem(es, 5n), Tl.elem(es, 6n)), guarded))

# ---- retry_policy ----

# proof_retry_policy: the laws of LAWS.bend section retry over the model in
# bend/retry.bend. Most decisions are a match on their inputs, so most
# laws follow by case analysis. A clash of two values is refuted with a
# motive that sends the expected value to the goal and the other to Unit.
#
# - retry_never_parked, retry_never_limit, retry_status_first: the park
#   and the limit are matched first; then each side computes to the same
#   value.
# - retry_never_client_error, retry_server_errors, retry_only_retryable:
#   a helper takes the result of `Nat.is_lt(s, 500n)` as a Bool with its
#   equation, and matches on it. Below 500, the status must be listed;
#   at 500 or more, the status is a server error.
# - retry_kind_before_text: a known kind has a class that is not Unsure,
#   so the text is not read.
# - retry_after_respected: the wait is `Nat.max(jitter, s)`, and
#   `Nat.max_ge_r` gives that it is at least s. A refused wait sends no
#   retry.
# - retry_refuses_past_cap: the two premises make the refusal test True.
# - The failover laws: each pick (`pick.fresh`, `pick.back`) is shown, by
#   induction on its order list, to give only a switch that satisfies its
#   own Bool condition (the equation of the condition goes into
#   `pick.sel`); its switch is never the last provider, since the order
#   holds no last (`rp.order_notin`: the order's first part is above
#   last, its second part below it). `next` then goes through `next.last`, `next.budget` and
#   `next.mode` with the equations of the last attempt, the budget and
#   the all-seen test. From these facts, `good` gets the five `Switch`
#   checks together; each failover law takes one of them.
# - deferred_pays_once, deferred_bounded_in_time: a step never sends
#   while the job is live, and never polls a live job with 0 ms left.
#   Induction over the replies, with any start tally, shows that the run
#   adds 0 to each count.
# - deferred_failed_poll_repolls: the two premises make the repoll test
#   True.
# - stall_retry_extends: idle < idle + idle when idle > 0.
# - stall_detection_bounded: induction over the events, with any start
#   time: a stall ends at the last event plus the deadline, a close at
#   the last event, which is at most it plus the deadline.
# - stall_silent_ends_at_deadline: by computation.

# Clashes
# -------

def rp.BD(b: Bool, A: Type) -> Type:
  match b:
    case True{}:
      A
    case False{}:
      Unit

def rp.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : rp.BD(_, A)
  Unit{}

def rp.ND(b: Bool, A: Type) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      A

def rp.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : rp.ND(_, A)
  Unit{}

# Bools
# -----

def rp.or_l(a: Bool, -b: Bool, ea: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      rp.absurdF({Bool.or(False{}, b) == True{} : Bool}, ea)

def rp.or_r(a: Bool, -b: Bool, eb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      eb

def rp.or_ff(a: Bool, b: Bool, ea: {a == False{} : Bool}, eb: {b == False{} : Bool}) -> {Bool.or(a, b) == False{} : Bool}:
  match a:
    case True{}:
      rp.absurdT({Bool.or(True{}, b) == False{} : Bool}, ea)
    case False{}:
      eb

def rp.and_tt(a: Bool, -b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      eb
    case False{}:
      rp.absurdF({Bool.and(False{}, b) == True{} : Bool}, ea)

def rp.and_l(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      rp.absurdF({False{} == True{} : Bool}, e)

def rp.and_r(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      e
    case False{}:
      rp.absurdF({b == True{} : Bool}, e)

# Numbers
# -------

def rp.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      rp.eq_refl(p)

def rp.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      rp.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      rp.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, rp.eq_true(p, q, h))

def rp.cmp_ge(c: Cmp, e: {Cmp.is_lt(c) == False{} : Bool}) -> {Cmp.is_ge(c) == True{} : Bool}:
  match c:
    case LT{}:
      rp.absurdT({False{} == True{} : Bool}, e)
    case EQ{}:
      {==}
    case GT{}:
      {==}

def rp.ge_of_not_lt(+a: Nat, +b: Nat, e: {Nat.is_lt(a, b) == False{} : Bool}) -> {Nat.is_ge(a, b) == True{} : Bool}:
  rp.cmp_ge(Nat.cmp(a, b), e)

def rp.le_zero(n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def rp.add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %rp.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def rp.add_none(+s: Nat, +x: Nat, e: {x == 0n : Nat}) -> {Nat.add(s, x) == s : Nat}:
  %Equal.sym(Nat, x, 0n, e) : {Nat.add(s, _) == s : Nat}
  rp.add_zero(s)

def rp.lt_add_succ(k: Nat, +j: Nat) -> {Nat.is_lt(k, Nat.add(k, 1n+j)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      rp.lt_add_succ(p, j)

# (R1) The classifier
# -------------------

def never_parked(limit: Bool, status: Maybe<&2, Nat>, kind: Maybe<&2, R.Cause>, text: Bool) -> {R.retryable(R.Facts{True{}, limit, status, kind, text}) == False{} : Bool}:
  {==}

def never_limit(parked: Bool, status: Maybe<&2, Nat>, kind: Maybe<&2, R.Cause>, text: Bool) -> {R.retryable(R.Facts{parked, True{}, status, kind, text}) == False{} : Bool}:
  match parked:
    case True{}:
      {==}
    case False{}:
      {==}

def rp.client(lt: Bool, +s: Nat, below: {lt == True{} : Bool}, n408: {Nat.is_eq(s, 408n) == False{} : Bool}, n409: {Nat.is_eq(s, 409n) == False{} : Bool}, n429: {Nat.is_eq(s, 429n) == False{} : Bool}) -> {R.status.ok.go(lt, s) == False{} : Bool}:
  match lt:
    case True{}:
      rp.or_ff(Nat.is_eq(s, 408n), Bool.or(Nat.is_eq(s, 409n), Nat.is_eq(s, 429n)), n408, rp.or_ff(Nat.is_eq(s, 409n), Nat.is_eq(s, 429n), n409, n429))
    case False{}:
      rp.absurdF({R.status.ok.go(False{}, s) == False{} : Bool}, below)

def never_client_error(parked: Bool, limit: Bool, kind: Maybe<&2, R.Cause>, text: Bool, +s: Nat, below: {Nat.is_lt(s, 500n) == True{} : Bool}, n408: {Nat.is_eq(s, 408n) == False{} : Bool}, n409: {Nat.is_eq(s, 409n) == False{} : Bool}, n429: {Nat.is_eq(s, 429n) == False{} : Bool}) -> {R.retryable(R.Facts{parked, limit, Some{s}, kind, text}) == False{} : Bool}:
  match parked limit:
    case True{} l:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      rp.client(Nat.is_lt(s, 500n), s, below, n408, n409, n429)

def rp.only(lt: Bool, +s: Nat, elt: {Nat.is_lt(s, 500n) == lt : Bool}, r: {R.status.ok.go(lt, s) == True{} : Bool}) -> {Bool.or(Nat.is_ge(s, 500n), R.status.listed(s)) == True{} : Bool}:
  match lt:
    case True{}:
      rp.or_r(Nat.is_ge(s, 500n), R.status.listed(s), r)
    case False{}:
      rp.or_l(Nat.is_ge(s, 500n), R.status.listed(s), rp.ge_of_not_lt(s, 500n, elt))

def only_retryable(parked: Bool, limit: Bool, kind: Maybe<&2, R.Cause>, text: Bool, +s: Nat, retried: {R.retryable(R.Facts{parked, limit, Some{s}, kind, text}) == True{} : Bool}) -> {Bool.or(Nat.is_ge(s, 500n), R.status.listed(s)) == True{} : Bool}:
  match parked limit:
    case True{} l:
      rp.absurdF({Bool.or(Nat.is_ge(s, 500n), R.status.listed(s)) == True{} : Bool}, retried)
    case False{} True{}:
      rp.absurdF({Bool.or(Nat.is_ge(s, 500n), R.status.listed(s)) == True{} : Bool}, retried)
    case False{} False{}:
      rp.only(Nat.is_lt(s, 500n), s, {==}, retried)

def status_first(parked: Bool, limit: Bool, +s: Nat, k1: Maybe<&2, R.Cause>, t1: Bool, k2: Maybe<&2, R.Cause>, t2: Bool) -> {R.retryable(R.Facts{parked, limit, Some{s}, k1, t1}) == R.retryable(R.Facts{parked, limit, Some{s}, k2, t2}) : Bool}:
  match parked limit:
    case True{} l:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def rp.known(k: R.Cause, known: {R.Cause.known(k) == True{} : Bool}, t1: Bool, t2: Bool) -> {R.by_class(R.Cause.class(k), t1) == R.by_class(R.Cause.class(k), t2) : Bool}:
  match k:
    case R.Unknown{}:
      rp.absurdF({t1 == t2 : Bool}, known)
    case R.Refusal{}:
      {==}
    case R.Safety{}:
      {==}
    case R.PaymentRequired{}:
      {==}
    case R.Overloaded{}:
      {==}
    case R.RateLimit{}:
      {==}
    case R.ServerError{}:
      {==}
    case R.Auth{}:
      {==}
    case R.Permission{}:
      {==}
    case R.InvalidRequest{}:
      {==}
    case R.MalformedResponse{}:
      {==}
    case R.StreamDrop{}:
      {==}
    case R.StreamStalled{}:
      {==}
    case R.StreamRepeating{}:
      {==}

def kind_before_text(parked: Bool, limit: Bool, k: R.Cause, known: {R.Cause.known(k) == True{} : Bool}, t1: Bool, t2: Bool) -> {R.retryable(R.Facts{parked, limit, None{}, Some{k}, t1}) == R.retryable(R.Facts{parked, limit, None{}, Some{k}, t2}) : Bool}:
  match parked limit:
    case True{} l:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      rp.known(k, known, t1, t2)

def rp.server(lt: Bool, +s: Nat, e: {lt == False{} : Bool}) -> {R.status.ok.go(lt, s) == True{} : Bool}:
  match lt:
    case True{}:
      rp.absurdT({R.status.ok.go(True{}, s) == True{} : Bool}, e)
    case False{}:
      {==}

def server_errors(kind: Maybe<&2, R.Cause>, text: Bool, +s: Nat, server: {Nat.is_lt(s, 500n) == False{} : Bool}) -> {R.retryable(R.Facts{False{}, False{}, Some{s}, kind, text}) == True{} : Bool}:
  rp.server(Nat.is_lt(s, 500n), s, server)

# (R2) The wait
# -------------

def rp.after(over: Bool, +jitter: Nat, +s: Nat, +cap: Nat) -> {R.Delay.respects(R.wait.server(over, jitter, s, cap), s) == True{} : Bool}:
  match over:
    case True{}:
      {==}
    case False{}:
      Nat.max_ge_r(jitter, s)

def after_respected(+jitter: Nat, +s: Nat, +cap: Nat) -> {R.Delay.respects(R.wait(jitter, Some{s}, cap), s) == True{} : Bool}:
  rp.after(Bool.and(Nat.is_gt(cap, 0n), Nat.is_gt(s, cap)), jitter, s, cap)

def rp.refuse(over: Bool, +jitter: Nat, +s: Nat, +cap: Nat, e: {over == True{} : Bool}) -> {R.wait.server(over, jitter, s, cap) == R.Refused{s, cap} : R.Delay}:
  match over:
    case True{}:
      {==}
    case False{}:
      rp.absurdF({R.wait.server(False{}, jitter, s, cap) == R.Refused{s, cap} : R.Delay}, e)

def refuses_past_cap(+jitter: Nat, +s: Nat, +cap: Nat, capped: {Nat.is_gt(cap, 0n) == True{} : Bool}, over: {Nat.is_gt(s, cap) == True{} : Bool}) -> {R.wait(jitter, Some{s}, cap) == R.Refused{s, cap} : R.Delay}:
  rp.refuse(Bool.and(Nat.is_gt(cap, 0n), Nat.is_gt(s, cap)), jitter, s, cap, rp.and_tt(Nat.is_gt(cap, 0n), Nat.is_gt(s, cap), capped, over))

# (R3) The failover walk
# ----------------------

# what pick.fresh guarantees of its switch: no wait, not the last
# provider, not tried
def rp.fresh_ok(m: Maybe<&2, R.Switch>, +last: Nat, +ts: List<&2, R.Tried>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{s}:
      match s:
        case R.Switch{+to, d}:
          Bool.and(Nat.is_eq(d, 0n), Bool.and(Bool.not(Nat.is_eq(to, last)), Bool.not(R.seen(to, ts))))

# Order
# -----

# last is no element of xs
def rp.notin(+last: Nat, xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case x <> rest:
      Bool.and(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest))

def rp.not_of_false(b: Bool, e: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  match b:
    case True{}:
      rp.absurdT({Bool.not(True{}) == True{} : Bool}, e)
    case False{}:
      {==}

def rp.ne_of_lt(+last: Nat, +a: Nat, h: {Nat.is_lt(last, a) == True{} : Bool}) -> {Nat.is_eq(a, last) == False{} : Bool}:
  match last a:
    case 0n 0n:
      rp.absurdF({Nat.is_eq(0n, 0n) == False{} : Bool}, h)
    case 0n 1n+p:
      {==}
    case 1n+q 0n:
      rp.absurdF({Nat.is_eq(0n, 1n+q) == False{} : Bool}, h)
    case 1n+q 1n+p:
      rp.ne_of_lt(q, p, h)

def rp.lt_succ(+last: Nat, +a: Nat, h: {Nat.is_lt(last, a) == True{} : Bool}) -> {Nat.is_lt(last, 1n+a) == True{} : Bool}:
  match last a:
    case 0n a:
      {==}
    case 1n+q 0n:
      rp.absurdF({Nat.is_lt(1n+q, 1n) == True{} : Bool}, h)
    case 1n+q 1n+p:
      rp.lt_succ(q, p, h)

def rp.lt_self(n: Nat) -> {Nat.is_lt(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      rp.lt_self(p)

# every element of upto(k, a) is at least a, so above last
def rp.notin_above(k: Nat, +a: Nat, +last: Nat, +h: {Nat.is_lt(last, a) == True{} : Bool}) -> {rp.notin(last, R.upto(k, a)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+j:
      rp.and_tt(Bool.not(Nat.is_eq(a, last)), rp.notin(last, R.upto(j, 1n+a)), rp.not_of_false(Nat.is_eq(a, last), rp.ne_of_lt(last, a, h)), rp.notin_above(j, 1n+a, last, rp.lt_succ(last, a, h)))

# shifting the list and last by one keeps the answer
def rp.notin_shift(k: Nat, +a: Nat, +last: Nat) -> {rp.notin(1n+last, R.upto(k, 1n+a)) == rp.notin(last, R.upto(k, a)) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+j:
      %rp.notin_shift(j, 1n+a, last) : {Bool.and(Bool.not(Nat.is_eq(a, last)), rp.notin(1n+last, R.upto(j, 2n+a))) == Bool.and(Bool.not(Nat.is_eq(a, last)), _) : Bool}
      {==}

# every element of upto(k, 0) is below k, so below last when k <= last
def rp.notin_below(+k: Nat, +last: Nat, h: {Nat.is_le(k, last) == True{} : Bool}) -> {rp.notin(last, R.upto(k, 0n)) == True{} : Bool}:
  match k last:
    case 0n l:
      {==}
    case 1n+j 0n:
      rp.absurdF({rp.notin(0n, R.upto(1n+j, 0n)) == True{} : Bool}, h)
    case 1n+j 1n+q:
      %Equal.sym(Bool, rp.notin(1n+q, R.upto(j, 1n)), rp.notin(q, R.upto(j, 0n)), rp.notin_shift(j, 0n, q)) : {_ == True{} : Bool}
      rp.notin_below(j, q, h)

def rp.min_le(+a: Nat, +b: Nat) -> {Nat.is_le(Nat.min(a, b), a) == True{} : Bool}:
  match a b:
    case 0n b:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      rp.min_le(p, q)

def rp.notin_append(+last: Nat, xs: List<&2, Nat>, +ys: List<&2, Nat>, +hx: {rp.notin(last, xs) == True{} : Bool}, hy: {rp.notin(last, ys) == True{} : Bool}) -> {rp.notin(last, List.append(&2, Nat, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hy
    case +x <> +rest:
      ne = rp.and_l(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), hx)
      nr = rp.and_r(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), hx)
      rp.and_tt(Bool.not(Nat.is_eq(x, last)), rp.notin(last, List.append(&2, Nat, rest, ys)), ne, rp.notin_append(last, rest, ys, nr, hy))

# the chain order after last never holds last
def rp.order_notin(+last: Nat, +len: Nat) -> {rp.notin(last, R.order(last, len)) == True{} : Bool}:
  rp.notin_append(last, R.upto(Nat.sub(len, 1n+last), 1n+last), R.upto(Nat.min(last, len), 0n), rp.notin_above(Nat.sub(len, 1n+last), 1n+last, last, rp.lt_self(last)), rp.notin_below(Nat.min(last, len), last, rp.min_le(last, len)))

# The picks
# ---------

def rp.fresh_sel(c: Bool, +x: Nat, +last: Nat, +ts: List<&2, R.Tried>, r: Maybe<&2, R.Switch>, ec: {Bool.not(R.seen(x, ts)) == c : Bool}, ne: {Bool.not(Nat.is_eq(x, last)) == True{} : Bool}, ih: {rp.fresh_ok(r, last, ts) == True{} : Bool}) -> {rp.fresh_ok(R.pick.sel(c, R.Switch{x, 0n}, r), last, ts) == True{} : Bool}:
  match c:
    case True{}:
      rp.and_tt(Bool.not(Nat.is_eq(x, last)), Bool.not(R.seen(x, ts)), ne, ec)
    case False{}:
      ih

def rp.fresh_inv(xs: List<&2, Nat>, +last: Nat, +ts: List<&2, R.Tried>, +nin: {rp.notin(last, xs) == True{} : Bool}) -> {rp.fresh_ok(R.pick.fresh(xs, ts), last, ts) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +rest:
      ne = rp.and_l(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), nin)
      nr = rp.and_r(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), nin)
      rp.fresh_sel(Bool.not(R.seen(x, ts)), x, last, ts, R.pick.fresh(rest, ts), {==}, ne, rp.fresh_inv(rest, last, ts, nr))

# what pick.back guarantees of its switch: the wait is the backoff, and
# never less than its server's wait; not the last provider; the wait is
# positive and at most max
def rp.back_ok(m: Maybe<&2, R.Switch>, +last: Nat, +ts: List<&2, R.Tried>, +backoff: Nat, +max: Nat) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{s}:
      match s:
        case R.Switch{+to, +d}:
          Bool.and(Nat.is_eq(Nat.max(backoff, R.server(to, ts)), d), Bool.and(Bool.not(Nat.is_eq(to, last)), Bool.and(Nat.is_gt(d, 0n), Nat.is_le(d, max))))

def rp.back_sel(c: Bool, +x: Nat, +last: Nat, +ts: List<&2, R.Tried>, +backoff: Nat, +max: Nat, r: Maybe<&2, R.Switch>, ec: {Bool.and(Nat.is_gt(Nat.max(backoff, R.server(x, ts)), 0n), Nat.is_le(Nat.max(backoff, R.server(x, ts)), max)) == c : Bool}, ne: {Bool.not(Nat.is_eq(x, last)) == True{} : Bool}, ih: {rp.back_ok(r, last, ts, backoff, max) == True{} : Bool}) -> {rp.back_ok(R.pick.sel(c, R.Switch{x, Nat.max(backoff, R.server(x, ts))}, r), last, ts, backoff, max) == True{} : Bool}:
  match c:
    case True{}:
      +w = Nat.max(backoff, R.server(x, ts))
      rp.and_tt(Nat.is_eq(w, w), Bool.and(Bool.not(Nat.is_eq(x, last)), Bool.and(Nat.is_gt(w, 0n), Nat.is_le(w, max))), Equal.sym(Bool, True{}, Nat.is_eq(w, w), rp.eq_refl(w)), rp.and_tt(Bool.not(Nat.is_eq(x, last)), Bool.and(Nat.is_gt(w, 0n), Nat.is_le(w, max)), ne, ec))
    case False{}:
      ih

def rp.back_inv(xs: List<&2, Nat>, +last: Nat, +ts: List<&2, R.Tried>, +backoff: Nat, +max: Nat, +nin: {rp.notin(last, xs) == True{} : Bool}) -> {rp.back_ok(R.pick.back(xs, ts, backoff, max), last, ts, backoff, max) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +rest:
      ne = rp.and_l(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), nin)
      nr = rp.and_r(Bool.not(Nat.is_eq(x, last)), rp.notin(last, rest), nin)
      rp.back_sel(Bool.and(Nat.is_gt(Nat.max(backoff, R.server(x, ts)), 0n), Nat.is_le(Nat.max(backoff, R.server(x, ts)), max)), x, last, ts, backoff, max, R.pick.back(rest, ts, backoff, max), {==}, ne, rp.back_inv(rest, last, ts, backoff, max, nr))

# the five checks of a switch together
def rp.Good(m: Maybe<&2, R.Switch>, len: Nat, ts: List<&2, R.Tried>, p: R.Policy) -> Type:
  {R.Switch.not_last(m, ts) == True{} : Bool} & ({R.Switch.fresh_first(m, len, ts) == True{} : Bool} & ({R.Switch.return_waits(m, ts) == True{} : Bool} & ({R.Switch.capped(m, R.Policy.max(p)) == True{} : Bool} & {R.Switch.within(m, ts, p) == True{} : Bool})))

def rp.good_none(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> rp.Good(None{}, len, ts, p):
  ({==}, ({==}, ({==}, ({==}, {==}))))

def rp.not_eq_move(+to: Nat, -a: Nat, -b: Nat, e: {a == b : Nat}, h: {Bool.not(Nat.is_eq(to, a)) == True{} : Bool}) -> {Bool.not(Nat.is_eq(to, b)) == True{} : Bool}:
  %e : {Bool.not(Nat.is_eq(to, _)) == True{} : Bool}
  h

def rp.ge_move(-a: Nat, -b: Nat, +c: Nat, e: {a == b : Nat}, h: {Nat.is_ge(a, c) == True{} : Bool}) -> {Nat.is_ge(b, c) == True{} : Bool}:
  %e : {Nat.is_ge(_, c) == True{} : Bool}
  h

def rp.fresh_good(m: Maybe<&2, R.Switch>, +last: Nat, +len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy, +hf: {rp.fresh_ok(m, last, ts) == True{} : Bool}, elast: {last == R.last_at(ts) : Nat}, eok: {Nat.is_le(R.length(ts), R.Policy.switches(p)) == True{} : Bool}) -> rp.Good(m, len, ts, p):
  match m:
    case None{}:
      rp.good_none(len, ts, p)
    case Some{s}:
      match s:
        case R.Switch{+to, d}:
          match d:
            case 0n:
              nl = rp.and_l(Bool.not(Nat.is_eq(to, last)), Bool.not(R.seen(to, ts)), hf)
              +fr = rp.and_r(Bool.not(Nat.is_eq(to, last)), Bool.not(R.seen(to, ts)), hf)
              nl2 = rp.not_eq_move(to, last, R.last_at(ts), elast, nl)
              ff = rp.or_l(Bool.not(R.seen(to, ts)), R.all_seen(len, ts), fr)
              rw = rp.or_l(Bool.not(R.seen(to, ts)), Bool.and(Nat.is_gt(0n, 0n), Nat.is_ge(0n, R.server(to, ts))), fr)
              (nl2, (ff, (rw, (rp.le_zero(R.Policy.max(p)), eok))))
            case 1n+k:
              rp.absurdF(rp.Good(Some{R.Switch{to, 1n+k}}, len, ts, p), hf)

def rp.back_good(m: Maybe<&2, R.Switch>, +last: Nat, +len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy, +backoff: Nat, +hb: {rp.back_ok(m, last, ts, backoff, R.Policy.max(p)) == True{} : Bool}, eall: {R.all_seen(len, ts) == True{} : Bool}, elast: {last == R.last_at(ts) : Nat}, eok: {Nat.is_le(R.length(ts), R.Policy.switches(p)) == True{} : Bool}) -> rp.Good(m, len, ts, p):
  match m:
    case None{}:
      rp.good_none(len, ts, p)
    case Some{s}:
      match s:
        case R.Switch{+to, +d}:
          +rest = rp.and_r(Nat.is_eq(Nat.max(backoff, R.server(to, ts)), d), Bool.and(Bool.not(Nat.is_eq(to, last)), Bool.and(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p)))), hb)
          deq = rp.eq_true(Nat.max(backoff, R.server(to, ts)), d, rp.and_l(Nat.is_eq(Nat.max(backoff, R.server(to, ts)), d), Bool.and(Bool.not(Nat.is_eq(to, last)), Bool.and(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p)))), hb))
          nl = rp.and_l(Bool.not(Nat.is_eq(to, last)), Bool.and(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p))), rest)
          +wc = rp.and_r(Bool.not(Nat.is_eq(to, last)), Bool.and(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p))), rest)
          pos = rp.and_l(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p)), wc)
          cap = rp.and_r(Nat.is_gt(d, 0n), Nat.is_le(d, R.Policy.max(p)), wc)
          nl2 = rp.not_eq_move(to, last, R.last_at(ts), elast, nl)
          ge = rp.ge_move(Nat.max(backoff, R.server(to, ts)), d, R.server(to, ts), deq, Nat.max_ge_r(backoff, R.server(to, ts)))
          ff = rp.or_r(Bool.not(R.seen(to, ts)), R.all_seen(len, ts), eall)
          rw = rp.or_r(Bool.not(R.seen(to, ts)), Bool.and(Nat.is_gt(d, 0n), Nat.is_ge(d, R.server(to, ts))), rp.and_tt(Nat.is_gt(d, 0n), Nat.is_ge(d, R.server(to, ts)), pos, ge))
          (nl2, (ff, (rw, (cap, eok))))

def rp.mode_good(all: Bool, +last: Nat, +len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy, eall: {R.all_seen(len, ts) == all : Bool}, elast: {last == R.last_at(ts) : Nat}, eok: {Nat.is_le(R.length(ts), R.Policy.switches(p)) == True{} : Bool}) -> rp.Good(R.next.mode(all, last, len, ts, p), len, ts, p):
  match all:
    case True{}:
      rp.back_good(R.pick.back(R.order(last, len), ts, R.backoff(p, len, ts), R.Policy.max(p)), last, len, ts, p, R.backoff(p, len, ts), rp.back_inv(R.order(last, len), last, ts, R.backoff(p, len, ts), R.Policy.max(p), rp.order_notin(last, len)), eall, elast, eok)
    case False{}:
      rp.fresh_good(R.pick.fresh(R.order(last, len), ts), last, len, ts, p, rp.fresh_inv(R.order(last, len), last, ts, rp.order_notin(last, len)), elast, eok)

def rp.budget_good(ok: Bool, +last: Nat, +len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy, eok: {Nat.is_le(R.length(ts), R.Policy.switches(p)) == ok : Bool}, elast: {last == R.last_at(ts) : Nat}) -> rp.Good(R.next.budget(ok, last, len, ts, p), len, ts, p):
  match ok:
    case True{}:
      rp.mode_good(R.all_seen(len, ts), last, len, ts, p, {==}, elast, eok)
    case False{}:
      rp.good_none(len, ts, p)

def rp.last_good(m: Maybe<&2, R.Tried>, +len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy, em: {m == R.last(ts) : Maybe<&2, R.Tried>}) -> rp.Good(R.next.last(m, len, ts, p), len, ts, p):
  match m:
    case None{}:
      rp.good_none(len, ts, p)
    case Some{+t}:
      rp.budget_good(Nat.is_le(R.length(ts), R.Policy.switches(p)), R.Tried.at(t), len, ts, p, {==}, Equal.cong(Maybe<&2, R.Tried>, Nat, R.at_of, Some{t}, R.last(ts), em))

def good(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> rp.Good(R.next(len, ts, p), len, ts, p):
  rp.last_good(R.last(ts), len, ts, p, {==})

def rp.not_last_of(-m: Maybe<&2, R.Switch>, -len: Nat, -ts: List<&2, R.Tried>, -p: R.Policy, g: rp.Good(m, len, ts, p)) -> {R.Switch.not_last(m, ts) == True{} : Bool}:
  (nl, rest) = g
  nl

def rp.fresh_first_of(-m: Maybe<&2, R.Switch>, -len: Nat, -ts: List<&2, R.Tried>, -p: R.Policy, g: rp.Good(m, len, ts, p)) -> {R.Switch.fresh_first(m, len, ts) == True{} : Bool}:
  (nl, rest) = g
  (ff, more) = rest
  ff

def rp.return_waits_of(-m: Maybe<&2, R.Switch>, -len: Nat, -ts: List<&2, R.Tried>, -p: R.Policy, g: rp.Good(m, len, ts, p)) -> {R.Switch.return_waits(m, ts) == True{} : Bool}:
  (nl, rest) = g
  (ff, more) = rest
  (rw, tail) = more
  rw

def rp.capped_of(-m: Maybe<&2, R.Switch>, -len: Nat, -ts: List<&2, R.Tried>, -p: R.Policy, g: rp.Good(m, len, ts, p)) -> {R.Switch.capped(m, R.Policy.max(p)) == True{} : Bool}:
  (nl, rest) = g
  (ff, more) = rest
  (rw, tail) = more
  (cap, wi) = tail
  cap

def rp.within_of(-m: Maybe<&2, R.Switch>, -len: Nat, -ts: List<&2, R.Tried>, -p: R.Policy, g: rp.Good(m, len, ts, p)) -> {R.Switch.within(m, ts, p) == True{} : Bool}:
  (nl, rest) = g
  (ff, more) = rest
  (rw, tail) = more
  (cap, wi) = tail
  wi

def visits_once(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> {R.Switch.fresh_first(R.next(len, ts, p), len, ts) == True{} : Bool}:
  rp.fresh_first_of(R.next(len, ts, p), len, ts, p, good(len, ts, p))

def never_twice_in_a_row(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> {R.Switch.not_last(R.next(len, ts, p), ts) == True{} : Bool}:
  rp.not_last_of(R.next(len, ts, p), len, ts, p, good(len, ts, p))

def return_waits(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> {R.Switch.return_waits(R.next(len, ts, p), ts) == True{} : Bool}:
  rp.return_waits_of(R.next(len, ts, p), len, ts, p, good(len, ts, p))

def delay_capped(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> {R.Switch.capped(R.next(len, ts, p), R.Policy.max(p)) == True{} : Bool}:
  rp.capped_of(R.next(len, ts, p), len, ts, p, good(len, ts, p))

def bounded(+len: Nat, +ts: List<&2, R.Tried>, +p: R.Policy) -> {R.Switch.within(R.next(len, ts, p), ts, p) == True{} : Bool}:
  rp.within_of(R.next(len, ts, p), len, ts, p, good(len, ts, p))

# (R4) The deferred job
# ---------------------

def rp.send_off(a: R.Act) -> {R.tally.send(a, False{}) == 0n : Nat}:
  match a:
    case R.Send{}:
      {==}
    case R.Poll{}:
      {==}
    case R.Cancel{}:
      {==}
    case R.Settle{}:
      {==}
    case R.Quit{}:
      {==}

def rp.late_off(a: R.Act, +left: Nat) -> {R.tally.late(a, left, False{}) == 0n : Nat}:
  match a:
    case R.Send{}:
      {==}
    case R.Poll{}:
      {==}
    case R.Cancel{}:
      {==}
    case R.Settle{}:
      {==}
    case R.Quit{}:
      {==}

def rp.pending_send(over: Bool, +left: Nat, +gap: Nat) -> {R.tally.send(R.Step.act(R.live.pending(over, left, gap)), True{}) == 0n : Nat}:
  match over:
    case True{}:
      {==}
    case False{}:
      {==}

def rp.failed_send(again: Bool, +failed: Nat, +left: Nat, +gap: Nat) -> {R.tally.send(R.Step.act(R.live.failed(again, failed, left, gap)), True{}) == 0n : Nat}:
  match again:
    case True{}:
      {==}
    case False{}:
      {==}

# a step sends nothing while the job is live
def rp.step_send(+fails: Nat, +budget: Nat, job: R.Job, g: R.Got) -> {R.tally.send(R.Step.act(R.step(fails, budget, job, g)), R.Job.live(job)) == 0n : Nat}:
  match job:
    case R.NoJob{}:
      rp.send_off(R.Step.act(R.step(fails, budget, R.NoJob{}, g)))
    case R.Live{+failed, +left}:
      match g:
        case R.Answer{}:
          {==}
        case R.Later{+gap}:
          rp.pending_send(Nat.is_eq(left, 0n), left, gap)
        case R.Broke{r, +gap}:
          rp.failed_send(Bool.and(r, Bool.and(Nat.is_lt(failed, fails), Nat.is_gt(left, 0n))), failed, left, gap)

def rp.pending_late(over: Bool, left: Nat, +gap: Nat, e: {Nat.is_eq(left, 0n) == over : Bool}) -> {R.tally.late(R.Step.act(R.live.pending(over, left, gap)), left, True{}) == 0n : Nat}:
  match over left:
    case True{} l:
      {==}
    case False{} 0n:
      rp.absurdT({R.late.at(0n) == 0n : Nat}, e)
    case False{} 1n+k:
      {==}

def rp.failed_late(again: Bool, r: Bool, +failed: Nat, +fails: Nat, left: Nat, +gap: Nat, e: {Bool.and(r, Bool.and(Nat.is_lt(failed, fails), Nat.is_gt(left, 0n))) == again : Bool}) -> {R.tally.late(R.Step.act(R.live.failed(again, failed, left, gap)), left, True{}) == 0n : Nat}:
  match again left:
    case False{} l:
      {==}
    case True{} 0n:
      rp.absurdF({R.late.at(0n) == 0n : Nat}, rp.and_r(Nat.is_lt(failed, fails), False{}, rp.and_r(r, Bool.and(Nat.is_lt(failed, fails), False{}), e)))
    case True{} 1n+k:
      {==}

# a step never polls a live job with 0 ms left
def rp.step_late(+fails: Nat, +budget: Nat, job: R.Job, g: R.Got) -> {R.tally.late(R.Step.act(R.step(fails, budget, job, g)), R.Job.left(job), R.Job.live(job)) == 0n : Nat}:
  match job:
    case R.NoJob{}:
      rp.late_off(R.Step.act(R.step(fails, budget, R.NoJob{}, g)), 0n)
    case R.Live{+failed, +left}:
      match g:
        case R.Answer{}:
          {==}
        case R.Later{+gap}:
          rp.pending_late(Nat.is_eq(left, 0n), left, gap, {==})
        case R.Broke{+r, +gap}:
          rp.failed_late(Bool.and(r, Bool.and(Nat.is_lt(failed, fails), Nat.is_gt(left, 0n))), r, failed, fails, left, gap, {==})

def rp.sends_go(gots: List<&2, R.Got>, +fails: Nat, +budget: Nat, +job: R.Job, +s: Nat, +l: Nat) -> {R.Tally.sends(R.run.go(gots, fails, budget, job, R.Tally{s, l})) == s : Nat}:
  match gots:
    case Nil{}:
      {==}
    case +g <> +rest:
      +x = R.tally.send(R.Step.act(R.step(fails, budget, job, g)), R.Job.live(job))
      +y = R.tally.late(R.Step.act(R.step(fails, budget, job, g)), R.Job.left(job), R.Job.live(job))
      Equal.trans(Nat, R.Tally.sends(R.run.go(rest, fails, budget, R.Step.job(R.step(fails, budget, job, g)), R.Tally{Nat.add(s, x), Nat.add(l, y)})), Nat.add(s, x), s, rp.sends_go(rest, fails, budget, R.Step.job(R.step(fails, budget, job, g)), Nat.add(s, x), Nat.add(l, y)), rp.add_none(s, x, rp.step_send(fails, budget, job, g)))

def rp.late_go(gots: List<&2, R.Got>, +fails: Nat, +budget: Nat, +job: R.Job, +s: Nat, +l: Nat) -> {R.Tally.late(R.run.go(gots, fails, budget, job, R.Tally{s, l})) == l : Nat}:
  match gots:
    case Nil{}:
      {==}
    case +g <> +rest:
      +x = R.tally.send(R.Step.act(R.step(fails, budget, job, g)), R.Job.live(job))
      +y = R.tally.late(R.Step.act(R.step(fails, budget, job, g)), R.Job.left(job), R.Job.live(job))
      Equal.trans(Nat, R.Tally.late(R.run.go(rest, fails, budget, R.Step.job(R.step(fails, budget, job, g)), R.Tally{Nat.add(s, x), Nat.add(l, y)})), Nat.add(l, y), l, rp.late_go(rest, fails, budget, R.Step.job(R.step(fails, budget, job, g)), Nat.add(s, x), Nat.add(l, y)), rp.add_none(l, y, rp.step_late(fails, budget, job, g)))

def pays_once(+fails: Nat, +budget: Nat, gots: List<&2, R.Got>) -> {R.Tally.sends(R.run(fails, budget, gots)) == 0n : Nat}:
  rp.sends_go(gots, fails, budget, R.NoJob{}, 0n, 0n)

def bounded_in_time(+fails: Nat, +budget: Nat, gots: List<&2, R.Got>) -> {R.Tally.late(R.run(fails, budget, gots)) == 0n : Nat}:
  rp.late_go(gots, fails, budget, R.NoJob{}, 0n, 0n)

def rp.repoll(again: Bool, +failed: Nat, +left: Nat, +gap: Nat, e: {again == True{} : Bool}) -> {R.live.failed(again, failed, left, gap) == R.Step{R.Poll{}, R.Live{1n+failed, Nat.sub(left, 1n+gap)}} : R.Step}:
  match again:
    case True{}:
      {==}
    case False{}:
      rp.absurdF({R.live.failed(False{}, failed, left, gap) == R.Step{R.Poll{}, R.Live{1n+failed, Nat.sub(left, 1n+gap)}} : R.Step}, e)

def failed_poll_repolls(+fails: Nat, +budget: Nat, +failed: Nat, +left: Nat, +gap: Nat, below: {Nat.is_lt(failed, fails) == True{} : Bool}, live: {Nat.is_gt(left, 0n) == True{} : Bool}) -> {R.step(fails, budget, R.Live{failed, left}, R.Broke{True{}, gap}) == R.Step{R.Poll{}, R.Live{1n+failed, Nat.sub(left, 1n+gap)}} : R.Step}:
  rp.repoll(Bool.and(Nat.is_lt(failed, fails), Nat.is_gt(left, 0n)), failed, left, gap, rp.and_tt(Nat.is_lt(failed, fails), Nat.is_gt(left, 0n), below, live))

# (R5) The stall
# --------------

def stall_extends(+idle: Nat, positive: {Nat.is_gt(idle, 0n) == True{} : Bool}) -> {Nat.is_lt(idle, R.stall.next(idle)) == True{} : Bool}:
  match idle:
    case 0n:
      rp.absurdF({Nat.is_lt(0n, R.stall.next(0n)) == True{} : Bool}, positive)
    case 1n+k:
      rp.lt_add_succ(k, k)

# (R6) The idle deadline
# ----------------------

def rp.le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      rp.le_refl(p)

def rp.le_add(n: Nat, +d: Nat) -> {Nat.is_le(n, Nat.add(n, d)) == True{} : Bool}:
  match n:
    case 0n:
      rp.le_zero(d)
    case 1n+p:
      rp.le_add(p, d)

# the bound after one more event, given the bound of the events after it
def rp.idle_next(over: Bool, +g: Nat, rest: List<&2, Nat>, +d: Nat, +last: Nat, ih: {Nat.is_le(R.Idle.at(R.idle.go(rest, d, Nat.add(last, g))), Nat.add(R.idle.life.go(rest, d, Nat.add(last, g)), d)) == True{} : Bool}) -> {Nat.is_le(R.Idle.at(R.idle.sel(over, R.IdleStall{Nat.add(last, d)}, R.idle.go(rest, d, Nat.add(last, g)))), Nat.add(R.idle.life.sel(over, last, R.idle.life.go(rest, d, Nat.add(last, g))), d)) == True{} : Bool}:
  match over:
    case True{}:
      rp.le_refl(Nat.add(last, d))
    case False{}:
      ih

def rp.idle_go(gs: List<&2, Nat>, +d: Nat, +last: Nat) -> {Nat.is_le(R.Idle.at(R.idle.go(gs, d, last)), Nat.add(R.idle.life.go(gs, d, last), d)) == True{} : Bool}:
  match gs:
    case Nil{}:
      rp.le_add(last, d)
    case +g <> +rest:
      rp.idle_next(Nat.is_gt(g, d), g, rest, d, last, rp.idle_go(rest, d, Nat.add(last, g)))

def detection_bounded(gs: List<&2, Nat>, +d: Nat) -> {Nat.is_le(R.Idle.at(R.idle(gs, d)), Nat.add(R.idle.life(gs, d), d)) == True{} : Bool}:
  match gs:
    case Nil{}:
      rp.le_refl(d)
    case +g <> +rest:
      rp.idle_next(Nat.is_gt(g, d), g, rest, d, 0n, rp.idle_go(rest, d, g))

def silent_at_deadline(+d: Nat) -> {R.idle(Nil{}, d) == R.IdleStall{d} : R.Idle}:
  {==}

# ---- facts ----

# proof_facts: proofs of LAWS.bend section model_facts (the model in
# bend/facts.bend). PROOF.bend proves each law as Laws.<law> with the
# pf.<law> of this file. The rulebook laws reuse the lookup lemmas of
# PROOF.bend section quirks.

# Nat order
# ---------

def facts.pf.le_refl(+n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      facts.pf.le_refl(p)

def facts.pf.le_succ(+n: Nat) -> {Nat.is_le(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      facts.pf.le_succ(p)

# a not below b: b is at most a
def pf.not_lt_le(+a: Nat, +b: Nat, h: {Nat.is_lt(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pq.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pf.not_lt_le(p, q, h)

# a not at most b: b is at most a
def pf.not_le_le(+a: Nat, +b: Nat, h: {Nat.is_le(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      pq.absurd({Nat.is_le(0n, 0n) == True{} : Bool}, h)
    case 0n 1n+q:
      pq.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, h)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pf.not_le_le(p, q, h)

# a below b and b at most a cannot both hold
def pf.lt_le_absurd(-A: Type, +a: Nat, +b: Nat, h1: {Nat.is_lt(a, b) == True{} : Bool}, h2: {Nat.is_le(b, a) == True{} : Bool}) -> A:
  match a b:
    case 0n 0n:
      pq.absurdF(A, h1)
    case 0n 1n+q:
      pq.absurdF(A, h2)
    case 1n+p 0n:
      pq.absurdF(A, h1)
    case 1n+p 1n+q:
      pf.lt_le_absurd(A, p, q, h1, h2)

def pf.le_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n b c:
      pq.le0(c)
    case 1n+p 0n c:
      pq.absurdF({Nat.is_le(1n+p, c) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      pq.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      pf.le_trans(p, q, r, ab, bc)

def pf.min_le_r(+x: Nat, +y: Nat) -> {Nat.is_le(Nat.min(x, y), y) == True{} : Bool}:
  match x y:
    case 0n y:
      pq.le0(y)
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pf.min_le_r(p, q)

def pf.sub_le(+m: Nat, +a: Nat) -> {Nat.is_le(Nat.sub(m, a), m) == True{} : Bool}:
  match m a:
    case 0n a:
      {==}
    case 1n+p 0n:
      facts.pf.le_refl(1n+p)
    case 1n+p 1n+q:
      pf.le_trans(Nat.sub(p, q), p, 1n+p, pf.sub_le(p, q), facts.pf.le_succ(p))

def facts.pf.add_zero(+n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %facts.pf.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def pf.add_succ(+x: Nat, +q: Nat) -> {Nat.add(x, 1n+q) == 1n+Nat.add(x, q) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %pf.add_succ(p, q) : {1n+Nat.add(p, 1n+q) == 1n+_ : Nat}
      {==}

# (m - a) + a is m when a is at most m
def pf.sub_add(+m: Nat, +a: Nat, h: {Nat.is_le(a, m) == True{} : Bool}) -> {Nat.add(Nat.sub(m, a), a) == m : Nat}:
  match m a:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      pq.absurdF({Nat.add(Nat.sub(0n, 1n+q), 1n+q) == 0n : Nat}, h)
    case 1n+p 0n:
      facts.pf.add_zero(1n+p)
    case 1n+p 1n+q:
      %Equal.sym(Nat, Nat.add(Nat.sub(p, q), 1n+q), 1n+Nat.add(Nat.sub(p, q), q), pf.add_succ(Nat.sub(p, q), q)) : {_ == 1n+p : Nat}
      %pf.sub_add(p, q, h) : {1n+Nat.add(Nat.sub(p, q), q) == 1n+_ : Nat}
      {==}

def pf.le_add(+y: Nat, +a: Nat) -> {Nat.is_le(a, Nat.add(y, a)) == True{} : Bool}:
  match y:
    case 0n:
      facts.pf.le_refl(a)
    case 1n+q:
      pf.le_trans(a, Nat.add(q, a), 1n+Nat.add(q, a), pf.le_add(q, a), facts.pf.le_succ(Nat.add(q, a)))

def pf.le_add_mono(+x: Nat, +y: Nat, +a: Nat, h: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(Nat.add(x, a), Nat.add(y, a)) == True{} : Bool}:
  match x y:
    case 0n y:
      pf.le_add(y, a)
    case 1n+p 0n:
      pq.absurdF({Nat.is_le(Nat.add(1n+p, a), Nat.add(0n, a)) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pf.le_add_mono(p, q, a, h)

def pf.sub_zero(+a: Nat) -> {Nat.sub(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pf.add_sub(+b: Nat, +a: Nat) -> {Nat.sub(Nat.add(b, a), b) == a : Nat}:
  match b:
    case 0n:
      pf.sub_zero(a)
    case 1n+p:
      pf.add_sub(p, a)

# Decisions from the rulebook
# ---------------------------

def pf.facts_rulebook_decides(+known: List<&2, Nat>, +pre: List<&2, If.Rule>, +r: If.Rule, +post: List<&2, If.Rule>, +q: If.Query, dflt: Bool, ok: {If.compiles(known, List.append(&2, If.Rule, pre, r <> post)) == True{} : Bool}, hit: {If.applies(q, r) == True{} : Bool}, top: {If.any_at(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r), 1n+If.Rule.rank(r)) == False{} : Bool}) -> {Fx.decide(List.append(&2, If.Rule, pre, r <> post), q, If.Rule.dir(r), dflt) == Nat.is_eq(If.Rule.val(r), 1n) : Bool}:
  +L = List.append(&2, If.Rule, pre, r <> post)
  +D = If.Rule.dir(r)
  +V = If.Rule.val(r)
  %Equal.sym(If.Ans, If.lookup(L, q, D), If.Known{V}, pq.quirk_highest_wins(known, pre, r, post, q, ok, hit, top)) : {Fx.flag(_, dflt) == Nat.is_eq(V, 1n) : Bool}
  {==}

def pf.facts_rulebook_default(+rs: List<&2, If.Rule>, +q: If.Query, +d: Nat, dflt: Bool, none: {If.any_at(rs, q, d, 0n) == False{} : Bool}) -> {Fx.decide(rs, q, d, dflt) == dflt : Bool}:
  %Equal.sym(If.Ans, If.lookup(rs, q, d), If.Unknown{}, pq.quirk_unknown_when_none(rs, q, d, none)) : {Fx.flag(_, dflt) == dflt : Bool}
  {==}

def pf.facts_only_the_rulebook_decides(+rs: List<&2, If.Rule>, +q1: If.Query, +q2: If.Query, +d: Nat, dflt: Bool, same: {If.lookup(rs, q1, d) == If.lookup(rs, q2, d) : If.Ans}) -> {Fx.decide(rs, q1, d, dflt) == Fx.decide(rs, q2, d, dflt) : Bool}:
  %same : {Fx.flag(If.lookup(rs, q1, d), dflt) == Fx.flag(_, dflt) : Bool}
  {==}

def pf.facts_adaptive_compat_first(b: Bool, a: If.Ans) -> {Fx.adaptive(Some{b}, a) == b : Bool}:
  {==}

def pf.facts_adaptive_rulebook_second(a: If.Ans) -> {Fx.adaptive(None{}, a) == Fx.flag(a, False{}) : Bool}:
  {==}

# Budgets
# -------

def pf.hi_le(+x: Nat, +hi: Nat, g: Bool, eg: {Nat.is_lt(hi, x) == g : Bool}) -> {Nat.is_le(Fx.clamp.hi(g, x, hi), hi) == True{} : Bool}:
  match g:
    case True{}:
      facts.pf.le_refl(hi)
    case False{}:
      pf.not_lt_le(hi, x, eg)

def pf.lo_le(+x: Nat, +lo: Nat, +hi: Nat, c: Bool, lohi: {Nat.is_le(lo, hi) == True{} : Bool}) -> {Nat.is_le(Fx.clamp.lo(c, x, lo, hi), hi) == True{} : Bool}:
  match c:
    case True{}:
      lohi
    case False{}:
      pf.hi_le(x, hi, Nat.is_lt(hi, x), {==})

def pf.clamp_le(+x: Nat, +lo: Nat, +hi: Nat, lohi: {Nat.is_le(lo, hi) == True{} : Bool}) -> {Nat.is_le(Fx.clamp(x, lo, hi), hi) == True{} : Bool}:
  pf.lo_le(x, lo, hi, Nat.is_lt(x, lo), lohi)

def pf.hi_ge(+x: Nat, +lo: Nat, +hi: Nat, g: Bool, lohi: {Nat.is_le(lo, hi) == True{} : Bool}, lox: {Nat.is_le(lo, x) == True{} : Bool}) -> {Nat.is_le(lo, Fx.clamp.hi(g, x, hi)) == True{} : Bool}:
  match g:
    case True{}:
      lohi
    case False{}:
      lox

def pf.lo_ge(+x: Nat, +lo: Nat, +hi: Nat, c: Bool, ec: {Nat.is_lt(x, lo) == c : Bool}, lohi: {Nat.is_le(lo, hi) == True{} : Bool}) -> {Nat.is_le(lo, Fx.clamp.lo(c, x, lo, hi)) == True{} : Bool}:
  match c:
    case True{}:
      facts.pf.le_refl(lo)
    case False{}:
      pf.hi_ge(x, lo, hi, Nat.is_lt(hi, x), lohi, pf.not_lt_le(x, lo, ec))

def pf.clamp_ge(+x: Nat, +lo: Nat, +hi: Nat, lohi: {Nat.is_le(lo, hi) == True{} : Bool}) -> {Nat.is_le(lo, Fx.clamp(x, lo, hi)) == True{} : Bool}:
  pf.lo_ge(x, lo, hi, Nat.is_lt(x, lo), {==}, lohi)

def pf.hi_id(+x: Nat, +hi: Nat, g: Bool, eg: {Nat.is_lt(hi, x) == g : Bool}, xhi: {Nat.is_le(x, hi) == True{} : Bool}) -> {Fx.clamp.hi(g, x, hi) == x : Nat}:
  match g:
    case True{}:
      pf.lt_le_absurd({hi == x : Nat}, hi, x, eg, xhi)
    case False{}:
      {==}

def pf.lo_id(+x: Nat, +lo: Nat, +hi: Nat, c: Bool, ec: {Nat.is_lt(x, lo) == c : Bool}, lox: {Nat.is_le(lo, x) == True{} : Bool}, xhi: {Nat.is_le(x, hi) == True{} : Bool}) -> {Fx.clamp.lo(c, x, lo, hi) == x : Nat}:
  match c:
    case True{}:
      pf.lt_le_absurd({lo == x : Nat}, x, lo, ec, lox)
    case False{}:
      pf.hi_id(x, hi, Nat.is_lt(hi, x), {==}, xhi)

# a value inside lo..hi stays as it is
def pf.clamp_id(+x: Nat, +lo: Nat, +hi: Nat, lox: {Nat.is_le(lo, x) == True{} : Bool}, xhi: {Nat.is_le(x, hi) == True{} : Bool}) -> {Fx.clamp(x, lo, hi) == x : Nat}:
  pf.lo_id(x, lo, hi, Nat.is_lt(x, lo), {==}, lox, xhi)

# the minimal budget of an ordered rule is at most its high budget
def pf.ord_mh(+b: Fx.Budgets, +ordered: {Fx.Budgets.ordered(b) == True{} : Bool}) -> {Nat.is_le(Fx.Budgets.minimal(b), Fx.Budgets.high(b)) == True{} : Bool}:
  match b:
    case Fx.Budgets{+mi, +lo, +me, +hi}:
      +ml = pq.and_l(Nat.is_le(mi, lo), Bool.and(Nat.is_le(lo, me), Nat.is_le(me, hi)), ordered)
      +rest = pq.and_r(Nat.is_le(mi, lo), Bool.and(Nat.is_le(lo, me), Nat.is_le(me, hi)), ordered)
      +lm = pq.and_l(Nat.is_le(lo, me), Nat.is_le(me, hi), rest)
      +mh = pq.and_r(Nat.is_le(lo, me), Nat.is_le(me, hi), rest)
      pf.le_trans(mi, lo, hi, ml, pf.le_trans(lo, me, hi, lm, mh))

def pf.facts_google_budget_at_most_high(+b: Fx.Budgets, c: Fx.Customs, +l: Fx.Lv, +ordered: {Fx.Budgets.ordered(b) == True{} : Bool}) -> {Nat.is_le(Fx.gtokens(b, c, l), Fx.Budgets.high(b)) == True{} : Bool}:
  pf.clamp_le(Maybe.default(&2, Nat, Fx.Customs.at(c, l), Fx.Budgets.at(b, l)), Fx.Budgets.minimal(b), Fx.Budgets.high(b), pf.ord_mh(b, ordered))

def pf.facts_google_budget_at_least_minimal(+b: Fx.Budgets, c: Fx.Customs, +l: Fx.Lv, +ordered: {Fx.Budgets.ordered(b) == True{} : Bool}) -> {Nat.is_le(Fx.Budgets.minimal(b), Fx.gtokens(b, c, l)) == True{} : Bool}:
  pf.clamp_ge(Maybe.default(&2, Nat, Fx.Customs.at(c, l), Fx.Budgets.at(b, l)), Fx.Budgets.minimal(b), Fx.Budgets.high(b), pf.ord_mh(b, ordered))

def pf.table_at(+mi: Nat, +lo: Nat, +me: Nat, +hi: Nat, l: Fx.Lv, ml: {Nat.is_le(mi, lo) == True{} : Bool}, lm: {Nat.is_le(lo, me) == True{} : Bool}, mh: {Nat.is_le(me, hi) == True{} : Bool}) -> {Fx.gtokens(Fx.Budgets{mi, lo, me, hi}, Fx.Customs.none(), l) == Fx.Budgets.at(Fx.Budgets{mi, lo, me, hi}, l) : Nat}:
  match l:
    case Fx.Minimal{}:
      pf.clamp_id(mi, mi, hi, facts.pf.le_refl(mi), pf.le_trans(mi, lo, hi, ml, pf.le_trans(lo, me, hi, lm, mh)))
    case Fx.Low{}:
      pf.clamp_id(lo, mi, hi, ml, pf.le_trans(lo, me, hi, lm, mh))
    case Fx.Medium{}:
      pf.clamp_id(me, mi, hi, pf.le_trans(mi, lo, me, ml, lm), mh)
    case Fx.High{}:
      pf.clamp_id(hi, mi, hi, pf.le_trans(mi, lo, hi, ml, pf.le_trans(lo, me, hi, lm, mh)), facts.pf.le_refl(hi))

def pf.facts_google_rule_is_the_table(+b: Fx.Budgets, +l: Fx.Lv, +ordered: {Fx.Budgets.ordered(b) == True{} : Bool}) -> {Fx.gtokens(b, Fx.Customs.none(), l) == Fx.Budgets.at(b, l) : Nat}:
  match b:
    case Fx.Budgets{+mi, +lo, +me, +hi}:
      +rest = pq.and_r(Nat.is_le(mi, lo), Bool.and(Nat.is_le(lo, me), Nat.is_le(me, hi)), ordered)
      pf.table_at(mi, lo, me, hi, l, pq.and_l(Nat.is_le(mi, lo), Bool.and(Nat.is_le(lo, me), Nat.is_le(me, hi)), ordered), pq.and_l(Nat.is_le(lo, me), Nat.is_le(me, hi), rest), pq.and_r(Nat.is_le(lo, me), Nat.is_le(me, hi), rest))

def pf.fit_at_le(+m: Nat, +b: Nat, +a: Nat, c: Bool, ec: {Nat.is_le(m, b) == c : Bool}) -> {Nat.is_le(Fx.Fit.budget(Fx.fit.at(c, m, b, a)), Fx.Fit.max(Fx.fit.at(c, m, b, a))) == True{} : Bool}:
  match c:
    case True{}:
      pf.le_trans(Nat.min(b, Nat.sub(m, a)), Nat.sub(m, a), m, pf.min_le_r(b, Nat.sub(m, a)), pf.sub_le(m, a))
    case False{}:
      pf.not_le_le(m, b, ec)

def pf.facts_fit_budget_under_ceiling(+base: Maybe<&2, Nat>, +mm: Nat, +b: Nat, +a: Nat) -> {Nat.is_le(Fx.Fit.budget(Fx.fit(base, mm, b, a)), Fx.Fit.max(Fx.fit(base, mm, b, a))) == True{} : Bool}:
  +m = Fx.fit.cap(base, mm, b)
  pf.fit_at_le(m, b, a, Nat.is_le(m, b), {==})

def pf.fit_at_max(+m: Nat, +b: Nat, +a: Nat, c: Bool) -> {Fx.Fit.max(Fx.fit.at(c, m, b, a)) == m : Nat}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def pf.cap_le(+base: Maybe<&2, Nat>, +mm: Nat, +b: Nat) -> {Nat.is_le(Fx.fit.cap(base, mm, b), mm) == True{} : Bool}:
  match base:
    case None{}:
      facts.pf.le_refl(mm)
    case Some{x}:
      pf.min_le_r(Nat.add(x, b), mm)

def pf.facts_fit_ceiling_under_model(+base: Maybe<&2, Nat>, +mm: Nat, +b: Nat, +a: Nat) -> {Nat.is_le(Fx.Fit.max(Fx.fit(base, mm, b, a)), mm) == True{} : Bool}:
  +m = Fx.fit.cap(base, mm, b)
  +c = Nat.is_le(m, b)
  %Equal.sym(Nat, Fx.Fit.max(Fx.fit.at(c, m, b, a)), m, pf.fit_at_max(m, b, a, c)) : {Nat.is_le(_, mm) == True{} : Bool}
  pf.cap_le(base, mm, b)

def pf.facts_room_leaves_the_answer(+b: Nat, +m: Nat, +a: Nat, fits: {Nat.is_le(a, m) == True{} : Bool}) -> {Nat.is_le(Nat.add(Fx.room(b, m, a), a), m) == True{} : Bool}:
  +R = Nat.min(b, Nat.sub(m, a))
  %pf.sub_add(m, a, fits) : {Nat.is_le(Nat.add(R, a), _) == True{} : Bool}
  pf.le_add_mono(R, Nat.sub(m, a), a, pf.min_le_r(b, Nat.sub(m, a)))

def pf.facts_aux_cap_answer_room(+b: Nat, +a: Nat) -> {Nat.sub(Fx.aux_cap(b, a), b) == a : Nat}:
  pf.add_sub(b, a)

# Oracles
# -------

# a native-xhigh model whose map keeps the promise sends xhigh at xhigh
def pf.xhigh(+m: Fx.EMap, ok: {Fx.native_ok.e(Fx.EMap.at(m, Fx.EXhigh{})) == True{} : Bool}) -> {5n == Fx.effort(m, Fx.EXhigh{}) : Nat}:
  match m:
    case Fx.EMap{mi, lo, me, hi, xh, mx}:
      match xh:
        case None{}:
          pq.absurdF({5n == Fx.effort.default(Fx.EXhigh{}) : Nat}, ok)
        case Some{w}:
          match w:
            case None{}:
              pq.absurdF({5n == Fx.effort.default(Fx.EXhigh{}) : Nat}, ok)
            case Some{v}:
              Equal.sym(Nat, v, 5n, pq.eq_true(v, 5n, ok))

def pf.facts_bedrock_effort_oracle(native: Bool, +m: Fx.EMap, +l: Fx.ELv, ok: {Fx.native_ok(native, m) == True{} : Bool}) -> {Fx.effort.old(native, m, l) == Fx.effort(m, l) : Nat}:
  match native:
    case False{}:
      {==}
    case True{}:
      match l:
        case Fx.EMinimal{}:
          {==}
        case Fx.ELow{}:
          {==}
        case Fx.EMedium{}:
          {==}
        case Fx.EHigh{}:
          {==}
        case Fx.EMax{}:
          {==}
        case Fx.EXhigh{}:
          pf.xhigh(m, ok)

def pf.facts_bedrock_budget_oracle(c: Fx.Customs, +l: Fx.Lv) -> {Fx.budget(c, Fx.budgets.shipped(), l) == Fx.budget.old(c, l) : Nat}:
  match l:
    case Fx.Minimal{}:
      {==}
    case Fx.Low{}:
      {==}
    case Fx.Medium{}:
      {==}
    case Fx.High{}:
      {==}

# Prices
# ------

def pf.facts_tier_price_model_row_first(+rows: List<&2, Fx.PRow>, +m: Nat, +t: Nat, +k: Nat, hit: {Fx.price.find(rows, m, t, True{}) == Some{k} : Maybe<&2, Nat>}) -> {Fx.price(rows, m, t) == Some{k} : Maybe<&2, Nat>}:
  %Equal.sym(Maybe<&2, Nat>, Fx.price.find(rows, m, t, True{}), Some{k}, hit) : {Fx.price.or(_, Fx.price.find(rows, m, t, False{})) == Some{k} : Maybe<&2, Nat>}
  {==}

def pf.facts_tier_price_no_row_base(+rows: List<&2, Fx.PRow>, +m: Nat, +t: Nat, +base: Nat, none: {Fx.price(rows, m, t) == None{} : Maybe<&2, Nat>}) -> {Fx.tier_cost(base, Fx.price(rows, m, t)) == Nat.mul(base, 100n) : Nat}:
  %Equal.sym(Maybe<&2, Nat>, Fx.price(rows, m, t), None{}, none) : {Fx.tier_cost(base, _) == Nat.mul(base, 100n) : Nat}
  {==}

def pf.facts_tier_price_openai_oracle(m: Nat, t: Nat) -> {Maybe.default(&2, Nat, Fx.price(Fx.prices.openai(), m, t), 100n) == Fx.price.old.openai(m, t) : Nat}:
  match m t:
    case 0n 0n:
      {==}
    case 0n 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+c:
              match c:
                case 0n:
                  {==}
                case 1n+d:
                  {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+c:
              match c:
                case 0n:
                  {==}
                case 1n+d:
                  {==}

def pf.facts_tier_price_codex_oracle(m: Nat, t: Nat) -> {Maybe.default(&2, Nat, Fx.price(Fx.prices.codex(), m, t), 100n) == Fx.price.old.codex(m, t) : Nat}:
  match m t:
    case 0n 0n:
      {==}
    case 0n 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+c:
              {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+a:
      match a:
        case 0n:
          {==}
        case 1n+b:
          match b:
            case 0n:
              {==}
            case 1n+c:
              {==}

def pf.facts_cache_write_1h_own_rate(+input: Nat, +write: Nat) -> {Fx.rate_1h(None{}, input, write) == write : Nat}:
  {==}

# ---- dashboard_auth ----

# proof_dashboard_auth: the D1 laws (LAWS.bend section dashboard_auth, the
# dashboard's pairing gate) of the model in bend/dash.bend.
#
# The gate compares a token with the current one, so an open pairs and a
# frame runs exactly when the token is the current one. A connection is
# "stale" when it is not open, or holds a token older than the current
# one. A stale connection stays stale under every event but its own open
# (a rotation only makes its token older; other connections' events do
# not touch its row), and a stale connection runs no frame. A connection
# that is not open, or was rejected, is stale. Every reachable state holds
# only tokens made so far (at most the current one), so a rotation makes
# every open connection stale; and the current token only grows, so a
# token older than it never becomes current again.
#
# A recursive proof takes the value it inspects as a parameter (Bend
# matches only parameters), with an equation that names it.

# Logic
# -----

def dashboard_auth.pa.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def dashboard_auth.pa.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : dashboard_auth.pa.BD(_, A, Unit)
  Unit{}

def dashboard_auth.pa.absurdT(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : dashboard_auth.pa.BD(_, Unit, A)
  Unit{}

def pa.or_l(a: Bool, +b: Bool, +h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      dashboard_auth.pa.absurdT({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pa.or_r(a: Bool, +b: Bool, +h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      dashboard_auth.pa.absurdT({b == False{} : Bool}, h)
    case False{}:
      h

def pa.and_l(a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      dashboard_auth.pa.absurdF({False{} == True{} : Bool}, h)

def pa.and_r(a: Bool, +b: Bool, +h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      dashboard_auth.pa.absurdF({b == True{} : Bool}, h)

# Numbers
# -------

def pa.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pa.eq_refl(p)

def pa.eq_true(a: Nat, b: Nat, +h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      dashboard_auth.pa.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      dashboard_auth.pa.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pa.eq_true(p, q, h))

def pa.eq_le(a: Nat, b: Nat, +h: {Nat.is_eq(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      dashboard_auth.pa.absurdF({Nat.is_le(1n+p, 0n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pa.eq_le(p, q, h)

def pa.le_succ(a: Nat, b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n b:
      {==}
    case 1n+p 0n:
      dashboard_auth.pa.absurdF({Nat.is_le(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pa.le_succ(p, q, h)

def pa.le_lt_succ(a: Nat, b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n b:
      {==}
    case 1n+p 0n:
      dashboard_auth.pa.absurdF({Nat.is_lt(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pa.le_lt_succ(p, q, h)

def pa.lt_succ(a: Nat, b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n b:
      {==}
    case 1n+p 0n:
      dashboard_auth.pa.absurdF({Nat.is_lt(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      pa.lt_succ(p, q, h)

def pa.lt_ne(a: Nat, b: Nat, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      dashboard_auth.pa.absurdF({True{} == False{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pa.lt_ne(p, q, h)

# The gate
# --------

def pa.ran_ok(+c: Nat, b: Bool, +h: {Da.ran(c, Da.frame.ran(c, b)) == True{} : Bool}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      dashboard_auth.pa.absurdF({False{} == True{} : Bool}, h)

def pa.paired_ok(c: Nat, b: Bool, +h: {Da.is_paired(Da.open.out(c, b)) == True{} : Bool}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      dashboard_auth.pa.absurdF({False{} == True{} : Bool}, h)

def pa.rejected_no(c: Nat, b: Bool, +h: {Da.is_paired(Da.open.out(c, b)) == False{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      dashboard_auth.pa.absurdT({True{} == False{} : Bool}, h)
    case False{}:
      {==}

# a frame that runs has the current token
def pa.frame_ran_cur(+c: Nat, m: Maybe<&2, Nat>, +cur: Nat, +h: {Da.ran(c, Da.frame.out(c, m, cur)) == True{} : Bool}) -> {m == Some{cur} : Maybe<&2, Nat>}:
  match m:
    case None{}:
      dashboard_auth.pa.absurdF({None{} == Some{cur} : Maybe<&2, Nat>}, h)
    case Some{+t}:
      Equal.cong(Nat, Maybe<&2, Nat>, x => Some{x}, t, cur, pa.eq_true(t, cur, pa.ran_ok(c, Nat.is_eq(t, cur), h)))

# an admitted token is the current one
def pa.admit_cur(+cur: Nat, shown: Maybe<&2, Nat>, +h: {Da.admit(cur, shown) == True{} : Bool}) -> {shown == Some{cur} : Maybe<&2, Nat>}:
  match shown:
    case None{}:
      dashboard_auth.pa.absurdF({None{} == Some{cur} : Maybe<&2, Nat>}, h)
    case Some{+t}:
      Equal.cong(Nat, Maybe<&2, Nat>, x => Some{x}, t, cur, pa.eq_true(t, cur, h))

# The connection table
# --------------------

def pa.hds_put(+c: Nat, +i: Nat, t: Nat, r: List<&2, Da.Conn>, hit: Bool, +eh: {Nat.is_eq(i, c) == hit : Bool}, +hr: {Da.held(c, r) == None{} : Maybe<&2, Nat>}) -> {Da.held(c, Da.drop.put(Da.Conn{i, t}, r, hit)) == None{} : Maybe<&2, Nat>}:
  match hit:
    case True{}:
      hr
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(i, c), False{}, eh) : {Da.held.put(t, Da.held(c, r), _) == None{} : Maybe<&2, Nat>}
      hr

# no row of c is left once c is dropped
def pa.held_drop_same(+c: Nat, cs: List<&2, Da.Conn>) -> {Da.held(c, Da.drop(c, cs)) == None{} : Maybe<&2, Nat>}:
  match cs:
    case Nil{}:
      {==}
    case Da.Conn{+i, +t} <> +rest:
      pa.hds_put(c, i, t, Da.drop(c, rest), Nat.is_eq(i, c), {==}, pa.held_drop_same(c, rest))

def pa.hdo_put(+c: Nat, +x: Nat, +i: Nat, +t: Nat, +rest: List<&2, Da.Conn>, hit: Bool, +eh: {Nat.is_eq(i, x) == hit : Bool}, +ne: {Nat.is_eq(x, c) == False{} : Bool}, +ih: {Da.held(c, Da.drop(x, rest)) == Da.held(c, rest) : Maybe<&2, Nat>}) -> {Da.held(c, Da.drop.put(Da.Conn{i, t}, Da.drop(x, rest), hit)) == Da.held.put(t, Da.held(c, rest), Nat.is_eq(i, c)) : Maybe<&2, Nat>}:
  match hit:
    case True{}:
      %Equal.sym(Nat, i, x, pa.eq_true(i, x, eh)) : {Da.held(c, Da.drop(x, rest)) == Da.held.put(t, Da.held(c, rest), Nat.is_eq(_, c)) : Maybe<&2, Nat>}
      %Equal.sym(Bool, Nat.is_eq(x, c), False{}, ne) : {Da.held(c, Da.drop(x, rest)) == Da.held.put(t, Da.held(c, rest), _) : Maybe<&2, Nat>}
      ih
    case False{}:
      %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.drop(x, rest)), Da.held(c, rest), ih) : {Da.held.put(t, _, Nat.is_eq(i, c)) == Da.held.put(t, Da.held(c, rest), Nat.is_eq(i, c)) : Maybe<&2, Nat>}
      {==}

# dropping another connection leaves the row of c as it was
def pa.held_drop_other(+c: Nat, +x: Nat, cs: List<&2, Da.Conn>, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.held(c, Da.drop(x, cs)) == Da.held(c, cs) : Maybe<&2, Nat>}:
  match cs:
    case Nil{}:
      {==}
    case Da.Conn{+i, +t} <> +rest:
      pa.hdo_put(c, x, i, t, rest, Nat.is_eq(i, x), {==}, ne, pa.held_drop_other(c, x, rest, ne))

def pa.held_keep_other(+c: Nat, +x: Nat, +t: Nat, b: Bool, +cs: List<&2, Da.Conn>, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.held(c, Da.open.keep(x, t, b, cs)) == Da.held(c, cs) : Maybe<&2, Nat>}:
  match b:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(x, c), False{}, ne) : {Da.held.put(t, Da.held(c, cs), _) == Da.held(c, cs) : Maybe<&2, Nat>}
      {==}
    case False{}:
      {==}

# an open of another connection leaves the row of c as it was
def pa.held_open_other(+c: Nat, +x: Nat, shown: Maybe<&2, Nat>, +cur: Nat, +cs: List<&2, Da.Conn>, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.held(c, Da.open.next(x, shown, cur, Da.drop(x, cs))) == Da.held(c, cs) : Maybe<&2, Nat>}:
  match shown:
    case None{}:
      pa.held_drop_other(c, x, cs, ne)
    case Some{+t}:
      %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.open.keep(x, t, Nat.is_eq(t, cur), Da.drop(x, cs))), Da.held(c, Da.drop(x, cs)), pa.held_keep_other(c, x, t, Nat.is_eq(t, cur), Da.drop(x, cs), ne)) : {_ == Da.held(c, cs) : Maybe<&2, Nat>}
      pa.held_drop_other(c, x, cs, ne)

# a frame of another connection leaves the row of c as it was
def pa.held_frame_other(+c: Nat, +x: Nat, b: Bool, +cs: List<&2, Da.Conn>, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.held(c, Da.frame.next(x, b, cs)) == Da.held(c, cs) : Maybe<&2, Nat>}:
  match b:
    case True{}:
      {==}
    case False{}:
      pa.held_drop_other(c, x, cs, ne)

# Stale connections
# -----------------

# not open, or holding a token older than cur
def pa.stale(+cur: Nat, m: Maybe<&2, Nat>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{t}:
      Nat.is_lt(t, cur)

# a row equal to a stale one is stale
def pa.stale_eq(+cur: Nat, m: Maybe<&2, Nat>, n: Maybe<&2, Nat>, +e: {m == n : Maybe<&2, Nat>}, +h: {pa.stale(cur, n) == True{} : Bool}) -> {pa.stale(cur, m) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Nat>, m, n, e) : {pa.stale(cur, _) == True{} : Bool}
  h

def pa.stale_succ(+cur: Nat, m: Maybe<&2, Nat>, +h: {pa.stale(cur, m) == True{} : Bool}) -> {pa.stale(1n+cur, m) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{t}:
      pa.lt_succ(t, cur, h)

# a stale row is not admitted
def pa.stale_no(+cur: Nat, m: Maybe<&2, Nat>, +h: {pa.stale(cur, m) == True{} : Bool}) -> {Da.admit(cur, m) == False{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{t}:
      pa.lt_ne(t, cur, h)

# a stale connection's frame does not run
def pa.stale_frame(+c: Nat, m: Maybe<&2, Nat>, +cur: Nat, +h: {pa.stale(cur, m) == True{} : Bool}) -> {Da.ran(c, Da.frame.out(c, m, cur)) == False{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+t}:
      %Equal.sym(Bool, Nat.is_eq(t, cur), False{}, pa.lt_ne(t, cur, h)) : {Da.ran(c, Da.frame.ran(c, _)) == False{} : Bool}
      {==}

def pa.fr_other(+c: Nat, +x: Nat, b: Bool, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.ran(c, Da.frame.ran(x, b)) == False{} : Bool}:
  match b:
    case True{}:
      ne
    case False{}:
      {==}

# another connection's frame runs no frame of c
def pa.frame_other(+c: Nat, +x: Nat, m: Maybe<&2, Nat>, +cur: Nat, +ne: {Nat.is_eq(x, c) == False{} : Bool}) -> {Da.ran(c, Da.frame.out(x, m, cur)) == False{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{t}:
      pa.fr_other(c, x, Nat.is_eq(t, cur), ne)

def pa.open_not_ran(+c: Nat, x: Nat, b: Bool) -> {Da.ran(c, Da.open.out(x, b)) == False{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# a frame of x, while c is stale, runs no frame of c
def pa.frame_quiet(+c: Nat, +x: Nat, b: Bool, +eb: {Nat.is_eq(x, c) == b : Bool}, +cur: Nat, +cs: List<&2, Da.Conn>, +st: {pa.stale(cur, Da.held(c, cs)) == True{} : Bool}) -> {Da.ran(c, Da.frame.out(x, Da.held(x, cs), cur)) == False{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, x, c, pa.eq_true(x, c, eb)) : {Da.ran(c, Da.frame.out(_, Da.held(_, cs), cur)) == False{} : Bool}
      pa.stale_frame(c, Da.held(c, cs), cur, st)
    case False{}:
      pa.frame_other(c, x, Da.held(x, cs), cur, eb)

# a frame of x, while c is stale, leaves c stale
def pa.frame_stale(+c: Nat, +x: Nat, b: Bool, +eb: {Nat.is_eq(x, c) == b : Bool}, +cur: Nat, +cs: List<&2, Da.Conn>, +st: {pa.stale(cur, Da.held(c, cs)) == True{} : Bool}) -> {pa.stale(cur, Da.held(c, Da.frame.next(x, Da.admit(cur, Da.held(x, cs)), cs))) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, x, c, pa.eq_true(x, c, eb)) : {pa.stale(cur, Da.held(c, Da.frame.next(_, Da.admit(cur, Da.held(_, cs)), cs))) == True{} : Bool}
      %Equal.sym(Bool, Da.admit(cur, Da.held(c, cs)), False{}, pa.stale_no(cur, Da.held(c, cs), st)) : {pa.stale(cur, Da.held(c, Da.frame.next(c, _, cs))) == True{} : Bool}
      %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.drop(c, cs)), None{}, pa.held_drop_same(c, cs)) : {pa.stale(cur, _) == True{} : Bool}
      {==}
    case False{}:
      pa.stale_eq(cur, Da.held(c, Da.frame.next(x, Da.admit(cur, Da.held(x, cs)), cs)), Da.held(c, cs), pa.held_frame_other(c, x, Da.admit(cur, Da.held(x, cs)), cs, eb), st)

# one event, other than an open of c, runs no frame of a stale c
def pa.step_quiet(+s: Da.St, +e: Da.Ev, +c: Nat, +st: {pa.stale(Da.St.cur(s), Da.held(c, Da.St.conns(s))) == True{} : Bool}, +no: {Da.opens(c, e) == False{} : Bool}) -> {Da.ran(c, Da.out(s, e)) == False{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      match e:
        case Da.Rotate{}:
          {==}
        case Da.Open{+x, shown}:
          pa.open_not_ran(c, x, Da.admit(cur, shown))
        case Da.Frame{+x}:
          pa.frame_quiet(c, x, Nat.is_eq(x, c), {==}, cur, cs, st)

# one event, other than an open of c, leaves a stale c stale
def pa.step_stale(+s: Da.St, +e: Da.Ev, +c: Nat, +st: {pa.stale(Da.St.cur(s), Da.held(c, Da.St.conns(s))) == True{} : Bool}, +no: {Da.opens(c, e) == False{} : Bool}) -> {pa.stale(Da.St.cur(Da.next(s, e)), Da.held(c, Da.St.conns(Da.next(s, e)))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      match e:
        case Da.Rotate{}:
          pa.stale_succ(cur, Da.held(c, cs), st)
        case Da.Open{+x, +shown}:
          pa.stale_eq(cur, Da.held(c, Da.open.next(x, shown, cur, Da.drop(x, cs))), Da.held(c, cs), pa.held_open_other(c, x, shown, cur, cs, no), st)
        case Da.Frame{+x}:
          pa.frame_stale(c, x, Nat.is_eq(x, c), {==}, cur, cs, st)

# a stale connection runs no frame until it opens again
def pa.quiet(evs: List<&2, Da.Ev>, +s: Da.St, +c: Nat, +st: {pa.stale(Da.St.cur(s), Da.held(c, Da.St.conns(s))) == True{} : Bool}, +again: {Da.any_opens(c, evs) == False{} : Bool}) -> {Da.any_ran(c, Da.run(evs, s)) == False{} : Bool}:
  match evs:
    case Nil{}:
      {==}
    case +e <> +rest:
      %Equal.sym(Bool, Da.ran(c, Da.out(s, e)), False{}, pa.step_quiet(s, e, c, st, pa.or_l(Da.opens(c, e), Da.any_opens(c, rest), again))) : {Bool.or(_, Da.any_ran(c, Da.run(rest, Da.next(s, e)))) == False{} : Bool}
      pa.quiet(rest, Da.next(s, e), c, pa.step_stale(s, e, c, st, pa.or_l(Da.opens(c, e), Da.any_opens(c, rest), again)), pa.or_r(Da.opens(c, e), Da.any_opens(c, rest), again))

# a rejected open leaves its connection stale
def pa.rejected_stale(+s: Da.St, +c: Nat, +shown: Maybe<&2, Nat>, +rejected: {Da.is_paired(Da.out(s, Da.Open{c, shown})) == False{} : Bool}) -> {pa.stale(Da.St.cur(Da.next(s, Da.Open{c, shown})), Da.held(c, Da.St.conns(Da.next(s, Da.Open{c, shown})))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      match shown:
        case None{}:
          %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.drop(c, cs)), None{}, pa.held_drop_same(c, cs)) : {pa.stale(cur, _) == True{} : Bool}
          {==}
        case Some{+t}:
          %Equal.sym(Bool, Nat.is_eq(t, cur), False{}, pa.rejected_no(c, Nat.is_eq(t, cur), rejected)) : {pa.stale(cur, Da.held(c, Da.open.keep(c, t, _, Da.drop(c, cs)))) == True{} : Bool}
          %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.drop(c, cs)), None{}, pa.held_drop_same(c, cs)) : {pa.stale(cur, _) == True{} : Bool}
          {==}

# Reachable states
# ----------------

# every token the table holds is at most cur
def pa.inv(+cur: Nat, cs: List<&2, Da.Conn>) -> Bool:
  match cs:
    case Nil{}:
      True{}
    case Da.Conn{i, t} <> rest:
      Bool.and(Nat.is_le(t, cur), pa.inv(cur, rest))

def pa.inv_succ(+cur: Nat, cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.inv(1n+cur, cs) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Da.Conn{i, +t} <> +rest:
      %Equal.sym(Bool, Nat.is_le(t, 1n+cur), True{}, pa.le_succ(t, cur, pa.and_l(Nat.is_le(t, cur), pa.inv(cur, rest), h))) : {Bool.and(_, pa.inv(1n+cur, rest)) == True{} : Bool}
      pa.inv_succ(cur, rest, pa.and_r(Nat.is_le(t, cur), pa.inv(cur, rest), h))

def pa.inv_put(+cur: Nat, +i: Nat, +t: Nat, r: List<&2, Da.Conn>, hit: Bool, +ht: {Nat.is_le(t, cur) == True{} : Bool}, +hr: {pa.inv(cur, r) == True{} : Bool}) -> {pa.inv(cur, Da.drop.put(Da.Conn{i, t}, r, hit)) == True{} : Bool}:
  match hit:
    case True{}:
      hr
    case False{}:
      %Equal.sym(Bool, Nat.is_le(t, cur), True{}, ht) : {Bool.and(_, pa.inv(cur, r)) == True{} : Bool}
      hr

def pa.inv_drop(+cur: Nat, +x: Nat, cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.inv(cur, Da.drop(x, cs)) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Da.Conn{+i, +t} <> +rest:
      pa.inv_put(cur, i, t, Da.drop(x, rest), Nat.is_eq(i, x), pa.and_l(Nat.is_le(t, cur), pa.inv(cur, rest), h), pa.inv_drop(cur, x, rest, pa.and_r(Nat.is_le(t, cur), pa.inv(cur, rest), h)))

def pa.inv_keep(+cur: Nat, x: Nat, +t: Nat, b: Bool, +eb: {Nat.is_eq(t, cur) == b : Bool}, +cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.inv(cur, Da.open.keep(x, t, b, cs)) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, Nat.is_le(t, cur), True{}, pa.eq_le(t, cur, eb)) : {Bool.and(_, pa.inv(cur, cs)) == True{} : Bool}
      h
    case False{}:
      h

def pa.inv_open(+cur: Nat, +x: Nat, shown: Maybe<&2, Nat>, +cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.inv(cur, Da.open.next(x, shown, cur, Da.drop(x, cs))) == True{} : Bool}:
  match shown:
    case None{}:
      pa.inv_drop(cur, x, cs, h)
    case Some{+t}:
      pa.inv_keep(cur, x, t, Nat.is_eq(t, cur), {==}, Da.drop(x, cs), pa.inv_drop(cur, x, cs, h))

def pa.inv_frame(+cur: Nat, +x: Nat, b: Bool, +cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.inv(cur, Da.frame.next(x, b, cs)) == True{} : Bool}:
  match b:
    case True{}:
      h
    case False{}:
      pa.inv_drop(cur, x, cs, h)

def pa.inv_next(+s: Da.St, +e: Da.Ev, +h: {pa.inv(Da.St.cur(s), Da.St.conns(s)) == True{} : Bool}) -> {pa.inv(Da.St.cur(Da.next(s, e)), Da.St.conns(Da.next(s, e))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      match e:
        case Da.Rotate{}:
          pa.inv_succ(cur, cs, h)
        case Da.Open{+x, +shown}:
          pa.inv_open(cur, x, shown, cs, h)
        case Da.Frame{+x}:
          pa.inv_frame(cur, x, Da.admit(cur, Da.held(x, cs)), cs, h)

# every reachable state holds only tokens made so far
def pa.inv_state(evs: List<&2, Da.Ev>, +s: Da.St, +h: {pa.inv(Da.St.cur(s), Da.St.conns(s)) == True{} : Bool}) -> {pa.inv(Da.St.cur(Da.state(evs, s)), Da.St.conns(Da.state(evs, s))) == True{} : Bool}:
  match evs:
    case Nil{}:
      h
    case +e <> +rest:
      pa.inv_state(rest, Da.next(s, e), pa.inv_next(s, e, h))

# a row holds a token made so far, or none
def pa.made(+cur: Nat, m: Maybe<&2, Nat>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{t}:
      Nat.is_le(t, cur)

def pa.made_put(+cur: Nat, +t: Nat, r: Maybe<&2, Nat>, hit: Bool, +ht: {Nat.is_le(t, cur) == True{} : Bool}, +hr: {pa.made(cur, r) == True{} : Bool}) -> {pa.made(cur, Da.held.put(t, r, hit)) == True{} : Bool}:
  match hit:
    case True{}:
      ht
    case False{}:
      hr

def pa.held_made(+c: Nat, +cur: Nat, cs: List<&2, Da.Conn>, +h: {pa.inv(cur, cs) == True{} : Bool}) -> {pa.made(cur, Da.held(c, cs)) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Da.Conn{+i, +t} <> +rest:
      pa.made_put(cur, t, Da.held(c, rest), Nat.is_eq(i, c), pa.and_l(Nat.is_le(t, cur), pa.inv(cur, rest), h), pa.held_made(c, cur, rest, pa.and_r(Nat.is_le(t, cur), pa.inv(cur, rest), h)))

def pa.made_stale(+cur: Nat, m: Maybe<&2, Nat>, +h: {pa.made(cur, m) == True{} : Bool}) -> {pa.stale(1n+cur, m) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{t}:
      pa.le_lt_succ(t, cur, h)

# a rotation makes every connection of a reachable state stale
def pa.rotate_stale(+s: Da.St, +c: Nat, +h: {pa.inv(Da.St.cur(s), Da.St.conns(s)) == True{} : Bool}) -> {pa.stale(Da.St.cur(Da.next(s, Da.Rotate{})), Da.held(c, Da.St.conns(Da.next(s, Da.Rotate{})))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      pa.made_stale(cur, Da.held(c, cs), pa.held_made(c, cur, cs, h))

# The current token only grows
# ----------------------------

def pa.lt_next(+s: Da.St, +e: Da.Ev, +t: Nat, +h: {Nat.is_lt(t, Da.St.cur(s)) == True{} : Bool}) -> {Nat.is_lt(t, Da.St.cur(Da.next(s, e))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      match e:
        case Da.Rotate{}:
          pa.lt_succ(t, cur, h)
        case Da.Open{x, shown}:
          h
        case Da.Frame{x}:
          h

def pa.lt_state(evs: List<&2, Da.Ev>, +s: Da.St, +t: Nat, +h: {Nat.is_lt(t, Da.St.cur(s)) == True{} : Bool}) -> {Nat.is_lt(t, Da.St.cur(Da.state(evs, s))) == True{} : Bool}:
  match evs:
    case Nil{}:
      h
    case +e <> +rest:
      pa.lt_state(rest, Da.next(s, e), t, pa.lt_next(s, e, t, h))

def pa.lt_rotate(+s: Da.St, +t: Nat, +h: {Nat.is_le(t, Da.St.cur(s)) == True{} : Bool}) -> {Nat.is_lt(t, Da.St.cur(Da.next(s, Da.Rotate{}))) == True{} : Bool}:
  match s:
    case Da.St{+cur, +cs}:
      pa.le_lt_succ(t, cur, h)

# The laws
# --------

def pa.frame_runs_only_current(+s: Da.St, +c: Nat, +ran: {Da.ran(c, Da.out(s, Da.Frame{c})) == True{} : Bool}) -> {Da.held(c, Da.St.conns(s)) == Some{Da.St.cur(s)} : Maybe<&2, Nat>}:
  pa.frame_ran_cur(c, Da.held(c, Da.St.conns(s)), Da.St.cur(s), ran)

def pa.current_frame_runs(+s: Da.St, +c: Nat, +cur: {Da.held(c, Da.St.conns(s)) == Some{Da.St.cur(s)} : Maybe<&2, Nat>}) -> {Da.out(s, Da.Frame{c}) == Da.Ran{c} : Da.Out}:
  %Equal.sym(Maybe<&2, Nat>, Da.held(c, Da.St.conns(s)), Some{Da.St.cur(s)}, cur) : {Da.frame.out(c, _, Da.St.cur(s)) == Da.Ran{c} : Da.Out}
  %pa.eq_refl(Da.St.cur(s)) : {Da.frame.ran(c, _) == Da.Ran{c} : Da.Out}
  {==}

def pa.open_pairs_only_current(+s: Da.St, +c: Nat, +shown: Maybe<&2, Nat>, +paired: {Da.is_paired(Da.out(s, Da.Open{c, shown})) == True{} : Bool}) -> {shown == Some{Da.St.cur(s)} : Maybe<&2, Nat>}:
  pa.admit_cur(Da.St.cur(s), shown, pa.paired_ok(c, Da.admit(Da.St.cur(s), shown), paired))

def pa.current_open_pairs(+s: Da.St, +c: Nat) -> {Da.out(s, Da.Open{c, Some{Da.St.cur(s)}}) == Da.Paired{c} : Da.Out}:
  %pa.eq_refl(Da.St.cur(s)) : {Da.open.out(c, _) == Da.Paired{c} : Da.Out}
  {==}

def pa.paired_holds_token(+s: Da.St, +c: Nat) -> {Da.held(c, Da.St.conns(Da.next(s, Da.Open{c, Some{Da.St.cur(s)}}))) == Some{Da.St.cur(s)} : Maybe<&2, Nat>}:
  match s:
    case Da.St{+cur, +cs}:
      %pa.eq_refl(cur) : {Da.held(c, Da.open.keep(c, cur, _, Da.drop(c, cs))) == Some{cur} : Maybe<&2, Nat>}
      %pa.eq_refl(c) : {Da.held.put(cur, Da.held(c, Da.drop(c, cs)), _) == Some{cur} : Maybe<&2, Nat>}
      {==}

def pa.closed_runs_nothing(+s: Da.St, +c: Nat, +evs: List<&2, Da.Ev>, +closed: {Da.held(c, Da.St.conns(s)) == None{} : Maybe<&2, Nat>}, +again: {Da.any_opens(c, evs) == False{} : Bool}) -> {Da.any_ran(c, Da.run(evs, s)) == False{} : Bool}:
  pa.quiet(evs, s, c, pa.stale_eq(Da.St.cur(s), Da.held(c, Da.St.conns(s)), None{}, closed, {==}), again)

def pa.rejected_runs_nothing(+s: Da.St, +c: Nat, +shown: Maybe<&2, Nat>, +evs: List<&2, Da.Ev>, +rejected: {Da.is_paired(Da.out(s, Da.Open{c, shown})) == False{} : Bool}, +again: {Da.any_opens(c, evs) == False{} : Bool}) -> {Da.any_ran(c, Da.run(Da.Open{c, shown} <> evs, s)) == False{} : Bool}:
  %Equal.sym(Bool, Da.ran(c, Da.out(s, Da.Open{c, shown})), False{}, pa.open_not_ran(c, c, Da.admit(Da.St.cur(s), shown))) : {Bool.or(_, Da.any_ran(c, Da.run(evs, Da.next(s, Da.Open{c, shown})))) == False{} : Bool}
  pa.quiet(evs, Da.next(s, Da.Open{c, shown}), c, pa.rejected_stale(s, c, shown, rejected), again)

def pa.rotation_ends_connections(+hist: List<&2, Da.Ev>, +c: Nat, +evs: List<&2, Da.Ev>, +again: {Da.any_opens(c, evs) == False{} : Bool}) -> {Da.any_ran(c, Da.run(Da.Rotate{} <> evs, Da.state(hist, Da.init()))) == False{} : Bool}:
  pa.quiet(evs, Da.next(Da.state(hist, Da.init()), Da.Rotate{}), c, pa.rotate_stale(Da.state(hist, Da.init()), c, pa.inv_state(hist, Da.init(), {==})), again)

def pa.rotation_rejects_old_tokens(+hist: List<&2, Da.Ev>, +more: List<&2, Da.Ev>, +c: Nat, +t: Nat, +old: {Nat.is_le(t, Da.St.cur(Da.state(hist, Da.init()))) == True{} : Bool}) -> {Da.out(Da.state(Da.Rotate{} <> more, Da.state(hist, Da.init())), Da.Open{c, Some{t}}) == Da.Rejected{c} : Da.Out}:
  %Equal.sym(Bool, Nat.is_eq(t, Da.St.cur(Da.state(more, Da.next(Da.state(hist, Da.init()), Da.Rotate{})))), False{}, pa.lt_ne(t, Da.St.cur(Da.state(more, Da.next(Da.state(hist, Da.init()), Da.Rotate{}))), pa.lt_state(more, Da.next(Da.state(hist, Da.init()), Da.Rotate{}), t, pa.lt_rotate(Da.state(hist, Da.init()), t, old)))) : {Da.open.out(c, _) == Da.Rejected{c} : Da.Out}
  {==}

# ---- documents ----

# proof_documents: the lemmas behind the laws of LAWS.bend section documents
# (Laws.<law> in PROOF.bend delegates here; the lines and endings laws
# delegate to PROOF.bend section doc_lines), one section per model of
# bend/doc_*.bend. Each section keeps its own name prefix: pc. (an edit of
# many files, the write tool, a move, the temp sweep), pv. (seen lines),
# ps. (what grep searched, continuations), pdt. (tags).

# ==== commit ====
# proof_doc_commit: the edit, write, move and sweep laws of
# LAWS.bend section documents (F1, F9, F2, F5, F10): the reply of an edit names
# exactly the files that landed, a conflict lands nothing, a sound edit
# lands every file; a write never replaces a version the session did not
# see; a move never replaces a file; a sweep removes only the free
# temporary files of its target, and all of them.
# Logic and numbers
# -----------------

def documents.pc.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def documents.pc.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : documents.pc.BD(_, Unit, A)
  Unit{}

def pc.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      documents.pc.absurd({0n == 1n+q : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 0n:
      documents.pc.absurd({1n+p == 0n : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 1n+q:
      %pc.eq_true(p, q, h) : {1n+p == 1n+_ : Nat}
      {==}

def documents.pc.eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      documents.pc.eq_refl(p)

def pc.or_t(a: Bool) -> {Bool.or(a, True{}) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pc.or_false_l(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      documents.pc.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def documents.pc.or_false_r(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      documents.pc.absurd({b == False{} : Bool}, h)
    case False{}:
      h

# Edit
# ----

# with no publish, the reply applies no file
def pc.none_applied(fs: List<&2, Cm.Doc>, +n: Nat) -> {Cm.applied(Cm.report(fs, Nil{}), n) == Nil{} : List<&2, Nat>}:
  match fs:
    case Nil{}:
      {==}
    case f <> rest:
      pc.none_applied(rest, 1n+n)

def pc.step(-f: Cm.Doc, +rest: List<&2, Cm.Doc>, +n: Nat, o: Cm.Out, ih: {Cm.applied(Cm.report(rest, Cm.run(rest)), 1n+n) == Cm.landed.go(rest, 1n+n) : List<&2, Nat>}) -> {Cm.applied(Cm.report(f <> rest, Cm.run.put(o, Cm.run(rest))), n) == Cm.landed.put(n, Cm.landed.go(rest, 1n+n), o) : List<&2, Nat>}:
  match o:
    case Cm.Landed{w}:
      %ih : {n <> Cm.applied(Cm.report(rest, Cm.run(rest)), 1n+n) == n <> _ : List<&2, Nat>}
      {==}
    case Cm.Failed{}:
      pc.none_applied(rest, 1n+n)

# the reply built from the publishes applies the files that landed
def pc.reported(fs: List<&2, Cm.Doc>, +n: Nat) -> {Cm.applied(Cm.report(fs, Cm.run(fs)), n) == Cm.landed.go(fs, n) : List<&2, Nat>}:
  match fs:
    case Nil{}:
      {==}
    case +f <> +rest:
      pc.step(f, rest, n, Cm.publish(f), pc.reported(rest, 1n+n))

def pc.go.step(-f: Cm.Doc, +rest: List<&2, Cm.Doc>, o: Cm.Out) -> {Cm.reported(Cm.reply.go(Cm.run.put(o, Cm.run(rest)), f <> rest)) == Cm.landed.put(0n, Cm.landed.go(rest, 1n), o) : List<&2, Nat>}:
  match o:
    case Cm.Landed{+w}:
      pc.step(f, rest, 0n, Cm.Landed{w}, pc.reported(rest, 1n))
    case Cm.Failed{}:
      {==}

def pc.go(fs: List<&2, Cm.Doc>) -> {Cm.reported(Cm.reply.go(Cm.run(fs), fs)) == Cm.landed.go(fs, 0n) : List<&2, Nat>}:
  match fs:
    case Nil{}:
      {==}
    case +f <> +rest:
      pc.go.step(f, rest, Cm.publish(f))

def pc.pick(c: Bool, +fs: List<&2, Cm.Doc>) -> {Cm.reported(Cm.reply.pick(c, fs)) == Cm.landed.pick(c, fs) : List<&2, Nat>}:
  match c:
    case True{}:
      {==}
    case False{}:
      pc.go(fs)

# the law edit_reports_what_landed
def pc.reports_what_landed(+fs: List<&2, Cm.Doc>) -> {Cm.reported(Cm.reply(fs)) == Cm.landed(fs) : List<&2, Nat>}:
  pc.pick(Cm.conflict(fs), fs)

# a changed file anywhere is a conflict
def pc.conflict_at(pre: List<&2, Cm.Doc>, +k: Cm.Op, +x: Cm.Fault, +post: List<&2, Cm.Doc>) -> {Cm.conflict(List.append(&2, Cm.Doc, pre, Cm.Doc{k, True{}, x} <> post)) == True{} : Bool}:
  match pre:
    case Nil{}:
      {==}
    case g <> rest:
      match g:
        case Cm.Doc{gk, gc, gx}:
          %Equal.sym(Bool, Cm.conflict(List.append(&2, Cm.Doc, rest, Cm.Doc{k, True{}, x} <> post)), True{}, pc.conflict_at(rest, k, x, post)) : {Bool.or(gc, _) == True{} : Bool}
          pc.or_t(gc)

# the law edit_all_or_nothing_on_conflict
def pc.all_or_nothing(+pre: List<&2, Cm.Doc>, +k: Cm.Op, +x: Cm.Fault, +post: List<&2, Cm.Doc>) -> {Cm.landed(List.append(&2, Cm.Doc, pre, Cm.Doc{k, True{}, x} <> post)) == Nil{} : List<&2, Nat>}:
  +fs = {List.append(&2, Cm.Doc, pre, Cm.Doc{k, True{}, x} <> post) : List<&2, Cm.Doc>}
  %Equal.sym(Bool, Cm.conflict(fs), True{}, pc.conflict_at(pre, k, x, post)) : {Cm.landed.pick(_, fs) == Nil{} : List<&2, Nat>}
  {==}

def pc.lands_put(x: Cm.Fault, k: Cm.Op, -rest: List<&2, Cm.Doc>, +n: Nat, ok: {Bool.or(Cm.Fault.fails(x), Cm.failing(rest)) == False{} : Bool}, ih: {Cm.failing(rest) == False{} : Bool} -> {Cm.landed.go(rest, 1n+n) == Cm.ids(rest, 1n+n) : List<&2, Nat>}) -> {Cm.landed.put(n, Cm.landed.go(rest, 1n+n), Cm.publish.go(x, k)) == n <> Cm.ids(rest, 1n+n) : List<&2, Nat>}:
  match x:
    case Cm.Clean{}:
      %ih(ok) : {n <> Cm.landed.go(rest, 1n+n) == n <> _ : List<&2, Nat>}
      {==}
    case Cm.Sync{}:
      %ih(ok) : {n <> Cm.landed.go(rest, 1n+n) == n <> _ : List<&2, Nat>}
      {==}
    case Cm.Publish{}:
      documents.pc.absurd({Cm.landed.put(n, Cm.landed.go(rest, 1n+n), Cm.Failed{}) == n <> Cm.ids(rest, 1n+n) : List<&2, Nat>}, ok)
    case Cm.Remove{}:
      match k:
        case Cm.Update{}:
          %ih(ok) : {n <> Cm.landed.go(rest, 1n+n) == n <> _ : List<&2, Nat>}
          {==}
        case Cm.Moving{}:
          %ih(ok) : {n <> Cm.landed.go(rest, 1n+n) == n <> _ : List<&2, Nat>}
          {==}

# with no failed publish, every file lands
def pc.lands_go(fs: List<&2, Cm.Doc>, +n: Nat, ok: {Cm.failing(fs) == False{} : Bool}) -> {Cm.landed.go(fs, n) == Cm.ids(fs, n) : List<&2, Nat>}:
  match fs:
    case Nil{}:
      {==}
    case g <> +rest:
      match g:
        case Cm.Doc{k, c, x}:
          pc.lands_put(x, k, rest, n, ok, h => pc.lands_go(rest, 1n+n, h))

# the law edit_lands_every_file
def pc.lands_every_file(+fs: List<&2, Cm.Doc>, same: {Cm.conflict(fs) == False{} : Bool}, sound: {Cm.failing(fs) == False{} : Bool}) -> {Cm.landed(fs) == Cm.ids(fs, 0n) : List<&2, Nat>}:
  %Equal.sym(Bool, Cm.conflict(fs), False{}, same) : {Cm.landed.pick(_, fs) == Cm.ids(fs, 0n) : List<&2, Nat>}
  pc.lands_go(fs, 0n, sound)

# Write
# -----

# the law write_never_loses_unseen
def pc.write_refused(+d: Maybe<&2, Nat>, +s: List<&2, Nat>, +c: Nat, lost: {Cm.unseen(d, s) == True{} : Bool}) -> {Cm.write(d, s, c) == Cm.Wt{False{}, d, s} : Cm.Wt}:
  %Equal.sym(Bool, Cm.unseen(d, s), True{}, lost) : {Cm.write.go(_, d, s, c) == Cm.Wt{False{}, d, s} : Cm.Wt}
  {==}

# the law write_writes_seen
def pc.write_writes(+d: Maybe<&2, Nat>, +s: List<&2, Nat>, +c: Nat, kept: {Cm.unseen(d, s) == False{} : Bool}) -> {Cm.write(d, s, c) == Cm.Wt{True{}, Some{c}, Cm.saw(c, s)} : Cm.Wt}:
  %Equal.sym(Bool, Cm.unseen(d, s), False{}, kept) : {Cm.write.go(_, d, s, c) == Cm.Wt{True{}, Some{c}, Cm.saw(c, s)} : Cm.Wt}
  {==}

# Move
# ----

# the law move_never_overwrites
def pc.move_taken(+s: Nat, +t: Nat, +es: List<&2, Cm.Entry>, taken: {Cm.has(t, es) == True{} : Bool}) -> {Cm.move(s, t, es) == Cm.Mv{False{}, es} : Cm.Mv}:
  %Equal.sym(Bool, Cm.has(t, es), True{}, taken) : {Cm.move.go(s, t, _, es) == Cm.Mv{False{}, es} : Cm.Mv}
  {==}

# a free name is not the name of a file that is there
def pc.ne.go(+t: Nat, +s: Nat, -es: List<&2, Cm.Entry>, b: Bool, eb: {Nat.is_eq(t, s) == b : Bool}, free: {Cm.has(t, es) == False{} : Bool}, from: {Cm.has(s, es) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      same = {Equal.cong(Nat, Bool, y => Cm.has(y, es), s, t, Equal.sym(Nat, t, s, pc.eq_true(t, s, eb))) : {Cm.has(s, es) == Cm.has(t, es) : Bool}}
      Equal.trans(Bool, True{}, Cm.has(s, es), False{}, Equal.sym(Bool, Cm.has(s, es), True{}, from), Equal.trans(Bool, Cm.has(s, es), Cm.has(t, es), False{}, same, free))
    case False{}:
      {==}

def pc.gone.put(+s: Nat, +t: Nat, +m: Nat, g: Nat, -r: List<&2, Cm.Entry>, b: Bool, eb: {Nat.is_eq(m, s) == b : Bool}, ne: {Nat.is_eq(t, s) == False{} : Bool}, ih: {Cm.has(s, r) == False{} : Bool}) -> {Cm.has(s, Cm.rename.put(t, m, g, r, b)) == False{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(t, s), False{}, ne) : {Bool.or(_, Cm.has(s, r)) == False{} : Bool}
      ih
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(m, s), False{}, eb) : {Bool.or(_, Cm.has(s, r)) == False{} : Bool}
      ih

# after the move no file has the source name
def pc.gone(+s: Nat, +t: Nat, es: List<&2, Cm.Entry>, +ne: {Nat.is_eq(t, s) == False{} : Bool}) -> {Cm.has(s, Cm.rename(s, t, es)) == False{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Cm.Entry{+m, g}:
          pc.gone.put(s, t, m, g, Cm.rename(s, t, rest), Nat.is_eq(m, s), {==}, ne, pc.gone(s, t, rest, ne))

def pc.lands.put(+s: Nat, +t: Nat, +m: Nat, +g: Nat, -r: List<&2, Cm.Entry>, -rest: List<&2, Cm.Entry>, b: Bool, hm: {Nat.is_eq(m, t) == False{} : Bool}, ih: {Cm.get(t, r) == Cm.get(s, rest) : Maybe<&2, Nat>}) -> {Cm.get(t, Cm.rename.put(t, m, g, r, b)) == Cm.get.put(b, g, Cm.get(s, rest)) : Maybe<&2, Nat>}:
  match b:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(t, t), True{}, documents.pc.eq_refl(t)) : {Cm.get.put(_, g, Cm.get(t, r)) == Some{g} : Maybe<&2, Nat>}
      {==}
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(m, t), False{}, hm) : {Cm.get.put(_, g, Cm.get(t, r)) == Cm.get(s, rest) : Maybe<&2, Nat>}
      ih

# after the move the destination holds what the source held
def pc.lands(+s: Nat, +t: Nat, es: List<&2, Cm.Entry>, +free: {Cm.has(t, es) == False{} : Bool}) -> {Cm.get(t, Cm.rename(s, t, es)) == Cm.get(s, es) : Maybe<&2, Nat>}:
  match es:
    case Nil{}:
      {==}
    case e <> +rest:
      match e:
        case Cm.Entry{+m, +g}:
          pc.lands.put(s, t, m, g, Cm.rename(s, t, rest), rest, Nat.is_eq(m, s), pc.or_false_l(Nat.is_eq(m, t), Cm.has(t, rest), free), pc.lands(s, t, rest, documents.pc.or_false_r(Nat.is_eq(m, t), Cm.has(t, rest), free)))

# the law move_moves
def pc.move_moves(+s: Nat, +t: Nat, +es: List<&2, Cm.Entry>, +free: {Cm.has(t, es) == False{} : Bool}, +from: {Cm.has(s, es) == True{} : Bool}) -> {Cm.Mv.ok(Cm.move(s, t, es)) == True{} : Bool} & {Cm.has(s, Cm.Mv.es(Cm.move(s, t, es))) == False{} : Bool} & {Cm.get(t, Cm.Mv.es(Cm.move(s, t, es))) == Cm.get(s, es) : Maybe<&2, Nat>}:
  %Equal.sym(Bool, Cm.has(t, es), False{}, free) : {Cm.Mv.ok(Cm.move.go(s, t, _, es)) == True{} : Bool} & {Cm.has(s, Cm.Mv.es(Cm.move.go(s, t, _, es))) == False{} : Bool} & {Cm.get(t, Cm.Mv.es(Cm.move.go(s, t, _, es))) == Cm.get(s, es) : Maybe<&2, Nat>}
  ({==}, (pc.gone(s, t, es, pc.ne.go(t, s, es, Nat.is_eq(t, s), {==}, free, from)), pc.lands(s, t, es, free)))

# Sweep
# -----

def pc.put_app(+n: Cm.Temp, a: List<&2, Cm.Temp>, +c: List<&2, Cm.Temp>, b: Bool) -> {Cm.sweep.put(n, List.append(&2, Cm.Temp, a, c), b) == List.append(&2, Cm.Temp, Cm.sweep.put(n, a, b), c) : List<&2, Cm.Temp>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pc.sweep_app(pre: List<&2, Cm.Temp>, +x: List<&2, Cm.Temp>) -> {List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(x)) == Cm.sweep(List.append(&2, Cm.Temp, pre, x)) : List<&2, Cm.Temp>}:
  match pre:
    case Nil{}:
      {==}
    case +n <> +rest:
      %pc.put_app(n, Cm.sweep(rest), Cm.sweep(x), Cm.removes(n)) : {_ == Cm.sweep.put(n, Cm.sweep(List.append(&2, Cm.Temp, rest, x)), Cm.removes(n)) : List<&2, Cm.Temp>}
      %pc.sweep_app(rest, x) : {Cm.sweep.put(n, List.append(&2, Cm.Temp, Cm.sweep(rest), Cm.sweep(x)), Cm.removes(n)) == Cm.sweep.put(n, _, Cm.removes(n)) : List<&2, Cm.Temp>}
      {==}

# an entry the sweep keeps: the sweep of the whole is the sweep of the parts
def pc.kept(+pre: List<&2, Cm.Temp>, +n: Cm.Temp, +post: List<&2, Cm.Temp>, no: {False{} == Cm.removes(n) : Bool}) -> {Cm.sweep(List.append(&2, Cm.Temp, pre, n <> post)) == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(post)) : List<&2, Cm.Temp>}:
  %pc.sweep_app(pre, n <> post) : {_ == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(post)) : List<&2, Cm.Temp>}
  %no : {List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep.put(n, Cm.sweep(post), _)) == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(post)) : List<&2, Cm.Temp>}
  {==}

def pc.no_held(+i: Nat, k: Cm.Sort) -> {False{} == Cm.removes(Cm.Temp{i, k, True{}}) : Bool}:
  match k:
    case Cm.Own{}:
      {==}
    case Cm.Foreign{}:
      {==}
    case Cm.Plain{}:
      {==}

# the law temp_sweep_never_held
def pc.sweep_never_held(+pre: List<&2, Cm.Temp>, +i: Nat, +k: Cm.Sort, +post: List<&2, Cm.Temp>) -> {Cm.sweep(List.append(&2, Cm.Temp, pre, Cm.Temp{i, k, True{}} <> post)) == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(post)) : List<&2, Cm.Temp>}:
  pc.kept(pre, Cm.Temp{i, k, True{}}, post, pc.no_held(i, k))

def pc.no_other(+i: Nat, +k: Cm.Sort, +h: Bool, other: {Cm.Sort.own(k) == False{} : Bool}) -> {False{} == Cm.removes(Cm.Temp{i, k, h}) : Bool}:
  %Equal.sym(Bool, Cm.Sort.own(k), False{}, other) : {False{} == Bool.and(_, Bool.not(h)) : Bool}
  {==}

# the law temp_sweep_only_own
def pc.sweep_only_own(+pre: List<&2, Cm.Temp>, +i: Nat, +k: Cm.Sort, +h: Bool, +post: List<&2, Cm.Temp>, other: {Cm.Sort.own(k) == False{} : Bool}) -> {Cm.sweep(List.append(&2, Cm.Temp, pre, Cm.Temp{i, k, h} <> post)) == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.sweep(post)) : List<&2, Cm.Temp>}:
  pc.kept(pre, Cm.Temp{i, k, h}, post, pc.no_other(i, k, h, other))

# the law temp_sweep_removes_free
def pc.sweep_removes_free(+pre: List<&2, Cm.Temp>, +i: Nat, +post: List<&2, Cm.Temp>) -> {Cm.sweep(List.append(&2, Cm.Temp, pre, Cm.Temp{i, Cm.Own{}, False{}} <> post)) == List.append(&2, Cm.Temp, Cm.sweep(pre), Cm.Temp{i, Cm.Own{}, False{}} <> Cm.sweep(post)) : List<&2, Cm.Temp>}:
  +n = {Cm.Temp{i, Cm.Own{}, False{}} : Cm.Temp}
  %pc.sweep_app(pre, n <> post) : {_ == List.append(&2, Cm.Temp, Cm.sweep(pre), n <> Cm.sweep(post)) : List<&2, Cm.Temp>}
  {==}

# ==== seen ====
# proof_doc_seen: the seen-line laws of LAWS.bend section documents (F11): an
# edit applies only on seen anchors, an edit on seen anchors applies, and
# a rejection marks its anchors seen, so a straight retry applies.
# Logic and numbers
# -----------------

def documents.pv.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def documents.pv.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : documents.pv.BD(_, Unit, A)
  Unit{}

def pv.LD(xs: List<&2, Nat>, A: Type) -> Type:
  match xs:
    case Nil{}:
      A
    case x <> rest:
      Unit

def pv.cons_nil(-A: Type, +a: Nat, u: List<&2, Nat>, e: {a <> u == Nil{} : List<&2, Nat>}) -> A:
  %e : pv.LD(_, A)
  Unit{}

def documents.pv.eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      documents.pv.eq_refl(p)

def pv.or_t(a: Bool) -> {Bool.or(a, True{}) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def documents.pv.and_l(p: Bool, q: Bool, h: {Bool.and(p, q) == True{} : Bool}) -> {p == True{} : Bool}:
  match p:
    case True{}:
      {==}
    case False{}:
      documents.pv.absurd({False{} == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))

def documents.pv.and_r(p: Bool, q: Bool, h: {Bool.and(p, q) == True{} : Bool}) -> {q == True{} : Bool}:
  match p:
    case True{}:
      h
    case False{}:
      documents.pv.absurd({q == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))

def pv.and_tt(p: Bool, q: Bool, hp: {p == True{} : Bool}, hq: {q == True{} : Bool}) -> {Bool.and(p, q) == True{} : Bool}:
  %Equal.sym(Bool, p, True{}, hp) : {Bool.and(_, q) == True{} : Bool}
  hq

def pv.le_succ(m: Nat, k: Nat, h: {Nat.is_le(m, k) == True{} : Bool}) -> {Nat.is_le(m, 1n+k) == True{} : Bool}:
  match m k:
    case 0n k:
      {==}
    case 1n+p 0n:
      documents.pv.absurd({Nat.is_le(1n+p, 1n) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 1n+q:
      pv.le_succ(p, q, h)

# Membership
# ----------

def pv.mem_head(+a: Nat, ys: List<&2, Nat>) -> {Ds.mem(a, a <> ys) == True{} : Bool}:
  %Equal.sym(Bool, Nat.is_eq(a, a), True{}, documents.pv.eq_refl(a)) : {Bool.or(_, Ds.mem(a, ys)) == True{} : Bool}
  {==}

def pv.mem_cons(+b: Nat, +x: Nat, ys: List<&2, Nat>, h: {Ds.mem(x, ys) == True{} : Bool}) -> {Ds.mem(x, b <> ys) == True{} : Bool}:
  %Equal.sym(Bool, Ds.mem(x, ys), True{}, h) : {Bool.or(Nat.is_eq(b, x), _) == True{} : Bool}
  pv.or_t(Nat.is_eq(b, x))

def pv.mem_app(+a: Nat, xs: List<&2, Nat>, +ys: List<&2, Nat>, h: {Ds.mem(a, ys) == True{} : Bool}) -> {Ds.mem(a, List.append(&2, Nat, xs, ys)) == True{} : Bool}:
  match xs:
    case Nil{}:
      h
    case +x <> +rest:
      pv.mem_cons(x, a, List.append(&2, Nat, rest, ys), pv.mem_app(a, rest, ys, h))

def pv.sub_cons(xs: List<&2, Nat>, +b: Nat, +ys: List<&2, Nat>, +h: {Ds.subset(xs, ys) == True{} : Bool}) -> {Ds.subset(xs, b <> ys) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +rest:
      +hm = documents.pv.and_l(Ds.mem(x, ys), Ds.subset(rest, ys), h)
      +hr = documents.pv.and_r(Ds.mem(x, ys), Ds.subset(rest, ys), h)
      pv.and_tt(Ds.mem(x, b <> ys), Ds.subset(rest, b <> ys), pv.mem_cons(b, x, ys, hm), pv.sub_cons(rest, b, ys, hr))

# An applied edit: its anchors are seen
# -------------------------------------

def pv.applied_nil(+seen: List<&2, Nat>, u: List<&2, Nat>, h: {Ds.Step.applied(Ds.edit.go(seen, u)) == True{} : Bool}) -> {u == Nil{} : List<&2, Nat>}:
  match u:
    case Nil{}:
      {==}
    case x <> rest:
      documents.pv.absurd({x <> rest == Nil{} : List<&2, Nat>}, Equal.sym(Bool, False{}, True{}, h))

def pv.put_nil_seen(+a: Nat, u: List<&2, Nat>, b: Bool, h: {Ds.unseen.put(a, u, b) == Nil{} : List<&2, Nat>}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      pv.cons_nil({False{} == True{} : Bool}, a, u, h)

def pv.put_nil_rest(+a: Nat, u: List<&2, Nat>, b: Bool, h: {Ds.unseen.put(a, u, b) == Nil{} : List<&2, Nat>}) -> {u == Nil{} : List<&2, Nat>}:
  match b:
    case True{}:
      h
    case False{}:
      pv.cons_nil({u == Nil{} : List<&2, Nat>}, a, u, h)

def pv.nil_subset(+seen: List<&2, Nat>, anchors: List<&2, Nat>, +h: {Ds.unseen(seen, anchors) == Nil{} : List<&2, Nat>}) -> {Ds.subset(anchors, seen) == True{} : Bool}:
  match anchors:
    case Nil{}:
      {==}
    case +a <> +rest:
      +u = Ds.unseen(seen, rest)
      +b = Ds.mem(a, seen)
      pv.and_tt(b, Ds.subset(rest, seen), pv.put_nil_seen(a, u, b, h), pv.nil_subset(seen, rest, pv.put_nil_rest(a, u, b, h)))

def pv.edit_only_seen_lines(+seen: List<&2, Nat>, +anchors: List<&2, Nat>, ok: {Ds.Step.applied(Ds.edit(seen, anchors)) == True{} : Bool}) -> {Ds.subset(anchors, seen) == True{} : Bool}:
  pv.nil_subset(seen, anchors, pv.applied_nil(seen, Ds.unseen(seen, anchors), ok))

# Seen anchors: the edit applies
# ------------------------------

def pv.subset_nil(+seen: List<&2, Nat>, anchors: List<&2, Nat>, +h: {Ds.subset(anchors, seen) == True{} : Bool}) -> {Ds.unseen(seen, anchors) == Nil{} : List<&2, Nat>}:
  match anchors:
    case Nil{}:
      {==}
    case +a <> +rest:
      +hm = documents.pv.and_l(Ds.mem(a, seen), Ds.subset(rest, seen), h)
      +hr = documents.pv.and_r(Ds.mem(a, seen), Ds.subset(rest, seen), h)
      %Equal.sym(Bool, Ds.mem(a, seen), True{}, hm) : {Ds.unseen.put(a, Ds.unseen(seen, rest), _) == Nil{} : List<&2, Nat>}
      pv.subset_nil(seen, rest, hr)

def pv.edit_seen_applies(+seen: List<&2, Nat>, +anchors: List<&2, Nat>, all: {Ds.subset(anchors, seen) == True{} : Bool}) -> {Ds.Step.applied(Ds.edit(seen, anchors)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, Ds.unseen(seen, anchors), Nil{}, pv.subset_nil(seen, anchors, all)) : {Ds.Step.applied(Ds.edit.go(seen, _)) == True{} : Bool}
  {==}

# A rejection, then a retry
# -------------------------

# every anchor is seen or unseen
def pv.cover.go(+seen: List<&2, Nat>, +a: Nat, +rest: List<&2, Nat>, b: Bool, e: {Ds.mem(a, seen) == b : Bool}, ih: {Ds.subset(rest, List.append(&2, Nat, Ds.unseen(seen, rest), seen)) == True{} : Bool}) -> {Ds.subset(a <> rest, List.append(&2, Nat, Ds.unseen.put(a, Ds.unseen(seen, rest), b), seen)) == True{} : Bool}:
  match b:
    case True{}:
      +u = Ds.unseen(seen, rest)
      pv.and_tt(Ds.mem(a, List.append(&2, Nat, u, seen)), Ds.subset(rest, List.append(&2, Nat, u, seen)), pv.mem_app(a, u, seen, e), ih)
    case False{}:
      +y = List.append(&2, Nat, Ds.unseen(seen, rest), seen)
      pv.and_tt(Ds.mem(a, a <> y), Ds.subset(rest, a <> y), pv.mem_head(a, y), pv.sub_cons(rest, a, y, ih))

def pv.cover(+seen: List<&2, Nat>, anchors: List<&2, Nat>) -> {Ds.subset(anchors, List.append(&2, Nat, Ds.unseen(seen, anchors), seen)) == True{} : Bool}:
  match anchors:
    case Nil{}:
      {==}
    case +a <> +rest:
      pv.cover.go(seen, a, rest, Ds.mem(a, seen), {==}, pv.cover(seen, rest))

def pv.short.go(+a: Nat, u: List<&2, Nat>, +k: Nat, b: Bool, ih: {Nat.is_le(List.length(&2, Nat, u), k) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Nat, Ds.unseen.put(a, u, b)), 1n+k) == True{} : Bool}:
  match b:
    case True{}:
      pv.le_succ(List.length(&2, Nat, u), k, ih)
    case False{}:
      ih

# a rejection has no more unseen anchors than anchors
def pv.short(+seen: List<&2, Nat>, anchors: List<&2, Nat>, n: Nat, h: {Nat.is_le(List.length(&2, Nat, anchors), n) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Nat, Ds.unseen(seen, anchors)), n) == True{} : Bool}:
  match anchors n:
    case Nil{} 0n:
      {==}
    case Nil{} 1n+k:
      {==}
    case +a <> rest 0n:
      documents.pv.absurd({Nat.is_le(List.length(&2, Nat, Ds.unseen(seen, a <> rest)), 0n) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case +a <> +rest 1n+(+k):
      pv.short.go(a, Ds.unseen(seen, rest), k, Ds.mem(a, seen), pv.short(seen, rest, k, h))

def pv.retry.go(+seen: List<&2, Nat>, +anchors: List<&2, Nat>, u: List<&2, Nat>, eu: {Ds.unseen(seen, anchors) == u : List<&2, Nat>}, few: {Nat.is_le(List.length(&2, Nat, u), Ds.cap) == True{} : Bool}, cover: {Ds.subset(anchors, List.append(&2, Nat, u, seen)) == True{} : Bool}) -> {Ds.Step.applied(Ds.edit(Ds.Step.seen(Ds.edit.go(seen, u)), anchors)) == True{} : Bool}:
  match u:
    case Nil{}:
      %Equal.sym(List<&2, Nat>, Ds.unseen(seen, anchors), Nil{}, eu) : {Ds.Step.applied(Ds.edit.go(seen, _)) == True{} : Bool}
      {==}
    case +x <> +rest:
      %Equal.sym(Bool, Nat.is_le(List.length(&2, Nat, x <> rest), Ds.cap), True{}, few) : {Ds.Step.applied(Ds.edit(Ds.reveal(x <> rest, seen, _), anchors)) == True{} : Bool}
      pv.edit_seen_applies(List.append(&2, Nat, x <> rest, seen), anchors, cover)

def pv.reveal_then_retry(+seen: List<&2, Nat>, +anchors: List<&2, Nat>, few: {Nat.is_le(List.length(&2, Nat, anchors), Ds.cap) == True{} : Bool}) -> {Ds.Step.applied(Ds.edit(Ds.Step.seen(Ds.edit(seen, anchors)), anchors)) == True{} : Bool}:
  pv.retry.go(seen, anchors, Ds.unseen(seen, anchors), {==}, pv.short(seen, anchors, Ds.cap, few), pv.cover(seen, anchors))

# ==== search ====
# proof_doc_search: the grep and continuation laws of LAWS.bend section documents
# (F6, F7): grep puts every walked entry in exactly one class, has a
# notice of each class it left out exactly when that class is not empty,
# and a notice for each shown file it cut; a continuation gives a page
# that is not empty, follows on from the page before it with nothing left
# out and nothing twice, and has no item in common with it.
# Logic and numbers
# -----------------

def documents.ps.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def documents.ps.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : documents.ps.BD(_, Unit, A)
  Unit{}

def documents.ps.MD(m: Maybe<&2, Nat>, t: Type) -> Type:
  match m:
    case None{}:
      Unit
    case Some{v}:
      t

def documents.ps.none_some(-A: Type, -c: Nat, e: {None{} == Some{c} : Maybe<&2, Nat>}) -> A:
  %e : documents.ps.MD(_, A)
  Unit{}

def ps.some_inj(-a: Nat, -b: Nat, e: {Some{a} == Some{b} : Maybe<&2, Nat>}) -> {a == b : Nat}:
  Equal.cong(Maybe<&2, Nat>, Nat, m => Maybe.default(&2, Nat, m, 0n), Some{a}, Some{b}, e)

def documents.ps.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      documents.ps.absurd({0n == 1n+q : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 0n:
      documents.ps.absurd({1n+p == 0n : Nat}, Equal.sym(Bool, False{}, True{}, h))
    case 1n+p 1n+q:
      %documents.ps.eq_true(p, q, h) : {1n+p == 1n+_ : Nat}
      {==}

def documents.ps.eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      documents.ps.eq_refl(p)

def documents.ps.and_r(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      documents.ps.absurd({b == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))

def documents.ps.and_l(a: Bool, -b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      documents.ps.absurd({False{} == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))

def documents.ps.not_t(a: Bool, h: {Bool.not(a) == True{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      documents.ps.absurd({True{} == False{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case False{}:
      {==}

def ps.or_fr(a: Bool, -b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      documents.ps.absurd({b == False{} : Bool}, h)
    case False{}:
      h

def documents.ps.and_f(a: Bool) -> {Bool.and(a, False{}) == False{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def documents.ps.or_assoc(a: Bool, +b: Bool, +c: Bool) -> {Bool.or(Bool.or(a, b), c) == Bool.or(a, Bool.or(b, c)) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def ps.add_sr(a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %ps.add_sr(p, b) : {1n+Nat.add(p, 1n+b) == 1n+_ : Nat}
      {==}

# Pages
# -----

def ps.take_drop(xs: List<&2, Nat>, k: Nat) -> {List.append(&2, Nat, List.take(&2, Nat, xs, k), List.drop(&2, Nat, xs, k)) == xs : List<&2, Nat>}:
  match xs k:
    case Nil{} k:
      {==}
    case h <> t 0n:
      {==}
    case +h <> t 1n+p:
      %ps.take_drop(t, p) : {h <> List.append(&2, Nat, List.take(&2, Nat, t, p), List.drop(&2, Nat, t, p)) == h <> _ : List<&2, Nat>}
      {==}

def ps.drop_drop(xs: List<&2, Nat>, s: Nat, +k: Nat) -> {List.drop(&2, Nat, List.drop(&2, Nat, xs, s), k) == List.drop(&2, Nat, xs, Nat.add(s, k)) : List<&2, Nat>}:
  match xs s:
    case Nil{} s:
      match k:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case h <> t 0n:
      {==}
    case h <> t 1n+p:
      ps.drop_drop(t, p, k)

def ps.put_c(after: List<&2, Nat>, -c0: Nat, -c: Nat, h: {Sr.next.put(after, c0) == Some{c} : Maybe<&2, Nat>}) -> {c0 == c : Nat}:
  match after:
    case Nil{}:
      documents.ps.none_some({c0 == c : Nat}, c, h)
    case x <> t:
      ps.some_inj(c0, c, h)

# the continuation is S + K
def ps.next_c(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +c: Nat, h: {Sr.next(ps, s, k) == Some{c} : Maybe<&2, Nat>}) -> {Nat.add(s, k) == c : Nat}:
  match k:
    case 0n:
      documents.ps.none_some({Nat.add(s, 0n) == c : Nat}, c, h)
    case 1n+j:
      ps.put_c(List.drop(&2, Nat, ps, Nat.add(s, 1n+j)), Nat.add(s, 1n+j), c, h)

# the page of a continuation is not empty
def ps.prog_go(+ps: List<&2, Nat>, -c0: Nat, +j: Nat, after: List<&2, Nat>, e: {List.drop(&2, Nat, ps, c0) == after : List<&2, Nat>}, -c: Nat, h: {Sr.next.put(after, c0) == Some{c} : Maybe<&2, Nat>}) -> {List.is_empty(&2, Nat, Sr.page(ps, c, 1n+j)) == False{} : Bool}:
  match after:
    case Nil{}:
      documents.ps.none_some({List.is_empty(&2, Nat, Sr.page(ps, c, 1n+j)) == False{} : Bool}, c, h)
    case x <> t:
      %ps.some_inj(c0, c, h) : {List.is_empty(&2, Nat, Sr.page(ps, _, 1n+j)) == False{} : Bool}
      %Equal.sym(List<&2, Nat>, List.drop(&2, Nat, ps, c0), x <> t, e) : {List.is_empty(&2, Nat, List.take(&2, Nat, _, 1n+j)) == False{} : Bool}
      {==}

# the law continuation_progresses
def ps.progresses(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +c: Nat, h: {Sr.next(ps, s, k) == Some{c} : Maybe<&2, Nat>}) -> {List.is_empty(&2, Nat, Sr.page(ps, c, k)) == False{} : Bool}:
  match k:
    case 0n:
      documents.ps.none_some({List.is_empty(&2, Nat, Sr.page(ps, c, 0n)) == False{} : Bool}, c, h)
    case 1n+j:
      ps.prog_go(ps, Nat.add(s, 1n+j), j, List.drop(&2, Nat, ps, Nat.add(s, 1n+j)), {==}, c, h)

# the page at S + K and what follows it are the list after S
def ps.contig(+ps: List<&2, Nat>, +s: Nat, +k: Nat) -> {List.append(&2, Nat, Sr.page(ps, s, k), List.append(&2, Nat, Sr.page(ps, Nat.add(s, k), k), List.drop(&2, Nat, List.drop(&2, Nat, ps, Nat.add(s, k)), k))) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}:
  +d = List.drop(&2, Nat, ps, Nat.add(s, k))
  %Equal.sym(List<&2, Nat>, List.append(&2, Nat, List.take(&2, Nat, d, k), List.drop(&2, Nat, d, k)), d, ps.take_drop(d, k)) : {List.append(&2, Nat, Sr.page(ps, s, k), _) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}
  %ps.drop_drop(ps, s, k) : {List.append(&2, Nat, Sr.page(ps, s, k), _) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}
  ps.take_drop(List.drop(&2, Nat, ps, s), k)

def ps.contig_at(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +c: Nat, e: {Nat.add(s, k) == c : Nat}) -> {List.append(&2, Nat, Sr.page(ps, s, k), List.append(&2, Nat, Sr.page(ps, c, k), List.drop(&2, Nat, List.drop(&2, Nat, ps, c), k))) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}:
  %e : {List.append(&2, Nat, Sr.page(ps, s, k), List.append(&2, Nat, Sr.page(ps, _, k), List.drop(&2, Nat, List.drop(&2, Nat, ps, _), k))) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}
  ps.contig(ps, s, k)

# the law continuation_contiguous
def ps.contiguous(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +c: Nat, h: {Sr.next(ps, s, k) == Some{c} : Maybe<&2, Nat>}) -> &rest: List<&2, Nat> -> {List.append(&2, Nat, Sr.page(ps, s, k), List.append(&2, Nat, Sr.page(ps, c, k), rest)) == List.drop(&2, Nat, ps, s) : List<&2, Nat>}:
  (List.drop(&2, Nat, List.drop(&2, Nat, ps, c), k), ps.contig_at(ps, s, k, c, ps.next_c(ps, s, k, c, h)))

def ps.or_mono(a: Bool, -x: Bool, -y: Bool, h: {Bool.or(a, x) == True{} : Bool}, f: {x == True{} : Bool} -> {y == True{} : Bool}) -> {Bool.or(a, y) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      f(h)

def ps.mem_app(+n: Nat, a: List<&2, Nat>, +b: List<&2, Nat>) -> {Bool.or(Sr.mem(n, a), Sr.mem(n, b)) == Sr.mem(n, List.append(&2, Nat, a, b)) : Bool}:
  match a:
    case Nil{}:
      {==}
    case +x <> +rest:
      %ps.mem_app(n, rest, b) : {Bool.or(Bool.or(Nat.is_eq(x, n), Sr.mem(n, rest)), Sr.mem(n, b)) == Bool.or(Nat.is_eq(x, n), _) : Bool}
      documents.ps.or_assoc(Nat.is_eq(x, n), Sr.mem(n, rest), Sr.mem(n, b))

def ps.mem_app_l(+n: Nat, a: List<&2, Nat>, +b: List<&2, Nat>, h: {Sr.mem(n, a) == True{} : Bool}) -> {Sr.mem(n, List.append(&2, Nat, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      documents.ps.absurd({Sr.mem(n, b) == True{} : Bool}, Equal.sym(Bool, False{}, True{}, h))
    case +x <> +rest:
      ps.or_mono(Nat.is_eq(x, n), Sr.mem(n, rest), Sr.mem(n, List.append(&2, Nat, rest, b)), h, hh => ps.mem_app_l(n, rest, b, hh))

def ps.nodup_drop(xs: List<&2, Nat>, s: Nat, nd: {Sr.nodup(xs) == True{} : Bool}) -> {Sr.nodup(List.drop(&2, Nat, xs, s)) == True{} : Bool}:
  match xs s:
    case Nil{} s:
      {==}
    case h <> t 0n:
      nd
    case +h <> +t 1n+p:
      ps.nodup_drop(t, p, documents.ps.and_r(Bool.not(Sr.mem(h, t)), Sr.nodup(t), nd))

def ps.nd_hit(-y: Nat, +x: Nat, e: {y == x : Nat}, +t: List<&2, Nat>, +b: List<&2, Nat>, ny: {Sr.mem(y, List.append(&2, Nat, t, b)) == False{} : Bool}) -> {Bool.or(Sr.mem(x, t), Sr.mem(x, b)) == False{} : Bool}:
  %Equal.sym(Bool, Bool.or(Sr.mem(x, t), Sr.mem(x, b)), Sr.mem(x, List.append(&2, Nat, t, b)), ps.mem_app(x, t, b)) : {_ == False{} : Bool}
  %e : {Sr.mem(_, List.append(&2, Nat, t, b)) == False{} : Bool}
  ny

def ps.nd_step(+y: Nat, +x: Nat, q: Bool, eq: {Nat.is_eq(y, x) == q : Bool}, +t: List<&2, Nat>, +b: List<&2, Nat>, ny: {Sr.mem(y, List.append(&2, Nat, t, b)) == False{} : Bool}, ih: {Bool.and(Sr.mem(x, t), Sr.mem(x, b)) == False{} : Bool}) -> {Bool.and(Bool.or(q, Sr.mem(x, t)), Sr.mem(x, b)) == False{} : Bool}:
  match q:
    case True{}:
      ps.or_fr(Sr.mem(x, t), Sr.mem(x, b), ps.nd_hit(y, x, documents.ps.eq_true(y, x, eq), t, b, ny))
    case False{}:
      ih

def ps.nd_app(a: List<&2, Nat>, +b: List<&2, Nat>, +x: Nat, +nd: {Sr.nodup(List.append(&2, Nat, a, b)) == True{} : Bool}) -> {Bool.and(Sr.mem(x, a), Sr.mem(x, b)) == False{} : Bool}:
  match a:
    case Nil{}:
      {==}
    case +y <> +t:
      +ab = List.append(&2, Nat, t, b)
      +ny = documents.ps.not_t(Sr.mem(y, ab), documents.ps.and_l(Bool.not(Sr.mem(y, ab)), Sr.nodup(ab), nd))
      ps.nd_step(y, x, Nat.is_eq(y, x), {==}, t, b, ny, ps.nd_app(t, b, x, documents.ps.and_r(Bool.not(Sr.mem(y, ab)), Sr.nodup(ab), nd)))

def ps.and_imp(a: Bool, b: Bool, -c: Bool, h: {Bool.and(a, c) == False{} : Bool}, f: {b == True{} : Bool} -> {c == True{} : Bool}) -> {Bool.and(a, b) == False{} : Bool}:
  match a b:
    case False{} False{}:
      {==}
    case False{} True{}:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      documents.ps.absurd({True{} == False{} : Bool}, Equal.trans(Bool, True{}, c, False{}, Equal.sym(Bool, c, True{}, f({==})), h))

def ps.disj_at(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +x: Nat, nd: {Sr.nodup(ps) == True{} : Bool}) -> {Bool.and(Sr.mem(x, Sr.page(ps, s, k)), Sr.mem(x, Sr.page(ps, Nat.add(s, k), k))) == False{} : Bool}:
  +p1 = Sr.page(ps, s, k)
  +p2 = Sr.page(ps, Nat.add(s, k), k)
  +r = List.drop(&2, Nat, List.drop(&2, Nat, ps, Nat.add(s, k)), k)
  +all = List.append(&2, Nat, p1, List.append(&2, Nat, p2, r))
  +whole = Equal.trans(Bool, Sr.nodup(all), Sr.nodup(List.drop(&2, Nat, ps, s)), True{}, Equal.cong(List<&2, Nat>, Bool, l => Sr.nodup(l), all, List.drop(&2, Nat, ps, s), ps.contig(ps, s, k)), ps.nodup_drop(ps, s, nd))
  ps.and_imp(Sr.mem(x, p1), Sr.mem(x, p2), Sr.mem(x, List.append(&2, Nat, p2, r)), ps.nd_app(p1, List.append(&2, Nat, p2, r), x, whole), hh => ps.mem_app_l(x, p2, r, hh))

# the law continuation_disjoint
def ps.disjoint(+ps: List<&2, Nat>, +s: Nat, +k: Nat, +c: Nat, +x: Nat, h: {Sr.next(ps, s, k) == Some{c} : Maybe<&2, Nat>}, nd: {Sr.nodup(ps) == True{} : Bool}) -> {Bool.and(Sr.mem(x, Sr.page(ps, s, k)), Sr.mem(x, Sr.page(ps, c, k))) == False{} : Bool}:
  %ps.next_c(ps, s, k, c, h) : {Bool.and(Sr.mem(x, Sr.page(ps, s, k)), Sr.mem(x, Sr.page(ps, _, k))) == False{} : Bool}
  ps.disj_at(ps, s, k, x, nd)

# Grep: every entry in one class
# ------------------------------

def ps.sum_mid(pre: List<&2, Nat>, +x: Nat, +post: List<&2, Nat>) -> {Sr.sum(List.append(&2, Nat, pre, (1n+x) <> post)) == 1n+Sr.sum(List.append(&2, Nat, pre, x <> post)) : Nat}:
  match pre:
    case Nil{}:
      {==}
    case +y <> +t:
      +a = Sr.sum(List.append(&2, Nat, t, (1n+x) <> post))
      +b = Sr.sum(List.append(&2, Nat, t, x <> post))
      Equal.trans(Nat, Nat.add(y, a), Nat.add(y, 1n+b), 1n+Nat.add(y, b), Equal.cong(Nat, Nat, z => Nat.add(y, z), a, 1n+b, ps.sum_mid(t, x, post)), ps.add_sr(y, b))

def ps.total_part(pa: Bool, c: Sr.Count) -> {Sr.Count.total(Sr.Count.part(pa, c)) == Sr.Count.total(c) : Nat}:
  match pa:
    case True{}:
      match c:
        case Sr.Count{a, b, d, e, f, g, h, i, j, q}:
          {==}
    case False{}:
      {==}

# one more entry in a class is one more in all
def ps.total_add(c: Sr.Count, x: Sr.Class) -> {Sr.Count.total(Sr.Count.add(c, x)) == 1n+Sr.Count.total(c) : Nat}:
  match c:
    case Sr.Count{+a, +b, +d, +e, +f, +g, +h, +i, +j, q}:
      match x:
        case Sr.NoMatch{}:
          ps.sum_mid([], a, [b, d, e, f, g, h, i, j])
        case Sr.Shown{}:
          ps.sum_mid([a], b, [d, e, f, g, h, i, j])
        case Sr.PagedOut{}:
          ps.sum_mid([a, b], d, [e, f, g, h, i, j])
        case Sr.Unsearched{}:
          ps.sum_mid([a, b, d], e, [f, g, h, i, j])
        case Sr.Skipped{w}:
          match w:
            case Sr.Binary{}:
              ps.sum_mid([a, b, d, e], f, [g, h, i, j])
            case Sr.Unreadable{}:
              ps.sum_mid([a, b, d, e, f], g, [h, i, j])
            case Sr.Excluded{}:
              ps.sum_mid([a, b, d, e, f, g], h, [i, j])
            case Sr.Link{}:
              ps.sum_mid([a, b, d, e, f, g, h], i, [j])
            case Sr.Broken{}:
              ps.sum_mid([a, b, d, e, f, g, h, i], j, [])

def ps.total_account(os: List<&2, Sr.Out>) -> {Sr.Count.total(Sr.account(os)) == List.length(&2, Sr.Out, os) : Nat}:
  match os:
    case Nil{}:
      {==}
    case o <> +rest:
      match o:
        case Sr.Out{i, +c, t, +pa}:
          +acc = Sr.account(rest)
          +grown = Sr.Count.add(acc, c)
          Equal.trans(Nat, Sr.Count.total(Sr.Count.part(pa, grown)), Sr.Count.total(grown), 1n+List.length(&2, Sr.Out, rest), ps.total_part(pa, grown), Equal.trans(Nat, Sr.Count.total(grown), 1n+Sr.Count.total(acc), 1n+List.length(&2, Sr.Out, rest), ps.total_add(acc, c), Equal.cong(Nat, Nat, z => 1n+z, Sr.Count.total(acc), List.length(&2, Sr.Out, rest), ps.total_account(rest))))

def ps.len_run(es: List<&2, Sr.Ent>, +p: Nat, +s: Nat, +k: Nat, +rem: Nat, +n: Nat) -> {List.length(&2, Sr.Out, Sr.run(es, p, s, k, rem, n)) == List.length(&2, Sr.Ent, es) : Nat}:
  match es:
    case Nil{}:
      {==}
    case +e <> rest:
      %ps.len_run(rest, p, s, k, Sr.left(e, p, rem), Sr.seen(e, rem, n)) : {1n+List.length(&2, Sr.Out, Sr.run(rest, p, s, k, Sr.left(e, p, rem), Sr.seen(e, rem, n))) == 1n+_ : Nat}
      {==}

# the law grep_accounts_every_file
def ps.accounts_every_file(+es: List<&2, Sr.Ent>, +p: Nat, +s: Nat, +k: Nat, +rem: Nat, +n: Nat) -> {Sr.Count.total(Sr.account(Sr.run(es, p, s, k, rem, n))) == List.length(&2, Sr.Ent, es) : Nat}:
  +os = Sr.run(es, p, s, k, rem, n)
  Equal.trans(Nat, Sr.Count.total(Sr.account(os)), List.length(&2, Sr.Out, os), List.length(&2, Sr.Ent, es), ps.total_account(os), ps.len_run(es, p, s, k, rem, n))

# Grep: a notice for each class left out
# --------------------------------------

def ps.bump(b: Bool, x: Nat) -> Nat:
  match b:
    case True{}:
      1n+x
    case False{}:
      x

# the count of a notice after one more entry: one more when the notice
# reports the entry
def ps.count_step(c: Sr.Count, pa: Bool, x: Sr.Class, n: Sr.Note) -> {Sr.Note.count(Sr.Count.part(pa, Sr.Count.add(c, x)), n) == ps.bump(Sr.Note.cls(n, x, pa), Sr.Note.count(c, n)) : Nat}:
  match c:
    case Sr.Count{a, b, d, e, f, g, h, i, j, q}:
      match pa:
        case True{}:
          match x:
            case Sr.NoMatch{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Shown{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.PagedOut{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Unsearched{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Skipped{v}:
              match v:
                case Sr.Binary{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Unreadable{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Excluded{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Link{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Broken{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
        case False{}:
          match x:
            case Sr.NoMatch{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Shown{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.PagedOut{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Unsearched{}:
              match n:
                case Sr.NSkip{w}:
                  match w:
                    case Sr.Binary{}:
                      {==}
                    case Sr.Unreadable{}:
                      {==}
                    case Sr.Excluded{}:
                      {==}
                    case Sr.Link{}:
                      {==}
                    case Sr.Broken{}:
                      {==}
                case Sr.NPartial{}:
                  {==}
                case Sr.NUnsearched{}:
                  {==}
            case Sr.Skipped{v}:
              match v:
                case Sr.Binary{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Unreadable{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Excluded{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
                        case Sr.Broken{}:
                          {==}
                    case Sr.NPartial{}:
                      {==}
                    case Sr.NUnsearched{}:
                      {==}
                case Sr.Link{}:
                  match n:
                    case Sr.NSkip{w}:
                      match w:
                        case Sr.Binary{}:
                          {==}
                        case Sr.Unreadable{}:
                          {==}
                        case Sr.Excluded{}:
                          {==}
                        case Sr.Link{}:
                          {==}
