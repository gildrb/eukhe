    case GT{}:
      +gn = pt.get_below(h1 <> r1, Tr.Ent.k(h2), pt.cmp_gt(Tr.Ent.k(h1), Tr.Ent.k(h2), ec), s1)
      tree.pt.none_some({Tr.Ent.k(h1) == Tr.Ent.k(h2) : Nat}, h2, Equal.trans(Maybe<&2, Tr.Ent>, None{}, Tr.get(h1 <> r1, Tr.Ent.k(h2)), Some{h2}, Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(h1 <> r1, Tr.Ent.k(h2)), None{}, gn), Equal.trans(Maybe<&2, Tr.Ent>, Tr.get(h1 <> r1, Tr.Ent.k(h2)), Tr.get(h2 <> r2, Tr.Ent.k(h2)), Some{h2}, e2, pt.get_head(h2, r2))))

# two sorted lists that agree on their keys are equal
def pt.ext(l1: List<&2, Tr.Ent>, l2: List<&2, Tr.Ent>, +s1: {Tr.sorted(l1) == True{} : Bool}, +s2: {Tr.sorted(l2) == True{} : Bool}, A1: pt.Agree(l1, l1, l2), A2: pt.Agree(l2, l1, l2)) -> {l1 == l2 : List<&2, Tr.Ent>}:
  match l1 l2:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{+h2, +r2}:
      (e2, t2) = A2
      tree.pt.none_some({Nil{} == h2 <> r2 : List<&2, Tr.Ent>}, h2, Equal.trans(Maybe<&2, Tr.Ent>, None{}, Tr.get(h2 <> r2, Tr.Ent.k(h2)), Some{h2}, e2, pt.get_head(h2, r2)))
    case Con{+h1, +r1} Nil{}:
      (e1, t1) = A1
      pt.some_none({h1 <> r1 == Nil{} : List<&2, Tr.Ent>}, h1, Equal.trans(Maybe<&2, Tr.Ent>, Some{h1}, Tr.get(h1 <> r1, Tr.Ent.k(h1)), None{}, Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(h1 <> r1, Tr.Ent.k(h1)), Some{h1}, pt.get_head(h1, r1)), e1))
    case Con{+h1, +r1} Con{+h2, +r2}:
      (+e1, t1) = A1
      (+e2, t2) = A2
      +keq = pt.ext_head(h1, r1, h2, r2, Nat.cmp(Tr.Ent.k(h1), Tr.Ent.k(h2)), {==}, e1, e2, s1, s2)
      +s1t = tree.pt.and_r(Tr.above(Tr.Ent.k(h1), r1), Tr.sorted(r1), s1)
      +s2t = tree.pt.and_r(Tr.above(Tr.Ent.k(h2), r2), Tr.sorted(r2), s2)
      +al1 = tree.pt.and_l(Tr.above(Tr.Ent.k(h1), r1), Tr.sorted(r1), s1)
      +al2 = Equal.trans(Bool, Tr.above(Tr.Ent.k(h1), r2), Tr.above(Tr.Ent.k(h2), r2), True{}, Equal.cong(Nat, Bool, n => Tr.above(n, r2), Tr.Ent.k(h1), Tr.Ent.k(h2), keq), tree.pt.and_l(Tr.above(Tr.Ent.k(h2), r2), Tr.sorted(r2), s2))
      +ih = pt.ext(r1, r2, s1t, s2t, pt.agree_strip(r1, h1, r1, h2, r2, t1, al1, s1t, keq), pt.agree_strip(r2, h1, r1, h2, r2, t2, al2, s2t, keq))
      +hs = Equal.trans(Maybe<&2, Tr.Ent>, Some{h1}, Tr.get(h1 <> r1, Tr.Ent.k(h1)), Some{h2}, Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(h1 <> r1, Tr.Ent.k(h1)), Some{h1}, pt.get_head(h1, r1)), Equal.trans(Maybe<&2, Tr.Ent>, Tr.get(h1 <> r1, Tr.Ent.k(h1)), Tr.get(h2 <> r2, Tr.Ent.k(h1)), Some{h2}, e1, pt.get_hit(h2, r2, Tr.Ent.k(h1), pt.eq_of(Tr.Ent.k(h1), Tr.Ent.k(h2), keq))))
      %tree.pt.some_inj(h1, h2, hs) : {h1 <> r1 == _ <> r2 : List<&2, Tr.Ent>}
      %ih : {h1 <> r1 == h1 <> _ : List<&2, Tr.Ent>}
      {==}

def rewind_reaches(+a: List<&2, Tr.Ent>, +b: List<&2, Tr.Ent>, ga: {Tr.sound(a) == True{} : Bool}, +gb: {Tr.sound(b) == True{} : Bool}) -> {Tr.apply(a, Tr.Rewind{Tr.diff(a, b)}) == b : List<&2, Tr.Ent>}:
  +n = Tr.patch(Tr.diff(a, b), a)
  +sb = tree.pt.and_l(Tr.sorted(b), Tr.rooted(b), gb)
  +sn = pt.sorted_patch(Tr.diff(a, b), a, tree.pt.and_l(Tr.sorted(a), Tr.rooted(a), ga))
  +eq = pt.ext(n, b, sn, sb, pt.agree_reach(n, a, b, sb), pt.agree_reach(b, a, b, sb))
  %Equal.sym(List<&2, Tr.Ent>, n, b, eq) : {Tr.keep.at(Tr.sound(_), a, _) == b : List<&2, Tr.Ent>}
  %Equal.sym(Bool, Tr.sound(b), True{}, gb) : {Tr.keep.at(_, a, b) == b : List<&2, Tr.Ent>}
  {==}

# Delete: only below
# ------------------
# While prune walks the tree, every key in gone is x or below the rest
# of the walk, is not 0 (x is not the root; a node's key is above its
# parent's), and is not a key of the kept nodes; and every kept key is
# below the rest of the walk.

# f holds for every key of gone
def pt.All(gone: List<&2, Nat>, -f: Nat -> Bool) -> Data:
  match gone:
    case Nil{}:
      Unit
    case +g <> rest:
      Sigma<&2, &2, {f(g) == True{} : Bool}, _ => pt.All(rest, f)>

def pt.ah_go(+g: Nat, +gs: List<&2, Nat>, -f: Nat -> Bool, +y: Nat, c: Bool, ec: {Nat.is_eq(g, y) == c : Bool}, hd: {f(g) == True{} : Bool}, ih: {Tr.elem(gs, y) == True{} : Bool} -> {f(y) == True{} : Bool}, el: {Tr.elem(g <> gs, y) == True{} : Bool}) -> {f(y) == True{} : Bool}:
  match c:
    case True{}:
      %pt.eq_true(g, y, ec) : {f(_) == True{} : Bool}
      hd
    case False{}:
      ih(Equal.trans(Bool, Tr.elem(gs, y), Bool.or(Nat.is_eq(g, y), Tr.elem(gs, y)), True{}, Equal.cong(Bool, Bool, w => Bool.or(w, Tr.elem(gs, y)), False{}, Nat.is_eq(g, y), Equal.sym(Bool, Nat.is_eq(g, y), False{}, ec)), el))

def pt.all_hit(gone: List<&2, Nat>, -f: Nat -> Bool, +y: Nat, a: pt.All(gone, f)) -> {Tr.elem(gone, y) == True{} : Bool} -> {f(y) == True{} : Bool}:
  match gone:
    case Nil{}:
      el => tree.pt.absurdF({f(y) == True{} : Bool}, el)
    case +g <> +gs:
      (hd, tl) = a
      ih = pt.all_hit(gs, f, y, tl)
      el => pt.ah_go(g, gs, f, y, Nat.is_eq(g, y), {==}, hd, ih, el)

def pt.or_above_tail(c: Bool, +g: Nat, +e: Tr.Ent, +r: List<&2, Tr.Ent>, h: {Bool.or(c, Tr.above(g, e <> r)) == True{} : Bool}, +st: {Tr.sorted(e <> r) == True{} : Bool}) -> {Bool.or(c, Tr.above(g, r)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      pt.above_tail(g, e, r, h, st)

def pt.gl_tail(gone: List<&2, Nat>, +x: Nat, +e: Tr.Ent, +r: List<&2, Tr.Ent>, a: pt.All(gone, z => Bool.or(Nat.is_eq(z, x), Tr.above(z, e <> r))), +st: {Tr.sorted(e <> r) == True{} : Bool}) -> pt.All(gone, z => Bool.or(Nat.is_eq(z, x), Tr.above(z, r))):
  match gone:
    case Nil{}:
      Unit{}
    case +g <> +gs:
      (hd, tl) = a
      (pt.or_above_tail(Nat.is_eq(g, x), g, e, r, hd, st), pt.gl_tail(gs, x, e, r, tl, st))

def pt.not_f(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      tree.pt.absurdF({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pt.not_t(+b: Bool, h: {b == False{} : Bool}) -> {Bool.not(b) == True{} : Bool}:
  %Equal.sym(Bool, b, False{}, h) : {Bool.not(_) == True{} : Bool}
  {==}

def pt.not_has_app(+B: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +y: Nat, nb: {Tr.has(B, y) == False{} : Bool}, nc: {Tr.has(C, y) == False{} : Bool}) -> {Bool.not(Tr.has(List.append(&2, Tr.Ent, B, C), y)) == True{} : Bool}:
  %Equal.sym(Bool, Tr.has(List.append(&2, Tr.Ent, B, C), y), Bool.or(Tr.has(B, y), Tr.has(C, y)), pt.has_app(B, C, y)) : {Bool.not(_) == True{} : Bool}
  %Equal.sym(Bool, Tr.has(B, y), False{}, nb) : {Bool.not(Bool.or(_, Tr.has(C, y))) == True{} : Bool}
  %Equal.sym(Bool, Tr.has(C, y), False{}, nc) : {Bool.not(Bool.or(False{}, _)) == True{} : Bool}
  {==}

def pt.ng_snoc(gone: List<&2, Nat>, +B: List<&2, Tr.Ent>, +e: Tr.Ent, a: pt.All(gone, z => Bool.not(Tr.has(B, z))), +ne: {Tr.elem(gone, Tr.Ent.k(e)) == False{} : Bool}) -> pt.All(gone, z => Bool.not(Tr.has(List.append(&2, Tr.Ent, B, [e]), z))):
  match gone:
    case Nil{}:
      Unit{}
    case +g <> +gs:
      (hd, tl) = a
      +ng = pt.or_l(Nat.is_eq(g, Tr.Ent.k(e)), Tr.elem(gs, Tr.Ent.k(e)), ne)
      +nc = pt.has_miss(e, Nil{}, g, pt.ne_comm(g, Tr.Ent.k(e), ng))
