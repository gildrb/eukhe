# PROOF: one proof per law of LAWS.bend, as Laws.<law>, and every lemma
# behind them, one section per area (`# ---- <area> ----`). The proofs of
# the chat memory laws use the sections cover (coverage, messages,
# merges), fit (batches, summarized lines, compaction views), push
# (Taelin's push up to 20,000 and the T = 10 example, by computation) and
# agree (Taelin's push at every step, by induction); the last section,
# laws, fills the laws the area sections do not fill themselves.
#
#   bend PROOF.bend             checks every proof
#   bend PROOF.bend --verdict   checks them again with the proven kernel

import Base
import ./LAWS.bend as Laws
import ./bend/optchat.bend as O
