# agree is agree.go from the empty state
def push.unfold(-n: Nat) -> {O.agree(O.Last{}, n) == O.agree.go(n, O.Last{}, Nil{}, Nil{}, Nil{}) : Bool}:
  {==}

# chunk ok from S to S' and agree.go(r) from S' make agree.go(n) from S,
# for n = c + r as literals: each {==} on the sum unfolds c steps of
# Nat.add and meets r, never a chain of nested sums (the checker compares
# a Succ chain against a literal one frame per Succ)
def push.step(c: Nat, -r: Nat, -n: Nat, eq: {Nat.add(c, r) == n : Nat}, +m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>, -tb2: List<&2, Bool>, -es2: List<&2, O.Entry>, -v2: List<&2, O.Node>,
  ch: {push.sim(c, True{}, m, tb, es, v) == PushSt{True{}, tb2, es2, v2} : PushSt}, nx: {O.agree.go(r, m, tb2, es2, v2) == True{} : Bool})
  -> {O.agree.go(n, m, tb, es, v) == True{} : Bool}:
  %eq : {O.agree.go(_, m, tb, es, v) == True{} : Bool}
  push.link(c, r, m, tb, es, v, tb2, es2, v2, ch, nx)

# 20001 = 20·1000 + 1: twenty chunks, then the last step
def push.go() -> {O.agree.go(20001n, O.Last{}, Nil{}, Nil{}, Nil{}) == True{} : Bool}:
  push.step(1000n, 19001n, 20001n, {==}, O.Last{}, Nil{}, Nil{}, Nil{}, push.tb1(), push.es1(), push.v1(), push.chunk0(), push.step(1000n, 18001n, 19001n, {==}, O.Last{}, push.tb1(), push.es1(), push.v1(), push.tb2(), push.es2(), push.v2(), push.chunk1(), push.step(1000n, 17001n, 18001n, {==}, O.Last{}, push.tb2(), push.es2(), push.v2(), push.tb3(), push.es3(), push.v3(), push.chunk2(), push.step(1000n, 16001n, 17001n, {==}, O.Last{}, push.tb3(), push.es3(), push.v3(), push.tb4(), push.es4(), push.v4(), push.chunk3(), push.step(1000n, 15001n, 16001n, {==}, O.Last{}, push.tb4(), push.es4(), push.v4(), push.tb5(), push.es5(), push.v5(), push.chunk4(), push.step(1000n, 14001n, 15001n, {==}, O.Last{}, push.tb5(), push.es5(), push.v5(), push.tb6(), push.es6(), push.v6(), push.chunk5(), push.step(1000n, 13001n, 14001n, {==}, O.Last{}, push.tb6(), push.es6(), push.v6(), push.tb7(), push.es7(), push.v7(), push.chunk6(), push.step(1000n, 12001n, 13001n, {==}, O.Last{}, push.tb7(), push.es7(), push.v7(), push.tb8(), push.es8(), push.v8(), push.chunk7(), push.step(1000n, 11001n, 12001n, {==}, O.Last{}, push.tb8(), push.es8(), push.v8(), push.tb9(), push.es9(), push.v9(), push.chunk8(), push.step(1000n, 10001n, 11001n, {==}, O.Last{}, push.tb9(), push.es9(), push.v9(), push.tb10(), push.es10(), push.v10(), push.chunk9(), push.step(1000n, 9001n, 10001n, {==}, O.Last{}, push.tb10(), push.es10(), push.v10(), push.tb11(), push.es11(), push.v11(), push.chunk10(), push.step(1000n, 8001n, 9001n, {==}, O.Last{}, push.tb11(), push.es11(), push.v11(), push.tb12(), push.es12(), push.v12(), push.chunk11(), push.step(1000n, 7001n, 8001n, {==}, O.Last{}, push.tb12(), push.es12(), push.v12(), push.tb13(), push.es13(), push.v13(), push.chunk12(), push.step(1000n, 6001n, 7001n, {==}, O.Last{}, push.tb13(), push.es13(), push.v13(), push.tb14(), push.es14(), push.v14(), push.chunk13(), push.step(1000n, 5001n, 6001n, {==}, O.Last{}, push.tb14(), push.es14(), push.v14(), push.tb15(), push.es15(), push.v15(), push.chunk14(), push.step(1000n, 4001n, 5001n, {==}, O.Last{}, push.tb15(), push.es15(), push.v15(), push.tb16(), push.es16(), push.v16(), push.chunk15(), push.step(1000n, 3001n, 4001n, {==}, O.Last{}, push.tb16(), push.es16(), push.v16(), push.tb17(), push.es17(), push.v17(), push.chunk16(), push.step(1000n, 2001n, 3001n, {==}, O.Last{}, push.tb17(), push.es17(), push.v17(), push.tb18(), push.es18(), push.v18(), push.chunk17(), push.step(1000n, 1001n, 2001n, {==}, O.Last{}, push.tb18(), push.es18(), push.v18(), push.tb19(), push.es19(), push.v19(), push.chunk18(), push.step(1000n, 1n, 1001n, {==}, O.Last{}, push.tb19(), push.es19(), push.v19(), push.tb20(), push.es20(), push.v20(), push.chunk19(), push.tail()))))))))))))))))))))

def push_agrees() -> {O.agree(O.Last{}, 20001n) == True{} : Bool}:
  Equal.trans(Bool, O.agree(O.Last{}, 20001n), O.agree.go(20001n, O.Last{}, Nil{}, Nil{}, Nil{}), True{}, push.unfold(20001n), push.go())

# ---- agree ----

# proof_agree: push_agrees_always, for every number of pushes. Under push
# alone, Taelin's list is a bijective binary counter: T messages are
# T = sum (1 + d_j)·2^j with digits d_j in {0, 1} (the keep bits, newest
# entry first), and entry j is one line of level j + d_j. pa.GE writes
# push's list and pa.GV the view (that list read oldest first) as
# functions of the digits.
#
# One step appends message T's line, and push adds 1 to the digits. If
# every digit is 1, the list grows and the fit merges nothing. Otherwise
# let j be the lowest 0 digit: push's carry merges the two level-j lines
# j and j-1 (line 0 and the new line when j = 0), and with push's length
# as the budget the fit makes exactly one merge. The due order picks that
# pair:
# - j > 0 (the lowest digit is 1): the view is the view of the higher
#   digits one level up (every line lifted, T + 2 doubled) plus the new
#   line, and the due order between lifted lines is the same (pa.md_lift),
#   so the fit is the lifted fit of the higher digits (pa.fit_lift);
# - j = 0: the pair (line 0, the new line) is due (T + 1 - T)/1 = 1; every
#   older line ends recently enough, in its own line size, to be due less
#   than 1 (pa.Good, pa.old_one), and no later pair can merge (their
#   levels differ).
#
# The arithmetic runs on Nat through Bits.val: the comparisons of the
# model's bit lists are those of their values (pa.cmp_val, pa.val_add).

# Nat
# ---

def pa.succ(-a: Nat, -b: Nat, e: {a == b : Nat}) -> {1n+a == 1n+b : Nat}:
  %e : {1n+a == 1n+_ : Nat}
  {==}

def pa.add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pa.succ(Nat.add(p, 0n), p, pa.add_zero(p))

def pa.add_succ(a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pa.succ(Nat.add(p, 1n+b), 1n+Nat.add(p, b), pa.add_succ(p, b))

def pa.add_comm(+a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  match a:
    case 0n:
      Equal.sym(Nat, Nat.add(b, 0n), b, pa.add_zero(b))
    case 1n+p:
      Equal.trans(Nat, 1n+Nat.add(p, b), 1n+Nat.add(b, p), Nat.add(b, 1n+p), pa.succ(Nat.add(p, b), Nat.add(b, p), pa.add_comm(p, b)), Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), pa.add_succ(b, p)))

def pa.add_assoc(a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pa.succ(Nat.add(Nat.add(p, b), c), Nat.add(p, Nat.add(b, c)), pa.add_assoc(p, b, c))

def pa.double_add(a: Nat, +b: Nat) -> {Nat.double(Nat.add(a, b)) == Nat.add(Nat.double(a), Nat.double(b)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pa.succ(1n+Nat.double(Nat.add(p, b)), 1n+Nat.add(Nat.double(p), Nat.double(b)), pa.succ(Nat.double(Nat.add(p, b)), Nat.add(Nat.double(p), Nat.double(b)), pa.double_add(p, b)))

# b + 1 + k is above b
def pa.gt_add(b: Nat, -k: Nat) -> {Nat.is_gt(Nat.add(b, 1n+k), b) == True{} : Bool}:
  match b:
    case 0n:
      {==}
    case 1n+p:
      pa.gt_add(p, k)

def pa.gt_succ(n: Nat) -> {Nat.is_gt(1n+n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pa.gt_succ(p)

def pa.gt_self(n: Nat) -> {Nat.is_gt(n, n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pa.gt_self(p)

def pa.cmp_self(n: Nat) -> {Nat.cmp(n, n) == EQ{} : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pa.cmp_self(p)

# x·2^l, doubling outside
def pa.sh(l: Nat, x: Nat) -> Nat:
  match l:
    case 0n:
      x
    case 1n+p:
      Nat.double(pa.sh(p, x))

def pa.sh_zero(l: Nat) -> {pa.sh(l, 0n) == 0n : Nat}:
  match l:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, pa.sh(p, 0n), 0n, pa.sh_zero(p)) : {Nat.double(_) == 0n : Nat}
      {==}

def pa.sh_add(+l: Nat, +a: Nat, +b: Nat) -> {pa.sh(l, Nat.add(a, b)) == Nat.add(pa.sh(l, a), pa.sh(l, b)) : Nat}:
  match l:
    case 0n:
      {==}
    case 1n+p:
      Equal.trans(Nat, Nat.double(pa.sh(p, Nat.add(a, b))), Nat.double(Nat.add(pa.sh(p, a), pa.sh(p, b))), Nat.add(Nat.double(pa.sh(p, a)), Nat.double(pa.sh(p, b))), Equal.cong(Nat, Nat, x => Nat.double(x), pa.sh(p, Nat.add(a, b)), Nat.add(pa.sh(p, a), pa.sh(p, b)), pa.sh_add(p, a, b)), pa.double_add(pa.sh(p, a), pa.sh(p, b)))

def pa.sh_double(+l: Nat, +x: Nat) -> {pa.sh(l, Nat.double(x)) == Nat.double(pa.sh(l, x)) : Nat}:
  match l:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, y => Nat.double(y), pa.sh(p, Nat.double(x)), Nat.double(pa.sh(p, x)), pa.sh_double(p, x))

# Bits and their values
# ---------------------

def pa.val_inc(x: List<&2, Bool>) -> {O.Bits.val(O.Bits.inc(x)) == 1n+O.Bits.val(x) : Nat}:
  match x:
    case Nil{}:
      {==}
    case h <> t:
      match h:
        case False{}:
          {==}
        case True{}:
          Equal.cong(Nat, Nat, z => Nat.double(z), O.Bits.val(O.Bits.inc(t)), 1n+O.Bits.val(t), pa.val_inc(t))

def pa.val_shl(l: Nat, +x: List<&2, Bool>) -> {O.Bits.val(O.Bits.shl(l, x)) == pa.sh(l, O.Bits.val(x)) : Nat}:
  match l:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, z => Nat.double(z), O.Bits.val(O.Bits.shl(p, x)), pa.sh(p, O.Bits.val(x)), pa.val_shl(p, x))

def pa.add_bits(x: Bool, y: Bool, +P: Nat, +Q: Nat) -> {Nat.add(O.bit(x, P), O.bit(y, Q)) == O.bit(x, O.bit(y, Nat.add(P, Q))) : Nat}:
  match x y:
    case False{} False{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      pa.add_succ(P, Q)
    case True{} True{}:
      pa.succ(Nat.add(P, 1n+Q), 1n+Nat.add(P, Q), pa.add_succ(P, Q))

# a full adder: the sum bit, then twice the carry
def pa.fa(x: Bool, y: Bool, c: Bool, -S: Nat) -> {O.bit(Bool.xor(Bool.xor(x, y), c), Nat.double(O.bit(Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))), S))) == O.bit(c, O.bit(x, O.bit(y, Nat.double(S)))) : Nat}:
  match x y c:
    case False{} False{} False{}:
      {==}
    case False{} False{} True{}:
      {==}
    case False{} True{} False{}:
      {==}
    case False{} True{} True{}:
      {==}
    case True{} False{} False{}:
      {==}
    case True{} False{} True{}:
      {==}
    case True{} True{} False{}:
      {==}
    case True{} True{} True{}:
      {==}

def pa.val_add.cons(+x: Bool, +y: Bool, +c: Bool, +A: Nat, +B: Nat, -L: Nat,
  ih: {L == O.bit(Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))), Nat.add(A, B)) : Nat})
  -> {O.bit(Bool.xor(Bool.xor(x, y), c), Nat.double(L)) == O.bit(c, Nat.add(O.bit(x, Nat.double(A)), O.bit(y, Nat.double(B)))) : Nat}:
  %Equal.sym(Nat, L, O.bit(Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))), Nat.add(A, B)), ih) : {O.bit(Bool.xor(Bool.xor(x, y), c), Nat.double(_)) == O.bit(c, Nat.add(O.bit(x, Nat.double(A)), O.bit(y, Nat.double(B)))) : Nat}
  %Equal.sym(Nat, Nat.add(O.bit(x, Nat.double(A)), O.bit(y, Nat.double(B))), O.bit(x, O.bit(y, Nat.add(Nat.double(A), Nat.double(B)))), pa.add_bits(x, y, Nat.double(A), Nat.double(B))) : {O.bit(Bool.xor(Bool.xor(x, y), c), Nat.double(O.bit(Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))), Nat.add(A, B)))) == O.bit(c, _) : Nat}
  %pa.double_add(A, B) : {O.bit(Bool.xor(Bool.xor(x, y), c), Nat.double(O.bit(Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))), Nat.add(A, B)))) == O.bit(c, O.bit(x, O.bit(y, _))) : Nat}
  pa.fa(x, y, c, Nat.add(A, B))

# the value of x + y + c
def pa.val_add(xs: List<&2, Bool>, ys: List<&2, Bool>, +c: Bool) -> {O.Bits.val(O.Bits.add.go(xs, ys, c)) == O.bit(c, Nat.add(O.Bits.val(xs), O.Bits.val(ys))) : Nat}:
  match xs ys:
    case Nil{} +ys:
      match c:
        case False{}:
          {==}
        case True{}:
          pa.val_inc(ys)
    case +x <> +xt Nil{}:
      match c:
        case False{}:
          Equal.sym(Nat, Nat.add(O.Bits.val(x <> xt), 0n), O.Bits.val(x <> xt), pa.add_zero(O.Bits.val(x <> xt)))
        case True{}:
          Equal.trans(Nat, O.Bits.val(O.Bits.inc(x <> xt)), 1n+O.Bits.val(x <> xt), 1n+Nat.add(O.Bits.val(x <> xt), 0n), pa.val_inc(x <> xt), pa.succ(O.Bits.val(x <> xt), Nat.add(O.Bits.val(x <> xt), 0n), Equal.sym(Nat, Nat.add(O.Bits.val(x <> xt), 0n), O.Bits.val(x <> xt), pa.add_zero(O.Bits.val(x <> xt)))))
    case +x <> +xt +y <> +yt:
      pa.val_add.cons(x, y, c, O.Bits.val(xt), O.Bits.val(yt), O.Bits.val(O.Bits.add.go(xt, yt, Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y))))), pa.val_add(xt, yt, Bool.or(Bool.and(x, y), Bool.and(c, Bool.or(x, y)))))

def pa.cmp0_dbl(n: Nat) -> {Nat.cmp(0n, Nat.double(n)) == Nat.cmp(0n, n) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pa.cmp_dbl0(n: Nat) -> {Nat.cmp(Nat.double(n), 0n) == Nat.cmp(n, 0n) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def pa.cmp_nil(ys: List<&2, Bool>) -> {O.Cmp.of_zero(O.Bits.is_zero(ys), LT{}) == Nat.cmp(0n, O.Bits.val(ys)) : Cmp}:
  match ys:
    case Nil{}:
      {==}
    case h <> +t:
      match h:
        case True{}:
          {==}
        case False{}:
          Equal.trans(Cmp, O.Cmp.of_zero(O.Bits.is_zero(t), LT{}), Nat.cmp(0n, O.Bits.val(t)), Nat.cmp(0n, Nat.double(O.Bits.val(t))), pa.cmp_nil(t), Equal.sym(Cmp, Nat.cmp(0n, Nat.double(O.Bits.val(t))), Nat.cmp(0n, O.Bits.val(t)), pa.cmp0_dbl(O.Bits.val(t))))

def pa.cmp_nil_r(xs: List<&2, Bool>) -> {O.Cmp.of_zero(O.Bits.is_zero(xs), GT{}) == Nat.cmp(O.Bits.val(xs), 0n) : Cmp}:
  match xs:
    case Nil{}:
      {==}
    case h <> +t:
      match h:
        case True{}:
          {==}
        case False{}:
          Equal.trans(Cmp, O.Cmp.of_zero(O.Bits.is_zero(t), GT{}), Nat.cmp(O.Bits.val(t), 0n), Nat.cmp(Nat.double(O.Bits.val(t)), 0n), pa.cmp_nil_r(t), Equal.sym(Cmp, Nat.cmp(Nat.double(O.Bits.val(t)), 0n), Nat.cmp(O.Bits.val(t), 0n), pa.cmp_dbl0(O.Bits.val(t))))

# comparing two numbers by their higher bits, then the lowest
def pa.cmp_bit(A: Nat, B: Nat, x: Bool, y: Bool) -> {O.Cmp.then(Nat.cmp(A, B), Bool.cmp(x, y)) == Nat.cmp(O.bit(x, Nat.double(A)), O.bit(y, Nat.double(B))) : Cmp}:
  match A B:
    case 0n 0n:
      match x y:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 0n 1n+q:
      match x y:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 1n+p 0n:
      match x y:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 1n+p 1n+q:
      match x y:
        case False{} False{}:
          pa.cmp_bit(p, q, False{}, False{})
        case False{} True{}:
          pa.cmp_bit(p, q, False{}, True{})
        case True{} False{}:
          pa.cmp_bit(p, q, True{}, False{})
        case True{} True{}:
          pa.cmp_bit(p, q, True{}, True{})

# bit lists compare as their values
def pa.cmp_val(xs: List<&2, Bool>, ys: List<&2, Bool>) -> {O.Bits.cmp(xs, ys) == Nat.cmp(O.Bits.val(xs), O.Bits.val(ys)) : Cmp}:
  match xs ys:
    case Nil{} ys:
      pa.cmp_nil(ys)
    case x <> xt Nil{}:
      pa.cmp_nil_r(x <> xt)
    case +x <> +xt +y <> +yt:
      Equal.trans(Cmp, O.Cmp.then(O.Bits.cmp(xt, yt), Bool.cmp(x, y)), O.Cmp.then(Nat.cmp(O.Bits.val(xt), O.Bits.val(yt)), Bool.cmp(x, y)), Nat.cmp(O.Bits.val(x <> xt), O.Bits.val(y <> yt)), Equal.cong(Cmp, Cmp, z => O.Cmp.then(z, Bool.cmp(x, y)), O.Bits.cmp(xt, yt), Nat.cmp(O.Bits.val(xt), O.Bits.val(yt)), pa.cmp_val(xt, yt)), pa.cmp_bit(O.Bits.val(xt), O.Bits.val(yt), x, y))

def pa.gt_val(+xs: List<&2, Bool>, +ys: List<&2, Bool>, e: {Nat.is_gt(O.Bits.val(xs), O.Bits.val(ys)) == True{} : Bool}) -> {O.Bits.gt(xs, ys) == True{} : Bool}:
  %Equal.sym(Cmp, O.Bits.cmp(xs, ys), Nat.cmp(O.Bits.val(xs), O.Bits.val(ys)), pa.cmp_val(xs, ys)) : {Cmp.is_gt(_) == True{} : Bool}
  e

def pa.same_val(+xs: List<&2, Bool>, +ys: List<&2, Bool>, e: {O.Bits.val(xs) == O.Bits.val(ys) : Nat}) -> {O.Bits.same(xs, ys) == True{} : Bool}:
  %Equal.sym(Cmp, O.Bits.cmp(xs, ys), Nat.cmp(O.Bits.val(xs), O.Bits.val(ys)), pa.cmp_val(xs, ys)) : {Cmp.is_eq(_) == True{} : Bool}
  %e : {Cmp.is_eq(Nat.cmp(O.Bits.val(xs), _)) == True{} : Bool}
  %Equal.sym(Cmp, Nat.cmp(O.Bits.val(xs), O.Bits.val(xs)), EQ{}, pa.cmp_self(O.Bits.val(xs))) : {Cmp.is_eq(_) == True{} : Bool}
  {==}

# A number's bits
# ---------------
# nb(n): n in binary without high zero bits, as Bits.inc counts

def pa.nb(n: Nat) -> List<&2, Bool>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      O.Bits.inc(pa.nb(p))

def pa.val_nb(+n: Nat) -> {O.Bits.val(pa.nb(n)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      Equal.trans(Nat, O.Bits.val(O.Bits.inc(pa.nb(p))), 1n+O.Bits.val(pa.nb(p)), 1n+p, pa.val_inc(pa.nb(p)), pa.succ(O.Bits.val(pa.nb(p)), p, pa.val_nb(p)))

def pa.nb_odd(+r: Nat) -> {pa.nb(1n+Nat.double(r)) == True{} <> pa.nb(r) : List<&2, Bool>}:
  match r:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(List<&2, Bool>, List<&2, Bool>, z => O.Bits.inc(O.Bits.inc(z)), pa.nb(1n+Nat.double(p)), True{} <> pa.nb(p), pa.nb_odd(p))

def pa.nb_even(+p: Nat) -> {pa.nb(2n+Nat.double(p)) == False{} <> pa.nb(1n+p) : List<&2, Bool>}:
  Equal.cong(List<&2, Bool>, List<&2, Bool>, z => O.Bits.inc(z), pa.nb(1n+Nat.double(p)), True{} <> pa.nb(p), pa.nb_odd(p))

def pa.low_even(+r: Nat) -> {O.Bits.low(pa.nb(Nat.double(r))) == False{} : Bool}:
  match r:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(List<&2, Bool>, pa.nb(2n+Nat.double(p)), False{} <> pa.nb(1n+p), pa.nb_even(p)) : {O.Bits.low(_) == False{} : Bool}
      {==}

def pa.up_even(+r: Nat) -> {O.Bits.up(pa.nb(Nat.double(r))) == pa.nb(r) : List<&2, Bool>}:
  match r:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(List<&2, Bool>, pa.nb(2n+Nat.double(p)), False{} <> pa.nb(1n+p), pa.nb_even(p)) : {O.Bits.up(_) == pa.nb(1n+p) : List<&2, Bool>}
      {==}

def pa.bits_eq_self(x: List<&2, Bool>) -> {O.Bits.eq(x, x) == True{} : Bool}:
  match x:
    case Nil{}:
      {==}
    case h <> t:
      match h:
        case False{}:
          pa.bits_eq_self(t)
        case True{}:
          pa.bits_eq_self(t)

# The counter
# -----------
# ds: push's keep bits, lowest (newest entry) first; T = B(ds) messages.

def pa.B(ds: List<&2, Bool>) -> Nat:
  match ds:
    case Nil{}:
      0n
    case d <> r:
      match d:
        case False{}:
          1n+Nat.double(pa.B(r))
        case True{}:
          2n+Nat.double(pa.B(r))

# one more message: a 0 absorbs, a 1 carries
def pa.inc(ds: List<&2, Bool>) -> List<&2, Bool>:
  match ds:
    case Nil{}:
      [False{}]
    case d <> r:
      match d:
        case False{}:
          True{} <> r
        case True{}:
          False{} <> pa.inc(r)

def pa.B_inc(ds: List<&2, Bool>) -> {pa.B(pa.inc(ds)) == 1n+pa.B(ds) : Nat}:
  match ds:
    case Nil{}:
      {==}
    case d <> +r:
      match d:
        case False{}:
          {==}
        case True{}:
          Equal.cong(Nat, Nat, z => 1n+Nat.double(z), pa.B(pa.inc(r)), 1n+pa.B(r), pa.B_inc(r))

# push's list (newest first) at offset j: entry j keeps its digit and
# holds the state where its line starts, sum over k > j of (1 + d_k)·2^k
def pa.GE(ds: List<&2, Bool>, +j: Nat) -> List<&2, O.Entry>:
  match ds:
    case Nil{}:
      Nil{}
    case d <> +r:
      match d:
        case False{}:
          O.Entry{0n, 0n, pa.nb(pa.sh(1n+j, pa.B(r)))} <> pa.GE(r, 1n+j)
        case True{}:
          O.Entry{1n, 0n, pa.nb(pa.sh(1n+j, pa.B(r)))} <> pa.GE(r, 1n+j)

# the view (oldest first): the view of the higher digits one level up,
# then the line of digit 0, of level d_0
def pa.lift(n: O.Node) -> O.Node:
  match n:
    case O.Node{l, i}:
      O.Node{1n+l, i}

def pa.lifts(v: List<&2, O.Node>) -> List<&2, O.Node>:
  match v:
    case Nil{}:
      Nil{}
    case h <> t:
      pa.lift(h) <> pa.lifts(t)

def pa.line(d: Bool, +r: Nat) -> O.Node:
  match d:
    case False{}:
      O.Node{0n, pa.nb(Nat.double(r))}
    case True{}:
      O.Node{1n, pa.nb(r)}

def pa.GV(ds: List<&2, Bool>) -> List<&2, O.Node>:
  match ds:
    case Nil{}:
      Nil{}
    case d <> +r:
      List.append(&2, O.Node, pa.lifts(pa.GV(r)), [pa.line(d, pa.B(r))])

# Push is the counter
# -------------------

def pa.push_ge(ds: List<&2, Bool>, +j: Nat) -> {O.push(pa.GE(ds, j), pa.nb(pa.sh(j, pa.B(ds)))) == pa.GE(pa.inc(ds), j) : List<&2, O.Entry>}:
  match ds:
    case Nil{}:
      %Equal.sym(Nat, pa.sh(j, 0n), 0n, pa.sh_zero(j)) : {[O.Entry{0n, 0n, pa.nb(_)}] == [O.Entry{0n, 0n, pa.nb(Nat.double(_))}] : List<&2, O.Entry>}
      {==}
    case d <> +r:
      match d:
        case False{}:
          {==}
        case True{}:
          %pa.push_ge(r, 1n+j) : {O.Entry{0n, 0n, pa.nb(pa.sh(j, 2n+Nat.double(pa.B(r))))} <> O.push(pa.GE(r, 1n+j), pa.nb(pa.sh(1n+j, pa.B(r)))) == O.Entry{0n, 0n, pa.nb(pa.sh(1n+j, pa.B(pa.inc(r))))} <> _ : List<&2, O.Entry>}
          %pa.B_inc(r) : {O.Entry{0n, 0n, pa.nb(pa.sh(j, Nat.double(_)))} <> O.push(pa.GE(r, 1n+j), pa.nb(pa.sh(1n+j, pa.B(r)))) == O.Entry{0n, 0n, pa.nb(pa.sh(1n+j, pa.B(pa.inc(r))))} <> O.push(pa.GE(r, 1n+j), pa.nb(pa.sh(1n+j, pa.B(r)))) : List<&2, O.Entry>}
          %pa.sh_double(j, pa.B(pa.inc(r))) : {O.Entry{0n, 0n, pa.nb(pa.sh(j, Nat.double(pa.B(pa.inc(r)))))} <> O.push(pa.GE(r, 1n+j), pa.nb(pa.sh(1n+j, pa.B(r)))) == O.Entry{0n, 0n, pa.nb(_)} <> O.push(pa.GE(r, 1n+j), pa.nb(pa.sh(1n+j, pa.B(r)))) : List<&2, O.Entry>}
          {==}

# Push's list is the view
# -----------------------
# Compared by value: the view's starts and push's states, oldest first.

def pa.vals(xs: List<&2, List<&2, Bool>>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      Nil{}
    case h <> t:
      O.Bits.val(h) <> pa.vals(t)

def pa.dbls(xs: List<&2, Nat>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      Nil{}
    case h <> t:
      Nat.double(h) <> pa.dbls(t)

def pa.hd(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case h <> t:
      h

def pa.tl(xs: List<&2, Nat>) -> List<&2, Nat>:
  match xs:
    case Nil{}:
      Nil{}
    case h <> t:
      t

def pa.NilT(xs: List<&2, Nat>, A: Type) -> Type:
  match xs:
    case Nil{}:
      Unit
    case h <> t:
      A

def pa.nil_cons(-A: Type, -h: Nat, -t: List<&2, Nat>, e: {Nil{} == h <> t : List<&2, Nat>}) -> A:
  %e : pa.NilT(_, A)
  Unit{}

def pa.same_vals(xs: List<&2, List<&2, Bool>>, ys: List<&2, List<&2, Bool>>, +e: {pa.vals(xs) == pa.vals(ys) : List<&2, Nat>}) -> {O.Bitss.same(xs, ys) == True{} : Bool}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Nil{} +y <> +yt:
      pa.nil_cons({False{} == True{} : Bool}, O.Bits.val(y), pa.vals(yt), e)
    case +x <> +xt Nil{}:
      pa.nil_cons({False{} == True{} : Bool}, O.Bits.val(x), pa.vals(xt), Equal.sym(List<&2, Nat>, O.Bits.val(x) <> pa.vals(xt), Nil{}, e))
    case +x <> +xt +y <> +yt:
      %Equal.sym(Bool, O.Bits.same(x, y), True{}, pa.same_val(x, y, Equal.cong(List<&2, Nat>, Nat, z => pa.hd(z), O.Bits.val(x) <> pa.vals(xt), O.Bits.val(y) <> pa.vals(yt), e))) : {Bool.and(_, O.Bitss.same(xt, yt)) == True{} : Bool}
      pa.same_vals(xt, yt, Equal.cong(List<&2, Nat>, List<&2, Nat>, z => pa.tl(z), O.Bits.val(x) <> pa.vals(xt), O.Bits.val(y) <> pa.vals(yt), e))

def pa.vals_rev(xs: List<&2, List<&2, Bool>>, acc: List<&2, List<&2, Bool>>) -> {pa.vals(List.reverse.go(&2, List<&2, Bool>, xs, acc)) == List.reverse.go(&2, Nat, pa.vals(xs), pa.vals(acc)) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case h <> t:
      pa.vals_rev(t, h <> acc)

def pa.app_assoc(xs: List<&2, Nat>, +ys: List<&2, Nat>, +zs: List<&2, Nat>) -> {List.append(&2, Nat, List.append(&2, Nat, xs, ys), zs) == List.append(&2, Nat, xs, List.append(&2, Nat, ys, zs)) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, z => h <> z, List.append(&2, Nat, List.append(&2, Nat, t, ys), zs), List.append(&2, Nat, t, List.append(&2, Nat, ys, zs)), pa.app_assoc(t, ys, zs))

# reversing onto acc is reversing, then acc
def pa.rev_app(xs: List<&2, Nat>, +acc: List<&2, Nat>) -> {List.reverse.go(&2, Nat, xs, acc) == List.append(&2, Nat, List.reverse.go(&2, Nat, xs, Nil{}), acc) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      +R = List.reverse.go(&2, Nat, t, Nil{})
      %Equal.sym(List<&2, Nat>, List.reverse.go(&2, Nat, t, [h]), List.append(&2, Nat, R, [h]), pa.rev_app(t, [h])) : {List.reverse.go(&2, Nat, t, h <> acc) == List.append(&2, Nat, _, acc) : List<&2, Nat>}
      %Equal.sym(List<&2, Nat>, List.append(&2, Nat, List.append(&2, Nat, R, [h]), acc), List.append(&2, Nat, R, h <> acc), pa.app_assoc(R, [h], acc)) : {List.reverse.go(&2, Nat, t, h <> acc) == _ : List<&2, Nat>}
      pa.rev_app(t, h <> acc)

def pa.dbls_rev(xs: List<&2, Nat>, +acc: List<&2, Nat>) -> {List.reverse.go(&2, Nat, pa.dbls(xs), pa.dbls(acc)) == pa.dbls(List.reverse.go(&2, Nat, xs, acc)) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      pa.dbls_rev(t, h <> acc)

def pa.SG(ds: List<&2, Bool>) -> List<&2, Nat>:
  pa.vals(O.starts(pa.GV(ds)))

def pa.SE(ds: List<&2, Bool>, +j: Nat) -> List<&2, Nat>:
  pa.vals(O.states(pa.GE(ds, j)))

def pa.cons2(-a: Nat, -b: Nat, -xs: List<&2, Nat>, -ys: List<&2, Nat>, ea: {a == b : Nat}, et: {xs == ys : List<&2, Nat>}) -> {a <> xs == b <> ys : List<&2, Nat>}:
  %ea : {a <> xs == _ <> ys : List<&2, Nat>}
  %et : {a <> xs == a <> _ : List<&2, Nat>}
  {==}

# val(nb(2x)) = 2·val(nb(x))
def pa.val_nb2(+x: Nat) -> {O.Bits.val(pa.nb(Nat.double(x))) == Nat.double(O.Bits.val(pa.nb(x))) : Nat}:
  Equal.trans(Nat, O.Bits.val(pa.nb(Nat.double(x))), Nat.double(x), Nat.double(O.Bits.val(pa.nb(x))), pa.val_nb(Nat.double(x)), Equal.cong(Nat, Nat, z => Nat.double(z), x, O.Bits.val(pa.nb(x)), Equal.sym(Nat, O.Bits.val(pa.nb(x)), x, pa.val_nb(x))))

def pa.vs_app(xs: List<&2, O.Node>, +y: O.Node) -> {pa.vals(O.starts(List.append(&2, O.Node, xs, [y]))) == List.append(&2, Nat, pa.vals(O.starts(xs)), [O.Bits.val(O.pair_start(y))]) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> t:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, z => O.Bits.val(O.pair_start(h)) <> z, pa.vals(O.starts(List.append(&2, O.Node, t, [y]))), List.append(&2, Nat, pa.vals(O.starts(t)), [O.Bits.val(O.pair_start(y))]), pa.vs_app(t, y))

def pa.vs_lifts(xs: List<&2, O.Node>) -> {pa.vals(O.starts(pa.lifts(xs))) == pa.dbls(pa.vals(O.starts(xs))) : List<&2, Nat>}:
