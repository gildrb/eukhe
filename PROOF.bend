# ---- wait ----

# proof_wait: the wait laws of LAWS.bend (H6): a wait ends exactly once,
# no later than its deadline or its cancel, and with the event when the
# event comes first. Each lemma speaks of an open wait whose deadline
# passes on the (m + 1)-th tick (`pw.up` names that deadline in ticks
# from now), by induction on the signals it sees.

# Logic
# -----

def pw.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pw.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : pw.BD(_, Unit, A)
  Unit{}

def pw.or_true(a: Bool) -> {True{} == Bool.or(a, True{}) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pw.le0(t: Nat) -> {True{} == Nat.is_le(0n, t) : Bool}:
  match t:
    case 0n:
      {==}
    case 1n+q:
      {==}

# a deadline of 0 ticks is reached, whatever came
def pw.reached0(+a: Bool, +c: Bool, t: Nat) -> {True{} == Bool.or(a, Bool.or(c, Nat.is_le(0n, t))) : Bool}:
  %pw.le0(t) : {True{} == Bool.or(a, Bool.or(c, _)) : Bool}
  %pw.or_true(c) : {True{} == Bool.or(a, _) : Bool}
  pw.or_true(a)

# the deadline, in ticks from now, of an open wait
def pw.up(l: Maybe<&2, Nat>) -> Maybe<&2, Nat>:
  match l:
    case None{}:
      None{}
    case Some{m}:
      Some{1n+m}

# an ended wait reports nothing more
def pw.over(xs: List<&2, Wt.Sig>) -> {Nil{} == Wt.go(xs, Wt.Over{}) : List<&2, Wt.End>}:
  match xs:
    case Nil{}:
      {==}
    case s <> rest:
      pw.over(rest)

# Exactly once
# ------------

def pw.once(xs: List<&2, Wt.Sig>, +l: Maybe<&2, Nat>) -> {List.length(&2, Wt.End, Wt.go(xs, Wt.Open{l})) == Wt.once(Wt.exits(pw.up(l), xs)) : Nat}:
  match xs:
    case Nil{}:
      match l:
        case None{}:
          {==}
        case Some{m}:
          {==}
    case s <> +rest:
      match s:
        case Wt.Arrive{}:
          %pw.over(rest) : {1n+List.length(&2, Wt.End, _) == 1n : Nat}
          {==}
        case Wt.Cancel{}:
          %pw.over(rest) : {1n+List.length(&2, Wt.End, _) == Wt.once(Bool.or(Wt.has_arrive(rest), True{})) : Nat}
          %pw.or_true(Wt.has_arrive(rest)) : {1n == Wt.once(_) : Nat}
          {==}
        case Wt.Tick{}:
          match l:
            case None{}:
              pw.once(rest, None{})
            case Some{m}:
              match m:
                case 0n:
                  %pw.over(rest) : {1n+List.length(&2, Wt.End, _) == Wt.once(Bool.or(Wt.has_arrive(rest), Bool.or(Wt.has_cancel(rest), Nat.is_le(0n, Wt.ticks(rest))))) : Nat}
                  %pw.reached0(Wt.has_arrive(rest), Wt.has_cancel(rest), Wt.ticks(rest)) : {1n == Wt.once(_) : Nat}
                  {==}
                case 1n+q:
                  pw.once(rest, Some{q})

# No later than the deadline or the cancel
# ----------------------------------------

def pw.bound(pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, +l: Maybe<&2, Nat>, stop: {Wt.stops(pw.up(l), pre) == True{} : Bool}) -> {Wt.go(List.append(&2, Wt.Sig, pre, post), Wt.Open{l}) == Wt.go(pre, Wt.Open{l}) : List<&2, Wt.End>}:
  match pre:
    case Nil{}:
      match l:
        case None{}:
          pw.absurd({Wt.go(post, Wt.Open{None{}}) == Nil{} : List<&2, Wt.End>}, Equal.sym(Bool, False{}, True{}, stop))
        case Some{m}:
          pw.absurd({Wt.go(post, Wt.Open{Some{m}}) == Nil{} : List<&2, Wt.End>}, Equal.sym(Bool, False{}, True{}, stop))
    case s <> +rest:
      match s:
        case Wt.Arrive{}:
          %pw.over(List.append(&2, Wt.Sig, rest, post)) : {Wt.Arrived{} <> _ == Wt.Arrived{} <> Wt.go(rest, Wt.Over{}) : List<&2, Wt.End>}
          %pw.over(rest) : {[Wt.Arrived{}] == Wt.Arrived{} <> _ : List<&2, Wt.End>}
          {==}
        case Wt.Cancel{}:
          %pw.over(List.append(&2, Wt.Sig, rest, post)) : {Wt.Cancelled{} <> _ == Wt.Cancelled{} <> Wt.go(rest, Wt.Over{}) : List<&2, Wt.End>}
          %pw.over(rest) : {[Wt.Cancelled{}] == Wt.Cancelled{} <> _ : List<&2, Wt.End>}
          {==}
        case Wt.Tick{}:
          match l:
            case None{}:
              pw.bound(rest, post, None{}, stop)
            case Some{m}:
              match m:
                case 0n:
                  %pw.over(List.append(&2, Wt.Sig, rest, post)) : {Wt.Expired{} <> _ == Wt.Expired{} <> Wt.go(rest, Wt.Over{}) : List<&2, Wt.End>}
                  %pw.over(rest) : {[Wt.Expired{}] == Wt.Expired{} <> _ : List<&2, Wt.End>}
                  {==}
                case 1n+q:
                  pw.bound(rest, post, Some{q}, stop)

# The first exit wins
# -------------------

def pw.arrive(pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, +l: Maybe<&2, Nat>, calm: {Wt.exits(pw.up(l), pre) == False{} : Bool}) -> {Wt.go(List.append(&2, Wt.Sig, pre, Wt.Arrive{} <> post), Wt.Open{l}) == [Wt.Arrived{}] : List<&2, Wt.End>}:
  match pre:
    case Nil{}:
      %pw.over(post) : {Wt.Arrived{} <> _ == [Wt.Arrived{}] : List<&2, Wt.End>}
      {==}
    case s <> +rest:
      match s:
        case Wt.Arrive{}:
          pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Arrive{} <> rest, Wt.Arrive{} <> post), Wt.Open{l}) == [Wt.Arrived{}] : List<&2, Wt.End>}, calm)
        case Wt.Cancel{}:
          pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Cancel{} <> rest, Wt.Arrive{} <> post), Wt.Open{l}) == [Wt.Arrived{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(rest), True{}), False{}, pw.or_true(Wt.has_arrive(rest)), calm))
        case Wt.Tick{}:
          match l:
            case None{}:
              pw.arrive(rest, post, None{}, calm)
            case Some{m}:
              match m:
                case 0n:
                  pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Tick{} <> rest, Wt.Arrive{} <> post), Wt.Open{Some{0n}}) == [Wt.Arrived{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(rest), Bool.or(Wt.has_cancel(rest), Nat.is_le(0n, Wt.ticks(rest)))), False{}, pw.reached0(Wt.has_arrive(rest), Wt.has_cancel(rest), Wt.ticks(rest)), calm))
                case 1n+q:
                  pw.arrive(rest, post, Some{q}, calm)

def pw.cancel(pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, +l: Maybe<&2, Nat>, calm: {Wt.exits(pw.up(l), pre) == False{} : Bool}) -> {Wt.go(List.append(&2, Wt.Sig, pre, Wt.Cancel{} <> post), Wt.Open{l}) == [Wt.Cancelled{}] : List<&2, Wt.End>}:
  match pre:
    case Nil{}:
      %pw.over(post) : {Wt.Cancelled{} <> _ == [Wt.Cancelled{}] : List<&2, Wt.End>}
      {==}
    case s <> +rest:
      match s:
        case Wt.Arrive{}:
          pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Arrive{} <> rest, Wt.Cancel{} <> post), Wt.Open{l}) == [Wt.Cancelled{}] : List<&2, Wt.End>}, calm)
        case Wt.Cancel{}:
          pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Cancel{} <> rest, Wt.Cancel{} <> post), Wt.Open{l}) == [Wt.Cancelled{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(rest), True{}), False{}, pw.or_true(Wt.has_arrive(rest)), calm))
        case Wt.Tick{}:
          match l:
            case None{}:
              pw.cancel(rest, post, None{}, calm)
            case Some{m}:
              match m:
                case 0n:
                  pw.absurd({Wt.go(List.append(&2, Wt.Sig, Wt.Tick{} <> rest, Wt.Cancel{} <> post), Wt.Open{Some{0n}}) == [Wt.Cancelled{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(rest), Bool.or(Wt.has_cancel(rest), Nat.is_le(0n, Wt.ticks(rest)))), False{}, pw.reached0(Wt.has_arrive(rest), Wt.has_cancel(rest), Wt.ticks(rest)), calm))
                case 1n+q:
                  pw.cancel(rest, post, Some{q}, calm)

# The laws
# --------

def wait_ends_once(+dl: Maybe<&2, Nat>, +xs: List<&2, Wt.Sig>) -> {List.length(&2, Wt.End, Wt.run(dl, xs)) == Wt.once(Wt.exits(dl, xs)) : Nat}:
  match dl:
    case None{}:
      pw.once(xs, None{})
    case Some{d}:
      match d:
        case 0n:
          %pw.reached0(Wt.has_arrive(xs), Wt.has_cancel(xs), Wt.ticks(xs)) : {1n == Wt.once(_) : Nat}
          {==}
        case 1n+m:
          pw.once(xs, Some{m})

def wait_end_is_final(+dl: Maybe<&2, Nat>, +pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, stop: {Wt.stops(dl, pre) == True{} : Bool}) -> {Wt.run(dl, List.append(&2, Wt.Sig, pre, post)) == Wt.run(dl, pre) : List<&2, Wt.End>}:
  match dl:
    case None{}:
      pw.bound(pre, post, None{}, stop)
    case Some{d}:
      match d:
        case 0n:
          {==}
        case 1n+m:
          pw.bound(pre, post, Some{m}, stop)

def wait_arrival_wins(+dl: Maybe<&2, Nat>, +pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, calm: {Wt.exits(dl, pre) == False{} : Bool}) -> {Wt.run(dl, List.append(&2, Wt.Sig, pre, Wt.Arrive{} <> post)) == [Wt.Arrived{}] : List<&2, Wt.End>}:
  match dl:
    case None{}:
      pw.arrive(pre, post, None{}, calm)
    case Some{d}:
      match d:
        case 0n:
          pw.absurd({[Wt.Expired{}] == [Wt.Arrived{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(pre), Bool.or(Wt.has_cancel(pre), Nat.is_le(0n, Wt.ticks(pre)))), False{}, pw.reached0(Wt.has_arrive(pre), Wt.has_cancel(pre), Wt.ticks(pre)), calm))
        case 1n+m:
          pw.arrive(pre, post, Some{m}, calm)

def wait_cancel_wins(+dl: Maybe<&2, Nat>, +pre: List<&2, Wt.Sig>, +post: List<&2, Wt.Sig>, calm: {Wt.exits(dl, pre) == False{} : Bool}) -> {Wt.run(dl, List.append(&2, Wt.Sig, pre, Wt.Cancel{} <> post)) == [Wt.Cancelled{}] : List<&2, Wt.End>}:
  match dl:
    case None{}:
      pw.cancel(pre, post, None{}, calm)
    case Some{d}:
      match d:
        case 0n:
          pw.absurd({[Wt.Expired{}] == [Wt.Cancelled{}] : List<&2, Wt.End>}, Equal.trans(Bool, True{}, Bool.or(Wt.has_arrive(pre), Bool.or(Wt.has_cancel(pre), Nat.is_le(0n, Wt.ticks(pre)))), False{}, pw.reached0(Wt.has_arrive(pre), Wt.has_cancel(pre), Wt.ticks(pre)), calm))
        case 1n+m:
          pw.cancel(pre, post, Some{m}, calm)

# ---- lease ----

# proof_lease: the lease laws of LAWS.bend (H6). Every event keeps an
# invariant of the reachable states: the holder came before every waiter,
# the waiters wait in arrival order, and every key is below the next one
# (`pl.Inv`). From it: first come, first served (`lease_fifo`); the lease
# is never free while a live waiter waits (`lease_never_idle`); no event
# drops a waiter it does not name (`lease_keeps_waiters`); a waiter that
# stopped waiting never holds the lease (`lease_stop_never_holds`); a
# crash frees every lease of its origin (`lease_crash_frees`).

# Logic and numbers
# -----------------

def lease.pl.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def lease.pl.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : lease.pl.BD(_, Unit, A)
  Unit{}

def lease.pl.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : lease.pl.BD(_, A, Unit)
  Unit{}

def pl.void(-A: Type, e: Empty) -> A:
  match e:

def pl.MD(m: Maybe<&2, Ls.Lease>, A: Type) -> Type:
  match m:
    case None{}:
      Unit
    case Some{x}:
      A

def pl.none_some(-A: Type, -x: Ls.Lease, e: {None{} == Some{x} : Maybe<&2, Ls.Lease>}) -> A:
  %e : pl.MD(_, A)
  Unit{}

def pl.and_false(b: Bool) -> {Bool.and(b, False{}) == False{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def lease.pl.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      lease.pl.eq_refl(p)

def pl.lt_irrefl(k: Nat) -> {Nat.is_lt(k, k) == False{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pl.lt_irrefl(p)

def pl.lt_self(n: Nat) -> {Nat.is_lt(n, 1n+n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      pl.lt_self(p)

def pl.lt_succ(k: Nat, n: Nat, h: {Nat.is_lt(k, n) == True{} : Bool}) -> {Nat.is_lt(k, 1n+n) == True{} : Bool}:
  match k n:
    case 0n _:
      {==}
    case 1n+p 0n:
      lease.pl.absurdF({Nat.is_lt(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+m:
      pl.lt_succ(p, m, h)

def pl.lt_trans(a: Nat, b: Nat, c: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  match a b c:
    case _ 0n _:
      lease.pl.absurdF({Nat.is_lt(a, c) == True{} : Bool}, ab)
    case _ 1n+q 0n:
      lease.pl.absurdF({Nat.is_lt(a, 0n) == True{} : Bool}, bc)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 1n+q 1n+r:
      pl.lt_trans(p, q, r, ab, bc)

def pl.lt_irrefl_at(+a: Nat, +b: Nat, eq: {a == b : Nat}) -> {Nat.is_lt(a, b) == False{} : Bool}:
  %Equal.sym(Nat, a, b, eq) : {Nat.is_lt(_, b) == False{} : Bool}
  pl.lt_irrefl(b)

# a key below another is not it
def pl.ne_of_lt(+a: Nat, +b: Nat, lt: {Nat.is_lt(a, b) == True{} : Bool}, eq: {a == b : Nat}) -> Empty:
  lease.pl.absurd(Empty, Equal.trans(Bool, True{}, Nat.is_lt(a, b), False{}, Equal.sym(Bool, Nat.is_lt(a, b), True{}, lt), pl.lt_irrefl_at(a, b, eq)))

# Waiters
# -------

def pl.org(w: Ls.Waiter) -> Nat:
  match w:
    case Ls.Waiter{k, o, l}:
      o

def pl.lease_of(w: Ls.Waiter) -> Maybe<&2, Ls.Lease>:
  match w:
    case Ls.Waiter{k, o, l}:
      Some{Ls.Lease{k, o}}

def pl.in_append(+x: Ls.Waiter, q: List<&2, Ls.Waiter>, +ys: List<&2, Ls.Waiter>, i: Ls.In(x, q)) -> Ls.In(x, List.append(&2, Ls.Waiter, q, ys)):
  match q:
    case Nil{}:
      match i:
    case +w <> +t:
      match i:
        case Inl{eq}:
          Inl{eq}
        case Inr{it}:
          Inr{pl.in_append(x, t, ys, it)}

def pl.in_put(b: Bool, +w: Ls.Waiter, +x: Ls.Waiter, +r: List<&2, Ls.Waiter>, i: Ls.In(x, r)) -> Ls.In(x, Ls.drop.put(b, w, r)):
  match b:
    case True{}:
      i
    case False{}:
      Inr{i}

# a waiter e does not end stays
def pl.in_drop(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +x: Ls.Waiter, i: Ls.In(x, q), miss: {Ls.hits(e, x) == False{} : Bool}) -> Ls.In(x, Ls.drop(e, q)):
  match q:
    case Nil{}:
      match i:
    case +w <> +t:
      match i:
        case Inl{eq}:
          %eq : Ls.In(x, Ls.drop.put(Ls.hits(e, _), _, Ls.drop(e, t)))
          %Equal.sym(Bool, Ls.hits(e, x), False{}, miss) : Ls.In(x, Ls.drop.put(_, x, Ls.drop(e, t)))
          Inl{{==}}
        case Inr{it}:
          pl.in_put(Ls.hits(e, w), w, x, Ls.drop(e, t), pl.in_drop(e, t, x, it, miss))

# and stays live
def pl.in_mark(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +k: Nat, +o: Nat, i: Ls.In(Ls.Waiter{k, o, True{}}, q), miss: {Ls.hits(e, Ls.Waiter{k, o, True{}}) == False{} : Bool}) -> Ls.In(Ls.Waiter{k, o, True{}}, Ls.mark(e, q)):
  match q:
    case Nil{}:
      match i:
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          match i:
            case Inl{+eq}:
              +ek = Equal.cong(Ls.Waiter, Nat, v => Ls.Waiter.key(v), Ls.Waiter{k, o, True{}}, Ls.Waiter{wk, wo, wl}, eq)
              +eo = Equal.cong(Ls.Waiter, Nat, v => pl.org(v), Ls.Waiter{k, o, True{}}, Ls.Waiter{wk, wo, wl}, eq)
              +el = Equal.cong(Ls.Waiter, Bool, v => Ls.Waiter.live(v), Ls.Waiter{k, o, True{}}, Ls.Waiter{wk, wo, wl}, eq)
              %ek : Ls.In(Ls.Waiter{k, o, True{}}, Ls.Waiter{_, wo, Bool.and(wl, Bool.not(Ls.hits(e, Ls.Waiter{_, wo, wl})))} <> Ls.mark(e, t))
              %eo : Ls.In(Ls.Waiter{k, o, True{}}, Ls.Waiter{k, _, Bool.and(wl, Bool.not(Ls.hits(e, Ls.Waiter{k, _, wl})))} <> Ls.mark(e, t))
              %el : Ls.In(Ls.Waiter{k, o, True{}}, Ls.Waiter{k, o, Bool.and(_, Bool.not(Ls.hits(e, Ls.Waiter{k, o, _})))} <> Ls.mark(e, t))
              %Equal.sym(Bool, Ls.hits(e, Ls.Waiter{k, o, True{}}), False{}, miss) : Ls.In(Ls.Waiter{k, o, True{}}, Ls.Waiter{k, o, Bool.and(True{}, Bool.not(_))} <> Ls.mark(e, t))
              Inl{{==}}
            case Inr{it}:
              Inr{pl.in_mark(e, t, k, o, it, miss)}

# Kept: no event drops a waiter it does not name
# ----------------------------------------------

def pl.pick_kept(+k: Nat, +o: Nat, +n: Nat, q: List<&2, Ls.Waiter>, i: Ls.In(Ls.Waiter{k, o, True{}}, q)) -> Ls.Kept(k, o, Ls.L{n, Ls.pick(q), Ls.after(q)}):
  match q:
    case Nil{}:
      match i:
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          match wl:
            case True{}:
              match i:
                case Inl{eq}:
                  Inl{Equal.sym(Maybe<&2, Ls.Lease>, Some{Ls.Lease{k, o}}, Some{Ls.Lease{wk, wo}}, Equal.cong(Ls.Waiter, Maybe<&2, Ls.Lease>, v => pl.lease_of(v), Ls.Waiter{k, o, True{}}, Ls.Waiter{wk, wo, True{}}, eq))}
                case Inr{it}:
                  Inr{it}
            case False{}:
              match i:
                case Inl{eq}:
                  lease.pl.absurd(Ls.Kept(k, o, Ls.L{n, Ls.pick(t), Ls.after(t)}), Equal.cong(Ls.Waiter, Bool, v => Ls.Waiter.live(v), Ls.Waiter{k, o, True{}}, Ls.Waiter{wk, wo, False{}}, eq))
                case Inr{it}:
                  pl.pick_kept(k, o, n, t, it)

def pl.settle_kept(+k: Nat, +o: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, kp: Or({h == Some{Ls.Lease{k, o}} : Maybe<&2, Ls.Lease>}, Ls.In(Ls.Waiter{k, o, True{}}, q))) -> Ls.Kept(k, o, Ls.settle(n, h, q)):
  match h:
    case None{}:
      match kp:
        case Inl{e}:
          pl.none_some(Ls.Kept(k, o, Ls.settle(n, None{}, q)), Ls.Lease{k, o}, e)
        case Inr{i}:
          pl.pick_kept(k, o, n, q, i)
    case Some{x}:
      kp

def pl.release_kept(hit: Bool, +x: Ls.Lease, +j: Nat, +k: Nat, +o: Nat, +n: Nat, +q: List<&2, Ls.Waiter>, i: Ls.In(Ls.Waiter{k, o, True{}}, q), miss: {Nat.is_eq(k, j) == False{} : Bool}) -> Ls.Kept(k, o, Ls.release.holder(hit, x, j, n, q)):
  match hit:
    case True{}:
      pl.settle_kept(k, o, n, None{}, q, Inr{i})
    case False{}:
      Inr{pl.in_drop(Ls.Release{j}, q, Ls.Waiter{k, o, True{}}, i, miss)}

def pl.keeps_release(+j: Nat, +k: Nat, +o: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, i: Ls.In(Ls.Waiter{k, o, True{}}, q), miss: {Nat.is_eq(k, j) == False{} : Bool}) -> Ls.Kept(k, o, Ls.release(j, n, h, q)):
  match h:
    case None{}:
      pl.settle_kept(k, o, n, None{}, Ls.drop(Ls.Release{j}, q), Inr{pl.in_drop(Ls.Release{j}, q, Ls.Waiter{k, o, True{}}, i, miss)})
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          pl.release_kept(Nat.is_eq(hk, j), Ls.Lease{hk, ho}, j, k, o, n, q, i, miss)

def pl.keeps(+s: Ls.L, +e: Ls.Ev, +k: Nat, +o: Nat, i: Ls.In(Ls.Waiter{k, o, True{}}, Ls.L.queue(s)), miss: {Ls.hits(e, Ls.Waiter{k, o, True{}}) == False{} : Bool}) -> Ls.Kept(k, o, Ls.step(s, e)):
  match s:
    case Ls.L{+n, h, +q}:
      match e:
        case Ls.Ask{p}:
          pl.settle_kept(k, o, 1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]), Inr{pl.in_append(Ls.Waiter{k, o, True{}}, q, [Ls.Waiter{n, p, True{}}], i)})
        case Ls.Release{+j}:
          pl.keeps_release(j, k, o, n, h, q, i, miss)
        case Ls.Stop{+j}:
          Inr{pl.in_mark(Ls.Stop{j}, q, k, o, i, miss)}
        case Ls.Crash{+p}:
          pl.settle_kept(k, o, n, Ls.crash.holder(p, h), Ls.drop(Ls.Crash{p}, q), Inr{pl.in_drop(Ls.Crash{p}, q, Ls.Waiter{k, o, True{}}, i, miss)})

# Busy: the lease is never free while a live waiter waits
# -------------------------------------------------------

def pl.pick_busy(+n: Nat, q: List<&2, Ls.Waiter>) -> Ls.Busy(Ls.L{n, Ls.pick(q), Ls.after(q)}):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{wk, wo, wl}:
          match wl:
            case True{}:
              Unit{}
            case False{}:
              pl.pick_busy(n, t)

def pl.settle_busy(+n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>) -> Ls.Busy(Ls.settle(n, h, q)):
  match h:
    case None{}:
      pl.pick_busy(n, q)
    case Some{x}:
      Unit{}

def pl.mark_dead(+e: Ls.Ev, q: List<&2, Ls.Waiter>, d: Ls.Dead(q)) -> Ls.Dead(Ls.mark(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          (dh, dt) = d
          %Equal.sym(Bool, wl, False{}, dh) : ({Bool.and(_, Bool.not(Ls.hits(e, Ls.Waiter{wk, wo, wl}))) == False{} : Bool} & Ls.Dead(Ls.mark(e, t)))
          ({==}, pl.mark_dead(e, t, dt))

def pl.release_busy(hit: Bool, +x: Ls.Lease, +j: Nat, +n: Nat, +q: List<&2, Ls.Waiter>) -> Ls.Busy(Ls.release.holder(hit, x, j, n, q)):
  match hit:
    case True{}:
      pl.settle_busy(n, None{}, q)
    case False{}:
      Unit{}

def pl.busy_release(+j: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>) -> Ls.Busy(Ls.release(j, n, h, q)):
  match h:
    case None{}:
      pl.settle_busy(n, None{}, Ls.drop(Ls.Release{j}, q))
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          pl.release_busy(Nat.is_eq(hk, j), Ls.Lease{hk, ho}, j, n, q)

def pl.busy_stop(+j: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, b: Ls.Busy(Ls.L{n, h, q})) -> Ls.Busy(Ls.L{n, h, Ls.mark(Ls.Stop{j}, q)}):
  match h:
    case None{}:
      pl.mark_dead(Ls.Stop{j}, q, b)
    case Some{x}:
      Unit{}

def pl.busy_step(+s: Ls.L, +e: Ls.Ev, b: Ls.Busy(s)) -> Ls.Busy(Ls.step(s, e)):
  match s:
    case Ls.L{+n, h, +q}:
      match e:
        case Ls.Ask{p}:
          pl.settle_busy(1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]))
        case Ls.Release{+j}:
          pl.busy_release(j, n, h, q)
        case Ls.Stop{+j}:
          pl.busy_stop(j, n, h, q, b)
        case Ls.Crash{+p}:
          pl.settle_busy(n, Ls.crash.holder(p, h), Ls.drop(Ls.Crash{p}, q))

def pl.busy_go(evs: List<&2, Ls.Ev>, +s: Ls.L, b: Ls.Busy(s)) -> Ls.Busy(Ls.go(evs, s)):
  match evs:
    case Nil{}:
      b
    case +e <> rest:
      pl.busy_go(rest, Ls.step(s, e), pl.busy_step(s, e, b))

# The invariant: arrival order, keys below the next
# -------------------------------------------------

def pl.Under(+n: Nat, q: List<&2, Ls.Waiter>) -> Data:
  match q:
    case Nil{}:
      Unit
    case +w <> +t:
      Sigma<&2, &2, {Nat.is_lt(Ls.Waiter.key(w), n) == True{} : Bool}, _ => pl.Under(n, t)>

def pl.HUnder(+n: Nat, h: Maybe<&2, Ls.Lease>) -> Data:
  match h:
    case None{}:
      Unit
    case Some{x}:
      match x:
        case Ls.Lease{hk, ho}:
          {Nat.is_lt(hk, n) == True{} : Bool}

def pl.Inv(s: Ls.L) -> Type:
  match s:
    case Ls.L{+n, +h, +q}:
      (Ls.Asc(Ls.hkey(h), q) & Sigma<&2, &2, pl.Under(n, q), _ => pl.HUnder(n, h)>)

def pl.asc_none(lo: Maybe<&2, Nat>, q: List<&2, Ls.Waiter>, a: Ls.Asc(lo, q)) -> Ls.Asc(None{}, q):
  match q:
    case Nil{}:
      Unit{}
    case +w <> +t:
      (_, at) = a
      ({==}, at)

# a looser bound
def pl.weaken(lo: Maybe<&2, Nat>, +l: Nat, r: List<&2, Ls.Waiter>, g: {Ls.above(l, lo) == True{} : Bool}, ar: Ls.Asc(Some{l}, r)) -> Ls.Asc(lo, r):
  match lo:
    case None{}:
      pl.asc_none(Some{l}, r, ar)
    case Some{+l0}:
      match r:
        case Nil{}:
          Unit{}
        case +w <> +t:
          (g2, at) = ar
          (pl.lt_trans(l0, l, Ls.Waiter.key(w), g, g2), at)

def pl.asc_put(b: Bool, +lo: Maybe<&2, Nat>, +w: Ls.Waiter, +r: List<&2, Ls.Waiter>, g: {Ls.above(Ls.Waiter.key(w), lo) == True{} : Bool}, ar: Ls.Asc(Some{Ls.Waiter.key(w)}, r)) -> Ls.Asc(lo, Ls.drop.put(b, w, r)):
  match b:
    case True{}:
      pl.weaken(lo, Ls.Waiter.key(w), r, g, ar)
    case False{}:
      (g, ar)

def pl.asc_drop(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +lo: Maybe<&2, Nat>, a: Ls.Asc(lo, q)) -> Ls.Asc(lo, Ls.drop(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case +w <> +t:
      (g, at) = a
      pl.asc_put(Ls.hits(e, w), lo, w, Ls.drop(e, t), g, pl.asc_drop(e, t, Some{Ls.Waiter.key(w)}, at))

def pl.asc_mark(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +lo: Maybe<&2, Nat>, a: Ls.Asc(lo, q)) -> Ls.Asc(lo, Ls.mark(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, wo, wl}:
          (g, at) = a
          (g, pl.asc_mark(e, t, Some{wk}, at))

def pl.asc_snoc(q: List<&2, Ls.Waiter>, +lo: Maybe<&2, Nat>, +n: Nat, +o: Nat, a: Ls.Asc(lo, q), u: pl.Under(n, q), g: {Ls.above(n, lo) == True{} : Bool}) -> Ls.Asc(lo, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, o, True{}}])):
  match q:
    case Nil{}:
      (g, Unit{})
    case +w <> +t:
      (gw, at) = a
      (uw, ut) = u
      (gw, pl.asc_snoc(t, Some{Ls.Waiter.key(w)}, n, o, at, ut, uw))

def pl.under_put(b: Bool, +n: Nat, +w: Ls.Waiter, +r: List<&2, Ls.Waiter>, uw: {Nat.is_lt(Ls.Waiter.key(w), n) == True{} : Bool}, ur: pl.Under(n, r)) -> pl.Under(n, Ls.drop.put(b, w, r)):
  match b:
    case True{}:
      ur
    case False{}:
      (uw, ur)

def pl.under_drop(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +n: Nat, u: pl.Under(n, q)) -> pl.Under(n, Ls.drop(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case +w <> +t:
      (uw, ut) = u
      pl.under_put(Ls.hits(e, w), n, w, Ls.drop(e, t), uw, pl.under_drop(e, t, n, ut))

def pl.under_mark(+e: Ls.Ev, q: List<&2, Ls.Waiter>, +n: Nat, u: pl.Under(n, q)) -> pl.Under(n, Ls.mark(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{wk, wo, wl}:
          (uw, ut) = u
          (uw, pl.under_mark(e, t, n, ut))

def pl.under_snoc(q: List<&2, Ls.Waiter>, +n: Nat, +o: Nat, u: pl.Under(n, q)) -> pl.Under(1n+n, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, o, True{}}])):
  match q:
    case Nil{}:
      (pl.lt_self(n), Unit{})
    case +w <> +t:
      (uw, ut) = u
      (pl.lt_succ(Ls.Waiter.key(w), n, uw), pl.under_snoc(t, n, o, ut))

def pl.hunder_succ(+n: Nat, h: Maybe<&2, Ls.Lease>, hu: pl.HUnder(n, h)) -> pl.HUnder(1n+n, h):
  match h:
    case None{}:
      Unit{}
    case Some{x}:
      match x:
        case Ls.Lease{hk, ho}:
          pl.lt_succ(hk, n, hu)

def pl.h_above(+n: Nat, h: Maybe<&2, Ls.Lease>, hu: pl.HUnder(n, h)) -> {Ls.above(n, Ls.hkey(h)) == True{} : Bool}:
  match h:
    case None{}:
      {==}
    case Some{x}:
      match x:
        case Ls.Lease{hk, ho}:
          hu

def pl.pick_inv(+n: Nat, q: List<&2, Ls.Waiter>, +lo: Maybe<&2, Nat>, a: Ls.Asc(lo, q), u: pl.Under(n, q)) -> pl.Inv(Ls.L{n, Ls.pick(q), Ls.after(q)}):
  match q:
    case Nil{}:
      (Unit{}, (Unit{}, Unit{}))
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, wo, wl}:
          match wl:
            case True{}:
              (g, at) = a
              (uw, ut) = u
              (at, (ut, uw))
            case False{}:
              (g, at) = a
              (uw, ut) = u
              pl.pick_inv(n, t, Some{wk}, at, ut)

def pl.settle_inv(+n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, a: Ls.Asc(Ls.hkey(h), q), u: pl.Under(n, q), hu: pl.HUnder(n, h)) -> pl.Inv(Ls.settle(n, h, q)):
  match h:
    case None{}:
      pl.pick_inv(n, q, None{}, a, u)
    case Some{x}:
      (a, (u, hu))

def pl.release_inv(hit: Bool, +hk: Nat, +ho: Nat, +j: Nat, +n: Nat, +q: List<&2, Ls.Waiter>, a: Ls.Asc(Some{hk}, q), u: pl.Under(n, q), hu: {Nat.is_lt(hk, n) == True{} : Bool}) -> pl.Inv(Ls.release.holder(hit, Ls.Lease{hk, ho}, j, n, q)):
  match hit:
    case True{}:
      pl.settle_inv(n, None{}, q, pl.asc_none(Some{hk}, q, a), u, Unit{})
    case False{}:
      (pl.asc_drop(Ls.Release{j}, q, Some{hk}, a), (pl.under_drop(Ls.Release{j}, q, n, u), hu))

def pl.crash_inv(hit: Bool, +hk: Nat, +ho: Nat, +p: Nat, +n: Nat, +q: List<&2, Ls.Waiter>, a: Ls.Asc(Some{hk}, q), u: pl.Under(n, q), hu: {Nat.is_lt(hk, n) == True{} : Bool}) -> pl.Inv(Ls.settle(n, Ls.crash.put(hit, Ls.Lease{hk, ho}), Ls.drop(Ls.Crash{p}, q))):
  match hit:
    case True{}:
      pl.settle_inv(n, None{}, Ls.drop(Ls.Crash{p}, q), pl.asc_none(Some{hk}, Ls.drop(Ls.Crash{p}, q), pl.asc_drop(Ls.Crash{p}, q, Some{hk}, a)), pl.under_drop(Ls.Crash{p}, q, n, u), Unit{})
    case False{}:
      (pl.asc_drop(Ls.Crash{p}, q, Some{hk}, a), (pl.under_drop(Ls.Crash{p}, q, n, u), hu))

def pl.inv_ask.go(+p: Nat, +n: Nat, +h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, a: Ls.Asc(Ls.hkey(h), q), uh: Sigma<&2, &2, pl.Under(n, q), _ => pl.HUnder(n, h)>) -> pl.Inv(Ls.settle(1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]))):
  (+u, +hu) = uh
  pl.settle_inv(1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]), pl.asc_snoc(q, Ls.hkey(h), n, p, a, u, pl.h_above(n, h, hu)), pl.under_snoc(q, n, p, u), pl.hunder_succ(n, h, hu))

def pl.inv_ask(+p: Nat, +n: Nat, +h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, inv: pl.Inv(Ls.L{n, h, q})) -> pl.Inv(Ls.settle(1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]))):
  (a, uh) = inv
  pl.inv_ask.go(p, n, h, q, a, uh)

def pl.inv_release(+j: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, inv: pl.Inv(Ls.L{n, h, q})) -> pl.Inv(Ls.release(j, n, h, q)):
  match h:
    case None{}:
      (a, uh) = inv
      (u, hu) = uh
      pl.settle_inv(n, None{}, Ls.drop(Ls.Release{j}, q), pl.asc_drop(Ls.Release{j}, q, None{}, a), pl.under_drop(Ls.Release{j}, q, n, u), Unit{})
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          (a, uh) = inv
          (u, hu) = uh
          pl.release_inv(Nat.is_eq(hk, j), hk, ho, j, n, q, a, u, hu)

def pl.inv_stop(+j: Nat, +n: Nat, +h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, inv: pl.Inv(Ls.L{n, h, q})) -> pl.Inv(Ls.L{n, h, Ls.mark(Ls.Stop{j}, q)}):
  (a, uh) = inv
  (u, hu) = uh
  (pl.asc_mark(Ls.Stop{j}, q, Ls.hkey(h), a), (pl.under_mark(Ls.Stop{j}, q, n, u), hu))

def pl.inv_crash(+p: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, inv: pl.Inv(Ls.L{n, h, q})) -> pl.Inv(Ls.settle(n, Ls.crash.holder(p, h), Ls.drop(Ls.Crash{p}, q))):
  match h:
    case None{}:
      (a, uh) = inv
      (u, hu) = uh
      pl.settle_inv(n, None{}, Ls.drop(Ls.Crash{p}, q), pl.asc_drop(Ls.Crash{p}, q, None{}, a), pl.under_drop(Ls.Crash{p}, q, n, u), Unit{})
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          (a, uh) = inv
          (u, hu) = uh
          pl.crash_inv(Nat.is_eq(ho, p), hk, ho, p, n, q, a, u, hu)

def pl.inv_step(+s: Ls.L, +e: Ls.Ev, inv: pl.Inv(s)) -> pl.Inv(Ls.step(s, e)):
  match s:
    case Ls.L{+n, +h, +q}:
      match e:
        case Ls.Ask{+p}:
          pl.inv_ask(p, n, h, q, inv)
        case Ls.Release{+j}:
          pl.inv_release(j, n, h, q, inv)
        case Ls.Stop{+j}:
          pl.inv_stop(j, n, h, q, inv)
        case Ls.Crash{+p}:
          pl.inv_crash(p, n, h, q, inv)

def pl.inv_go(evs: List<&2, Ls.Ev>, +s: Ls.L, inv: pl.Inv(s)) -> pl.Inv(Ls.go(evs, s)):
  match evs:
    case Nil{}:
      inv
    case +e <> rest:
      pl.inv_go(rest, Ls.step(s, e), pl.inv_step(s, e, inv))

def pl.inv_run(+evs: List<&2, Ls.Ev>) -> pl.Inv(Ls.run(evs)):
  pl.inv_go(evs, Ls.L.empty(), (Unit{}, (Unit{}, Unit{})))

def pl.inv_fifo(+s: Ls.L, inv: pl.Inv(s)) -> Ls.Fifo(s):
  match s:
    case Ls.L{n, h, q}:
      (a, _) = inv
      a

def pl.bounds_up(+l: Nat, +kw: Nat, +kx: Nat, +n: Nat, g: {Nat.is_lt(l, kw) == True{} : Bool}, p: ({Nat.is_lt(kw, kx) == True{} : Bool} & {Nat.is_lt(kx, n) == True{} : Bool})) -> ({Nat.is_lt(l, kx) == True{} : Bool} & {Nat.is_lt(kx, n) == True{} : Bool}):
  (ab, ltn) = p
  (pl.lt_trans(l, kw, kx, g, ab), ltn)

# a waiter is above the bound of its queue, and below the next key
def pl.in_bounds(q: List<&2, Ls.Waiter>, +lo: Maybe<&2, Nat>, +n: Nat, +x: Ls.Waiter, i: Ls.In(x, q), a: Ls.Asc(lo, q), u: pl.Under(n, q)) -> ({Ls.above(Ls.Waiter.key(x), lo) == True{} : Bool} & {Nat.is_lt(Ls.Waiter.key(x), n) == True{} : Bool}):
  match q:
    case Nil{}:
      match i:
    case +w <> +t:
      match lo:
        case None{}:
          match i:
            case Inl{eq}:
              (g, at) = a
              (uw, ut) = u
              %Equal.sym(Ls.Waiter, x, w, eq) : ({True{} == True{} : Bool} & {Nat.is_lt(Ls.Waiter.key(_), n) == True{} : Bool})
              ({==}, uw)
            case Inr{it}:
              (g, at) = a
              (uw, ut) = u
              ({==}, Pair.snd({Ls.above(Ls.Waiter.key(x), Some{Ls.Waiter.key(w)}) == True{} : Bool}, {Nat.is_lt(Ls.Waiter.key(x), n) == True{} : Bool}, pl.in_bounds(t, Some{Ls.Waiter.key(w)}, n, x, it, at, ut)))
        case Some{+l}:
          match i:
            case Inl{eq}:
              (g, at) = a
              (uw, ut) = u
              %Equal.sym(Ls.Waiter, x, w, eq) : ({Nat.is_lt(l, Ls.Waiter.key(_)) == True{} : Bool} & {Nat.is_lt(Ls.Waiter.key(_), n) == True{} : Bool})
              (g, uw)
            case Inr{it}:
              (g, at) = a
              (uw, ut) = u
              pl.bounds_up(l, Ls.Waiter.key(w), Ls.Waiter.key(x), n, g, pl.in_bounds(t, Some{Ls.Waiter.key(w)}, n, x, it, at, ut))

# A stopped waiter never holds
# ----------------------------

# no live waiter of q has key k
def pl.NoLive(+k: Nat, q: List<&2, Ls.Waiter>) -> Type:
  match q:
    case Nil{}:
      Unit
    case +w <> +t:
      (({Ls.Waiter.key(w) == k : Nat} -> {Ls.Waiter.live(w) == False{} : Bool}) & pl.NoLive(k, t))

# k neither holds nor waits live, and every new key is above it
def pl.Gone(+k: Nat, s: Ls.L) -> Type:
  match s:
    case Ls.L{+n, +h, +q}:
      (Ls.NotHeld(k, h) & (pl.NoLive(k, q) & {Nat.is_lt(k, n) == True{} : Bool}))

def pl.kill(+wk: Nat, +k: Nat, +wl: Bool, eq: {wk == k : Nat}) -> {Bool.and(wl, Bool.not(Nat.is_eq(wk, k))) == False{} : Bool}:
  %Equal.sym(Nat, wk, k, eq) : {Bool.and(wl, Bool.not(Nat.is_eq(_, k))) == False{} : Bool}
  %lease.pl.eq_refl(k) : {Bool.and(wl, Bool.not(_)) == False{} : Bool}
  pl.and_false(wl)

# a stop of k leaves no live waiter of k
def pl.mark_kills(+k: Nat, q: List<&2, Ls.Waiter>) -> pl.NoLive(k, Ls.mark(Ls.Stop{k}, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          (eq => pl.kill(wk, k, wl, eq), pl.mark_kills(k, t))

def pl.dead_and(+wl: Bool, +x: Bool, f: {wl == False{} : Bool}) -> {Bool.and(wl, x) == False{} : Bool}:
  %Equal.sym(Bool, wl, False{}, f) : {Bool.and(_, x) == False{} : Bool}
  {==}

def pl.nolive_mark(+e: Ls.Ev, +k: Nat, q: List<&2, Ls.Waiter>, nl: pl.NoLive(k, q)) -> pl.NoLive(k, Ls.mark(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          (f, nt) = nl
          (eq => pl.dead_and(wl, Bool.not(Ls.hits(e, Ls.Waiter{wk, wo, wl})), f(eq)), pl.nolive_mark(e, k, t, nt))

def pl.nolive_put(b: Bool, +k: Nat, +w: Ls.Waiter, +r: List<&2, Ls.Waiter>, f: {Ls.Waiter.key(w) == k : Nat} -> {Ls.Waiter.live(w) == False{} : Bool}, nr: pl.NoLive(k, r)) -> pl.NoLive(k, Ls.drop.put(b, w, r)):
  match b:
    case True{}:
      nr
    case False{}:
      (f, nr)

def pl.nolive_drop(+e: Ls.Ev, +k: Nat, q: List<&2, Ls.Waiter>, nl: pl.NoLive(k, q)) -> pl.NoLive(k, Ls.drop(e, q)):
  match q:
    case Nil{}:
      Unit{}
    case +w <> +t:
      (f, nt) = nl
      pl.nolive_put(Ls.hits(e, w), k, w, Ls.drop(e, t), f, pl.nolive_drop(e, k, t, nt))

def pl.fresh(+k: Nat, +n: Nat, lt: {Nat.is_lt(k, n) == True{} : Bool}, eq: {n == k : Nat}) -> {True{} == False{} : Bool}:
  pl.void({True{} == False{} : Bool}, pl.ne_of_lt(k, n, lt, Equal.sym(Nat, n, k, eq)))

def pl.nolive_snoc(+k: Nat, +n: Nat, +o: Nat, q: List<&2, Ls.Waiter>, nl: pl.NoLive(k, q), lt: {Nat.is_lt(k, n) == True{} : Bool}) -> pl.NoLive(k, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, o, True{}}])):
  match q:
    case Nil{}:
      (eq => pl.fresh(k, n, lt, eq), Unit{})
    case +w <> +t:
      (f, nt) = nl
      (f, pl.nolive_snoc(k, n, o, t, nt, lt))

def pl.pick_gone(+k: Nat, +n: Nat, q: List<&2, Ls.Waiter>, nl: pl.NoLive(k, q), lt: {Nat.is_lt(k, n) == True{} : Bool}) -> pl.Gone(k, Ls.L{n, Ls.pick(q), Ls.after(q)}):
  match q:
    case Nil{}:
      (Unit{}, (Unit{}, lt))
    case w <> +t:
      match w:
        case Ls.Waiter{wk, wo, wl}:
          match wl:
            case True{}:
              (f, nt) = nl
              (eq => lease.pl.absurd(Empty, f(eq)), (nt, lt))
            case False{}:
              (f, nt) = nl
              pl.pick_gone(k, n, t, nt, lt)

def pl.settle_gone(+k: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, nh: Ls.NotHeld(k, h), nl: pl.NoLive(k, q), lt: {Nat.is_lt(k, n) == True{} : Bool}) -> pl.Gone(k, Ls.settle(n, h, q)):
  match h:
    case None{}:
      pl.pick_gone(k, n, q, nl, lt)
    case Some{x}:
      (nh, (nl, lt))

def pl.release_gone(hit: Bool, +hk: Nat, +ho: Nat, +j: Nat, +k: Nat, +n: Nat, +q: List<&2, Ls.Waiter>, nh: Ls.NotHeld(k, Some{Ls.Lease{hk, ho}}), nl: pl.NoLive(k, q), lt: {Nat.is_lt(k, n) == True{} : Bool}) -> pl.Gone(k, Ls.release.holder(hit, Ls.Lease{hk, ho}, j, n, q)):
  match hit:
    case True{}:
      pl.settle_gone(k, n, None{}, q, Unit{}, nl, lt)
    case False{}:
      (nh, (pl.nolive_drop(Ls.Release{j}, k, q, nl), lt))

def pl.crash_gone(hit: Bool, +hk: Nat, +ho: Nat, +k: Nat, nh: Ls.NotHeld(k, Some{Ls.Lease{hk, ho}})) -> Ls.NotHeld(k, Ls.crash.put(hit, Ls.Lease{hk, ho})):
  match hit:
    case True{}:
      Unit{}
    case False{}:
      nh

def pl.crash_notheld(+p: Nat, +k: Nat, h: Maybe<&2, Ls.Lease>, nh: Ls.NotHeld(k, h)) -> Ls.NotHeld(k, Ls.crash.holder(p, h)):
  match h:
    case None{}:
      Unit{}
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          pl.crash_gone(Nat.is_eq(ho, p), hk, ho, k, nh)

def pl.gone_release(+j: Nat, +k: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, g: pl.Gone(k, Ls.L{n, h, q})) -> pl.Gone(k, Ls.release(j, n, h, q)):
  match h:
    case None{}:
      (nh, rest) = g
      (nl, lt) = rest
      pl.settle_gone(k, n, None{}, Ls.drop(Ls.Release{j}, q), Unit{}, pl.nolive_drop(Ls.Release{j}, k, q, nl), lt)
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          (nh, rest) = g
          (nl, lt) = rest
          pl.release_gone(Nat.is_eq(hk, j), hk, ho, j, k, n, q, nh, nl, lt)

def pl.gone_ask(+k: Nat, +n: Nat, +p: Nat, +h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, nh: Ls.NotHeld(k, h), nl: pl.NoLive(k, q), +lt: {Nat.is_lt(k, n) == True{} : Bool}) -> pl.Gone(k, Ls.settle(1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]))):
  pl.settle_gone(k, 1n+n, h, List.append(&2, Ls.Waiter, q, [Ls.Waiter{n, p, True{}}]), nh, pl.nolive_snoc(k, n, p, q, nl, lt), pl.lt_succ(k, n, lt))

def pl.gone_step(+k: Nat, +s: Ls.L, +e: Ls.Ev, g: pl.Gone(k, s)) -> pl.Gone(k, Ls.step(s, e)):
  match s:
    case Ls.L{+n, +h, +q}:
      match e:
        case Ls.Ask{+p}:
          (nh, rest) = g
          (nl, lt) = rest
          pl.gone_ask(k, n, p, h, q, nh, nl, lt)
        case Ls.Release{+j}:
          pl.gone_release(j, k, n, h, q, g)
        case Ls.Stop{+j}:
          (nh, rest) = g
          (nl, lt) = rest
          (nh, (pl.nolive_mark(Ls.Stop{j}, k, q, nl), lt))
        case Ls.Crash{+p}:
          (nh, rest) = g
          (nl, lt) = rest
          pl.settle_gone(k, n, Ls.crash.holder(p, h), Ls.drop(Ls.Crash{p}, q), pl.crash_notheld(p, k, h, nh), pl.nolive_drop(Ls.Crash{p}, k, q, nl), lt)

def pl.gone_go(+k: Nat, evs: List<&2, Ls.Ev>, +s: Ls.L, g: pl.Gone(k, s)) -> pl.Gone(k, Ls.go(evs, s)):
  match evs:
    case Nil{}:
      g
    case +e <> rest:
      pl.gone_go(k, rest, Ls.step(s, e), pl.gone_step(k, s, e, g))

def pl.gone_holder(h: Maybe<&2, Ls.Lease>, +k: Nat, ab: {Ls.above(k, Ls.hkey(h)) == True{} : Bool}) -> Ls.NotHeld(k, h):
  match h:
    case None{}:
      Unit{}
    case Some{x}:
      match x:
        case Ls.Lease{+hk, ho}:
          eq => pl.ne_of_lt(hk, k, ab, eq)

def pl.gone_of(h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, +k: Nat, +n: Nat, p: ({Ls.above(k, Ls.hkey(h)) == True{} : Bool} & {Nat.is_lt(k, n) == True{} : Bool})) -> pl.Gone(k, Ls.L{n, h, Ls.mark(Ls.Stop{k}, q)}):
  (ab, lt) = p
  (pl.gone_holder(h, k, ab), (pl.mark_kills(k, q), lt))

# a stop of a live waiter makes it gone
def pl.gone_start(+s: Ls.L, +k: Nat, +o: Nat, inv: pl.Inv(s), i: Ls.In(Ls.Waiter{k, o, True{}}, Ls.L.queue(s))) -> pl.Gone(k, Ls.step(s, Ls.Stop{k})):
  match s:
    case Ls.L{+n, +h, +q}:
      (a, uh) = inv
      (u, hu) = uh
      pl.gone_of(h, q, k, n, pl.in_bounds(q, Ls.hkey(h), n, Ls.Waiter{k, o, True{}}, i, a, u))

def pl.gone_held(+k: Nat, +s: Ls.L, g: pl.Gone(k, s)) -> Ls.NotHeld(k, Ls.L.holder(s)):
  match s:
    case Ls.L{n, h, q}:
      (nh, _) = g
      nh

# A crash frees its origin
# ------------------------

def pl.none_put(+p: Nat, +wk: Nat, +wo: Nat, +wl: Bool, b: Bool, eb: {Nat.is_eq(wo, p) == b : Bool}, +r: List<&2, Ls.Waiter>, nr: Ls.NoneFrom(p, r)) -> Ls.NoneFrom(p, Ls.drop.put(b, Ls.Waiter{wk, wo, wl}, r)):
  match b:
    case True{}:
      nr
    case False{}:
      (eb, nr)

def pl.none_drop(+p: Nat, q: List<&2, Ls.Waiter>) -> Ls.NoneFrom(p, Ls.drop(Ls.Crash{p}, q)):
  match q:
    case Nil{}:
      Unit{}
    case w <> +t:
      match w:
        case Ls.Waiter{+wk, +wo, +wl}:
          pl.none_put(p, wk, wo, wl, Nat.is_eq(wo, p), {==}, Ls.drop(Ls.Crash{p}, t), pl.none_drop(p, t))

def pl.pick_freed(+p: Nat, +n: Nat, q: List<&2, Ls.Waiter>, nf: Ls.NoneFrom(p, q)) -> Ls.Freed(p, Ls.L{n, Ls.pick(q), Ls.after(q)}):
  match q:
    case Nil{}:
      (Unit{}, Unit{})
    case w <> +t:
      match w:
        case Ls.Waiter{wk, wo, wl}:
          match wl:
            case True{}:
              nf
            case False{}:
              (e, nt) = nf
              pl.pick_freed(p, n, t, nt)

def pl.crash_put(+p: Nat, b: Bool, +hk: Nat, +ho: Nat, eb: {Nat.is_eq(ho, p) == b : Bool}) -> Ls.NotFrom(p, Ls.crash.put(b, Ls.Lease{hk, ho})):
  match b:
    case True{}:
      Unit{}
    case False{}:
      eb

def pl.crash_holder(+p: Nat, h: Maybe<&2, Ls.Lease>) -> Ls.NotFrom(p, Ls.crash.holder(p, h)):
  match h:
    case None{}:
      Unit{}
    case Some{x}:
      match x:
        case Ls.Lease{+hk, +ho}:
          pl.crash_put(p, Nat.is_eq(ho, p), hk, ho, {==})

def pl.settle_freed(+p: Nat, +n: Nat, h: Maybe<&2, Ls.Lease>, +q: List<&2, Ls.Waiter>, nh: Ls.NotFrom(p, h), nq: Ls.NoneFrom(p, q)) -> Ls.Freed(p, Ls.settle(n, h, q)):
  match h:
    case None{}:
      pl.pick_freed(p, n, q, nq)
    case Some{x}:
      (nh, nq)

# The laws
# --------

def lease_fifo(+evs: List<&2, Ls.Ev>) -> Ls.Fifo(Ls.run(evs)):
  pl.inv_fifo(Ls.run(evs), pl.inv_run(evs))

def lease_never_idle(+evs: List<&2, Ls.Ev>) -> Ls.Busy(Ls.run(evs)):
  pl.busy_go(evs, Ls.L.empty(), Unit{})

def lease_keeps_waiters(+s: Ls.L, +e: Ls.Ev, +k: Nat, +o: Nat, waits: Ls.In(Ls.Waiter{k, o, True{}}, Ls.L.queue(s)), other: {Ls.hits(e, Ls.Waiter{k, o, True{}}) == False{} : Bool}) -> Ls.Kept(k, o, Ls.step(s, e)):
  pl.keeps(s, e, k, o, waits, other)

def lease_stop_never_holds(+evs: List<&2, Ls.Ev>, +k: Nat, +o: Nat, +rest: List<&2, Ls.Ev>, waits: Ls.In(Ls.Waiter{k, o, True{}}, Ls.L.queue(Ls.run(evs)))) -> Ls.NotHeld(k, Ls.L.holder(Ls.go(rest, Ls.step(Ls.run(evs), Ls.Stop{k})))):
  +s = Ls.step(Ls.run(evs), Ls.Stop{k})
  pl.gone_held(k, Ls.go(rest, s), pl.gone_go(k, rest, s, pl.gone_start(Ls.run(evs), k, o, pl.inv_run(evs), waits)))

def lease_crash_frees(+s: Ls.L, +p: Nat) -> Ls.Freed(p, Ls.step(s, Ls.Crash{p})):
  match s:
    case Ls.L{+n, h, +q}:
      pl.settle_freed(p, n, Ls.crash.holder(p, h), Ls.drop(Ls.Crash{p}, q), pl.crash_holder(p, h), pl.none_drop(p, q))

# ---- child ----

# proof_child: the H5 laws of LAWS.bend (bend/child.bend, the life of one
# subagent).
#
# - The watch: a quiet poll takes 1 ms or more off the clock (`left`) and
#   a failed one a try (`tries`), so a run of them as long as the clock
#   ends the watch (`stalls_in_time`, `unreachable_in_time`); a clock
#   never grows past its full size (`clock_bounded`); progress sets it
#   back to full (`progress_is_not_a_stall`).
# - The report: an invariant `K` holds after any events: every submission
#   in the parent's inbox but the newest is withdrawn, under an id below
#   it (`Kin`), and the task owes the newest id, or the next one once the
#   newest is withdrawn (`Kowe`). Only the newest may be live, which gives
#   `one_live` and `report_once`; a delivery or withdrawal touches only the
#   newest. From any state that owes the report, a reopen and two task
#   steps (three when an abort mark is pending) leave the report queued
#   under the owed id or placed (`ready`), and a delivery of that id
#   places it (`delivered_once`). A potential (1 plus the withdrawn
#   submissions) bounds the inbox and grows only at a withdrawal
#   (`resubmits_per_abort`).

# Logic
# -----

def child.pc.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def child.pc.absurd(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : child.pc.BD(_, A, Unit)
  Unit{}

def pc.and_l(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      child.pc.absurd({False{} == True{} : Bool}, e)

def pc.and_r(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      e
    case False{}:
      child.pc.absurd({b == True{} : Bool}, e)

def pc.and_in(a: Bool, -b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      eb
    case False{}:
      child.pc.absurd({Bool.and(False{}, b) == True{} : Bool}, ea)

# Numbers
# -------

def child.pc.eq_refl(+a: Nat) -> {Nat.is_eq(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      child.pc.eq_refl(p)

def pc.eq_succ(+a: Nat) -> {Nat.is_eq(1n+a, a) == False{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      pc.eq_succ(p)

def child.pc.eq_of(+a: Nat, +b: Nat, e: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      child.pc.absurd({0n == 1n+q : Nat}, e)
    case 1n+p 0n:
      child.pc.absurd({1n+p == 0n : Nat}, e)
    case 1n+p 1n+q:
      %child.pc.eq_of(p, q, e) : {1n+p == 1n+_ : Nat}
      {==}

def child.pc.le_zero(+b: Nat) -> {Nat.is_le(0n, b) == True{} : Bool}:
  match b:
    case 0n:
      {==}
    case 1n+q:
      {==}

def child.pc.le_refl(+a: Nat) -> {Nat.is_le(a, a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      child.pc.le_refl(p)

def pc.le_of_eq(+a: Nat, +b: Nat, e: {Nat.is_eq(a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      child.pc.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pc.le_of_eq(p, q, e)

def pc.le_succ(+a: Nat, +b: Nat, e: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n b:
      {==}
    case 1n+p 0n:
      child.pc.absurd({Nat.is_le(1n+p, 1n) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pc.le_succ(p, q, e)

def pc.le_pred(+a: Nat, +b: Nat, e: {Nat.is_le(1n+a, b) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  match a b:
    case 0n b:
      child.pc.le_zero(b)
    case 1n+p 0n:
      child.pc.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, e)
    case 1n+p 1n+q:
      pc.le_pred(p, q, e)

def child.pc.le_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) -> {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n b c:
      child.pc.le_zero(c)
    case 1n+p 0n c:
      child.pc.absurd({Nat.is_le(1n+p, c) == True{} : Bool}, ab)
    case 1n+p 1n+q 0n:
      child.pc.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, bc)
    case 1n+p 1n+q 1n+r:
      child.pc.le_trans(p, q, r, ab, bc)

def pc.sub_le(+a: Nat, +d: Nat) -> {Nat.is_le(Nat.sub(a, d), a) == True{} : Bool}:
  match a d:
    case 0n d:
      {==}
    case 1n+p 0n:
      child.pc.le_refl(p)
    case 1n+p 1n+e:
      pc.le_succ(Nat.sub(p, e), p, pc.sub_le(p, e))

def child.pc.le_add(+c: Nat, +x: Nat) -> {Nat.is_le(x, Nat.add(c, x)) == True{} : Bool}:
  match c:
    case 0n:
      child.pc.le_refl(x)
    case 1n+p:
      pc.le_succ(x, Nat.add(p, x), child.pc.le_add(p, x))

def pc.le_add_mono(+a: Nat, +x: Nat, +y: Nat, e: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(Nat.add(a, x), Nat.add(a, y)) == True{} : Bool}:
  match a:
    case 0n:
      e
    case 1n+p:
      pc.le_add_mono(p, x, y, e)

def pc.add_assoc(+a: Nat, -b: Nat, -c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %pc.add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

# The watch
# ---------

# an owed report stays owed through any more polls
def pc.owe_stops(hs: List<&2, Ch.Hush>, +cfg: Ch.Cfg, +k: Ch.Report) -> {Ch.Next.watching(Ch.hush(hs, cfg, Ch.Owe{k})) == False{} : Bool}:
  match hs:
    case Nil{}:
      {==}
    case h <> t:
      pc.owe_stops(t, cfg, k)

# the token the watch holds is no progress
def pc.moved_self(+tok: Maybe<&2, Nat>) -> {False{} == Ch.moved(tok, tok) : Bool}:
  match tok:
    case None{}:
      {==}
    case Some{+x}:
      %Equal.sym(Bool, Nat.is_eq(x, x), True{}, child.pc.eq_refl(x)) : {False{} == Bool.not(_) : Bool}
      {==}

# from the clock spend(r, tok, n), quiet polls hs, at least r of them,
# end the watch: each takes 1 ms or more off the r ms left
def pc.stall(hs: List<&2, Ch.Hush>, +cfg: Ch.Cfg, +r: Nat, +tok: Maybe<&2, Nat>, +n: Nat, long: {Nat.is_le(r, List.length(&2, Ch.Hush, hs)) == True{} : Bool}) -> {Ch.Next.watching(Ch.hush(hs, cfg, Ch.spend(r, tok, n))) == False{} : Bool}:
  match hs:
    case Nil{}:
      match r:
        case 0n:
          {==}
        case 1n+p:
          child.pc.absurd({Ch.Next.watching(Ch.hush(Nil{}, cfg, Ch.spend(1n+p, tok, n))) == False{} : Bool}, long)
    case h <> +t:
      match h:
        case Ch.Same{+dt}:
          match r:
            case 0n:
              pc.owe_stops(t, cfg, Ch.Stalled{})
            case 1n+p:
              %pc.moved_self(tok) : {Ch.Next.watching(Ch.hush(t, cfg, Ch.busy(_, cfg, Ch.W{tok, 1n+p, n}, tok, 1n+dt))) == False{} : Bool}
              pc.stall(t, cfg, Nat.sub(p, dt), tok, Ch.Cfg.fails(cfg), child.pc.le_trans(Nat.sub(p, dt), p, List.length(&2, Ch.Hush, t), pc.sub_le(p, dt), long))
        case Ch.Miss{+dt}:
          match r:
            case 0n:
              pc.owe_stops(t, cfg, Ch.Stalled{})
            case 1n+p:
              match n:
                case 0n:
                  pc.owe_stops(t, cfg, Ch.Unreachable{})
                case 1n+q:
                  match q:
                    case 0n:
                      pc.owe_stops(t, cfg, Ch.Unreachable{})
                    case 1n+u:
                      pc.stall(t, cfg, Nat.sub(p, dt), tok, 1n+u, child.pc.le_trans(Nat.sub(p, dt), p, List.length(&2, Ch.Hush, t), pc.sub_le(p, dt), long))

# a clock with nothing left ends at the next quiet poll
def pc.spent(h: Ch.Hush, hs: List<&2, Ch.Hush>, +cfg: Ch.Cfg, +tok: Maybe<&2, Nat>, +n: Nat) -> {Ch.Next.watching(Ch.hush(h <> hs, cfg, Ch.Watch{Ch.W{tok, 0n, n}})) == False{} : Bool}:
  match h:
    case Ch.Same{+dt}:
      %pc.moved_self(tok) : {Ch.Next.watching(Ch.hush(hs, cfg, Ch.busy(_, cfg, Ch.W{tok, 0n, n}, tok, 1n+dt))) == False{} : Bool}
      pc.owe_stops(hs, cfg, Ch.Stalled{})
    case Ch.Miss{+dt}:
      match n:
        case 0n:
          pc.owe_stops(hs, cfg, Ch.Unreachable{})
        case 1n+q:
          match q:
            case 0n:
              pc.owe_stops(hs, cfg, Ch.Unreachable{})
            case 1n+u:
              pc.owe_stops(hs, cfg, Ch.Stalled{})

def pc.stalls_in_time(+cfg: Ch.Cfg, +w: Ch.W, +h: Ch.Hush, +hs: List<&2, Ch.Hush>, long: {Nat.is_le(Ch.W.left(w), List.length(&2, Ch.Hush, h <> hs)) == True{} : Bool}) -> {Ch.Next.watching(Ch.hush(h <> hs, cfg, Ch.Watch{w})) == False{} : Bool}:
  match w:
    case Ch.W{+tok, +l, +n}:
      match l:
        case 0n:
          pc.spent(h, hs, cfg, tok, n)
        case 1n+p:
          pc.stall(h <> hs, cfg, 1n+p, tok, n, long)

# from the clock spend(r, tok, 1 + q), failed polls ds, more than q of
# them, end the watch
def pc.miss(ds: List<&2, Nat>, +cfg: Ch.Cfg, +r: Nat, +tok: Maybe<&2, Nat>, +q: Nat, long: {Nat.is_le(1n+q, List.length(&2, Nat, ds)) == True{} : Bool}) -> {Ch.Next.watching(Ch.hush(Ch.misses(ds), cfg, Ch.spend(r, tok, 1n+q))) == False{} : Bool}:
  match ds:
    case Nil{}:
      child.pc.absurd({Ch.Next.watching(Ch.hush(Nil{}, cfg, Ch.spend(r, tok, 1n+q))) == False{} : Bool}, long)
    case +d <> +t:
      match r:
        case 0n:
          pc.owe_stops(Ch.misses(d <> t), cfg, Ch.Stalled{})
        case 1n+p:
          match q:
            case 0n:
              pc.owe_stops(Ch.misses(t), cfg, Ch.Unreachable{})
            case 1n+u:
              pc.miss(t, cfg, Nat.sub(p, d), tok, u, long)

def pc.unreachable_in_time(+cfg: Ch.Cfg, +w: Ch.W, +d: Nat, +ds: List<&2, Nat>, long: {Nat.is_le(Ch.W.tries(w), List.length(&2, Nat, d <> ds)) == True{} : Bool}) -> {Ch.Next.watching(Ch.hush(Ch.misses(d <> ds), cfg, Ch.Watch{w})) == False{} : Bool}:
  match w:
    case Ch.W{+tok, +l, +n}:
      match n:
        case 0n:
          pc.owe_stops(Ch.misses(ds), cfg, Ch.Unreachable{})
        case 1n+q:
          match q:
            case 0n:
              pc.owe_stops(Ch.misses(ds), cfg, Ch.Unreachable{})
            case 1n+u:
              pc.miss(ds, cfg, Nat.sub(l, 1n+d), tok, u, long)

def pc.spend_within(+cfg: Ch.Cfg, +r: Nat, +tok: Maybe<&2, Nat>, +n: Nat, er: {Nat.is_le(r, Ch.Cfg.stall(cfg)) == True{} : Bool}, en: {Nat.is_le(n, Ch.Cfg.fails(cfg)) == True{} : Bool}) -> {Ch.within(cfg, Ch.spend(r, tok, n)) == True{} : Bool}:
  match r:
    case 0n:
      {==}
    case 1n+p:
      pc.and_in(Nat.is_le(1n+p, Ch.Cfg.stall(cfg)), Nat.is_le(n, Ch.Cfg.fails(cfg)), er, en)

def pc.busy_within(b: Bool, +cfg: Ch.Cfg, +w: Ch.W, +t: Maybe<&2, Nat>, +e: Nat, full: {Ch.within(cfg, Ch.Watch{w}) == True{} : Bool}) -> {Ch.within(cfg, Ch.busy(b, cfg, w, t, e)) == True{} : Bool}:
  match b:
    case True{}:
      pc.and_in(Nat.is_le(Ch.Cfg.stall(cfg), Ch.Cfg.stall(cfg)), Nat.is_le(Ch.Cfg.fails(cfg), Ch.Cfg.fails(cfg)), child.pc.le_refl(Ch.Cfg.stall(cfg)), child.pc.le_refl(Ch.Cfg.fails(cfg)))
    case False{}:
      match w:
        case Ch.W{+tok, +l, +n}:
          pc.spend_within(cfg, Nat.sub(l, e), tok, Ch.Cfg.fails(cfg), child.pc.le_trans(Nat.sub(l, e), l, Ch.Cfg.stall(cfg), pc.sub_le(l, e), pc.and_l(Nat.is_le(l, Ch.Cfg.stall(cfg)), Nat.is_le(n, Ch.Cfg.fails(cfg)), full)), child.pc.le_refl(Ch.Cfg.fails(cfg)))

def pc.look_within(o: Ch.Obs, +cfg: Ch.Cfg, +w: Ch.W, +e: Nat, +full: {Ch.within(cfg, Ch.Watch{w}) == True{} : Bool}) -> {Ch.within(cfg, Ch.look(cfg, w, e, o)) == True{} : Bool}:
  match o:
    case Ch.Busy{+t}:
      pc.busy_within(Ch.moved(Ch.W.tok(w), t), cfg, w, t, e, full)
    case Ch.Lost{}:
      match w:
        case Ch.W{+tok, +l, +n}:
          match n:
            case 0n:
              {==}
            case 1n+q:
              match q:
                case 0n:
                  {==}
                case 1n+u:
                  pc.spend_within(cfg, Nat.sub(l, e), tok, 1n+u, child.pc.le_trans(Nat.sub(l, e), l, Ch.Cfg.stall(cfg), pc.sub_le(l, e), pc.and_l(Nat.is_le(l, Ch.Cfg.stall(cfg)), Nat.is_le(2n+u, Ch.Cfg.fails(cfg)), full)), pc.le_pred(1n+u, Ch.Cfg.fails(cfg), pc.and_r(Nat.is_le(l, Ch.Cfg.stall(cfg)), Nat.is_le(2n+u, Ch.Cfg.fails(cfg)), full)))
    case Ch.Answered{r}:
      match r:
        case True{}:
          {==}
        case False{}:
          {==}
    case Ch.Broke{}:
      {==}
    case Ch.Gone{}:
      {==}

def pc.clock_bounded(+cfg: Ch.Cfg, +w: Ch.W, +e: Nat, o: Ch.Obs, full: {Ch.within(cfg, Ch.Watch{w}) == True{} : Bool}) -> {Ch.within(cfg, Ch.look(cfg, w, e, o)) == True{} : Bool}:
  pc.look_within(o, cfg, w, e, full)

def pc.progress_is_not_a_stall(+cfg: Ch.Cfg, +w: Ch.W, +e: Nat, +x: Nat, news: {Ch.moved(Ch.W.tok(w), Some{x}) == True{} : Bool}) -> {Ch.look(cfg, w, e, Ch.Busy{Some{x}}) == Ch.Watch{Ch.W.fresh(cfg, Some{x})} : Ch.Next}:
  %Equal.sym(Bool, Ch.moved(Ch.W.tok(w), Some{x}), True{}, news) : {Ch.busy(_, cfg, w, Some{x}, e) == Ch.Watch{Ch.W.fresh(cfg, Some{x})} : Ch.Next}
  {==}

# The report
# ----------

# a clash of constructors proves anything
def child.pc.MD(x: Maybe<&2, Ch.Fate>, t: Type, u: Type) -> Type:
  match x:
    case None{}:
      t
    case Some{f}:
      u

def pc.none_some(-A: Type, -f: Ch.Fate, e: {None{} == Some{f} : Maybe<&2, Ch.Fate>}) -> A:
  %e : child.pc.MD(_, Unit, A)
  Unit{}

def child.pc.ND(n: Nat, t: Type, u: Type) -> Type:
  match n:
    case 0n:
      t
    case 1n+p:
      u

def pc.zero_succ(-A: Type, -p: Nat, e: {0n == 1n+p : Nat}) -> A:
  %e : child.pc.ND(_, Unit, A)
  Unit{}

# x is 0 and 1 at once
def pc.one_zero(-A: Type, x: Nat, e: {0n == x : Nat}, r: {Nat.is_eq(x, 1n) == True{} : Bool}) -> A:
  match x:
    case 0n:
      child.pc.absurd(A, r)
    case 1n+p:
      pc.zero_succ(A, p, e)

# j < n and j = n at once
def pc.lt_ne(-A: Type, +j: Nat, +n: Nat, lt: {Nat.is_le(1n+j, n) == True{} : Bool}, eq: {Nat.is_eq(j, n) == True{} : Bool}) -> A:
  match j n:
    case 0n 0n:
      child.pc.absurd(A, lt)
    case 0n 1n+q:
      child.pc.absurd(A, eq)
    case 1n+p 0n:
      child.pc.absurd(A, eq)
    case 1n+p 1n+q:
      pc.lt_ne(A, p, q, lt, eq)

def pc.eq_next(+m: Nat, +n: Nat, e: {Nat.is_eq(m, n) == True{} : Bool}) -> {Nat.is_eq(m, 1n+n) == False{} : Bool}:
  match m n:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      child.pc.absurd({Nat.is_eq(0n, 2n+q) == False{} : Bool}, e)
    case 1n+p 0n:
      child.pc.absurd({Nat.is_eq(1n+p, 1n) == False{} : Bool}, e)
    case 1n+p 1n+q:
      pc.eq_next(p, q, e)

def pc.isW(f: Ch.Fate) -> Bool:
  match f:
    case Ch.Queued{}:
      False{}
    case Ch.Withdrawn{}:
      True{}
    case Ch.Placed{}:
      False{}

def pc.empty(inbox: List<&2, Ch.Sub>) -> Bool:
  match inbox:
    case Nil{}:
      True{}
    case s <> rest:
      False{}

# every submission in rest is withdrawn, under an id below m (newest
# first)
def pc.Old(rest: List<&2, Ch.Sub>, +m: Nat) -> Bool:
  match rest:
    case Nil{}:
      True{}
    case s <> r:
      match s:
        case Ch.Sub{+j, f}:
          Bool.and(pc.isW(f), Bool.and(Nat.is_le(1n+j, m), pc.Old(r, j)))

# every submission but the newest is withdrawn
def pc.Kin(inbox: List<&2, Ch.Sub>) -> Bool:
  match inbox:
    case Nil{}:
      True{}
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          pc.Old(rest, m)

# owing id n: the newest submission has id n (same), or id n - 1 and is
# withdrawn
def pc.Kowe.at(same: Bool, +n: Nat, +m: Nat, f: Ch.Fate) -> Bool:
  match same:
    case True{}:
      True{}
    case False{}:
      Bool.and(Nat.is_eq(1n+m, n), pc.isW(f))

# owing id n: no submission yet (and n is 1), or as Kowe.at
def pc.Kowe(inbox: List<&2, Ch.Sub>, +n: Nat) -> Bool:
  match inbox:
    case Nil{}:
      Nat.is_eq(n, 1n)
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          pc.Kowe.at(Nat.is_eq(m, n), n, m, f)

def pc.Kph(ph: Ch.Ph, inbox: List<&2, Ch.Sub>) -> Bool:
  match ph:
    case Ch.Watching{w}:
      pc.empty(inbox)
    case Ch.Owing{k, +n}:
      pc.Kowe(inbox, n)
    case Ch.Ended{}:
      True{}

def pc.K(s: Ch.St) -> Bool:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      Bool.and(pc.Kph(ph, inbox), pc.Kin(inbox))

def pc.Kin_of(s: Ch.St, k: {pc.K(s) == True{} : Bool}) -> {pc.Kin(Ch.St.inbox(s)) == True{} : Bool}:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k)

# the parts of Old(Sub{j, f} <> r, m)
def pc.old_head(+f: Ch.Fate, +j: Nat, +m: Nat, +r: List<&2, Ch.Sub>, o: {pc.Old(Ch.Sub{j, f} <> r, m) == True{} : Bool}) -> {pc.isW(f) == True{} : Bool}:
  pc.and_l(pc.isW(f), Bool.and(Nat.is_le(1n+j, m), pc.Old(r, j)), o)

def pc.old_lt(+f: Ch.Fate, +j: Nat, +m: Nat, +r: List<&2, Ch.Sub>, o: {pc.Old(Ch.Sub{j, f} <> r, m) == True{} : Bool}) -> {Nat.is_le(1n+j, m) == True{} : Bool}:
  pc.and_l(Nat.is_le(1n+j, m), pc.Old(r, j), pc.and_r(pc.isW(f), Bool.and(Nat.is_le(1n+j, m), pc.Old(r, j)), o))

def pc.old_tail(+f: Ch.Fate, +j: Nat, +m: Nat, +r: List<&2, Ch.Sub>, o: {pc.Old(Ch.Sub{j, f} <> r, m) == True{} : Bool}) -> {pc.Old(r, j) == True{} : Bool}:
  pc.and_r(Nat.is_le(1n+j, m), pc.Old(r, j), pc.and_r(pc.isW(f), Bool.and(Nat.is_le(1n+j, m), pc.Old(r, j)), o))

# no submission in an old list has an id m or above
def pc.old_none.at(same: Bool, +j: Nat, +n: Nat, -f: Ch.Fate, -r: List<&2, Ch.Sub>, eb: {Nat.is_eq(j, n) == same : Bool}, lt: {Nat.is_le(1n+j, n) == True{} : Bool}, ih: {None{} == Ch.fate(r, n) : Maybe<&2, Ch.Fate>}) -> {None{} == Maybe.or(&2, Ch.Fate, Ch.fate.here(same, f), Ch.fate(r, n)) : Maybe<&2, Ch.Fate>}:
  match same:
    case True{}:
      pc.lt_ne({None{} == Some{f} : Maybe<&2, Ch.Fate>}, j, n, lt, eb)
    case False{}:
      ih

def pc.old_none(rest: List<&2, Ch.Sub>, +m: Nat, +n: Nat, +o: {pc.Old(rest, m) == True{} : Bool}, +le: {Nat.is_le(m, n) == True{} : Bool}) -> {None{} == Ch.fate(rest, n) : Maybe<&2, Ch.Fate>}:
  match rest:
    case Nil{}:
      {==}
    case s <> +r:
      match s:
        case Ch.Sub{+j, +f}:
          pc.old_none.at(Nat.is_eq(j, n), j, n, f, r, {==}, child.pc.le_trans(1n+j, m, n, pc.old_lt(f, j, m, r, o), le), pc.old_none(r, j, n, pc.old_tail(f, j, m, r, o), pc.le_pred(j, n, child.pc.le_trans(1n+j, m, n, pc.old_lt(f, j, m, r, o), le))))

# no submission in an old list is placed or live
def pc.old_placed(rest: List<&2, Ch.Sub>, +m: Nat, o: {pc.Old(rest, m) == True{} : Bool}) -> {0n == Ch.placed(rest) : Nat}:
  match rest:
    case Nil{}:
      {==}
    case s <> r:
      match s:
        case Ch.Sub{+j, f}:
          match f:
            case Ch.Queued{}:
              child.pc.absurd({0n == Ch.placed(Ch.Sub{j, Ch.Queued{}} <> r) : Nat}, o)
            case Ch.Withdrawn{}:
              pc.old_placed(r, j, pc.and_r(Nat.is_le(1n+j, m), pc.Old(r, j), o))
            case Ch.Placed{}:
              child.pc.absurd({0n == Ch.placed(Ch.Sub{j, Ch.Placed{}} <> r) : Nat}, o)

def pc.old_live(rest: List<&2, Ch.Sub>, +m: Nat, o: {pc.Old(rest, m) == True{} : Bool}) -> {0n == Ch.live(rest) : Nat}:
  match rest:
    case Nil{}:
      {==}
    case s <> r:
      match s:
        case Ch.Sub{+j, f}:
          match f:
            case Ch.Queued{}:
              child.pc.absurd({0n == Ch.live(Ch.Sub{j, Ch.Queued{}} <> r) : Nat}, o)
            case Ch.Withdrawn{}:
              pc.old_live(r, j, pc.and_r(Nat.is_le(1n+j, m), pc.Old(r, j), o))
            case Ch.Placed{}:
              child.pc.absurd({0n == Ch.live(Ch.Sub{j, Ch.Placed{}} <> r) : Nat}, o)

# a delivery or withdrawal leaves a withdrawn submission withdrawn
def pc.isW_act(f: Ch.Fate, +a: Ch.Act, +i: Nat, w: {pc.isW(f) == True{} : Bool}) -> {pc.isW(Ch.Fate.act(a, i, f)) == True{} : Bool}:
  match f:
    case Ch.Queued{}:
      child.pc.absurd({pc.isW(Ch.Fate.act(a, i, Ch.Queued{})) == True{} : Bool}, w)
    case Ch.Withdrawn{}:
      {==}
    case Ch.Placed{}:
      child.pc.absurd({pc.isW(Ch.Fate.act(a, i, Ch.Placed{})) == True{} : Bool}, w)

def pc.old_act(rest: List<&2, Ch.Sub>, +m: Nat, +a: Ch.Act, +o: {pc.Old(rest, m) == True{} : Bool}) -> {pc.Old(Ch.act(rest, a), m) == True{} : Bool}:
  match rest:
    case Nil{}:
      {==}
    case s <> +r:
      match s:
        case Ch.Sub{+j, +f}:
          pc.and_in(pc.isW(Ch.Fate.act(a, j, f)), Bool.and(Nat.is_le(1n+j, m), pc.Old(Ch.act(r, a), j)), pc.isW_act(f, a, j, pc.old_head(f, j, m, r, o)), pc.and_in(Nat.is_le(1n+j, m), pc.Old(Ch.act(r, a), j), pc.old_lt(f, j, m, r, o), pc.old_act(r, j, a, pc.old_tail(f, j, m, r, o))))

# ... and leaves an old list as it is
def pc.act_eq(rest: List<&2, Ch.Sub>, +m: Nat, +a: Ch.Act, o: {pc.Old(rest, m) == True{} : Bool}) -> {rest == Ch.act(rest, a) : List<&2, Ch.Sub>}:
  match rest:
    case Nil{}:
      {==}
    case s <> r:
      match s:
        case Ch.Sub{+j, f}:
          match f:
            case Ch.Queued{}:
              child.pc.absurd({Ch.Sub{j, Ch.Queued{}} <> r == Ch.act(Ch.Sub{j, Ch.Queued{}} <> r, a) : List<&2, Ch.Sub>}, o)
            case Ch.Withdrawn{}:
              %pc.act_eq(r, j, a, pc.and_r(Nat.is_le(1n+j, m), pc.Old(r, j), o)) : {Ch.Sub{j, Ch.Withdrawn{}} <> r == Ch.Sub{j, Ch.Withdrawn{}} <> _ : List<&2, Ch.Sub>}
              {==}
            case Ch.Placed{}:
              child.pc.absurd({Ch.Sub{j, Ch.Placed{}} <> r == Ch.act(Ch.Sub{j, Ch.Placed{}} <> r, a) : List<&2, Ch.Sub>}, o)

# The invariant K

def pc.kat(same: Bool, +n: Nat, +m: Nat, -f: Ch.Fate, e: {same == True{} : Bool}) -> {pc.Kowe.at(same, n, m, f) == True{} : Bool}:
  match same:
    case True{}:
      {==}
    case False{}:
      child.pc.absurd({pc.Kowe.at(False{}, n, m, f) == True{} : Bool}, e)

# after the newest submission n is withdrawn, the task owes n + 1
def pc.kat_w(same: Bool, +m: Nat, +n: Nat, e: {Nat.is_eq(m, n) == True{} : Bool}) -> {pc.Kowe.at(same, 1n+n, m, Ch.Withdrawn{}) == True{} : Bool}:
  match same:
    case True{}:
      {==}
    case False{}:
      pc.and_in(Nat.is_eq(1n+m, 1n+n), True{}, e, {==})

def pc.kat_act(same: Bool, +n: Nat, +m: Nat, +f: Ch.Fate, +a: Ch.Act, +k: {pc.Kowe.at(same, n, m, f) == True{} : Bool}) -> {pc.Kowe.at(same, n, m, Ch.Fate.act(a, m, f)) == True{} : Bool}:
  match same:
    case True{}:
      {==}
    case False{}:
      pc.and_in(Nat.is_eq(1n+m, n), pc.isW(Ch.Fate.act(a, m, f)), pc.and_l(Nat.is_eq(1n+m, n), pc.isW(f), k), pc.isW_act(f, a, m, pc.and_r(Nat.is_eq(1n+m, n), pc.isW(f), k)))

# the watch hands on no submission
def pc.Kph_watched(x: Ch.Next) -> {pc.Kph(Ch.watched(x), Nil{}) == True{} : Bool}:
  match x:
    case Ch.Watch{w}:
      {==}
    case Ch.Owe{k}:
      {==}
    case Ch.Quiet{}:
      {==}

# the first submission
def pc.K_new0(open: Bool, +kr: Ch.Report, +n: Nat, kph: {Nat.is_eq(n, 1n) == True{} : Bool}) -> {pc.K(Ch.owe.new(open, kr, n, Nil{})) == True{} : Bool}:
  match open:
    case True{}:
      pc.and_in(pc.Kowe.at(Nat.is_eq(n, n), n, n, Ch.Queued{}), True{}, pc.kat(Nat.is_eq(n, n), n, n, Ch.Queued{}, child.pc.eq_refl(n)), {==})
    case False{}:
      pc.and_in(Nat.is_eq(n, 1n), True{}, kph, {==})

# a submission after the withdrawn one m
def pc.K_new(open: Bool, +kr: Ch.Report, +n: Nat, +m: Nat, +f: Ch.Fate, +rest: List<&2, Ch.Sub>, +kph: {Bool.and(Nat.is_eq(1n+m, n), pc.isW(f)) == True{} : Bool}, kph0: {pc.Kowe.at(Nat.is_eq(m, n), n, m, f) == True{} : Bool}, kin: {pc.Old(rest, m) == True{} : Bool}) -> {pc.K(Ch.owe.new(open, kr, n, Ch.Sub{m, f} <> rest)) == True{} : Bool}:
  match open:
    case True{}:
      pc.and_in(pc.Kowe.at(Nat.is_eq(n, n), n, n, Ch.Queued{}), pc.Old(Ch.Sub{m, f} <> rest, n), pc.kat(Nat.is_eq(n, n), n, n, Ch.Queued{}, child.pc.eq_refl(n)), pc.and_in(pc.isW(f), Bool.and(Nat.is_le(1n+m, n), pc.Old(rest, m)), pc.and_r(Nat.is_eq(1n+m, n), pc.isW(f), kph), pc.and_in(Nat.is_le(1n+m, n), pc.Old(rest, m), pc.le_of_eq(1n+m, n, pc.and_l(Nat.is_eq(1n+m, n), pc.isW(f), kph)), kin)))
    case False{}:
      pc.and_in(pc.Kowe.at(Nat.is_eq(m, n), n, m, f), pc.Old(rest, m), kph0, kin)

# the report rule on the newest submission m (same: m is the owed id n)
def pc.K_owe.at(same: Bool, +kr: Ch.Report, +n: Nat, +m: Nat, f: Ch.Fate, +rest: List<&2, Ch.Sub>, +open: Bool, eb: {Nat.is_eq(m, n) == same : Bool}, +kph: {pc.Kowe.at(same, n, m, f) == True{} : Bool}, +kph0: {pc.Kowe.at(Nat.is_eq(m, n), n, m, f) == True{} : Bool}, +kin: {pc.Old(rest, m) == True{} : Bool}) -> {pc.K(Ch.owe(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, f), Ch.fate(rest, n)), kr, n, open, Ch.Sub{m, f} <> rest)) == True{} : Bool}:
  match same:
    case True{}:
      match f:
        case Ch.Queued{}:
          pc.and_in(pc.Kowe.at(Nat.is_eq(m, n), n, m, Ch.Queued{}), pc.Old(rest, m), kph0, kin)
        case Ch.Withdrawn{}:
          pc.and_in(pc.Kowe.at(Nat.is_eq(m, 1n+n), 1n+n, m, Ch.Withdrawn{}), pc.Old(rest, m), pc.kat_w(Nat.is_eq(m, 1n+n), m, n, eb), kin)
        case Ch.Placed{}:
          kin
    case False{}:
      %pc.old_none(rest, m, n, kin, pc.le_pred(m, n, pc.le_of_eq(1n+m, n, pc.and_l(Nat.is_eq(1n+m, n), pc.isW(f), kph)))) : {pc.K(Ch.owe(_, kr, n, open, Ch.Sub{m, f} <> rest)) == True{} : Bool}
      pc.K_new(open, kr, n, m, f, rest, kph, kph0, kin)

# the report rule keeps K
def pc.K_owe(inbox: List<&2, Ch.Sub>, +kr: Ch.Report, +n: Nat, +open: Bool, +kph: {pc.Kowe(inbox, n) == True{} : Bool}, kin: {pc.Kin(inbox) == True{} : Bool}) -> {pc.K(Ch.owe(Ch.fate(inbox, n), kr, n, open, inbox)) == True{} : Bool}:
  match inbox:
    case Nil{}:
      pc.K_new0(open, kr, n, kph)
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          pc.K_owe.at(Nat.is_eq(m, n), kr, n, m, f, rest, open, {==}, kph, kph, kin)

# the abort keeps K: a delete of a watched child owes report 1, which has
# no submission yet
def pc.K_cut(ph: Ch.Ph, del: Bool, +inbox: List<&2, Ch.Sub>, +open: Bool, kph: {pc.Kph(ph, inbox) == True{} : Bool}, kin: {pc.Kin(inbox) == True{} : Bool}) -> {pc.K(Ch.St{Ch.cut.ph(ph, del), None{}, open, inbox}) == True{} : Bool}:
  match ph:
    case Ch.Watching{w}:
      match del:
        case True{}:
          match inbox:
            case Nil{}:
              {==}
            case s <> rest:
              child.pc.absurd({pc.K(Ch.St{Ch.Owing{Ch.Cancelled{}, 1n}, None{}, open, s <> rest}) == True{} : Bool}, kph)
        case False{}:
          kin
    case Ch.Owing{kr, +n}:
      pc.and_in(pc.Kowe(inbox, n), pc.Kin(inbox), kph, kin)
    case Ch.Ended{}:
      kin

def pc.K_poll(cut: Maybe<&2, Bool>, ph: Ch.Ph, +inbox: List<&2, Ch.Sub>, +open: Bool, +cfg: Ch.Cfg, +dt: Nat, +o: Ch.Obs, +kph: {pc.Kph(ph, inbox) == True{} : Bool}, +kin: {pc.Kin(inbox) == True{} : Bool}) -> {pc.K(Ch.task(cfg, ph, cut, open, inbox, dt, o)) == True{} : Bool}:
  match cut:
    case None{}:
      match ph:
        case Ch.Watching{+w}:
          match inbox:
            case Nil{}:
              pc.and_in(pc.Kph(Ch.watched(Ch.look(cfg, w, 1n+dt, o)), Nil{}), True{}, pc.Kph_watched(Ch.look(cfg, w, 1n+dt, o)), {==})
            case s <> rest:
              child.pc.absurd({pc.K(Ch.task(cfg, Ch.Watching{w}, None{}, open, s <> rest, dt, o)) == True{} : Bool}, kph)
        case Ch.Owing{kr, +n}:
          pc.K_owe(inbox, kr, n, open, kph, kin)
        case Ch.Ended{}:
          kin
    case Some{del}:
      pc.K_cut(ph, del, inbox, open, kph, kin)

# a delivery or withdrawal keeps K: it touches the newest submission only
def pc.K_act(inbox: List<&2, Ch.Sub>, ph: Ch.Ph, +a: Ch.Act, +kph: {pc.Kph(ph, inbox) == True{} : Bool}, +kin: {pc.Kin(inbox) == True{} : Bool}) -> {Bool.and(pc.Kph(ph, Ch.act(inbox, a)), pc.Kin(Ch.act(inbox, a))) == True{} : Bool}:
  match inbox:
    case Nil{}:
      pc.and_in(pc.Kph(ph, Nil{}), True{}, kph, {==})
    case s <> +rest:
      match s:
        case Ch.Sub{+m, +f}:
          match ph:
            case Ch.Watching{w}:
              child.pc.absurd({Bool.and(pc.Kph(Ch.Watching{w}, Ch.act(Ch.Sub{m, f} <> rest, a)), pc.Kin(Ch.act(Ch.Sub{m, f} <> rest, a))) == True{} : Bool}, kph)
            case Ch.Owing{kr, +n}:
              pc.and_in(pc.Kowe.at(Nat.is_eq(m, n), n, m, Ch.Fate.act(a, m, f)), pc.Old(Ch.act(rest, a), m), pc.kat_act(Nat.is_eq(m, n), n, m, f, a, kph), pc.old_act(rest, m, a, kin))
            case Ch.Ended{}:
              pc.old_act(rest, m, a, kin)

# every event keeps K
def pc.K_step(+cfg: Ch.Cfg, s: Ch.St, e: Ch.Ev, +k: {pc.K(s) == True{} : Bool}) -> {pc.K(Ch.step(cfg, s, e)) == True{} : Bool}:
  match s:
    case Ch.St{+ph, +cut, +open, +inbox}:
      match e:
        case Ch.Poll{+dt, +o}:
          pc.K_poll(cut, ph, inbox, open, cfg, dt, o, pc.and_l(pc.Kph(ph, inbox), pc.Kin(inbox), k), pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Deliver{+m}:
          pc.K_act(inbox, ph, Ch.Place{m}, pc.and_l(pc.Kph(ph, inbox), pc.Kin(inbox), k), pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Withdraw{+m}:
          pc.K_act(inbox, ph, Ch.Pull{m}, pc.and_l(pc.Kph(ph, inbox), pc.Kin(inbox), k), pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Abort{}:
          pc.K_act(inbox, ph, Ch.PullAll{}, pc.and_l(pc.Kph(ph, inbox), pc.Kin(inbox), k), pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Shut{}:
          pc.K_act(inbox, ph, Ch.PullAll{}, pc.and_l(pc.Kph(ph, inbox), pc.Kin(inbox), k), pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Reopen{}:
          k
        case Ch.Cut{del}:
          k

def pc.K_run(evs: List<&2, Ch.Ev>, +cfg: Ch.Cfg, +s: Ch.St, k: {pc.K(s) == True{} : Bool}) -> {pc.K(Ch.run(evs, cfg, s)) == True{} : Bool}:
  match evs:
    case Nil{}:
      k
    case +e <> t:
      pc.K_run(t, cfg, Ch.step(cfg, s, e), pc.K_step(cfg, s, e, k))

# one_live, report_once: only the newest submission may be live
def pc.le1_live(f: Ch.Fate) -> {Nat.is_le(Nat.add(Ch.Fate.live(f), 0n), 1n) == True{} : Bool}:
  match f:
    case Ch.Queued{}:
      {==}
    case Ch.Withdrawn{}:
      {==}
    case Ch.Placed{}:
      {==}

def pc.le1_placed(f: Ch.Fate) -> {Nat.is_le(Nat.add(Ch.Fate.placed(f), 0n), 1n) == True{} : Bool}:
  match f:
    case Ch.Queued{}:
      {==}
    case Ch.Withdrawn{}:
      {==}
    case Ch.Placed{}:
      {==}

def pc.live_le(inbox: List<&2, Ch.Sub>, kin: {pc.Kin(inbox) == True{} : Bool}) -> {Nat.is_le(Ch.live(inbox), 1n) == True{} : Bool}:
  match inbox:
    case Nil{}:
      {==}
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          %pc.old_live(rest, m, kin) : {Nat.is_le(Nat.add(Ch.Fate.live(f), _), 1n) == True{} : Bool}
          pc.le1_live(f)

def pc.placed_le(inbox: List<&2, Ch.Sub>, kin: {pc.Kin(inbox) == True{} : Bool}) -> {Nat.is_le(Ch.placed(inbox), 1n) == True{} : Bool}:
  match inbox:
    case Nil{}:
      {==}
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          %pc.old_placed(rest, m, kin) : {Nat.is_le(Nat.add(Ch.Fate.placed(f), _), 1n) == True{} : Bool}
          pc.le1_placed(f)

def pc.one_live(+cfg: Ch.Cfg, +evs: List<&2, Ch.Ev>) -> {Nat.is_le(Ch.live(Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg)))), 1n) == True{} : Bool}:
  pc.live_le(Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg))), pc.Kin_of(Ch.run(evs, cfg, Ch.St.init(cfg)), pc.K_run(evs, cfg, Ch.St.init(cfg), {==})))

def pc.report_once(+cfg: Ch.Cfg, +evs: List<&2, Ch.Ev>) -> {Nat.is_le(Ch.St.placed(Ch.run(evs, cfg, Ch.St.init(cfg))), 1n) == True{} : Bool}:
  pc.placed_le(Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg))), pc.Kin_of(Ch.run(evs, cfg, Ch.St.init(cfg)), pc.K_run(evs, cfg, Ch.St.init(cfg), {==})))

# resubmits_per_abort: the potential pot = 1 + the withdrawn submissions
# bounds the inbox (all but the newest are withdrawn) and grows only at a
# withdrawal (only the newest may be queued)
def pc.fwd(f: Ch.Fate) -> Nat:
  match f:
    case Ch.Queued{}:
      0n
    case Ch.Withdrawn{}:
      1n
    case Ch.Placed{}:
      0n

def pc.slots(inbox: List<&2, Ch.Sub>) -> Nat:
  match inbox:
    case Nil{}:
      1n
    case s <> rest:
      match s:
        case Ch.Sub{i, f}:
          Nat.add(pc.fwd(f), pc.slots(rest))

def pc.pot(s: Ch.St) -> Nat:
  pc.slots(Ch.St.inbox(s))

def pc.acut(a: Ch.Act) -> Nat:
  match a:
    case Ch.Place{m}:
      0n
    case Ch.Pull{m}:
      1n
    case Ch.PullAll{}:
      1n

def pc.old_len(rest: List<&2, Ch.Sub>, +m: Nat, o: {pc.Old(rest, m) == True{} : Bool}) -> {Nat.is_le(1n+List.length(&2, Ch.Sub, rest), pc.slots(rest)) == True{} : Bool}:
  match rest:
    case Nil{}:
      {==}
    case s <> r:
      match s:
        case Ch.Sub{+j, f}:
          match f:
            case Ch.Queued{}:
              child.pc.absurd({Nat.is_le(1n+List.length(&2, Ch.Sub, Ch.Sub{j, Ch.Queued{}} <> r), pc.slots(Ch.Sub{j, Ch.Queued{}} <> r)) == True{} : Bool}, o)
            case Ch.Withdrawn{}:
              pc.old_len(r, j, pc.and_r(Nat.is_le(1n+j, m), pc.Old(r, j), o))
            case Ch.Placed{}:
              child.pc.absurd({Nat.is_le(1n+List.length(&2, Ch.Sub, Ch.Sub{j, Ch.Placed{}} <> r), pc.slots(Ch.Sub{j, Ch.Placed{}} <> r)) == True{} : Bool}, o)

def pc.len_le(inbox: List<&2, Ch.Sub>, kin: {pc.Kin(inbox) == True{} : Bool}) -> {Nat.is_le(List.length(&2, Ch.Sub, inbox), pc.slots(inbox)) == True{} : Bool}:
  match inbox:
    case Nil{}:
      {==}
    case s <> +rest:
      match s:
        case Ch.Sub{+m, +f}:
          child.pc.le_trans(1n+List.length(&2, Ch.Sub, rest), pc.slots(rest), Nat.add(pc.fwd(f), pc.slots(rest)), pc.old_len(rest, m, kin), child.pc.le_add(pc.fwd(f), pc.slots(rest)))

def pc.hit_placed(b: Bool, +w: Nat) -> {Nat.is_le(Nat.add(pc.fwd(Ch.Act.hit(b, Ch.Placed{})), w), w) == True{} : Bool}:
  match b:
    case True{}:
      child.pc.le_refl(w)
    case False{}:
      child.pc.le_refl(w)

def pc.hit_pulled(b: Bool, +w: Nat) -> {Nat.is_le(Nat.add(pc.fwd(Ch.Act.hit(b, Ch.Withdrawn{})), w), 1n+w) == True{} : Bool}:
  match b:
    case True{}:
      child.pc.le_refl(w)
    case False{}:
      pc.le_succ(w, w, child.pc.le_refl(w))

def pc.slots_queued(a: Ch.Act, +i: Nat, +w: Nat) -> {Nat.is_le(Nat.add(pc.fwd(Ch.Act.queued(a, i)), w), Nat.add(pc.acut(a), Nat.add(0n, w))) == True{} : Bool}:
  match a:
    case Ch.Place{+x}:
      pc.hit_placed(Nat.is_eq(i, x), w)
    case Ch.Pull{+x}:
      pc.hit_pulled(Nat.is_eq(i, x), w)
    case Ch.PullAll{}:
      child.pc.le_refl(w)

# the newest submission's share of the potential grows by at most the act's
def pc.slots_head(f: Ch.Fate, +a: Ch.Act, +i: Nat, +w: Nat) -> {Nat.is_le(Nat.add(pc.fwd(Ch.Fate.act(a, i, f)), w), Nat.add(pc.acut(a), Nat.add(pc.fwd(f), w))) == True{} : Bool}:
  match f:
    case Ch.Queued{}:
      pc.slots_queued(a, i, w)
    case Ch.Withdrawn{}:
      child.pc.le_add(pc.acut(a), Nat.add(1n, w))
    case Ch.Placed{}:
      child.pc.le_add(pc.acut(a), w)

def pc.slots_act(inbox: List<&2, Ch.Sub>, +a: Ch.Act, kin: {pc.Kin(inbox) == True{} : Bool}) -> {Nat.is_le(pc.slots(Ch.act(inbox, a)), Nat.add(pc.acut(a), pc.slots(inbox))) == True{} : Bool}:
  match inbox:
    case Nil{}:
      child.pc.le_add(pc.acut(a), 1n)
    case s <> +rest:
      match s:
        case Ch.Sub{+m, +f}:
          %pc.act_eq(rest, m, a, kin) : {Nat.is_le(Nat.add(pc.fwd(Ch.Fate.act(a, m, f)), pc.slots(_)), Nat.add(pc.acut(a), Nat.add(pc.fwd(f), pc.slots(rest)))) == True{} : Bool}
          pc.slots_head(f, a, m, pc.slots(rest))

def pc.slots_owe(x: Maybe<&2, Ch.Fate>, +kr: Ch.Report, +n: Nat, open: Bool, +inbox: List<&2, Ch.Sub>) -> {Nat.is_le(pc.slots(Ch.St.inbox(Ch.owe(x, kr, n, open, inbox))), pc.slots(inbox)) == True{} : Bool}:
  match x:
    case None{}:
      match open:
        case True{}:
          child.pc.le_refl(pc.slots(inbox))
        case False{}:
          child.pc.le_refl(pc.slots(inbox))
    case Some{y}:
      match y:
        case Ch.Queued{}:
          child.pc.le_refl(pc.slots(inbox))
        case Ch.Withdrawn{}:
          child.pc.le_refl(pc.slots(inbox))
        case Ch.Placed{}:
          child.pc.le_refl(pc.slots(inbox))

def pc.slots_poll(cut: Maybe<&2, Bool>, ph: Ch.Ph, +inbox: List<&2, Ch.Sub>, +open: Bool, +cfg: Ch.Cfg, +dt: Nat, +o: Ch.Obs) -> {Nat.is_le(pc.slots(Ch.St.inbox(Ch.task(cfg, ph, cut, open, inbox, dt, o))), pc.slots(inbox)) == True{} : Bool}:
  match cut:
    case None{}:
      match ph:
        case Ch.Watching{w}:
          child.pc.le_refl(pc.slots(inbox))
        case Ch.Owing{kr, +n}:
          pc.slots_owe(Ch.fate(inbox, n), kr, n, open, inbox)
        case Ch.Ended{}:
          child.pc.le_refl(pc.slots(inbox))
    case Some{del}:
      child.pc.le_refl(pc.slots(inbox))

def pc.pot_step(+cfg: Ch.Cfg, s: Ch.St, e: Ch.Ev, k: {pc.K(s) == True{} : Bool}) -> {Nat.is_le(pc.pot(Ch.step(cfg, s, e)), Nat.add(Ch.Ev.cut(e), pc.pot(s))) == True{} : Bool}:
  match s:
    case Ch.St{+ph, +cut, +open, +inbox}:
      match e:
        case Ch.Poll{+dt, +o}:
          pc.slots_poll(cut, ph, inbox, open, cfg, dt, o)
        case Ch.Deliver{+m}:
          pc.slots_act(inbox, Ch.Place{m}, pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Withdraw{+m}:
          pc.slots_act(inbox, Ch.Pull{m}, pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Abort{}:
          pc.slots_act(inbox, Ch.PullAll{}, pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Shut{}:
          pc.slots_act(inbox, Ch.PullAll{}, pc.and_r(pc.Kph(ph, inbox), pc.Kin(inbox), k))
        case Ch.Reopen{}:
          child.pc.le_refl(pc.slots(inbox))
        case Ch.Cut{del}:
          child.pc.le_refl(pc.slots(inbox))

def pc.pot_run(evs: List<&2, Ch.Ev>, +cfg: Ch.Cfg, +s: Ch.St, +k: {pc.K(s) == True{} : Bool}) -> {Nat.is_le(pc.pot(Ch.run(evs, cfg, s)), Nat.add(Ch.cuts(evs), pc.pot(s))) == True{} : Bool}:
  match evs:
    case Nil{}:
      child.pc.le_refl(pc.pot(s))
    case +e <> +t:
      %Equal.sym(Nat, Nat.add(Nat.add(Ch.cuts(t), Ch.Ev.cut(e)), pc.pot(s)), Nat.add(Ch.cuts(t), Nat.add(Ch.Ev.cut(e), pc.pot(s))), pc.add_assoc(Ch.cuts(t), Ch.Ev.cut(e), pc.pot(s))) : {Nat.is_le(pc.pot(Ch.run(t, cfg, Ch.step(cfg, s, e))), _) == True{} : Bool}
      child.pc.le_trans(pc.pot(Ch.run(t, cfg, Ch.step(cfg, s, e))), Nat.add(Ch.cuts(t), pc.pot(Ch.step(cfg, s, e))), Nat.add(Ch.cuts(t), Nat.add(Ch.Ev.cut(e), pc.pot(s))), pc.pot_run(t, cfg, Ch.step(cfg, s, e), pc.K_step(cfg, s, e, k)), pc.le_add_mono(Ch.cuts(t), pc.pot(Ch.step(cfg, s, e)), Nat.add(Ch.Ev.cut(e), pc.pot(s)), pc.pot_step(cfg, s, e, k)))

def pc.resubmits_per_abort(+cfg: Ch.Cfg, +evs: List<&2, Ch.Ev>) -> {Nat.is_le(List.length(&2, Ch.Sub, Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg)))), Nat.add(Ch.cuts(evs), 1n)) == True{} : Bool}:
  child.pc.le_trans(List.length(&2, Ch.Sub, Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg)))), pc.pot(Ch.run(evs, cfg, Ch.St.init(cfg))), Nat.add(Ch.cuts(evs), 1n), pc.len_le(Ch.St.inbox(Ch.run(evs, cfg, Ch.St.init(cfg))), pc.Kin_of(Ch.run(evs, cfg, Ch.St.init(cfg)), pc.K_run(evs, cfg, Ch.St.init(cfg), {==}))), pc.pot_run(evs, cfg, Ch.St.init(cfg), {==}))

# delivered_once: `soon` holds when the open, unmarked task owes id n with
# no submission of n yet or n queued, or the report is placed; `ready`
# when n is queued, or the report is placed
def pc.unmarked(cut: Maybe<&2, Bool>) -> Bool:
  match cut:
    case None{}:
      True{}
    case Some{d}:
      False{}

def pc.fq(x: Maybe<&2, Ch.Fate>) -> Bool:
  match x:
    case None{}:
      False{}
    case Some{f}:
      match f:
        case Ch.Queued{}:
          True{}
        case Ch.Withdrawn{}:
          False{}
        case Ch.Placed{}:
          False{}

def pc.fs(x: Maybe<&2, Ch.Fate>) -> Bool:
  match x:
    case None{}:
      True{}
    case Some{f}:
      match f:
        case Ch.Queued{}:
          True{}
        case Ch.Withdrawn{}:
          False{}
        case Ch.Placed{}:
          False{}

def pc.ready(s: Ch.St) -> Bool:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          False{}
        case Ch.Owing{k, +n}:
          Bool.and(pc.unmarked(cut), Bool.and(open, pc.fq(Ch.fate(inbox, n))))
        case Ch.Ended{}:
          Nat.is_eq(Ch.placed(inbox), 1n)

def pc.soon(s: Ch.St) -> Bool:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          False{}
        case Ch.Owing{k, +n}:
          Bool.and(pc.unmarked(cut), Bool.and(open, pc.fs(Ch.fate(inbox, n))))
        case Ch.Ended{}:
          Nat.is_eq(Ch.placed(inbox), 1n)

# the submission just made is found queued
def pc.fs_new(same: Bool, -x: Maybe<&2, Ch.Fate>, e: {same == True{} : Bool}) -> {pc.fs(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, Ch.Queued{}), x)) == True{} : Bool}:
  match same:
    case True{}:
      {==}
    case False{}:
      child.pc.absurd({pc.fs(Maybe.or(&2, Ch.Fate, Ch.fate.here(False{}, Ch.Queued{}), x)) == True{} : Bool}, e)

def pc.fq_new(same: Bool, -x: Maybe<&2, Ch.Fate>, e: {same == True{} : Bool}) -> {pc.fq(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, Ch.Queued{}), x)) == True{} : Bool}:
  match same:
    case True{}:
      {==}
    case False{}:
      child.pc.absurd({pc.fq(Maybe.or(&2, Ch.Fate, Ch.fate.here(False{}, Ch.Queued{}), x)) == True{} : Bool}, e)

def pc.fs_off(same: Bool, -f: Ch.Fate, e: {same == False{} : Bool}) -> {pc.fs(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, f), None{})) == True{} : Bool}:
  match same:
    case True{}:
      child.pc.absurd({pc.fs(Maybe.or(&2, Ch.Fate, Ch.fate.here(True{}, f), None{})) == True{} : Bool}, Equal.sym(Bool, True{}, False{}, e))
    case False{}:
      {==}

def pc.fs_of_fq(x: Maybe<&2, Ch.Fate>, e: {pc.fq(x) == True{} : Bool}) -> {pc.fs(x) == True{} : Bool}:
  match x:
    case None{}:
      child.pc.absurd({pc.fs(None{}) == True{} : Bool}, e)
    case Some{f}:
      match f:
        case Ch.Queued{}:
          {==}
        case Ch.Withdrawn{}:
          child.pc.absurd({pc.fs(Some{Ch.Withdrawn{}}) == True{} : Bool}, e)
        case Ch.Placed{}:
          child.pc.absurd({pc.fs(Some{Ch.Placed{}}) == True{} : Bool}, e)

# no queued submission where none exists
def pc.fq_none(-A: Type, x: Maybe<&2, Ch.Fate>, e: {None{} == x : Maybe<&2, Ch.Fate>}, r: {pc.fq(x) == True{} : Bool}) -> A:
  match x:
    case None{}:
      child.pc.absurd(A, r)
    case Some{f}:
      pc.none_some(A, f, e)

# one step of the report rule from K leaves the report soon
def pc.soon_owe.at(same: Bool, +kr: Ch.Report, +n: Nat, +m: Nat, f: Ch.Fate, +rest: List<&2, Ch.Sub>, +eb: {Nat.is_eq(m, n) == same : Bool}, kph: {pc.Kowe.at(same, n, m, f) == True{} : Bool}, +kin: {pc.Old(rest, m) == True{} : Bool}) -> {pc.soon(Ch.owe(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, f), Ch.fate(rest, n)), kr, n, True{}, Ch.Sub{m, f} <> rest)) == True{} : Bool}:
  match same:
    case True{}:
      match f:
        case Ch.Queued{}:
          pc.fs_new(Nat.is_eq(m, n), Ch.fate(rest, n), eb)
        case Ch.Withdrawn{}:
          %pc.old_none(rest, m, 1n+n, kin, pc.le_succ(m, n, pc.le_of_eq(m, n, eb))) : {pc.fs(Maybe.or(&2, Ch.Fate, Ch.fate.here(Nat.is_eq(m, 1n+n), Ch.Withdrawn{}), _)) == True{} : Bool}
          pc.fs_off(Nat.is_eq(m, 1n+n), Ch.Withdrawn{}, pc.eq_next(m, n, eb))
        case Ch.Placed{}:
          %pc.old_placed(rest, m, kin) : {Nat.is_eq(Nat.add(1n, _), 1n) == True{} : Bool}
          {==}
    case False{}:
      %pc.old_none(rest, m, n, kin, pc.le_pred(m, n, pc.le_of_eq(1n+m, n, pc.and_l(Nat.is_eq(1n+m, n), pc.isW(f), kph)))) : {pc.soon(Ch.owe(_, kr, n, True{}, Ch.Sub{m, f} <> rest)) == True{} : Bool}
      pc.fs_new(Nat.is_eq(n, n), Ch.fate(Ch.Sub{m, f} <> rest, n), child.pc.eq_refl(n))

def pc.soon_owe(inbox: List<&2, Ch.Sub>, +kr: Ch.Report, +n: Nat, kph: {pc.Kowe(inbox, n) == True{} : Bool}, kin: {pc.Kin(inbox) == True{} : Bool}) -> {pc.soon(Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox)) == True{} : Bool}:
  match inbox:
    case Nil{}:
      pc.fs_new(Nat.is_eq(n, n), None{}, child.pc.eq_refl(n))
    case s <> rest:
      match s:
        case Ch.Sub{+m, f}:
          pc.soon_owe.at(Nat.is_eq(m, n), kr, n, m, f, rest, {==}, kph, kin)

# a soon report is ready after one more task step
def pc.ready_owe(x: Maybe<&2, Ch.Fate>, +kr: Ch.Report, +n: Nat, +inbox: List<&2, Ch.Sub>, ex: {Ch.fate(inbox, n) == x : Maybe<&2, Ch.Fate>}, sn: {pc.fs(x) == True{} : Bool}) -> {pc.ready(Ch.owe(x, kr, n, True{}, inbox)) == True{} : Bool}:
  match x:
    case None{}:
      pc.fq_new(Nat.is_eq(n, n), Ch.fate(inbox, n), child.pc.eq_refl(n))
    case Some{y}:
      match y:
        case Ch.Queued{}:
          %Equal.sym(Maybe<&2, Ch.Fate>, Ch.fate(inbox, n), Some{Ch.Queued{}}, ex) : {pc.fq(_) == True{} : Bool}
          {==}
        case Ch.Withdrawn{}:
          child.pc.absurd({pc.ready(Ch.owe(Some{Ch.Withdrawn{}}, kr, n, True{}, inbox)) == True{} : Bool}, sn)
        case Ch.Placed{}:
          child.pc.absurd({pc.ready(Ch.owe(Some{Ch.Placed{}}, kr, n, True{}, inbox)) == True{} : Bool}, sn)

def pc.ready_soon(+cfg: Ch.Cfg, s: Ch.St, +d: Nat, +o: Ch.Obs, sn: {pc.soon(s) == True{} : Bool}) -> {pc.ready(Ch.step(cfg, s, Ch.Poll{d, o})) == True{} : Bool}:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          child.pc.absurd({pc.ready(Ch.step(cfg, Ch.St{Ch.Watching{w}, cut, open, inbox}, Ch.Poll{d, o})) == True{} : Bool}, sn)
        case Ch.Owing{kr, +n}:
          match cut:
            case None{}:
              match open:
                case True{}:
                  pc.ready_owe(Ch.fate(inbox, n), kr, n, inbox, {==}, sn)
                case False{}:
                  child.pc.absurd({pc.ready(Ch.step(cfg, Ch.St{Ch.Owing{kr, n}, None{}, False{}, inbox}, Ch.Poll{d, o})) == True{} : Bool}, sn)
            case Some{del}:
              child.pc.absurd({pc.ready(Ch.step(cfg, Ch.St{Ch.Owing{kr, n}, Some{del}, open, inbox}, Ch.Poll{d, o})) == True{} : Bool}, sn)
        case Ch.Ended{}:
          match cut:
            case None{}:
              sn
            case Some{del}:
              sn

def pc.soon_of_ready(s: Ch.St, r: {pc.ready(s) == True{} : Bool}) -> {pc.soon(s) == True{} : Bool}:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          r
        case Ch.Owing{k, +n}:
          match cut:
            case None{}:
              match open:
                case True{}:
                  pc.fs_of_fq(Ch.fate(inbox, n), r)
                case False{}:
                  r
            case Some{d}:
              r
        case Ch.Ended{}:
          r

# a delivery of the queued submission n places it: one entry placed
def pc.del_at(same: Bool, +n: Nat, +m: Nat, f: Ch.Fate, +rest: List<&2, Ch.Sub>, eb: {Nat.is_eq(m, n) == same : Bool}, kph: {pc.Kowe.at(same, n, m, f) == True{} : Bool}, +kin: {pc.Old(rest, m) == True{} : Bool}, r: {pc.fq(Maybe.or(&2, Ch.Fate, Ch.fate.here(same, f), Ch.fate(rest, n))) == True{} : Bool}) -> {Ch.placed(Ch.act(Ch.Sub{m, f} <> rest, Ch.Place{n})) == 1n : Nat}:
  match same:
    case True{}:
      match f:
        case Ch.Queued{}:
          %pc.old_placed(Ch.act(rest, Ch.Place{n}), m, pc.old_act(rest, m, Ch.Place{n}, kin)) : {Nat.add(Ch.Fate.placed(Ch.Act.hit(Nat.is_eq(m, n), Ch.Placed{})), _) == 1n : Nat}
          %Equal.sym(Bool, Nat.is_eq(m, n), True{}, eb) : {Nat.add(Ch.Fate.placed(Ch.Act.hit(_, Ch.Placed{})), 0n) == 1n : Nat}
          {==}
        case Ch.Withdrawn{}:
          child.pc.absurd({Ch.placed(Ch.act(Ch.Sub{m, Ch.Withdrawn{}} <> rest, Ch.Place{n})) == 1n : Nat}, r)
        case Ch.Placed{}:
          child.pc.absurd({Ch.placed(Ch.act(Ch.Sub{m, Ch.Placed{}} <> rest, Ch.Place{n})) == 1n : Nat}, r)
    case False{}:
      pc.fq_none({Ch.placed(Ch.act(Ch.Sub{m, f} <> rest, Ch.Place{n})) == 1n : Nat}, Ch.fate(rest, n), pc.old_none(rest, m, n, kin, pc.le_pred(m, n, pc.le_of_eq(1n+m, n, pc.and_l(Nat.is_eq(1n+m, n), pc.isW(f), kph)))), r)

# a delivery of any id leaves a placed report placed once
def pc.del_end(inbox: List<&2, Ch.Sub>, +x: Nat, kin: {pc.Kin(inbox) == True{} : Bool}, r: {Nat.is_eq(Ch.placed(inbox), 1n) == True{} : Bool}) -> {Ch.placed(Ch.act(inbox, Ch.Place{x})) == 1n : Nat}:
  match inbox:
    case Nil{}:
      child.pc.absurd({Ch.placed(Ch.act(Nil{}, Ch.Place{x})) == 1n : Nat}, r)
    case s <> +rest:
      match s:
        case Ch.Sub{+m, f}:
          match f:
            case Ch.Queued{}:
              pc.one_zero({Ch.placed(Ch.act(Ch.Sub{m, Ch.Queued{}} <> rest, Ch.Place{x})) == 1n : Nat}, Ch.placed(rest), pc.old_placed(rest, m, kin), r)
            case Ch.Withdrawn{}:
              pc.one_zero({Ch.placed(Ch.act(Ch.Sub{m, Ch.Withdrawn{}} <> rest, Ch.Place{x})) == 1n : Nat}, Ch.placed(rest), pc.old_placed(rest, m, kin), r)
            case Ch.Placed{}:
              %pc.old_placed(Ch.act(rest, Ch.Place{x}), m, pc.old_act(rest, m, Ch.Place{x}, kin)) : {Nat.add(1n, _) == 1n : Nat}
              {==}

def pc.ready_deliver0(+cfg: Ch.Cfg, s: Ch.St, +k: {pc.K(s) == True{} : Bool}, r: {pc.ready(s) == True{} : Bool}) -> {Ch.St.placed(Ch.step(cfg, s, Ch.Deliver{Ch.St.owed(s)})) == 1n : Nat}:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          child.pc.absurd({Ch.St.placed(Ch.step(cfg, Ch.St{Ch.Watching{w}, cut, open, inbox}, Ch.Deliver{0n})) == 1n : Nat}, r)
        case Ch.Owing{kr, +n}:
          match cut:
            case None{}:
              match open:
                case True{}:
                  match inbox:
                    case Nil{}:
                      child.pc.absurd({Ch.St.placed(Ch.step(cfg, Ch.St{Ch.Owing{kr, n}, None{}, True{}, Nil{}}, Ch.Deliver{n})) == 1n : Nat}, r)
                    case s2 <> +rest:
                      match s2:
                        case Ch.Sub{+m, +f}:
                          pc.del_at(Nat.is_eq(m, n), n, m, f, rest, {==}, pc.and_l(pc.Kowe.at(Nat.is_eq(m, n), n, m, f), pc.Old(rest, m), k), pc.and_r(pc.Kowe.at(Nat.is_eq(m, n), n, m, f), pc.Old(rest, m), k), r)
                case False{}:
                  child.pc.absurd({Ch.St.placed(Ch.step(cfg, Ch.St{Ch.Owing{kr, n}, None{}, False{}, inbox}, Ch.Deliver{n})) == 1n : Nat}, r)
            case Some{del}:
              child.pc.absurd({Ch.St.placed(Ch.step(cfg, Ch.St{Ch.Owing{kr, n}, Some{del}, open, inbox}, Ch.Deliver{n})) == 1n : Nat}, r)
        case Ch.Ended{}:
          pc.del_end(inbox, 0n, k, r)

def pc.ready_deliver(+cfg: Ch.Cfg, +s: Ch.St, +m: Nat, k: {pc.K(s) == True{} : Bool}, r: {pc.ready(s) == True{} : Bool}, em: {Ch.St.owed(s) == m : Nat}) -> {Ch.St.placed(Ch.step(cfg, s, Ch.Deliver{m})) == 1n : Nat}:
  %em : {Ch.St.placed(Ch.step(cfg, s, Ch.Deliver{_})) == 1n : Nat}
  pc.ready_deliver0(cfg, s, k, r)

# from any state that owes the report: a reopen, three task steps (the
# first may run a pending abort, which hands the report on), and a
# delivery of the id the task then owes place it, exactly once
def pc.delivered(+cfg: Ch.Cfg, s: Ch.St, +d1: Nat, +o1: Ch.Obs, +d2: Nat, +o2: Ch.Obs, +d3: Nat, +o3: Ch.Obs, +m: Nat, +k: {pc.K(s) == True{} : Bool}, ow: {Ch.Ph.owing(Ch.St.ph(s)) == True{} : Bool}, em: {Ch.St.owed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}], cfg, s)) == m : Nat}) -> {Ch.St.placed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}, Ch.Deliver{m}], cfg, s)) == 1n : Nat}:
  match s:
    case Ch.St{ph, cut, open, +inbox}:
      match ph:
        case Ch.Watching{w}:
          child.pc.absurd({Ch.St.placed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}, Ch.Deliver{m}], cfg, Ch.St{Ch.Watching{w}, cut, open, inbox})) == 1n : Nat}, ow)
        case Ch.Owing{+kr, +n}:
          match cut:
            case None{}:
              pc.ready_deliver(cfg, Ch.step(cfg, Ch.step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d2, o2}), Ch.Poll{d3, o3}), m, pc.K_step(cfg, Ch.step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d2, o2}), Ch.Poll{d3, o3}, pc.K_step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d2, o2}, pc.K_step(cfg, Ch.St{Ch.Owing{kr, n}, None{}, True{}, inbox}, Ch.Poll{d1, o1}, k))), pc.ready_soon(cfg, Ch.step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d2, o2}), d3, o3, pc.soon_of_ready(Ch.step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d2, o2}), pc.ready_soon(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), d2, o2, pc.soon_owe(inbox, kr, n, pc.and_l(pc.Kowe(inbox, n), pc.Kin(inbox), k), pc.and_r(pc.Kowe(inbox, n), pc.Kin(inbox), k))))), em)
            case Some{del}:
              pc.ready_deliver(cfg, Ch.step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d3, o3}), m, pc.K_step(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), Ch.Poll{d3, o3}, pc.K_step(cfg, Ch.St{Ch.Owing{kr, n}, None{}, True{}, inbox}, Ch.Poll{d2, o2}, k)), pc.ready_soon(cfg, Ch.owe(Ch.fate(inbox, n), kr, n, True{}, inbox), d3, o3, pc.soon_owe(inbox, kr, n, pc.and_l(pc.Kowe(inbox, n), pc.Kin(inbox), k), pc.and_r(pc.Kowe(inbox, n), pc.Kin(inbox), k))), em)
        case Ch.Ended{}:
          child.pc.absurd({Ch.St.placed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}, Ch.Deliver{m}], cfg, Ch.St{Ch.Ended{}, cut, open, inbox})) == 1n : Nat}, ow)

def pc.delivered_once(+cfg: Ch.Cfg, +evs: List<&2, Ch.Ev>, +d1: Nat, +o1: Ch.Obs, +d2: Nat, +o2: Ch.Obs, +d3: Nat, +o3: Ch.Obs, ow: {Ch.Ph.owing(Ch.St.ph(Ch.run(evs, cfg, Ch.St.init(cfg)))) == True{} : Bool}, +m: Nat, em: {Ch.St.owed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}], cfg, Ch.run(evs, cfg, Ch.St.init(cfg)))) == m : Nat}) -> {Ch.St.placed(Ch.run([Ch.Reopen{}, Ch.Poll{d1, o1}, Ch.Poll{d2, o2}, Ch.Poll{d3, o3}, Ch.Deliver{m}], cfg, Ch.run(evs, cfg, Ch.St.init(cfg)))) == 1n : Nat}:
  pc.delivered(cfg, Ch.run(evs, cfg, Ch.St.init(cfg)), d1, o1, d2, o2, d3, o3, m, pc.K_run(evs, cfg, Ch.St.init(cfg), {==}), ow, em)

# ---- run ----

# proof_run: the H4 laws of LAWS.bend about bend/run.bend.
#
# - run_ends: an explicit measure M (the inputs a run may still take) falls
#   by at least one at every input to a live run: lexicographically, the
#   rounds left, then the compactions, and the retries and notes left in
#   the generation (one budget u = a + n: each retry, noted or not, spends
#   one of them), the polls left, then the phase (prepare > call >
#   compact; tools ends the generation). M is that order written as one
#   number, in mixed radix, and M at the start is bound(cfg).
# - end_stays, abort_ends_now: by computation on each phase.
# - rounds_capped, rounds_fail_at_cap: invariants of every run and its
#   counted rounds, by induction on its inputs.
# - polls_need_defers: an invariant of the run and its deferred replies in
#   a row, by induction on its inputs.
# - no_answer, calls_never_answer, note_spends_no_retry,
#   retry_spends_no_note: by computation: Ended.reply makes a message with
#   a tool call Calls, whatever its text, and one with no text and no call
#   a noted Error; a noted Error spends a note, any other a retry.

# Logic
# -----

def BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def absurd(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : BD(_, A, Unit)
  Unit{}

def ND(n: Nat, t: Type, f: Type) -> Type:
  match n:
    case 0n:
      t
    case 1n+p:
      f

# 0 is no successor
def zero_succ(-A: Type, -n: Nat, e: {0n == 1n+n : Nat}) -> A:
  %e : ND(_, Unit, A)
  Unit{}

def pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def succ_inj(-a: Nat, -b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, pred, 1n+a, 1n+b, e)

# Numbers
# -------

def add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def add_succ(a: Nat, -b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %add_succ(p, b) : {1n+Nat.add(p, 1n+b) == 1n+_ : Nat}
      {==}

def add_assoc(a: Nat, -b: Nat, -c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %add_assoc(p, b, c) : {1n+Nat.add(Nat.add(p, b), c) == 1n+_ : Nat}
      {==}

def add_comm(a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  match a:
    case 0n:
      Equal.sym(Nat, Nat.add(b, 0n), b, add_zero(b))
    case 1n+p:
      %Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), add_succ(b, p)) : {1n+Nat.add(p, b) == _ : Nat}
      %add_comm(p, b) : {1n+Nat.add(p, b) == 1n+_ : Nat}
      {==}

# a + (b + c) = b + (a + c)
def add_lcomm(+a: Nat, +b: Nat, -c: Nat) -> {Nat.add(a, Nat.add(b, c)) == Nat.add(b, Nat.add(a, c)) : Nat}:
  %add_assoc(a, b, c) : {_ == Nat.add(b, Nat.add(a, c)) : Nat}
  %Equal.sym(Nat, Nat.add(a, b), Nat.add(b, a), add_comm(a, b)) : {Nat.add(_, c) == Nat.add(b, Nat.add(a, c)) : Nat}
  add_assoc(b, a, c)

def add_succ_r(a: Nat, -b: Nat) -> {1n+Nat.add(a, b) == Nat.add(a, 1n+b) : Nat}:
  Equal.sym(Nat, Nat.add(a, 1n+b), 1n+Nat.add(a, b), add_succ(a, b))

def add_assoc_r(a: Nat, -b: Nat, -c: Nat) -> {Nat.add(a, Nat.add(b, c)) == Nat.add(Nat.add(a, b), c) : Nat}:
  Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), add_assoc(a, b, c))

# The measure
# -----------
# M(s): the inputs a run may still take from s, at most; 0 once it ended.
# A request takes Q = 2 + polls inputs (its preparation, its reply, its
# polls); a retry (noted or not) one more request; a compaction one input
# and one more request; a generation G inputs, its round's end included.
# u is the retries and notes left, U the retries and notes a generation
# starts with.

def Q(+P: Nat) -> Nat:
  2n+P

# what the compactions c and the retries and notes u left in a generation
# may take
def B(+P: Nat, c: Nat, u: Nat) -> Nat:
  Nat.add(Nat.mul(c, 1n+Q(P)), Nat.mul(u, Q(P)))

# what the generation may still take before its round ends
def gen(+P: Nat, ph: Rn.Ph, c: Nat, u: Nat, p: Nat) -> Nat:
  match ph:
    case Rn.Prepare{}:
      Nat.add(Q(P), B(P, c, u))
    case Rn.Call{}:
      1n+Nat.add(p, B(P, c, u))
    case Rn.Compact{over}:
      1n+Nat.add(Q(P), B(P, c, u))
    case Rn.Tools{}:
      0n
    case Rn.Answered{}:
      0n
    case Rn.Aborted{}:
      0n
    case Rn.Failed{why}:
      0n

def G(+P: Nat, +U: Nat) -> Nat:
  1n+gen(P, Rn.Prepare{}, 1n, U, 0n)

def M.ph(+P: Nat, +U: Nat, ph: Rn.Ph, +r: Nat, +c: Nat, +u: Nat, +p: Nat) -> Nat:
  match ph:
    case Rn.Prepare{}:
      Nat.add(gen(P, Rn.Prepare{}, c, u, p), 1n+Nat.mul(r, G(P, U)))
    case Rn.Call{}:
      Nat.add(gen(P, Rn.Call{}, c, u, p), 1n+Nat.mul(r, G(P, U)))
    case Rn.Compact{over}:
      Nat.add(gen(P, Rn.Compact{over}, c, u, p), 1n+Nat.mul(r, G(P, U)))
    case Rn.Tools{}:
      Nat.add(gen(P, Rn.Tools{}, c, u, p), 1n+Nat.mul(r, G(P, U)))
    case Rn.Answered{}:
      0n
    case Rn.Aborted{}:
      0n
    case Rn.Failed{why}:
      0n

def M(+cfg: Rn.Cfg, s: Rn.St) -> Nat:
  match cfg s:
    case Rn.Cfg{cap, P, A, N} Rn.St{ph, r, c, a, n, p}:
      M.ph(P, Nat.add(A, N), ph, r, c, Nat.add(a, n), p)

# a fall within the generation is a fall of M
def lift(k: Nat, -gs: Nat, -gt: Nat, -X: Nat, e: {gs == Nat.add(k, 1n+gt) : Nat}) -> {Nat.add(gs, 1n+X) == Nat.add(k, 1n+Nat.add(gt, 1n+X)) : Nat}:
  %Equal.sym(Nat, gs, Nat.add(k, 1n+gt), e) : {Nat.add(_, 1n+X) == Nat.add(k, 1n+Nat.add(gt, 1n+X)) : Nat}
  add_assoc(k, 1n+gt, 1n+X)

# a run that ends takes no more inputs
def to_end(+gs: Nat, +X: Nat) -> {Nat.add(gs, 1n+X) == Nat.add(Nat.add(gs, X), 1n+0n) : Nat}:
  %add_succ_r(Nat.add(gs, X), 0n) : {Nat.add(gs, 1n+X) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(gs, X), 0n), Nat.add(gs, X), add_zero(Nat.add(gs, X))) : {Nat.add(gs, 1n+X) == 1n+_ : Nat}
  add_succ(gs, X)

# Each input
# ----------

# prepare -> compact: the generation's compaction
def prep_compact(+P: Nat, +d: Nat, +u: Nat) -> {gen(P, Rn.Prepare{}, 1n+d, u, 0n) == Nat.add(1n+P, 1n+gen(P, Rn.Compact{False{}}, d, u, 0n)) : Nat}:
  +mD = Nat.mul(d, 1n+Q(P))
  +mU = Nat.mul(u, Q(P))
  %add_assoc_r(1n+Q(P), mD, mU) : {Nat.add(Q(P), _) == Nat.add(1n+P, 1n+gen(P, Rn.Compact{False{}}, d, u, 0n)) : Nat}
  %add_succ_r(P, gen(P, Rn.Compact{False{}}, d, u, 0n)) : {Nat.add(Q(P), Nat.add(1n+Q(P), Nat.add(mD, mU))) == 1n+_ : Nat}
  {==}

# call -> tools: the generation's round starts
def call_tools(+X: Nat) -> {1n+X == Nat.add(X, 1n+0n) : Nat}:
  %add_succ_r(X, 0n) : {1n+X == _ : Nat}
  %add_zero(X) : {1n+_ == 1n+Nat.add(X, 0n) : Nat}
  {==}

# call -> prepare: a retry, noted or not
def call_retry(+P: Nat, +c: Nat, +b: Nat, +p: Nat) -> {gen(P, Rn.Call{}, c, 1n+b, p) == Nat.add(p, 1n+gen(P, Rn.Prepare{}, c, b, 0n)) : Nat}:
  +mC = Nat.mul(c, 1n+Q(P))
  +mb = Nat.mul(b, Q(P))
  %add_succ_r(p, gen(P, Rn.Prepare{}, c, b, 0n)) : {gen(P, Rn.Call{}, c, 1n+b, p) == _ : Nat}
  %add_lcomm(mC, Q(P), mb) : {gen(P, Rn.Call{}, c, 1n+b, p) == 1n+Nat.add(p, _) : Nat}
  {==}

# call -> prepare: a noted retry spends a note, a + (1 + m) = 1 + (a + m)
def call_note(+P: Nat, +c: Nat, +a: Nat, +m: Nat, +p: Nat) -> {gen(P, Rn.Call{}, c, Nat.add(a, 1n+m), p) == Nat.add(p, 1n+gen(P, Rn.Prepare{}, c, Nat.add(a, m), 0n)) : Nat}:
  %add_succ_r(a, m) : {gen(P, Rn.Call{}, c, _, p) == Nat.add(p, 1n+gen(P, Rn.Prepare{}, c, Nat.add(a, m), 0n)) : Nat}
  call_retry(P, c, Nat.add(a, m), p)

# call -> compact: an overflow's compaction
def call_compact(+P: Nat, +d: Nat, +u: Nat, +p: Nat) -> {gen(P, Rn.Call{}, 1n+d, u, p) == Nat.add(p, 1n+gen(P, Rn.Compact{True{}}, d, u, 0n)) : Nat}:
  +mD = Nat.mul(d, 1n+Q(P))
  +mU = Nat.mul(u, Q(P))
  %add_succ_r(p, gen(P, Rn.Compact{True{}}, d, u, 0n)) : {gen(P, Rn.Call{}, 1n+d, u, p) == _ : Nat}
  %add_assoc(1n+Q(P), mD, mU) : {gen(P, Rn.Call{}, 1n+d, u, p) == 1n+Nat.add(p, _) : Nat}
  {==}

# tools -> prepare: the next generation
def next_gen(+gp: Nat, +X: Nat) -> {Nat.add(0n, 1n+Nat.add(1n+gp, X)) == Nat.add(0n, 1n+Nat.add(gp, 1n+X)) : Nat}:
  %add_succ(gp, X) : {1n+_ == 1n+Nat.add(gp, 1n+X) : Nat}
  {==}

# Each phase
# ----------
# For a live run s and any input e, M falls: M(s) = k + 1 + M(step(s, e)),
# with k = K(cfg, s, e). Once a run ends, M is 0.

# M falls from s to t, by k + 1
def Fall(+cfg: Rn.Cfg, s: Rn.St, k: Nat, t: Rn.St) -> Type:
  {M(cfg, s) == Nat.add(k, 1n+M(cfg, t)) : Nat}

def X(+P: Nat, +U: Nat, r: Nat) -> Nat:
  Nat.mul(r, G(P, U))

def K.prepare_cut(+P: Nat, cut: Bool, c: Nat) -> Nat:
  match cut c:
    case True{} 1n+d:
      1n+P
    case True{} 0n:
      0n
    case False{} c:
      0n

def dec_prepare_cut(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Prepare{}, r, c, a, n, p}, K.prepare_cut(P, cut, c), Rn.prepare.cut(Rn.Cfg{cap, P, A, N}, cut, r, c, a, n)):
  match cut c:
    case True{} 1n+d:
      lift(1n+P, gen(P, Rn.Prepare{}, 1n+d, Nat.add(a, n), p), gen(P, Rn.Compact{False{}}, d, Nat.add(a, n), P), X(P, Nat.add(A, N), r), prep_compact(P, d, Nat.add(a, n)))
    case True{} 0n:
      lift(0n, gen(P, Rn.Prepare{}, 0n, Nat.add(a, n), p), gen(P, Rn.Call{}, 0n, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case False{} +c:
      lift(0n, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), gen(P, Rn.Call{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})

def K.prepare(+P: Nat, reply: Rn.Reply, c: Nat) -> Nat:
  match reply:
    case Rn.Overflow{cut}:
      K.prepare_cut(P, cut, c)
    case Rn.Plain{}:
      0n
    case Rn.Calls{}:
      0n
    case Rn.Deferred{}:
      0n
    case Rn.Error{retryable, noted}:
      0n

def dec_prepare(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Prepare{}, r, c, a, n, p}, K.prepare(P, reply, c), Rn.prepare(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n)):
  match reply:
    case Rn.Overflow{cut}:
      dec_prepare_cut(cap, P, A, N, cut, r, c, a, n, p)
    case Rn.Plain{}:
      lift(0n, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), gen(P, Rn.Call{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case Rn.Calls{}:
      lift(0n, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), gen(P, Rn.Call{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case Rn.Deferred{}:
      lift(0n, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), gen(P, Rn.Call{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case Rn.Error{retryable, noted}:
      lift(0n, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), gen(P, Rn.Call{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})

# the k of a call that ends the run
def K.call_end(+P: Nat, +U: Nat, +r: Nat, +c: Nat, +u: Nat, +p: Nat) -> Nat:
  Nat.add(gen(P, Rn.Call{}, c, u, p), X(P, U, r))

def call_end(+P: Nat, +U: Nat, +r: Nat, +c: Nat, +u: Nat, +p: Nat) -> {Nat.add(gen(P, Rn.Call{}, c, u, p), 1n+X(P, U, r)) == Nat.add(K.call_end(P, U, r, c, u, p), 1n+0n) : Nat}:
  to_end(gen(P, Rn.Call{}, c, u, p), X(P, U, r))

def K.retry(+P: Nat, +U: Nat, retryable: Bool, +r: Nat, +c: Nat, a: Nat, +n: Nat, +p: Nat) -> Nat:
  match retryable a:
    case True{} 1n+b:
      p
    case True{} 0n:
      K.call_end(P, U, r, c, Nat.add(0n, n), p)
    case False{} +a:
      K.call_end(P, U, r, c, Nat.add(a, n), p)

def dec_retry(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, +r: Nat, +c: Nat, a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.retry(P, Nat.add(A, N), retryable, r, c, a, n, p), Rn.retry(Rn.Cfg{cap, P, A, N}, retryable, r, c, a, n, p)):
  match retryable a:
    case True{} 1n+b:
      lift(p, gen(P, Rn.Call{}, c, Nat.add(1n+b, n), p), gen(P, Rn.Prepare{}, c, Nat.add(b, n), P), X(P, Nat.add(A, N), r), call_retry(P, c, Nat.add(b, n), p))
    case True{} 0n:
      call_end(P, Nat.add(A, N), r, c, Nat.add(0n, n), p)
    case False{} +a:
      call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), p)

def K.note(+P: Nat, +U: Nat, +r: Nat, +c: Nat, +a: Nat, n: Nat, +p: Nat) -> Nat:
  match n:
    case 1n+m:
      p
    case 0n:
      K.call_end(P, U, r, c, Nat.add(a, 0n), p)

def dec_note(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +r: Nat, +c: Nat, +a: Nat, n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.note(P, Nat.add(A, N), r, c, a, n, p), Rn.note(Rn.Cfg{cap, P, A, N}, r, c, a, n, p)):
  match n:
    case 1n+m:
      lift(p, gen(P, Rn.Call{}, c, Nat.add(a, 1n+m), p), gen(P, Rn.Prepare{}, c, Nat.add(a, m), P), X(P, Nat.add(A, N), r), call_note(P, c, a, m, p))
    case 0n:
      call_end(P, Nat.add(A, N), r, c, Nat.add(a, 0n), p)

def K.error(+P: Nat, +U: Nat, retryable: Bool, noted: Bool, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Nat:
  match noted:
    case True{}:
      K.note(P, U, r, c, a, n, p)
    case False{}:
      K.retry(P, U, retryable, r, c, a, n, p)

def dec_error(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, noted: Bool, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.error(P, Nat.add(A, N), retryable, noted, r, c, a, n, p), Rn.error(Rn.Cfg{cap, P, A, N}, retryable, noted, r, c, a, n, p)):
  match noted:
    case True{}:
      dec_note(cap, P, A, N, r, c, a, n, p)
    case False{}:
      dec_retry(cap, P, A, N, retryable, r, c, a, n, p)

def K.overflow(+P: Nat, +U: Nat, cut: Bool, +r: Nat, c: Nat, +u: Nat, +p: Nat) -> Nat:
  match cut c:
    case True{} 1n+d:
      p
    case True{} 0n:
      K.call_end(P, U, r, 0n, u, p)
    case False{} +c:
      K.call_end(P, U, r, c, u, p)

def dec_overflow(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.overflow(P, Nat.add(A, N), cut, r, c, Nat.add(a, n), p), Rn.overflow(cut, r, c, a, n, p)):
  match cut c:
    case True{} 1n+d:
      lift(p, gen(P, Rn.Call{}, 1n+d, Nat.add(a, n), p), gen(P, Rn.Compact{True{}}, d, Nat.add(a, n), p), X(P, Nat.add(A, N), r), call_compact(P, d, Nat.add(a, n), p))
    case True{} 0n:
      call_end(P, Nat.add(A, N), r, 0n, Nat.add(a, n), p)
    case False{} +c:
      call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), p)

def K.deferred(+P: Nat, +U: Nat, +r: Nat, +c: Nat, +u: Nat, p: Nat) -> Nat:
  match p:
    case 0n:
      K.call_end(P, U, r, c, u, 0n)
    case 1n+q:
      0n

def dec_deferred(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +r: Nat, +c: Nat, +a: Nat, +n: Nat, p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.deferred(P, Nat.add(A, N), r, c, Nat.add(a, n), p), Rn.call(Rn.Cfg{cap, P, A, N}, Rn.Deferred{}, r, c, a, n, p)):
  match p:
    case 0n:
      call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), 0n)
    case 1n+q:
      lift(0n, gen(P, Rn.Call{}, c, Nat.add(a, n), 1n+q), gen(P, Rn.Call{}, c, Nat.add(a, n), q), X(P, Nat.add(A, N), r), {==})

def K.call(+P: Nat, +U: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Nat:
  match reply:
    case Rn.Plain{}:
      K.call_end(P, U, r, c, Nat.add(a, n), p)
    case Rn.Calls{}:
      Nat.add(p, B(P, c, Nat.add(a, n)))
    case Rn.Deferred{}:
      K.deferred(P, U, r, c, Nat.add(a, n), p)
    case Rn.Error{retryable, noted}:
      K.error(P, U, retryable, noted, r, c, a, n, p)
    case Rn.Overflow{cut}:
      K.overflow(P, U, cut, r, c, Nat.add(a, n), p)

def dec_call(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Call{}, r, c, a, n, p}, K.call(P, Nat.add(A, N), reply, r, c, a, n, p), Rn.call(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n, p)):
  match reply:
    case Rn.Plain{}:
      call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), p)
    case Rn.Calls{}:
      lift(Nat.add(p, B(P, c, Nat.add(a, n))), gen(P, Rn.Call{}, c, Nat.add(a, n), p), 0n, X(P, Nat.add(A, N), r), call_tools(Nat.add(p, B(P, c, Nat.add(a, n)))))
    case Rn.Deferred{}:
      dec_deferred(cap, P, A, N, r, c, a, n, p)
    case Rn.Error{retryable, noted}:
      dec_error(cap, P, A, N, retryable, noted, r, c, a, n, p)
    case Rn.Overflow{cut}:
      dec_overflow(cap, P, A, N, cut, r, c, a, n, p)

def K.compact(+P: Nat, +U: Nat, over: Bool, got: Rn.Got, +r: Nat, +c: Nat, +u: Nat, +p: Nat) -> Nat:
  match over got:
    case over Rn.Built{}:
      0n
    case True{} Rn.Kept{}:
      Nat.add(gen(P, Rn.Compact{True{}}, c, u, p), X(P, U, r))
    case False{} Rn.Kept{}:
      0n
    case over Rn.Broke{}:
      Nat.add(gen(P, Rn.Compact{over}, c, u, p), X(P, U, r))

def dec_compact(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +over: Bool, got: Rn.Got, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Compact{over}, r, c, a, n, p}, K.compact(P, Nat.add(A, N), over, got, r, c, Nat.add(a, n), p), Rn.compact(Rn.Cfg{cap, P, A, N}, over, got, r, c, a, n, p)):
  match over got:
    case over Rn.Built{}:
      lift(0n, gen(P, Rn.Compact{over}, c, Nat.add(a, n), p), gen(P, Rn.Prepare{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case True{} Rn.Kept{}:
      to_end(gen(P, Rn.Compact{True{}}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))
    case False{} Rn.Kept{}:
      lift(0n, gen(P, Rn.Compact{False{}}, c, Nat.add(a, n), p), gen(P, Rn.Prepare{}, c, Nat.add(a, n), P), X(P, Nat.add(A, N), r), {==})
    case over Rn.Broke{}:
      to_end(gen(P, Rn.Compact{over}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))

def K.round(+P: Nat, +U: Nat, reset: Bool, r: Nat) -> Nat:
  match reset r:
    case reset 0n:
      Nat.add(0n, X(P, U, 0n))
    case True{} 1n+s:
      Nat.add(0n, X(P, U, 1n+s))
    case False{} 1n+s:
      0n

def dec_round(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reset: Bool, r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Tools{}, r, c, a, n, p}, K.round(P, Nat.add(A, N), reset, r), Rn.round(Rn.Cfg{cap, P, A, N}, reset, r, c, a, n, p)):
  match reset r:
    case reset 0n:
      to_end(0n, X(P, Nat.add(A, N), 0n))
    case True{} 1n+s:
      to_end(0n, X(P, Nat.add(A, N), 1n+s))
    case False{} 1n+s:
      next_gen(gen(P, Rn.Prepare{}, 1n, Nat.add(A, N), 0n), X(P, Nat.add(A, N), s))

def K.tools(+P: Nat, +U: Nat, fin: Rn.Fin, +r: Nat) -> Nat:
  match fin:
    case Rn.Stops{}:
      Nat.add(0n, X(P, U, r))
    case Rn.Goes{}:
      K.round(P, U, False{}, r)
    case Rn.Resets{}:
      K.round(P, U, True{}, r)

def dec_tools(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, fin: Rn.Fin, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> Fall(Rn.Cfg{cap, P, A, N}, Rn.St{Rn.Tools{}, r, c, a, n, p}, K.tools(P, Nat.add(A, N), fin, r), Rn.tools(Rn.Cfg{cap, P, A, N}, fin, r, c, a, n, p)):
  match fin:
    case Rn.Stops{}:
      to_end(0n, X(P, Nat.add(A, N), r))
    case Rn.Goes{}:
      dec_round(cap, P, A, N, False{}, r, c, a, n, p)
    case Rn.Resets{}:
      dec_round(cap, P, A, N, True{}, r, c, a, n, p)

# k for any input
def K(+cfg: Rn.Cfg, s: Rn.St, e: Rn.Ev) -> Nat:
  match cfg s:
    case Rn.Cfg{cap, P, A, N} Rn.St{ph, r, c, a, n, p}:
      match ph e:
        case Rn.Answered{} e:
          0n
        case Rn.Aborted{} e:
          0n
        case Rn.Failed{why} e:
          0n
        case Rn.Prepare{} Rn.Abort{}:
          Nat.add(gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))
        case Rn.Call{} Rn.Abort{}:
          K.call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), p)
        case Rn.Compact{over} Rn.Abort{}:
          Nat.add(gen(P, Rn.Compact{over}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))
        case Rn.Tools{} Rn.Abort{}:
          Nat.add(0n, X(P, Nat.add(A, N), r))
        case Rn.Prepare{} Rn.Go{reply, fin, got}:
          K.prepare(P, reply, c)
        case Rn.Call{} Rn.Go{reply, fin, got}:
          K.call(P, Nat.add(A, N), reply, r, c, a, n, p)
        case Rn.Compact{over} Rn.Go{reply, fin, got}:
          K.compact(P, Nat.add(A, N), over, got, r, c, Nat.add(a, n), p)
        case Rn.Tools{} Rn.Go{reply, fin, got}:
          K.tools(P, Nat.add(A, N), fin, r)

# the goal of dec at a phase
def FallAt(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +ph: Rn.Ph, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +e: Rn.Ev) -> Type:
  Fall(Rn.Cfg{cap, P, A, N}, Rn.St{ph, r, c, a, n, p}, K(Rn.Cfg{cap, P, A, N}, Rn.St{ph, r, c, a, n, p}, e), Rn.step(Rn.Cfg{cap, P, A, N}, Rn.St{ph, r, c, a, n, p}, e))

# every input to a live run lowers M
def dec(+cfg: Rn.Cfg, +s: Rn.St, +e: Rn.Ev, nd: {Rn.done(s) == False{} : Bool}) -> Fall(cfg, s, K(cfg, s, e), Rn.step(cfg, s, e)):
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph e:
            case Rn.Answered{} e:
              absurd(FallAt(cap, P, A, N, Rn.Answered{}, r, c, a, n, p, e), Equal.sym(Bool, True{}, False{}, nd))
            case Rn.Aborted{} e:
              absurd(FallAt(cap, P, A, N, Rn.Aborted{}, r, c, a, n, p, e), Equal.sym(Bool, True{}, False{}, nd))
            case Rn.Failed{why} e:
              absurd(FallAt(cap, P, A, N, Rn.Failed{why}, r, c, a, n, p, e), Equal.sym(Bool, True{}, False{}, nd))
            case Rn.Prepare{} Rn.Abort{}:
              to_end(gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))
            case Rn.Call{} Rn.Abort{}:
              call_end(P, Nat.add(A, N), r, c, Nat.add(a, n), p)
            case Rn.Compact{over} Rn.Abort{}:
              to_end(gen(P, Rn.Compact{over}, c, Nat.add(a, n), p), X(P, Nat.add(A, N), r))
            case Rn.Tools{} Rn.Abort{}:
              to_end(0n, X(P, Nat.add(A, N), r))
            case Rn.Prepare{} Rn.Go{reply, fin, got}:
              dec_prepare(cap, P, A, N, reply, r, c, a, n, p)
            case Rn.Call{} Rn.Go{reply, fin, got}:
              dec_call(cap, P, A, N, reply, r, c, a, n, p)
            case Rn.Compact{over} Rn.Go{reply, fin, got}:
              dec_compact(cap, P, A, N, over, got, r, c, a, n, p)
            case Rn.Tools{} Rn.Go{reply, fin, got}:
              dec_tools(cap, P, A, N, fin, r, c, a, n, p)

# The run ends
# ------------

# an ended run stays as it is
def end_stays(+cfg: Rn.Cfg, s: Rn.St, e: Rn.Ev, d: {Rn.done(s) == True{} : Bool}) -> {Rn.step(cfg, s, e) == s : Rn.St}:
  match s:
    case Rn.St{ph, r, c, a, n, p}:
      match ph:
        case Rn.Answered{}:
          {==}
        case Rn.Aborted{}:
          {==}
        case Rn.Failed{why}:
          {==}
        case Rn.Prepare{}:
          absurd({Rn.step(cfg, Rn.St{Rn.Prepare{}, r, c, a, n, p}, e) == Rn.St{Rn.Prepare{}, r, c, a, n, p} : Rn.St}, d)
        case Rn.Call{}:
          absurd({Rn.step(cfg, Rn.St{Rn.Call{}, r, c, a, n, p}, e) == Rn.St{Rn.Call{}, r, c, a, n, p} : Rn.St}, d)
        case Rn.Compact{over}:
          absurd({Rn.step(cfg, Rn.St{Rn.Compact{over}, r, c, a, n, p}, e) == Rn.St{Rn.Compact{over}, r, c, a, n, p} : Rn.St}, d)
        case Rn.Tools{}:
          absurd({Rn.step(cfg, Rn.St{Rn.Tools{}, r, c, a, n, p}, e) == Rn.St{Rn.Tools{}, r, c, a, n, p} : Rn.St}, d)

def stays_done(evs: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St, +d: {Rn.done(s) == True{} : Bool}) -> {Rn.done(Rn.run.go(evs, cfg, s)) == True{} : Bool}:
  match evs:
    case Nil{}:
      d
    case e <> rest:
      %Equal.sym(Rn.St, Rn.step(cfg, s, e), s, end_stays(cfg, s, e, d)) : {Rn.done(Rn.run.go(rest, cfg, _)) == True{} : Bool}
      stays_done(rest, cfg, s, d)

def succ_m(+j: Nat, +g: Nat, +X: Nat) -> {Nat.add(j, Nat.add(g, 1n+X)) == 1n+Nat.add(j, Nat.add(g, X)) : Nat}:
  %add_succ_r(g, X) : {Nat.add(j, _) == 1n+Nat.add(j, Nat.add(g, X)) : Nat}
  add_succ(j, Nat.add(g, X))

# a live run may still take an input
def pos(-T: Type, +j: Nat, +g: Nat, +X: Nat, h: {0n == Nat.add(j, Nat.add(g, 1n+X)) : Nat}) -> T:
  zero_succ(T, Nat.add(j, Nat.add(g, X)), Equal.trans(Nat, 0n, Nat.add(j, Nat.add(g, 1n+X)), 1n+Nat.add(j, Nat.add(g, X)), h, succ_m(j, g, X)))

# with no input left, the run has ended
def nil_done(+cfg: Rn.Cfg, +s: Rn.St, +j: Nat, h: {0n == Nat.add(j, M(cfg, s)) : Nat}) -> {Rn.done(s) == True{} : Bool}:
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph:
            case Rn.Prepare{}:
              pos({Rn.done(Rn.St{Rn.Prepare{}, r, c, a, n, p}) == True{} : Bool}, j, gen(P, Rn.Prepare{}, c, Nat.add(a, n), p), Nat.mul(r, G(P, Nat.add(A, N))), h)
            case Rn.Call{}:
              pos({Rn.done(Rn.St{Rn.Call{}, r, c, a, n, p}) == True{} : Bool}, j, gen(P, Rn.Call{}, c, Nat.add(a, n), p), Nat.mul(r, G(P, Nat.add(A, N))), h)
            case Rn.Compact{over}:
              pos({Rn.done(Rn.St{Rn.Compact{over}, r, c, a, n, p}) == True{} : Bool}, j, gen(P, Rn.Compact{over}, c, Nat.add(a, n), p), Nat.mul(r, G(P, Nat.add(A, N))), h)
            case Rn.Tools{}:
              pos({Rn.done(Rn.St{Rn.Tools{}, r, c, a, n, p}) == True{} : Bool}, j, 0n, Nat.mul(r, G(P, Nat.add(A, N))), h)
            case Rn.Answered{}:
              {==}
            case Rn.Aborted{}:
              {==}
            case Rn.Failed{why}:
              {==}

def next_len1(-n: Nat, +j: Nat, +k: Nat, -ms: Nat, -mt: Nat, h: {1n+n == Nat.add(j, ms) : Nat}, eq: {ms == Nat.add(k, 1n+mt) : Nat}) -> {1n+n == 1n+Nat.add(Nat.add(j, k), mt) : Nat}:
  %add_succ(Nat.add(j, k), mt) : {1n+n == _ : Nat}
  %add_assoc_r(j, k, 1n+mt) : {1n+n == _ : Nat}
  %eq : {1n+n == Nat.add(j, _) : Nat}
  h

# one input later, the inputs left still cover M
def next_len(+cfg: Rn.Cfg, +s: Rn.St, +e: Rn.Ev, +j: Nat, -rest: List<&2, Rn.Ev>, h: {1n+List.length(&2, Rn.Ev, rest) == Nat.add(j, M(cfg, s)) : Nat}, nd: {Rn.done(s) == False{} : Bool}) -> {List.length(&2, Rn.Ev, rest) == Nat.add(Nat.add(j, K(cfg, s, e)), M(cfg, Rn.step(cfg, s, e))) : Nat}:
  succ_inj(List.length(&2, Rn.Ev, rest), Nat.add(Nat.add(j, K(cfg, s, e)), M(cfg, Rn.step(cfg, s, e))), next_len1(List.length(&2, Rn.Ev, rest), j, K(cfg, s, e), M(cfg, s), M(cfg, Rn.step(cfg, s, e)), h, dec(cfg, s, e, nd)))

# a run whose inputs cover M has ended after them
def ends(evs: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St, +j: Nat, h: {List.length(&2, Rn.Ev, evs) == Nat.add(j, M(cfg, s)) : Nat}) -> {Rn.done(Rn.run.go(evs, cfg, s)) == True{} : Bool}:
  match evs:
    case Nil{}:
      nil_done(cfg, s, j, h)
    case +e <> rest:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph:
            case Rn.Prepare{}:
              +t = {Rn.St{Rn.Prepare{}, r, c, a, n, p} : Rn.St}
              ends(rest, cfg, Rn.step(cfg, t, e), Nat.add(j, K(cfg, t, e)), next_len(cfg, t, e, j, rest, h, {==}))
            case Rn.Call{}:
              +t = {Rn.St{Rn.Call{}, r, c, a, n, p} : Rn.St}
              ends(rest, cfg, Rn.step(cfg, t, e), Nat.add(j, K(cfg, t, e)), next_len(cfg, t, e, j, rest, h, {==}))
            case Rn.Compact{over}:
              +t = {Rn.St{Rn.Compact{over}, r, c, a, n, p} : Rn.St}
              ends(rest, cfg, Rn.step(cfg, t, e), Nat.add(j, K(cfg, t, e)), next_len(cfg, t, e, j, rest, h, {==}))
            case Rn.Tools{}:
              +t = {Rn.St{Rn.Tools{}, r, c, a, n, p} : Rn.St}
              ends(rest, cfg, Rn.step(cfg, t, e), Nat.add(j, K(cfg, t, e)), next_len(cfg, t, e, j, rest, h, {==}))
            case Rn.Answered{}:
              stays_done(rest, cfg, Rn.St{Rn.Answered{}, r, c, a, n, p}, {==})
            case Rn.Aborted{}:
              stays_done(rest, cfg, Rn.St{Rn.Aborted{}, r, c, a, n, p}, {==})
            case Rn.Failed{why}:
              stays_done(rest, cfg, Rn.St{Rn.Failed{why}, r, c, a, n, p}, {==})

# The bound
# ---------

# a generation: 2 + (U + 2)·(polls + 2), U = retries + notes
def G_eq(+P: Nat, +U: Nat) -> {G(P, U) == 2n+Nat.mul(2n+U, 2n+P) : Nat}:
  +Y = Nat.add(P, Nat.mul(U, Q(P)))
  %Equal.sym(Nat, Nat.add(P, 0n), P, add_zero(P)) : {1n+Nat.add(Q(P), Nat.add(3n+_, Nat.mul(U, Q(P)))) == 2n+Nat.mul(2n+U, 2n+P) : Nat}
  %Equal.sym(Nat, Nat.add(P, Nat.add(3n, Y)), Nat.add(3n, Nat.add(P, Y)), add_lcomm(P, 3n, Y)) : {3n+_ == 2n+Nat.mul(2n+U, 2n+P) : Nat}
  %Equal.sym(Nat, Nat.add(P, Nat.add(2n, Y)), Nat.add(2n, Nat.add(P, Y)), add_lcomm(P, 2n, Y)) : {6n+Nat.add(P, Y) == 4n+_ : Nat}
  {==}

# max(cap, 1) = 1 + (cap - 1)
def max1(cap: Nat) -> {Nat.max(cap, 1n) == 1n+Nat.sub(cap, 1n) : Nat}:
  match cap:
    case 0n:
      {==}
    case 1n+k:
      match k:
        case 0n:
          {==}
        case 1n+j:
          {==}

# bound(cfg) is M at the start
def bound_m(+cfg: Rn.Cfg) -> {Rn.bound(cfg) == M(cfg, Rn.init(cfg)) : Nat}:
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      +U = Nat.add(A, N)
      +gp = gen(P, Rn.Prepare{}, 1n, U, 0n)
      +r0 = Nat.sub(cap, 1n)
      %G_eq(P, U) : {Nat.mul(Nat.max(cap, 1n), _) == M(Rn.Cfg{cap, P, A, N}, Rn.init(Rn.Cfg{cap, P, A, N})) : Nat}
      %Equal.sym(Nat, Nat.max(cap, 1n), 1n+r0, max1(cap)) : {Nat.mul(_, G(P, U)) == M(Rn.Cfg{cap, P, A, N}, Rn.init(Rn.Cfg{cap, P, A, N})) : Nat}
      %add_succ(gp, Nat.mul(r0, G(P, U))) : {_ == Nat.add(gp, 1n+Nat.mul(r0, G(P, U))) : Nat}
      {==}

def run_append(xs: List<&2, Rn.Ev>, -ys: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St) -> {Rn.run.go(List.append(&2, Rn.Ev, xs, ys), cfg, s) == Rn.run.go(ys, cfg, Rn.run.go(xs, cfg, s)) : Rn.St}:
  match xs:
    case Nil{}:
      {==}
    case e <> rest:
      run_append(rest, ys, cfg, Rn.step(cfg, s, e))

# The invariant
# -------------
# After any inputs, with k the counted rounds: the cap ended the run only
# after max(cap, 1) rounds; and a run that did not fail has made
# cap - 1 - r rounds.

def Inv(+cap: Nat, +ph: Rn.Ph, +r: Nat, +k: Nat) -> Type:
  Or({Rn.Ph.capped(ph) == False{} : Bool}, {k == Nat.max(cap, 1n) : Nat}) & Or({Rn.Ph.failed(ph) == True{} : Bool}, {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat})

def InvS(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat) -> Type:
  Inv(Rn.Cfg.cap(cfg), Rn.St.ph(s), Rn.St.r(s), k)

# a live run has not failed
def cap_of(-T: Type, o: Or({False{} == True{} : Bool}, T)) -> T:
  match o:
    case Inl{x}:
      absurd(T, x)
    case Inr{y}:
      y

def eq_refl(n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      eq_refl(p)

def cap_next(n: Nat, -s: Nat, -cap: Nat, capv: {Nat.add(n, 2n+s) == cap : Nat}) -> {1n+Nat.add(n, 1n+s) == cap : Nat}:
  %capv : {1n+Nat.add(n, 1n+s) == _ : Nat}
  add_succ_r(n, 1n+s)

# the round that meets the cap is the max(cap, 1)th
def one_more(+n: Nat, -m: Nat, capv: {Nat.add(n, 1n+0n) == m : Nat}) -> {1n+n == m : Nat}:
  %capv : {1n+n == _ : Nat}
  %add_succ_r(n, 0n) : {1n+n == _ : Nat}
  %Equal.sym(Nat, Nat.add(n, 0n), n, add_zero(n)) : {1n+n == 1n+_ : Nat}
  {==}

def inv_round(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reset: Bool, r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.round(Rn.Cfg{cap, P, A, N}, reset, r, c, a, n, p), 1n+k):
  match reset r:
    case reset 0n:
      (Inr{one_more(k, Nat.max(cap, 1n), capv)}, Inl{{==}})
    case True{} 1n+s:
      (Inl{{==}}, Inr{cap_next(k, s, Nat.max(cap, 1n), capv)})
    case False{} 1n+s:
      (Inl{{==}}, Inr{cap_next(k, s, Nat.max(cap, 1n), capv)})

def inv_tools(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, fin: Rn.Fin, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.tools(Rn.Cfg{cap, P, A, N}, fin, r, c, a, n, p), Rn.counted.go(fin, k)):
  match fin:
    case Rn.Stops{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Goes{}:
      inv_round(cap, P, A, N, False{}, r, c, a, n, p, k, capv)
    case Rn.Resets{}:
      inv_round(cap, P, A, N, True{}, r, c, a, n, p, k, capv)

def inv_prepare_cut(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.prepare.cut(Rn.Cfg{cap, P, A, N}, cut, r, c, a, n), k):
  match cut c:
    case True{} 1n+d:
      (Inl{{==}}, Inr{capv})
    case True{} 0n:
      (Inl{{==}}, Inr{capv})
    case False{} c:
      (Inl{{==}}, Inr{capv})

def inv_prepare(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.prepare(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n), k):
  match reply:
    case Rn.Overflow{cut}:
      inv_prepare_cut(cap, P, A, N, cut, r, c, a, n, k, capv)
    case Rn.Plain{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Calls{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Deferred{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Error{retryable, noted}:
      (Inl{{==}}, Inr{capv})

def inv_retry(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, +r: Nat, +c: Nat, a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.retry(Rn.Cfg{cap, P, A, N}, retryable, r, c, a, n, p), k):
  match retryable a:
    case True{} 1n+b:
      (Inl{{==}}, Inr{capv})
    case True{} 0n:
      (Inl{{==}}, Inl{{==}})
    case False{} a:
      (Inl{{==}}, Inl{{==}})

def inv_note(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +r: Nat, +c: Nat, +a: Nat, n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.note(Rn.Cfg{cap, P, A, N}, r, c, a, n, p), k):
  match n:
    case 1n+m:
      (Inl{{==}}, Inr{capv})
    case 0n:
      (Inl{{==}}, Inl{{==}})

def inv_error(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, noted: Bool, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.error(Rn.Cfg{cap, P, A, N}, retryable, noted, r, c, a, n, p), k):
  match noted:
    case True{}:
      inv_note(cap, P, A, N, r, c, a, n, p, k, capv)
    case False{}:
      inv_retry(cap, P, A, N, retryable, r, c, a, n, p, k, capv)

def inv_overflow(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.overflow(cut, r, c, a, n, p), k):
  match cut c:
    case True{} 1n+d:
      (Inl{{==}}, Inr{capv})
    case True{} 0n:
      (Inl{{==}}, Inl{{==}})
    case False{} c:
      (Inl{{==}}, Inl{{==}})

def inv_call(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.call(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n, p), k):
  match reply:
    case Rn.Plain{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Calls{}:
      (Inl{{==}}, Inr{capv})
    case Rn.Deferred{}:
      match p:
        case 0n:
          (Inl{{==}}, Inl{{==}})
        case 1n+q:
          (Inl{{==}}, Inr{capv})
    case Rn.Error{retryable, noted}:
      inv_error(cap, P, A, N, retryable, noted, r, c, a, n, p, k, capv)
    case Rn.Overflow{cut}:
      inv_overflow(cap, P, A, N, cut, r, c, a, n, p, k, capv)

def inv_compact(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, over: Bool, got: Rn.Got, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, capv: {Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}) -> InvS(Rn.Cfg{cap, P, A, N}, Rn.compact(Rn.Cfg{cap, P, A, N}, over, got, r, c, a, n, p), k):
  match over got:
    case over Rn.Built{}:
      (Inl{{==}}, Inr{capv})
    case True{} Rn.Kept{}:
      (Inl{{==}}, Inl{{==}})
    case False{} Rn.Kept{}:
      (Inl{{==}}, Inr{capv})
    case over Rn.Broke{}:
      (Inl{{==}}, Inl{{==}})

# one input keeps the invariant
def inv_step(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat, +e: Rn.Ev, i: InvS(cfg, s, k)) -> InvS(cfg, Rn.step(cfg, s, e), Rn.counted(Rn.St.ph(s), e, k)):
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph e:
            case Rn.Answered{} e:
              i
            case Rn.Aborted{} e:
              i
            case Rn.Failed{why} e:
              i
            case Rn.Prepare{} Rn.Abort{}:
              (cp, co) = i
              (Inl{{==}}, Inr{cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co)})
            case Rn.Call{} Rn.Abort{}:
              (cp, co) = i
              (Inl{{==}}, Inr{cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co)})
            case Rn.Compact{over} Rn.Abort{}:
              (cp, co) = i
              (Inl{{==}}, Inr{cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co)})
            case Rn.Tools{} Rn.Abort{}:
              (cp, co) = i
              (Inl{{==}}, Inr{cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co)})
            case Rn.Prepare{} Rn.Go{reply, fin, got}:
              (cp, co) = i
              inv_prepare(cap, P, A, N, reply, r, c, a, n, k, cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co))
            case Rn.Call{} Rn.Go{reply, fin, got}:
              (cp, co) = i
              inv_call(cap, P, A, N, reply, r, c, a, n, p, k, cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co))
            case Rn.Compact{over} Rn.Go{reply, fin, got}:
              (cp, co) = i
              inv_compact(cap, P, A, N, over, got, r, c, a, n, p, k, cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co))
            case Rn.Tools{} Rn.Go{reply, fin, got}:
              (cp, co) = i
              inv_tools(cap, P, A, N, fin, r, c, a, n, p, k, cap_of({Nat.add(k, 1n+r) == Nat.max(cap, 1n) : Nat}, co))

def inv_run(evs: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St, +k: Nat, i: InvS(cfg, s, k)) -> InvS(cfg, Rn.run.go(evs, cfg, s), Rn.rounds.go(evs, cfg, s, k)):
  match evs:
    case Nil{}:
      i
    case +e <> rest:
      inv_run(rest, cfg, Rn.step(cfg, s, e), Rn.counted(Rn.St.ph(s), e, k), inv_step(cfg, s, k, e, i))

# a run starts with the invariant
def inv_init(+cfg: Rn.Cfg) -> InvS(cfg, Rn.init(cfg), 0n):
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      (Inl{{==}}, Inr{Equal.sym(Nat, Nat.max(cap, 1n), 1n+Nat.sub(cap, 1n), max1(cap))})

# The laws' conclusions
# ---------------------

def lt_add(x: Nat, -r: Nat) -> {Nat.is_lt(x, Nat.add(x, 1n+r)) == True{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+y:
      lt_add(y, r)

def lt_of(n: Nat, -r: Nat, -cap: Nat, eq: {Nat.add(n, 1n+r) == cap : Nat}) -> {Nat.is_lt(n, cap) == True{} : Bool}:
  %eq : {Nat.is_lt(n, _) == True{} : Bool}
  lt_add(n, r)

# a run that did not fail made fewer than max(cap, 1) rounds
def rounds_of(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat, i: InvS(cfg, s, k)) -> Or({Rn.failed(s) == True{} : Bool}, {Nat.is_lt(k, Nat.max(Rn.Cfg.cap(cfg), 1n)) == True{} : Bool}):
  (cp, co) = i
  match co:
    case Inl{f}:
      Inl{f}
    case Inr{eq}:
      Inr{lt_of(k, Rn.St.r(s), Nat.max(Rn.Cfg.cap(cfg), 1n), eq)}

# a run the cap failed made max(cap, 1) rounds
def caps_of(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat, i: InvS(cfg, s, k)) -> Or({Rn.capped(s) == False{} : Bool}, {k == Nat.max(Rn.Cfg.cap(cfg), 1n) : Nat}):
  (cp, co) = i
  cp

# The polls
# ---------
# After any inputs, with k = the deferred replies in a row: in a call,
# k + p = polls (the polls left and the deferred replies so far make the
# cap); a run the poll cap failed had k = polls + 1.

def PInv.why(+P: Nat, why: Rn.Why, +k: Nat) -> Type:
  match why:
    case Rn.Polls{}:
      {k == 1n+P : Nat}
    case Rn.Model{}:
      Unit
    case Rn.Rounds{}:
      Unit

def PInv.ph(+P: Nat, ph: Rn.Ph, +p: Nat, +k: Nat) -> Type:
  match ph:
    case Rn.Call{}:
      {Nat.add(k, p) == P : Nat}
    case Rn.Failed{why}:
      PInv.why(P, why, k)
    case Rn.Prepare{}:
      Unit
    case Rn.Compact{over}:
      Unit
    case Rn.Tools{}:
      Unit
    case Rn.Answered{}:
      Unit
    case Rn.Aborted{}:
      Unit

def PInv(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat) -> Type:
  PInv.ph(Rn.Cfg.polls(cfg), Rn.St.ph(s), Rn.St.p(s), k)

def pinv_prepare_cut(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.prepare.cut(Rn.Cfg{cap, P, A, N}, cut, r, c, a, n), 0n):
  match cut c:
    case True{} 1n+d:
      Unit{}
    case True{} 0n:
      {==}
    case False{} c:
      {==}

def pinv_prepare(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.prepare(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n), 0n):
  match reply:
    case Rn.Overflow{cut}:
      pinv_prepare_cut(cap, P, A, N, cut, r, c, a, n)
    case Rn.Plain{}:
      {==}
    case Rn.Calls{}:
      {==}
    case Rn.Deferred{}:
      {==}
    case Rn.Error{retryable, noted}:
      {==}

def pinv_retry(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, +r: Nat, +c: Nat, a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.retry(Rn.Cfg{cap, P, A, N}, retryable, r, c, a, n, p), 0n):
  match retryable a:
    case True{} 1n+b:
      Unit{}
    case True{} 0n:
      Unit{}
    case False{} a:
      Unit{}

def pinv_note(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, +r: Nat, +c: Nat, +a: Nat, n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.note(Rn.Cfg{cap, P, A, N}, r, c, a, n, p), 0n):
  match n:
    case 1n+m:
      Unit{}
    case 0n:
      Unit{}

def pinv_error(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, retryable: Bool, noted: Bool, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.error(Rn.Cfg{cap, P, A, N}, retryable, noted, r, c, a, n, p), 0n):
  match noted:
    case True{}:
      pinv_note(cap, P, A, N, r, c, a, n, p)
    case False{}:
      pinv_retry(cap, P, A, N, retryable, r, c, a, n, p)

def pinv_overflow(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, cut: Bool, +r: Nat, c: Nat, +a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.overflow(cut, r, c, a, n, p), 0n):
  match cut c:
    case True{} 1n+d:
      Unit{}
    case True{} 0n:
      Unit{}
    case False{} c:
      Unit{}

# the last poll's deferred reply makes polls + 1 in a row
def polls_full(+k: Nat, -P: Nat, i: {Nat.add(k, 0n) == P : Nat}) -> {1n+k == 1n+P : Nat}:
  %i : {1n+k == 1n+_ : Nat}
  %Equal.sym(Nat, Nat.add(k, 0n), k, add_zero(k)) : {1n+k == 1n+_ : Nat}
  {==}

def pinv_call(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reply: Rn.Reply, +r: Nat, +c: Nat, +a: Nat, +n: Nat, p: Nat, +k: Nat, i: {Nat.add(k, p) == P : Nat}) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.call(Rn.Cfg{cap, P, A, N}, reply, r, c, a, n, p), Rn.defers.reply(reply, k)):
  match reply:
    case Rn.Plain{}:
      Unit{}
    case Rn.Calls{}:
      Unit{}
    case Rn.Deferred{}:
      match p:
        case 0n:
          polls_full(k, P, i)
        case 1n+q:
          %i : {1n+Nat.add(k, q) == _ : Nat}
          add_succ_r(k, q)
    case Rn.Error{retryable, noted}:
      pinv_error(cap, P, A, N, retryable, noted, r, c, a, n, p)
    case Rn.Overflow{cut}:
      pinv_overflow(cap, P, A, N, cut, r, c, a, n, p)

def pinv_compact(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, over: Bool, got: Rn.Got, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.compact(Rn.Cfg{cap, P, A, N}, over, got, r, c, a, n, p), 0n):
  match over got:
    case over Rn.Built{}:
      Unit{}
    case True{} Rn.Kept{}:
      Unit{}
    case False{} Rn.Kept{}:
      Unit{}
    case over Rn.Broke{}:
      Unit{}

def pinv_round(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, reset: Bool, r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.round(Rn.Cfg{cap, P, A, N}, reset, r, c, a, n, p), 0n):
  match reset r:
    case reset 0n:
      Unit{}
    case True{} 1n+s:
      Unit{}
    case False{} 1n+s:
      Unit{}

def pinv_tools(+cap: Nat, +P: Nat, +A: Nat, +N: Nat, fin: Rn.Fin, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> PInv(Rn.Cfg{cap, P, A, N}, Rn.tools(Rn.Cfg{cap, P, A, N}, fin, r, c, a, n, p), 0n):
  match fin:
    case Rn.Stops{}:
      Unit{}
    case Rn.Goes{}:
      pinv_round(cap, P, A, N, False{}, r, c, a, n, p)
    case Rn.Resets{}:
      pinv_round(cap, P, A, N, True{}, r, c, a, n, p)

# one input keeps the poll invariant
def pinv_step(+cfg: Rn.Cfg, +s: Rn.St, +e: Rn.Ev, +k: Nat, i: PInv(cfg, s, k)) -> PInv(cfg, Rn.step(cfg, s, e), Rn.defers.at(Rn.St.ph(s), e, k)):
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph e:
            case Rn.Answered{} e:
              i
            case Rn.Aborted{} e:
              i
            case Rn.Failed{why} e:
              i
            case Rn.Prepare{} Rn.Abort{}:
              Unit{}
            case Rn.Call{} Rn.Abort{}:
              Unit{}
            case Rn.Compact{over} Rn.Abort{}:
              Unit{}
            case Rn.Tools{} Rn.Abort{}:
              Unit{}
            case Rn.Prepare{} Rn.Go{reply, fin, got}:
              pinv_prepare(cap, P, A, N, reply, r, c, a, n)
            case Rn.Call{} Rn.Go{reply, fin, got}:
              pinv_call(cap, P, A, N, reply, r, c, a, n, p, k, i)
            case Rn.Compact{over} Rn.Go{reply, fin, got}:
              pinv_compact(cap, P, A, N, over, got, r, c, a, n, p)
            case Rn.Tools{} Rn.Go{reply, fin, got}:
              pinv_tools(cap, P, A, N, fin, r, c, a, n, p)

def pinv_run(evs: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St, +k: Nat, i: PInv(cfg, s, k)) -> PInv(cfg, Rn.run.go(evs, cfg, s), Rn.defers.go(evs, cfg, s, k)):
  match evs:
    case Nil{}:
      i
    case +e <> rest:
      pinv_run(rest, cfg, Rn.step(cfg, s, e), Rn.defers.at(Rn.St.ph(s), e, k), pinv_step(cfg, s, e, k, i))

# a run the poll cap failed had polls + 1 deferred replies in a row
def polls_of(+cfg: Rn.Cfg, +s: Rn.St, +k: Nat, i: PInv(cfg, s, k)) -> Or({Rn.polled(s) == False{} : Bool}, {k == 1n+Rn.Cfg.polls(cfg) : Nat}):
  match cfg:
    case Rn.Cfg{cap, P, A, N}:
      match s:
        case Rn.St{ph, r, c, a, n, p}:
          match ph:
            case Rn.Failed{why}:
              match why:
                case Rn.Polls{}:
                  Inr{i}
                case Rn.Model{}:
                  Inl{{==}}
                case Rn.Rounds{}:
                  Inl{{==}}
            case Rn.Prepare{}:
              Inl{{==}}
            case Rn.Call{}:
              Inl{{==}}
            case Rn.Compact{over}:
              Inl{{==}}
            case Rn.Tools{}:
              Inl{{==}}
            case Rn.Answered{}:
              Inl{{==}}
            case Rn.Aborted{}:
              Inl{{==}}

# The laws
# --------

def run_ends(+cfg: Rn.Cfg, +xs: List<&2, Rn.Ev>, h: {List.length(&2, Rn.Ev, xs) == Rn.bound(cfg) : Nat}, +more: List<&2, Rn.Ev>) -> {Rn.done(Rn.run(cfg, List.append(&2, Rn.Ev, xs, more))) == True{} : Bool}:
  %Equal.sym(Rn.St, Rn.run.go(List.append(&2, Rn.Ev, xs, more), cfg, Rn.init(cfg)), Rn.run.go(more, cfg, Rn.run.go(xs, cfg, Rn.init(cfg))), run_append(xs, more, cfg, Rn.init(cfg))) : {Rn.done(_) == True{} : Bool}
  stays_done(more, cfg, Rn.run.go(xs, cfg, Rn.init(cfg)), ends(xs, cfg, Rn.init(cfg), 0n, Equal.trans(Nat, List.length(&2, Rn.Ev, xs), Rn.bound(cfg), M(cfg, Rn.init(cfg)), h, bound_m(cfg))))

def abort_now(+cfg: Rn.Cfg, s: Rn.St, nd: {Rn.done(s) == False{} : Bool}) -> {Rn.St.ph(Rn.step(cfg, s, Rn.Abort{})) == Rn.Aborted{} : Rn.Ph}:
  match s:
    case Rn.St{ph, r, c, a, n, p}:
      match ph:
        case Rn.Prepare{}:
          {==}
        case Rn.Call{}:
          {==}
        case Rn.Compact{over}:
          {==}
        case Rn.Tools{}:
          {==}
        case Rn.Answered{}:
          absurd({Rn.St.ph(Rn.step(cfg, Rn.St{Rn.Answered{}, r, c, a, n, p}, Rn.Abort{})) == Rn.Aborted{} : Rn.Ph}, Equal.sym(Bool, True{}, False{}, nd))
        case Rn.Aborted{}:
          {==}
        case Rn.Failed{why}:
          absurd({Rn.St.ph(Rn.step(cfg, Rn.St{Rn.Failed{why}, r, c, a, n, p}, Rn.Abort{})) == Rn.Aborted{} : Rn.Ph}, Equal.sym(Bool, True{}, False{}, nd))

def rounds_capped(+cfg: Rn.Cfg, +evs: List<&2, Rn.Ev>) -> Or({Rn.failed(Rn.run(cfg, evs)) == True{} : Bool}, {Nat.is_lt(Rn.rounds(cfg, evs), Nat.max(Rn.Cfg.cap(cfg), 1n)) == True{} : Bool}):
  rounds_of(cfg, Rn.run(cfg, evs), Rn.rounds(cfg, evs), inv_run(evs, cfg, Rn.init(cfg), 0n, inv_init(cfg)))

def rounds_fail_at_cap(+cfg: Rn.Cfg, +evs: List<&2, Rn.Ev>) -> Or({Rn.capped(Rn.run(cfg, evs)) == False{} : Bool}, {Rn.rounds(cfg, evs) == Nat.max(Rn.Cfg.cap(cfg), 1n) : Nat}):
  caps_of(cfg, Rn.run(cfg, evs), Rn.rounds(cfg, evs), inv_run(evs, cfg, Rn.init(cfg), 0n, inv_init(cfg)))

def polls_need_defers(+cfg: Rn.Cfg, +evs: List<&2, Rn.Ev>) -> Or({Rn.polled(Rn.run(cfg, evs)) == False{} : Bool}, {Rn.defers(cfg, evs) == 1n+Rn.Cfg.polls(cfg) : Nat}):
  polls_of(cfg, Rn.run(cfg, evs), Rn.defers(cfg, evs), pinv_run(evs, cfg, Rn.init(cfg), 0n, Unit{}))

# a message that ends the model's turn with no text and no tool call steps
# as a noted error does: a retry with a note while notes are left, else
# the run fails on the model
def no_answer(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> {Rn.call(cfg, Rn.Ended.reply(Rn.Ended{False{}, False{}}), r, c, a, n, p) == Rn.note(cfg, r, c, a, n, p) : Rn.St}:
  {==}

# a message with a tool call goes to the tools phase, whatever its text
def calls_never_answer(+cfg: Rn.Cfg, -text: Bool, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> {Rn.call(cfg, Rn.Ended.reply(Rn.Ended{text, True{}}), r, c, a, n, p) == Rn.St{Rn.Tools{}, r, c, a, n, p} : Rn.St}:
  {==}

# a noted error spends a note, retryable or not, and keeps the retries
def note_spends_no_retry(+cfg: Rn.Cfg, -retryable: Bool, +r: Nat, +c: Nat, +a: Nat, +m: Nat, +p: Nat) -> {Rn.call(cfg, Rn.Error{retryable, True{}}, r, c, a, 1n+m, p) == Rn.St{Rn.Prepare{}, r, c, a, m, Rn.Cfg.polls(cfg)} : Rn.St}:
  {==}

# a retryable error that is not noted spends a retry and keeps the notes
def retry_spends_no_note(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +b: Nat, +n: Nat, +p: Nat) -> {Rn.call(cfg, Rn.Error{True{}, False{}}, r, c, 1n+b, n, p) == Rn.St{Rn.Prepare{}, r, c, b, n, Rn.Cfg.polls(cfg)} : Rn.St}:
  {==}


# The decisions Rust calls (H4.9)
# --------------------------------
# rk.*: the lemmas of the laws of LAWS.bend (H4.9) and of
# rec_recover_is_the_rust_rule: each decision of bend/run.bend that
# Rust calls is the rule decide.rs wrote (the counts left are exact,
# by induction on the counts and the limits), the counts left lose
# nothing (m - (m - x) = x for x <= m), and the core's cap changes no
# decision.

def rk.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def rk.wait(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +a: Nat, +n: Nat, +w: Nat, +x: Nat) -> {Rn.Then.ph(False{}, Rn.St.ph(Rn.call(cfg, Rn.Deferred{}, r, c, a, n, Nat.sub(w, x)))) == Laws.rust.wait(Nat.is_lt(x, w)) : Rn.Then}:
  match w x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.wait(cfg, r, c, a, n, v, y)

def rk.notes(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +a: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.Then.ph(True{}, Rn.St.ph(Rn.note(cfg, r, c, a, Nat.sub(m, x), p))) == Laws.rust.noted(Nat.is_lt(x, m)) : Rn.Then}:
  match m x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.notes(cfg, r, c, a, p, v, y)

def rk.retry(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +n: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.Then.ph(False{}, Rn.St.ph(Rn.retry(cfg, True{}, r, c, Nat.sub(m, x), n, p))) == Laws.rust.retry(Nat.is_lt(x, m)) : Rn.Then}:
  match m x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.retry(cfg, r, c, n, p, v, y)

def rk.over(+cfg: Rn.Cfg, +r: Nat, +a: Nat, +n: Nat, +p: Nat, +compacted: Bool, +cut: Bool) -> {Rn.Then.ph(False{}, Rn.St.ph(Rn.call(cfg, Rn.Overflow{cut}, r, Rn.c.of(compacted), a, n, p))) == Laws.rust.over(Bool.and(cut, Bool.not(compacted))) : Rn.Then}:
  match compacted cut:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def rk.run_reply_is_the_rust_rule(+l: Rn.Lim, +t: Rn.At, +reply: Rn.Reply) -> {Rn.decide.reply(l, t, reply) == Laws.rust.after_reply(l, t, reply) : Rn.Then}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          match reply:
            case Rn.Plain{}:
              {==}
            case Rn.Calls{}:
              {==}
            case Rn.Deferred{}:
              rk.wait(Rn.Cfg{rounds, wait, retries, most}, 0n, Rn.c.of(compacted), Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes)), Nat.sub(most, notes), wait, waited)
            case Rn.Error{retryable, noted}:
              match retryable noted:
                case retryable True{}:
                  rk.notes(Rn.Cfg{rounds, wait, retries, most}, 0n, Rn.c.of(compacted), Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes)), Nat.sub(wait, waited), most, notes)
                case True{} False{}:
                  rk.retry(Rn.Cfg{rounds, wait, retries, most}, 0n, Rn.c.of(compacted), Nat.sub(most, notes), Nat.sub(wait, waited), retries, Nat.sub(Nat.sub(attempt, 1n), notes))
                case False{} False{}:
                  {==}
            case Rn.Overflow{cut}:
              rk.over(Rn.Cfg{rounds, wait, retries, most}, 0n, Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes)), Nat.sub(most, notes), Nat.sub(wait, waited), compacted, cut)

def rk.run_prepare_is_the_rust_rule(+compacted: Bool, +th: Rn.Th) -> {Rn.decide.prepare(compacted, th) == Laws.rust.before_request(compacted, th) : Rn.Prepared}:
  match compacted th:
    case True{} Rn.Under{}:
      {==}
    case True{} Rn.Background{}:
      {==}
    case True{} Rn.Blocking{}:
      {==}
    case False{} Rn.Under{}:
      {==}
    case False{} Rn.Background{}:
      {==}
    case False{} Rn.Blocking{}:
      {==}

def rk.run_prepare_compacted_reads_no_threshold(+th: Rn.Th) -> {Rn.decide.prepare(True{}, th) == Rn.decide.prepare(True{}, Rn.Under{}) : Rn.Prepared}:
  match th:
    case Rn.Under{}:
      {==}
    case Rn.Background{}:
      {==}
    case Rn.Blocking{}:
      {==}

def rk.run_compact_is_the_rust_rule(+over: Bool, +got: Rn.Got) -> {Rn.decide.compact(over, got) == Laws.rust.after_compaction(over, got) : Bool}:
  match over got:
    case True{} Rn.Built{}:
      {==}
    case True{} Rn.Kept{}:
      {==}
    case True{} Rn.Broke{}:
      {==}
    case False{} Rn.Built{}:
      {==}
    case False{} Rn.Kept{}:
      {==}
    case False{} Rn.Broke{}:
      {==}

def rk.lt_pred(+m: Nat, +x: Nat) -> {Nat.is_lt(x, Nat.sub(m, 1n)) == Nat.is_lt(1n+x, m) : Bool}:
  match m:
    case 0n:
      match x:
        case 0n:
          {==}
        case 1n+y:
          {==}
    case 1n+v:
      match v:
        case 0n:
          {==}
        case 1n+u:
          {==}

def rk.round_t(+cfg: Rn.Cfg, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, +m: Nat, +x: Nat) -> {Rn.End.ph(Rn.Resets{}, k, Rn.St.ph(Rn.round(cfg, True{}, Nat.sub(m, x), c, a, n, p))) == Laws.rust.next(Nat.is_lt(x, m), True{}, k) : Rn.End}:
  match m x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.round_t(cfg, c, a, n, p, k, v, y)

def rk.round_f(+cfg: Rn.Cfg, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +k: Nat, +m: Nat, +x: Nat) -> {Rn.End.ph(Rn.Goes{}, k, Rn.St.ph(Rn.round(cfg, False{}, Nat.sub(m, x), c, a, n, p))) == Laws.rust.next(Nat.is_lt(x, m), False{}, k) : Rn.End}:
  match m x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.round_f(cfg, c, a, n, p, k, v, y)

def rk.run_round_is_the_rust_rule(+l: Rn.Lim, +count: Nat, +stops: Bool, +reset: Bool) -> {Rn.decide.round(l, count, stops, reset) == Laws.rust.round_end(l, count, stops, reset) : Rn.End}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match stops reset:
        case True{} reset:
          {==}
        case False{} True{}:
          %rk.lt_pred(rounds, count) : {Rn.End.ph(Rn.Resets{}, count, Rn.St.ph(Rn.round(Rn.Cfg{rounds, wait, retries, most}, True{}, Nat.sub(Nat.sub(rounds, 1n), count), 0n, 0n, 0n, 0n))) == Laws.rust.next(_, True{}, count) : Rn.End}
          rk.round_t(Rn.Cfg{rounds, wait, retries, most}, 0n, 0n, 0n, 0n, count, Nat.sub(rounds, 1n), count)
        case False{} False{}:
          %rk.lt_pred(rounds, count) : {Rn.End.ph(Rn.Goes{}, count, Rn.St.ph(Rn.round(Rn.Cfg{rounds, wait, retries, most}, False{}, Nat.sub(Nat.sub(rounds, 1n), count), 0n, 0n, 0n, 0n))) == Laws.rust.next(_, False{}, count) : Rn.End}
          rk.round_f(Rn.Cfg{rounds, wait, retries, most}, 0n, 0n, 0n, 0n, count, Nat.sub(rounds, 1n), count)

def rk.below(+a: Nat, +b: Nat) -> {Nat.is_lt(a, b) == Rn.below(a, b) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      rk.below(p, q)

def rk.long(+b: Bool, +n: Nat, +same: Nat, +last: Nat, +r: Rn.Rec) -> {Rn.Help.of(Rn.rec.long(b, n, same, last, r)) == Laws.rust.redo(b, n, Rn.Quits{}) : Rn.Help}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def rk.leak(+b: Bool, +n: Nat, +same: Nat, +last: Nat, +r: Rn.Rec) -> {Rn.Help.of(Rn.rec.leak(b, n, same, last, r)) == Laws.rust.redo(b, n, Rn.Stands{}) : Rn.Help}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def rk.ran(+fresh: Bool, +under: Bool, +m: Nat, +h: Nat, +n: Nat, +same: Nat, +last: Nat, +r: Rn.Rec) -> {Rn.Help.of(Rn.rec.ran(fresh, under, True{}, m, h, n, same, last, r)) == Laws.rust.calls(fresh, Laws.rust.redo(under, n, Rn.Quits{})) : Rn.Help}:
  match fresh under:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def rk.again(+before: Nat) -> {1n+before == Rn.again(before, 0n, 0n) : Nat}:
  match before:
    case 0n:
      {==}
    case 1n+j:
      {==}

def rk.long_row(+k: Rn.Rk, +row: Nat) -> {Rn.Rk.longs(k, row) == Laws.rust.long_row(k, row) : Nat}:
  match k:
    case Rn.Free{}:
      {==}
    case Rn.Longs{}:
      {==}
    case Rn.Leaks{}:
      {==}
    case Rn.Loops{}:
      {==}

def rk.leak_row(+k: Rn.Rk, +row: Nat) -> {Rn.Rk.leaks(k, row) == Laws.rust.leak_row(k, row) : Nat}:
  match k:
    case Rn.Free{}:
      {==}
    case Rn.Longs{}:
      {==}
    case Rn.Leaks{}:
      {==}
    case Rn.Loops{}:
      {==}

def rk.loop_row(+k: Rn.Rk, +row: Nat) -> {Rn.Rk.loops(k, row) == Laws.rust.loop_row(k, row) : Nat}:
  match k:
    case Rn.Free{}:
      {==}
    case Rn.Longs{}:
      {==}
    case Rn.Leaks{}:
      {==}
    case Rn.Loops{}:
      {==}

def rk.rec_recover_is_the_rust_rule(+rc: Rn.RCfg, +s: Rn.Stuck, +k: Rn.Rk, +row: Nat) -> {Rn.decide.recover(rc, s, k, row) == Laws.rust.recover(rc, s, k, row) : Rn.Help}:
  match rc:
    case Rn.RCfg{+long, +leak, +redirect, +repeat}:
      match s:
        case Rn.Truncated{}:
          +x = Rn.Rk.longs(k, row)
          +r = {Rn.Rec{k, row, 0n, 0n} : Rn.Rec}
          %rk.long_row(k, row) : {Rn.Help.of(Rn.rec.long(Rn.below(x, long), x, 0n, 0n, r)) == Laws.rust.redo(Nat.is_lt(_, long), _, Rn.Quits{}) : Rn.Help}
          %rk.below(x, long) : {Rn.Help.of(Rn.rec.long(_, x, 0n, 0n, r)) == Laws.rust.redo(Nat.is_lt(x, long), x, Rn.Quits{}) : Rn.Help}
          rk.long(Nat.is_lt(x, long), x, 0n, 0n, r)
        case Rn.Leaked{}:
          +x = Rn.Rk.leaks(k, row)
          +r = {Rn.Rec{k, row, 0n, 0n} : Rn.Rec}
          %rk.leak_row(k, row) : {Rn.Help.of(Rn.rec.leak(Rn.below(x, leak), x, 0n, 0n, r)) == Laws.rust.redo(Nat.is_lt(_, leak), _, Rn.Stands{}) : Rn.Help}
          %rk.below(x, leak) : {Rn.Help.of(Rn.rec.leak(_, x, 0n, 0n, r)) == Laws.rust.redo(Nat.is_lt(x, leak), x, Rn.Stands{}) : Rn.Help}
          rk.leak(Nat.is_lt(x, leak), x, 0n, 0n, r)
        case Rn.Repeats{+before}:
          +y = Rn.Rk.loops(k, row)
          +r = {Rn.Rec{k, row, before, 0n} : Rn.Rec}
          %rk.again(before) : {Rn.Help.of(Rn.rec.ran(Rn.below(_, repeat), Rn.below(y, redirect), True{}, _, 0n, y, before, 0n, r)) == Laws.rust.calls(Nat.is_lt(1n+before, repeat), Laws.rust.redo(Nat.is_lt(Laws.rust.loop_row(k, row), redirect), Laws.rust.loop_row(k, row), Rn.Quits{})) : Rn.Help}
          %rk.loop_row(k, row) : {Rn.Help.of(Rn.rec.ran(Rn.below(1n+before, repeat), Rn.below(y, redirect), True{}, 1n+before, 0n, y, before, 0n, r)) == Laws.rust.calls(Nat.is_lt(1n+before, repeat), Laws.rust.redo(Nat.is_lt(_, redirect), _, Rn.Quits{})) : Rn.Help}
          %rk.below(1n+before, repeat) : {Rn.Help.of(Rn.rec.ran(_, Rn.below(y, redirect), True{}, 1n+before, 0n, y, before, 0n, r)) == Laws.rust.calls(Nat.is_lt(1n+before, repeat), Laws.rust.redo(Nat.is_lt(y, redirect), y, Rn.Quits{})) : Rn.Help}
          %rk.below(y, redirect) : {Rn.Help.of(Rn.rec.ran(Nat.is_lt(1n+before, repeat), _, True{}, 1n+before, 0n, y, before, 0n, r)) == Laws.rust.calls(Nat.is_lt(1n+before, repeat), Laws.rust.redo(Nat.is_lt(y, redirect), y, Rn.Quits{})) : Rn.Help}
          rk.ran(Nat.is_lt(1n+before, repeat), Nat.is_lt(y, redirect), 1n+before, 0n, y, before, 0n, r)

def rk.gt(+w: Nat, +x: Nat) -> {Nat.is_lt(x, w) == Nat.is_gt(Nat.sub(w, x), 0n) : Bool}:
  match w x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.gt(v, y)

def rk.eq0(+w: Nat, +x: Nat) -> {Bool.not(Nat.is_lt(x, w)) == Nat.is_eq(Nat.sub(w, x), 0n) : Bool}:
  match w x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+v 0n:
      {==}
    case 1n+v 1n+y:
      rk.eq0(v, y)

def rk.job(+retryable: Bool, +b1: Bool, +b2: Bool, +failed: Nat, +left: Nat, +gap: Nat) -> {Laws.rust.job(Bool.and(retryable, b1), Laws.rust.wait(b2)) == R.Step.act(R.live.failed(Bool.and(retryable, Bool.and(b1, b2)), failed, left, gap)) : R.Act}:
  match retryable b1 b2:
    case True{} True{} True{}:
      {==}
    case True{} True{} False{}:
      {==}
    case True{} False{} b2:
      {==}
    case False{} b1 b2:
      {==}

def rk.later(+b: Bool, +left: Nat, +gap: Nat) -> {Laws.rust.later(Laws.rust.wait(b)) == R.Step.act(R.live.pending(Bool.not(b), left, gap)) : R.Act}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def rk.run_failed_poll_is_the_job_model(+l: Rn.Lim, +t: Rn.At, +retryable: Bool, +failed: Nat, +budget: Nat, +gap: Nat) -> {Laws.rust.job(Rn.decide.poll(retryable, failed, Rn.Lim.retries(l)), Rn.decide.reply(l, t, Rn.Deferred{})) == R.Step.act(R.step(Rn.Lim.retries(l), budget, R.Live{failed, Rn.At.p(l, t)}, R.Broke{retryable, gap})) : R.Act}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          +cfg = {Rn.Cfg{rounds, wait, retries, most} : Rn.Cfg}
          +c = Rn.c.of(compacted)
          +a = Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes))
          +n = Nat.sub(most, notes)
          +ph = Rn.Then.ph(False{}, Rn.St.ph(Rn.call(cfg, Rn.Deferred{}, 0n, c, a, n, Nat.sub(wait, waited))))
          %Equal.sym(Rn.Then, ph, Laws.rust.wait(Nat.is_lt(waited, wait)), rk.wait(cfg, 0n, c, a, n, wait, waited)) : {Laws.rust.job(Bool.and(retryable, Nat.is_lt(failed, retries)), _) == R.Step.act(R.step(retries, budget, R.Live{failed, Nat.sub(wait, waited)}, R.Broke{retryable, gap})) : R.Act}
          %rk.gt(wait, waited) : {Laws.rust.job(Bool.and(retryable, Nat.is_lt(failed, retries)), Laws.rust.wait(Nat.is_lt(waited, wait))) == R.Step.act(R.live.failed(Bool.and(retryable, Bool.and(Nat.is_lt(failed, retries), _)), failed, Nat.sub(wait, waited), gap)) : R.Act}
          rk.job(retryable, Nat.is_lt(failed, retries), Nat.is_lt(waited, wait), failed, Nat.sub(wait, waited), gap)

def rk.run_deferred_reply_is_the_job_model(+l: Rn.Lim, +t: Rn.At, +fails: Nat, +budget: Nat, +failed: Nat, +gap: Nat) -> {Laws.rust.later(Rn.decide.reply(l, t, Rn.Deferred{})) == R.Step.act(R.step(fails, budget, R.Live{failed, Rn.At.p(l, t)}, R.Later{gap})) : R.Act}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          +cfg = {Rn.Cfg{rounds, wait, retries, most} : Rn.Cfg}
          +c = Rn.c.of(compacted)
          +a = Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes))
          +n = Nat.sub(most, notes)
          +ph = Rn.Then.ph(False{}, Rn.St.ph(Rn.call(cfg, Rn.Deferred{}, 0n, c, a, n, Nat.sub(wait, waited))))
          %Equal.sym(Rn.Then, ph, Laws.rust.wait(Nat.is_lt(waited, wait)), rk.wait(cfg, 0n, c, a, n, wait, waited)) : {Laws.rust.later(_) == R.Step.act(R.step(fails, budget, R.Live{failed, Nat.sub(wait, waited)}, R.Later{gap})) : R.Act}
          %rk.eq0(wait, waited) : {Laws.rust.later(Laws.rust.wait(Nat.is_lt(waited, wait))) == R.Step.act(R.live.pending(_, Nat.sub(wait, waited), gap)) : R.Act}
          rk.later(Nat.is_lt(waited, wait), Nat.sub(wait, waited), gap)

def rk.run_first_deferred_reply_is_the_job_model(+l: Rn.Lim, +t: Rn.At, +fails: Nat, +gap: Nat) -> {Laws.rust.later(Rn.decide.reply(l, t, Rn.Deferred{})) == R.Step.act(R.step(fails, Rn.At.p(l, t), R.NoJob{}, R.Later{gap})) : R.Act}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          +cfg = {Rn.Cfg{rounds, wait, retries, most} : Rn.Cfg}
          +c = Rn.c.of(compacted)
          +a = Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes))
          +n = Nat.sub(most, notes)
          +ph = Rn.Then.ph(False{}, Rn.St.ph(Rn.call(cfg, Rn.Deferred{}, 0n, c, a, n, Nat.sub(wait, waited))))
          %Equal.sym(Rn.Then, ph, Laws.rust.wait(Nat.is_lt(waited, wait)), rk.wait(cfg, 0n, c, a, n, wait, waited)) : {Laws.rust.later(_) == R.Step.act(R.step(fails, Nat.sub(wait, waited), R.NoJob{}, R.Later{gap})) : R.Act}
          %rk.eq0(wait, waited) : {Laws.rust.later(Laws.rust.wait(Nat.is_lt(waited, wait))) == R.Step.act(R.live.pending(_, Nat.sub(wait, waited), gap)) : R.Act}
          rk.later(Nat.is_lt(waited, wait), Nat.sub(wait, waited), gap)

def rk.absurd(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : rk.BD(_, A, Unit)
  Unit{}

def rk.sub0(+x: Nat) -> {x == Nat.sub(x, 0n) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+y:
      {==}

def rk.rpred_t(+cfg: Rn.Cfg, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.St.r(Rn.round(cfg, True{}, Nat.sub(m, x), c, a, n, p)) == Nat.sub(m, 1n+x) : Nat}:
  match m x:
    case 0n x:
      {==}
    case 1n+v 0n:
      rk.sub0(v)
    case 1n+v 1n+y:
      rk.rpred_t(cfg, c, a, n, p, v, y)

def rk.rpred_f(+cfg: Rn.Cfg, +c: Nat, +a: Nat, +n: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.St.r(Rn.round(cfg, False{}, Nat.sub(m, x), c, a, n, p)) == Nat.sub(m, 1n+x) : Nat}:
  match m x:
    case 0n x:
      {==}
    case 1n+v 0n:
      rk.sub0(v)
    case 1n+v 1n+y:
      rk.rpred_f(cfg, c, a, n, p, v, y)

def rk.run_round_counts_down(+l: Rn.Lim, +count: Nat, +reset: Bool, +c: Nat, +a: Nat, +n: Nat, +p: Nat) -> {Rn.St.r(Rn.tools(Rn.Lim.cfg(l), Rn.fin.of(False{}, reset), Rn.Lim.r(l, count), c, a, n, p)) == Rn.Lim.r(l, 1n+count) : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match reset:
        case True{}:
          rk.rpred_t(Rn.Cfg{rounds, wait, retries, most}, c, a, n, p, Nat.sub(rounds, 1n), count)
        case False{}:
          rk.rpred_f(Rn.Cfg{rounds, wait, retries, most}, c, a, n, p, Nat.sub(rounds, 1n), count)

def rk.npred(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +a: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.St.n(Rn.note(cfg, r, c, a, Nat.sub(m, x), p)) == Nat.sub(m, 1n+x) : Nat}:
  match m x:
    case 0n x:
      {==}
    case 1n+v 0n:
      rk.sub0(v)
    case 1n+v 1n+y:
      rk.npred(cfg, r, c, a, p, v, y)

def rk.na(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +a: Nat, +p: Nat, +n: Nat) -> {a == Rn.St.a(Rn.note(cfg, r, c, a, n, p)) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      {==}

def rk.s1(+x: Nat, +y: Nat) -> {Nat.sub(Nat.sub(x, 1n), y) == Nat.sub(Nat.sub(1n+x, 1n), 1n+y) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+u:
      match u:
        case 0n:
          {==}
        case 1n+v:
          {==}

def rk.run_note_counts_down(+l: Rn.Lim, +t: Rn.At, +r: Nat, +c: Nat, +p: Nat) -> {Rn.St.n(Rn.note(Rn.Lim.cfg(l), r, c, Rn.At.a(l, t), Rn.At.n(l, t), p)) == Rn.At.n(l, Laws.rust.noted_next(t)) : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          rk.npred(Rn.Cfg{rounds, wait, retries, most}, r, c, Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes)), p, most, notes)

def rk.run_note_keeps_the_retries(+l: Rn.Lim, +t: Rn.At, +r: Nat, +c: Nat, +p: Nat) -> {Rn.St.a(Rn.note(Rn.Lim.cfg(l), r, c, Rn.At.a(l, t), Rn.At.n(l, t), p)) == Rn.At.a(l, Laws.rust.noted_next(t)) : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          +cfg = {Rn.Cfg{rounds, wait, retries, most} : Rn.Cfg}
          +a = Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes))
          %rk.na(cfg, r, c, a, p, Nat.sub(most, notes)) : {_ == Nat.sub(retries, Nat.sub(Nat.sub(1n+attempt, 1n), 1n+notes)) : Nat}
          %rk.s1(attempt, notes) : {a == Nat.sub(retries, _) : Nat}
          {==}

def rk.apred(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +n: Nat, +p: Nat, +m: Nat, +x: Nat) -> {Rn.St.a(Rn.retry(cfg, True{}, r, c, Nat.sub(m, x), n, p)) == Nat.sub(m, 1n+x) : Nat}:
  match m x:
    case 0n x:
      {==}
    case 1n+v 0n:
      rk.sub0(v)
    case 1n+v 1n+y:
      rk.apred(cfg, r, c, n, p, v, y)

def rk.rn(+cfg: Rn.Cfg, +r: Nat, +c: Nat, +n: Nat, +p: Nat, +a: Nat) -> {n == Rn.St.n(Rn.retry(cfg, True{}, r, c, a, n, p)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+b:
      {==}

def rk.sub_succ(+v: Nat, +s: Nat, +e: {Nat.is_le(s, v) == True{} : Bool}) -> {1n+Nat.sub(v, s) == Nat.sub(1n+v, s) : Nat}:
  match v s:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      rk.absurd({1n+Nat.sub(0n, 1n+y) == Nat.sub(1n, 1n+y) : Nat}, e)
    case 1n+u 0n:
      {==}
    case 1n+u 1n+y:
      rk.sub_succ(u, y, e)

def rk.ra(+retries: Nat, +b: Nat, +notes: Nat, +e: {Nat.is_le(notes, b) == True{} : Bool}) -> {Nat.sub(retries, 1n+Nat.sub(Nat.sub(1n+b, 1n), notes)) == Nat.sub(retries, Nat.sub(Nat.sub(2n+b, 1n), notes)) : Nat}:
  %rk.sub0(b) : {Nat.sub(retries, 1n+Nat.sub(_, notes)) == Nat.sub(retries, Nat.sub(1n+b, notes)) : Nat}
  %rk.sub_succ(b, notes, e) : {Nat.sub(retries, 1n+Nat.sub(b, notes)) == Nat.sub(retries, _) : Nat}
  {==}

def rk.run_retry_counts_down(+l: Rn.Lim, +t: Rn.At, +e: {Nat.is_le(1n+Rn.At.notes(t), Rn.At.attempt(t)) == True{} : Bool}, +r: Nat, +c: Nat, +p: Nat) -> {Rn.St.a(Rn.retry(Rn.Lim.cfg(l), True{}, r, c, Rn.At.a(l, t), Rn.At.n(l, t), p)) == Rn.At.a(l, Laws.rust.retried_next(t)) : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          match attempt:
            case 0n:
              rk.absurd({Rn.St.a(Rn.retry(Rn.Cfg{rounds, wait, retries, most}, True{}, r, c, Nat.sub(retries, Nat.sub(Nat.sub(0n, 1n), notes)), Nat.sub(most, notes), p)) == Nat.sub(retries, Nat.sub(Nat.sub(1n, 1n), notes)) : Nat}, e)
            case 1n++b:
              Equal.trans(Nat, Rn.St.a(Rn.retry(Rn.Cfg{rounds, wait, retries, most}, True{}, r, c, Nat.sub(retries, Nat.sub(Nat.sub(1n+b, 1n), notes)), Nat.sub(most, notes), p)), Nat.sub(retries, 1n+Nat.sub(Nat.sub(1n+b, 1n), notes)), Nat.sub(retries, Nat.sub(Nat.sub(2n+b, 1n), notes)), rk.apred(Rn.Cfg{rounds, wait, retries, most}, r, c, Nat.sub(most, notes), p, retries, Nat.sub(Nat.sub(1n+b, 1n), notes)), rk.ra(retries, b, notes, e))

def rk.run_retry_keeps_the_notes(+l: Rn.Lim, +t: Rn.At, +r: Nat, +c: Nat, +p: Nat) -> {Rn.St.n(Rn.retry(Rn.Lim.cfg(l), True{}, r, c, Rn.At.a(l, t), Rn.At.n(l, t), p)) == Rn.At.n(l, Laws.rust.retried_next(t)) : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          Equal.sym(Nat, Nat.sub(most, notes), Rn.St.n(Rn.retry(Rn.Cfg{rounds, wait, retries, most}, True{}, r, c, Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes)), Nat.sub(most, notes), p)), rk.rn(Rn.Cfg{rounds, wait, retries, most}, r, c, Nat.sub(most, notes), p, Nat.sub(retries, Nat.sub(Nat.sub(attempt, 1n), notes))))

def rk.and_l(+a: Bool, +b: Bool, +e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      rk.absurd({False{} == True{} : Bool}, e)

def rk.and_r(+a: Bool, +b: Bool, +e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      e
    case False{}:
      rk.absurd({b == True{} : Bool}, e)

def rk.add0(+n: Nat) -> {n == Nat.add(n, 0n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %rk.add0(p) : {1n+p == 1n+_ : Nat}
      {==}

def rk.adds(+a: Nat, +b: Nat) -> {1n+Nat.add(a, b) == Nat.add(a, 1n+b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %rk.adds(p, b) : {2n+Nat.add(p, b) == 1n+_ : Nat}
      {==}

def rk.subadd(+m: Nat, +x: Nat, +e: {Nat.is_le(x, m) == True{} : Bool}) -> {Nat.add(Nat.sub(m, x), x) == m : Nat}:
  match m x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      rk.absurd({Nat.add(Nat.sub(0n, 1n+y), 1n+y) == 0n : Nat}, e)
    case 1n+v 0n:
      %rk.add0(v) : {1n+_ == 1n+v : Nat}
      {==}
    case 1n+v 1n+y:
      %rk.adds(Nat.sub(v, y), y) : {_ == 1n+v : Nat}
      %rk.subadd(v, y, e) : {1n+Nat.add(Nat.sub(v, y), y) == 1n+_ : Nat}
      {==}

def rk.addsub(+a: Nat, +b: Nat) -> {b == Nat.sub(Nat.add(a, b), a) : Nat}:
  match a:
    case 0n:
      rk.sub0(b)
    case 1n+p:
      rk.addsub(p, b)

def rk.subsub(+m: Nat, +x: Nat, +e: {Nat.is_le(x, m) == True{} : Bool}) -> {x == Nat.sub(m, Nat.sub(m, x)) : Nat}:
  %rk.subadd(m, x, e) : {x == Nat.sub(_, Nat.sub(m, x)) : Nat}
  rk.addsub(Nat.sub(m, x), x)

def rk.att(+attempt: Nat, +notes: Nat, +e: {Nat.is_le(1n+notes, attempt) == True{} : Bool}) -> {attempt == 1n+Nat.add(Nat.sub(Nat.sub(attempt, 1n), notes), notes) : Nat}:
  match attempt:
    case 0n:
      rk.absurd({0n == 1n+Nat.add(Nat.sub(Nat.sub(0n, 1n), notes), notes) : Nat}, e)
    case 1n++b:
      %rk.sub0(b) : {1n+b == 1n+Nat.add(Nat.sub(_, notes), notes) : Nat}
      %rk.subadd(b, notes, e) : {1n+_ == 1n+Nat.add(Nat.sub(b, notes), notes) : Nat}
      {==}

def rk.c(+compacted: Bool) -> {compacted == Nat.is_eq(Rn.c.of(compacted), 0n) : Bool}:
  match compacted:
    case True{}:
      {==}
    case False{}:
      {==}

def rk.run_counts_lossless(+l: Rn.Lim, +t: Rn.At, +w: {Laws.rust.within(l, t) == True{} : Bool}) -> {Laws.rust.back(l, Rn.At.a(l, t), Rn.At.n(l, t), Rn.At.p(l, t), Rn.At.c(t)) == t : Rn.At}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          +spent = Nat.sub(Nat.sub(attempt, 1n), notes)
          +b1 = Nat.is_le(notes, most)
          +b2 = Nat.is_le(1n+notes, attempt)
          +b3 = Nat.is_le(spent, retries)
          +b4 = Nat.is_le(waited, wait)
          +w1 = rk.and_l(b1, Bool.and(b2, Bool.and(b3, b4)), w)
          +r1 = rk.and_r(b1, Bool.and(b2, Bool.and(b3, b4)), w)
          +w2 = rk.and_l(b2, Bool.and(b3, b4), r1)
          +r2 = rk.and_r(b2, Bool.and(b3, b4), r1)
          +w3 = rk.and_l(b3, b4, r2)
          +w4 = rk.and_r(b3, b4, r2)
          %rk.subsub(retries, spent, w3) : {Rn.At{1n+Nat.add(_, Nat.sub(most, Nat.sub(most, notes))), Nat.sub(most, Nat.sub(most, notes)), Nat.sub(wait, Nat.sub(wait, waited)), Nat.is_eq(Rn.c.of(compacted), 0n)} == Rn.At{attempt, notes, waited, compacted} : Rn.At}
          %rk.subsub(most, notes, w1) : {Rn.At{1n+Nat.add(spent, _), _, Nat.sub(wait, Nat.sub(wait, waited)), Nat.is_eq(Rn.c.of(compacted), 0n)} == Rn.At{attempt, notes, waited, compacted} : Rn.At}
          %rk.subsub(wait, waited, w4) : {Rn.At{1n+Nat.add(spent, notes), notes, _, Nat.is_eq(Rn.c.of(compacted), 0n)} == Rn.At{attempt, notes, waited, compacted} : Rn.At}
          %rk.c(compacted) : {Rn.At{1n+Nat.add(spent, notes), notes, waited, _} == Rn.At{attempt, notes, waited, compacted} : Rn.At}
          %rk.att(attempt, notes, w2) : {Rn.At{_, notes, waited, compacted} == Rn.At{attempt, notes, waited, compacted} : Rn.At}
          {==}

def rk.lt_s(+v: Nat, +x: Nat) -> {Nat.is_le(x, v) == Nat.is_lt(x, 1n+v) : Bool}:
  match v x:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      match y:
        case 0n:
          {==}
        case 1n+z:
          {==}
    case 1n+u 0n:
      {==}
    case 1n+u 1n+y:
      rk.lt_s(u, y)

def rk.lt_le(+m: Nat, +x: Nat, +e: {Nat.is_lt(x, m) == True{} : Bool}) -> {Nat.is_le(x, Nat.sub(m, 1n)) == True{} : Bool}:
  match m:
    case 0n:
      match x:
        case 0n:
          rk.absurd({Nat.is_le(0n, 0n) == True{} : Bool}, e)
        case 1n+y:
          rk.absurd({Nat.is_le(1n+y, 0n) == True{} : Bool}, e)
    case 1n+v:
      %rk.sub0(v) : {Nat.is_le(x, _) == True{} : Bool}
      Equal.trans(Bool, Nat.is_le(x, v), Nat.is_lt(x, 1n+v), True{}, rk.lt_s(v, x), e)

def rk.run_rounds_lossless(+l: Rn.Lim, +count: Nat, +w: {Nat.is_lt(count, Rn.Lim.rounds(l)) == True{} : Bool}) -> {Nat.sub(Nat.sub(Rn.Lim.rounds(l), 1n), Rn.Lim.r(l, count)) == count : Nat}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      Equal.sym(Nat, count, Nat.sub(Nat.sub(rounds, 1n), Nat.sub(Nat.sub(rounds, 1n), count)), rk.subsub(Nat.sub(rounds, 1n), count, rk.lt_le(rounds, count, w)))

def rk.min_lt(+w: Nat, +c: Nat, +x: Nat, +e: {Nat.is_lt(x, c) == True{} : Bool}) -> {Nat.is_lt(x, w) == Nat.is_lt(x, Nat.min(w, c)) : Bool}:
  match w:
    case 0n:
      {==}
    case 1n+v:
      match c:
        case 0n:
          match x:
            case 0n:
              rk.absurd({Nat.is_lt(0n, 1n+v) == Nat.is_lt(0n, Nat.min(1n+v, 0n)) : Bool}, e)
            case 1n+y:
              rk.absurd({Nat.is_lt(1n+y, 1n+v) == Nat.is_lt(1n+y, Nat.min(1n+v, 0n)) : Bool}, e)
        case 1n+d:
          match x:
            case 0n:
              {==}
            case 1n+y:
              rk.min_lt(v, d, y, e)

def rk.sat_wait(+l: Rn.Lim, +t: Rn.At, +reply: Rn.Reply, +cap: Nat, +e: {Nat.is_lt(Rn.At.waited(t), cap) == True{} : Bool}) -> {Laws.rust.after_reply(Laws.rust.sat_wait(l, cap), t, reply) == Laws.rust.after_reply(l, t, reply) : Rn.Then}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          match reply:
            case Rn.Plain{}:
              {==}
            case Rn.Calls{}:
              {==}
            case Rn.Deferred{}:
              %rk.min_lt(wait, cap, waited, e) : {Laws.rust.wait(_) == Laws.rust.wait(Nat.is_lt(waited, wait)) : Rn.Then}
              {==}
            case Rn.Error{retryable, noted}:
              match retryable noted:
                case retryable True{}:
                  {==}
                case True{} False{}:
                  {==}
                case False{} False{}:
                  {==}
            case Rn.Overflow{cut}:
              {==}

def rk.run_reply_saturates_the_wait(+l: Rn.Lim, +t: Rn.At, +reply: Rn.Reply, +cap: Nat, +e: {Nat.is_lt(Rn.At.waited(t), cap) == True{} : Bool}) -> {Rn.decide.reply(Laws.rust.sat_wait(l, cap), t, reply) == Rn.decide.reply(l, t, reply) : Rn.Then}:
  +l2 = Laws.rust.sat_wait(l, cap)
  Equal.trans(Rn.Then, Rn.decide.reply(l2, t, reply), Laws.rust.after_reply(l2, t, reply), Rn.decide.reply(l, t, reply), rk.run_reply_is_the_rust_rule(l2, t, reply), Equal.trans(Rn.Then, Laws.rust.after_reply(l2, t, reply), Laws.rust.after_reply(l, t, reply), Rn.decide.reply(l, t, reply), rk.sat_wait(l, t, reply, cap, e), Equal.sym(Rn.Then, Rn.decide.reply(l, t, reply), Laws.rust.after_reply(l, t, reply), rk.run_reply_is_the_rust_rule(l, t, reply))))

def rk.min_le(+a: Nat, +c: Nat, +r: Nat, +e: {Nat.is_le(r, c) == True{} : Bool}) -> {Nat.is_lt(a, r) == Nat.is_lt(Nat.min(a, c), r) : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+u:
      match c:
        case 0n:
          match r:
            case 0n:
              {==}
            case 1n+q:
              rk.absurd({Nat.is_lt(1n+u, 1n+q) == Nat.is_lt(Nat.min(1n+u, 0n), 1n+q) : Bool}, e)
        case 1n+d:
          match r:
            case 0n:
              {==}
            case 1n+q:
              rk.min_le(u, d, q, e)

def rk.min_sub(+k: Nat, +a: Nat, +c: Nat, +r: Nat, +e: {Nat.is_le(Nat.add(k, r), c) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(a, k), r) == Nat.is_lt(Nat.sub(Nat.min(a, c), k), r) : Bool}:
  match k:
    case 0n:
      %rk.sub0(a) : {Nat.is_lt(_, r) == Nat.is_lt(Nat.sub(Nat.min(a, c), 0n), r) : Bool}
      %rk.sub0(Nat.min(a, c)) : {Nat.is_lt(a, r) == Nat.is_lt(_, r) : Bool}
      rk.min_le(a, c, r, e)
    case 1n+j:
      match a:
        case 0n:
          {==}
        case 1n+u:
          match c:
            case 0n:
              rk.absurd({Nat.is_lt(Nat.sub(1n+u, 1n+j), r) == Nat.is_lt(Nat.sub(Nat.min(1n+u, 0n), 1n+j), r) : Bool}, e)
            case 1n+d:
              rk.min_sub(j, u, d, r, e)

def rk.ss(+a: Nat, +n: Nat) -> {Nat.sub(a, 1n+n) == Nat.sub(Nat.sub(a, 1n), n) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+u:
      %rk.sub0(u) : {Nat.sub(u, n) == Nat.sub(_, n) : Nat}
      {==}

def rk.lt_le1(+c: Nat, +x: Nat, +e: {Nat.is_lt(x, c) == True{} : Bool}) -> {Nat.is_le(1n+x, c) == True{} : Bool}:
  match c:
    case 0n:
      match x:
        case 0n:
          rk.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, e)
        case 1n+y:
          rk.absurd({Nat.is_le(2n+y, 0n) == True{} : Bool}, e)
    case 1n+d:
      Equal.trans(Bool, Nat.is_le(x, d), Nat.is_lt(x, 1n+d), True{}, rk.lt_s(d, x), e)

def rk.sat_attempt(+l: Rn.Lim, +t: Rn.At, +reply: Rn.Reply, +cap: Nat, +e: {Nat.is_lt(Nat.add(Rn.At.notes(t), Rn.Lim.retries(l)), cap) == True{} : Bool}) -> {Laws.rust.after_reply(l, Laws.rust.sat_attempt(t, cap), reply) == Laws.rust.after_reply(l, t, reply) : Rn.Then}:
  match l:
    case Rn.Lim{+rounds, +wait, +retries, +most}:
      match t:
        case Rn.At{+attempt, +notes, +waited, +compacted}:
          match reply:
            case Rn.Plain{}:
              {==}
            case Rn.Calls{}:
              {==}
            case Rn.Deferred{}:
              {==}
            case Rn.Error{retryable, noted}:
              match retryable noted:
                case retryable True{}:
                  {==}
                case True{} False{}:
                  +m = Nat.min(attempt, cap)
                  %rk.ss(m, notes) : {Laws.rust.retry(Nat.is_lt(_, retries)) == Laws.rust.retry(Nat.is_lt(Nat.sub(Nat.sub(attempt, 1n), notes), retries)) : Rn.Then}
                  %rk.ss(attempt, notes) : {Laws.rust.retry(Nat.is_lt(Nat.sub(m, 1n+notes), retries)) == Laws.rust.retry(Nat.is_lt(_, retries)) : Rn.Then}
                  %rk.min_sub(1n+notes, attempt, cap, retries, rk.lt_le1(cap, Nat.add(notes, retries), e)) : {Laws.rust.retry(_) == Laws.rust.retry(Nat.is_lt(Nat.sub(attempt, 1n+notes), retries)) : Rn.Then}
                  {==}
                case False{} False{}:
                  {==}
            case Rn.Overflow{cut}:
              {==}

def rk.run_reply_saturates_the_attempt(+l: Rn.Lim, +t: Rn.At, +reply: Rn.Reply, +cap: Nat, +e: {Nat.is_lt(Nat.add(Rn.At.notes(t), Rn.Lim.retries(l)), cap) == True{} : Bool}) -> {Rn.decide.reply(l, Laws.rust.sat_attempt(t, cap), reply) == Rn.decide.reply(l, t, reply) : Rn.Then}:
  +t2 = Laws.rust.sat_attempt(t, cap)
  Equal.trans(Rn.Then, Rn.decide.reply(l, t2, reply), Laws.rust.after_reply(l, t2, reply), Rn.decide.reply(l, t, reply), rk.run_reply_is_the_rust_rule(l, t2, reply), Equal.trans(Rn.Then, Laws.rust.after_reply(l, t2, reply), Laws.rust.after_reply(l, t, reply), Rn.decide.reply(l, t, reply), rk.sat_attempt(l, t, reply, cap, e), Equal.sym(Rn.Then, Rn.decide.reply(l, t, reply), Laws.rust.after_reply(l, t, reply), rk.run_reply_is_the_rust_rule(l, t, reply))))

# ---- retry ----

# proof_retry: the H4.7 retry laws of LAWS.bend about the requests of
# bend/run.bend.
#
# - retry_sends_a_new_request: an invariant of the requests (Ok), by
#   induction on the inputs. Every request the run cut is behind the
#   request it sends next: from an older context, or from this context
#   with an attempt up to the current one and another note. A noted error
#   moves the note to the next attempt, which no cut request of this
#   context names; a grown context leaves every cut request behind. So
#   the request the run sends is never one it cut.
# - cut_names_the_request: by computation.
# - note_is_never_logged: by computation on the note.

# Order
# -----

# a < b
def lt(a: Nat, b: Nat) -> Bool:
  match a b:
    case 0n 0n:
      False{}
    case 0n 1n+q:
      True{}
    case 1n+p 0n:
      False{}
    case 1n+p 1n+q:
      lt(p, q)

def lt_up(a: Nat, b: Nat, h: {lt(a, b) == True{} : Bool}) -> {lt(a, 1n+b) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      absurd({lt(1n+p, 1n) == True{} : Bool}, h)
    case 1n+p 1n+q:
      lt_up(p, q, h)

def lt_self(a: Nat) -> {lt(a, 1n+a) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      lt_self(p)

def lt_ne(a: Nat, b: Nat, h: {lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      absurd({Nat.is_eq(0n, 0n) == False{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      lt_ne(p, q, h)

# c = ctx, so c < ctx + 1
def lt_eq_up(+c: Nat, +ctx: Nat, e: {c == ctx : Nat}) -> {lt(c, 1n+ctx) == True{} : Bool}:
  %Equal.sym(Nat, c, ctx, e) : {lt(_, 1n+ctx) == True{} : Bool}
  lt_self(ctx)

# The invariant
# -------------

# a cut request q is behind the next request of context ctx, attempt n
# and note: from an older context, or from this one with an attempt up to
# n and another note
def OkQ(+ctx: Nat, +n: Nat, +note: Nat, q: Rn.Req) -> Type:
  match q:
    case Rn.Req{c, m}:
      Or({lt(c, ctx) == True{} : Bool}, Here(c, m, ctx, n, note))

# the request (c, m) is from context ctx, with an attempt up to n and
# another note
def Here(-c: Nat, -m: Nat, -ctx: Nat, -n: Nat, -note: Nat) -> Type:
  {c == ctx : Nat} & {lt(m, 1n+n) == True{} : Bool} & {Nat.is_eq(m, note) == False{} : Bool}

# every cut request of xs is
def OkL(+ctx: Nat, +n: Nat, +note: Nat, xs: List<&2, Rn.Sent>) -> Type:
  match xs:
    case Nil{}:
      Unit
    case Rn.Sent{q} <> t:
      OkL(ctx, n, note, t)
    case Rn.Cut{q} <> t:
      OkQ(ctx, n, note, q) & OkL(ctx, n, note, t)

# the note names an attempt up to the current one, every cut request is
# behind the next request, and no sent request was cut before
def Ok3(+ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>) -> Type:
  {lt(note, 1n+n) == True{} : Bool} & OkL(ctx, n, note, log) & {Rn.fresh(log) == True{} : Bool}

def Ok(t: Rn.Reqs) -> Type:
  match t:
    case Rn.Reqs{ctx, n, note, log}:
      Ok3(ctx, n, note, log)

# The next request was not cut
# ----------------------------
# Each lemma hands its invariant back, as a proof is used once.

def or_ff(a: Bool, -b: Bool, ea: {a == False{} : Bool}, eb: {b == False{} : Bool}) -> {Bool.or(a, b) == False{} : Bool}:
  match a:
    case False{}:
      eb
    case True{}:
      absurd({Bool.or(True{}, b) == False{} : Bool}, Equal.sym(Bool, True{}, False{}, ea))

# an older context
def not_older(+c: Nat, +ctx: Nat, -m: Nat, -note: Nat, l: {lt(c, ctx) == True{} : Bool}) -> {Rn.Req.is(Rn.Req{c, m}, Rn.Req{ctx, note}) == False{} : Bool}:
  %Equal.sym(Bool, Nat.is_eq(c, ctx), False{}, lt_ne(c, ctx, l)) : {Bool.and(_, Nat.is_eq(m, note)) == False{} : Bool}
  {==}

# this context, another note
def not_noted(+c: Nat, +ctx: Nat, +m: Nat, +note: Nat, e: {c == ctx : Nat}, ne: {Nat.is_eq(m, note) == False{} : Bool}) -> {Rn.Req.is(Rn.Req{c, m}, Rn.Req{ctx, note}) == False{} : Bool}:
  %Equal.sym(Bool, Nat.is_eq(m, note), False{}, ne) : {Bool.and(Nat.is_eq(c, ctx), _) == False{} : Bool}
  %Equal.sym(Nat, c, ctx, e) : {Bool.and(Nat.is_eq(_, ctx), False{}) == False{} : Bool}
  %Equal.sym(Bool, Nat.is_eq(ctx, ctx), True{}, eq_refl(ctx)) : {Bool.and(_, False{}) == False{} : Bool}
  {==}

def not_noted.back(+c: Nat, +ctx: Nat, +m: Nat, -n: Nat, +note: Nat, +e: {c == ctx : Nat}, l: {lt(m, 1n+n) == True{} : Bool}, +ne: {Nat.is_eq(m, note) == False{} : Bool}) -> {Rn.Req.is(Rn.Req{c, m}, Rn.Req{ctx, note}) == False{} : Bool} & OkQ(ctx, n, note, Rn.Req{c, m}):
  (not_noted(c, ctx, m, note, e, ne), Inr{{(e, l, ne) : Here(c, m, ctx, n, note)}})

def not_cutq(+ctx: Nat, +n: Nat, +note: Nat, q: Rn.Req, oq: OkQ(ctx, n, note, q)) -> {Rn.Req.is(q, Rn.Req{ctx, note}) == False{} : Bool} & OkQ(ctx, n, note, q):
  match q:
    case Rn.Req{+c, +m}:
      match oq:
        case Inl{+l}:
          (not_older(c, ctx, m, note, l), Inl{l})
        case Inr{y}:
          (e, l, ne) = y
          not_noted.back(c, ctx, m, n, note, e, l, ne)

def not_cut.cons(+ctx: Nat, -n: Nat, +note: Nat, +q: Rn.Req, -t: List<&2, Rn.Sent>, pq: {Rn.Req.is(q, Rn.Req{ctx, note}) == False{} : Bool} & OkQ(ctx, n, note, q), pt: {Rn.cut_in(Rn.Req{ctx, note}, t) == False{} : Bool} & OkL(ctx, n, note, t)) -> {Rn.cut_in(Rn.Req{ctx, note}, Rn.Cut{q} <> t) == False{} : Bool} & OkL(ctx, n, note, Rn.Cut{q} <> t):
  (nq, oq) = pq
  (nt, ot) = pt
  (or_ff(Rn.Req.is(q, Rn.Req{ctx, note}), Rn.cut_in(Rn.Req{ctx, note}, t), nq, nt), (oq, ot))

def not_cut(+ctx: Nat, +n: Nat, +note: Nat, xs: List<&2, Rn.Sent>, ok: OkL(ctx, n, note, xs)) -> {Rn.cut_in(Rn.Req{ctx, note}, xs) == False{} : Bool} & OkL(ctx, n, note, xs):
  match xs:
    case Nil{}:
      ({==}, ok)
    case Rn.Sent{q} <> t:
      not_cut(ctx, n, note, t, ok)
    case Rn.Cut{+q} <> t:
      (oq, ot) = ok
      not_cut.cons(ctx, n, note, q, t, not_cutq(ctx, n, note, q, oq), not_cut(ctx, n, note, t, ot))

# sending the next request keeps the log fresh
def fresh_send(+ctx: Nat, +note: Nat, +log: List<&2, Rn.Sent>, nc: {Rn.cut_in(Rn.Req{ctx, note}, log) == False{} : Bool}, fr: {Rn.fresh(log) == True{} : Bool}) -> {Rn.fresh(Rn.Sent{Rn.Req{ctx, note}} <> log) == True{} : Bool}:
  %Equal.sym(Bool, Rn.cut_in(Rn.Req{ctx, note}, log), False{}, nc) : {Bool.and(Bool.not(_), Rn.fresh(log)) == True{} : Bool}
  fr

# Each change keeps it
# --------------------

# a grown context leaves every cut request behind, whatever the attempt
# and the note
def okq_ctx(+ctx: Nat, -n: Nat, -note: Nat, -n2: Nat, -note2: Nat, q: Rn.Req, oq: OkQ(ctx, n, note, q)) -> OkQ(1n+ctx, n2, note2, q):
  match q:
    case Rn.Req{+c, m}:
      match oq:
        case Inl{l}:
          Inl{lt_up(c, ctx, l)}
        case Inr{y}:
          (e, l, ne) = y
          Inl{lt_eq_up(c, ctx, e)}

def ok_ctx(+ctx: Nat, -n: Nat, -note: Nat, -n2: Nat, -note2: Nat, xs: List<&2, Rn.Sent>, ok: OkL(ctx, n, note, xs)) -> OkL(1n+ctx, n2, note2, xs):
  match xs:
    case Nil{}:
      Unit{}
    case Rn.Sent{q} <> t:
      ok_ctx(ctx, n, note, n2, note2, t, ok)
    case Rn.Cut{q} <> t:
      (oq, ot) = ok
      (okq_ctx(ctx, n, note, n2, note2, q, oq), ok_ctx(ctx, n, note, n2, note2, t, ot))

# an attempt more keeps every cut request behind, with the same note
def okq_n(-ctx: Nat, +n: Nat, -note: Nat, q: Rn.Req, oq: OkQ(ctx, n, note, q)) -> OkQ(ctx, 1n+n, note, q):
  match q:
    case Rn.Req{c, +m}:
      match oq:
        case Inl{l}:
          Inl{l}
        case Inr{y}:
          (e, l, ne) = y
          Inr{{(e, lt_up(m, 1n+n, l), ne) : Here(c, m, ctx, 1n+n, note)}}

def ok_n(-ctx: Nat, +n: Nat, -note: Nat, xs: List<&2, Rn.Sent>, ok: OkL(ctx, n, note, xs)) -> OkL(ctx, 1n+n, note, xs):
  match xs:
    case Nil{}:
      Unit{}
    case Rn.Sent{q} <> t:
      ok_n(ctx, n, note, t, ok)
    case Rn.Cut{q} <> t:
      (oq, ot) = ok
      (okq_n(ctx, n, note, q, oq), ok_n(ctx, n, note, t, ot))

# and with the note of the next attempt, which no cut request of this
# context names
def next_here(-c: Nat, +m: Nat, -ctx: Nat, +n: Nat, -note: Nat, e: {c == ctx : Nat}, +l: {lt(m, 1n+n) == True{} : Bool}) -> Here(c, m, ctx, 1n+n, 1n+n):
  (e, lt_up(m, 1n+n, l), lt_ne(m, 1n+n, l))

def okq_cut(-ctx: Nat, +n: Nat, -note: Nat, q: Rn.Req, oq: OkQ(ctx, n, note, q)) -> OkQ(ctx, 1n+n, 1n+n, q):
  match q:
    case Rn.Req{c, +m}:
      match oq:
        case Inl{l}:
          Inl{l}
        case Inr{y}:
          (e, l, ne) = y
          Inr{next_here(c, m, ctx, n, note, e, l)}

def ok_cut(-ctx: Nat, +n: Nat, -note: Nat, xs: List<&2, Rn.Sent>, ok: OkL(ctx, n, note, xs)) -> OkL(ctx, 1n+n, 1n+n, xs):
  match xs:
    case Nil{}:
      Unit{}
    case Rn.Sent{q} <> t:
      ok_cut(ctx, n, note, t, ok)
    case Rn.Cut{q} <> t:
      (oq, ot) = ok
      (okq_cut(ctx, n, note, q, oq), ok_cut(ctx, n, note, t, ot))

# Each input
# ----------

def send_ok(+ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, le: {lt(note, 1n+n) == True{} : Bool}, fr: {Rn.fresh(log) == True{} : Bool}, p: {Rn.cut_in(Rn.Req{ctx, note}, log) == False{} : Bool} & OkL(ctx, n, note, log)) -> Ok3(ctx, n, note, Rn.Sent{Rn.Req{ctx, note}} <> log):
  (nc, okl) = p
  (le, okl, fresh_send(ctx, note, log, nc, fr))

def ok_prepared(pa: Rn.Ph, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.prepared(pa, ctx, n, note, log)):
  match pa:
    case Rn.Call{}:
      (le, okl, fr) = ok
      send_ok(ctx, n, note, log, le, fr, not_cut(ctx, n, note, log, okl))
    case Rn.Prepare{}:
      ok
    case Rn.Compact{over}:
      ok
    case Rn.Tools{}:
      ok
    case Rn.Answered{}:
      ok
    case Rn.Aborted{}:
      ok
    case Rn.Failed{why}:
      ok

def ok_error(noted: Bool, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.error(noted, ctx, n, note, log)):
  match noted:
    case True{}:
      (le, okl, fr) = ok
      (lt_self(1n+n), (Inr{next_here(ctx, note, ctx, n, note, {==}, le)}, ok_cut(ctx, n, note, log, okl)), fr)
    case False{}:
      (le, okl, fr) = ok
      (lt_up(note, 1n+n, le), ok_n(ctx, n, note, log, okl), fr)

def ok_reply(reply: Rn.Reply, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.reply(reply, ctx, n, note, log)):
  match reply:
    case Rn.Error{retryable, noted}:
      ok_error(noted, ctx, n, note, log, ok)
    case Rn.Plain{}:
      ok
    case Rn.Calls{}:
      ok
    case Rn.Deferred{}:
      ok
    case Rn.Overflow{cut}:
      ok

def ok_compacted(got: Rn.Got, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.compacted(got, ctx, n, note, log)):
  match got:
    case Rn.Built{}:
      (le, okl, fr) = ok
      (le, ok_ctx(ctx, n, note, n, note, log, okl), fr)
    case Rn.Kept{}:
      ok
    case Rn.Broke{}:
      ok

def ok_rounded(pa: Rn.Ph, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.rounded(pa, ctx, n, note, log)):
  match pa:
    case Rn.Prepare{}:
      (le, okl, fr) = ok
      ({==}, ok_ctx(ctx, n, note, 1n, 0n, log, okl), fr)
    case Rn.Call{}:
      ok
    case Rn.Compact{over}:
      ok
    case Rn.Tools{}:
      ok
    case Rn.Answered{}:
      ok
    case Rn.Aborted{}:
      ok
    case Rn.Failed{why}:
      ok

def ok_go(pb: Rn.Ph, e: Rn.Ev, pa: Rn.Ph, +ctx: Nat, +n: Nat, +note: Nat, +log: List<&2, Rn.Sent>, ok: Ok3(ctx, n, note, log)) -> Ok(Rn.Reqs.go(pb, e, pa, ctx, n, note, log)):
  match pb e:
    case Rn.Prepare{} e:
      ok_prepared(pa, ctx, n, note, log, ok)
    case Rn.Call{} Rn.Go{reply, fin, got}:
      ok_reply(reply, ctx, n, note, log, ok)
    case Rn.Call{} Rn.Abort{}:
      ok
    case Rn.Compact{over} Rn.Go{reply, fin, got}:
      ok_compacted(got, ctx, n, note, log, ok)
    case Rn.Compact{over} Rn.Abort{}:
      ok
    case Rn.Tools{} e:
      ok_rounded(pa, ctx, n, note, log, ok)
    case Rn.Answered{} e:
      ok
    case Rn.Aborted{} e:
      ok
    case Rn.Failed{why} e:
      ok

def ok_step(pb: Rn.Ph, e: Rn.Ev, pa: Rn.Ph, t: Rn.Reqs, ok: Ok(t)) -> Ok(Rn.Reqs.step(pb, e, pa, t)):
  match t:
    case Rn.Reqs{+ctx, +n, +note, +log}:
      ok_go(pb, e, pa, ctx, n, note, log, ok)

def ok_run(evs: List<&2, Rn.Ev>, +cfg: Rn.Cfg, +s: Rn.St, +t: Rn.Reqs, ok: Ok(t)) -> Ok(Rn.reqs.go(evs, cfg, s, t)):
  match evs:
    case Nil{}:
      ok
    case +e <> rest:
      +s2 = Rn.step(cfg, s, e)
      ok_run(rest, cfg, s2, Rn.Reqs.step(Rn.St.ph(s), e, Rn.St.ph(s2), t), ok_step(Rn.St.ph(s), e, Rn.St.ph(s2), t, ok))

def fresh_of(t: Rn.Reqs, ok: Ok(t)) -> {Rn.fresh(Rn.Reqs.log(t)) == True{} : Bool}:
  match t:
    case Rn.Reqs{ctx, n, note, log}:
      (le, okl, fr) = ok
      fr

# The laws
# --------

# no request the run sends equals one it sent before and had cut
def retry_sends_a_new_request(+cfg: Rn.Cfg, +evs: List<&2, Rn.Ev>) -> {Rn.fresh(Rn.Reqs.log(Rn.reqs(cfg, evs))) == True{} : Bool}:
  +t = Rn.reqs.go(evs, cfg, Rn.init(cfg), Rn.Reqs.init())
  fresh_of(t, ok_run(evs, cfg, Rn.init(cfg), Rn.Reqs.init(), ({==}, Unit{}, {==})))

# a noted reply cuts the request the run sent, and the retry's note names
# the retry's attempt
def cut_names_the_request(-retryable: Bool, -fin: Rn.Fin, -got: Rn.Got, -pa: Rn.Ph, -ctx: Nat, -n: Nat, -note: Nat, -log: List<&2, Rn.Sent>) -> {Rn.Reqs.step(Rn.Call{}, Rn.Go{Rn.Error{retryable, True{}}, fin, got}, pa, Rn.Reqs{ctx, n, note, log}) == Rn.Reqs{ctx, 1n+n, 1n+n, Rn.Cut{Rn.Req{ctx, note}} <> log} : Rn.Reqs}:
  {==}

# a note changes what the model reads, never what the run logs
def note_is_never_logged(q: Rn.Req) -> {Rn.logged(Rn.Req.lines(q)) == Rn.logged(Rn.Req.lines(Rn.Req{Rn.Req.ctx(q), 0n})) : List<&2, Rn.Line>}:
  match q:
    case Rn.Req{ctx, note}:
      match note:
        case 0n:
          {==}
        case 1n+k:
          {==}

# ---- admission ----

# proof_admission: the admission laws of LAWS.bend (rule H3 of
# docs/harness.md) over the model in admission.bend.

# Logic
# -----

# a type picked by a Bool: a rewrite through it refutes False == True
def ad.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def ad.absurd(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : ad.BD(_, A, Unit)
  Unit{}

# Counting
# --------

def ad.bit_comm(a: Bool, b: Bool, -x: Nat) -> {Ad.bit(a, Ad.bit(b, x)) == Ad.bit(b, Ad.bit(a, x)) : Nat}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# a ticket appended counts last
def ad.cnt_app(+m: Ad.Mode, +c: Ad.Cls, t: List<&2, Ad.Tk>, +x: Ad.Tk) -> {Ad.cnt(m, c, List.append(&2, Ad.Tk, t, [x])) == Ad.bit(Ad.hit(m, c, x), Ad.cnt(m, c, t)) : Nat}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      %Equal.sym(Nat, Ad.cnt(m, c, List.append(&2, Ad.Tk, r, [x])), Ad.bit(Ad.hit(m, c, x), Ad.cnt(m, c, r)), ad.cnt_app(m, c, r, x)) : {Ad.bit(Ad.hit(m, c, h), _) == Ad.bit(Ad.hit(m, c, x), Ad.bit(Ad.hit(m, c, h), Ad.cnt(m, c, r))) : Nat}
      ad.bit_comm(Ad.hit(m, c, h), Ad.hit(m, c, x), Ad.cnt(m, c, r))

# what a count of mode m, class c sees of ticket mb
def ad.at(+m: Ad.Mode, +c: Ad.Cls, mb: Maybe<&2, Ad.Tk>) -> Bool:
  match mb:
    case None{}:
      False{}
    case Some{t}:
      Ad.hit(m, c, t)

# ticket mb with status x
def ad.set(mb: Maybe<&2, Ad.Tk>, x: Ad.Sts) -> Maybe<&2, Ad.Tk>:
  match mb:
    case None{}:
      None{}
    case Some{Ad.Tk{c, s}}:
      Some{Ad.Tk{c, x}}

# a ticket's new status counts in its place
def ad.cnt_put(+m: Ad.Mode, +c: Ad.Cls, t: List<&2, Ad.Tk>, +k: Nat, +x: Ad.Sts) -> {Ad.bit(ad.at(m, c, Ad.get(t, k)), Ad.cnt(m, c, Ad.put(t, k, x))) == Ad.bit(ad.at(m, c, ad.set(Ad.get(t, k), x)), Ad.cnt(m, c, t)) : Nat}:
  match t:
    case Nil{}:
      {==}
    case Ad.Tk{+c1, +s1} <> +r:
      match k:
        case 0n:
          ad.bit_comm(Ad.hit(m, c, Ad.Tk{c1, s1}), Ad.hit(m, c, Ad.Tk{c1, x}), Ad.cnt(m, c, r))
        case 1n+p:
          +ha = ad.at(m, c, Ad.get(r, p))
          +hs = ad.at(m, c, ad.set(Ad.get(r, p), x))
          +hh = Ad.hit(m, c, Ad.Tk{c1, s1})
          %ad.bit_comm(hh, ha, Ad.cnt(m, c, Ad.put(r, p, x))) : {_ == Ad.bit(hs, Ad.bit(hh, Ad.cnt(m, c, r))) : Nat}
          %Equal.sym(Nat, Ad.bit(ha, Ad.cnt(m, c, Ad.put(r, p, x))), Ad.bit(hs, Ad.cnt(m, c, r)), ad.cnt_put(m, c, r, p, x)) : {Ad.bit(hh, _) == Ad.bit(hs, Ad.bit(hh, Ad.cnt(m, c, r))) : Nat}
          ad.bit_comm(hh, hs, Ad.cnt(m, c, r))

def ad.absurd_t(-A: Type, e: {True{} == False{} : Bool}) -> A:
  ad.absurd(A, Equal.sym(Bool, True{}, False{}, e))

def ad.and_ff(x: Bool, y: Bool) -> {Bool.and(x, False{}) == Bool.and(y, False{}) : Bool}:
  match x y:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def ad.and_f(x: Bool) -> {Bool.and(x, False{}) == False{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

# A preemption
# ------------

# it keeps an interactive ticket's counts
def ad.hit_pre(+m: Ad.Mode, t: Ad.Tk) -> {Ad.hit(m, Ad.Ia{}, Ad.Tk.preempt(t)) == Ad.hit(m, Ad.Ia{}, t) : Bool}:
  match t:
    case Ad.Tk{Ad.Ia{}, s}:
      {==}
    case Ad.Tk{Ad.Bg{}, s}:
      match s:
        case Ad.Queued{}:
          {==}
        case Ad.Granted{}:
          ad.and_ff(Ad.Mode.of(m, Ad.Queued{}), Ad.Mode.of(m, Ad.Granted{}))
        case Ad.Held{}:
          ad.and_ff(Ad.Mode.of(m, Ad.Preempted{}), Ad.Mode.of(m, Ad.Held{}))
        case Ad.Preempted{}:
          {==}
        case Ad.Ended{}:
          {==}

def ad.pre_ia(+m: Ad.Mode, t: List<&2, Ad.Tk>) -> {Ad.cnt(m, Ad.Ia{}, Ad.preempt(t)) == Ad.cnt(m, Ad.Ia{}, t) : Nat}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      %Equal.sym(Bool, Ad.hit(m, Ad.Ia{}, Ad.Tk.preempt(h)), Ad.hit(m, Ad.Ia{}, h), ad.hit_pre(m, h)) : {Ad.bit(_, Ad.cnt(m, Ad.Ia{}, Ad.preempt(r))) == Ad.bit(Ad.hit(m, Ad.Ia{}, h), Ad.cnt(m, Ad.Ia{}, r)) : Nat}
      %Equal.sym(Nat, Ad.cnt(m, Ad.Ia{}, Ad.preempt(r)), Ad.cnt(m, Ad.Ia{}, r), ad.pre_ia(m, r)) : {Ad.bit(Ad.hit(m, Ad.Ia{}, h), _) == Ad.bit(Ad.hit(m, Ad.Ia{}, h), Ad.cnt(m, Ad.Ia{}, r)) : Nat}
      {==}

# it leaves no background slot held
def ad.hb_pre(t: Ad.Tk) -> {Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk.preempt(t)) == False{} : Bool}:
  match t:
    case Ad.Tk{Ad.Ia{}, s}:
      ad.and_f(Ad.Mode.of(Ad.Holding{}, s))
    case Ad.Tk{Ad.Bg{}, s}:
      match s:
        case Ad.Queued{}:
          {==}
        case Ad.Granted{}:
          {==}
        case Ad.Held{}:
          {==}
        case Ad.Preempted{}:
          {==}
        case Ad.Ended{}:
          {==}

def ad.pre_hb(t: List<&2, Ad.Tk>) -> {Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.preempt(t)) == 0n : Nat}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      %Equal.sym(Bool, Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk.preempt(h)), False{}, ad.hb_pre(h)) : {Ad.bit(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.preempt(r))) == 0n : Nat}
      ad.pre_hb(r)

# A grant
# -------

# the grant passes a ticket that is not the oldest waiter of class c
def ad.mark_skip(+m: Ad.Mode, +d: Ad.Cls, +c: Ad.Cls, +h: Ad.Tk, +r: List<&2, Ad.Tk>, ih: {Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Queued{}}), Ad.cnt(m, d, Ad.mark(c, r))) == Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Granted{}}), Ad.cnt(m, d, r)) : Nat}) -> {Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Queued{}}), Ad.bit(Ad.hit(m, d, h), Ad.cnt(m, d, Ad.mark(c, r)))) == Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Granted{}}), Ad.bit(Ad.hit(m, d, h), Ad.cnt(m, d, r))) : Nat}:
  +hq = Ad.hit(m, d, Ad.Tk{c, Ad.Queued{}})
  +hg = Ad.hit(m, d, Ad.Tk{c, Ad.Granted{}})
  +hh = Ad.hit(m, d, h)
  %ad.bit_comm(hh, hq, Ad.cnt(m, d, Ad.mark(c, r))) : {_ == Ad.bit(hg, Ad.bit(hh, Ad.cnt(m, d, r))) : Nat}
  %Equal.sym(Nat, Ad.bit(hq, Ad.cnt(m, d, Ad.mark(c, r))), Ad.bit(hg, Ad.cnt(m, d, r)), ih) : {Ad.bit(hh, _) == Ad.bit(hg, Ad.bit(hh, Ad.cnt(m, d, r))) : Nat}
  ad.bit_comm(hh, hg, Ad.cnt(m, d, r))

# a grant to class c turns one waiter of c into a slot held
def ad.cnt_mark(+m: Ad.Mode, +d: Ad.Cls, t: List<&2, Ad.Tk>, +c: Ad.Cls, nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, c, t)) == False{} : Bool}) -> {Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Queued{}}), Ad.cnt(m, d, Ad.mark(c, t))) == Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Granted{}}), Ad.cnt(m, d, t)) : Nat}:
  match t:
    case Nil{}:
      ad.absurd_t({Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Queued{}}), 0n) == Ad.bit(Ad.hit(m, d, Ad.Tk{c, Ad.Granted{}}), 0n) : Nat}, nz)
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Ia{} Ad.Queued{}:
          match c:
            case Ad.Ia{}:
              ad.bit_comm(Ad.hit(m, d, Ad.Tk{Ad.Ia{}, Ad.Queued{}}), Ad.hit(m, d, Ad.Tk{Ad.Ia{}, Ad.Granted{}}), Ad.cnt(m, d, r))
            case Ad.Bg{}:
              ad.mark_skip(m, d, Ad.Bg{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}}, r, ad.cnt_mark(m, d, r, Ad.Bg{}, nz))
        case Ad.Bg{} Ad.Queued{}:
          match c:
            case Ad.Ia{}:
              ad.mark_skip(m, d, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}}, r, ad.cnt_mark(m, d, r, Ad.Ia{}, nz))
            case Ad.Bg{}:
              ad.bit_comm(Ad.hit(m, d, Ad.Tk{Ad.Bg{}, Ad.Queued{}}), Ad.hit(m, d, Ad.Tk{Ad.Bg{}, Ad.Granted{}}), Ad.cnt(m, d, r))
        case _ Ad.Granted{}:
          ad.mark_skip(m, d, c, Ad.Tk{hc, Ad.Granted{}}, r, ad.cnt_mark(m, d, r, c, nz))
        case _ Ad.Held{}:
          ad.mark_skip(m, d, c, Ad.Tk{hc, Ad.Held{}}, r, ad.cnt_mark(m, d, r, c, nz))
        case _ Ad.Preempted{}:
          ad.mark_skip(m, d, c, Ad.Tk{hc, Ad.Preempted{}}, r, ad.cnt_mark(m, d, r, c, nz))
        case _ Ad.Ended{}:
          ad.mark_skip(m, d, c, Ad.Tk{hc, Ad.Ended{}}, r, ad.cnt_mark(m, d, r, c, nz))

# Bools and numbers
# -----------------

def ad.and_l(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      ad.absurd({False{} == True{} : Bool}, e)

def ad.and_r(a: Bool, -b: Bool, e: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      e
    case False{}:
      ad.absurd({b == True{} : Bool}, e)

def ad.and_t(a: Bool, -b: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      eb
    case False{}:
      ad.absurd({Bool.and(False{}, b) == True{} : Bool}, ea)

def ad.or_t(x: Bool) -> {Bool.or(x, True{}) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

def ad.not_t(x: Bool, e: {Bool.not(x) == True{} : Bool}) -> {x == False{} : Bool}:
  match x:
    case True{}:
      ad.absurd({True{} == False{} : Bool}, e)
    case False{}:
      {==}

def ad.pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def ad.bit_inj(b: Bool, -x: Nat, -y: Nat, e: {Ad.bit(b, x) == Ad.bit(b, y) : Nat}) -> {x == y : Nat}:
  match b:
    case False{}:
      e
    case True{}:
      Equal.cong(Nat, Nat, n => ad.pred(n), 1n+x, 1n+y, e)

def ad.add_zero(n: Nat) -> {Nat.add(n, 0n) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %ad.add_zero(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

def ad.le_refl(n: Nat) -> {Ad.le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      ad.le_refl(p)

def ad.zero2(a: Nat, b: Nat, e: {Ad.le(Nat.add(a, b), 0n) == True{} : Bool}) -> {a == 0n : Nat} & {b == 0n : Nat}:
  match a:
    case 0n:
      match b:
        case 0n:
          ({==}, {==})
        case 1n+y:
          ad.absurd({0n == 0n : Nat} & {1n+y == 0n : Nat}, e)
    case 1n+x:
      ad.absurd({1n+x == 0n : Nat} & {b == 0n : Nat}, e)

# a Some{c} that is not: refuted through its class
def ad.mis(m: Maybe<&2, Ad.Cls>, c: Ad.Cls) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{d}:
      Ad.Cls.eq(d, c)

def ad.m_ia(-X: Type, -m: Maybe<&2, Ad.Cls>, e: {m == Some{Ad.Ia{}} : Maybe<&2, Ad.Cls>}, u: ad.BD(ad.mis(m, Ad.Ia{}), X, Unit)) -> X:
  %e : ad.BD(ad.mis(_, Ad.Ia{}), X, Unit)
  u

def ad.m_bg(-X: Type, -m: Maybe<&2, Ad.Cls>, e: {m == Some{Ad.Bg{}} : Maybe<&2, Ad.Cls>}, u: ad.BD(ad.mis(m, Ad.Bg{}), X, Unit)) -> X:
  %e : ad.BD(ad.mis(_, Ad.Bg{}), X, Unit)
  u

# The invariant: no lost wake-up, and background slots only while no
# interactive request holds or waits
# ------------------------------------------------------------------

def ad.ok.n(+l: Ad.Lim, +hi: Nat, +wi: Nat, +hb: Nat, +wb: Nat) -> Bool:
  Bool.and(Bool.not(Maybe.is_some(&2, Ad.Cls, Ad.pick.go(Ad.room(l, Nat.add(hi, hb)), wi, hi, wb))), Ad.calm.n(hi, wi, hb))

def ad.ok(+l: Ad.Lim, +ts: List<&2, Ad.Tk>) -> Bool:
  ad.ok.n(l, Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts), Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts))

def ad.okS(s: Ad.St) -> Bool:
  match s:
    case Ad.St{+l, q, +ts}:
      ad.ok(l, ts)

def ad.ok.tr(-l: Ad.Lim, -a1: Nat, -a2: Nat, -a3: Nat, -a4: Nat, -b1: Nat, -b2: Nat, -b3: Nat, -b4: Nat, e1: {a1 == b1 : Nat}, e2: {a2 == b2 : Nat}, e3: {a3 == b3 : Nat}, e4: {a4 == b4 : Nat}, h: {ad.ok.n(l, a1, a2, a3, a4) == True{} : Bool}) -> {ad.ok.n(l, b1, b2, b3, b4) == True{} : Bool}:
  %e1 : {ad.ok.n(l, _, b2, b3, b4) == True{} : Bool}
  %e2 : {ad.ok.n(l, a1, _, b3, b4) == True{} : Bool}
  %e3 : {ad.ok.n(l, a1, a2, _, b4) == True{} : Bool}
  %e4 : {ad.ok.n(l, a1, a2, a3, _) == True{} : Bool}
  h

def ad.calm.tr(-a1: Nat, -a2: Nat, -a3: Nat, -b1: Nat, -b2: Nat, -b3: Nat, e1: {a1 == b1 : Nat}, e2: {a2 == b2 : Nat}, e3: {a3 == b3 : Nat}, h: {Ad.calm.n(a1, a2, a3) == True{} : Bool}) -> {Ad.calm.n(b1, b2, b3) == True{} : Bool}:
  %e1 : {Ad.calm.n(_, b2, b3) == True{} : Bool}
  %e2 : {Ad.calm.n(a1, _, b3) == True{} : Bool}
  %e3 : {Ad.calm.n(a1, a2, _) == True{} : Bool}
  h

def ad.pick_none0(r: Bool, hi: Nat) -> {Ad.pick.go(r, 0n, hi, 0n) == None{} : Maybe<&2, Ad.Cls>}:
  match r hi:
    case False{} _:
      {==}
    case True{} 0n:
      {==}
    case True{} 1n+x:
      {==}

def ad.pick_none_hi(r: Bool, -hi: Nat, -wb: Nat) -> {Ad.pick.go(r, 0n, 1n+hi, wb) == None{} : Maybe<&2, Ad.Cls>}:
  match r:
    case False{}:
      {==}
    case True{}:
      {==}

# with interactive slots held, background waiters do not matter
def ad.pick_hi(r: Bool, wi: Nat, -a: Nat, -x: Nat, -y: Nat) -> {Ad.pick.go(r, wi, 1n+a, x) == Ad.pick.go(r, wi, 1n+a, y) : Maybe<&2, Ad.Cls>}:
  match r wi:
    case False{} _:
      {==}
    case True{} 0n:
      {==}
    case True{} 1n+b:
      {==}

# with interactive waiters, background waiters do not matter
def ad.pick_wi(r: Bool, -b: Nat, -h: Nat, -x: Nat, -y: Nat) -> {Ad.pick.go(r, 1n+b, h, x) == Ad.pick.go(r, 1n+b, h, y) : Maybe<&2, Ad.Cls>}:
  match r:
    case False{}:
      {==}
    case True{}:
      {==}

def ad.pick_wb(r: Bool, -x: Nat, -y: Nat) -> {Ad.pick.go(r, 0n, 0n, 1n+x) == Ad.pick.go(r, 0n, 0n, 1n+y) : Maybe<&2, Ad.Cls>}:
  match r:
    case False{}:
      {==}
    case True{}:
      {==}

# a grant to an interactive waiter: one waits
def ad.pick_ia(r: Bool, wi: Nat, hi: Nat, wb: Nat, e: {Ad.pick.go(r, wi, hi, wb) == Some{Ad.Ia{}} : Maybe<&2, Ad.Cls>}) -> {Ad.isz(wi) == False{} : Bool}:
  match r wi hi wb:
    case False{} _ _ _:
      ad.m_ia({Ad.isz(wi) == False{} : Bool}, None{}, e, Unit{})
    case True{} 1n+a _ _:
      {==}
    case True{} 0n 1n+b _:
      ad.m_ia({Ad.isz(0n) == False{} : Bool}, None{}, e, Unit{})
    case True{} 0n 0n 0n:
      ad.m_ia({Ad.isz(0n) == False{} : Bool}, None{}, e, Unit{})
    case True{} 0n 0n 1n+d:
      ad.m_ia({Ad.isz(0n) == False{} : Bool}, Some{Ad.Bg{}}, e, Unit{})

# a grant to a background waiter: no interactive request holds or waits,
# and one background request waits
def ad.pick_bg(r: Bool, wi: Nat, hi: Nat, wb: Nat, e: {Ad.pick.go(r, wi, hi, wb) == Some{Ad.Bg{}} : Maybe<&2, Ad.Cls>}) -> {wi == 0n : Nat} & ({hi == 0n : Nat} & {Ad.isz(wb) == False{} : Bool}):
  match r wi hi wb:
    case False{} _ _ _:
      ad.m_bg({wi == 0n : Nat} & ({hi == 0n : Nat} & {Ad.isz(wb) == False{} : Bool}), None{}, e, Unit{})
    case True{} 1n+a _ _:
      ad.m_bg({1n+a == 0n : Nat} & ({hi == 0n : Nat} & {Ad.isz(wb) == False{} : Bool}), Some{Ad.Ia{}}, e, Unit{})
    case True{} 0n 1n+b _:
      ad.m_bg({0n == 0n : Nat} & ({1n+b == 0n : Nat} & {Ad.isz(wb) == False{} : Bool}), None{}, e, Unit{})
    case True{} 0n 0n 0n:
      ad.m_bg({0n == 0n : Nat} & ({0n == 0n : Nat} & {Ad.isz(0n) == False{} : Bool}), None{}, e, Unit{})
    case True{} 0n 0n 1n+d:
      ({==}, ({==}, {==}))

# calm stays calm as counts drop
def ad.calm_m1(-a: Nat, -b: Nat, c: Nat, h: {Ad.calm.n(1n+a, b, c) == True{} : Bool}) -> {Ad.calm.n(a, b, c) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+x:
      ad.absurd({Ad.calm.n(a, b, 1n+x) == True{} : Bool}, h)

def ad.calm_m2(+a: Nat, -b: Nat, c: Nat, h: {Ad.calm.n(a, 1n+b, c) == True{} : Bool}) -> {Ad.calm.n(a, b, c) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+x:
      ad.absurd({Ad.calm.n(a, b, 1n+x) == True{} : Bool}, Equal.trans(Bool, False{}, Bool.and(Ad.isz(a), False{}), True{}, Equal.sym(Bool, Bool.and(Ad.isz(a), False{}), False{}, ad.and_f(Ad.isz(a))), h))

def ad.calm_m3(-a: Nat, -b: Nat, c: Nat, h: {Ad.calm.n(a, b, 1n+c) == True{} : Bool}) -> {Ad.calm.n(a, b, c) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+x:
      h

def ad.calm_mono(x1: Bool, x2: Bool, x3: Bool, +a: Nat, +b: Nat, +c: Nat, h: {Ad.calm.n(Ad.bit(x1, a), Ad.bit(x2, b), Ad.bit(x3, c)) == True{} : Bool}) -> {Ad.calm.n(a, b, c) == True{} : Bool}:
  match x1 x2 x3:
    case False{} False{} False{}:
      h
    case False{} False{} True{}:
      ad.calm_m3(a, b, c, h)
    case False{} True{} False{}:
      ad.calm_m2(a, b, c, h)
    case False{} True{} True{}:
      ad.calm_m3(a, b, c, ad.calm_m2(a, b, 1n+c, h))
    case True{} False{} False{}:
      ad.calm_m1(a, b, c, h)
    case True{} False{} True{}:
      ad.calm_m3(a, b, c, ad.calm_m1(a, b, 1n+c, h))
    case True{} True{} False{}:
      ad.calm_m2(a, b, c, ad.calm_m1(a, 1n+b, c, h))
    case True{} True{} True{}:
      ad.calm_m3(a, b, c, ad.calm_m2(a, b, 1n+c, ad.calm_m1(a, 1n+b, 1n+c, h)))

# an interactive waiter: no background slot is held
def ad.calm_hb0(+hi: Nat, -w: Nat, hb: Nat, c: {Ad.calm.n(hi, 1n+w, hb) == True{} : Bool}) -> {hb == 0n : Nat}:
  match hb:
    case 0n:
      {==}
    case 1n+x:
      ad.absurd({1n+x == 0n : Nat}, Equal.trans(Bool, False{}, Bool.and(Ad.isz(hi), False{}), True{}, Equal.sym(Bool, Bool.and(Ad.isz(hi), False{}), False{}, ad.and_f(Ad.isz(hi))), c))

# an interactive waiter: no slot is free
def ad.ok_room(r: Bool, -w: Nat, -hi: Nat, -wb: Nat, -c: Bool, h: {Bool.and(Bool.not(Maybe.is_some(&2, Ad.Cls, Ad.pick.go(r, 1n+w, hi, wb))), c) == True{} : Bool}) -> {r == False{} : Bool}:
  match r:
    case True{}:
      ad.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

# A grant keeps the invariant
# ---------------------------

def ad.ok_idle(+l: Ad.Lim, +hi: Nat, +hb: Nat, c: {Ad.calm.n(hi, 0n, hb) == True{} : Bool}) -> {ad.ok.n(l, hi, 0n, hb, 0n) == True{} : Bool}:
  +r = Ad.room(l, Nat.add(hi, hb))
  %Equal.sym(Maybe<&2, Ad.Cls>, Ad.pick.go(r, 0n, hi, 0n), None{}, ad.pick_none0(r, hi)) : {Bool.and(Bool.not(Maybe.is_some(&2, Ad.Cls, _)), Ad.calm.n(hi, 0n, hb)) == True{} : Bool}
  c

def ad.grant_idle(+l: Ad.Lim, +t: List<&2, Ad.Tk>, z: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat} & {Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t) == 0n : Nat}, cm: {Ad.calm(t) == True{} : Bool}) -> {ad.ok(l, t) == True{} : Bool}:
  (+zi, zb) = z
  +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)
  +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t)
  +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)
  ad.ok.tr(l, hi, 0n, hb, 0n, hi, wi, hb, wb, {==}, Equal.sym(Nat, wi, 0n, zi), {==}, Equal.sym(Nat, wb, 0n, zb), ad.ok_idle(l, hi, hb, ad.calm.tr(hi, wi, hb, hi, 0n, hb, {==}, zi, {==}, cm)))

def ad.not_none(-m: Maybe<&2, Ad.Cls>, e: {m == None{} : Maybe<&2, Ad.Cls>}) -> {Bool.not(Maybe.is_some(&2, Ad.Cls, m)) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Ad.Cls>, m, None{}, e) : {Bool.not(Maybe.is_some(&2, Ad.Cls, _)) == True{} : Bool}
  {==}

def ad.grant_none(+l: Ad.Lim, +t: List<&2, Ad.Tk>, ed: {Ad.pick(l, t) == None{} : Maybe<&2, Ad.Cls>}, cm: {Ad.calm(t) == True{} : Bool}) -> {ad.ok(l, t) == True{} : Bool}:
  +p = Ad.pick(l, t)
  ad.and_t(Bool.not(Maybe.is_some(&2, Ad.Cls, p)), Ad.calm(t), ad.not_none(p, ed), cm)

# the waiters bound the grants still to come
def ad.fuel_ia(+t: List<&2, Ad.Tk>, -f: Nat, +nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)) == False{} : Bool}, fuel: {Ad.le(Ad.waits(t), 1n+f) == True{} : Bool}) -> {Ad.le(Ad.waits(Ad.mark(Ad.Ia{}, t)), f) == True{} : Bool}:
  +t2 = Ad.mark(Ad.Ia{}, t)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)
  +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)
  +wi2 = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t2)
  +wb2 = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t2)
  %Equal.sym(Nat, wb2, wb, ad.cnt_mark(Ad.Waiting{}, Ad.Bg{}, t, Ad.Ia{}, nz)) : {Ad.le(Nat.add(wi2, _), f) == True{} : Bool}
  %Equal.sym(Nat, 1n+wi2, wi, ad.cnt_mark(Ad.Waiting{}, Ad.Ia{}, t, Ad.Ia{}, nz)) : {Ad.le(Nat.add(_, wb), 1n+f) == True{} : Bool}
  fuel

def ad.calm_ia(-a: Nat, -b: Nat, hb: Nat, +hi: Nat, -w: Nat, c: {Ad.calm.n(hi, 1n+w, hb) == True{} : Bool}) -> {Ad.calm.n(a, b, hb) == True{} : Bool}:
  match hb:
    case 0n:
      {==}
    case 1n+x:
      ad.absurd({Ad.calm.n(a, b, 1n+x) == True{} : Bool}, Equal.trans(Bool, False{}, Bool.and(Ad.isz(hi), False{}), True{}, Equal.sym(Bool, Bool.and(Ad.isz(hi), False{}), False{}, ad.and_f(Ad.isz(hi))), c))

def ad.calm_mark_ia(+t: List<&2, Ad.Tk>, +nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)) == False{} : Bool}, cm: {Ad.calm(t) == True{} : Bool}) -> {Ad.calm(Ad.mark(Ad.Ia{}, t)) == True{} : Bool}:
  +t2 = Ad.mark(Ad.Ia{}, t)
  +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)
  +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t)
  +hi2 = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2)
  +wi2 = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t2)
  +hb2 = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)
  %Equal.sym(Nat, hb2, hb, ad.cnt_mark(Ad.Holding{}, Ad.Bg{}, t, Ad.Ia{}, nz)) : {Ad.calm.n(hi2, wi2, _) == True{} : Bool}
  ad.calm_ia(hi2, wi2, hb, hi, wi2, ad.calm.tr(hi, wi, hb, hi, 1n+wi2, hb, {==}, Equal.sym(Nat, 1n+wi2, wi, ad.cnt_mark(Ad.Waiting{}, Ad.Ia{}, t, Ad.Ia{}, nz)), {==}, cm))

def ad.pbg(+l: Ad.Lim, +t: List<&2, Ad.Tk>, e: {Ad.pick(l, t) == Some{Ad.Bg{}} : Maybe<&2, Ad.Cls>}) -> {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat} & ({Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat} & {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool}):
  ad.pick_bg(Ad.room(l, Ad.held(t)), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t), Ad.cnt(Ad.Holding{}, Ad.Ia{}, t), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t), e)

def ad.bg_wi(-t: List<&2, Ad.Tk>, p: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat} & ({Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat} & {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool})) -> {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat}:
  (a, b, c) = p
  a

def ad.bg_hi(-t: List<&2, Ad.Tk>, p: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat} & ({Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat} & {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool})) -> {Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat}:
  (a, b, c) = p
  b

def ad.bg_wb(-t: List<&2, Ad.Tk>, p: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat} & ({Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat} & {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool})) -> {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool}:
  (a, b, c) = p
  c

def ad.fuel_bg(+t: List<&2, Ad.Tk>, -f: Nat, +zi: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat}, +nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool}, fuel: {Ad.le(Ad.waits(t), 1n+f) == True{} : Bool}) -> {Ad.le(Ad.waits(Ad.mark(Ad.Bg{}, t)), f) == True{} : Bool}:
  +t2 = Ad.mark(Ad.Bg{}, t)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)
  +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)
  +wi2 = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t2)
  +wb2 = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t2)
  %Equal.sym(Nat, wi2, wi, ad.cnt_mark(Ad.Waiting{}, Ad.Ia{}, t, Ad.Bg{}, nz)) : {Ad.le(Nat.add(_, wb2), f) == True{} : Bool}
  %Equal.sym(Nat, wi, 0n, zi) : {Ad.le(Nat.add(_, wb2), f) == True{} : Bool}
  %Equal.sym(Nat, 1n+wb2, wb, ad.cnt_mark(Ad.Waiting{}, Ad.Bg{}, t, Ad.Bg{}, nz)) : {Ad.le(_, 1n+f) == True{} : Bool}
  %zi : {Ad.le(Nat.add(_, wb), 1n+f) == True{} : Bool}
  fuel

def ad.calm_bg(+t: List<&2, Ad.Tk>, zi: {Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t) == 0n : Nat}, zh: {Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) == 0n : Nat}, +nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t)) == False{} : Bool}) -> {Ad.calm(Ad.mark(Ad.Bg{}, t)) == True{} : Bool}:
  +t2 = Ad.mark(Ad.Bg{}, t)
  +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)
  +hi2 = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2)
  +wi2 = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t2)
  +hb2 = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)
  %Equal.sym(Nat, hi2, hi, ad.cnt_mark(Ad.Holding{}, Ad.Ia{}, t, Ad.Bg{}, nz)) : {Ad.calm.n(_, wi2, hb2) == True{} : Bool}
  %Equal.sym(Nat, wi2, wi, ad.cnt_mark(Ad.Waiting{}, Ad.Ia{}, t, Ad.Bg{}, nz)) : {Ad.calm.n(hi, _, hb2) == True{} : Bool}
  %Equal.sym(Nat, hi, 0n, zh) : {Ad.calm.n(_, wi, hb2) == True{} : Bool}
  %Equal.sym(Nat, wi, 0n, zi) : {Ad.calm.n(0n, _, hb2) == True{} : Bool}
  ad.or_t(Ad.isz(hb2))

def ad.grant_ok(n: Nat, d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +ed: {Ad.pick(l, t) == d : Maybe<&2, Ad.Cls>}, fuel: {Ad.le(Ad.waits(t), n) == True{} : Bool}, +cm: {Ad.calm(t) == True{} : Bool}) -> {ad.ok(l, Ad.grant.go(n, d, l, t)) == True{} : Bool}:
  match n d:
    case 0n _:
      ad.grant_idle(l, t, ad.zero2(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t), fuel), cm)
    case 1n+f None{}:
      ad.grant_none(l, t, ed, cm)
    case 1n+f Some{Ad.Ia{}}:
      +nz = ad.pick_ia(Ad.room(l, Ad.held(t)), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t), Ad.cnt(Ad.Holding{}, Ad.Ia{}, t), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t), ed)
      ad.grant_ok(f, Ad.pick(l, Ad.mark(Ad.Ia{}, t)), l, Ad.mark(Ad.Ia{}, t), {==}, ad.fuel_ia(t, f, nz, fuel), ad.calm_mark_ia(t, nz, cm))
    case 1n+f Some{Ad.Bg{}}:
      ad.grant_ok(f, Ad.pick(l, Ad.mark(Ad.Bg{}, t)), l, Ad.mark(Ad.Bg{}, t), {==}, ad.fuel_bg(t, f, ad.bg_wi(t, ad.pbg(l, t, ed)), ad.bg_wb(t, ad.pbg(l, t, ed)), fuel), ad.calm_bg(t, ad.bg_wi(t, ad.pbg(l, t, ed)), ad.bg_hi(t, ad.pbg(l, t, ed)), ad.bg_wb(t, ad.pbg(l, t, ed))))

# Every op keeps the invariant
# ----------------------------

def ad.bit_off(-b: Bool, -x: Nat, off: {b == False{} : Bool}) -> {Ad.bit(b, x) == x : Nat}:
  %Equal.sym(Bool, b, False{}, off) : {Ad.bit(_, x) == x : Nat}
  {==}

# a ticket appended that the count does not see
def ad.app_off(+m: Ad.Mode, +c: Ad.Cls, +t: List<&2, Ad.Tk>, +x: Ad.Tk, off: {Ad.hit(m, c, x) == False{} : Bool}) -> {Ad.cnt(m, c, List.append(&2, Ad.Tk, t, [x])) == Ad.cnt(m, c, t) : Nat}:
  Equal.trans(Nat, Ad.cnt(m, c, List.append(&2, Ad.Tk, t, [x])), Ad.bit(Ad.hit(m, c, x), Ad.cnt(m, c, t)), Ad.cnt(m, c, t), ad.cnt_app(m, c, t, x), ad.bit_off(Ad.hit(m, c, x), Ad.cnt(m, c, t), off))

# an interactive ticket appended after a preemption
def ad.app_pre(+m: Ad.Mode, +ts: List<&2, Ad.Tk>, +x: Ad.Tk) -> {Ad.cnt(m, Ad.Ia{}, List.append(&2, Ad.Tk, Ad.preempt(ts), [x])) == Ad.bit(Ad.hit(m, Ad.Ia{}, x), Ad.cnt(m, Ad.Ia{}, ts)) : Nat}:
  +hx = Ad.hit(m, Ad.Ia{}, x)
  Equal.trans(Nat, Ad.cnt(m, Ad.Ia{}, List.append(&2, Ad.Tk, Ad.preempt(ts), [x])), Ad.bit(hx, Ad.cnt(m, Ad.Ia{}, Ad.preempt(ts))), Ad.bit(hx, Ad.cnt(m, Ad.Ia{}, ts)), ad.cnt_app(m, Ad.Ia{}, Ad.preempt(ts), x), Equal.cong(Nat, Nat, y => Ad.bit(hx, y), Ad.cnt(m, Ad.Ia{}, Ad.preempt(ts)), Ad.cnt(m, Ad.Ia{}, ts), ad.pre_ia(m, ts)))

def ad.put_at(+m: Ad.Mode, +cc: Ad.Cls, +ts: List<&2, Ad.Tk>, +k: Nat, +x: Ad.Sts, -mb: Maybe<&2, Ad.Tk>, e: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Ad.bit(ad.at(m, cc, mb), Ad.cnt(m, cc, Ad.put(ts, k, x))) == Ad.bit(ad.at(m, cc, ad.set(mb, x)), Ad.cnt(m, cc, ts)) : Nat}:
  %e : {Ad.bit(ad.at(m, cc, _), Ad.cnt(m, cc, Ad.put(ts, k, x))) == Ad.bit(ad.at(m, cc, ad.set(_, x)), Ad.cnt(m, cc, ts)) : Nat}
  ad.cnt_put(m, cc, ts, k, x)

# collecting a granted permit changes no count
def ad.col_cnt(m: Ad.Mode, +cc: Ad.Cls, +ts: List<&2, Ad.Tk>, +k: Nat, +c: Ad.Cls, e: {Ad.get(ts, k) == Some{Ad.Tk{c, Ad.Granted{}}} : Maybe<&2, Ad.Tk>}) -> {Ad.cnt(m, cc, Ad.put(ts, k, Ad.Held{})) == Ad.cnt(m, cc, ts) : Nat}:
  match m:
    case Ad.Holding{}:
      ad.bit_inj(Ad.Cls.eq(cc, c), Ad.cnt(Ad.Holding{}, cc, Ad.put(ts, k, Ad.Held{})), Ad.cnt(Ad.Holding{}, cc, ts), ad.put_at(Ad.Holding{}, cc, ts, k, Ad.Held{}, Some{Ad.Tk{c, Ad.Granted{}}}, e))
    case Ad.Waiting{}:
      ad.put_at(Ad.Waiting{}, cc, ts, k, Ad.Held{}, Some{Ad.Tk{c, Ad.Granted{}}}, e)

# ending ticket k drops it from its count
def ad.end_cnt(m: Ad.Mode, +cc: Ad.Cls, +ts: List<&2, Ad.Tk>, +k: Nat, +c: Ad.Cls, +s: Ad.Sts, e: {Ad.get(ts, k) == Some{Ad.Tk{c, s}} : Maybe<&2, Ad.Tk>}) -> {Ad.bit(Ad.hit(m, cc, Ad.Tk{c, s}), Ad.cnt(m, cc, Ad.put(ts, k, Ad.Ended{}))) == Ad.cnt(m, cc, ts) : Nat}:
  match m:
    case Ad.Holding{}:
      ad.put_at(Ad.Holding{}, cc, ts, k, Ad.Ended{}, Some{Ad.Tk{c, s}}, e)
    case Ad.Waiting{}:
      ad.put_at(Ad.Waiting{}, cc, ts, k, Ad.Ended{}, Some{Ad.Tk{c, s}}, e)

def ad.end_calm(+ts: List<&2, Ad.Tk>, +k: Nat, +c: Ad.Cls, +s: Ad.Sts, +e: {Ad.get(ts, k) == Some{Ad.Tk{c, s}} : Maybe<&2, Ad.Tk>}, cm: {Ad.calm(ts) == True{} : Bool}) -> {Ad.calm(Ad.put(ts, k, Ad.Ended{})) == True{} : Bool}:
  +t2 = Ad.put(ts, k, Ad.Ended{})
  +x = {Ad.Tk{c, s} : Ad.Tk}
  +x1 = Ad.hit(Ad.Holding{}, Ad.Ia{}, x)
  +x2 = Ad.hit(Ad.Waiting{}, Ad.Ia{}, x)
  +x3 = Ad.hit(Ad.Holding{}, Ad.Bg{}, x)
  +a1 = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2)
  +a2 = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t2)
  +a3 = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)
