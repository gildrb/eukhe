    case Nil{} k:
      idle
    case h <> rest 0n:
      pos
    case +h <> +rest 1n+r:
      (st, tl) = tiles
      +s2 = Nat.add(s, O.Node.count(h))
      +a1 = pc.ahead(s, busy)
      +a2 = pc.ahead(s2, busy)
