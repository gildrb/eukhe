def ad.lea_ok(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +e: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, +h: {ad.ok(l, ts) == True{} : Bool}) -> {ad.okS(Ad.leave.at(mb, l, q, ts, k)) == True{} : Bool}:
  match mb:
    case None{}:
      h
    case Some{Ad.Tk{+c, Ad.Queued{}}}:
      ad.end_grant(l, ts, k, c, Ad.Queued{}, e, ad.calm_of(l, ts, h))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      ad.end_grant(l, ts, k, c, Ad.Granted{}, e, ad.calm_of(l, ts, h))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      h
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      h
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      h

def ad.step_ok(s: Ad.St, o: Ad.Op, +h: {ad.okS(s) == True{} : Bool}) -> {ad.okS(Ad.step(s, o)) == True{} : Bool}:
  match s:
    case Ad.St{+l, +q, +ts}:
      match o:
        case Ad.Admit{Ad.Ia{}}:
          ad.adm_ia_ok(l, q, ts, h)
        case Ad.Admit{Ad.Bg{}}:
          ad.adm_bg_ok(l, ts, h)
        case Ad.Collect{+k}:
          ad.col_ok(Ad.get(ts, k), l, q, ts, k, {==}, h)
        case Ad.Release{+k}:
          ad.rel_ok(Ad.get(ts, k), l, q, ts, k, {==}, h)
        case Ad.Leave{+k}:
          ad.lea_ok(Ad.get(ts, k), l, q, ts, k, {==}, h)
        case Ad.Limit{+l2, q2}:
          ad.grant_ok(Ad.waits(ts), Ad.pick(l2, ts), l2, ts, {==}, ad.le_refl(Ad.waits(ts)), ad.calm_of(l, ts, h))

def ad.run_ok(os: List<&2, Ad.Op>, +s: Ad.St, h: {ad.okS(s) == True{} : Bool}) -> {ad.okS(Ad.run(os, s)) == True{} : Bool}:
  match os:
    case Nil{}:
      h
    case +o <> r:
      ad.run_ok(r, Ad.step(s, o), ad.step_ok(s, o, h))

def ad.new_ok(l: Ad.Lim, -q: Nat) -> {ad.okS(Ad.St.new(l, q)) == True{} : Bool}:
  match l:
    case Ad.Unl{}:
      {==}
    case Ad.Cap{p}:
      {==}

def ad.okS_quiet(s: Ad.St, h: {ad.okS(s) == True{} : Bool}) -> {Ad.grantable(s) == False{} : Bool}:
  match s:
    case Ad.St{+l, q, +ts}:
      +g = Maybe.is_some(&2, Ad.Cls, Ad.pick(l, ts))
      ad.not_t(g, ad.and_l(Bool.not(g), Ad.calm(ts), h))

def ad.okS_calm(s: Ad.St, h: {ad.okS(s) == True{} : Bool}) -> {Ad.calm(Ad.St.ts(s)) == True{} : Bool}:
  match s:
    case Ad.St{+l, q, +ts}:
      ad.calm_of(l, ts, h)

# Laws (a)-(c)
# ------------

def preempts(s: Ad.St) -> {Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.St.ts(Ad.step(s, Ad.Admit{Ad.Ia{}}))) == 0n : Nat}:
  match s:
    case Ad.St{+l, +q, +ts}:
      +st = Ad.admit.ia.st(Bool.and(Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)), Ad.room(l, Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts))), Ad.le(q, Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)))
      +t1 = Ad.preempt(ts)
      Equal.trans(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, List.append(&2, Ad.Tk, t1, [Ad.Tk{Ad.Ia{}, st}])), Ad.cnt(Ad.Holding{}, Ad.Bg{}, t1), 0n, ad.app_off(Ad.Holding{}, Ad.Bg{}, t1, Ad.Tk{Ad.Ia{}, st}, ad.and_f(Ad.Mode.of(Ad.Holding{}, st))), ad.pre_hb(ts))

def no_lost_wakeup(+l: Ad.Lim, +q: Nat, +os: List<&2, Ad.Op>) -> {Ad.grantable(Ad.run(os, Ad.St.new(l, q))) == False{} : Bool}:
  ad.okS_quiet(Ad.run(os, Ad.St.new(l, q)), ad.run_ok(os, Ad.St.new(l, q), ad.new_ok(l, q)))

def background_yields(+l: Ad.Lim, +q: Nat, +os: List<&2, Ad.Op>) -> {Ad.calm(Ad.St.ts(Ad.run(os, Ad.St.new(l, q)))) == True{} : Bool}:
  ad.okS_calm(Ad.run(os, Ad.St.new(l, q)), ad.run_ok(os, Ad.St.new(l, q), ad.new_ok(l, q)))

# Every ticket ends exactly once
# ------------------------------

# a preemption ends no ticket and revives none
def ad.end_pre1(t: Ad.Tk) -> {Ad.ended(Some{Ad.Tk.preempt(t)}) == Ad.ended(Some{t}) : Bool}:
  match t:
    case Ad.Tk{Ad.Ia{}, s}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Queued{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Granted{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Held{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Preempted{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Ended{}}:
      {==}

def ad.end_pre(t: List<&2, Ad.Tk>, k: Nat) -> {Ad.ended(Ad.get(Ad.preempt(t), k)) == Ad.ended(Ad.get(t, k)) : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match k:
        case 0n:
          ad.end_pre1(h)
        case 1n+p:
          ad.end_pre(r, p)

def ad.end_app(t: List<&2, Ad.Tk>, -x: Ad.Tk, k: Nat, e: {Ad.ended(Ad.get(t, k)) == True{} : Bool}) -> {Ad.ended(Ad.get(List.append(&2, Ad.Tk, t, [x]), k)) == True{} : Bool}:
  match t:
    case Nil{}:
      ad.absurd({Ad.ended(Ad.get([x], k)) == True{} : Bool}, e)
    case +h <> +r:
      match k:
        case 0n:
          e
        case 1n+p:
          ad.end_app(r, x, p, e)

# a ticket op on another ticket leaves an ended one ended
def ad.end_put(t: List<&2, Ad.Tk>, k: Nat, j: Nat, -x: Ad.Sts, e: {Ad.ended(Ad.get(t, k)) == True{} : Bool}, ne: {Ad.ended(Ad.get(t, j)) == False{} : Bool}) -> {Ad.ended(Ad.get(Ad.put(t, j, x), k)) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+c, +s} <> +r:
      match k j:
        case 0n 0n:
          ad.absurd({Ad.ended(Some{Ad.Tk{c, x}}) == True{} : Bool}, Equal.trans(Bool, False{}, Ad.ended(Some{Ad.Tk{c, s}}), True{}, Equal.sym(Bool, Ad.ended(Some{Ad.Tk{c, s}}), False{}, ne), e))
        case 0n 1n+q:
          e
        case 1n+p 0n:
          e
        case 1n+p 1n+q:
          ad.end_put(r, p, q, x, e, ne)

def ad.end_mark(t: List<&2, Ad.Tk>, +c: Ad.Cls, k: Nat, e: {Ad.ended(Ad.get(t, k)) == True{} : Bool}) -> {Ad.ended(Ad.get(Ad.mark(c, t), k)) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Ia{} Ad.Queued{}:
          match c k:
            case Ad.Ia{} 0n:
              ad.absurd({Ad.ended(Some{Ad.Tk{Ad.Ia{}, Ad.Granted{}}}) == True{} : Bool}, e)
            case Ad.Ia{} 1n+p:
              e
            case Ad.Bg{} 0n:
              e
            case Ad.Bg{} 1n+p:
              ad.end_mark(r, Ad.Bg{}, p, e)
        case Ad.Bg{} Ad.Queued{}:
          match c k:
            case Ad.Bg{} 0n:
              ad.absurd({Ad.ended(Some{Ad.Tk{Ad.Bg{}, Ad.Granted{}}}) == True{} : Bool}, e)
            case Ad.Bg{} 1n+p:
              e
            case Ad.Ia{} 0n:
              e
            case Ad.Ia{} 1n+p:
              ad.end_mark(r, Ad.Ia{}, p, e)
        case _ Ad.Granted{}:
          match k:
            case 0n:
              e
            case 1n+p:
              ad.end_mark(r, c, p, e)
        case _ Ad.Held{}:
          match k:
            case 0n:
              e
            case 1n+p:
              ad.end_mark(r, c, p, e)
        case _ Ad.Preempted{}:
          match k:
            case 0n:
              e
            case 1n+p:
              ad.end_mark(r, c, p, e)
        case _ Ad.Ended{}:
          match k:
            case 0n:
              e
            case 1n+p:
              ad.end_mark(r, c, p, e)

def ad.end_grant_k(n: Nat, d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +k: Nat, e: {Ad.ended(Ad.get(t, k)) == True{} : Bool}) -> {Ad.ended(Ad.get(Ad.grant.go(n, d, l, t), k)) == True{} : Bool}:
  match n d:
    case 0n _:
      e
    case 1n+f None{}:
      e
    case 1n+f Some{+c}:
      ad.end_grant_k(f, Ad.pick(l, Ad.mark(c, t)), l, Ad.mark(c, t), k, ad.end_mark(t, c, k, e))

# ticket j, which is not ended, ends and the waiters are granted
def ad.ne_at(-ts: List<&2, Ad.Tk>, -j: Nat, -mb: Maybe<&2, Ad.Tk>, ej: {Ad.get(ts, j) == mb : Maybe<&2, Ad.Tk>}, f: {Ad.ended(mb) == False{} : Bool}) -> {Ad.ended(Ad.get(ts, j)) == False{} : Bool}:
  %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, j), mb, ej) : {Ad.ended(_) == False{} : Bool}
  f

def ad.end_other(+l: Ad.Lim, +ts: List<&2, Ad.Tk>, +k: Nat, +j: Nat, -c: Ad.Cls, -s: Ad.Sts, ej: {Ad.get(ts, j) == Some{Ad.Tk{c, s}} : Maybe<&2, Ad.Tk>}, ne: {Ad.ended(Some{Ad.Tk{c, s}}) == False{} : Bool}, e: {Ad.ended(Ad.get(ts, k)) == True{} : Bool}) -> {Ad.ended(Ad.get(Ad.put(ts, j, Ad.Ended{}), k)) == True{} : Bool}:
  ad.end_put(ts, k, j, Ad.Ended{}, e, ad.ne_at(ts, j, Some{Ad.Tk{c, s}}, ej, ne))

def ad.end_col(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +j: Nat, +k: Nat, ej: {Ad.get(ts, j) == mb : Maybe<&2, Ad.Tk>}, e: {Ad.ended(Ad.get(ts, k)) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.collect.at(mb, l, q, ts, j), k)) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      e
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      ad.end_put(ts, k, j, Ad.Held{}, e, ad.ne_at(ts, j, Some{Ad.Tk{c, Ad.Granted{}}}, ej, {==}))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      e
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      e
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ad.end_rel(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +j: Nat, +k: Nat, ej: {Ad.get(ts, j) == mb : Maybe<&2, Ad.Tk>}, e: {Ad.ended(Ad.get(ts, k)) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.release.at(mb, l, q, ts, j), k)) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      e
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      e
    case Some{Ad.Tk{+c, Ad.Held{}}}:
      +t2 = Ad.put(ts, j, Ad.Ended{})
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_other(l, ts, k, j, c, Ad.Held{}, ej, {==}, e))
    case Some{Ad.Tk{+c, Ad.Preempted{}}}:
      ad.end_other(l, ts, k, j, c, Ad.Preempted{}, ej, {==}, e)
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ad.end_lea(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +j: Nat, +k: Nat, ej: {Ad.get(ts, j) == mb : Maybe<&2, Ad.Tk>}, e: {Ad.ended(Ad.get(ts, k)) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.leave.at(mb, l, q, ts, j), k)) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{+c, Ad.Queued{}}}:
      +t2 = Ad.put(ts, j, Ad.Ended{})
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_other(l, ts, k, j, c, Ad.Queued{}, ej, {==}, e))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      +t2 = Ad.put(ts, j, Ad.Ended{})
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_other(l, ts, k, j, c, Ad.Granted{}, ej, {==}, e))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      e
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      e
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ended_stays_ended(s: Ad.St, o: Ad.Op, +k: Nat, e: {Ad.ended(Ad.status(s, k)) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.step(s, o), k)) == True{} : Bool}:
  match s:
    case Ad.St{+l, +q, +ts}:
      match o:
        case Ad.Admit{Ad.Ia{}}:
          +st = Ad.admit.ia.st(Bool.and(Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)), Ad.room(l, Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts))), Ad.le(q, Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)))
          ad.end_app(Ad.preempt(ts), Ad.Tk{Ad.Ia{}, st}, k, Equal.trans(Bool, Ad.ended(Ad.get(Ad.preempt(ts), k)), Ad.ended(Ad.get(ts, k)), True{}, ad.end_pre(ts, k), e))
        case Ad.Admit{Ad.Bg{}}:
          +st = Ad.admit.bg.st(Bool.and(Ad.isz(Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)), Bool.and(Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)), Bool.and(Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts)), Ad.room(l, Ad.held(ts))))))
          ad.end_app(ts, Ad.Tk{Ad.Bg{}, st}, k, e)
        case Ad.Collect{+j}:
          ad.end_col(Ad.get(ts, j), l, q, ts, j, k, {==}, e)
        case Ad.Release{+j}:
          ad.end_rel(Ad.get(ts, j), l, q, ts, j, k, {==}, e)
        case Ad.Leave{+j}:
          ad.end_lea(Ad.get(ts, j), l, q, ts, j, k, {==}, e)
        case Ad.Limit{+l2, q2}:
          ad.end_grant_k(Ad.waits(ts), Ad.pick(l2, ts), l2, ts, k, e)

# ending an ended ticket again changes nothing
def ad.twice(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, e: {Ad.ended(mb) == True{} : Bool}) -> {Ad.step(Ad.St{l, q, ts}, Ad.finish(mb, k)) == Ad.St{l, q, ts} : Ad.St}:
  match mb:
    case None{}:
      ad.absurd({Ad.step(Ad.St{l, q, ts}, Ad.Release{k}) == Ad.St{l, q, ts} : Ad.St}, e)
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      ad.absurd({Ad.step(Ad.St{l, q, ts}, Ad.Leave{k}) == Ad.St{l, q, ts} : Ad.St}, e)
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      ad.absurd({Ad.step(Ad.St{l, q, ts}, Ad.Leave{k}) == Ad.St{l, q, ts} : Ad.St}, e)
    case Some{Ad.Tk{c, Ad.Held{}}}:
      ad.absurd({Ad.step(Ad.St{l, q, ts}, Ad.Release{k}) == Ad.St{l, q, ts} : Ad.St}, e)
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      ad.absurd({Ad.step(Ad.St{l, q, ts}, Ad.Release{k}) == Ad.St{l, q, ts} : Ad.St}, e)
    case Some{Ad.Tk{+c, Ad.Ended{}}}:
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Ended{}}}, ej) : {Ad.release.at(_, l, q, ts, k) == Ad.St{l, q, ts} : Ad.St}
      {==}

def end_twice_changes_nothing(s: Ad.St, +k: Nat, e: {Ad.ended(Ad.status(s, k)) == True{} : Bool}) -> {Ad.step(s, Ad.finish(Ad.status(s, k), k)) == s : Ad.St}:
  match s:
    case Ad.St{+l, +q, +ts}:
      ad.twice(Ad.get(ts, k), l, q, ts, k, {==}, e)

# ending a ticket ends it
def ad.end_self(t: List<&2, Ad.Tk>, k: Nat, live: {Maybe.is_some(&2, Ad.Tk, Ad.get(t, k)) == True{} : Bool}) -> {Ad.ended(Ad.get(Ad.put(t, k, Ad.Ended{}), k)) == True{} : Bool}:
  match t:
    case Nil{}:
      ad.absurd({Ad.ended(None{}) == True{} : Bool}, live)
    case Ad.Tk{c, s} <> +r:
      match k:
        case 0n:
          {==}
        case 1n+p:
          ad.end_self(r, p, live)

def ad.some_at(-ts: List<&2, Ad.Tk>, -k: Nat, -mb: Maybe<&2, Ad.Tk>, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, f: {Maybe.is_some(&2, Ad.Tk, mb) == True{} : Bool}) -> {Maybe.is_some(&2, Ad.Tk, Ad.get(ts, k)) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), mb, ej) : {Maybe.is_some(&2, Ad.Tk, _) == True{} : Bool}
  f

def ad.ends(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, live: {Maybe.is_some(&2, Ad.Tk, mb) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.step(Ad.St{l, q, ts}, Ad.finish(mb, k)), k)) == True{} : Bool}:
  match mb:
    case None{}:
      ad.absurd({Ad.ended(Ad.status(Ad.step(Ad.St{l, q, ts}, Ad.Release{k}), k)) == True{} : Bool}, live)
    case Some{Ad.Tk{+c, Ad.Queued{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Queued{}}}, ej) : {Ad.ended(Ad.get(Ad.St.ts(Ad.leave.at(_, l, q, ts, k)), k)) == True{} : Bool}
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_self(ts, k, ad.some_at(ts, k, Some{Ad.Tk{c, Ad.Queued{}}}, ej, {==})))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Granted{}}}, ej) : {Ad.ended(Ad.get(Ad.St.ts(Ad.leave.at(_, l, q, ts, k)), k)) == True{} : Bool}
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_self(ts, k, ad.some_at(ts, k, Some{Ad.Tk{c, Ad.Granted{}}}, ej, {==})))
    case Some{Ad.Tk{+c, Ad.Held{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Held{}}}, ej) : {Ad.ended(Ad.get(Ad.St.ts(Ad.release.at(_, l, q, ts, k)), k)) == True{} : Bool}
      ad.end_grant_k(Ad.waits(t2), Ad.pick(l, t2), l, t2, k, ad.end_self(ts, k, ad.some_at(ts, k, Some{Ad.Tk{c, Ad.Held{}}}, ej, {==})))
    case Some{Ad.Tk{+c, Ad.Preempted{}}}:
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Preempted{}}}, ej) : {Ad.ended(Ad.get(Ad.St.ts(Ad.release.at(_, l, q, ts, k)), k)) == True{} : Bool}
      ad.end_self(ts, k, ad.some_at(ts, k, Some{Ad.Tk{c, Ad.Preempted{}}}, ej, {==}))
    case Some{Ad.Tk{+c, Ad.Ended{}}}:
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Ended{}}}, ej) : {Ad.ended(Ad.get(Ad.St.ts(Ad.release.at(_, l, q, ts, k)), k)) == True{} : Bool}
      %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), Some{Ad.Tk{c, Ad.Ended{}}}, ej) : {Ad.ended(_) == True{} : Bool}
      {==}

def every_ticket_ends(s: Ad.St, +k: Nat, live: {Maybe.is_some(&2, Ad.Tk, Ad.status(s, k)) == True{} : Bool}) -> {Ad.ended(Ad.status(Ad.step(s, Ad.finish(Ad.status(s, k), k)), k)) == True{} : Bool}:
  match s:
    case Ad.St{+l, +q, +ts}:
      ad.ends(Ad.get(ts, k), l, q, ts, k, {==}, live)

# Slots held stay within the limit
# --------------------------------

def ad.le_trans(a: Nat, b: Nat, c: Nat, ab: {Ad.le(a, b) == True{} : Bool}, bc: {Ad.le(b, c) == True{} : Bool}) -> {Ad.le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      {==}
    case 1n+x 0n _:
      ad.absurd({Ad.le(1n+x, c) == True{} : Bool}, ab)
    case 1n+x 1n+y 0n:
      ad.absurd({Ad.le(1n+x, 0n) == True{} : Bool}, bc)
    case 1n+x 1n+y 1n+z:
      ad.le_trans(x, y, z, ab, bc)

def ad.add_succ(a: Nat, -b: Nat) -> {1n+Nat.add(a, b) == Nat.add(a, 1n+b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %ad.add_succ(p, b) : {2n+Nat.add(p, b) == 1n+_ : Nat}
      {==}

def ad.add_one(n: Nat) -> {1n+n == Nat.add(n, 1n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %ad.add_one(p) : {2n+p == 1n+_ : Nat}
      {==}

def ad.or_tl(x: Bool, -y: Bool, ex: {x == True{} : Bool}) -> {Bool.or(x, y) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      ad.absurd({Bool.or(False{}, y) == True{} : Bool}, ex)

def ad.or_elim(w: Bool, -v: Bool, ih: {Bool.or(w, v) == True{} : Bool}, f: {v == True{} : Bool} -> {w == True{} : Bool}) -> {w == True{} : Bool}:
  match w:
    case True{}:
      {==}
    case False{}:
      f(ih)

def ad.pick_room(r: Bool, -wi: Nat, -hi: Nat, -wb: Nat, -c: Ad.Cls, e: {Ad.pick.go(r, wi, hi, wb) == Some{c} : Maybe<&2, Ad.Cls>}) -> {r == True{} : Bool}:
  match r:
    case True{}:
      {==}
    case False{}:
      %e : ad.BD(Maybe.is_some(&2, Ad.Cls, _), {False{} == True{} : Bool}, Unit)
      Unit{}

def ad.within_room(l: Ad.Lim, -n: Nat, rm: {Ad.room(l, n) == True{} : Bool}) -> {Ad.within(l, 1n+n) == True{} : Bool}:
  match l:
    case Ad.Unl{}:
      {==}
    case Ad.Cap{p}:
      rm

def ad.within_of(l: Ad.Lim, +g: Nat, +m: Nat, lg: {Ad.le(g, 1n+m) == True{} : Bool}, rm: {Ad.room(l, m) == True{} : Bool}) -> {Ad.within(l, g) == True{} : Bool}:
  match l:
    case Ad.Unl{}:
      {==}
    case Ad.Cap{+p}:
      ad.le_trans(g, 1n+m, 1n+p, lg, rm)

# a grant takes one more slot
def ad.held_mark(+t: List<&2, Ad.Tk>, c: Ad.Cls, +nz: {Ad.isz(Ad.cnt(Ad.Waiting{}, c, t)) == False{} : Bool}) -> {Ad.held(Ad.mark(c, t)) == 1n+Ad.held(t) : Nat}:
  match c:
    case Ad.Ia{}:
      +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t)
      +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t)
      +t2 = Ad.mark(Ad.Ia{}, t)
      %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2), 1n+hi, ad.cnt_mark(Ad.Holding{}, Ad.Ia{}, t, Ad.Ia{}, nz)) : {Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)) == 1n+Nat.add(hi, hb) : Nat}
      %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), hb, ad.cnt_mark(Ad.Holding{}, Ad.Bg{}, t, Ad.Ia{}, nz)) : {Nat.add(1n+hi, _) == 1n+Nat.add(hi, hb) : Nat}
      {==}
    case Ad.Bg{}:
      +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, t)
      +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, t)
      +t2 = Ad.mark(Ad.Bg{}, t)
      %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2), hi, ad.cnt_mark(Ad.Holding{}, Ad.Ia{}, t, Ad.Bg{}, nz)) : {Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)) == 1n+Nat.add(hi, hb) : Nat}
      %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), 1n+hb, ad.cnt_mark(Ad.Holding{}, Ad.Bg{}, t, Ad.Bg{}, nz)) : {Nat.add(hi, _) == 1n+Nat.add(hi, hb) : Nat}
      Equal.sym(Nat, 1n+Nat.add(hi, hb), Nat.add(hi, 1n+hb), ad.add_succ(hi, hb))

def ad.nz_of(+l: Ad.Lim, +t: List<&2, Ad.Tk>, c: Ad.Cls, +ed: {Ad.pick(l, t) == Some{c} : Maybe<&2, Ad.Cls>}) -> {Ad.isz(Ad.cnt(Ad.Waiting{}, c, t)) == False{} : Bool}:
  match c:
    case Ad.Ia{}:
      ad.pick_ia(Ad.room(l, Ad.held(t)), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t), Ad.cnt(Ad.Holding{}, Ad.Ia{}, t), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t), ed)
    case Ad.Bg{}:
      ad.bg_wb(t, ad.pbg(l, t, ed))

def ad.cap_tr(-w: Bool, -g: Nat, -a: Nat, -b: Nat, e: {a == b : Nat}, ih: {Bool.or(w, Ad.le(g, a)) == True{} : Bool}) -> {Bool.or(w, Ad.le(g, b)) == True{} : Bool}:
  %e : {Bool.or(w, Ad.le(g, _)) == True{} : Bool}
  ih

def ad.cap_stay(+l: Ad.Lim, +t: List<&2, Ad.Tk>) -> {Bool.or(Ad.within(l, Ad.held(t)), Ad.le(Ad.held(t), Ad.held(t))) == True{} : Bool}:
  %Equal.sym(Bool, Ad.le(Ad.held(t), Ad.held(t)), True{}, ad.le_refl(Ad.held(t))) : {Bool.or(Ad.within(l, Ad.held(t)), _) == True{} : Bool}
  ad.or_t(Ad.within(l, Ad.held(t)))

# grants happen only into free slots
def ad.cap_grant(+n: Nat, +d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +ed: {Ad.pick(l, t) == d : Maybe<&2, Ad.Cls>}) -> {Bool.or(Ad.within(l, Ad.held(Ad.grant.go(n, d, l, t))), Ad.le(Ad.held(Ad.grant.go(n, d, l, t)), Ad.held(t))) == True{} : Bool}:
  match n d:
    case 0n _:
      ad.cap_stay(l, t)
    case 1n+f None{}:
      ad.cap_stay(l, t)
    case 1n+f Some{+c}:
      +t2 = Ad.mark(c, t)
      +g = Ad.held(Ad.grant.go(f, Ad.pick(l, t2), l, t2))
      +w = Ad.within(l, g)
      +rm = ad.pick_room(Ad.room(l, Ad.held(t)), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t), Ad.cnt(Ad.Holding{}, Ad.Ia{}, t), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t), c, ed)
      +ih = ad.cap_tr(w, g, Ad.held(t2), 1n+Ad.held(t), ad.held_mark(t, c, ad.nz_of(l, t, c, ed)), ad.cap_grant(f, Ad.pick(l, t2), l, t2, {==}))
      ad.or_tl(w, Ad.le(g, Ad.held(t)), ad.or_elim(w, Ad.le(g, 1n+Ad.held(t)), ih, lg => ad.within_of(l, g, Ad.held(t), lg, rm)))

# Collected, released, left
def ad.held_col(+ts: List<&2, Ad.Tk>, +k: Nat, +c: Ad.Cls, +e: {Ad.get(ts, k) == Some{Ad.Tk{c, Ad.Granted{}}} : Maybe<&2, Ad.Tk>}) -> {Ad.held(Ad.put(ts, k, Ad.Held{})) == Ad.held(ts) : Nat}:
  +t2 = Ad.put(ts, k, Ad.Held{})
  %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2), Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts), ad.col_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, c, e)) : {Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)) == Ad.held(ts) : Nat}
  %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts), ad.col_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, c, e)) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts), _) == Ad.held(ts) : Nat}
  {==}

# a ticket that holds no slot ends
def ad.held_same(+ts: List<&2, Ad.Tk>, +k: Nat, +c: Ad.Cls, s: Ad.Sts, +e: {Ad.get(ts, k) == Some{Ad.Tk{c, s}} : Maybe<&2, Ad.Tk>}, hs: {Ad.Mode.of(Ad.Holding{}, s) == False{} : Bool}) -> {Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}:
  match s:
    case Ad.Queued{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, c, Ad.Queued{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, c, Ad.Queued{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      {==}
    case Ad.Granted{}:
      ad.absurd({Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}, Equal.sym(Bool, True{}, False{}, hs))
    case Ad.Held{}:
      ad.absurd({Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}, Equal.sym(Bool, True{}, False{}, hs))
    case Ad.Preempted{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, c, Ad.Preempted{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, c, Ad.Preempted{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      {==}
    case Ad.Ended{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, c, Ad.Ended{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, c, Ad.Ended{}, e) : {Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      {==}

# a ticket that holds a slot ends: one slot frees
def ad.held_end(+ts: List<&2, Ad.Tk>, +k: Nat, c: Ad.Cls, s: Ad.Sts, +e: {Ad.get(ts, k) == Some{Ad.Tk{c, s}} : Maybe<&2, Ad.Tk>}, hs: {Ad.Mode.of(Ad.Holding{}, s) == True{} : Bool}) -> {1n+Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}:
  match c s:
    case Ad.Ia{} Ad.Granted{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, Ad.Ia{}, Ad.Granted{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, Ad.Ia{}, Ad.Granted{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(1n+Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      {==}
    case Ad.Ia{} Ad.Held{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, Ad.Ia{}, Ad.Held{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, Ad.Ia{}, Ad.Held{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(1n+Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      {==}
    case Ad.Bg{} Ad.Granted{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, Ad.Bg{}, Ad.Granted{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, Ad.Bg{}, Ad.Granted{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      ad.add_succ(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{})))
    case Ad.Bg{} Ad.Held{}:
      %ad.end_cnt(Ad.Holding{}, Ad.Ia{}, ts, k, Ad.Bg{}, Ad.Held{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)) : Nat}
      %ad.end_cnt(Ad.Holding{}, Ad.Bg{}, ts, k, Ad.Bg{}, Ad.Held{}, e) : {1n+Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{}))) == Nat.add(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), _) : Nat}
      ad.add_succ(Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(ts, k, Ad.Ended{})), Ad.cnt(Ad.Holding{}, Ad.Bg{}, Ad.put(ts, k, Ad.Ended{})))
    case _ Ad.Queued{}:
      ad.absurd({1n+Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}, hs)
    case _ Ad.Preempted{}:
      ad.absurd({1n+Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}, hs)
    case _ Ad.Ended{}:
      ad.absurd({1n+Ad.held(Ad.put(ts, k, Ad.Ended{})) == Ad.held(ts) : Nat}, hs)

def ad.cap_id(+l: Ad.Lim, +n: Nat) -> {Bool.or(Ad.within(l, n), Ad.le(Nat.add(n, 0n), n)) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(n, 0n), n, ad.add_zero(n)) : {Bool.or(Ad.within(l, n), Ad.le(_, n)) == True{} : Bool}
  %Equal.sym(Bool, Ad.le(n, n), True{}, ad.le_refl(n)) : {Bool.or(Ad.within(l, n), _) == True{} : Bool}
  ad.or_t(Ad.within(l, n))

def ad.cap_add(-w: Bool, +g: Nat, +h: Nat, f: Nat, ih: {Bool.or(w, Ad.le(g, h)) == True{} : Bool}) -> {Bool.or(w, Ad.le(Nat.add(g, f), Nat.add(h, f))) == True{} : Bool}:
  match f:
    case 0n:
      %Equal.sym(Nat, Nat.add(g, 0n), g, ad.add_zero(g)) : {Bool.or(w, Ad.le(_, Nat.add(h, 0n))) == True{} : Bool}
      %Equal.sym(Nat, Nat.add(h, 0n), h, ad.add_zero(h)) : {Bool.or(w, Ad.le(g, _)) == True{} : Bool}
      ih
    case 1n+p:
      %ad.add_succ(g, p) : {Bool.or(w, Ad.le(_, Nat.add(h, 1n+p))) == True{} : Bool}
      %ad.add_succ(h, p) : {Bool.or(w, Ad.le(1n+Nat.add(g, p), _)) == True{} : Bool}
      ad.cap_add(w, g, h, p, ih)

# a grant after an op that freed f slots
def ad.cap_after(+l: Ad.Lim, +t2: List<&2, Ad.Tk>, +ts: List<&2, Ad.Tk>, +f: Nat, e: {Nat.add(Ad.held(t2), f) == Ad.held(ts) : Nat}) -> {Bool.or(Ad.within(l, Ad.held(Ad.grant(l, t2))), Ad.le(Nat.add(Ad.held(Ad.grant(l, t2)), f), Ad.held(ts))) == True{} : Bool}:
  +g = Ad.held(Ad.grant(l, t2))
  %e : {Bool.or(Ad.within(l, g), Ad.le(Nat.add(g, f), _)) == True{} : Bool}
  ad.cap_add(Ad.within(l, g), g, Ad.held(t2), f, ad.cap_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, {==}))

def ad.cap_keep(+l: Ad.Lim, +hi: Nat, +hb: Nat) -> {Bool.or(Ad.within(l, Nat.add(hi, 0n)), Ad.le(Nat.add(Nat.add(hi, 0n), hb), Nat.add(hi, hb))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(hi, 0n), hi, ad.add_zero(hi)) : {Bool.or(Ad.within(l, _), Ad.le(Nat.add(_, hb), Nat.add(hi, hb))) == True{} : Bool}
  %Equal.sym(Bool, Ad.le(Nat.add(hi, hb), Nat.add(hi, hb)), True{}, ad.le_refl(Nat.add(hi, hb))) : {Bool.or(Ad.within(l, hi), _) == True{} : Bool}
  ad.or_t(Ad.within(l, hi))

def ad.room_z(-l: Ad.Lim, +hi: Nat, er: {Ad.room(l, hi) == True{} : Bool}) -> {Ad.room(l, Nat.add(hi, 0n)) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(hi, 0n), hi, ad.add_zero(hi)) : {Ad.room(l, _) == True{} : Bool}
  er

def ad.cap_ia0(+l: Ad.Lim, +hi: Nat, +hb: Nat, r: Bool, u: Bool, er: {Ad.room(l, hi) == r : Bool}) -> {Bool.or(Ad.within(l, Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(r, u)}), hi), 0n)), Ad.le(Nat.add(Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(r, u)}), hi), 0n), hb), Nat.add(hi, hb))) == True{} : Bool}:
  match r u:
    case True{} _:
      ad.or_tl(Ad.within(l, 1n+Nat.add(hi, 0n)), Ad.le(1n+Nat.add(Nat.add(hi, 0n), hb), Nat.add(hi, hb)), ad.within_room(l, Nat.add(hi, 0n), ad.room_z(l, hi, er)))
    case False{} True{}:
      ad.cap_keep(l, hi, hb)
    case False{} False{}:
      ad.cap_keep(l, hi, hb)

def ad.cap_ia1(+l: Ad.Lim, +hi: Nat, +hb: Nat, u: Bool) -> {Bool.or(Ad.within(l, Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(False{}, u)}), hi), 0n)), Ad.le(Nat.add(Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(False{}, u)}), hi), 0n), hb), Nat.add(hi, hb))) == True{} : Bool}:
  match u:
    case True{}:
      ad.cap_keep(l, hi, hb)
    case False{}:
      ad.cap_keep(l, hi, hb)

def ad.cap_ia(+l: Ad.Lim, +q: Nat, wi: Nat, +hi: Nat, +hb: Nat) -> {Bool.or(Ad.within(l, Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(Bool.and(Ad.isz(wi), Ad.room(l, hi)), Ad.le(q, wi))}), hi), 0n)), Ad.le(Nat.add(Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.admit.ia.st(Bool.and(Ad.isz(wi), Ad.room(l, hi)), Ad.le(q, wi))}), hi), 0n), hb), Nat.add(hi, hb))) == True{} : Bool}:
  match wi:
    case 0n:
      ad.cap_ia0(l, hi, hb, Ad.room(l, hi), Ad.le(q, 0n), {==})
    case 1n+w:
      ad.cap_ia1(l, hi, hb, Ad.le(q, 1n+w))

def ad.cap_bg0(+l: Ad.Lim, +hb: Nat, r: Bool, er: {Ad.room(l, hb) == r : Bool}) -> {Bool.or(Ad.within(l, Ad.bit(Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.admit.bg.st(r)}), hb)), Ad.le(Nat.add(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.admit.bg.st(r)}), hb), 0n), hb)) == True{} : Bool}:
  match r:
    case True{}:
      ad.or_tl(Ad.within(l, 1n+hb), Ad.le(1n+Nat.add(hb, 0n), hb), ad.within_room(l, hb, er))
    case False{}:
      ad.cap_id(l, hb)

def ad.cap_bg(+l: Ad.Lim, hi: Nat, wi: Nat, wb: Nat, +hb: Nat) -> {Bool.or(Ad.within(l, Nat.add(hi, Ad.bit(Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.admit.bg.st(Bool.and(Ad.isz(hi), Bool.and(Ad.isz(wi), Bool.and(Ad.isz(wb), Ad.room(l, Nat.add(hi, hb))))))}), hb))), Ad.le(Nat.add(Nat.add(hi, Ad.bit(Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.admit.bg.st(Bool.and(Ad.isz(hi), Bool.and(Ad.isz(wi), Bool.and(Ad.isz(wb), Ad.room(l, Nat.add(hi, hb))))))}), hb)), 0n), Nat.add(hi, hb))) == True{} : Bool}:
  match hi:
    case 1n+a:
      ad.cap_id(l, Nat.add(1n+a, hb))
    case 0n:
      match wi:
        case 1n+b:
          ad.cap_id(l, hb)
        case 0n:
          match wb:
            case 1n+c:
              ad.cap_id(l, hb)
            case 0n:
              ad.cap_bg0(l, hb, Ad.room(l, hb), {==})

def ad.cap_col(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, e: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Bool.or(Ad.within(Ad.St.lim(Ad.collect.at(mb, l, q, ts, k)), Ad.held(Ad.St.ts(Ad.collect.at(mb, l, q, ts, k)))), Ad.le(Nat.add(Ad.held(Ad.St.ts(Ad.collect.at(mb, l, q, ts, k))), 0n), Ad.held(ts))) == True{} : Bool}:
  match mb:
    case None{}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Held{})
      %Equal.sym(Nat, Ad.held(t2), Ad.held(ts), ad.held_col(ts, k, c, e)) : {Bool.or(Ad.within(l, _), Ad.le(Nat.add(_, 0n), Ad.held(ts))) == True{} : Bool}
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      ad.cap_id(l, Ad.held(ts))

def ad.cap_rel(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, e: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Bool.or(Ad.within(Ad.St.lim(Ad.release.at(mb, l, q, ts, k)), Ad.held(Ad.St.ts(Ad.release.at(mb, l, q, ts, k)))), Ad.le(Nat.add(Ad.held(Ad.St.ts(Ad.release.at(mb, l, q, ts, k))), Ad.freed.at(mb, True{})), Ad.held(ts))) == True{} : Bool}:
  match mb:
    case None{}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{+c, Ad.Held{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      ad.cap_after(l, t2, ts, 1n, Equal.trans(Nat, Nat.add(Ad.held(t2), 1n), 1n+Ad.held(t2), Ad.held(ts), Equal.sym(Nat, 1n+Ad.held(t2), Nat.add(Ad.held(t2), 1n), ad.add_one(Ad.held(t2))), ad.held_end(ts, k, c, Ad.Held{}, e, {==})))
    case Some{Ad.Tk{+c, Ad.Preempted{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.held(t2), Ad.held(ts), ad.held_same(ts, k, c, Ad.Preempted{}, e, {==})) : {Bool.or(Ad.within(l, _), Ad.le(Nat.add(_, 0n), Ad.held(ts))) == True{} : Bool}
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      ad.cap_id(l, Ad.held(ts))

def ad.cap_lea(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, e: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Bool.or(Ad.within(Ad.St.lim(Ad.leave.at(mb, l, q, ts, k)), Ad.held(Ad.St.ts(Ad.leave.at(mb, l, q, ts, k)))), Ad.le(Nat.add(Ad.held(Ad.St.ts(Ad.leave.at(mb, l, q, ts, k))), Ad.freed.at(mb, False{})), Ad.held(ts))) == True{} : Bool}:
  match mb:
    case None{}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{+c, Ad.Queued{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      ad.cap_after(l, t2, ts, 0n, Equal.trans(Nat, Nat.add(Ad.held(t2), 0n), Ad.held(t2), Ad.held(ts), ad.add_zero(Ad.held(t2)), ad.held_same(ts, k, c, Ad.Queued{}, e, {==})))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      ad.cap_after(l, t2, ts, 1n, Equal.trans(Nat, Nat.add(Ad.held(t2), 1n), 1n+Ad.held(t2), Ad.held(ts), Equal.sym(Nat, 1n+Ad.held(t2), Nat.add(Ad.held(t2), 1n), ad.add_one(Ad.held(t2))), ad.held_end(ts, k, c, Ad.Granted{}, e, {==})))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      ad.cap_id(l, Ad.held(ts))
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      ad.cap_id(l, Ad.held(ts))

def capacity(s: Ad.St, o: Ad.Op) -> {Bool.or(Ad.within(Ad.St.lim(Ad.step(s, o)), Ad.held(Ad.St.ts(Ad.step(s, o)))), Ad.le(Nat.add(Ad.held(Ad.St.ts(Ad.step(s, o))), Ad.freed(s, o)), Ad.held(Ad.St.ts(s)))) == True{} : Bool}:
  match s:
    case Ad.St{+l, +q, +ts}:
      match o:
        case Ad.Admit{Ad.Ia{}}:
          +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
          +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
          +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)
          +st = Ad.admit.ia.st(Bool.and(Ad.isz(wi), Ad.room(l, hi)), Ad.le(q, wi))
          +x = {Ad.Tk{Ad.Ia{}, st} : Ad.Tk}
          +t1 = Ad.preempt(ts)
          +t2 = List.append(&2, Ad.Tk, t1, [x])
          +b = Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, x), hi)
          %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2), b, ad.app_pre(Ad.Holding{}, ts, x)) : {Bool.or(Ad.within(l, Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2))), Ad.le(Nat.add(Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)), hb), Nat.add(hi, hb))) == True{} : Bool}
          %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), 0n, Equal.trans(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), Ad.cnt(Ad.Holding{}, Ad.Bg{}, t1), 0n, ad.app_off(Ad.Holding{}, Ad.Bg{}, t1, x, ad.and_f(Ad.Mode.of(Ad.Holding{}, st))), ad.pre_hb(ts))) : {Bool.or(Ad.within(l, Nat.add(b, _)), Ad.le(Nat.add(Nat.add(b, _), hb), Nat.add(hi, hb))) == True{} : Bool}
          ad.cap_ia(l, q, wi, hi, hb)
        case Ad.Admit{Ad.Bg{}}:
          +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
          +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
          +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)
          +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts)
          +st = Ad.admit.bg.st(Bool.and(Ad.isz(hi), Bool.and(Ad.isz(wi), Bool.and(Ad.isz(wb), Ad.room(l, Nat.add(hi, hb))))))
          +y = {Ad.Tk{Ad.Bg{}, st} : Ad.Tk}
          +t2 = List.append(&2, Ad.Tk, ts, [y])
          +b = Ad.bit(Ad.hit(Ad.Holding{}, Ad.Bg{}, y), hb)
          %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Ia{}, t2), hi, ad.app_off(Ad.Holding{}, Ad.Ia{}, ts, y, ad.and_f(Ad.Mode.of(Ad.Holding{}, st)))) : {Bool.or(Ad.within(l, Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2))), Ad.le(Nat.add(Nat.add(_, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2)), 0n), Nat.add(hi, hb))) == True{} : Bool}
          %Equal.sym(Nat, Ad.cnt(Ad.Holding{}, Ad.Bg{}, t2), b, ad.cnt_app(Ad.Holding{}, Ad.Bg{}, ts, y)) : {Bool.or(Ad.within(l, Nat.add(hi, _)), Ad.le(Nat.add(Nat.add(hi, _), 0n), Nat.add(hi, hb))) == True{} : Bool}
          ad.cap_bg(l, hi, wi, wb, hb)
        case Ad.Collect{+k}:
          ad.cap_col(Ad.get(ts, k), l, q, ts, k, {==})
        case Ad.Release{+k}:
          ad.cap_rel(Ad.get(ts, k), l, q, ts, k, {==})
        case Ad.Leave{+k}:
          ad.cap_lea(Ad.get(ts, k), l, q, ts, k, {==})
        case Ad.Limit{+l2, q2}:
          ad.cap_after(l2, ts, ts, 0n, ad.add_zero(Ad.held(ts)))

# Grants within a class go oldest first
# -------------------------------------

def ad.or_f(x: Bool) -> {Bool.or(x, False{}) == x : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

def ad.or_nt(-x: Bool, -y: Bool, e: {x == False{} : Bool}) -> {Bool.or(Bool.not(x), y) == True{} : Bool}:
  %Equal.sym(Bool, x, False{}, e) : {Bool.or(Bool.not(_), y) == True{} : Bool}
  {==}

# with no waiter seen yet, every holder is in order
def ad.f_any(t: List<&2, Ad.Tk>, +c: Ad.Cls, b: Bool, e: {Ad.fifo(c, t, True{}) == True{} : Bool}) -> {Ad.fifo(c, t, b) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match b:
        case True{}:
          e
        case False{}:
          ad.f_any(r, c, Ad.hit(Ad.Waiting{}, c, h), ad.and_r(Bool.not(Ad.hit(Ad.Holding{}, c, h)), Ad.fifo(c, r, True{}), e))

def ad.f_weak(+r: List<&2, Ad.Tk>, +c: Ad.Cls, s: Bool, w: Bool, e: {Ad.fifo(c, r, Bool.or(s, w)) == True{} : Bool}) -> {Ad.fifo(c, r, s) == True{} : Bool}:
  match s:
    case True{}:
      e
    case False{}:
      match w:
        case True{}:
          ad.f_any(r, c, False{}, e)
        case False{}:
          e

def ad.f_pre_ia(t: List<&2, Ad.Tk>, +s: Bool) -> {Ad.fifo(Ad.Ia{}, Ad.preempt(t), s) == Ad.fifo(Ad.Ia{}, t, s) : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      +hh = Ad.hit(Ad.Holding{}, Ad.Ia{}, h)
      +hw = Ad.hit(Ad.Waiting{}, Ad.Ia{}, h)
      +rhs = Bool.and(Bool.not(Bool.and(s, hh)), Ad.fifo(Ad.Ia{}, r, Bool.or(s, hw)))
      %Equal.sym(Bool, Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk.preempt(h)), hh, ad.hit_pre(Ad.Holding{}, h)) : {Bool.and(Bool.not(Bool.and(s, _)), Ad.fifo(Ad.Ia{}, Ad.preempt(r), Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk.preempt(h))))) == rhs : Bool}
      %Equal.sym(Bool, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk.preempt(h)), hw, ad.hit_pre(Ad.Waiting{}, h)) : {Bool.and(Bool.not(Bool.and(s, hh)), Ad.fifo(Ad.Ia{}, Ad.preempt(r), Bool.or(s, _))) == rhs : Bool}
      %Equal.sym(Bool, Ad.fifo(Ad.Ia{}, Ad.preempt(r), Bool.or(s, hw)), Ad.fifo(Ad.Ia{}, r, Bool.or(s, hw)), ad.f_pre_ia(r, Bool.or(s, hw))) : {Bool.and(Bool.not(Bool.and(s, hh)), _) == rhs : Bool}
      {==}

def ad.f_pre_bg(t: List<&2, Ad.Tk>, +s: Bool) -> {Ad.fifo(Ad.Bg{}, Ad.preempt(t), s) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      +rest = Ad.fifo(Ad.Bg{}, Ad.preempt(r), Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk.preempt(h))))
      %Equal.sym(Bool, Ad.hit(Ad.Holding{}, Ad.Bg{}, Ad.Tk.preempt(h)), False{}, ad.hb_pre(h)) : {Bool.and(Bool.not(Bool.and(s, _)), rest) == True{} : Bool}
      %Equal.sym(Bool, Bool.and(s, False{}), False{}, ad.and_f(s)) : {Bool.and(Bool.not(_), rest) == True{} : Bool}
      ad.f_pre_bg(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk.preempt(h))))

def ad.fapp0(s: Bool, x: Bool, ok: {Bool.or(Bool.not(x), Bool.and(Bool.not(s), True{})) == True{} : Bool}) -> {Bool.and(Bool.not(Bool.and(s, x)), True{}) == True{} : Bool}:
  match s x:
    case True{} True{}:
      ad.absurd({False{} == True{} : Bool}, ok)
    case True{} False{}:
      {==}
    case False{} _:
      {==}

def ad.fapp_ok(x: Bool, s: Bool, w: Bool, n: Nat, ok: {Bool.or(Bool.not(x), Bool.and(Bool.not(s), Ad.isz(Ad.bit(w, n)))) == True{} : Bool}) -> {Bool.or(Bool.not(x), Bool.and(Bool.not(Bool.or(s, w)), Ad.isz(n))) == True{} : Bool}:
  match x s w:
    case False{} _ _:
      {==}
    case True{} True{} _:
      ad.absurd({Bool.or(False{}, Bool.and(False{}, Ad.isz(n))) == True{} : Bool}, ok)
    case True{} False{} True{}:
      ad.absurd({Bool.or(False{}, Bool.and(False{}, Ad.isz(n))) == True{} : Bool}, ok)
    case True{} False{} False{}:
      ok

# a ticket appended keeps the order, if it takes no slot while an older
# one of its class waits
def ad.f_app(t: List<&2, Ad.Tk>, +c: Ad.Cls, +s: Bool, +x: Ad.Tk, +e: {Ad.fifo(c, t, s) == True{} : Bool}, ok: {Bool.or(Bool.not(Ad.hit(Ad.Holding{}, c, x)), Bool.and(Bool.not(s), Ad.isz(Ad.cnt(Ad.Waiting{}, c, t)))) == True{} : Bool}) -> {Ad.fifo(c, List.append(&2, Ad.Tk, t, [x]), s) == True{} : Bool}:
  match t:
    case Nil{}:
      ad.fapp0(s, Ad.hit(Ad.Holding{}, c, x), ok)
    case +h <> +r:
      +hh = Ad.hit(Ad.Holding{}, c, h)
      +hw = Ad.hit(Ad.Waiting{}, c, h)
      ad.and_t(Bool.not(Bool.and(s, hh)), Ad.fifo(c, List.append(&2, Ad.Tk, r, [x]), Bool.or(s, hw)), ad.and_l(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e), ad.f_app(r, c, Bool.or(s, hw), x, ad.and_r(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e), ad.fapp_ok(Ad.hit(Ad.Holding{}, c, x), s, hw, Ad.cnt(Ad.Waiting{}, c, r), ok)))

# a ticket that ends keeps the order
def ad.f_end(t: List<&2, Ad.Tk>, +c: Ad.Cls, +s: Bool, k: Nat, +e: {Ad.fifo(c, t, s) == True{} : Bool}) -> {Ad.fifo(c, Ad.put(t, k, Ad.Ended{}), s) == True{} : Bool}:
  match t k:
    case Nil{} _:
      e
    case Ad.Tk{+hc, +hs} <> +r 0n:
      +hh = Ad.hit(Ad.Holding{}, c, Ad.Tk{hc, hs})
      +hw = Ad.hit(Ad.Waiting{}, c, Ad.Tk{hc, hs})
      %Equal.sym(Bool, Bool.and(s, False{}), False{}, ad.and_f(s)) : {Bool.and(Bool.not(_), Ad.fifo(c, r, Bool.or(s, False{}))) == True{} : Bool}
      %Equal.sym(Bool, Bool.or(s, False{}), s, ad.or_f(s)) : {Ad.fifo(c, r, _) == True{} : Bool}
      ad.f_weak(r, c, s, hw, ad.and_r(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e))
    case Ad.Tk{+hc, +hs} <> +r 1n+p:
      +hh = Ad.hit(Ad.Holding{}, c, Ad.Tk{hc, hs})
      +hw = Ad.hit(Ad.Waiting{}, c, Ad.Tk{hc, hs})
      ad.and_t(Bool.not(Bool.and(s, hh)), Ad.fifo(c, Ad.put(r, p, Ad.Ended{}), Bool.or(s, hw)), ad.and_l(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e), ad.f_end(r, c, Bool.or(s, hw), p, ad.and_r(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e)))

def ad.isg(m: Maybe<&2, Ad.Tk>) -> Bool:
  match m:
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      True{}
    case _:
      False{}

def ad.fcol0(+hc: Ad.Cls, hs: Ad.Sts, +r: List<&2, Ad.Tk>, +c: Ad.Cls, +s: Bool, e: {Ad.fifo(c, Ad.Tk{hc, hs} <> r, s) == True{} : Bool}, g: {ad.isg(Some{Ad.Tk{hc, hs}}) == True{} : Bool}) -> {Ad.fifo(c, Ad.Tk{hc, Ad.Held{}} <> r, s) == True{} : Bool}:
  match hs:
    case Ad.Queued{}:
      ad.absurd({Ad.fifo(c, Ad.Tk{hc, Ad.Held{}} <> r, s) == True{} : Bool}, g)
    case Ad.Granted{}:
      e
    case Ad.Held{}:
      ad.absurd({Ad.fifo(c, Ad.Tk{hc, Ad.Held{}} <> r, s) == True{} : Bool}, g)
    case Ad.Preempted{}:
      ad.absurd({Ad.fifo(c, Ad.Tk{hc, Ad.Held{}} <> r, s) == True{} : Bool}, g)
    case Ad.Ended{}:
      ad.absurd({Ad.fifo(c, Ad.Tk{hc, Ad.Held{}} <> r, s) == True{} : Bool}, g)

# collecting a grant keeps the order
def ad.f_col(t: List<&2, Ad.Tk>, +c: Ad.Cls, +s: Bool, k: Nat, +e: {Ad.fifo(c, t, s) == True{} : Bool}, g: {ad.isg(Ad.get(t, k)) == True{} : Bool}) -> {Ad.fifo(c, Ad.put(t, k, Ad.Held{}), s) == True{} : Bool}:
  match t k:
    case Nil{} _:
      e
    case Ad.Tk{+hc, +hs} <> +r 0n:
      ad.fcol0(hc, hs, r, c, s, e, g)
    case Ad.Tk{+hc, +hs} <> +r 1n+p:
      +hh = Ad.hit(Ad.Holding{}, c, Ad.Tk{hc, hs})
      +hw = Ad.hit(Ad.Waiting{}, c, Ad.Tk{hc, hs})
      ad.and_t(Bool.not(Bool.and(s, hh)), Ad.fifo(c, Ad.put(r, p, Ad.Held{}), Bool.or(s, hw)), ad.and_l(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e), ad.f_col(r, c, Bool.or(s, hw), p, ad.and_r(Bool.not(Bool.and(s, hh)), Ad.fifo(c, r, Bool.or(s, hw)), e), g))

# a grant to class c takes its oldest waiter
def ad.f_mark(t: List<&2, Ad.Tk>, +c: Ad.Cls, e: {Ad.fifo(c, t, False{}) == True{} : Bool}) -> {Ad.fifo(c, Ad.mark(c, t), False{}) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Ia{} Ad.Queued{}:
          match c:
            case Ad.Ia{}:
              ad.f_any(r, Ad.Ia{}, False{}, e)
            case Ad.Bg{}:
              ad.f_mark(r, Ad.Bg{}, e)
        case Ad.Bg{} Ad.Queued{}:
          match c:
            case Ad.Ia{}:
              ad.f_mark(r, Ad.Ia{}, e)
            case Ad.Bg{}:
              ad.f_any(r, Ad.Bg{}, False{}, e)
        case _ Ad.Granted{}:
          ad.f_mark(r, c, e)
        case _ Ad.Held{}:
          ad.f_mark(r, c, e)
        case _ Ad.Preempted{}:
          ad.f_mark(r, c, e)
        case _ Ad.Ended{}:
          ad.f_mark(r, c, e)

# a grant to the other class keeps the order: (c, d) is (Ia, Bg) or
# (Bg, Ia)
def ad.f_tail(+c: Ad.Cls, +h: Ad.Tk, -r: List<&2, Ad.Tk>, +s: Bool, e: {Ad.fifo(c, h <> r, s) == True{} : Bool}) -> {Ad.fifo(c, r, Bool.or(s, Ad.hit(Ad.Waiting{}, c, h))) == True{} : Bool}:
  ad.and_r(Bool.not(Bool.and(s, Ad.hit(Ad.Holding{}, c, h))), Ad.fifo(c, r, Bool.or(s, Ad.hit(Ad.Waiting{}, c, h))), e)

def ad.f_skip(+c: Ad.Cls, +h: Ad.Tk, -r2: List<&2, Ad.Tk>, -r: List<&2, Ad.Tk>, +s: Bool, e: {Ad.fifo(c, h <> r, s) == True{} : Bool}, ih: {Ad.fifo(c, r2, Bool.or(s, Ad.hit(Ad.Waiting{}, c, h))) == True{} : Bool}) -> {Ad.fifo(c, h <> r2, s) == True{} : Bool}:
  ad.and_t(Bool.not(Bool.and(s, Ad.hit(Ad.Holding{}, c, h))), Ad.fifo(c, r2, Bool.or(s, Ad.hit(Ad.Waiting{}, c, h))), ad.and_l(Bool.not(Bool.and(s, Ad.hit(Ad.Holding{}, c, h))), Ad.fifo(c, r, Bool.or(s, Ad.hit(Ad.Waiting{}, c, h))), e), ih)

def ad.f_mark_ib(t: List<&2, Ad.Tk>, +s: Bool, +e: {Ad.fifo(Ad.Ia{}, t, s) == True{} : Bool}) -> {Ad.fifo(Ad.Ia{}, Ad.mark(Ad.Bg{}, t), s) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Bg{} Ad.Queued{}:
          e
        case Ad.Ia{} Ad.Queued{}:
          ad.f_skip(Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}}, Ad.mark(Ad.Bg{}, r), r, s, e, ad.f_mark_ib(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}})), ad.f_tail(Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}}, r, s, e)))
        case _ Ad.Granted{}:
          ad.f_skip(Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}}, Ad.mark(Ad.Bg{}, r), r, s, e, ad.f_mark_ib(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}})), ad.f_tail(Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}}, r, s, e)))
        case _ Ad.Held{}:
          ad.f_skip(Ad.Ia{}, Ad.Tk{hc, Ad.Held{}}, Ad.mark(Ad.Bg{}, r), r, s, e, ad.f_mark_ib(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Held{}})), ad.f_tail(Ad.Ia{}, Ad.Tk{hc, Ad.Held{}}, r, s, e)))
        case _ Ad.Preempted{}:
          ad.f_skip(Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}}, Ad.mark(Ad.Bg{}, r), r, s, e, ad.f_mark_ib(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}})), ad.f_tail(Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}}, r, s, e)))
        case _ Ad.Ended{}:
          ad.f_skip(Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}}, Ad.mark(Ad.Bg{}, r), r, s, e, ad.f_mark_ib(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}})), ad.f_tail(Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}}, r, s, e)))

def ad.f_mark_bi(t: List<&2, Ad.Tk>, +s: Bool, +e: {Ad.fifo(Ad.Bg{}, t, s) == True{} : Bool}) -> {Ad.fifo(Ad.Bg{}, Ad.mark(Ad.Ia{}, t), s) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Ia{} Ad.Queued{}:
          e
        case Ad.Bg{} Ad.Queued{}:
          ad.f_skip(Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}}, Ad.mark(Ad.Ia{}, r), r, s, e, ad.f_mark_bi(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}})), ad.f_tail(Ad.Bg{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}}, r, s, e)))
        case _ Ad.Granted{}:
          ad.f_skip(Ad.Bg{}, Ad.Tk{hc, Ad.Granted{}}, Ad.mark(Ad.Ia{}, r), r, s, e, ad.f_mark_bi(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk{hc, Ad.Granted{}})), ad.f_tail(Ad.Bg{}, Ad.Tk{hc, Ad.Granted{}}, r, s, e)))
        case _ Ad.Held{}:
          ad.f_skip(Ad.Bg{}, Ad.Tk{hc, Ad.Held{}}, Ad.mark(Ad.Ia{}, r), r, s, e, ad.f_mark_bi(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk{hc, Ad.Held{}})), ad.f_tail(Ad.Bg{}, Ad.Tk{hc, Ad.Held{}}, r, s, e)))
        case _ Ad.Preempted{}:
          ad.f_skip(Ad.Bg{}, Ad.Tk{hc, Ad.Preempted{}}, Ad.mark(Ad.Ia{}, r), r, s, e, ad.f_mark_bi(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk{hc, Ad.Preempted{}})), ad.f_tail(Ad.Bg{}, Ad.Tk{hc, Ad.Preempted{}}, r, s, e)))
        case _ Ad.Ended{}:
          ad.f_skip(Ad.Bg{}, Ad.Tk{hc, Ad.Ended{}}, Ad.mark(Ad.Ia{}, r), r, s, e, ad.f_mark_bi(r, Bool.or(s, Ad.hit(Ad.Waiting{}, Ad.Bg{}, Ad.Tk{hc, Ad.Ended{}})), ad.f_tail(Ad.Bg{}, Ad.Tk{hc, Ad.Ended{}}, r, s, e)))

def ad.f_grant(n: Nat, d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +e: {Ad.fifo.both(t) == True{} : Bool}) -> {Ad.fifo.both(Ad.grant.go(n, d, l, t)) == True{} : Bool}:
  match n d:
    case 0n _:
      e
    case 1n+f None{}:
      e
    case 1n+f Some{Ad.Ia{}}:
      +t2 = Ad.mark(Ad.Ia{}, t)
      ad.f_grant(f, Ad.pick(l, t2), l, t2, ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_mark(t, Ad.Ia{}, ad.and_l(Ad.fifo(Ad.Ia{}, t, False{}), Ad.fifo(Ad.Bg{}, t, False{}), e)), ad.f_mark_bi(t, False{}, ad.and_r(Ad.fifo(Ad.Ia{}, t, False{}), Ad.fifo(Ad.Bg{}, t, False{}), e))))
    case 1n+f Some{Ad.Bg{}}:
      +t2 = Ad.mark(Ad.Bg{}, t)
      ad.f_grant(f, Ad.pick(l, t2), l, t2, ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_mark_ib(t, False{}, ad.and_l(Ad.fifo(Ad.Ia{}, t, False{}), Ad.fifo(Ad.Bg{}, t, False{}), e)), ad.f_mark(t, Ad.Bg{}, ad.and_r(Ad.fifo(Ad.Ia{}, t, False{}), Ad.fifo(Ad.Bg{}, t, False{}), e))))

def ad.f_end2(+ts: List<&2, Ad.Tk>, +k: Nat, +e: {Ad.fifo.both(ts) == True{} : Bool}) -> {Ad.fifo.both(Ad.put(ts, k, Ad.Ended{})) == True{} : Bool}:
  +t2 = Ad.put(ts, k, Ad.Ended{})
  ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_end(ts, Ad.Ia{}, False{}, k, ad.and_l(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e)), ad.f_end(ts, Ad.Bg{}, False{}, k, ad.and_r(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e)))

def ad.f_end_grant(+l: Ad.Lim, +ts: List<&2, Ad.Tk>, +k: Nat, +e: {Ad.fifo.both(ts) == True{} : Bool}) -> {Ad.fifo.both(Ad.grant(l, Ad.put(ts, k, Ad.Ended{}))) == True{} : Bool}:
  +t2 = Ad.put(ts, k, Ad.Ended{})
  ad.f_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, ad.f_end2(ts, k, e))

def ad.isg_at(-ts: List<&2, Ad.Tk>, -k: Nat, -mb: Maybe<&2, Ad.Tk>, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, f: {ad.isg(mb) == True{} : Bool}) -> {ad.isg(Ad.get(ts, k)) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Ad.Tk>, Ad.get(ts, k), mb, ej) : {ad.isg(_) == True{} : Bool}
  f

def ad.f_col_op(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, +e: {Ad.fifo.both(ts) == True{} : Bool}) -> {Ad.fifo.both(Ad.St.ts(Ad.collect.at(mb, l, q, ts, k))) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      e
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Held{})
      +g = ad.isg_at(ts, k, Some{Ad.Tk{c, Ad.Granted{}}}, ej, {==})
      ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_col(ts, Ad.Ia{}, False{}, k, ad.and_l(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e), g), ad.f_col(ts, Ad.Bg{}, False{}, k, ad.and_r(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e), g))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      e
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      e
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ad.f_rel_op(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +e: {Ad.fifo.both(ts) == True{} : Bool}) -> {Ad.fifo.both(Ad.St.ts(Ad.release.at(mb, l, q, ts, k))) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      e
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      e
    case Some{Ad.Tk{c, Ad.Held{}}}:
      ad.f_end_grant(l, ts, k, e)
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      ad.f_end2(ts, k, e)
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ad.f_lea_op(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +e: {Ad.fifo.both(ts) == True{} : Bool}) -> {Ad.fifo.both(Ad.St.ts(Ad.leave.at(mb, l, q, ts, k))) == True{} : Bool}:
  match mb:
    case None{}:
      e
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      ad.f_end_grant(l, ts, k, e)
    case Some{Ad.Tk{c, Ad.Granted{}}}:
      ad.f_end_grant(l, ts, k, e)
    case Some{Ad.Tk{c, Ad.Held{}}}:
      e
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      e
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      e

def ad.fifo_ia_ok(wi: Nat, r: Bool, u: Bool) -> {Bool.or(Bool.not(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.ia.st(Bool.and(Ad.isz(wi), r), u)), True{})), Ad.isz(wi)) == True{} : Bool}:
  match wi:
    case 0n:
      ad.or_t(Bool.not(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.ia.st(r, u)), True{})))
    case 1n+w:
      match u:
        case True{}:
          {==}
        case False{}:
          {==}

def ad.fifo_bg_ok(a: Bool, b: Bool, w: Bool, r: Bool) -> {Bool.or(Bool.not(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.bg.st(Bool.and(a, Bool.and(b, Bool.and(w, r))))), True{})), w) == True{} : Bool}:
  match a b w:
    case False{} _ _:
      {==}
    case True{} False{} _:
      {==}
    case True{} True{} False{}:
      {==}
    case True{} True{} True{}:
      ad.or_t(Bool.not(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.bg.st(r)), True{})))

def ad.fifo_wi(-a: Nat, -b: Nat, -x: Bool, e: {b == a : Nat}, h: {Bool.or(x, Ad.isz(b)) == True{} : Bool}) -> {Bool.or(x, Bool.and(Bool.not(False{}), Ad.isz(a))) == True{} : Bool}:
  %e : {Bool.or(x, Ad.isz(_)) == True{} : Bool}
  h

def ad.f_step(s: Ad.St, o: Ad.Op, +e: {Ad.fifo.both(Ad.St.ts(s)) == True{} : Bool}) -> {Ad.fifo.both(Ad.St.ts(Ad.step(s, o))) == True{} : Bool}:
  match s o:
    case Ad.St{+l, +q, +ts} Ad.Admit{Ad.Ia{}}:
      +ei = ad.and_l(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e)
      +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
      +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
      +st = Ad.admit.ia.st(Bool.and(Ad.isz(wi), Ad.room(l, hi)), Ad.le(q, wi))
      +x = {Ad.Tk{Ad.Ia{}, st} : Ad.Tk}
      +t1 = Ad.preempt(ts)
      +t2 = List.append(&2, Ad.Tk, t1, [x])
      +oki = ad.fifo_wi(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t1), wi, Bool.not(Ad.hit(Ad.Holding{}, Ad.Ia{}, x)), Equal.sym(Nat, Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t1), wi, ad.pre_ia(Ad.Waiting{}, ts)), ad.fifo_ia_ok(wi, Ad.room(l, hi), Ad.le(q, wi)))
      ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_app(t1, Ad.Ia{}, False{}, x, Equal.trans(Bool, Ad.fifo(Ad.Ia{}, t1, False{}), Ad.fifo(Ad.Ia{}, ts, False{}), True{}, ad.f_pre_ia(ts, False{}), ei), oki), ad.f_app(t1, Ad.Bg{}, False{}, x, ad.f_pre_bg(ts, False{}), ad.or_nt(Ad.hit(Ad.Holding{}, Ad.Bg{}, x), Bool.and(True{}, Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Bg{}, t1))), ad.and_f(Ad.Mode.of(Ad.Holding{}, st)))))
    case Ad.St{+l, +q, +ts} Ad.Admit{Ad.Bg{}}:
      +ei = ad.and_l(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e)
      +eb = ad.and_r(Ad.fifo(Ad.Ia{}, ts, False{}), Ad.fifo(Ad.Bg{}, ts, False{}), e)
      +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
      +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
      +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)
      +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts)
      +st = Ad.admit.bg.st(Bool.and(Ad.isz(hi), Bool.and(Ad.isz(wi), Bool.and(Ad.isz(wb), Ad.room(l, Nat.add(hi, hb))))))
      +y = {Ad.Tk{Ad.Bg{}, st} : Ad.Tk}
      +t2 = List.append(&2, Ad.Tk, ts, [y])
      ad.and_t(Ad.fifo(Ad.Ia{}, t2, False{}), Ad.fifo(Ad.Bg{}, t2, False{}), ad.f_app(ts, Ad.Ia{}, False{}, y, ei, ad.or_nt(Ad.hit(Ad.Holding{}, Ad.Ia{}, y), Bool.and(True{}, Ad.isz(wi)), ad.and_f(Ad.Mode.of(Ad.Holding{}, st)))), ad.f_app(ts, Ad.Bg{}, False{}, y, eb, ad.fifo_bg_ok(Ad.isz(hi), Ad.isz(wi), Ad.isz(wb), Ad.room(l, Nat.add(hi, hb)))))
    case Ad.St{+l, +q, +ts} Ad.Collect{+k}:
      ad.f_col_op(Ad.get(ts, k), l, q, ts, k, {==}, e)
    case Ad.St{+l, +q, +ts} Ad.Release{+k}:
      ad.f_rel_op(Ad.get(ts, k), l, q, ts, k, e)
    case Ad.St{+l, +q, +ts} Ad.Leave{+k}:
      ad.f_lea_op(Ad.get(ts, k), l, q, ts, k, e)
    case Ad.St{+l, +q, +ts} Ad.Limit{+l2, q2}:
      ad.f_grant(Ad.waits(ts), Ad.pick(l2, ts), l2, ts, e)

def ad.run_fifo(os: List<&2, Ad.Op>, +s: Ad.St, e: {Ad.fifo.both(Ad.St.ts(s)) == True{} : Bool}) -> {Ad.fifo.both(Ad.St.ts(Ad.run(os, s))) == True{} : Bool}:
  match os:
    case Nil{}:
      e
    case +o <> r:
      ad.run_fifo(r, Ad.step(s, o), ad.f_step(s, o, e))

def fifo_per_class(+l: Ad.Lim, +q: Nat, +os: List<&2, Ad.Op>) -> {Ad.fifo.both(Ad.St.ts(Ad.run(os, Ad.St.new(l, q)))) == True{} : Bool}:
  ad.run_fifo(os, Ad.St.new(l, q), {==})

# ---- admission_wait ----

# proof_admission_wait: the interactive bound of LAWS.bend (rule H3.4 of
# docs/harness.md). An interactive waiter w waits for ahead(s, w): the
# interactive slots held and the interactive waiters older than w. No op
# raises it, a release of an interactive slot lowers it by one, and
# while w waits it is at least one (no lost wake-up). So w is granted
# after at most ahead(s, w) interactive releases, whatever background
# requests do.

# Numbers
# -------

def aw.le_succ(x: Nat, +y: Nat, e: {Ad.le(x, y) == True{} : Bool}) -> {Ad.le(x, 1n+y) == True{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+a:
      match y:
        case 0n:
          ad.absurd({Ad.le(1n+a, 1n) == True{} : Bool}, e)
        case 1n+b:
          aw.le_succ(a, b, e)

def aw.le0(a: Nat, e: {Ad.le(a, 0n) == True{} : Bool}) -> {a == 0n : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+x:
      ad.absurd({1n+x == 0n : Nat}, e)

def aw.bit_mono(b: Bool, -x: Nat, -y: Nat, e: {Ad.le(x, y) == True{} : Bool}) -> {Ad.le(Ad.bit(b, x), Ad.bit(b, y)) == True{} : Bool}:
  match b:
    case False{}:
      e
    case True{}:
      e

def aw.bit_or(a: Bool, b: Bool, +y: Nat) -> {Ad.le(Ad.bit(a, y), Ad.bit(Bool.or(a, b), y)) == True{} : Bool}:
  match a b:
    case True{} _:
      ad.le_refl(y)
    case False{} True{}:
      aw.le_succ(y, y, ad.le_refl(y))
    case False{} False{}:
      ad.le_refl(y)

def aw.le_add_l(f: Nat, -x: Nat, -y: Nat, e: {Ad.le(x, y) == True{} : Bool}) -> {Ad.le(Nat.add(f, x), Nat.add(f, y)) == True{} : Bool}:
  match f:
    case 0n:
      e
    case 1n+p:
      aw.le_add_l(p, x, y, e)

def aw.isz_bit(b: Bool, -n: Nat, e: {Ad.isz(n) == False{} : Bool}) -> {Ad.isz(Ad.bit(b, n)) == False{} : Bool}:
  match b:
    case False{}:
      e
    case True{}:
      {==}

# What w waits for
# ----------------

def aw.pot0(t: List<&2, Ad.Tk>) -> {Ad.pot(t, 0n) == Ad.cnt(Ad.Holding{}, Ad.Ia{}, t) : Nat}:
  match t:
    case Nil{}:
      {==}
    case h <> r:
      {==}

# the interactive slots held are part of it
def aw.held_pot(t: List<&2, Ad.Tk>, +w: Nat) -> {Ad.le(Ad.cnt(Ad.Holding{}, Ad.Ia{}, t), Ad.pot(t, w)) == True{} : Bool}:
  match t w:
    case Nil{} _:
      {==}
    case +h <> +r 0n:
      ad.le_refl(Ad.cnt(Ad.Holding{}, Ad.Ia{}, h <> r))
    case +h <> +r 1n+p:
      +hh = Ad.hit(Ad.Holding{}, Ad.Ia{}, h)
      +hw = Ad.hit(Ad.Waiting{}, Ad.Ia{}, h)
      ad.le_trans(Ad.bit(hh, Ad.cnt(Ad.Holding{}, Ad.Ia{}, r)), Ad.bit(hh, Ad.pot(r, p)), Ad.bit(Bool.or(hh, hw), Ad.pot(r, p)), aw.bit_mono(hh, Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), Ad.pot(r, p), aw.held_pot(r, p)), aw.bit_or(hh, hw, Ad.pot(r, p)))

def aw.wait0(h: Ad.Tk, -r: List<&2, Ad.Tk>, e: {Ad.waits.ia(Some{h}) == True{} : Bool}) -> {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, h <> r)) == False{} : Bool}:
  match h:
    case Ad.Tk{Ad.Ia{}, Ad.Queued{}}:
      {==}
    case Ad.Tk{Ad.Ia{}, Ad.Granted{}}:
      ad.absurd({Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Granted{}} <> r)) == False{} : Bool}, e)
    case Ad.Tk{Ad.Ia{}, Ad.Held{}}:
      ad.absurd({Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Held{}} <> r)) == False{} : Bool}, e)
    case Ad.Tk{Ad.Ia{}, Ad.Preempted{}}:
      ad.absurd({Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Preempted{}} <> r)) == False{} : Bool}, e)
    case Ad.Tk{Ad.Ia{}, Ad.Ended{}}:
      ad.absurd({Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Ended{}} <> r)) == False{} : Bool}, e)
    case Ad.Tk{Ad.Bg{}, s}:
      ad.absurd({Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, s} <> r)) == False{} : Bool}, e)

# an interactive waiter is counted
def aw.wait_cnt(t: List<&2, Ad.Tk>, w: Nat, e: {Ad.waits.ia(Ad.get(t, w)) == True{} : Bool}) -> {Ad.isz(Ad.cnt(Ad.Waiting{}, Ad.Ia{}, t)) == False{} : Bool}:
  match t w:
    case Nil{} _:
      ad.absurd({Ad.isz(0n) == False{} : Bool}, e)
    case +h <> +r 0n:
      aw.wait0(h, r, e)
    case +h <> +r 1n+p:
      aw.isz_bit(Ad.hit(Ad.Waiting{}, Ad.Ia{}, h), Ad.cnt(Ad.Waiting{}, Ad.Ia{}, r), aw.wait_cnt(r, p, e))

def aw.room_t(l: Ad.Lim) -> {Ad.room(l, 0n) == True{} : Bool}:
  match l:
    case Ad.Unl{}:
      {==}
    case Ad.Cap{p}:
      {==}

def aw.room00(-l: Ad.Lim, -hi: Nat, -hb: Nat, zh: {hi == 0n : Nat}, zb: {hb == 0n : Nat}, rf: {Ad.room(l, Nat.add(hi, hb)) == False{} : Bool}) -> {Ad.room(l, 0n) == False{} : Bool}:
  %zh : {Ad.room(l, Nat.add(_, 0n)) == False{} : Bool}
  %zb : {Ad.room(l, Nat.add(hi, _)) == False{} : Bool}
  rf

# with no interactive slot held, an interactive waiter would have a
# free slot
def aw.no_idle(-X: Type, +l: Ad.Lim, +hi: Nat, +wi: Nat, +hb: Nat, +wb: Nat, zh: {hi == 0n : Nat}, nz: {Ad.isz(wi) == False{} : Bool}, +h: {ad.ok.n(l, hi, wi, hb, wb) == True{} : Bool}) -> X:
  match wi:
    case 0n:
      ad.absurd_t(X, nz)
    case 1n+w:
      +cn = Ad.calm.n(hi, 1n+w, hb)
      +zb = ad.calm_hb0(hi, w, hb, ad.and_r(Bool.not(Maybe.is_some(&2, Ad.Cls, Ad.pick.go(Ad.room(l, Nat.add(hi, hb)), 1n+w, hi, wb))), cn, h))
      +rf = ad.ok_room(Ad.room(l, Nat.add(hi, hb)), w, hi, wb, cn, h)
      ad.absurd_t(X, Equal.trans(Bool, True{}, Ad.room(l, 0n), False{}, Equal.sym(Bool, Ad.room(l, 0n), True{}, aw.room_t(l)), aw.room00(l, hi, hb, zh, zb, rf)))

def aw.held_le0(+ts: List<&2, Ad.Tk>, +w: Nat, ep: {Ad.pot(ts, w) == 0n : Nat}) -> {Ad.le(Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts), 0n) == True{} : Bool}:
  %ep : {Ad.le(Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts), _) == True{} : Bool}
  aw.held_pot(ts, w)

def aw.pos_go(p: Nat, +l: Ad.Lim, +ts: List<&2, Ad.Tk>, +w: Nat, ep: {Ad.pot(ts, w) == p : Nat}, +inv: {ad.ok(l, ts) == True{} : Bool}, ws: {Ad.waits.ia(Ad.get(ts, w)) == True{} : Bool}) -> {Ad.le(1n, p) == True{} : Bool}:
  match p:
    case 1n+x:
      {==}
    case 0n:
      +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
      aw.no_idle({Ad.le(1n, 0n) == True{} : Bool}, l, hi, Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts), Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts), Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts), aw.le0(hi, aw.held_le0(ts, w, ep)), aw.wait_cnt(ts, w, ws), inv)

# while w waits, it waits for something
def aw.pot_pos(s: Ad.St, +w: Nat, inv: {ad.okS(s) == True{} : Bool}, ws: {Ad.waits.ia(Ad.status(s, w)) == True{} : Bool}) -> {Ad.le(1n, Ad.ahead(s, w)) == True{} : Bool}:
  match s:
    case Ad.St{+l, q, +ts}:
      aw.pos_go(Ad.pot(ts, w), l, ts, w, {==}, inv, ws)

# What each change does to it
# ---------------------------

def aw.pot_pre(t: List<&2, Ad.Tk>, +w: Nat) -> {Ad.pot(Ad.preempt(t), w) == Ad.pot(t, w) : Nat}:
  match t w:
    case Nil{} _:
      {==}
    case +h <> +r 0n:
      ad.pre_ia(Ad.Holding{}, h <> r)
    case +h <> +r 1n+p:
      +hh = Ad.hit(Ad.Holding{}, Ad.Ia{}, h)
      +hw = Ad.hit(Ad.Waiting{}, Ad.Ia{}, h)
      +rhs = Ad.bit(Bool.or(hh, hw), Ad.pot(r, p))
      %Equal.sym(Bool, Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk.preempt(h)), hh, ad.hit_pre(Ad.Holding{}, h)) : {Ad.bit(Bool.or(_, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk.preempt(h))), Ad.pot(Ad.preempt(r), p)) == rhs : Nat}
      %Equal.sym(Bool, Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk.preempt(h)), hw, ad.hit_pre(Ad.Waiting{}, h)) : {Ad.bit(Bool.or(hh, _), Ad.pot(Ad.preempt(r), p)) == rhs : Nat}
      %Equal.sym(Nat, Ad.pot(Ad.preempt(r), p), Ad.pot(r, p), aw.pot_pre(r, p)) : {Ad.bit(Bool.or(hh, hw), _) == rhs : Nat}
      {==}

def aw.wait_pre1(t: Ad.Tk) -> {Ad.waits.ia(Some{Ad.Tk.preempt(t)}) == Ad.waits.ia(Some{t}) : Bool}:
  match t:
    case Ad.Tk{Ad.Ia{}, s}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Queued{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Granted{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Held{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Preempted{}}:
      {==}
    case Ad.Tk{Ad.Bg{}, Ad.Ended{}}:
      {==}

def aw.wait_pre(t: List<&2, Ad.Tk>, w: Nat) -> {Ad.waits.ia(Ad.get(Ad.preempt(t), w)) == Ad.waits.ia(Ad.get(t, w)) : Bool}:
  match t w:
    case Nil{} _:
      {==}
    case +h <> +r 0n:
      aw.wait_pre1(h)
    case +h <> +r 1n+p:
      aw.wait_pre(r, p)

# a new ticket comes after w
def aw.pot_app(t: List<&2, Ad.Tk>, +x: Ad.Tk, +w: Nat, ws: {Ad.waits.ia(Ad.get(t, w)) == True{} : Bool}) -> {Ad.pot(List.append(&2, Ad.Tk, t, [x]), w) == Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, x), Ad.pot(t, w)) : Nat}:
  match t w:
    case Nil{} _:
      ad.absurd({Ad.pot([x], w) == Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, x), 0n) : Nat}, ws)
    case +h <> +r 0n:
      ad.cnt_app(Ad.Holding{}, Ad.Ia{}, h <> r, x)
    case +h <> +r 1n+p:
      +b = Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, h), Ad.hit(Ad.Waiting{}, Ad.Ia{}, h))
      +hx = Ad.hit(Ad.Holding{}, Ad.Ia{}, x)
      %Equal.sym(Nat, Ad.pot(List.append(&2, Ad.Tk, r, [x]), p), Ad.bit(hx, Ad.pot(r, p)), aw.pot_app(r, x, p, ws)) : {Ad.bit(b, _) == Ad.bit(hx, Ad.bit(b, Ad.pot(r, p))) : Nat}
      ad.bit_comm(b, hx, Ad.pot(r, p))

def aw.end0(+r: List<&2, Ad.Tk>, +q: Nat, -a: Bool, ih: {Ad.le(Ad.bit(a, Ad.pot(Ad.put(r, q, Ad.Ended{}), 0n)), Ad.pot(r, 0n)) == True{} : Bool}) -> {Ad.le(Ad.bit(a, Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(r, q, Ad.Ended{}))), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r)) == True{} : Bool}:
  %aw.pot0(Ad.put(r, q, Ad.Ended{})) : {Ad.le(Ad.bit(a, _), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r)) == True{} : Bool}
  %aw.pot0(r) : {Ad.le(Ad.bit(a, Ad.pot(Ad.put(r, q, Ad.Ended{}), 0n)), _) == True{} : Bool}
  ih

# a ticket that ends drops what it weighed (an interactive slot at
# least, if it held one)
def aw.pot_end(t: List<&2, Ad.Tk>, +k: Nat, +w: Nat) -> {Ad.le(Ad.bit(ad.at(Ad.Holding{}, Ad.Ia{}, Ad.get(t, k)), Ad.pot(Ad.put(t, k, Ad.Ended{}), w)), Ad.pot(t, w)) == True{} : Bool}:
  match t k w:
    case Nil{} _ _:
      {==}
    case Ad.Tk{+c1, +s1} <> +r 0n 0n:
      ad.le_refl(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1}), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r)))
    case Ad.Tk{+c1, +s1} <> +r 0n 1n+p:
      aw.bit_or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{c1, s1}), Ad.pot(r, p))
    case Ad.Tk{+c1, +s1} <> +r 1n+q 0n:
      +hh = Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1})
      +a = ad.at(Ad.Holding{}, Ad.Ia{}, Ad.get(r, q))
      +x = Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(r, q, Ad.Ended{}))
      %ad.bit_comm(hh, a, x) : {Ad.le(_, Ad.bit(hh, Ad.cnt(Ad.Holding{}, Ad.Ia{}, r))) == True{} : Bool}
      aw.bit_mono(hh, Ad.bit(a, x), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.end0(r, q, a, aw.pot_end(r, q, 0n)))
    case Ad.Tk{+c1, +s1} <> +r 1n+q 1n+p:
      +a = ad.at(Ad.Holding{}, Ad.Ia{}, Ad.get(r, q))
      +b = Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{c1, s1}))
      %ad.bit_comm(b, a, Ad.pot(Ad.put(r, q, Ad.Ended{}), p)) : {Ad.le(_, Ad.bit(b, Ad.pot(r, p))) == True{} : Bool}
      aw.bit_mono(b, Ad.bit(a, Ad.pot(Ad.put(r, q, Ad.Ended{}), p)), Ad.pot(r, p), aw.pot_end(r, q, p))

def aw.c_of(+x: List<&2, Ad.Tk>, +y: List<&2, Ad.Tk>, e: {Ad.pot(x, 0n) == Ad.pot(y, 0n) : Nat}) -> {Ad.cnt(Ad.Holding{}, Ad.Ia{}, x) == Ad.cnt(Ad.Holding{}, Ad.Ia{}, y) : Nat}:
  %aw.pot0(x) : {_ == Ad.cnt(Ad.Holding{}, Ad.Ia{}, y) : Nat}
  %aw.pot0(y) : {Ad.pot(x, 0n) == _ : Nat}
  e

def aw.col0(+c1: Ad.Cls, s1: Ad.Sts, -r: List<&2, Ad.Tk>, w: Nat, g: {ad.isg(Some{Ad.Tk{c1, s1}}) == True{} : Bool}) -> {Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) == Ad.pot(Ad.Tk{c1, s1} <> r, w) : Nat}:
  match s1:
    case Ad.Granted{}:
      match w:
        case 0n:
          {==}
        case 1n+p:
          {==}
    case Ad.Queued{}:
      ad.absurd({Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) == Ad.pot(Ad.Tk{c1, Ad.Queued{}} <> r, w) : Nat}, g)
    case Ad.Held{}:
      ad.absurd({Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) == Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) : Nat}, g)
    case Ad.Preempted{}:
      ad.absurd({Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) == Ad.pot(Ad.Tk{c1, Ad.Preempted{}} <> r, w) : Nat}, g)
    case Ad.Ended{}:
      ad.absurd({Ad.pot(Ad.Tk{c1, Ad.Held{}} <> r, w) == Ad.pot(Ad.Tk{c1, Ad.Ended{}} <> r, w) : Nat}, g)

# collecting a grant changes nothing w waits for
def aw.pot_col(t: List<&2, Ad.Tk>, +k: Nat, +w: Nat, +g: {ad.isg(Ad.get(t, k)) == True{} : Bool}) -> {Ad.pot(Ad.put(t, k, Ad.Held{}), w) == Ad.pot(t, w) : Nat}:
  match t k w:
    case Nil{} _ _:
      {==}
    case Ad.Tk{+c1, +s1} <> +r 0n 0n:
      aw.col0(c1, s1, r, 0n, g)
    case Ad.Tk{+c1, +s1} <> +r 0n 1n+p:
      aw.col0(c1, s1, r, 1n+p, g)
    case Ad.Tk{+c1, +s1} <> +r 1n+q 0n:
      +hh = Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1})
      Equal.cong(Nat, Nat, y => Ad.bit(hh, y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.put(r, q, Ad.Held{})), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.put(r, q, Ad.Held{}), r, aw.pot_col(r, q, 0n, g)))
    case Ad.Tk{+c1, +s1} <> +r 1n+q 1n+p:
      +b = Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{c1, s1}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{c1, s1}))
      Equal.cong(Nat, Nat, y => Ad.bit(b, y), Ad.pot(Ad.put(r, q, Ad.Held{}), p), Ad.pot(r, p), aw.pot_col(r, q, p, g))

# a grant never makes a ticket wait
def aw.wait_mark(t: List<&2, Ad.Tk>, +c: Ad.Cls, +w: Nat, e: {Ad.waits.ia(Ad.get(Ad.mark(c, t), w)) == True{} : Bool}) -> {Ad.waits.ia(Ad.get(t, w)) == True{} : Bool}:
  match t:
    case Nil{}:
      e
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs:
        case Ad.Ia{} Ad.Queued{}:
          match c w:
            case Ad.Ia{} 0n:
              ad.absurd({Ad.waits.ia(Some{Ad.Tk{Ad.Ia{}, Ad.Queued{}}}) == True{} : Bool}, e)
            case Ad.Ia{} 1n+p:
              e
            case Ad.Bg{} 0n:
              {==}
            case Ad.Bg{} 1n+p:
              aw.wait_mark(r, Ad.Bg{}, p, e)
        case Ad.Bg{} Ad.Queued{}:
          match c w:
            case Ad.Bg{} 0n:
              ad.absurd({Ad.waits.ia(Some{Ad.Tk{Ad.Bg{}, Ad.Queued{}}}) == True{} : Bool}, e)
            case Ad.Bg{} 1n+p:
              e
            case Ad.Ia{} 0n:
              e
            case Ad.Ia{} 1n+p:
              aw.wait_mark(r, Ad.Ia{}, p, e)
        case _ Ad.Granted{}:
          match w:
            case 0n:
              e
            case 1n+p:
              aw.wait_mark(r, c, p, e)
        case _ Ad.Held{}:
          match w:
            case 0n:
              e
            case 1n+p:
              aw.wait_mark(r, c, p, e)
        case _ Ad.Preempted{}:
          match w:
            case 0n:
              e
            case 1n+p:
              aw.wait_mark(r, c, p, e)
        case _ Ad.Ended{}:
          match w:
            case 0n:
              e
            case 1n+p:
              aw.wait_mark(r, c, p, e)

def aw.wait_grant(+n: Nat, +d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +w: Nat, e: {Ad.waits.ia(Ad.get(Ad.grant.go(n, d, l, t), w)) == True{} : Bool}) -> {Ad.waits.ia(Ad.get(t, w)) == True{} : Bool}:
  match n d:
    case 0n _:
      e
    case 1n+f None{}:
      e
    case 1n+f Some{+c}:
      aw.wait_mark(t, c, w, aw.wait_grant(f, Ad.pick(l, Ad.mark(c, t)), l, Ad.mark(c, t), w, e))

# an interactive grant while w waits goes to a waiter ahead of it: it
# moves from waiting to holding, which w waits for alike
def aw.pot_mark_ia(t: List<&2, Ad.Tk>, +w: Nat, +e: {Ad.waits.ia(Ad.get(Ad.mark(Ad.Ia{}, t), w)) == True{} : Bool}) -> {Ad.pot(Ad.mark(Ad.Ia{}, t), w) == Ad.pot(t, w) : Nat}:
  match t:
    case Nil{}:
      {==}
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs w:
        case Ad.Ia{} Ad.Queued{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Granted{}} <> r, 0n) == Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Queued{}} <> r, 0n) : Nat}, e)
        case Ad.Ia{} Ad.Queued{} 1n+p:
          {==}
        case Ad.Ia{} Ad.Granted{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Granted{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Granted{}} <> r, 0n) : Nat}, e)
        case Ad.Ia{} Ad.Granted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Granted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Granted{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Ia{} Ad.Held{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Held{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Held{}} <> r, 0n) : Nat}, e)
        case Ad.Ia{} Ad.Held{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Held{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Held{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Ia{} Ad.Preempted{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Preempted{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Preempted{}} <> r, 0n) : Nat}, e)
        case Ad.Ia{} Ad.Preempted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Preempted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Preempted{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Ia{} Ad.Ended{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Ended{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Ia{}, Ad.Ended{}} <> r, 0n) : Nat}, e)
        case Ad.Ia{} Ad.Ended{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Ended{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Ended{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Bg{} Ad.Queued{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Queued{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Queued{}} <> r, 0n) : Nat}, e)
        case Ad.Bg{} Ad.Queued{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Queued{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Bg{} Ad.Granted{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Granted{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Granted{}} <> r, 0n) : Nat}, e)
        case Ad.Bg{} Ad.Granted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Granted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Granted{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Bg{} Ad.Held{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Held{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Held{}} <> r, 0n) : Nat}, e)
        case Ad.Bg{} Ad.Held{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Held{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Held{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Bg{} Ad.Preempted{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Preempted{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Preempted{}} <> r, 0n) : Nat}, e)
        case Ad.Bg{} Ad.Preempted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Preempted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Preempted{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))
        case Ad.Bg{} Ad.Ended{} 0n:
          ad.absurd({Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Ended{}} <> Ad.mark(Ad.Ia{}, r), 0n) == Ad.pot(Ad.Tk{Ad.Bg{}, Ad.Ended{}} <> r, 0n) : Nat}, e)
        case Ad.Bg{} Ad.Ended{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Ended{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Bg{}, Ad.Ended{}})), y), Ad.pot(Ad.mark(Ad.Ia{}, r), p), Ad.pot(r, p), aw.pot_mark_ia(r, p, e))

# a background grant changes nothing w waits for
def aw.pot_mark_bg(t: List<&2, Ad.Tk>, +w: Nat) -> {Ad.pot(Ad.mark(Ad.Bg{}, t), w) == Ad.pot(t, w) : Nat}:
  match t:
    case Nil{}:
      {==}
    case Ad.Tk{+hc, +hs} <> +r:
      match hc hs w:
        case Ad.Bg{} Ad.Queued{} 0n:
          {==}
        case Ad.Bg{} Ad.Queued{} 1n+p:
          {==}
        case Ad.Ia{} Ad.Queued{} 0n:
          Equal.cong(Nat, Nat, y => Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}}), y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.mark(Ad.Bg{}, r)), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.mark(Ad.Bg{}, r), r, aw.pot_mark_bg(r, 0n)))
        case Ad.Ia{} Ad.Queued{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{Ad.Ia{}, Ad.Queued{}})), y), Ad.pot(Ad.mark(Ad.Bg{}, r), p), Ad.pot(r, p), aw.pot_mark_bg(r, p))
        case _ Ad.Granted{} 0n:
          Equal.cong(Nat, Nat, y => Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}}), y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.mark(Ad.Bg{}, r)), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.mark(Ad.Bg{}, r), r, aw.pot_mark_bg(r, 0n)))
        case _ Ad.Granted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Granted{}})), y), Ad.pot(Ad.mark(Ad.Bg{}, r), p), Ad.pot(r, p), aw.pot_mark_bg(r, p))
        case _ Ad.Held{} 0n:
          Equal.cong(Nat, Nat, y => Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Held{}}), y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.mark(Ad.Bg{}, r)), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.mark(Ad.Bg{}, r), r, aw.pot_mark_bg(r, 0n)))
        case _ Ad.Held{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Held{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Held{}})), y), Ad.pot(Ad.mark(Ad.Bg{}, r), p), Ad.pot(r, p), aw.pot_mark_bg(r, p))
        case _ Ad.Preempted{} 0n:
          Equal.cong(Nat, Nat, y => Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}}), y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.mark(Ad.Bg{}, r)), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.mark(Ad.Bg{}, r), r, aw.pot_mark_bg(r, 0n)))
        case _ Ad.Preempted{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Preempted{}})), y), Ad.pot(Ad.mark(Ad.Bg{}, r), p), Ad.pot(r, p), aw.pot_mark_bg(r, p))
        case _ Ad.Ended{} 0n:
          Equal.cong(Nat, Nat, y => Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}}), y), Ad.cnt(Ad.Holding{}, Ad.Ia{}, Ad.mark(Ad.Bg{}, r)), Ad.cnt(Ad.Holding{}, Ad.Ia{}, r), aw.c_of(Ad.mark(Ad.Bg{}, r), r, aw.pot_mark_bg(r, 0n)))
        case _ Ad.Ended{} 1n+p:
          Equal.cong(Nat, Nat, y => Ad.bit(Bool.or(Ad.hit(Ad.Holding{}, Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}}), Ad.hit(Ad.Waiting{}, Ad.Ia{}, Ad.Tk{hc, Ad.Ended{}})), y), Ad.pot(Ad.mark(Ad.Bg{}, r), p), Ad.pot(r, p), aw.pot_mark_bg(r, p))

def aw.pot_grant(+n: Nat, +d: Maybe<&2, Ad.Cls>, +l: Ad.Lim, +t: List<&2, Ad.Tk>, +w: Nat, +e: {Ad.waits.ia(Ad.get(Ad.grant.go(n, d, l, t), w)) == True{} : Bool}) -> {Ad.pot(Ad.grant.go(n, d, l, t), w) == Ad.pot(t, w) : Nat}:
  match n d:
    case 0n _:
      {==}
    case 1n+f None{}:
      {==}
    case 1n+f Some{Ad.Ia{}}:
      +t2 = Ad.mark(Ad.Ia{}, t)
      Equal.trans(Nat, Ad.pot(Ad.grant.go(f, Ad.pick(l, t2), l, t2), w), Ad.pot(t2, w), Ad.pot(t, w), aw.pot_grant(f, Ad.pick(l, t2), l, t2, w, e), aw.pot_mark_ia(t, w, aw.wait_grant(f, Ad.pick(l, t2), l, t2, w, e)))
    case 1n+f Some{Ad.Bg{}}:
      +t2 = Ad.mark(Ad.Bg{}, t)
      Equal.trans(Nat, Ad.pot(Ad.grant.go(f, Ad.pick(l, t2), l, t2), w), Ad.pot(t2, w), Ad.pot(t, w), aw.pot_grant(f, Ad.pick(l, t2), l, t2, w, e), aw.pot_mark_bg(t, w))

# One op
# ------

def aw.ia_new(-r: Bool, u: Bool, +p: Nat) -> {Ad.le(Ad.bit(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.ia.st(Bool.and(False{}, r), u)), True{}), p), p) == True{} : Bool}:
  match u:
    case True{}:
      ad.le_refl(p)
    case False{}:
      ad.le_refl(p)

# a new interactive request waits behind w
def aw.st_ia(+l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +w: Nat, +ws: {Ad.waits.ia(Ad.get(ts, w)) == True{} : Bool}) -> {Ad.le(Ad.pot(Ad.admit.ia(l, q, ts), w), Ad.pot(ts, w)) == True{} : Bool}:
  +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
  +st = Ad.admit.ia.st(Bool.and(Ad.isz(wi), Ad.room(l, hi)), Ad.le(q, wi))
  +x = {Ad.Tk{Ad.Ia{}, st} : Ad.Tk}
  +t1 = Ad.preempt(ts)
  +p = Ad.pot(ts, w)
  +ws1 = Equal.trans(Bool, Ad.waits.ia(Ad.get(t1, w)), Ad.waits.ia(Ad.get(ts, w)), True{}, aw.wait_pre(ts, w), ws)
  %Equal.sym(Nat, Ad.pot(List.append(&2, Ad.Tk, t1, [x]), w), Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, x), Ad.pot(t1, w)), aw.pot_app(t1, x, w, ws1)) : {Ad.le(_, p) == True{} : Bool}
  %Equal.sym(Nat, Ad.pot(t1, w), p, aw.pot_pre(ts, w)) : {Ad.le(Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, x), _), p) == True{} : Bool}
  %Equal.sym(Bool, Ad.isz(wi), False{}, aw.wait_cnt(ts, w, ws)) : {Ad.le(Ad.bit(Bool.and(Ad.Mode.of(Ad.Holding{}, Ad.admit.ia.st(Bool.and(_, Ad.room(l, hi)), Ad.le(q, wi))), True{}), p), p) == True{} : Bool}
  aw.ia_new(Ad.room(l, hi), Ad.le(q, wi), p)

# a new background request changes nothing w waits for
def aw.st_bg(+l: Ad.Lim, +ts: List<&2, Ad.Tk>, +w: Nat, ws: {Ad.waits.ia(Ad.get(ts, w)) == True{} : Bool}) -> {Ad.le(Ad.pot(Ad.admit.bg(l, ts), w), Ad.pot(ts, w)) == True{} : Bool}:
  +hi = Ad.cnt(Ad.Holding{}, Ad.Ia{}, ts)
  +wi = Ad.cnt(Ad.Waiting{}, Ad.Ia{}, ts)
  +hb = Ad.cnt(Ad.Holding{}, Ad.Bg{}, ts)
  +wb = Ad.cnt(Ad.Waiting{}, Ad.Bg{}, ts)
  +st = Ad.admit.bg.st(Bool.and(Ad.isz(hi), Bool.and(Ad.isz(wi), Bool.and(Ad.isz(wb), Ad.room(l, Nat.add(hi, hb))))))
  +y = {Ad.Tk{Ad.Bg{}, st} : Ad.Tk}
  +p = Ad.pot(ts, w)
  %Equal.sym(Nat, Ad.pot(List.append(&2, Ad.Tk, ts, [y]), w), Ad.bit(Ad.hit(Ad.Holding{}, Ad.Ia{}, y), p), aw.pot_app(ts, y, w, ws)) : {Ad.le(_, p) == True{} : Bool}
  %Equal.sym(Bool, Bool.and(Ad.Mode.of(Ad.Holding{}, st), False{}), False{}, ad.and_f(Ad.Mode.of(Ad.Holding{}, st))) : {Ad.le(Ad.bit(_, p), p) == True{} : Bool}
  ad.le_refl(p)

def aw.end_at(+ts: List<&2, Ad.Tk>, +k: Nat, +w: Nat, -mb: Maybe<&2, Ad.Tk>, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Ad.le(Ad.bit(ad.at(Ad.Holding{}, Ad.Ia{}, mb), Ad.pot(Ad.put(ts, k, Ad.Ended{}), w)), Ad.pot(ts, w)) == True{} : Bool}:
  %ej : {Ad.le(Ad.bit(ad.at(Ad.Holding{}, Ad.Ia{}, _), Ad.pot(Ad.put(ts, k, Ad.Ended{}), w)), Ad.pot(ts, w)) == True{} : Bool}
  aw.pot_end(ts, k, w)

def aw.col(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +w: Nat, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}) -> {Ad.le(Ad.pot(Ad.St.ts(Ad.collect.at(mb, l, q, ts, k)), w), Ad.pot(ts, w)) == True{} : Bool}:
  match mb:
    case None{}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{c, Ad.Queued{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{+c, Ad.Granted{}}}:
      %Equal.sym(Nat, Ad.pot(Ad.put(ts, k, Ad.Held{}), w), Ad.pot(ts, w), aw.pot_col(ts, k, w, ad.isg_at(ts, k, Some{Ad.Tk{c, Ad.Granted{}}}, ej, {==}))) : {Ad.le(_, Ad.pot(ts, w)) == True{} : Bool}
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{c, Ad.Held{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{c, Ad.Preempted{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{c, Ad.Ended{}}}:
      ad.le_refl(Ad.pot(ts, w))

def aw.rel(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +w: Nat, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, wf: {Ad.waits.ia(Ad.get(Ad.St.ts(Ad.release.at(mb, l, q, ts, k)), w)) == True{} : Bool}) -> {Ad.le(Nat.add(Ad.frees.at(mb, True{}), Ad.pot(Ad.St.ts(Ad.release.at(mb, l, q, ts, k)), w)), Ad.pot(ts, w)) == True{} : Bool}:
  match mb:
    case None{}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Queued{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Granted{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Held{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Ia{}, Ad.Held{}}}, True{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Ia{}, Ad.Held{}}}, ej)
    case Some{Ad.Tk{Ad.Ia{}, Ad.Preempted{}}}:
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Ia{}, Ad.Preempted{}}}, ej)
    case Some{Ad.Tk{Ad.Ia{}, Ad.Ended{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Queued{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Granted{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Held{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Bg{}, Ad.Held{}}}, True{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Bg{}, Ad.Held{}}}, ej)
    case Some{Ad.Tk{Ad.Bg{}, Ad.Preempted{}}}:
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Bg{}, Ad.Preempted{}}}, ej)
    case Some{Ad.Tk{Ad.Bg{}, Ad.Ended{}}}:
      ad.le_refl(Ad.pot(ts, w))

def aw.lea(mb: Maybe<&2, Ad.Tk>, +l: Ad.Lim, +q: Nat, +ts: List<&2, Ad.Tk>, +k: Nat, +w: Nat, ej: {Ad.get(ts, k) == mb : Maybe<&2, Ad.Tk>}, wf: {Ad.waits.ia(Ad.get(Ad.St.ts(Ad.leave.at(mb, l, q, ts, k)), w)) == True{} : Bool}) -> {Ad.le(Nat.add(Ad.frees.at(mb, False{}), Ad.pot(Ad.St.ts(Ad.leave.at(mb, l, q, ts, k)), w)), Ad.pot(ts, w)) == True{} : Bool}:
  match mb:
    case None{}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Queued{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Ia{}, Ad.Queued{}}}, False{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Ia{}, Ad.Queued{}}}, ej)
    case Some{Ad.Tk{Ad.Ia{}, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Ia{}, Ad.Granted{}}}, False{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Ia{}, Ad.Granted{}}}, ej)
    case Some{Ad.Tk{Ad.Ia{}, Ad.Held{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Preempted{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Ia{}, Ad.Ended{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Queued{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Bg{}, Ad.Queued{}}}, False{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Bg{}, Ad.Queued{}}}, ej)
    case Some{Ad.Tk{Ad.Bg{}, Ad.Granted{}}}:
      +t2 = Ad.put(ts, k, Ad.Ended{})
      %Equal.sym(Nat, Ad.pot(Ad.grant(l, t2), w), Ad.pot(t2, w), aw.pot_grant(Ad.waits(t2), Ad.pick(l, t2), l, t2, w, wf)) : {Ad.le(Nat.add(Ad.frees.at(Some{Ad.Tk{Ad.Bg{}, Ad.Granted{}}}, False{}), _), Ad.pot(ts, w)) == True{} : Bool}
      aw.end_at(ts, k, w, Some{Ad.Tk{Ad.Bg{}, Ad.Granted{}}}, ej)
    case Some{Ad.Tk{Ad.Bg{}, Ad.Held{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Preempted{}}}:
      ad.le_refl(Ad.pot(ts, w))
    case Some{Ad.Tk{Ad.Bg{}, Ad.Ended{}}}:
      ad.le_refl(Ad.pot(ts, w))

def aw.step(s: Ad.St, o: Ad.Op, +w: Nat, +ws: {Ad.waits.ia(Ad.status(s, w)) == True{} : Bool}, wf: {Ad.waits.ia(Ad.status(Ad.step(s, o), w)) == True{} : Bool}) -> {Ad.le(Nat.add(Ad.frees(s, o), Ad.ahead(Ad.step(s, o), w)), Ad.ahead(s, w)) == True{} : Bool}:
  match s o:
    case Ad.St{+l, +q, +ts} Ad.Admit{Ad.Ia{}}:
      aw.st_ia(l, q, ts, w, ws)
    case Ad.St{+l, +q, +ts} Ad.Admit{Ad.Bg{}}:
      aw.st_bg(l, ts, w, ws)
    case Ad.St{+l, +q, +ts} Ad.Collect{+k}:
      aw.col(Ad.get(ts, k), l, q, ts, k, w, {==})
    case Ad.St{+l, +q, +ts} Ad.Release{+k}:
      aw.rel(Ad.get(ts, k), l, q, ts, k, w, {==}, wf)
    case Ad.St{+l, +q, +ts} Ad.Leave{+k}:
      aw.lea(Ad.get(ts, k), l, q, ts, k, w, {==}, wf)
    case Ad.St{+l, +q, +ts} Ad.Limit{+l2, q2}:
      %Equal.sym(Nat, Ad.pot(Ad.grant(l2, ts), w), Ad.pot(ts, w), aw.pot_grant(Ad.waits(ts), Ad.pick(l2, ts), l2, ts, w, wf)) : {Ad.le(_, Ad.pot(ts, w)) == True{} : Bool}
      ad.le_refl(Ad.pot(ts, w))

# A run
# -----

def aw.thru_head(os: List<&2, Ad.Op>, +s: Ad.St, +w: Nat, e: {Ad.waits.thru(os, s, w) == True{} : Bool}) -> {Ad.waits.ia(Ad.status(s, w)) == True{} : Bool}:
  match os:
    case Nil{}:
      e
    case +o <> r:
      ad.and_l(Ad.waits.ia(Ad.status(s, w)), Ad.waits.thru(r, Ad.step(s, o), w), e)

def aw.trace(os: List<&2, Ad.Op>, +s: Ad.St, +w: Nat, +inv: {ad.okS(s) == True{} : Bool}, +e: {Ad.waits.thru(os, s, w) == True{} : Bool}) -> {Ad.le(1n+Ad.frees.run(os, s), Ad.ahead(s, w)) == True{} : Bool}:
  match os:
    case Nil{}:
      aw.pot_pos(s, w, inv, e)
    case +o <> +r:
      +s2 = Ad.step(s, o)
      +f = Ad.frees(s, o)
      +ff = Ad.frees.run(r, s2)
      +a1 = Ad.ahead(s2, w)
      +a0 = Ad.ahead(s, w)
      +e2 = ad.and_r(Ad.waits.ia(Ad.status(s, w)), Ad.waits.thru(r, s2, w), e)
      +ih = aw.trace(r, s2, w, ad.step_ok(s, o, inv), e2)
      +st = aw.step(s, o, w, ad.and_l(Ad.waits.ia(Ad.status(s, w)), Ad.waits.thru(r, s2, w), e), aw.thru_head(r, s2, w, e2))
      %Equal.sym(Nat, 1n+Nat.add(f, ff), Nat.add(f, 1n+ff), ad.add_succ(f, ff)) : {Ad.le(_, a0) == True{} : Bool}
      ad.le_trans(Nat.add(f, 1n+ff), Nat.add(f, a1), a0, aw.le_add_l(f, 1n+ff, a1, ih), st)

# Laws (e)
# --------

def interactive_step(s: Ad.St, o: Ad.Op, +w: Nat, ws: {Ad.waits.ia(Ad.status(s, w)) == True{} : Bool}, wf: {Ad.waits.ia(Ad.status(Ad.step(s, o), w)) == True{} : Bool}) -> {Ad.le(Nat.add(Ad.frees(s, o), Ad.ahead(Ad.step(s, o), w)), Ad.ahead(s, w)) == True{} : Bool}:
  aw.step(s, o, w, ws, wf)

def interactive_bound(+l: Ad.Lim, +q: Nat, +pre: List<&2, Ad.Op>, +os: List<&2, Ad.Op>, +w: Nat, e: {Ad.waits.thru(os, Ad.run(pre, Ad.St.new(l, q)), w) == True{} : Bool}) -> {Ad.le(1n+Ad.frees.run(os, Ad.run(pre, Ad.St.new(l, q))), Ad.ahead(Ad.run(pre, Ad.St.new(l, q)), w)) == True{} : Bool}:
  aw.trace(os, Ad.run(pre, Ad.St.new(l, q)), w, ad.run_ok(pre, Ad.St.new(l, q), ad.new_ok(l, q)), e)

# ---- tree ----

# proof_tree: the session tree laws of LAWS.bend (S1), about bend/tree.bend.
#
# Lookups first: a set or an unset changes only the lookup of its own key
# (`pt.get_set_*`, `pt.get_unset_*`), and both keep a tree sorted. A put
# keeps every parent (`pt.ok_set`); a delete keeps the parent of every
# node it keeps (`pt.rooted_prune_go`, by the nodes walked so far: kept,
# or with their key gone). So every record keeps a tree sound
# (`apply_sound`). A rewind's lookup at a key follows its ops on that key
# (`pt.look`); so after diff(a, b) the tree agrees with b on every key,
# and two sorted trees that agree are equal (`pt.ext`). A delete of the
# root (key 0) changes nothing, and no node of a rooted tree is the root
# (`pt.rooted_nz`); a delete of a node removes it and its subtree only.

# Logic
# -----

def tree.pt.BD(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

def pt.absurd(-A: Type, e: {True{} == False{} : Bool}) -> A:
  %e : tree.pt.BD(_, Unit, A)
  Unit{}

def tree.pt.absurdF(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : tree.pt.BD(_, A, Unit)
  Unit{}

def pt.MD(m: Maybe<&2, Tr.Ent>, n: Type, s: Type) -> Type:
  match m:
    case None{}:
      n
    case Some{x}:
      s

def tree.pt.none_some(-A: Type, -x: Tr.Ent, e: {None{} == Some{x} : Maybe<&2, Tr.Ent>}) -> A:
  %e : pt.MD(_, Unit, A)
  Unit{}

def pt.some_none(-A: Type, -x: Tr.Ent, e: {Some{x} == None{} : Maybe<&2, Tr.Ent>}) -> A:
  %e : pt.MD(_, A, Unit)
  Unit{}

def pt.CD(c: Cmp, l: Type, e: Type, g: Type) -> Type:
  match c:
    case LT{}:
      l
    case EQ{}:
      e
    case GT{}:
      g

def tree.pt.and_l(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      tree.pt.absurdF({False{} == True{} : Bool}, h)

def tree.pt.and_r(a: Bool, +b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      tree.pt.absurdF({b == True{} : Bool}, h)

def tree.pt.and_t(+a: Bool, +b: Bool, ha: {a == True{} : Bool}, hb: {b == True{} : Bool}) -> {Bool.and(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.and(_, b) == True{} : Bool}
  hb

def pt.or_l(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {a == False{} : Bool}:
  match a:
    case True{}:
      pt.absurd({True{} == False{} : Bool}, h)
    case False{}:
      {==}

def pt.or_r(a: Bool, +b: Bool, h: {Bool.or(a, b) == False{} : Bool}) -> {b == False{} : Bool}:
  match a:
    case True{}:
      pt.absurd({b == False{} : Bool}, h)
    case False{}:
      h

def pt.or_tl(+a: Bool, +b: Bool, ha: {a == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  %Equal.sym(Bool, a, True{}, ha) : {Bool.or(_, b) == True{} : Bool}
  {==}

def pt.or_tr(a: Bool, +b: Bool, hb: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      hb

def pt.flip(-a: Bool, h: {a == True{} : Bool}, g: {a == False{} : Bool}) -> Empty:
  pt.absurd(Empty, Equal.trans(Bool, True{}, a, False{}, Equal.sym(Bool, a, True{}, h), g))

# Numbers
# -------

def pt.eq_refl(k: Nat) -> {True{} == Nat.is_eq(k, k) : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pt.eq_refl(p)

def pt.eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      tree.pt.absurdF({0n == 1n+q : Nat}, h)
    case 1n+p 0n:
      tree.pt.absurdF({1n+p == 0n : Nat}, h)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pt.eq_true(p, q, h))

def pt.eq_comm(a: Nat, b: Nat) -> {Nat.is_eq(a, b) == Nat.is_eq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pt.eq_comm(p, q)

def pt.ne_comm(+a: Nat, +b: Nat, h: {Nat.is_eq(a, b) == False{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  %pt.eq_comm(a, b) : {_ == False{} : Bool}
  h

def pt.lt_irrefl(k: Nat) -> {Nat.is_lt(k, k) == False{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      pt.lt_irrefl(p)

def pt.lt_trans(a: Nat, b: Nat, c: Nat, ab: {Nat.is_lt(a, b) == True{} : Bool}, bc: {Nat.is_lt(b, c) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  match a b c:
    case _ 0n _:
      tree.pt.absurdF({Nat.is_lt(a, c) == True{} : Bool}, ab)
    case _ 1n+q 0n:
      tree.pt.absurdF({Nat.is_lt(a, 0n) == True{} : Bool}, bc)
    case 0n 1n+q 1n+r:
      {==}
    case 1n+p 1n+q 1n+r:
      pt.lt_trans(p, q, r, ab, bc)

# a key below another is not it
def pt.lt_ne(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case _ 0n:
      tree.pt.absurdF({Nat.is_eq(a, 0n) == False{} : Bool}, h)
    case 0n 1n+q:
      {==}
    case 1n+p 1n+q:
      pt.lt_ne(p, q, h)

def pt.lt_ne_r(+a: Nat, +b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(b, a) == False{} : Bool}:
  pt.ne_comm(a, b, pt.lt_ne(a, b, h))

def pt.cmp_eq(a: Nat, b: Nat, h: {Nat.cmp(a, b) == EQ{} : Cmp}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      %h : pt.CD(_, Unit, {0n == 1n+q : Nat}, Unit)
      Unit{}
    case 1n+p 0n:
      %h : pt.CD(_, Unit, {1n+p == 0n : Nat}, Unit)
      Unit{}
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, pt.cmp_eq(p, q, h))

def pt.cmp_gt(a: Nat, b: Nat, h: {Nat.cmp(a, b) == GT{} : Cmp}) -> {Nat.is_lt(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      %h : pt.CD(_, Unit, Unit, {Nat.is_lt(0n, 0n) == True{} : Bool})
      Unit{}
    case 0n 1n+q:
      %h : pt.CD(_, Unit, Unit, {Nat.is_lt(1n+q, 0n) == True{} : Bool})
      Unit{}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      pt.cmp_gt(p, q, h)

def pt.cmp_lt(+a: Nat, +b: Nat, h: {Nat.cmp(a, b) == LT{} : Cmp}) -> {Nat.is_lt(a, b) == True{} : Bool}:
  %Equal.sym(Cmp, Nat.cmp(a, b), LT{}, h) : {Cmp.is_lt(_) == True{} : Bool}
  {==}

# Nodes
# -----

def pt.ent_eta(e: Tr.Ent) -> {Tr.Ent{Tr.Ent.k(e), Tr.Ent.p(e), Tr.Ent.v(e)} == e : Tr.Ent}:
  match e:
    case Tr.Ent{k, p, v}:
      {==}

def pt.ent_refl(e: Tr.Ent) -> {Tr.Ent.eq(e, e) == True{} : Bool}:
  match e:
    case Tr.Ent{+k, +p, +v}:
      %pt.eq_refl(k) : {Bool.and(_, Bool.and(Nat.is_eq(p, p), Nat.is_eq(v, v))) == True{} : Bool}
      %pt.eq_refl(p) : {Bool.and(True{}, Bool.and(_, Nat.is_eq(v, v))) == True{} : Bool}
      %pt.eq_refl(v) : {Bool.and(True{}, Bool.and(True{}, _)) == True{} : Bool}
      {==}

def pt.ent_true(a: Tr.Ent, b: Tr.Ent, +h: {Tr.Ent.eq(a, b) == True{} : Bool}) -> {a == b : Tr.Ent}:
  match a b:
    case Tr.Ent{+ak, +ap, +av} Tr.Ent{+bk, +bp, +bv}:
      +hk = pt.eq_true(ak, bk, tree.pt.and_l(Nat.is_eq(ak, bk), Bool.and(Nat.is_eq(ap, bp), Nat.is_eq(av, bv)), h))
      +h2 = tree.pt.and_r(Nat.is_eq(ak, bk), Bool.and(Nat.is_eq(ap, bp), Nat.is_eq(av, bv)), h)
      +hp = pt.eq_true(ap, bp, tree.pt.and_l(Nat.is_eq(ap, bp), Nat.is_eq(av, bv), h2))
      +hv = pt.eq_true(av, bv, tree.pt.and_r(Nat.is_eq(ap, bp), Nat.is_eq(av, bv), h2))
      %hk : {Tr.Ent{ak, ap, av} == Tr.Ent{_, bp, bv} : Tr.Ent}
      %hp : {Tr.Ent{ak, ap, av} == Tr.Ent{ak, _, bv} : Tr.Ent}
      %hv : {Tr.Ent{ak, ap, av} == Tr.Ent{ak, ap, _} : Tr.Ent}
      {==}

# a lookup that is the same as Some{e} is Some{e}
def pt.same_some(m: Maybe<&2, Tr.Ent>, +e: Tr.Ent, h: {Tr.same(m, Some{e}) == True{} : Bool}) -> {m == Some{e} : Maybe<&2, Tr.Ent>}:
  match m:
    case None{}:
      tree.pt.absurdF({None{} == Some{e} : Maybe<&2, Tr.Ent>}, h)
    case Some{x}:
      Equal.cong(Tr.Ent, Maybe<&2, Tr.Ent>, y => Some{y}, x, e, pt.ent_true(x, e, h))

def pt.same_refl(+e: Tr.Ent) -> {Tr.same(Some{e}, Some{e}) == True{} : Bool}:
  pt.ent_refl(e)

# Lookup
# ------

def pt.get_hit(+h: Tr.Ent, +r: List<&2, Tr.Ent>, +x: Nat, eq: {Nat.is_eq(Tr.Ent.k(h), x) == True{} : Bool}) -> {Tr.get(h <> r, x) == Some{h} : Maybe<&2, Tr.Ent>}:
  %Equal.sym(Bool, Nat.is_eq(Tr.Ent.k(h), x), True{}, eq) : {Tr.get.go(h <> r, x, _) == Some{h} : Maybe<&2, Tr.Ent>}
  {==}

def pt.get_head(+h: Tr.Ent, +r: List<&2, Tr.Ent>) -> {Tr.get(h <> r, Tr.Ent.k(h)) == Some{h} : Maybe<&2, Tr.Ent>}:
  pt.get_hit(h, r, Tr.Ent.k(h), Equal.sym(Bool, True{}, Nat.is_eq(Tr.Ent.k(h), Tr.Ent.k(h)), pt.eq_refl(Tr.Ent.k(h))))

def pt.get_miss(+h: Tr.Ent, +r: List<&2, Tr.Ent>, +x: Nat, ne: {Nat.is_eq(Tr.Ent.k(h), x) == False{} : Bool}) -> {Tr.get(h <> r, x) == Tr.get(r, x) : Maybe<&2, Tr.Ent>}:
  %Equal.sym(Bool, Nat.is_eq(Tr.Ent.k(h), x), False{}, ne) : {Tr.get.go(h <> r, x, _) == Tr.get(r, x) : Maybe<&2, Tr.Ent>}
  {==}

def pt.get_go_cong(b: Bool, +h: Tr.Ent, +s: List<&2, Tr.Ent>, +r: List<&2, Tr.Ent>, +x: Nat, e: {Tr.get(s, x) == Tr.get(r, x) : Maybe<&2, Tr.Ent>}) -> {Tr.get.go(h <> s, x, b) == Tr.get.go(h <> r, x, b) : Maybe<&2, Tr.Ent>}:
  match b:
    case True{}:
      {==}
    case False{}:
      e

# a lookup sees past a head that agrees
def pt.get_cons_cong(+h: Tr.Ent, +s: List<&2, Tr.Ent>, +r: List<&2, Tr.Ent>, +x: Nat, e: {Tr.get(s, x) == Tr.get(r, x) : Maybe<&2, Tr.Ent>}) -> {Tr.get(h <> s, x) == Tr.get(h <> r, x) : Maybe<&2, Tr.Ent>}:
  pt.get_go_cong(Nat.is_eq(Tr.Ent.k(h), x), h, s, r, x, e)

def pt.get_set_go_same(t: List<&2, Tr.Ent>, +e: Tr.Ent, c: Cmp, ec: {Tr.first(Tr.Ent.k(e), t) == c : Cmp}) -> {Tr.get(Tr.set.go(t, e, c), Tr.Ent.k(e)) == Some{e} : Maybe<&2, Tr.Ent>}:
  match t:
    case Nil{}:
      pt.get_head(e, Nil{})
    case +h <> +r:
      match c:
        case LT{}:
          pt.get_head(e, h <> r)
        case EQ{}:
          pt.get_head(e, r)
        case GT{}:
          +s = Tr.set.go(r, e, Tr.first(Tr.Ent.k(e), r))
          +ne = pt.lt_ne(Tr.Ent.k(h), Tr.Ent.k(e), pt.cmp_gt(Tr.Ent.k(e), Tr.Ent.k(h), ec))
          Equal.trans(Maybe<&2, Tr.Ent>, Tr.get(h <> s, Tr.Ent.k(e)), Tr.get(s, Tr.Ent.k(e)), Some{e}, pt.get_miss(h, s, Tr.Ent.k(e), ne), pt.get_set_go_same(r, e, Tr.first(Tr.Ent.k(e), r), {==}))

def pt.get_set_same(+t: List<&2, Tr.Ent>, +e: Tr.Ent) -> {Tr.get(Tr.set(t, e), Tr.Ent.k(e)) == Some{e} : Maybe<&2, Tr.Ent>}:
  pt.get_set_go_same(t, e, Tr.first(Tr.Ent.k(e), t), {==})

def pt.get_set_go_other(t: List<&2, Tr.Ent>, +e: Tr.Ent, c: Cmp, ec: {Tr.first(Tr.Ent.k(e), t) == c : Cmp}, +x: Nat, +ne: {Nat.is_eq(Tr.Ent.k(e), x) == False{} : Bool}) -> {Tr.get(Tr.set.go(t, e, c), x) == Tr.get(t, x) : Maybe<&2, Tr.Ent>}:
  match t:
    case Nil{}:
      pt.get_miss(e, Nil{}, x, ne)
    case +h <> +r:
      match c:
        case LT{}:
          pt.get_miss(e, h <> r, x, ne)
        case EQ{}:
          +keq = pt.cmp_eq(Tr.Ent.k(e), Tr.Ent.k(h), ec)
          %keq : {Tr.get(e <> r, x) == Tr.get.go(h <> r, x, Nat.is_eq(_, x)) : Maybe<&2, Tr.Ent>}
          %Equal.sym(Bool, Nat.is_eq(Tr.Ent.k(e), x), False{}, ne) : {Tr.get.go(e <> r, x, _) == Tr.get.go(h <> r, x, _) : Maybe<&2, Tr.Ent>}
          {==}
        case GT{}:
          pt.get_cons_cong(h, Tr.set.go(r, e, Tr.first(Tr.Ent.k(e), r)), r, x, pt.get_set_go_other(r, e, Tr.first(Tr.Ent.k(e), r), {==}, x, ne))

def pt.get_set_other(+t: List<&2, Tr.Ent>, +e: Tr.Ent, +x: Nat, ne: {Nat.is_eq(Tr.Ent.k(e), x) == False{} : Bool}) -> {Tr.get(Tr.set(t, e), x) == Tr.get(t, x) : Maybe<&2, Tr.Ent>}:
  pt.get_set_go_other(t, e, Tr.first(Tr.Ent.k(e), t), {==}, x, ne)

def pt.get_unset_go_same(t: List<&2, Tr.Ent>, +x: Nat, hit: Bool, eh: {Tr.key.at(t, x) == hit : Bool}) -> {Tr.get(Tr.unset.go(t, x, hit), x) == None{} : Maybe<&2, Tr.Ent>}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match hit:
        case True{}:
          pt.get_unset_go_same(r, x, Tr.key.at(r, x), {==})
        case False{}:
          +u = Tr.unset.go(r, x, Tr.key.at(r, x))
          Equal.trans(Maybe<&2, Tr.Ent>, Tr.get(h <> u, x), Tr.get(u, x), None{}, pt.get_miss(h, u, x, eh), pt.get_unset_go_same(r, x, Tr.key.at(r, x), {==}))

def pt.get_unset_same(+t: List<&2, Tr.Ent>, +x: Nat) -> {Tr.get(Tr.unset(t, x), x) == None{} : Maybe<&2, Tr.Ent>}:
  pt.get_unset_go_same(t, x, Tr.key.at(t, x), {==})

def pt.ne_at(+a: Nat, +y: Nat, +x: Nat, ay: {a == y : Nat}, ne: {Nat.is_eq(y, x) == False{} : Bool}) -> {Nat.is_eq(a, x) == False{} : Bool}:
  %Equal.sym(Nat, a, y, ay) : {Nat.is_eq(_, x) == False{} : Bool}
  ne

def pt.get_unset_go_other(t: List<&2, Tr.Ent>, +y: Nat, hit: Bool, eh: {Tr.key.at(t, y) == hit : Bool}, +x: Nat, +ne: {Nat.is_eq(y, x) == False{} : Bool}) -> {Tr.get(Tr.unset.go(t, y, hit), x) == Tr.get(t, x) : Maybe<&2, Tr.Ent>}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match hit:
        case True{}:
          +neh = pt.ne_at(Tr.Ent.k(h), y, x, pt.eq_true(Tr.Ent.k(h), y, eh), ne)
          +u = Tr.unset.go(r, y, Tr.key.at(r, y))
          Equal.trans(Maybe<&2, Tr.Ent>, Tr.get(u, x), Tr.get(r, x), Tr.get(h <> r, x), pt.get_unset_go_other(r, y, Tr.key.at(r, y), {==}, x, ne), Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(h <> r, x), Tr.get(r, x), pt.get_miss(h, r, x, neh)))
        case False{}:
          pt.get_cons_cong(h, Tr.unset.go(r, y, Tr.key.at(r, y)), r, x, pt.get_unset_go_other(r, y, Tr.key.at(r, y), {==}, x, ne))

def pt.get_unset_other(+t: List<&2, Tr.Ent>, +y: Nat, +x: Nat, ne: {Nat.is_eq(y, x) == False{} : Bool}) -> {Tr.get(Tr.unset(t, y), x) == Tr.get(t, x) : Maybe<&2, Tr.Ent>}:
  pt.get_unset_go_other(t, y, Tr.key.at(t, y), {==}, x, ne)

# Order
# -----

def pt.above_set_go(t: List<&2, Tr.Ent>, +e: Tr.Ent, c: Cmp, +l: Nat, al: {Tr.above(l, t) == True{} : Bool}, le: {Nat.is_lt(l, Tr.Ent.k(e)) == True{} : Bool}) -> {Tr.above(l, Tr.set.go(t, e, c)) == True{} : Bool}:
  match t:
    case Nil{}:
      le
    case +h <> +r:
      match c:
        case LT{}:
          le
        case EQ{}:
          le
        case GT{}:
          al

def pt.sorted_set_go(t: List<&2, Tr.Ent>, +e: Tr.Ent, c: Cmp, ec: {Tr.first(Tr.Ent.k(e), t) == c : Cmp}, +st: {Tr.sorted(t) == True{} : Bool}) -> {Tr.sorted(Tr.set.go(t, e, c)) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match c:
        case LT{}:
          tree.pt.and_t(Nat.is_lt(Tr.Ent.k(e), Tr.Ent.k(h)), Tr.sorted(h <> r), pt.cmp_lt(Tr.Ent.k(e), Tr.Ent.k(h), ec), st)
        case EQ{}:
          %Equal.sym(Nat, Tr.Ent.k(e), Tr.Ent.k(h), pt.cmp_eq(Tr.Ent.k(e), Tr.Ent.k(h), ec)) : {Bool.and(Tr.above(_, r), Tr.sorted(r)) == True{} : Bool}
          st
        case GT{}:
          +s = Tr.set.go(r, e, Tr.first(Tr.Ent.k(e), r))
          +al = tree.pt.and_l(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st)
          +sr = tree.pt.and_r(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st)
          tree.pt.and_t(Tr.above(Tr.Ent.k(h), s), Tr.sorted(s), pt.above_set_go(r, e, Tr.first(Tr.Ent.k(e), r), Tr.Ent.k(h), al, pt.cmp_gt(Tr.Ent.k(e), Tr.Ent.k(h), ec)), pt.sorted_set_go(r, e, Tr.first(Tr.Ent.k(e), r), {==}, sr))

def pt.above_tail(+l: Nat, +h: Tr.Ent, r: List<&2, Tr.Ent>, al: {Tr.above(l, h <> r) == True{} : Bool}, st: {Tr.sorted(h <> r) == True{} : Bool}) -> {Tr.above(l, r) == True{} : Bool}:
  match r:
    case Nil{}:
      {==}
    case +h2 <> +r2:
      pt.lt_trans(l, Tr.Ent.k(h), Tr.Ent.k(h2), al, tree.pt.and_l(Nat.is_lt(Tr.Ent.k(h), Tr.Ent.k(h2)), Tr.sorted(h2 <> r2), st))

def pt.above_unset_go(t: List<&2, Tr.Ent>, +x: Nat, hit: Bool, +l: Nat, al: {Tr.above(l, t) == True{} : Bool}, +st: {Tr.sorted(t) == True{} : Bool}) -> {Tr.above(l, Tr.unset.go(t, x, hit)) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match hit:
        case True{}:
          pt.above_unset_go(r, x, Tr.key.at(r, x), l, pt.above_tail(l, h, r, al, st), tree.pt.and_r(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st))
        case False{}:
          al

def pt.sorted_unset_go(t: List<&2, Tr.Ent>, +x: Nat, hit: Bool, +st: {Tr.sorted(t) == True{} : Bool}) -> {Tr.sorted(Tr.unset.go(t, x, hit)) == True{} : Bool}:
  match t:
    case Nil{}:
      {==}
    case +h <> +r:
      match hit:
        case True{}:
          pt.sorted_unset_go(r, x, Tr.key.at(r, x), tree.pt.and_r(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st))
        case False{}:
          +sr = tree.pt.and_r(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st)
          +u = Tr.unset.go(r, x, Tr.key.at(r, x))
          tree.pt.and_t(Tr.above(Tr.Ent.k(h), u), Tr.sorted(u), pt.above_unset_go(r, x, Tr.key.at(r, x), Tr.Ent.k(h), tree.pt.and_l(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st), sr), pt.sorted_unset_go(r, x, Tr.key.at(r, x), sr))

def pt.sorted_exact(+t: List<&2, Tr.Ent>, o: Tr.Op, st: {Tr.sorted(t) == True{} : Bool}) -> {Tr.sorted(Tr.exact(t, o)) == True{} : Bool}:
  match o:
    case Tr.Put{+k, +p, +v}:
      pt.sorted_set_go(t, Tr.Ent{k, p, v}, Tr.first(k, t), {==}, st)
    case Tr.Del{+x}:
      pt.sorted_unset_go(t, x, Tr.key.at(t, x), st)

def pt.sorted_patch(ops: List<&2, Tr.Op>, +t: List<&2, Tr.Ent>, st: {Tr.sorted(t) == True{} : Bool}) -> {Tr.sorted(Tr.patch(ops, t)) == True{} : Bool}:
  match ops:
    case Nil{}:
      st
    case +o <> rest:
      pt.sorted_patch(rest, Tr.exact(t, o), pt.sorted_exact(t, o, st))

# Membership
# ----------

def pt.void(-A: Type, e: Empty) -> A:
  match e:

def tree.pt.or_false_r(a: Bool) -> {Bool.or(a, False{}) == a : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def pt.or_assoc(a: Bool, +b: Bool, +c: Bool) -> {Bool.or(Bool.or(a, b), c) == Bool.or(a, Bool.or(b, c)) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

# an or whose right side is false holds by its left side
def pt.or_l_true(a: Bool, +b: Bool, +h: {Bool.or(a, b) == True{} : Bool}, nb: {b == False{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      pt.void({False{} == True{} : Bool}, pt.flip(b, h, nb))

def pt.has_cons_go(b: Bool, +h: Tr.Ent, +r: List<&2, Tr.Ent>, +y: Nat) -> {Maybe.is_some(&2, Tr.Ent, Tr.get.go(h <> r, y, b)) == Bool.or(b, Tr.has(r, y)) : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def pt.has_cons(+h: Tr.Ent, +r: List<&2, Tr.Ent>, +y: Nat) -> {Tr.has(h <> r, y) == Bool.or(Nat.is_eq(Tr.Ent.k(h), y), Tr.has(r, y)) : Bool}:
  pt.has_cons_go(Nat.is_eq(Tr.Ent.k(h), y), h, r, y)

def pt.has_miss(+h: Tr.Ent, +r: List<&2, Tr.Ent>, +y: Nat, ne: {Nat.is_eq(Tr.Ent.k(h), y) == False{} : Bool}) -> {Tr.has(h <> r, y) == Tr.has(r, y) : Bool}:
  Equal.cong(Maybe<&2, Tr.Ent>, Bool, m => Maybe.is_some(&2, Tr.Ent, m), Tr.get(h <> r, y), Tr.get(r, y), pt.get_miss(h, r, y, ne))

def pt.has_head(+h: Tr.Ent, +r: List<&2, Tr.Ent>) -> {Tr.has(h <> r, Tr.Ent.k(h)) == True{} : Bool}:
  %Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(h <> r, Tr.Ent.k(h)), Some{h}, pt.get_head(h, r)) : {Maybe.is_some(&2, Tr.Ent, _) == True{} : Bool}
  {==}

def pt.has_app(A: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +y: Nat) -> {Tr.has(List.append(&2, Tr.Ent, A, C), y) == Bool.or(Tr.has(A, y), Tr.has(C, y)) : Bool}:
  match A:
    case Nil{}:
      {==}
    case +a <> +r:
      +ea = Nat.is_eq(Tr.Ent.k(a), y)
      +rc = List.append(&2, Tr.Ent, r, C)
      %Equal.sym(Bool, Tr.has(a <> rc, y), Bool.or(ea, Tr.has(rc, y)), pt.has_cons(a, rc, y)) : {_ == Bool.or(Tr.has(a <> r, y), Tr.has(C, y)) : Bool}
      %Equal.sym(Bool, Tr.has(rc, y), Bool.or(Tr.has(r, y), Tr.has(C, y)), pt.has_app(r, C, y)) : {Bool.or(ea, _) == Bool.or(Tr.has(a <> r, y), Tr.has(C, y)) : Bool}
      %Equal.sym(Bool, Tr.has(a <> r, y), Bool.or(ea, Tr.has(r, y)), pt.has_cons(a, r, y)) : {Bool.or(ea, Bool.or(Tr.has(r, y), Tr.has(C, y))) == Bool.or(_, Tr.has(C, y)) : Bool}
      Equal.sym(Bool, Bool.or(Bool.or(ea, Tr.has(r, y)), Tr.has(C, y)), Bool.or(ea, Bool.or(Tr.has(r, y), Tr.has(C, y))), pt.or_assoc(ea, Tr.has(r, y), Tr.has(C, y)))

def pt.has_app_l(+A: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +y: Nat, h: {Tr.has(A, y) == True{} : Bool}) -> {Tr.has(List.append(&2, Tr.Ent, A, C), y) == True{} : Bool}:
  %Equal.sym(Bool, Tr.has(List.append(&2, Tr.Ent, A, C), y), Bool.or(Tr.has(A, y), Tr.has(C, y)), pt.has_app(A, C, y)) : {_ == True{} : Bool}
  pt.or_tl(Tr.has(A, y), Tr.has(C, y), h)

def pt.has_app_r(+A: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, +y: Nat, h: {Tr.has(C, y) == True{} : Bool}) -> {Tr.has(List.append(&2, Tr.Ent, A, C), y) == True{} : Bool}:
  %Equal.sym(Bool, Tr.has(List.append(&2, Tr.Ent, A, C), y), Bool.or(Tr.has(A, y), Tr.has(C, y)), pt.has_app(A, C, y)) : {_ == True{} : Bool}
  pt.or_tr(Tr.has(A, y), Tr.has(C, y), h)

# no node of a sorted list is below its first key
def pt.has_below(X: List<&2, Tr.Ent>, +y: Nat, +al: {Tr.above(y, X) == True{} : Bool}, +st: {Tr.sorted(X) == True{} : Bool}) -> {Tr.has(X, y) == False{} : Bool}:
  match X:
    case Nil{}:
      {==}
    case +h <> +r:
      Equal.trans(Bool, Tr.has(h <> r, y), Tr.has(r, y), False{}, pt.has_miss(h, r, y, pt.lt_ne_r(y, Tr.Ent.k(h), al)), pt.has_below(r, y, pt.above_tail(y, h, r, al, st), tree.pt.and_r(Tr.above(Tr.Ent.k(h), r), Tr.sorted(r), st)))

def pt.app_snoc(A: List<&2, Tr.Ent>, +e: Tr.Ent, +C: List<&2, Tr.Ent>) -> {List.append(&2, Tr.Ent, List.append(&2, Tr.Ent, A, [e]), C) == List.append(&2, Tr.Ent, A, e <> C) : List<&2, Tr.Ent>}:
  match A:
    case Nil{}:
      {==}
    case +a <> +r:
      Equal.cong(List<&2, Tr.Ent>, List<&2, Tr.Ent>, l => a <> l, List.append(&2, Tr.Ent, List.append(&2, Tr.Ent, r, [e]), C), List.append(&2, Tr.Ent, r, e <> C), pt.app_snoc(r, e, C))

def pt.sorted_app_r(A: List<&2, Tr.Ent>, +C: List<&2, Tr.Ent>, st: {Tr.sorted(List.append(&2, Tr.Ent, A, C)) == True{} : Bool}) -> {Tr.sorted(C) == True{} : Bool}:
  match A:
    case Nil{}:
      st
    case +a <> +r:
      pt.sorted_app_r(r, C, tree.pt.and_r(Tr.above(Tr.Ent.k(a), List.append(&2, Tr.Ent, r, C)), Tr.sorted(List.append(&2, Tr.Ent, r, C)), st))

# A put
# -----

def pt.has_set_go(+t: List<&2, Tr.Ent>, +e: Tr.Ent, +y: Nat, b: Bool, eb: {Nat.is_eq(Tr.Ent.k(e), y) == b : Bool}, h: {Tr.has(t, y) == True{} : Bool}) -> {Tr.has(Tr.set(t, e), y) == True{} : Bool}:
  match b:
    case True{}:
      %pt.eq_true(Tr.Ent.k(e), y, eb) : {Tr.has(Tr.set(t, e), _) == True{} : Bool}
      %Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(Tr.set(t, e), Tr.Ent.k(e)), Some{e}, pt.get_set_same(t, e)) : {Maybe.is_some(&2, Tr.Ent, _) == True{} : Bool}
      {==}
    case False{}:
      %Equal.sym(Maybe<&2, Tr.Ent>, Tr.get(Tr.set(t, e), y), Tr.get(t, y), pt.get_set_other(t, e, y, eb)) : {Maybe.is_some(&2, Tr.Ent, _) == True{} : Bool}
      h

# a set keeps every node there
def pt.has_set(+t: List<&2, Tr.Ent>, +e: Tr.Ent, +y: Nat, h: {Tr.has(t, y) == True{} : Bool}) -> {Tr.has(Tr.set(t, e), y) == True{} : Bool}:
  pt.has_set_go(t, e, y, Nat.is_eq(Tr.Ent.k(e), y), {==}, h)

def pt.or_has_set(b: Bool, +t: List<&2, Tr.Ent>, +e: Tr.Ent, +p: Nat, o: {Bool.or(b, Tr.has(t, p)) == True{} : Bool}) -> {Bool.or(b, Tr.has(Tr.set(t, e), p)) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      pt.has_set(t, e, p, o)

def pt.ok_set(+t: List<&2, Tr.Ent>, +e: Tr.Ent, +k: Nat, +p: Nat, +h: {Tr.ok(t, k, p) == True{} : Bool}) -> {Tr.ok(Tr.set(t, e), k, p) == True{} : Bool}:
  +o = tree.pt.and_r(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(t, p)), h)
  tree.pt.and_t(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(Tr.set(t, e), p)), tree.pt.and_l(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(t, p)), h), pt.or_has_set(Nat.is_eq(p, 0n), t, e, p, o))

def pt.rooted_mono_set(s: List<&2, Tr.Ent>, +all: List<&2, Tr.Ent>, +e: Tr.Ent, +rs: {Tr.rooted.go(s, all) == True{} : Bool}) -> {Tr.rooted.go(s, Tr.set(all, e)) == True{} : Bool}:
  match s:
    case Nil{}:
      {==}
    case +h <> +r:
      +oh = tree.pt.and_l(Tr.ok(all, Tr.Ent.k(h), Tr.Ent.p(h)), Tr.rooted.go(r, all), rs)
