    case Nil{}:
      {==}
    case +e <> +r:
      match hit:
        case True{}:
          +g2 = {Tr.Ent.k(e) <> gone : List<&2, Nat>}
          pt.removes_go(r, g2, Tr.gone.at(r, g2), {==}, x, pt.or_tr(Nat.is_eq(Tr.Ent.k(e), x), Tr.elem(gone, x), ex))
        case False{}:
