          +lt = tree.pt.and_l(Nat.is_lt(p, k), Bool.or(Nat.is_eq(p, 0n), Tr.has(t, p)), tree.pt.and_l(Tr.ok(t, k, p), Tr.rooted.go(r, t), rs))
          +ak = tree.pt.and_l(Tr.above(k, r), Tr.sorted(r), st)
