    case Nil{}:
      {==}
    case +n <> rest:
      +a = Bool.and(O.Nodes.has(v, n), Bool.not(O.Info.built(info, n)))
      +ea = pf.and_l(a, C.needed(info, v, rest), e)
      pc.and_true(Bool.and(Bool.or(O.Node.eq(h, n), O.Nodes.has(v, n)), Bool.not(O.Info.built(info, n))), C.needed(info, h <> v, rest), pc.and_true(Bool.or(O.Node.eq(h, n), O.Nodes.has(v, n)), Bool.not(O.Info.built(info, n)), pf.or_r(O.Node.eq(h, n), O.Nodes.has(v, n), pf.and_l(O.Nodes.has(v, n), Bool.not(O.Info.built(info, n)), ea)), pf.and_r(O.Nodes.has(v, n), Bool.not(O.Info.built(info, n)), ea)), pc.needed_cons(info, h, v, rest, pf.and_r(a, C.needed(info, v, rest), e)))

def pc.emit_ok(stop: Bool, b: Bool, free: Bool, +info: O.Info, +h: O.Node, +rest: List<&2, O.Node>, +rec: List<&2, O.Node>, eb: {b == O.Info.built(info, h) : Bool}, +ih: {C.needed(info, rest, rec) == True{} : Bool}) -> {C.needed(info, h <> rest, O.cand.emit(stop, b, free, h, rec)) == True{} : Bool}:
  match stop b free:
    case True{} y z:
