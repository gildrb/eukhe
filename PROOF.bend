# every kept node is below the rest of the walk
def pt.blw(B: List<&2, Tr.Ent>, +s: List<&2, Tr.Ent>) -> Bool:
  match B:
    case Nil{}:
      True{}
    case +b <> rest:
      Bool.and(Tr.above(Tr.Ent.k(b), s), pt.blw(rest, s))

def pt.blw_tail(B: List<&2, Tr.Ent>, +e: Tr.Ent, +r: List<&2, Tr.Ent>, +bw: {pt.blw(B, e <> r) == True{} : Bool}, +st: {Tr.sorted(e <> r) == True{} : Bool}) -> {pt.blw(B, r) == True{} : Bool}:
  match B:
    case Nil{}:
      {==}
    case +b <> +bs:
      +i = Tr.above(Tr.Ent.k(b), e <> r)
      tree.pt.and_t(Tr.above(Tr.Ent.k(b), r), pt.blw(bs, r), pt.above_tail(Tr.Ent.k(b), e, r, tree.pt.and_l(i, pt.blw(bs, e <> r), bw), st), pt.blw_tail(bs, e, r, tree.pt.and_r(i, pt.blw(bs, e <> r), bw), st))

def pt.blw_snoc(B: List<&2, Tr.Ent>, +e: Tr.Ent, +r: List<&2, Tr.Ent>, +bw: {pt.blw(B, r) == True{} : Bool}, +ae: {Tr.above(Tr.Ent.k(e), r) == True{} : Bool}) -> {pt.blw(List.append(&2, Tr.Ent, B, [e]), r) == True{} : Bool}:
  match B:
    case Nil{}:
      tree.pt.and_t(Tr.above(Tr.Ent.k(e), r), True{}, ae, {==})
    case +b <> +bs:
      +i = Tr.above(Tr.Ent.k(b), r)
      tree.pt.and_t(i, pt.blw(List.append(&2, Tr.Ent, bs, [e]), r), tree.pt.and_l(i, pt.blw(bs, r), bw), pt.blw_snoc(bs, e, r, tree.pt.and_r(i, pt.blw(bs, r), bw), ae))

def pt.blw_has(B: List<&2, Tr.Ent>, +e: Tr.Ent, +r: List<&2, Tr.Ent>, +bw: {pt.blw(B, e <> r) == True{} : Bool}) -> {Tr.has(B, Tr.Ent.k(e)) == False{} : Bool}:
  match B:
    case Nil{}:
      {==}
    case +b <> +bs:
      +i = Tr.above(Tr.Ent.k(b), e <> r)
      +ne = pt.lt_ne(Tr.Ent.k(b), Tr.Ent.k(e), tree.pt.and_l(i, pt.blw(bs, e <> r), bw))
      Equal.trans(Bool, Tr.has(b <> bs, Tr.Ent.k(e)), Tr.has(bs, Tr.Ent.k(e)), False{}, pt.has_miss(b, bs, Tr.Ent.k(e), ne), pt.blw_has(bs, e, r, tree.pt.and_r(i, pt.blw(bs, e <> r), bw)))

def pt.lt_zero(-A: Type, p: Nat, lt: {Nat.is_lt(p, 0n) == True{} : Bool}) -> A:
  match p:
    case 0n:
      tree.pt.absurdF(A, lt)
    case 1n+q:
      tree.pt.absurdF(A, lt)

# a key above a parent is not the root
def pt.lt_nz(+p: Nat, k: Nat, lt: {Nat.is_lt(p, k) == True{} : Bool}) -> {Bool.not(Nat.is_eq(k, 0n)) == True{} : Bool}:
  match k:
    case 0n:
      pt.lt_zero({Bool.not(Nat.is_eq(0n, 0n)) == True{} : Bool}, p, lt)
    case 1n+q:
      {==}

def pt.above_lt(+a: Nat, +b: Nat, r: List<&2, Tr.Ent>, ab: {Nat.is_lt(a, b) == True{} : Bool}, br: {Tr.above(b, r) == True{} : Bool}) -> {Tr.above(a, r) == True{} : Bool}:
  match r:
    case Nil{}:
      {==}
    case +h <> +rest:
      pt.lt_trans(a, b, Tr.Ent.k(h), ab, br)

