// Deploy: `npm run deploy` (builds `dist/`, then `wrangler deploy`).
// eukhe.com and www.eukhe.com stay on the gildrb-products Worker until their routes move here.
{
  "name": "eukhe-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/install"],
  },
}
