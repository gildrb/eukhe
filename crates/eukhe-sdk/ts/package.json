{
  "name": "eukhe",
  "version": "0.1.0",
  "description": "Library that embeds the eukhe coding agent in a TypeScript application, over ACP (Agent Client Protocol); the eukhe CLI installs with npx eukhe install",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gildrb/eukhe.git",
    "directory": "crates/eukhe-sdk/ts"
  },
  "homepage": "https://github.com/gildrb/eukhe/tree/main/crates/eukhe-sdk/ts#readme",
  "keywords": ["eukhe", "agent", "acp", "agent-client-protocol", "coding-agent", "sdk"],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin", "linux"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "eukhe": "dist/cli.js"
  },
  "files": ["dist", "SKILL.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run build && tsc --noEmit && oxlint --type-aware --deny-warnings src test examples",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "prepack": "npm run build && cp ../SKILL.md SKILL.md"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  }
}
