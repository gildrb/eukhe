# in normal mode the frame selects nothing
def Leave.nosel(+w: T.St, hm: {S.St.mode(w) == T.Normal{} : T.Mode}) -> {Laws.Spec.no_sel(Laws.F.sel(Vim.Vim.frame(w))) == True{} : Bool}:
  %Equal.sym(T.Mode, S.St.mode(w), T.Normal{}, hm) : {Laws.Spec.no_sel(Laws.F.sel(Cl.Ck.frame(w, _))) == True{} : Bool}
  {==}

