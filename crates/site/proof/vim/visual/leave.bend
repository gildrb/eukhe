def LM.core(s: T.St, +hr: {B.Tgt.real(S.St.files(s), S.Win.tgt(S.St.win(s))) == True{} : Bool}, +fin: Fi.Final(Mo.Idle.mk(s))) -> {Laws.Claim.v_minus(Mo.Idle.mk(s)) == True{} : Bool}:
  match s:
    case T.St{+files, +folded, +dirs, +win, +marks, +spots, +opened, +bufs, +back, +fwd, +mode, +count, +pend, +find, +hl, +opts, +rows, +cols, +msg, +stat}:
      match win:
        case T.Win{tgt, cur, +want, +top, +left}:
          match tgt:
            case T.Dir{+d}:
              {==}
            case T.File{+i}:
              match cur:
                case T.Pos{+line, +col}:
                  LM.mid(files, folded, dirs, marks, spots, opened, bufs, back, fwd, mode, count, pend, find, hl, opts, rows, cols, msg, stat, i, line, col, want, top, left, hr, fin)

def LM.law(+fs: List<&2, T.Buf>, +rows: Nat, +cols: Nat, +evs: List<&2, T.Ev>) -> {Laws.Claim.v_minus(Laws.Spec.normal(fs, rows, cols, evs)) == True{} : Bool}:
  +n = Laws.Spec.normal(fs, rows, cols, evs)
  %Equal.sym(T.St, n, Mo.Idle.mk(n), Mo.Ready.eta(fs, rows, cols, evs)) : {Laws.Claim.v_minus(_) == True{} : Bool}
  LM.core(n, Mo.Ready.real(fs, rows, cols, evs), Mo.Ready.fin(fs, rows, cols, evs))

def VisualLaws.v_minus(fs, rows, cols, evs):
  LM.law(fs, rows, cols, evs)
