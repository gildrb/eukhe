# eukhe.com's Neovim: the proof of LAW v_minus
# ============================================
#
# v then -: normal mode's - (Oil shows the file's folder: Oil.here_file)
# leaves a folder, not the file, so Key.revisual leaves visual mode
# (Revis.leave) and the frame selects nothing (Leave.nosel). Each step is
# its own def, as in modes.bend, so --verdict never unfolds a whole
# keypress at once.

import Base
import ../../../vim/types.bend as T
import ../../../vim/buf.bend as B
import ../../../vim/st.bend as S
import ../../../vim/core.bend as C
import ../../../vim/keys.bend as K
import ../../../vim/visual.bend as Vi
import ../../../vim/vim.bend as Vim
import ../../../laws/vim/base.bend as Laws
import ../../../laws/vim/visual.bend as VisualLaws
import ../../base.bend as L
import ../../base/final.bend as Fi
import ../../base/reach.bend as Re
import ../motion/base.bend as Mo
import ../mouse/click.bend as Cl
import ../oil/base.bend as O
import ./yank_char.bend as Yc
import ./modes.bend as Md

def Revis.leave(+st: T.St, +k: T.Vis, +start: T.Pos, +i: Nat, -d: String, hm: {S.St.mode(st) == T.Normal{} : T.Mode}, ht: {S.Win.tgt(S.St.win(st)) == T.Dir{d} : T.Tgt})
  -> {K.Key.revisual(st, S.St.mode(st), k, start, T.File{i}) == st : T.St}:
  %Equal.sym(T.Mode, S.St.mode(st), T.Normal{}, hm) : {K.Key.revisual(st, _, k, start, T.File{i}) == st : T.St}
  %Equal.sym(T.Tgt, S.Win.tgt(S.St.win(st)), T.Dir{d}, ht) : {Bool.pick(T.St, Vi.Vis.same_tgt(T.File{i}, _), S.St.set_mode(st, T.Visual{k, start}), st) == st : T.St}
  {==}

def LM.next(+files: List<&2, T.Buf>, +folded: List<&2, List<&2, String>>, +dirs: List<&2, T.Listing>, +marks: List<&2, T.Pos>, +spots: List<&2, T.Spot>, +opened: List<&2, Nat>, +bufs: List<&2, Nat>, +back: List<&2, T.Win>, +fwd: List<&2, T.Win>, +find: Maybe<&2, T.Find>, +hl: Bool, +opts: T.Opts, +rows: Nat, +cols: Nat, +msg: String, +stat: String, +i: Nat, +p: T.Pos, +want: T.Want, +top: Nat, +left: Nat) -> {Re.Reach.next(T.St{files, folded, dirs, T.Win{T.File{i}, p, want, top, left}, marks, spots, opened, bufs, back, fwd, T.Visual{T.VChars{}, p}, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat}, T.EvKey{"-"}) == Vim.Vim.keep(T.St{files, folded, dirs, T.Win{T.File{i}, p, want, top, left}, marks, spots, opened, bufs, back, fwd, T.Visual{T.VChars{}, p}, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat}, Laws.Spec.after(K.Key.revisual.step(K.Key.in_normal(T.St{files, folded, dirs, T.Win{T.File{i}, p, want, top, left}, marks, spots, opened, bufs, back, fwd, T.Normal{}, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat}, "-"), T.VChars{}, p, T.File{i}))) : T.St}:
  {==}

def LM.hn(+files: List<&2, T.Buf>, +folded: List<&2, List<&2, String>>, +dirs: List<&2, T.Listing>, +marks: List<&2, T.Pos>, +spots: List<&2, T.Spot>, +opened: List<&2, Nat>, +bufs: List<&2, Nat>, +back: List<&2, T.Win>, +fwd: List<&2, T.Win>, +find: Maybe<&2, T.Find>, +hl: Bool, +opts: T.Opts, +rows: Nat, +cols: Nat, +msg: String, +stat: String, +i: Nat, +p: T.Pos, +want: T.Want, +top: Nat, +left: Nat) -> {Laws.Spec.after(K.Key.in_normal(T.St{files, folded, dirs, T.Win{T.File{i}, p, want, top, left}, marks, spots, opened, bufs, back, fwd, T.Normal{}, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat}, "-")) == C.Oil.here(O.Oil.idle(T.St{files, folded, dirs, T.Win{T.File{i}, p, want, top, left}, marks, spots, opened, bufs, back, fwd, T.Normal{}, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat})) : T.St}:
  {==}

