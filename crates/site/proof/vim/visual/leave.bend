  -> {Laws.Spec.no_sel(Laws.F.sel(Vim.Vim.frame(Laws.Spec.press(Laws.Spec.press(Mo.Idle.mk(T.St{files, folded, dirs, T.Win{T.File{i}, T.Pos{line, col}, want, top, left}, marks, spots, opened, bufs, back, fwd, mode, count, pend, find, hl, opts, rows, cols, msg, stat}), "v"), "-")))) == True{} : Bool}:
  %Equal.sym(T.St, Laws.Spec.press(Mo.Idle.mk(T.St{files, folded, dirs, T.Win{T.File{i}, T.Pos{line, col}, want, top, left}, marks, spots, opened, bufs, back, fwd, mode, count, pend, find, hl, opts, rows, cols, msg, stat}), "v"), Yc.Vis.at(files, folded, dirs, marks, spots, Vim.Vim.opened(opened), bufs, back, fwd, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat, T.VChars{}, T.Pos{line, col}, T.Win{T.File{i}, T.Pos{line, col}, C.Want.at(C.St.lines(Yc.Vis.at(files, folded, dirs, marks, spots, Vim.Vim.opened(opened), bufs, back, fwd, 0n, T.NoPend{}, find, hl, opts, rows, cols, msg, stat, T.VChars{}, T.Pos{line, col}, T.Win{T.File{i}, T.Pos{line, col}, want, top, left})), T.Pos{line, col}, want), top, left}), Md.VJ.state(files, folded, dirs, marks, spots, opened, bufs, back, fwd, mode, count, pend, find, hl, opts, rows, cols, msg, stat, i, line, col, want, top, left, hr, fin)) : {Laws.Spec.no_sel(Laws.F.sel(Vim.Vim.frame(Laws.Spec.press(_, "-")))) == True{} : Bool}
  %Md.VJ.eta(files, folded, dirs, marks, spots, opened, bufs, back, fwd, mode, count, pend, find, hl, opts, rows, cols, msg, stat, i, line, col, want, top, left) : {Laws.Spec.no_sel(Laws.F.sel(Vim.Vim.frame(Laws.Spec.press(_, "-")))) == True{} : Bool}
