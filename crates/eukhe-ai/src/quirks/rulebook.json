    { "layer": "model", "target": "claude-sonnet-4-5", "set": { "stops_output_at_window": true } },
    { "layer": "model", "target": "claude-sonnet-4-5-20250929", "set": { "stops_output_at_window": true } },
    { "layer": "model", "target": "claude-sonnet-4-6", "set": { "stops_output_at_window": true } },
    { "layer": "model", "target": "claude-sonnet-5", "set": { "stops_output_at_window": true } },
    { "layer": "model", "target": "claude-sonnet-5-5", "set": { "stops_output_at_window": true } },

    { "layer": "host", "target": "anthropic", "set": { "strict_cap": 20, "tool_choice_free": false, "count_tokens": "anthropic", "list_models": "anthropic", "web_search": "anthropic" } },
    { "layer": "host", "target": "ant-ling", "set": { "store": false, "developer_role": false, "reasoning_effort": false, "max_tokens_field": "max_tokens", "thinking_format": "ant-ling", "long_cache_retention": false } },
    { "layer": "host", "target": "azure-openai-responses", "set": { "strict_tools": true, "compound_tool_call_ids": true } },
    { "layer": "host", "target": "cerebras", "set": { "store": false, "developer_role": false } },
    { "layer": "host", "target": "chutes", "set": { "store": false, "developer_role": false, "max_tokens_field": "max_tokens" } },
