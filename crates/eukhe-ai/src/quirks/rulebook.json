    { "layer": "host", "target": "nvidia", "set": { "store": false, "developer_role": false, "reasoning_effort": false, "max_tokens_field": "max_tokens", "long_cache_retention": false } },
    { "layer": "host", "target": "openai", "set": { "developer_role": true, "count_tokens": "openai", "list_models": "openai", "embed": "openai", "generate_image": "openai", "web_search": "openai", "compact": "openai", "tool_call_id_limit": 40, "compound_tool_call_ids": true } },
    { "layer": "host", "target": "openai-codex-responses", "set": { "strict_tools": true, "compound_tool_call_ids": true } },
    { "layer": "host", "target": "opencode", "set": { "stops_output_at_window": false, "store": false, "developer_role": false, "compound_tool_call_ids": true } },
    { "layer": "host", "target": "opencode-go", "set": { "stops_output_at_window": false, "store": false, "developer_role": false, "reasoning_content_signature": true } },
    { "layer": "host", "target": "openrouter", "set": { "developer_role": false, "developer_role_prefixes": ["anthropic/", "openai/"], "thinking_format": "openrouter", "session_affinity_headers": true, "session_affinity_format": "openrouter", "anthropic_cache_control_prefixes": ["anthropic/"], "list_models": "openai", "usage": "openrouter", "generate_image": "openrouter" } },
    { "layer": "host", "target": "openrouter-url", "set": { "developer_role": false, "developer_role_prefixes": ["anthropic/", "openai/"], "thinking_format": "openrouter", "session_affinity_headers": true, "session_affinity_format": "openrouter", "list_models": "openai", "usage": "openrouter", "generate_image": "openrouter" } },
    { "layer": "host", "target": "prime-inference", "set": { "store": false, "developer_role": false, "max_tokens_field": "max_tokens", "anthropic_cache_control_prefixes": ["anthropic/"], "list_models": "openai" } },
    { "layer": "host", "target": "together", "set": { "store": false, "developer_role": false, "reasoning_effort": false, "max_tokens_field": "max_tokens", "thinking_format": "together", "long_cache_retention": false } },
    { "layer": "host", "target": "xai", "set": { "store": false, "developer_role": false, "reasoning_effort": false, "list_models": "openai", "tokenize": "xai", "generate_image": "openai", "encrypted_reasoning": true } },
