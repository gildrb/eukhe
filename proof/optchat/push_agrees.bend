# eukhe: the proof of LAW push_agrees

import Base
import ../../bend/optchat.bend as O
import ../../LAWS.bend as Laws

# Push agrees, in chunks
# ----------------------
# push.sim runs agree.go's steps from S with ok the verdict so far (it
# stops at the first False, which forces each step's view like agree.go
# does) and hands back the state it reaches; push.split cuts
# agree.go(a + b) at a. Each chunk is then one {==} between literal
# states, small enough for the kernel's fuel.

type PushSt is Data:
  PushSt{ok: Bool, tb: List<&2, Bool>, es: List<&2, O.Entry>, v: List<&2, O.Node>}

def push.sim(n: Nat, ok: Bool, +m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>) -> PushSt:
  match n ok:
    case 0n _:
      PushSt{ok, tb, es, v}
    case 1n+p False{}:
      PushSt{False{}, tb, es, v}
    case 1n+p True{}:
      +es2 = O.push(es, tb)
      +tb2 = O.Bits.inc(tb)
      +v2 = O.fit.view(m, tb2, List.length(&2, O.Entry, es2), 0n, O.All{1n}, List.append(&2, O.Node, v, [O.Node.leaf(tb)]))
      push.sim(p, O.same_lines(v2, es2), m, tb2, es2, v2)

# ok, then agree.go(b) from the state reached
def push.fin(b: Nat, +m: O.Age, s: PushSt) -> Bool:
  match s:
    case PushSt{ok, tb, es, v}:
      Bool.and(ok, O.agree.go(b, m, tb, es, v))

# one step's new list and view, as agree.go computes them
def push.nes(+tb: List<&2, Bool>, +es: List<&2, O.Entry>) -> List<&2, O.Entry>:
  O.push(es, tb)

def push.nv(+m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>) -> List<&2, O.Node>:
  O.fit.view(m, O.Bits.inc(tb), List.length(&2, O.Entry, O.push(es, tb)), 0n, O.All{1n}, List.append(&2, O.Node, v, [O.Node.leaf(tb)]))

def push.split(a: Nat, -b: Nat, ok: Bool, +m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>) -> {Bool.and(ok, O.agree.go(Nat.add(a, b), m, tb, es, v)) == push.fin(b, m, push.sim(a, ok, m, tb, es, v)) : Bool}:
  match a ok:
    case 0n _:
      {==}
    case 1n+p False{}:
      {==}
    case 1n+p True{}:
      push.split(p, b, O.same_lines(push.nv(m, tb, es, v), push.nes(tb, es)), m, O.Bits.inc(tb), push.nes(tb, es), push.nv(m, tb, es, v))

# the state agree.go(Last) reaches after 1000·k steps (k = 1..20),
# generated by running the same steps natively

