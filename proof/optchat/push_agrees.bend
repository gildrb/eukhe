# chunk ok from S to S' and agree.go(r) from S' make agree.go(c + r)
# from S
def push.link(c: Nat, -r: Nat, +m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>, -tb2: List<&2, Bool>, -es2: List<&2, O.Entry>, -v2: List<&2, O.Node>,
  ch: {push.sim(c, True{}, m, tb, es, v) == PushSt{True{}, tb2, es2, v2} : PushSt}, nx: {O.agree.go(r, m, tb2, es2, v2) == True{} : Bool})
  -> {O.agree.go(Nat.add(c, r), m, tb, es, v) == True{} : Bool}:
  %nx : {O.agree.go(Nat.add(c, r), m, tb, es, v) == _ : Bool}
  %ch : {O.agree.go(Nat.add(c, r), m, tb, es, v) == push.fin(r, m, _) : Bool}
  push.split(c, r, True{}, m, tb, es, v)

