# agree is agree.go from the empty state
def push.unfold(-n: Nat) -> {O.agree(O.Last{}, n) == O.agree.go(n, O.Last{}, Nil{}, Nil{}, Nil{}) : Bool}:
  {==}

# chunk ok from S to S' and agree.go(r) from S' make agree.go(n) from S,
# for n = c + r as literals: each {==} on the sum unfolds c steps of
# Nat.add and meets r, never a chain of nested sums (the checker compares
# a Succ chain against a literal one frame per Succ)
def push.step(c: Nat, -r: Nat, -n: Nat, eq: {Nat.add(c, r) == n : Nat}, +m: O.Age, +tb: List<&2, Bool>, +es: List<&2, O.Entry>, +v: List<&2, O.Node>, -tb2: List<&2, Bool>, -es2: List<&2, O.Entry>, -v2: List<&2, O.Node>,
  ch: {push.sim(c, True{}, m, tb, es, v) == PushSt{True{}, tb2, es2, v2} : PushSt}, nx: {O.agree.go(r, m, tb2, es2, v2) == True{} : Bool})
  -> {O.agree.go(n, m, tb, es, v) == True{} : Bool}:
  %eq : {O.agree.go(_, m, tb, es, v) == True{} : Bool}
  push.link(c, r, m, tb, es, v, tb2, es2, v2, ch, nx)

# 20001 = 20·1000 + 1: twenty chunks, then the last step
def push.go() -> {O.agree.go(20001n, O.Last{}, Nil{}, Nil{}, Nil{}) == True{} : Bool}:
  push.step(1000n, 19001n, 20001n, {==}, O.Last{}, Nil{}, Nil{}, Nil{}, push.tb1(), push.es1(), push.v1(), push.chunk0(), push.step(1000n, 18001n, 19001n, {==}, O.Last{}, push.tb1(), push.es1(), push.v1(), push.tb2(), push.es2(), push.v2(), push.chunk1(), push.step(1000n, 17001n, 18001n, {==}, O.Last{}, push.tb2(), push.es2(), push.v2(), push.tb3(), push.es3(), push.v3(), push.chunk2(), push.step(1000n, 16001n, 17001n, {==}, O.Last{}, push.tb3(), push.es3(), push.v3(), push.tb4(), push.es4(), push.v4(), push.chunk3(), push.step(1000n, 15001n, 16001n, {==}, O.Last{}, push.tb4(), push.es4(), push.v4(), push.tb5(), push.es5(), push.v5(), push.chunk4(), push.step(1000n, 14001n, 15001n, {==}, O.Last{}, push.tb5(), push.es5(), push.v5(), push.tb6(), push.es6(), push.v6(), push.chunk5(), push.step(1000n, 13001n, 14001n, {==}, O.Last{}, push.tb6(), push.es6(), push.v6(), push.tb7(), push.es7(), push.v7(), push.chunk6(), push.step(1000n, 12001n, 13001n, {==}, O.Last{}, push.tb7(), push.es7(), push.v7(), push.tb8(), push.es8(), push.v8(), push.chunk7(), push.step(1000n, 11001n, 12001n, {==}, O.Last{}, push.tb8(), push.es8(), push.v8(), push.tb9(), push.es9(), push.v9(), push.chunk8(), push.step(1000n, 10001n, 11001n, {==}, O.Last{}, push.tb9(), push.es9(), push.v9(), push.tb10(), push.es10(), push.v10(), push.chunk9(), push.step(1000n, 9001n, 10001n, {==}, O.Last{}, push.tb10(), push.es10(), push.v10(), push.tb11(), push.es11(), push.v11(), push.chunk10(), push.step(1000n, 8001n, 9001n, {==}, O.Last{}, push.tb11(), push.es11(), push.v11(), push.tb12(), push.es12(), push.v12(), push.chunk11(), push.step(1000n, 7001n, 8001n, {==}, O.Last{}, push.tb12(), push.es12(), push.v12(), push.tb13(), push.es13(), push.v13(), push.chunk12(), push.step(1000n, 6001n, 7001n, {==}, O.Last{}, push.tb13(), push.es13(), push.v13(), push.tb14(), push.es14(), push.v14(), push.chunk13(), push.step(1000n, 5001n, 6001n, {==}, O.Last{}, push.tb14(), push.es14(), push.v14(), push.tb15(), push.es15(), push.v15(), push.chunk14(), push.step(1000n, 4001n, 5001n, {==}, O.Last{}, push.tb15(), push.es15(), push.v15(), push.tb16(), push.es16(), push.v16(), push.chunk15(), push.step(1000n, 3001n, 4001n, {==}, O.Last{}, push.tb16(), push.es16(), push.v16(), push.tb17(), push.es17(), push.v17(), push.chunk16(), push.step(1000n, 2001n, 3001n, {==}, O.Last{}, push.tb17(), push.es17(), push.v17(), push.tb18(), push.es18(), push.v18(), push.chunk17(), push.step(1000n, 1001n, 2001n, {==}, O.Last{}, push.tb18(), push.es18(), push.v18(), push.tb19(), push.es19(), push.v19(), push.chunk18(), push.step(1000n, 1n, 1001n, {==}, O.Last{}, push.tb19(), push.es19(), push.v19(), push.tb20(), push.es20(), push.v20(), push.chunk19(), push.tail()))))))))))))))))))))

def push_agrees() -> {O.agree(O.Last{}, 20001n) == True{} : Bool}:
  Equal.trans(Bool, O.agree(O.Last{}, 20001n), O.agree.go(20001n, O.Last{}, Nil{}, Nil{}, Nil{}), True{}, push.unfold(20001n), push.go())

# (d) Taelin's push

def Laws.push_agrees():
  push_agrees()
