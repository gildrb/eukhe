def Screen.screen_ffi_pace(min, k, r, s, n, f):
  Equal.trans(String, FSc.ffi(FSc.put_req(FSc.ReqPace{min, k, Sc.Pace{r, s}, n}, "")), FSc.ffi.of(Wr.Got{FSc.ReqPace{min, k, Sc.Pace{r, s}, n}, ""}), FSc.put_pace(Sc.pace.run([Sc.Chunk{n}, Sc.Frame{}], min, k, Sc.Pace{r, s}), ""), Equal.cong(Wr.Dec<FSc.Req>, String, FSc.ffi.of, FSc.get_req(FSc.put_req(FSc.ReqPace{min, k, Sc.Pace{r, s}, n}, "")), Wr.Got{FSc.ReqPace{min, k, Sc.Pace{r, s}, n}, ""}, fs.rt_pace(min, k, r, s, n, f)), {==})
