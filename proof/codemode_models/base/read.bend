# eukhe: lemmas of the entry proofs of area codemode_models: spelled
# requests read back (generated by the scratch gen_entry.py; each decoder
# reads the spec's spelling of a value whose numbers fit back and leaves
# the rest untouched)

import Base
import ../../../bend/codemode_models.bend as Mod
import ../../../bend/ffi_codemode_models.bend as FMod
import ../../../bend/wire.bend as Wr
import ../../../laws/base.bend as LawsBase
import ../../../laws/wire.bend as Wire
import ../../../laws/codemode_models/entry.bend as CodemodeModelsEntry
import ../../context_order/base.bend as LACo
import ../../context_order/base/read.bend as LACoRead

# ---- tags ----

def cmq.desc(d: Mod.Desc, +rest: String, +h: {CodemodeModelsEntry.desc_fits(d) == True{} : Bool}) -> {FMod.get_desc(CodemodeModelsEntry.spell_desc(d, rest)) == Wr.Got{d, rest} : Wr.Dec<Mod.Desc>}:
  match d:
    case Mod.DUndef{}:
      %LACoRead.cot.nat(0n, rest, {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DUndef{}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DNull{}:
      %LACoRead.cot.nat(1n, rest, {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DNull{}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DBool{}:
      %LACoRead.cot.nat(2n, rest, {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DBool{}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DNum{}:
      %LACoRead.cot.nat(3n, rest, {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DNum{}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DStr{}:
      %LACoRead.cot.nat(4n, rest, {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DStr{}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DArr{+e}:
      %LACoRead.cot.nat(5n, Wr.put_bool(e, rest), {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DArr{e}, rest} : Wr.Dec<Mod.Desc>}
      %LACoRead.cot.bool(e, rest) : {FMod.get_desc.empty(_) == Wr.Got{Mod.DArr{e}, rest} : Wr.Dec<Mod.Desc>}
      {==}
    case Mod.DObj{+ks}:
      %LACoRead.cot.nat(6n, LawsBase.wire_spell_strs(ks, rest), {==}) : {FMod.get_desc.tag(_) == Wr.Got{Mod.DObj{ks}, rest} : Wr.Dec<Mod.Desc>}
      %Equal.sym(Wr.Dec<List<&2, String>>, Wr.get_list(~String, ~Wr.get_str, LawsBase.wire_spell_strs(ks, rest)), Wr.Got{ks, rest}, Wire.wire_strs_round_trip(ks, rest, h)) : {FMod.get_desc.keys(_) == Wr.Got{Mod.DObj{ks}, rest} : Wr.Dec<Mod.Desc>}
      {==}

def cmq.txt(t: Mod.Txt, +rest: String, +h: {CodemodeModelsEntry.txt_fits(t) == True{} : Bool}) -> {FMod.get_txt(CodemodeModelsEntry.spell_txt(t, rest)) == Wr.Got{t, rest} : Wr.Dec<Mod.Txt>}:
  match t:
    case Mod.NoTxt{}:
      %LACoRead.cot.nat(0n, rest, {==}) : {FMod.get_txt.tag(_) == Wr.Got{Mod.NoTxt{}, rest} : Wr.Dec<Mod.Txt>}
      {==}
    case Mod.Txt{+a}:
      %LACoRead.cot.nat(1n, Wr.put_str(a, rest), {==}) : {FMod.get_txt.tag(_) == Wr.Got{Mod.Txt{a}, rest} : Wr.Dec<Mod.Txt>}
      %Equal.sym(Wr.Dec<String>, Wr.get_str(Wr.put_str(a, rest)), Wr.Got{a, rest}, Wire.wire_str_round_trip(a, rest, h)) : {FMod.get_txt.text(_) == Wr.Got{Mod.Txt{a}, rest} : Wr.Dec<Mod.Txt>}
      {==}

def cmq.call(c: Mod.Call, +rest: String) -> {FMod.get_call(CodemodeModelsEntry.spell_call(c, rest)) == Wr.Got{c, rest} : Wr.Dec<Mod.Call>}:
  match c:
    case Mod.CClassify{}:
      %LACoRead.cot.nat(0n, rest, {==}) : {FMod.get_call.tag(_) == Wr.Got{Mod.CClassify{}, rest} : Wr.Dec<Mod.Call>}
      {==}
    case Mod.CImages{}:
      %LACoRead.cot.nat(1n, rest, {==}) : {FMod.get_call.tag(_) == Wr.Got{Mod.CImages{}, rest} : Wr.Dec<Mod.Call>}
      {==}

def cmq.mtype(t: Mod.MType, +rest: String) -> {FMod.get_mtype(CodemodeModelsEntry.spell_mtype(t, rest)) == Wr.Got{t, rest} : Wr.Dec<Mod.MType>}:
  match t:
    case Mod.TChat{}:
      %LACoRead.cot.nat(0n, rest, {==}) : {FMod.get_mtype.tag(_) == Wr.Got{Mod.TChat{}, rest} : Wr.Dec<Mod.MType>}
      {==}
    case Mod.TImage{}:
      %LACoRead.cot.nat(1n, rest, {==}) : {FMod.get_mtype.tag(_) == Wr.Got{Mod.TImage{}, rest} : Wr.Dec<Mod.MType>}
      {==}
    case Mod.TClassifier{}:
      %LACoRead.cot.nat(2n, rest, {==}) : {FMod.get_mtype.tag(_) == Wr.Got{Mod.TClassifier{}, rest} : Wr.Dec<Mod.MType>}
      {==}

def cmq.found(f: Maybe<&2, Mod.MType>, +rest: String) -> {FMod.get_found(CodemodeModelsEntry.spell_found(f, rest)) == Wr.Got{f, rest} : Wr.Dec<Maybe<&2, Mod.MType>>}:
  match f:
    case None{}:
      %LACoRead.cot.nat(0n, rest, {==}) : {FMod.get_found.tag(_) == Wr.Got{None{}, rest} : Wr.Dec<Maybe<&2, Mod.MType>>}
      {==}
    case Some{+t}:
      %LACoRead.cot.nat(1n, CodemodeModelsEntry.spell_mtype(t, rest), {==}) : {FMod.get_found.tag(_) == Wr.Got{Some{t}, rest} : Wr.Dec<Maybe<&2, Mod.MType>>}
      %Equal.sym(Wr.Dec<Mod.MType>, FMod.get_mtype(CodemodeModelsEntry.spell_mtype(t, rest)), Wr.Got{t, rest}, cmq.mtype(t, rest)) : {FMod.get_found.some(_) == Wr.Got{Some{t}, rest} : Wr.Dec<Maybe<&2, Mod.MType>>}
      {==}

# ---- lists of Mod.Desc ----

def cmq.dl.go_rt(+t: List<&2, Mod.Desc>, +x: Mod.Desc, +rest: String, +h: {CodemodeModelsEntry.descs_all(x <> t) == True{} : Bool}) -> {Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, List.length(&2, Mod.Desc, t), FMod.get_desc(CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_descs.items(t, rest)))) == Wr.Got{x <> t, rest} : Wr.Dec<List<&2, Mod.Desc>>}:
  match t:
    case Nil{}:
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(x, rest)), Wr.Got{x, rest}, cmq.desc(x, rest, LACo.co.and_l(CodemodeModelsEntry.desc_fits(x), CodemodeModelsEntry.descs_all([]), h))) : {Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, 0n, _) == Wr.Got{[x], rest} : Wr.Dec<List<&2, Mod.Desc>>}
      {==}
    case Con{+y, +u}:
      +r2 = CodemodeModelsEntry.spell_desc(y, CodemodeModelsEntry.spell_descs.items(u, rest))
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(x, r2)), Wr.Got{x, r2}, cmq.desc(x, r2, LACo.co.and_l(CodemodeModelsEntry.desc_fits(x), CodemodeModelsEntry.descs_all(y <> u), h))) : {Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, 1n+List.length(&2, Mod.Desc, u), _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Desc>>}
      %Equal.sym(Wr.Dec<List<&2, Mod.Desc>>, Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, List.length(&2, Mod.Desc, u), FMod.get_desc(r2)), Wr.Got{y <> u, rest}, cmq.dl.go_rt(u, y, rest, LACo.co.and_r(CodemodeModelsEntry.desc_fits(x), CodemodeModelsEntry.descs_all(y <> u), h))) : {Wr.get_list.cons(Mod.Desc, x, _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Desc>>}
      {==}

def cmq.dl.rt(+xs: List<&2, Mod.Desc>, +r: String, +h: {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Desc, xs)), CodemodeModelsEntry.descs_all(xs)) == True{} : Bool}) -> {Wr.get_list(~Mod.Desc, ~FMod.get_desc, Wr.put_nat(List.length(&2, Mod.Desc, xs), CodemodeModelsEntry.spell_descs.items(xs, r))) == Wr.Got{xs, r} : Wr.Dec<List<&2, Mod.Desc>>}:
  match xs:
    case Nil{}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(0n, r)), Wr.Got{0n, r}, Wire.wire_nat_round_trip(0n, r, {==})) : {Wr.get_list.start(~Mod.Desc, ~FMod.get_desc, _) == Wr.Got{Nil{}, r} : Wr.Dec<List<&2, Mod.Desc>>}
      {==}
    case Con{+x, +t}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(List.length(&2, Mod.Desc, x <> t), CodemodeModelsEntry.spell_descs.items(x <> t, r))), Wr.Got{List.length(&2, Mod.Desc, x <> t), CodemodeModelsEntry.spell_descs.items(x <> t, r)}, Wire.wire_nat_round_trip(List.length(&2, Mod.Desc, x <> t), CodemodeModelsEntry.spell_descs.items(x <> t, r), LACo.co.and_l(LawsBase.wire_fits(List.length(&2, Mod.Desc, x <> t)), CodemodeModelsEntry.descs_all(x <> t), h))) : {Wr.get_list.start(~Mod.Desc, ~FMod.get_desc, _) == Wr.Got{x <> t, r} : Wr.Dec<List<&2, Mod.Desc>>}
      cmq.dl.go_rt(t, x, r, LACo.co.and_r(LawsBase.wire_fits(List.length(&2, Mod.Desc, x <> t)), CodemodeModelsEntry.descs_all(x <> t), h))

# ---- blk ----

def cmq.blk(v: Mod.Blk, +rest: String, +h: {CodemodeModelsEntry.blk_fits(v) == True{} : Bool}) -> {FMod.get_blk(CodemodeModelsEntry.spell_blk(v, rest)) == Wr.Got{v, rest} : Wr.Dec<Mod.Blk>}:
  match v:
    case Mod.Blk{+k, +t, +x, +d, +m}:
      +h_k = LACo.co.and_l(CodemodeModelsEntry.desc_fits(k), Bool.and(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)))), h)
      +hr_k = LACo.co.and_r(CodemodeModelsEntry.desc_fits(k), Bool.and(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)))), h)
      +h_t = LACo.co.and_l(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m))), hr_k)
      +hr_t = LACo.co.and_r(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m))), hr_k)
      +h_x = LACo.co.and_l(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)), hr_t)
      +hr_x = LACo.co.and_r(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)), hr_t)
      +h_d = LACo.co.and_l(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m), hr_x)
      +hr_d = LACo.co.and_r(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m), hr_x)
      +h_m = hr_d
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest)))))), Wr.Got{k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest))))}, cmq.desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest)))), h_k)) : {FMod.get_blk.block(_) == Wr.Got{Mod.Blk{k, t, x, d, m}, rest} : Wr.Dec<Mod.Blk>}
      %Equal.sym(Wr.Dec<Mod.Txt>, FMod.get_txt(CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest))))), Wr.Got{t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest)))}, cmq.txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest))), h_t)) : {FMod.get_blk.kind(k, _) == Wr.Got{Mod.Blk{k, t, x, d, m}, rest} : Wr.Dec<Mod.Blk>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest)))), Wr.Got{x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest))}, cmq.desc(x, CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest)), h_x)) : {FMod.get_blk.text(k, t, _) == Wr.Got{Mod.Blk{k, t, x, d, m}, rest} : Wr.Dec<Mod.Blk>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(d, CodemodeModelsEntry.spell_desc(m, rest))), Wr.Got{d, CodemodeModelsEntry.spell_desc(m, rest)}, cmq.desc(d, CodemodeModelsEntry.spell_desc(m, rest), h_d)) : {FMod.get_blk.data(k, t, x, _) == Wr.Got{Mod.Blk{k, t, x, d, m}, rest} : Wr.Dec<Mod.Blk>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(m, rest)), Wr.Got{m, rest}, cmq.desc(m, rest, h_m)) : {FMod.get_blk.mime(k, t, x, d, _) == Wr.Got{Mod.Blk{k, t, x, d, m}, rest} : Wr.Dec<Mod.Blk>}
      {==}

# ---- lists of Mod.Blk ----

def cmq.bl.go_rt(+t: List<&2, Mod.Blk>, +x: Mod.Blk, +rest: String, +h: {CodemodeModelsEntry.blks_all(x <> t) == True{} : Bool}) -> {Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, List.length(&2, Mod.Blk, t), FMod.get_blk(CodemodeModelsEntry.spell_blk(x, CodemodeModelsEntry.spell_blks.items(t, rest)))) == Wr.Got{x <> t, rest} : Wr.Dec<List<&2, Mod.Blk>>}:
  match t:
    case Nil{}:
      %Equal.sym(Wr.Dec<Mod.Blk>, FMod.get_blk(CodemodeModelsEntry.spell_blk(x, rest)), Wr.Got{x, rest}, cmq.blk(x, rest, LACo.co.and_l(CodemodeModelsEntry.blk_fits(x), CodemodeModelsEntry.blks_all([]), h))) : {Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, 0n, _) == Wr.Got{[x], rest} : Wr.Dec<List<&2, Mod.Blk>>}
      {==}
    case Con{+y, +u}:
      +r2 = CodemodeModelsEntry.spell_blk(y, CodemodeModelsEntry.spell_blks.items(u, rest))
      %Equal.sym(Wr.Dec<Mod.Blk>, FMod.get_blk(CodemodeModelsEntry.spell_blk(x, r2)), Wr.Got{x, r2}, cmq.blk(x, r2, LACo.co.and_l(CodemodeModelsEntry.blk_fits(x), CodemodeModelsEntry.blks_all(y <> u), h))) : {Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, 1n+List.length(&2, Mod.Blk, u), _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Blk>>}
      %Equal.sym(Wr.Dec<List<&2, Mod.Blk>>, Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, List.length(&2, Mod.Blk, u), FMod.get_blk(r2)), Wr.Got{y <> u, rest}, cmq.bl.go_rt(u, y, rest, LACo.co.and_r(CodemodeModelsEntry.blk_fits(x), CodemodeModelsEntry.blks_all(y <> u), h))) : {Wr.get_list.cons(Mod.Blk, x, _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Blk>>}
      {==}

def cmq.bl.rt(+xs: List<&2, Mod.Blk>, +r: String, +h: {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Blk, xs)), CodemodeModelsEntry.blks_all(xs)) == True{} : Bool}) -> {Wr.get_list(~Mod.Blk, ~FMod.get_blk, Wr.put_nat(List.length(&2, Mod.Blk, xs), CodemodeModelsEntry.spell_blks.items(xs, r))) == Wr.Got{xs, r} : Wr.Dec<List<&2, Mod.Blk>>}:
  match xs:
    case Nil{}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(0n, r)), Wr.Got{0n, r}, Wire.wire_nat_round_trip(0n, r, {==})) : {Wr.get_list.start(~Mod.Blk, ~FMod.get_blk, _) == Wr.Got{Nil{}, r} : Wr.Dec<List<&2, Mod.Blk>>}
      {==}
    case Con{+x, +t}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(List.length(&2, Mod.Blk, x <> t), CodemodeModelsEntry.spell_blks.items(x <> t, r))), Wr.Got{List.length(&2, Mod.Blk, x <> t), CodemodeModelsEntry.spell_blks.items(x <> t, r)}, Wire.wire_nat_round_trip(List.length(&2, Mod.Blk, x <> t), CodemodeModelsEntry.spell_blks.items(x <> t, r), LACo.co.and_l(LawsBase.wire_fits(List.length(&2, Mod.Blk, x <> t)), CodemodeModelsEntry.blks_all(x <> t), h))) : {Wr.get_list.start(~Mod.Blk, ~FMod.get_blk, _) == Wr.Got{x <> t, r} : Wr.Dec<List<&2, Mod.Blk>>}
      cmq.bl.go_rt(t, x, r, LACo.co.and_r(LawsBase.wire_fits(List.length(&2, Mod.Blk, x <> t)), CodemodeModelsEntry.blks_all(x <> t), h))

# ---- q ----

def cmq.q(v: Mod.Q, +rest: String, +h: {CodemodeModelsEntry.q_fits(v) == True{} : Bool}) -> {FMod.get_q(CodemodeModelsEntry.spell_q(v, rest)) == Wr.Got{v, rest} : Wr.Dec<Mod.Q>}:
  match v:
    case Mod.Q{+id, +q, +ins, +kind, +json, +c, +vs, +yes, +no}:
      +h_id = LACo.co.and_l(CodemodeModelsEntry.str_fits(id), Bool.and(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))))), h)
      +hr_id = LACo.co.and_r(CodemodeModelsEntry.str_fits(id), Bool.and(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))))), h)
      +h_q = LACo.co.and_l(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))))), hr_id)
      +hr_q = LACo.co.and_r(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))))), hr_id)
      +h_ins = LACo.co.and_l(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))), hr_q)
      +hr_ins = LACo.co.and_r(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))), hr_q)
      +h_kind = LACo.co.and_l(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))), hr_ins)
      +hr_kind = LACo.co.and_r(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))), hr_ins)
      +h_json = LACo.co.and_l(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))), hr_kind)
      +hr_json = LACo.co.and_r(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))), hr_kind)
      +h_c = LACo.co.and_l(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))), hr_json)
      +hr_c = LACo.co.and_r(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))), hr_json)
      +h_vs = LACo.co.and_l(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)), hr_c)
      +hr_vs = LACo.co.and_r(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)), hr_c)
      +h_yes = LACo.co.and_l(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no), hr_vs)
      +hr_yes = LACo.co.and_r(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no), hr_vs)
      +h_no = hr_yes
      %Equal.sym(Wr.Dec<String>, Wr.get_str(Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))))))), Wr.Got{id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))))))}, Wire.wire_str_round_trip(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))))), h_id)) : {FMod.get_q.id(_) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))))))), Wr.Got{q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))))}, cmq.desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))))), h_q)) : {FMod.get_q.q(id, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))))), Wr.Got{ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))))}, cmq.desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))), h_ins)) : {FMod.get_q.ins(id, q, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Txt>, FMod.get_txt(CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))))), Wr.Got{kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))}, cmq.txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))), h_kind)) : {FMod.get_q.kind(id, q, ins, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<String>, Wr.get_str(Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))))), Wr.Got{json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))}, Wire.wire_str_round_trip(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))), h_json)) : {FMod.get_q.json(id, q, ins, kind, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))))), Wr.Got{c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))}, cmq.desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))), h_c)) : {FMod.get_q.criteria(id, q, ins, kind, json, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<List<&2, Mod.Desc>>, Wr.get_list(~Mod.Desc, ~FMod.get_desc, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)))), Wr.Got{vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))}, cmq.dl.rt(vs, CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest)), h_vs)) : {FMod.get_q.values(id, q, ins, kind, json, c, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(yes, CodemodeModelsEntry.spell_desc(no, rest))), Wr.Got{yes, CodemodeModelsEntry.spell_desc(no, rest)}, cmq.desc(yes, CodemodeModelsEntry.spell_desc(no, rest), h_yes)) : {FMod.get_q.yes(id, q, ins, kind, json, c, vs, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(no, rest)), Wr.Got{no, rest}, cmq.desc(no, rest, h_no)) : {FMod.get_q.no(id, q, ins, kind, json, c, vs, yes, _) == Wr.Got{Mod.Q{id, q, ins, kind, json, c, vs, yes, no}, rest} : Wr.Dec<Mod.Q>}
      {==}

# ---- lists of Mod.Q ----

def cmq.ql.go_rt(+t: List<&2, Mod.Q>, +x: Mod.Q, +rest: String, +h: {CodemodeModelsEntry.qs_all(x <> t) == True{} : Bool}) -> {Wr.get_list.go(~Mod.Q, ~FMod.get_q, List.length(&2, Mod.Q, t), FMod.get_q(CodemodeModelsEntry.spell_q(x, CodemodeModelsEntry.spell_qs.items(t, rest)))) == Wr.Got{x <> t, rest} : Wr.Dec<List<&2, Mod.Q>>}:
  match t:
    case Nil{}:
      %Equal.sym(Wr.Dec<Mod.Q>, FMod.get_q(CodemodeModelsEntry.spell_q(x, rest)), Wr.Got{x, rest}, cmq.q(x, rest, LACo.co.and_l(CodemodeModelsEntry.q_fits(x), CodemodeModelsEntry.qs_all([]), h))) : {Wr.get_list.go(~Mod.Q, ~FMod.get_q, 0n, _) == Wr.Got{[x], rest} : Wr.Dec<List<&2, Mod.Q>>}
      {==}
    case Con{+y, +u}:
      +r2 = CodemodeModelsEntry.spell_q(y, CodemodeModelsEntry.spell_qs.items(u, rest))
      %Equal.sym(Wr.Dec<Mod.Q>, FMod.get_q(CodemodeModelsEntry.spell_q(x, r2)), Wr.Got{x, r2}, cmq.q(x, r2, LACo.co.and_l(CodemodeModelsEntry.q_fits(x), CodemodeModelsEntry.qs_all(y <> u), h))) : {Wr.get_list.go(~Mod.Q, ~FMod.get_q, 1n+List.length(&2, Mod.Q, u), _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Q>>}
      %Equal.sym(Wr.Dec<List<&2, Mod.Q>>, Wr.get_list.go(~Mod.Q, ~FMod.get_q, List.length(&2, Mod.Q, u), FMod.get_q(r2)), Wr.Got{y <> u, rest}, cmq.ql.go_rt(u, y, rest, LACo.co.and_r(CodemodeModelsEntry.q_fits(x), CodemodeModelsEntry.qs_all(y <> u), h))) : {Wr.get_list.cons(Mod.Q, x, _) == Wr.Got{x <> y <> u, rest} : Wr.Dec<List<&2, Mod.Q>>}
      {==}

def cmq.ql.rt(+xs: List<&2, Mod.Q>, +r: String, +h: {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Q, xs)), CodemodeModelsEntry.qs_all(xs)) == True{} : Bool}) -> {Wr.get_list(~Mod.Q, ~FMod.get_q, Wr.put_nat(List.length(&2, Mod.Q, xs), CodemodeModelsEntry.spell_qs.items(xs, r))) == Wr.Got{xs, r} : Wr.Dec<List<&2, Mod.Q>>}:
  match xs:
    case Nil{}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(0n, r)), Wr.Got{0n, r}, Wire.wire_nat_round_trip(0n, r, {==})) : {Wr.get_list.start(~Mod.Q, ~FMod.get_q, _) == Wr.Got{Nil{}, r} : Wr.Dec<List<&2, Mod.Q>>}
      {==}
    case Con{+x, +t}:
      %Equal.sym(Wr.Dec<Nat>, Wr.get_nat(Wr.put_nat(List.length(&2, Mod.Q, x <> t), CodemodeModelsEntry.spell_qs.items(x <> t, r))), Wr.Got{List.length(&2, Mod.Q, x <> t), CodemodeModelsEntry.spell_qs.items(x <> t, r)}, Wire.wire_nat_round_trip(List.length(&2, Mod.Q, x <> t), CodemodeModelsEntry.spell_qs.items(x <> t, r), LACo.co.and_l(LawsBase.wire_fits(List.length(&2, Mod.Q, x <> t)), CodemodeModelsEntry.qs_all(x <> t), h))) : {Wr.get_list.start(~Mod.Q, ~FMod.get_q, _) == Wr.Got{x <> t, r} : Wr.Dec<List<&2, Mod.Q>>}
      cmq.ql.go_rt(t, x, r, LACo.co.and_r(LawsBase.wire_fits(List.length(&2, Mod.Q, x <> t)), CodemodeModelsEntry.qs_all(x <> t), h))

# ---- requests ----

# a spelled request whose numbers fit reads back
def cmq.req(q: FMod.Req, +rest: String, +h: {CodemodeModelsEntry.req_fits(q) == True{} : Bool}) -> {FMod.get_req(CodemodeModelsEntry.spell_req(q, rest)) == Wr.Got{q, rest} : Wr.Dec<FMod.Req>}:
  match q:
    case FMod.QClassify{x}:
      match x:
        case Mod.Ctx{+c, +st, +im, +bs, +qd, +qs}:
          +h_c = LACo.co.and_l(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.desc_fits(st), Bool.and(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs))))), h)
          +hr_c = LACo.co.and_r(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.desc_fits(st), Bool.and(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs))))), h)
          +h_st = LACo.co.and_l(CodemodeModelsEntry.desc_fits(st), Bool.and(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs)))), hr_c)
          +hr_st = LACo.co.and_r(CodemodeModelsEntry.desc_fits(st), Bool.and(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs)))), hr_c)
          +h_im = LACo.co.and_l(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs))), hr_st)
          +hr_im = LACo.co.and_r(CodemodeModelsEntry.desc_fits(im), Bool.and(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs))), hr_st)
          +h_bs = LACo.co.and_l(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs)), hr_im)
          +hr_bs = LACo.co.and_r(CodemodeModelsEntry.blks_fit(bs), Bool.and(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs)), hr_im)
          +h_qd = LACo.co.and_l(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs), hr_bs)
          +hr_qd = LACo.co.and_r(CodemodeModelsEntry.desc_fits(qd), CodemodeModelsEntry.qs_fit(qs), hr_bs)
          +h_qs = hr_qd
          %LACoRead.cot.nat(0n, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))))), {==}) : {FMod.get_req.tag(_) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))))))), Wr.Got{c, CodemodeModelsEntry.spell_desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))))}, cmq.desc(c, CodemodeModelsEntry.spell_desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))))), h_c)) : {FMod.get_classify(_) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))))), Wr.Got{st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))))}, cmq.desc(st, CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))), h_st)) : {FMod.get_classify.state(c, _) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))))), Wr.Got{im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))}, cmq.desc(im, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))), h_im)) : {FMod.get_classify.images(c, st, _) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<List<&2, Mod.Blk>>, Wr.get_list(~Mod.Blk, ~FMod.get_blk, CodemodeModelsEntry.spell_blks(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)))), Wr.Got{bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))}, cmq.bl.rt(bs, CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest)), h_bs)) : {FMod.get_classify.blocks(c, st, im, _) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(qd, CodemodeModelsEntry.spell_qs(qs, rest))), Wr.Got{qd, CodemodeModelsEntry.spell_qs(qs, rest)}, cmq.desc(qd, CodemodeModelsEntry.spell_qs(qs, rest), h_qd)) : {FMod.get_classify.questions(c, st, im, bs, _) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<List<&2, Mod.Q>>, Wr.get_list(~Mod.Q, ~FMod.get_q, CodemodeModelsEntry.spell_qs(qs, rest)), Wr.Got{qs, rest}, cmq.ql.rt(qs, rest, h_qs)) : {FMod.get_classify.qs(c, st, im, bs, qd, _) == Wr.Got{FMod.QClassify{Mod.Ctx{c, st, im, bs, qd, qs}}, rest} : Wr.Dec<FMod.Req>}
          {==}
    case FMod.QImages{x}:
      match x:
        case Mod.ICtx{+c, +i, +bs}:
          +h_c = LACo.co.and_l(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.desc_fits(i), CodemodeModelsEntry.blks_fit(bs)), h)
          +hr_c = LACo.co.and_r(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.desc_fits(i), CodemodeModelsEntry.blks_fit(bs)), h)
          +h_i = LACo.co.and_l(CodemodeModelsEntry.desc_fits(i), CodemodeModelsEntry.blks_fit(bs), hr_c)
          +hr_i = LACo.co.and_r(CodemodeModelsEntry.desc_fits(i), CodemodeModelsEntry.blks_fit(bs), hr_c)
          +h_bs = hr_i
          %LACoRead.cot.nat(1n, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_desc(i, CodemodeModelsEntry.spell_blks(bs, rest))), {==}) : {FMod.get_req.tag(_) == Wr.Got{FMod.QImages{Mod.ICtx{c, i, bs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_desc(i, CodemodeModelsEntry.spell_blks(bs, rest)))), Wr.Got{c, CodemodeModelsEntry.spell_desc(i, CodemodeModelsEntry.spell_blks(bs, rest))}, cmq.desc(c, CodemodeModelsEntry.spell_desc(i, CodemodeModelsEntry.spell_blks(bs, rest)), h_c)) : {FMod.get_images(_) == Wr.Got{FMod.QImages{Mod.ICtx{c, i, bs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<Mod.Desc>, FMod.get_desc(CodemodeModelsEntry.spell_desc(i, CodemodeModelsEntry.spell_blks(bs, rest))), Wr.Got{i, CodemodeModelsEntry.spell_blks(bs, rest)}, cmq.desc(i, CodemodeModelsEntry.spell_blks(bs, rest), h_i)) : {FMod.get_images.input(c, _) == Wr.Got{FMod.QImages{Mod.ICtx{c, i, bs}}, rest} : Wr.Dec<FMod.Req>}
          %Equal.sym(Wr.Dec<List<&2, Mod.Blk>>, Wr.get_list(~Mod.Blk, ~FMod.get_blk, CodemodeModelsEntry.spell_blks(bs, rest)), Wr.Got{bs, rest}, cmq.bl.rt(bs, rest, h_bs)) : {FMod.get_images.blocks(c, i, _) == Wr.Got{FMod.QImages{Mod.ICtx{c, i, bs}}, rest} : Wr.Dec<FMod.Req>}
          {==}
    case FMod.QResolve{x}:
      match x:
        case Mod.Res{+c, +d, +m, +p, +i, +fc, +fi, +fk}:
          +h_m = LACo.co.and_l(CodemodeModelsEntry.desc_fits(m), Bool.and(CodemodeModelsEntry.txt_fits(p), CodemodeModelsEntry.txt_fits(i)), h)
          +hr_m = LACo.co.and_r(CodemodeModelsEntry.desc_fits(m), Bool.and(CodemodeModelsEntry.txt_fits(p), CodemodeModelsEntry.txt_fits(i)), h)
          +h_p = LACo.co.and_l(CodemodeModelsEntry.txt_fits(p), CodemodeModelsEntry.txt_fits(i), hr_m)
