      (e1, g_vs) = pp
      cme.q.s7(s, s7, id, q, ins, kind, json, c, vs, cme.under(s, s6, CodemodeModelsEntry.spell_descs(vs, s7), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, y)))))), e0, e1), g_id, g_q, g_ins, g_kind, g_json, g_c, g_vs, FMod.get_desc(s7), cme.desc(s7))
