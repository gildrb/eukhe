def cme.q.s6(-s: String, -s6: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, +kind: Mod.Txt, +json: String, +c: Mod.Desc, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, s6)))))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, g_kind: {CodemodeModelsEntry.txt_fits(kind) == True{} : Bool}, g_json: {CodemodeModelsEntry.str_fits(json) == True{} : Bool}, g_c: {CodemodeModelsEntry.desc_fits(c) == True{} : Bool}, dd: Wr.Dec<List<&2, Mod.Desc>>, pp: cme.dl.LS(s6, dd)) -> cme.RQ1(s, FMod.get_q.values(id, q, ins, kind, json, c, dd)):
  match dd:
