    case Wr.Got{+no, +s9}:
      (e1, g_no) = pp
      (cme.under(s, s8, CodemodeModelsEntry.spell_desc(no, s9), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, y)))))))), e0, e1), LACo.co.and_tt(CodemodeModelsEntry.str_fits(id), Bool.and(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))))), g_id, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(q), Bool.and(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))))), g_q, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(ins), Bool.and(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))))), g_ins, LACo.co.and_tt(CodemodeModelsEntry.txt_fits(kind), Bool.and(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))))), g_kind, LACo.co.and_tt(CodemodeModelsEntry.str_fits(json), Bool.and(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)))), g_json, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(c), Bool.and(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no))), g_c, LACo.co.and_tt(CodemodeModelsEntry.descs_fit(vs), Bool.and(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no)), g_vs, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(yes), CodemodeModelsEntry.desc_fits(no), g_yes, g_no)))))))))
    case Wr.Bad{}:
      Unit{}

def cme.q.s7(-s: String, -s7: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, +kind: Mod.Txt, +json: String, +c: Mod.Desc, +vs: List<&2, Mod.Desc>, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, s7))))))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, g_kind: {CodemodeModelsEntry.txt_fits(kind) == True{} : Bool}, g_json: {CodemodeModelsEntry.str_fits(json) == True{} : Bool}, g_c: {CodemodeModelsEntry.desc_fits(c) == True{} : Bool}, g_vs: {CodemodeModelsEntry.descs_fit(vs) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s7, dd)) -> cme.RQ1(s, FMod.get_q.yes(id, q, ins, kind, json, c, vs, dd)):
