# eukhe: lemmas of the entry proofs of area codemode_models: only spelled
# values decode (generated by the scratch gen_entry.py)
#
# Each decoder of bend/ffi_codemode_models.bend answers Got only for the
# spec's spelling of a value whose numbers fit (Nats and Bools:
# proof/context_order/base/exact.bend; strings: wire_str_exact,
# wire_str_decoded_fits; lists of strings: wire_strs_exact,
# wire_strs_decoded_fit).

import Base
import ../../../bend/codemode_models.bend as Mod
import ../../../bend/ffi_codemode_models.bend as FMod
import ../../../bend/wire.bend as Wr
import ../../../laws/base.bend as LawsBase
import ../../../laws/wire.bend as Wire
import ../../../laws/codemode_models/entry.bend as CodemodeModelsEntry
import ../../context_order/base.bend as LACo
import ../../context_order/base/exact.bend as LACoExact

def cme.under(-s: String, -s1: String, -y: String, -f: String -> String, e: {s == f(s1) : String}, p: {s1 == y : String}) -> {s == f(y) : String}:
  %p : {s == f(_) : String}
  e

# ---- strings ----

def cme.PS(s: String, d: Wr.Dec<String>) -> Type:
  match d:
    case Wr.Got{+a, r}:
      {s == Wr.put_str(a, r) : String} & {CodemodeModelsEntry.str_fits(a) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.ps_go(+s: String, d: Wr.Dec<String>, +ed: {Wr.get_str(s) == d : Wr.Dec<String>}) -> cme.PS(s, d):
  match d:
    case Wr.Got{+a, +r}:
      (Wire.wire_str_exact(s, a, r, ed), Wire.wire_str_decoded_fits(s, a, r, ed))
    case Wr.Bad{}:
      Unit{}

def cme.str(+s: String) -> cme.PS(s, Wr.get_str(s)):
  cme.ps_go(s, Wr.get_str(s), {==})

def cme.PL(s: String, d: Wr.Dec<List<&2, String>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == LawsBase.wire_spell_strs(xs, r) : String} & {LawsBase.wire_strs_fit(xs) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.pl_go(+s: String, d: Wr.Dec<List<&2, String>>, +ed: {Wr.get_list(~String, ~Wr.get_str, s) == d : Wr.Dec<List<&2, String>>}) -> cme.PL(s, d):
  match d:
    case Wr.Got{+xs, +r}:
      (Wire.wire_strs_exact(s, xs, r, ed), Wire.wire_strs_decoded_fit(s, xs, r, ed))
    case Wr.Bad{}:
      Unit{}

def cme.pl(+s: String) -> cme.PL(s, Wr.get_list(~String, ~Wr.get_str, s)):
  cme.pl_go(s, Wr.get_list(~String, ~Wr.get_str, s), {==})

# ---- values ----

def cme.PD(s: String, d: Wr.Dec<Mod.Desc>) -> Type:
  match d:
    case Wr.Got{+x, r}:
      {s == CodemodeModelsEntry.spell_desc(x, r) : String} & {CodemodeModelsEntry.desc_fits(x) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.dg.empty(-s: String, -s1: String, e0: {s == Wr.put_nat(5n, s1) : String}, d: Wr.Dec<Bool>, p: LACoExact.coe.PB(s1, d)) -> cme.PD(s, FMod.get_desc.empty(d)):
  match d:
    case Wr.Got{+e, +r}:
      (cme.under(s, s1, Wr.put_bool(e, r), y => Wr.put_nat(5n, y), e0, p), {==})
    case Wr.Bad{}:
      Unit{}

def cme.dg.keys(-s: String, -s1: String, e0: {s == Wr.put_nat(6n, s1) : String}, d: Wr.Dec<List<&2, String>>, p: cme.PL(s1, d)) -> cme.PD(s, FMod.get_desc.keys(d)):
  match d:
    case Wr.Got{+ks, +r}:
      (e1, f1) = p
      (cme.under(s, s1, LawsBase.wire_spell_strs(ks, r), y => Wr.put_nat(6n, y), e0, e1), f1)
    case Wr.Bad{}:
      Unit{}

def cme.dg.tag(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.PD(s, FMod.get_desc.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          (e0, {==})
        case 1n:
          (e0, f0) = p
          (e0, {==})
        case 2n:
          (e0, f0) = p
          (e0, {==})
        case 3n:
          (e0, f0) = p
          (e0, {==})
        case 4n:
          (e0, f0) = p
          (e0, {==})
        case 5n:
          (e0, f0) = p
          cme.dg.empty(s, s1, e0, Wr.get_bool(s1), LACoExact.coe.pb(s1))
        case 6n:
          (e0, f0) = p
          cme.dg.keys(s, s1, e0, Wr.get_list(~String, ~Wr.get_str, s1), cme.pl(s1))
        case 7n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

def cme.desc(+s: String) -> cme.PD(s, FMod.get_desc(s)):
  cme.dg.tag(s, Wr.get_nat(s), LACoExact.coe.pnf(s))

def cme.PT(s: String, d: Wr.Dec<Mod.Txt>) -> Type:
  match d:
    case Wr.Got{+x, r}:
      {s == CodemodeModelsEntry.spell_txt(x, r) : String} & {CodemodeModelsEntry.txt_fits(x) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.tg.text(-s: String, -s1: String, e0: {s == Wr.put_nat(1n, s1) : String}, d: Wr.Dec<String>, p: cme.PS(s1, d)) -> cme.PT(s, FMod.get_txt.text(d)):
  match d:
    case Wr.Got{+a, +r}:
      (e1, f1) = p
      (cme.under(s, s1, Wr.put_str(a, r), y => Wr.put_nat(1n, y), e0, e1), f1)
    case Wr.Bad{}:
      Unit{}

def cme.tg.tag(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.PT(s, FMod.get_txt.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          (e0, {==})
        case 1n:
          (e0, f0) = p
          cme.tg.text(s, s1, e0, Wr.get_str(s1), cme.str(s1))
        case 2n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

def cme.txt(+s: String) -> cme.PT(s, FMod.get_txt(s)):
  cme.tg.tag(s, Wr.get_nat(s), LACoExact.coe.pnf(s))

def cme.PC(s: String, d: Wr.Dec<Mod.Call>) -> Type:
  match d:
    case Wr.Got{+x, r}:
      {s == CodemodeModelsEntry.spell_call(x, r) : String}
    case Wr.Bad{}:
      Unit

def cme.cg.tag(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.PC(s, FMod.get_call.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          e0
        case 1n:
          (e0, f0) = p
          e0
        case 2n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

def cme.call(+s: String) -> cme.PC(s, FMod.get_call(s)):
  cme.cg.tag(s, Wr.get_nat(s), LACoExact.coe.pnf(s))

def cme.PM(s: String, d: Wr.Dec<Mod.MType>) -> Type:
  match d:
    case Wr.Got{+x, r}:
      {s == CodemodeModelsEntry.spell_mtype(x, r) : String}
    case Wr.Bad{}:
      Unit

def cme.mg.tag(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.PM(s, FMod.get_mtype.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          e0
        case 1n:
          (e0, f0) = p
          e0
        case 2n:
          (e0, f0) = p
          e0
        case 3n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

def cme.mtype(+s: String) -> cme.PM(s, FMod.get_mtype(s)):
  cme.mg.tag(s, Wr.get_nat(s), LACoExact.coe.pnf(s))

def cme.PF(s: String, d: Wr.Dec<Maybe<&2, Mod.MType>>) -> Type:
  match d:
    case Wr.Got{+x, r}:
      {s == CodemodeModelsEntry.spell_found(x, r) : String}
    case Wr.Bad{}:
      Unit

def cme.fg.some(-s: String, -s1: String, e0: {s == Wr.put_nat(1n, s1) : String}, d: Wr.Dec<Mod.MType>, p: cme.PM(s1, d)) -> cme.PF(s, FMod.get_found.some(d)):
  match d:
    case Wr.Got{+t, +r}:
      cme.under(s, s1, CodemodeModelsEntry.spell_mtype(t, r), y => Wr.put_nat(1n, y), e0, p)
    case Wr.Bad{}:
      Unit{}

def cme.fg.tag(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.PF(s, FMod.get_found.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          e0
        case 1n:
          (e0, f0) = p
          cme.fg.some(s, s1, e0, FMod.get_mtype(s1), cme.mtype(s1))
        case 2n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

def cme.found(+s: String) -> cme.PF(s, FMod.get_found(s)):
  cme.fg.tag(s, Wr.get_nat(s), LACoExact.coe.pnf(s))

# ---- lists of Mod.Desc ----

def cme.dl.PL(s: String, m: Nat, d: Wr.Dec<List<&2, Mod.Desc>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == CodemodeModelsEntry.spell_descs.items(xs, r) : String} & ({List.length(&2, Mod.Desc, xs) == 1n+m : Nat} & {CodemodeModelsEntry.descs_all(xs) == True{} : Bool})
    case Wr.Bad{}:
      Unit

def cme.dl.step(-s: String, +x: Mod.Desc, +s3: String, -k: Nat, ex: {s == CodemodeModelsEntry.spell_desc(x, s3) : String}, fx: {CodemodeModelsEntry.desc_fits(x) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Desc>>, ih: cme.dl.PL(s3, k, d)) -> cme.dl.PL(s, 1n+k, Wr.get_list.cons(Mod.Desc, x, d)):
  match d:
    case Wr.Got{+ys, +r}:
      (e1, rest) = ih
      (e2, e3) = rest
      (cme.under(s, s3, CodemodeModelsEntry.spell_descs.items(ys, r), y => CodemodeModelsEntry.spell_desc(x, y), ex, e1), (Equal.cong(Nat, Nat, k2 => 1n+k2, List.length(&2, Mod.Desc, ys), 1n+k, e2), LACo.co.and_tt(CodemodeModelsEntry.desc_fits(x), CodemodeModelsEntry.descs_all(ys), fx, e3)))
    case Wr.Bad{}:
      Unit{}

def cme.dl.loop(m: Nat, cur: Wr.Dec<Mod.Desc>, +s: String, pc: cme.PD(s, cur)) -> cme.dl.PL(s, m, Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, m, cur)):
  match m cur:
    case 0n Wr.Got{+x, +s3}:
      (e, f) = pc
      (e, ({==}, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(x), True{}, f, {==})))
    case 0n Wr.Bad{}:
      Unit{}
    case 1n++k Wr.Got{+x, +s3}:
      (e, f) = pc
      cme.dl.step(s, x, s3, k, e, f, Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, k, FMod.get_desc(s3)), cme.dl.loop(k, FMod.get_desc(s3), s3, cme.desc(s3)))
    case 1n++k Wr.Bad{}:
      Unit{}

def cme.dl.LS(s: String, d: Wr.Dec<List<&2, Mod.Desc>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == Wr.put_nat(List.length(&2, Mod.Desc, xs), CodemodeModelsEntry.spell_descs.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Desc, xs)), CodemodeModelsEntry.descs_all(xs)) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.dl.conv(-s: String, -s2: String, +m: Nat, en: {s == Wr.put_nat(1n+m, s2) : String}, fn: {LawsBase.wire_fits(1n+m) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Desc>>, pl: cme.dl.PL(s2, m, d)) -> cme.dl.LS(s, d):
  match d:
    case Wr.Got{+xs, +r}:
      (e1, rest) = pl
      (+e2, e3) = rest
      %Equal.sym(Nat, List.length(&2, Mod.Desc, xs), 1n+m, e2) : {s == Wr.put_nat(_, CodemodeModelsEntry.spell_descs.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(_), CodemodeModelsEntry.descs_all(xs)) == True{} : Bool}
      (cme.under(s, s2, CodemodeModelsEntry.spell_descs.items(xs, r), y => Wr.put_nat(1n+m, y), en, e1), LACo.co.and_tt(LawsBase.wire_fits(1n+m), CodemodeModelsEntry.descs_all(xs), fn, e3))
    case Wr.Bad{}:
      Unit{}

def cme.dl.nat(-s: String, n: Nat, +s2: String, en: {s == Wr.put_nat(n, s2) : String}, fn: {LawsBase.wire_fits(n) == True{} : Bool}) -> cme.dl.LS(s, Wr.get_list.start(~Mod.Desc, ~FMod.get_desc, Wr.Got{n, s2})):
  match n:
    case 0n:
      (en, {==})
    case 1n++m:
      cme.dl.conv(s, s2, m, en, fn, Wr.get_list.go(~Mod.Desc, ~FMod.get_desc, m, FMod.get_desc(s2)), cme.dl.loop(m, FMod.get_desc(s2), s2, cme.desc(s2)))

def cme.dl.top(+s: String, d: Wr.Dec<Nat>, ed: {Wr.get_nat(s) == d : Wr.Dec<Nat>}) -> cme.dl.LS(s, Wr.get_list.start(~Mod.Desc, ~FMod.get_desc, d)):
  match d:
    case Wr.Got{+n, +s2}:
      +e = ed
      cme.dl.nat(s, n, s2, Wire.wire_nat_exact(s, n, s2, e), Wire.wire_nat_decoded_fits(s, n, s2, e))
    case Wr.Bad{}:
      Unit{}

def cme.dl.list(+s: String) -> cme.dl.LS(s, Wr.get_list(~Mod.Desc, ~FMod.get_desc, s)):
  cme.dl.top(s, Wr.get_nat(s), {==})

# ---- blk ----

def cme.RBLK(s: String, d: Wr.Dec<Mod.Blk>) -> Type:
  match d:
    case Wr.Got{+x, rr}:
      {s == CodemodeModelsEntry.spell_blk(x, rr) : String} & {CodemodeModelsEntry.blk_fits(x) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.blk.s4(-s: String, -s4: String, +k: Mod.Desc, +t: Mod.Txt, +x: Mod.Desc, +d: Mod.Desc, e0: {s == CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, s4)))) : String}, g_k: {CodemodeModelsEntry.desc_fits(k) == True{} : Bool}, g_t: {CodemodeModelsEntry.txt_fits(t) == True{} : Bool}, g_x: {CodemodeModelsEntry.desc_fits(x) == True{} : Bool}, g_d: {CodemodeModelsEntry.desc_fits(d) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s4, dd)) -> cme.RBLK(s, FMod.get_blk.mime(k, t, x, d, dd)):
  match dd:
    case Wr.Got{+m, +s5}:
      (e1, g_m) = pp
      (cme.under(s, s4, CodemodeModelsEntry.spell_desc(m, s5), y => CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, CodemodeModelsEntry.spell_desc(d, y)))), e0, e1), LACo.co.and_tt(CodemodeModelsEntry.desc_fits(k), Bool.and(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)))), g_k, LACo.co.and_tt(CodemodeModelsEntry.txt_fits(t), Bool.and(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m))), g_t, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(x), Bool.and(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m)), g_x, LACo.co.and_tt(CodemodeModelsEntry.desc_fits(d), CodemodeModelsEntry.desc_fits(m), g_d, g_m)))))
    case Wr.Bad{}:
      Unit{}

def cme.blk.s3(-s: String, -s3: String, +k: Mod.Desc, +t: Mod.Txt, +x: Mod.Desc, e0: {s == CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, s3))) : String}, g_k: {CodemodeModelsEntry.desc_fits(k) == True{} : Bool}, g_t: {CodemodeModelsEntry.txt_fits(t) == True{} : Bool}, g_x: {CodemodeModelsEntry.desc_fits(x) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s3, dd)) -> cme.RBLK(s, FMod.get_blk.data(k, t, x, dd)):
  match dd:
    case Wr.Got{+d, +s4}:
      (e1, g_d) = pp
      cme.blk.s4(s, s4, k, t, x, d, cme.under(s, s3, CodemodeModelsEntry.spell_desc(d, s4), y => CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, CodemodeModelsEntry.spell_desc(x, y))), e0, e1), g_k, g_t, g_x, g_d, FMod.get_desc(s4), cme.desc(s4))
    case Wr.Bad{}:
      Unit{}

def cme.blk.s2(-s: String, -s2: String, +k: Mod.Desc, +t: Mod.Txt, e0: {s == CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, s2)) : String}, g_k: {CodemodeModelsEntry.desc_fits(k) == True{} : Bool}, g_t: {CodemodeModelsEntry.txt_fits(t) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s2, dd)) -> cme.RBLK(s, FMod.get_blk.text(k, t, dd)):
  match dd:
    case Wr.Got{+x, +s3}:
      (e1, g_x) = pp
      cme.blk.s3(s, s3, k, t, x, cme.under(s, s2, CodemodeModelsEntry.spell_desc(x, s3), y => CodemodeModelsEntry.spell_desc(k, CodemodeModelsEntry.spell_txt(t, y)), e0, e1), g_k, g_t, g_x, FMod.get_desc(s3), cme.desc(s3))
    case Wr.Bad{}:
      Unit{}

def cme.blk.s1(-s: String, -s1: String, +k: Mod.Desc, e0: {s == CodemodeModelsEntry.spell_desc(k, s1) : String}, g_k: {CodemodeModelsEntry.desc_fits(k) == True{} : Bool}, dd: Wr.Dec<Mod.Txt>, pp: cme.PT(s1, dd)) -> cme.RBLK(s, FMod.get_blk.kind(k, dd)):
  match dd:
    case Wr.Got{+t, +s2}:
      (e1, g_t) = pp
      cme.blk.s2(s, s2, k, t, cme.under(s, s1, CodemodeModelsEntry.spell_txt(t, s2), y => CodemodeModelsEntry.spell_desc(k, y), e0, e1), g_k, g_t, FMod.get_desc(s2), cme.desc(s2))
    case Wr.Bad{}:
      Unit{}

def cme.blk.s0(-s: String, -s0: String, e0: {s == s0 : String}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s0, dd)) -> cme.RBLK(s, FMod.get_blk.block(dd)):
  match dd:
    case Wr.Got{+k, +s1}:
      (e1, g_k) = pp
      cme.blk.s1(s, s1, k, cme.under(s, s0, CodemodeModelsEntry.spell_desc(k, s1), y => y, e0, e1), g_k, FMod.get_txt(s1), cme.txt(s1))
    case Wr.Bad{}:
      Unit{}

def cme.blk(+s: String) -> cme.RBLK(s, FMod.get_blk(s)):
  cme.blk.s0(s, s, {==}, FMod.get_desc(s), cme.desc(s))

# ---- lists of Mod.Blk ----

def cme.bl.PL(s: String, m: Nat, d: Wr.Dec<List<&2, Mod.Blk>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == CodemodeModelsEntry.spell_blks.items(xs, r) : String} & ({List.length(&2, Mod.Blk, xs) == 1n+m : Nat} & {CodemodeModelsEntry.blks_all(xs) == True{} : Bool})
    case Wr.Bad{}:
      Unit

def cme.bl.step(-s: String, +x: Mod.Blk, +s3: String, -k: Nat, ex: {s == CodemodeModelsEntry.spell_blk(x, s3) : String}, fx: {CodemodeModelsEntry.blk_fits(x) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Blk>>, ih: cme.bl.PL(s3, k, d)) -> cme.bl.PL(s, 1n+k, Wr.get_list.cons(Mod.Blk, x, d)):
  match d:
    case Wr.Got{+ys, +r}:
      (e1, rest) = ih
      (e2, e3) = rest
      (cme.under(s, s3, CodemodeModelsEntry.spell_blks.items(ys, r), y => CodemodeModelsEntry.spell_blk(x, y), ex, e1), (Equal.cong(Nat, Nat, k2 => 1n+k2, List.length(&2, Mod.Blk, ys), 1n+k, e2), LACo.co.and_tt(CodemodeModelsEntry.blk_fits(x), CodemodeModelsEntry.blks_all(ys), fx, e3)))
    case Wr.Bad{}:
      Unit{}

def cme.bl.loop(m: Nat, cur: Wr.Dec<Mod.Blk>, +s: String, pc: cme.RBLK(s, cur)) -> cme.bl.PL(s, m, Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, m, cur)):
  match m cur:
    case 0n Wr.Got{+x, +s3}:
      (e, f) = pc
      (e, ({==}, LACo.co.and_tt(CodemodeModelsEntry.blk_fits(x), True{}, f, {==})))
    case 0n Wr.Bad{}:
      Unit{}
    case 1n++k Wr.Got{+x, +s3}:
      (e, f) = pc
      cme.bl.step(s, x, s3, k, e, f, Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, k, FMod.get_blk(s3)), cme.bl.loop(k, FMod.get_blk(s3), s3, cme.blk(s3)))
    case 1n++k Wr.Bad{}:
      Unit{}

def cme.bl.LS(s: String, d: Wr.Dec<List<&2, Mod.Blk>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == Wr.put_nat(List.length(&2, Mod.Blk, xs), CodemodeModelsEntry.spell_blks.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Blk, xs)), CodemodeModelsEntry.blks_all(xs)) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.bl.conv(-s: String, -s2: String, +m: Nat, en: {s == Wr.put_nat(1n+m, s2) : String}, fn: {LawsBase.wire_fits(1n+m) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Blk>>, pl: cme.bl.PL(s2, m, d)) -> cme.bl.LS(s, d):
  match d:
    case Wr.Got{+xs, +r}:
      (e1, rest) = pl
      (+e2, e3) = rest
      %Equal.sym(Nat, List.length(&2, Mod.Blk, xs), 1n+m, e2) : {s == Wr.put_nat(_, CodemodeModelsEntry.spell_blks.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(_), CodemodeModelsEntry.blks_all(xs)) == True{} : Bool}
      (cme.under(s, s2, CodemodeModelsEntry.spell_blks.items(xs, r), y => Wr.put_nat(1n+m, y), en, e1), LACo.co.and_tt(LawsBase.wire_fits(1n+m), CodemodeModelsEntry.blks_all(xs), fn, e3))
    case Wr.Bad{}:
      Unit{}

def cme.bl.nat(-s: String, n: Nat, +s2: String, en: {s == Wr.put_nat(n, s2) : String}, fn: {LawsBase.wire_fits(n) == True{} : Bool}) -> cme.bl.LS(s, Wr.get_list.start(~Mod.Blk, ~FMod.get_blk, Wr.Got{n, s2})):
  match n:
    case 0n:
      (en, {==})
    case 1n++m:
      cme.bl.conv(s, s2, m, en, fn, Wr.get_list.go(~Mod.Blk, ~FMod.get_blk, m, FMod.get_blk(s2)), cme.bl.loop(m, FMod.get_blk(s2), s2, cme.blk(s2)))

def cme.bl.top(+s: String, d: Wr.Dec<Nat>, ed: {Wr.get_nat(s) == d : Wr.Dec<Nat>}) -> cme.bl.LS(s, Wr.get_list.start(~Mod.Blk, ~FMod.get_blk, d)):
  match d:
    case Wr.Got{+n, +s2}:
      +e = ed
      cme.bl.nat(s, n, s2, Wire.wire_nat_exact(s, n, s2, e), Wire.wire_nat_decoded_fits(s, n, s2, e))
    case Wr.Bad{}:
      Unit{}

def cme.bl.list(+s: String) -> cme.bl.LS(s, Wr.get_list(~Mod.Blk, ~FMod.get_blk, s)):
  cme.bl.top(s, Wr.get_nat(s), {==})

# ---- q ----

def cme.RQ1(s: String, d: Wr.Dec<Mod.Q>) -> Type:
  match d:
    case Wr.Got{+x, rr}:
      {s == CodemodeModelsEntry.spell_q(x, rr) : String} & {CodemodeModelsEntry.q_fits(x) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.q.s8(-s: String, -s8: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, +kind: Mod.Txt, +json: String, +c: Mod.Desc, +vs: List<&2, Mod.Desc>, +yes: Mod.Desc, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, CodemodeModelsEntry.spell_desc(yes, s8)))))))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, g_kind: {CodemodeModelsEntry.txt_fits(kind) == True{} : Bool}, g_json: {CodemodeModelsEntry.str_fits(json) == True{} : Bool}, g_c: {CodemodeModelsEntry.desc_fits(c) == True{} : Bool}, g_vs: {CodemodeModelsEntry.descs_fit(vs) == True{} : Bool}, g_yes: {CodemodeModelsEntry.desc_fits(yes) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s8, dd)) -> cme.RQ1(s, FMod.get_q.no(id, q, ins, kind, json, c, vs, yes, dd)):
