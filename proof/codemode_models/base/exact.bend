def cme.q.s4(-s: String, -s4: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, +kind: Mod.Txt, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, s4)))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, g_kind: {CodemodeModelsEntry.txt_fits(kind) == True{} : Bool}, dd: Wr.Dec<String>, pp: cme.PS(s4, dd)) -> cme.RQ1(s, FMod.get_q.json(id, q, ins, kind, dd)):
  match dd:
    case Wr.Got{+json, +s5}:
      (e1, g_json) = pp
      cme.q.s5(s, s5, id, q, ins, kind, json, cme.under(s, s4, Wr.put_str(json, s5), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, y)))), e0, e1), g_id, g_q, g_ins, g_kind, g_json, FMod.get_desc(s5), cme.desc(s5))
    case Wr.Bad{}:
      Unit{}

def cme.q.s3(-s: String, -s3: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, s3))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, dd: Wr.Dec<Mod.Txt>, pp: cme.PT(s3, dd)) -> cme.RQ1(s, FMod.get_q.kind(id, q, ins, dd)):
  match dd:
    case Wr.Got{+kind, +s4}:
      (e1, g_kind) = pp
      cme.q.s4(s, s4, id, q, ins, kind, cme.under(s, s3, CodemodeModelsEntry.spell_txt(kind, s4), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, y))), e0, e1), g_id, g_q, g_ins, g_kind, Wr.get_str(s4), cme.str(s4))
    case Wr.Bad{}:
      Unit{}

def cme.q.s2(-s: String, -s2: String, +id: String, +q: Mod.Desc, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, s2)) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s2, dd)) -> cme.RQ1(s, FMod.get_q.ins(id, q, dd)):
  match dd:
    case Wr.Got{+ins, +s3}:
      (e1, g_ins) = pp
      cme.q.s3(s, s3, id, q, ins, cme.under(s, s2, CodemodeModelsEntry.spell_desc(ins, s3), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, y)), e0, e1), g_id, g_q, g_ins, FMod.get_txt(s3), cme.txt(s3))
    case Wr.Bad{}:
      Unit{}

def cme.q.s1(-s: String, -s1: String, +id: String, e0: {s == Wr.put_str(id, s1) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s1, dd)) -> cme.RQ1(s, FMod.get_q.q(id, dd)):
  match dd:
    case Wr.Got{+q, +s2}:
      (e1, g_q) = pp
      cme.q.s2(s, s2, id, q, cme.under(s, s1, CodemodeModelsEntry.spell_desc(q, s2), y => Wr.put_str(id, y), e0, e1), g_id, g_q, FMod.get_desc(s2), cme.desc(s2))
    case Wr.Bad{}:
      Unit{}

def cme.q.s0(-s: String, -s0: String, e0: {s == s0 : String}, dd: Wr.Dec<String>, pp: cme.PS(s0, dd)) -> cme.RQ1(s, FMod.get_q.id(dd)):
  match dd:
    case Wr.Got{+id, +s1}:
      (e1, g_id) = pp
      cme.q.s1(s, s1, id, cme.under(s, s0, Wr.put_str(id, s1), y => y, e0, e1), g_id, FMod.get_desc(s1), cme.desc(s1))
    case Wr.Bad{}:
      Unit{}

def cme.q(+s: String) -> cme.RQ1(s, FMod.get_q(s)):
  cme.q.s0(s, s, {==}, Wr.get_str(s), cme.str(s))

# ---- lists of Mod.Q ----

def cme.ql.PL(s: String, m: Nat, d: Wr.Dec<List<&2, Mod.Q>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == CodemodeModelsEntry.spell_qs.items(xs, r) : String} & ({List.length(&2, Mod.Q, xs) == 1n+m : Nat} & {CodemodeModelsEntry.qs_all(xs) == True{} : Bool})
    case Wr.Bad{}:
      Unit

def cme.ql.step(-s: String, +x: Mod.Q, +s3: String, -k: Nat, ex: {s == CodemodeModelsEntry.spell_q(x, s3) : String}, fx: {CodemodeModelsEntry.q_fits(x) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Q>>, ih: cme.ql.PL(s3, k, d)) -> cme.ql.PL(s, 1n+k, Wr.get_list.cons(Mod.Q, x, d)):
  match d:
    case Wr.Got{+ys, +r}:
      (e1, rest) = ih
      (e2, e3) = rest
      (cme.under(s, s3, CodemodeModelsEntry.spell_qs.items(ys, r), y => CodemodeModelsEntry.spell_q(x, y), ex, e1), (Equal.cong(Nat, Nat, k2 => 1n+k2, List.length(&2, Mod.Q, ys), 1n+k, e2), LACo.co.and_tt(CodemodeModelsEntry.q_fits(x), CodemodeModelsEntry.qs_all(ys), fx, e3)))
    case Wr.Bad{}:
      Unit{}

def cme.ql.loop(m: Nat, cur: Wr.Dec<Mod.Q>, +s: String, pc: cme.RQ1(s, cur)) -> cme.ql.PL(s, m, Wr.get_list.go(~Mod.Q, ~FMod.get_q, m, cur)):
  match m cur:
    case 0n Wr.Got{+x, +s3}:
      (e, f) = pc
      (e, ({==}, LACo.co.and_tt(CodemodeModelsEntry.q_fits(x), True{}, f, {==})))
    case 0n Wr.Bad{}:
      Unit{}
    case 1n++k Wr.Got{+x, +s3}:
      (e, f) = pc
      cme.ql.step(s, x, s3, k, e, f, Wr.get_list.go(~Mod.Q, ~FMod.get_q, k, FMod.get_q(s3)), cme.ql.loop(k, FMod.get_q(s3), s3, cme.q(s3)))
    case 1n++k Wr.Bad{}:
      Unit{}

def cme.ql.LS(s: String, d: Wr.Dec<List<&2, Mod.Q>>) -> Type:
  match d:
    case Wr.Got{+xs, r}:
      {s == Wr.put_nat(List.length(&2, Mod.Q, xs), CodemodeModelsEntry.spell_qs.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(List.length(&2, Mod.Q, xs)), CodemodeModelsEntry.qs_all(xs)) == True{} : Bool}
    case Wr.Bad{}:
      Unit

def cme.ql.conv(-s: String, -s2: String, +m: Nat, en: {s == Wr.put_nat(1n+m, s2) : String}, fn: {LawsBase.wire_fits(1n+m) == True{} : Bool}, d: Wr.Dec<List<&2, Mod.Q>>, pl: cme.ql.PL(s2, m, d)) -> cme.ql.LS(s, d):
  match d:
    case Wr.Got{+xs, +r}:
      (e1, rest) = pl
      (+e2, e3) = rest
      %Equal.sym(Nat, List.length(&2, Mod.Q, xs), 1n+m, e2) : {s == Wr.put_nat(_, CodemodeModelsEntry.spell_qs.items(xs, r)) : String} & {Bool.and(LawsBase.wire_fits(_), CodemodeModelsEntry.qs_all(xs)) == True{} : Bool}
      (cme.under(s, s2, CodemodeModelsEntry.spell_qs.items(xs, r), y => Wr.put_nat(1n+m, y), en, e1), LACo.co.and_tt(LawsBase.wire_fits(1n+m), CodemodeModelsEntry.qs_all(xs), fn, e3))
    case Wr.Bad{}:
      Unit{}

def cme.ql.nat(-s: String, n: Nat, +s2: String, en: {s == Wr.put_nat(n, s2) : String}, fn: {LawsBase.wire_fits(n) == True{} : Bool}) -> cme.ql.LS(s, Wr.get_list.start(~Mod.Q, ~FMod.get_q, Wr.Got{n, s2})):
  match n:
    case 0n:
      (en, {==})
    case 1n++m:
      cme.ql.conv(s, s2, m, en, fn, Wr.get_list.go(~Mod.Q, ~FMod.get_q, m, FMod.get_q(s2)), cme.ql.loop(m, FMod.get_q(s2), s2, cme.q(s2)))

def cme.ql.top(+s: String, d: Wr.Dec<Nat>, ed: {Wr.get_nat(s) == d : Wr.Dec<Nat>}) -> cme.ql.LS(s, Wr.get_list.start(~Mod.Q, ~FMod.get_q, d)):
  match d:
    case Wr.Got{+n, +s2}:
      +e = ed
      cme.ql.nat(s, n, s2, Wire.wire_nat_exact(s, n, s2, e), Wire.wire_nat_decoded_fits(s, n, s2, e))
    case Wr.Bad{}:
      Unit{}

def cme.ql.list(+s: String) -> cme.ql.LS(s, Wr.get_list(~Mod.Q, ~FMod.get_q, s)):
  cme.ql.top(s, Wr.get_nat(s), {==})
