def cme.q.s5(-s: String, -s5: String, +id: String, +q: Mod.Desc, +ins: Mod.Desc, +kind: Mod.Txt, +json: String, e0: {s == Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, s5))))) : String}, g_id: {CodemodeModelsEntry.str_fits(id) == True{} : Bool}, g_q: {CodemodeModelsEntry.desc_fits(q) == True{} : Bool}, g_ins: {CodemodeModelsEntry.desc_fits(ins) == True{} : Bool}, g_kind: {CodemodeModelsEntry.txt_fits(kind) == True{} : Bool}, g_json: {CodemodeModelsEntry.str_fits(json) == True{} : Bool}, dd: Wr.Dec<Mod.Desc>, pp: cme.PD(s5, dd)) -> cme.RQ1(s, FMod.get_q.criteria(id, q, ins, kind, json, dd)):
  match dd:
    case Wr.Got{+c, +s6}:
      (e1, g_c) = pp
      cme.q.s6(s, s6, id, q, ins, kind, json, c, cme.under(s, s5, CodemodeModelsEntry.spell_desc(c, s6), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, y))))), e0, e1), g_id, g_q, g_ins, g_kind, g_json, g_c, Wr.get_list(~Mod.Desc, ~FMod.get_desc, s6), cme.dl.list(s6))
    case Wr.Bad{}:
