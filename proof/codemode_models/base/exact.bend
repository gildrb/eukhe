      cme.q.s8(s, s8, id, q, ins, kind, json, c, vs, yes, cme.under(s, s7, CodemodeModelsEntry.spell_desc(yes, s8), y => Wr.put_str(id, CodemodeModelsEntry.spell_desc(q, CodemodeModelsEntry.spell_desc(ins, CodemodeModelsEntry.spell_txt(kind, Wr.put_str(json, CodemodeModelsEntry.spell_desc(c, CodemodeModelsEntry.spell_descs(vs, y))))))), e0, e1), g_id, g_q, g_ins, g_kind, g_json, g_c, g_vs, g_yes, FMod.get_desc(s8), cme.desc(s8))
    case Wr.Bad{}:
