      cme.rq.catalog.s3(s, s3, n, a, k, LACmExact.cme.under(s, s2, CodemodeModelsEntry.spell_txt(k, s3), y => Wr.put_nat(3n, Wr.put_str(n, CodemodeModelsEntry.spell_descs(a, y))), e0, e1), g_n, g_a, g_k, Wr.get_str(s3), LACmExact.cme.str(s3))
    case Wr.Bad{}:
      Unit{}

def cme.rq.catalog.s1(-s: String, -s1: String, +n: String, e0: {s == Wr.put_nat(3n, Wr.put_str(n, s1)) : String}, g_n: {CodemodeModelsEntry.str_fits(n) == True{} : Bool}, dd: Wr.Dec<List<&2, Mod.Desc>>, pp: LACmExact.cme.dl.LS(s1, dd)) -> cme.RQ(s, FMod.get_catalog.args(n, dd)):
  match dd:
    case Wr.Got{+a, +s2}:
      (e1, g_a) = pp
      cme.rq.catalog.s2(s, s2, n, a, LACmExact.cme.under(s, s1, CodemodeModelsEntry.spell_descs(a, s2), y => Wr.put_nat(3n, Wr.put_str(n, y)), e0, e1), g_n, g_a, FMod.get_txt(s2), LACmExact.cme.txt(s2))
    case Wr.Bad{}:
      Unit{}

def cme.rq.catalog.s0(-s: String, -s0: String, e0: {s == Wr.put_nat(3n, s0) : String}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s0, dd)) -> cme.RQ(s, FMod.get_catalog(dd)):
  match dd:
    case Wr.Got{+n, +s1}:
      (e1, g_n) = pp
      cme.rq.catalog.s1(s, s1, n, LACmExact.cme.under(s, s0, Wr.put_str(n, s1), y => Wr.put_nat(3n, y), e0, e1), g_n, Wr.get_list(~Mod.Desc, ~FMod.get_desc, s1), LACmExact.cme.dl.list(s1))
    case Wr.Bad{}:
      Unit{}

def cme.rq.tool.s0(-s: String, -s0: String, e0: {s == Wr.put_nat(4n, s0) : String}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s0, dd)) -> cme.RQ(s, FMod.get_tool(dd)):
  match dd:
    case Wr.Got{+g, +s1}:
      (e1, g_g) = pp
      (LACmExact.cme.under(s, s0, Wr.put_str(g, s1), y => Wr.put_nat(4n, y), e0, e1), g_g)
    case Wr.Bad{}:
      Unit{}

def cme.rq.result.s4(-s: String, -s4: String, +c: Mod.Call, +p: String, +i: String, +st: String, e0: {s == Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, Wr.put_str(i, Wr.put_str(st, s4))))) : String}, g_p: {CodemodeModelsEntry.str_fits(p) == True{} : Bool}, g_i: {CodemodeModelsEntry.str_fits(i) == True{} : Bool}, g_st: {CodemodeModelsEntry.str_fits(st) == True{} : Bool}, dd: Wr.Dec<Mod.Txt>, pp: LACmExact.cme.PT(s4, dd)) -> cme.RQ(s, FMod.get_result.error(c, p, i, st, dd)):
  match dd:
    case Wr.Got{+e, +s5}:
      (e1, g_e) = pp
      (LACmExact.cme.under(s, s4, CodemodeModelsEntry.spell_txt(e, s5), y => Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, Wr.put_str(i, Wr.put_str(st, y))))), e0, e1), LACo.co.and_tt(CodemodeModelsEntry.str_fits(p), Bool.and(CodemodeModelsEntry.str_fits(i), Bool.and(CodemodeModelsEntry.str_fits(st), CodemodeModelsEntry.txt_fits(e))), g_p, LACo.co.and_tt(CodemodeModelsEntry.str_fits(i), Bool.and(CodemodeModelsEntry.str_fits(st), CodemodeModelsEntry.txt_fits(e)), g_i, LACo.co.and_tt(CodemodeModelsEntry.str_fits(st), CodemodeModelsEntry.txt_fits(e), g_st, g_e))))
    case Wr.Bad{}:
      Unit{}

def cme.rq.result.s3(-s: String, -s3: String, +c: Mod.Call, +p: String, +i: String, e0: {s == Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, Wr.put_str(i, s3)))) : String}, g_p: {CodemodeModelsEntry.str_fits(p) == True{} : Bool}, g_i: {CodemodeModelsEntry.str_fits(i) == True{} : Bool}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s3, dd)) -> cme.RQ(s, FMod.get_result.stop(c, p, i, dd)):
  match dd:
    case Wr.Got{+st, +s4}:
      (e1, g_st) = pp
      cme.rq.result.s4(s, s4, c, p, i, st, LACmExact.cme.under(s, s3, Wr.put_str(st, s4), y => Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, Wr.put_str(i, y)))), e0, e1), g_p, g_i, g_st, FMod.get_txt(s4), LACmExact.cme.txt(s4))
    case Wr.Bad{}:
      Unit{}

def cme.rq.result.s2(-s: String, -s2: String, +c: Mod.Call, +p: String, e0: {s == Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, s2))) : String}, g_p: {CodemodeModelsEntry.str_fits(p) == True{} : Bool}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s2, dd)) -> cme.RQ(s, FMod.get_result.id(c, p, dd)):
  match dd:
    case Wr.Got{+i, +s3}:
      (e1, g_i) = pp
      cme.rq.result.s3(s, s3, c, p, i, LACmExact.cme.under(s, s2, Wr.put_str(i, s3), y => Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, Wr.put_str(p, y))), e0, e1), g_p, g_i, Wr.get_str(s3), LACmExact.cme.str(s3))
    case Wr.Bad{}:
      Unit{}

def cme.rq.result.s1(-s: String, -s1: String, +c: Mod.Call, e0: {s == Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, s1)) : String}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s1, dd)) -> cme.RQ(s, FMod.get_result.provider(c, dd)):
  match dd:
    case Wr.Got{+p, +s2}:
      (e1, g_p) = pp
      cme.rq.result.s2(s, s2, c, p, LACmExact.cme.under(s, s1, Wr.put_str(p, s2), y => Wr.put_nat(5n, CodemodeModelsEntry.spell_call(c, y)), e0, e1), g_p, Wr.get_str(s2), LACmExact.cme.str(s2))
    case Wr.Bad{}:
      Unit{}

def cme.rq.result.s0(-s: String, -s0: String, e0: {s == Wr.put_nat(5n, s0) : String}, dd: Wr.Dec<Mod.Call>, pp: LACmExact.cme.PC(s0, dd)) -> cme.RQ(s, FMod.get_result(dd)):
  match dd:
    case Wr.Got{+c, +s1}:
      e1 = pp
      cme.rq.result.s1(s, s1, c, LACmExact.cme.under(s, s0, CodemodeModelsEntry.spell_call(c, s1), y => Wr.put_nat(5n, y), e0, e1), Wr.get_str(s1), LACmExact.cme.str(s1))
    case Wr.Bad{}:
      Unit{}

def cme.rq.unread.s1(-s: String, -s1: String, +c: Mod.Call, e0: {s == Wr.put_nat(6n, CodemodeModelsEntry.spell_call(c, s1)) : String}, dd: Wr.Dec<String>, pp: LACmExact.cme.PS(s1, dd)) -> cme.RQ(s, FMod.get_unread.error(c, dd)):
  match dd:
    case Wr.Got{+e, +s2}:
      (e1, g_e) = pp
      (LACmExact.cme.under(s, s1, Wr.put_str(e, s2), y => Wr.put_nat(6n, CodemodeModelsEntry.spell_call(c, y)), e0, e1), g_e)
    case Wr.Bad{}:
      Unit{}

def cme.rq.unread.s0(-s: String, -s0: String, e0: {s == Wr.put_nat(6n, s0) : String}, dd: Wr.Dec<Mod.Call>, pp: LACmExact.cme.PC(s0, dd)) -> cme.RQ(s, FMod.get_unread(dd)):
  match dd:
    case Wr.Got{+c, +s1}:
      e1 = pp
      cme.rq.unread.s1(s, s1, c, LACmExact.cme.under(s, s0, CodemodeModelsEntry.spell_call(c, s1), y => Wr.put_nat(6n, y), e0, e1), Wr.get_str(s1), LACmExact.cme.str(s1))
    case Wr.Bad{}:
      Unit{}

def cme.rq.top(-s: String, d: Wr.Dec<Nat>, p: LACoExact.coe.PNF(s, d)) -> cme.RQ(s, FMod.get_req.tag(d)):
  match d:
    case Wr.Got{t, +s1}:
      match t:
        case 0n:
          (e0, f0) = p
          cme.rq.classify.s0(s, s1, e0, FMod.get_desc(s1), LACmExact.cme.desc(s1))
        case 1n:
          (e0, f0) = p
          cme.rq.images.s0(s, s1, e0, FMod.get_desc(s1), LACmExact.cme.desc(s1))
        case 2n:
          (e0, f0) = p
          cme.rq.resolve.s0(s, s1, e0, FMod.get_call(s1), LACmExact.cme.call(s1))
        case 3n:
          (e0, f0) = p
          cme.rq.catalog.s0(s, s1, e0, Wr.get_str(s1), LACmExact.cme.str(s1))
        case 4n:
          (e0, f0) = p
          cme.rq.tool.s0(s, s1, e0, Wr.get_str(s1), LACmExact.cme.str(s1))
        case 5n:
          (e0, f0) = p
          cme.rq.result.s0(s, s1, e0, FMod.get_call(s1), LACmExact.cme.call(s1))
        case 6n:
          (e0, f0) = p
          cme.rq.unread.s0(s, s1, e0, FMod.get_call(s1), LACmExact.cme.call(s1))
        case 7n:
          (e0, f0) = p
          (e0, {==})
        case 8n+u:
          Unit{}
    case Wr.Bad{}:
      Unit{}

# a request decoded is spelled, and its numbers fit
def cme.req(+s: String) -> cme.RQ(s, FMod.get_req(s)):
  cme.rq.top(s, Wr.get_nat(s), LACoExact.coe.pnf(s))
