def cme.RQ(s: String, d: Wr.Dec<FMod.Req>) -> Type:
  match d:
    case Wr.Got{+q, r}:
      {s == CodemodeModelsEntry.spell_req(q, r) : String} & {CodemodeModelsEntry.req_fits(q) == True{} : Bool}
    case Wr.Bad{}:
      Unit

