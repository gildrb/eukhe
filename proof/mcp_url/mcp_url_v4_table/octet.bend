# eukhe: lemmas of the proof of LAW mcp_url_v4_table: what the model does
# with the decimal spelling of each octet 0-255 (mvo.of, one arm per
# octet, each computed): it reads as that octet, holds no bracket, no
# uppercase letter and no `.`, and starts and ends with a digit.

import Base
import ../../../bend/mcp_url.bend as Mu
import ../../../laws/mcp_url.bend as McpUrl
import ../base/text.bend as LT

# String.order once a char differs
def mvo.ord_lt(a: String, b: String) -> {String.order.go(a, b, LT{}) == LT{} : Cmp}:
  match a:
    case SNil{}:
      match b:
        case SNil{}:
          {==}
        case SCon{y, t}:
          {==}
    case SCon{x, s}:
      match x:
        case Chr{xx}:
          match b:
            case SNil{}:
              {==}
            case SCon{y, t}:
              match y:
                case Chr{yy}:
                  {==}

# what the model does with the spelling of the octet n
def mvo.OF(+n: Nat) -> Type:
  {Mu.part(Nat.show(n)) == Mu.POct{Mu.dec(Nat.show(n), 0)} : Mu.Part} & ((@r: String -> {Mu.drop_open(String.append(Nat.show(n), r)) == String.append(Nat.show(n), r) : String}) & ({Mu.drop_close(Nat.show(n)) == Nat.show(n) : String} & ({String.to_lower(Nat.show(n)) == Nat.show(n) : String} & ((@r: String -> {String.eq(String.append(Nat.show(n), r), "localhost") == False{} : Bool}) & ((@acc: String -> {String.starts_with(String.reverse.go(Nat.show(n), acc), String.reverse(".localhost")) == False{} : Bool}) & ((@r: String -> {String.split(String.append(Nat.show(n), SCon{'.', r}), '.') == Nat.show(n) <> String.split(r, '.') : List<&2, String>}) & {String.split(Nat.show(n), '.') == [Nat.show(n)] : List<&2, String>}))))))

def mvo.of(n: Nat, h: {Nat.is_le(n, 255n) == True{} : Bool}) -> mvo.OF(n):
  match n:
    case 0n:
      ({==}, (r => {==}, ({==}, ({==}, (r => Equal.cong(Cmp, Bool, z => Cmp.is_eq(z), String.order.go(r, "ocalhost", LT{}), LT{}, mvo.ord_lt(r, "ocalhost")), (acc => {==}, (r => {==}, {==})))))))
    case 1n:
      ({==}, (r => {==}, ({==}, ({==}, (r => Equal.cong(Cmp, Bool, z => Cmp.is_eq(z), String.order.go(r, "ocalhost", LT{}), LT{}, mvo.ord_lt(r, "ocalhost")), (acc => {==}, (r => {==}, {==})))))))
