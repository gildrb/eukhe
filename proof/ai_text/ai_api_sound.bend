# eukhe: the proof of LAW ai_api_sound
#
# PROOF: a hit of the walk from the start flag True is a version part
# after the start or a `/` (aita.go_sound).

import Base
import ../../laws/ai_text.bend as AiText
import ./base/api.bend as LP

def AiText.ai_api_sound(s, h):
  LP.aita.go_sound(s, True{}, h)
