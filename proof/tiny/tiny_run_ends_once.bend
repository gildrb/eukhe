# eukhe: the proof of LAW tiny_run_ends_once
#
# PROOF: an ended run is Over, which answers nothing to every outcome
# and stays Over (tz.over). From any phase not yet ended, a step's reply
# either ends the run, and then the phase is Over (a case per phase and
# outcome, tz.step; a pong's comparison is a case of its own, tz.elect,
# tz.check), or does not, and then the run is not ended and the
# induction goes on (tz.go). This file is generated by a case table.

import Base
import ../../bend/tiny.bend as Tn
import ../../laws/tiny/run.bend as TinyRun

# an ended run answers nothing, whatever comes
def tz.over(ss: List<&2, Tn.Seen>, +m: String) -> {TinyRun.tr_once(ss, Tn.Run{m, Tn.Over{}}, True{}) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case s <> rest:
      tz.over(rest, m)

def tz.elect(+rest: List<&2, Tn.Seen>, +m: String, b: Bool, ih: @q: Tn.Phase -> {TinyRun.tr_once(rest, Tn.Run{m, q}, False{}) == True{} : Bool}) -> {Bool.and(TinyRun.tr_once.at(False{}, TinyRun.tr_do(Tn.run.elect(m, Tn.elect.pong(b)))), TinyRun.tr_once(rest, TinyRun.tr_run(Tn.run.elect(m, Tn.elect.pong(b))), Bool.or(False{}, TinyRun.tr_ends(TinyRun.tr_do(Tn.run.elect(m, Tn.elect.pong(b))))))) == True{} : Bool}:
  match b:
    case True{}:
      tz.over(rest, m)
    case False{}:
      ih(Tn.Shutting{})

def tz.check(+rest: List<&2, Tn.Seen>, +m: String, +g: Tn.Got, b: Bool) -> {Bool.and(TinyRun.tr_once.at(False{}, TinyRun.tr_do(Tn.run.check(m, g, Tn.confirm.pong(b)))), TinyRun.tr_once(rest, TinyRun.tr_run(Tn.run.check(m, g, Tn.confirm.pong(b))), Bool.or(False{}, TinyRun.tr_ends(TinyRun.tr_do(Tn.run.check(m, g, Tn.confirm.pong(b))))))) == True{} : Bool}:
  match b:
    case True{}:
      tz.over(rest, m)
    case False{}:
      tz.over(rest, m)

def tz.step(ph: Tn.Phase, s: Tn.Seen, +m: String, +rest: List<&2, Tn.Seen>, ih: @q: Tn.Phase -> {TinyRun.tr_once(rest, Tn.Run{m, q}, False{}) == True{} : Bool}) -> {Bool.and(TinyRun.tr_once.at(False{}, TinyRun.tr_do(Tn.step_run(Tn.Run{m, ph}, s))), TinyRun.tr_once(rest, TinyRun.tr_run(Tn.step_run(Tn.Run{m, ph}, s)), Bool.or(False{}, TinyRun.tr_ends(TinyRun.tr_do(Tn.step_run(Tn.Run{m, ph}, s)))))) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Launching{Tn.First{}})
            case Tn.Unreachable{}:
              tz.over(rest, m)
            case Tn.Pong{+t}:
              tz.elect(rest, m, Tn.same(t, m), ih)
            case Tn.Odd{}:
              tz.over(rest, m)
            case Tn.Garbled{}:
              tz.over(rest, m)
            case Tn.Hung{}:
              ih(Tn.Launching{Tn.First{}})
        case Tn.ShutHeard{h}:
          ih(Tn.Probing{})
        case Tn.Came{+l}:
          ih(Tn.Probing{})
        case Tn.NoSpawn{}:
          ih(Tn.Probing{})
        case Tn.Locked{}:
          ih(Tn.Probing{})
    case Tn.Shutting{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Shutting{})
        case Tn.ShutHeard{h}:
          match h:
            case Tn.Bye{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Other{}:
              tz.over(rest, m)
            case Tn.Eof{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Lost{}:
              tz.over(rest, m)
        case Tn.Came{+l}:
          ih(Tn.Shutting{})
        case Tn.NoSpawn{}:
          ih(Tn.Shutting{})
        case Tn.Locked{}:
          ih(Tn.Shutting{})
    case Tn.Launching{+f}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Launching{f})
        case Tn.ShutHeard{h}:
          ih(Tn.Launching{f})
        case Tn.Came{+l}:
          ih(Tn.Checking{Tn.launched(f, l)})
        case Tn.NoSpawn{}:
          tz.over(rest, m)
        case Tn.Locked{}:
          ih(Tn.Launching{f})
    case Tn.Checking{+g}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              tz.over(rest, m)
            case Tn.Unreachable{}:
              tz.over(rest, m)
            case Tn.Pong{+t}:
              tz.check(rest, m, g, Tn.same(t, m))
            case Tn.Odd{}:
              tz.over(rest, m)
            case Tn.Garbled{}:
              tz.over(rest, m)
            case Tn.Hung{}:
              tz.over(rest, m)
        case Tn.ShutHeard{h}:
          ih(Tn.Checking{g})
        case Tn.Came{+l}:
          ih(Tn.Checking{g})
        case Tn.NoSpawn{}:
          ih(Tn.Checking{g})
        case Tn.Locked{}:
          ih(Tn.Checking{g})
    case Tn.Locking{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Locking{})
        case Tn.ShutHeard{h}:
          ih(Tn.Locking{})
        case Tn.Came{+l}:
          ih(Tn.Locking{})
        case Tn.NoSpawn{}:
          ih(Tn.Locking{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Seating{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              tz.over(rest, m)
            case Tn.Unreachable{}:
              tz.over(rest, m)
            case Tn.Pong{t}:
              tz.over(rest, m)
            case Tn.Odd{}:
              tz.over(rest, m)
            case Tn.Garbled{}:
              tz.over(rest, m)
            case Tn.Hung{}:
              tz.over(rest, m)
        case Tn.ShutHeard{h}:
          ih(Tn.Seating{})
        case Tn.Came{+l}:
          ih(Tn.Seating{})
        case Tn.NoSpawn{}:
          ih(Tn.Seating{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Over{}:
      ih(Tn.Over{})

def tz.go(ss: List<&2, Tn.Seen>, +m: String, ph: Tn.Phase) -> {TinyRun.tr_once(ss, Tn.Run{m, ph}, False{}) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case s <> +rest:
      tz.step(ph, s, m, rest, q => tz.go(rest, m, q))

def TinyRun.tiny_run_ends_once(x, ss):
  match x:
    case Tn.Run{+m, ph}:
      tz.go(ss, m, ph)
