# eukhe: the proof of LAW tiny_run_at_most_once
#
# PROOF: each phase has a cap per kind of reply: the launches (kind 0),
# shutdowns (1) and pings (2) a run can still answer from it (tc.capK).
# A step answers at most what the cap of its phase leaves after the cap
# of the phase it goes to: an awaited outcome moves the run forward
# (Probing, Shutting, Launching, Checking, Over; Locking, Seating, Over)
# with one reply, an outcome not awaited answers nothing and stays (a
# case per phase and outcome, tc.cK_step; on a pong the comparison's
# answer is a case of its own, tc.cK_elect, tc.cK_check). By induction on
# the outcomes the count from a phase is at most its cap (tc.cK), and
# every cap is at most 1 (tc.leK). This file is generated by a case
# table: every case is one of three forms (the cap kept, the cap spent
# by the reply, or a cap of 0 read as at most 1).

import Base
import ../../bend/tiny.bend as Tn
import ../../laws/tiny/run.bend as TinyRun
import ./base.bend as LA

# a count of 0 is a count of at most 1
def tc.up(c: Nat, h: {Nat.is_le(c, 0n) == True{} : Bool}) -> {Nat.is_le(c, 1n) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+p:
      LA.tiny.pn.absurdF({Nat.is_le(1n+p, 1n) == True{} : Bool}, h)

def tc.three(-a: Bool, -b: Bool, -c: Bool, ea: {a == True{} : Bool}, eb: {b == True{} : Bool}, ec: {c == True{} : Bool}) -> {[a, b, c] == [True{}, True{}, True{}] : List<&2, Bool>}:
  %Equal.sym(Bool, a, True{}, ea) : {[_, b, c] == [True{}, True{}, True{}] : List<&2, Bool>}
  %Equal.sym(Bool, b, True{}, eb) : {[True{}, _, c] == [True{}, True{}, True{}] : List<&2, Bool>}
  %Equal.sym(Bool, c, True{}, ec) : {[True{}, True{}, _] == [True{}, True{}, True{}] : List<&2, Bool>}
  {==}

# Kind 0
# ------

def tc.cap0(ph: Tn.Phase) -> Nat:
  match ph:
    case Tn.Probing{}:
      1n
    case Tn.Shutting{}:
      1n
    case Tn.Launching{f}:
      0n
    case Tn.Checking{g}:
      0n
    case Tn.Locking{}:
      0n
    case Tn.Seating{}:
      0n
    case Tn.Over{}:
      0n

def tc.c0_elect(+rest: List<&2, Tn.Seen>, +m: String, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(0n, rest, Tn.Run{m, q}), tc.cap0(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.elect(m, Tn.elect.pong(b))), 0n), TinyRun.tr_count(0n, rest, TinyRun.tr_run(Tn.run.elect(m, Tn.elect.pong(b))))), 1n) == True{} : Bool}:
  match b:
    case True{}:
      tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
    case False{}:
      ih(Tn.Shutting{})

def tc.c0_check(+rest: List<&2, Tn.Seen>, +m: String, +g: Tn.Got, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(0n, rest, Tn.Run{m, q}), tc.cap0(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.check(m, g, Tn.confirm.pong(b))), 0n), TinyRun.tr_count(0n, rest, TinyRun.tr_run(Tn.run.check(m, g, Tn.confirm.pong(b))))), 0n) == True{} : Bool}:
  match b:
    case True{}:
      ih(Tn.Over{})
    case False{}:
      ih(Tn.Over{})

def tc.c0_step(ph: Tn.Phase, s: Tn.Seen, +m: String, +rest: List<&2, Tn.Seen>, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(0n, rest, Tn.Run{m, q}), tc.cap0(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.step_run(Tn.Run{m, ph}, s)), 0n), TinyRun.tr_count(0n, rest, TinyRun.tr_run(Tn.step_run(Tn.Run{m, ph}, s)))), tc.cap0(ph)) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Launching{Tn.First{}})
            case Tn.Unreachable{}:
              tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Pong{+t}:
              tc.c0_elect(rest, m, Tn.same(t, m), ih)
            case Tn.Odd{}:
              tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Garbled{}:
              tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Hung{}:
              ih(Tn.Launching{Tn.First{}})
        case Tn.ShutHeard{h}:
          ih(Tn.Probing{})
        case Tn.Came{l}:
          ih(Tn.Probing{})
        case Tn.NoSpawn{}:
          ih(Tn.Probing{})
        case Tn.Locked{}:
          ih(Tn.Probing{})
    case Tn.Shutting{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Shutting{})
        case Tn.ShutHeard{h}:
          match h:
            case Tn.Bye{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Other{}:
              tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Eof{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Lost{}:
              tc.up(TinyRun.tr_count(0n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
        case Tn.Came{l}:
          ih(Tn.Shutting{})
        case Tn.NoSpawn{}:
          ih(Tn.Shutting{})
        case Tn.Locked{}:
          ih(Tn.Shutting{})
    case Tn.Launching{+f}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Launching{f})
        case Tn.ShutHeard{h}:
          ih(Tn.Launching{f})
        case Tn.Came{+l}:
          ih(Tn.Checking{Tn.launched(f, l)})
        case Tn.NoSpawn{}:
          ih(Tn.Over{})
        case Tn.Locked{}:
          ih(Tn.Launching{f})
    case Tn.Checking{+g}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{+t}:
              tc.c0_check(rest, m, g, Tn.same(t, m), ih)
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Checking{g})
        case Tn.Came{l}:
          ih(Tn.Checking{g})
        case Tn.NoSpawn{}:
          ih(Tn.Checking{g})
        case Tn.Locked{}:
          ih(Tn.Checking{g})
    case Tn.Locking{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Locking{})
        case Tn.ShutHeard{h}:
          ih(Tn.Locking{})
        case Tn.Came{l}:
          ih(Tn.Locking{})
        case Tn.NoSpawn{}:
          ih(Tn.Locking{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Seating{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{t}:
              ih(Tn.Over{})
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Seating{})
        case Tn.Came{l}:
          ih(Tn.Seating{})
        case Tn.NoSpawn{}:
          ih(Tn.Seating{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Over{}:
      ih(Tn.Over{})

def tc.c0(ss: List<&2, Tn.Seen>, +m: String, ph: Tn.Phase) -> {Nat.is_le(TinyRun.tr_count(0n, ss, Tn.Run{m, ph}), tc.cap0(ph)) == True{} : Bool}:
  match ss:
    case Nil{}:
      match ph:
        case Tn.Probing{}:
          {==}
        case Tn.Shutting{}:
          {==}
        case Tn.Launching{f}:
          {==}
        case Tn.Checking{g}:
          {==}
        case Tn.Locking{}:
          {==}
        case Tn.Seating{}:
          {==}
        case Tn.Over{}:
          {==}
    case s <> +rest:
      tc.c0_step(ph, s, m, rest, q => tc.c0(rest, m, q))

# a count from any phase is at most 1
def tc.le0(+m: String, ph: Tn.Phase, +ss: List<&2, Tn.Seen>) -> {Nat.is_le(TinyRun.tr_count(0n, ss, Tn.Run{m, ph}), 1n) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      tc.c0(ss, m, Tn.Probing{})
    case Tn.Shutting{}:
      tc.c0(ss, m, Tn.Shutting{})
    case Tn.Launching{+f}:
      tc.up(TinyRun.tr_count(0n, ss, Tn.Run{m, Tn.Launching{f}}), tc.c0(ss, m, Tn.Launching{f}))
    case Tn.Checking{+g}:
      tc.up(TinyRun.tr_count(0n, ss, Tn.Run{m, Tn.Checking{g}}), tc.c0(ss, m, Tn.Checking{g}))
    case Tn.Locking{}:
      tc.up(TinyRun.tr_count(0n, ss, Tn.Run{m, Tn.Locking{}}), tc.c0(ss, m, Tn.Locking{}))
    case Tn.Seating{}:
      tc.up(TinyRun.tr_count(0n, ss, Tn.Run{m, Tn.Seating{}}), tc.c0(ss, m, Tn.Seating{}))
    case Tn.Over{}:
      tc.up(TinyRun.tr_count(0n, ss, Tn.Run{m, Tn.Over{}}), tc.c0(ss, m, Tn.Over{}))

# Kind 1
# ------

def tc.cap1(ph: Tn.Phase) -> Nat:
  match ph:
    case Tn.Probing{}:
      1n
    case Tn.Shutting{}:
      0n
    case Tn.Launching{f}:
      0n
    case Tn.Checking{g}:
      0n
    case Tn.Locking{}:
      0n
    case Tn.Seating{}:
      0n
    case Tn.Over{}:
      0n

def tc.c1_elect(+rest: List<&2, Tn.Seen>, +m: String, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(1n, rest, Tn.Run{m, q}), tc.cap1(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.elect(m, Tn.elect.pong(b))), 1n), TinyRun.tr_count(1n, rest, TinyRun.tr_run(Tn.run.elect(m, Tn.elect.pong(b))))), 1n) == True{} : Bool}:
  match b:
    case True{}:
      tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
    case False{}:
      ih(Tn.Shutting{})

def tc.c1_check(+rest: List<&2, Tn.Seen>, +m: String, +g: Tn.Got, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(1n, rest, Tn.Run{m, q}), tc.cap1(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.check(m, g, Tn.confirm.pong(b))), 1n), TinyRun.tr_count(1n, rest, TinyRun.tr_run(Tn.run.check(m, g, Tn.confirm.pong(b))))), 0n) == True{} : Bool}:
  match b:
    case True{}:
      ih(Tn.Over{})
    case False{}:
      ih(Tn.Over{})

def tc.c1_step(ph: Tn.Phase, s: Tn.Seen, +m: String, +rest: List<&2, Tn.Seen>, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(1n, rest, Tn.Run{m, q}), tc.cap1(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.step_run(Tn.Run{m, ph}, s)), 1n), TinyRun.tr_count(1n, rest, TinyRun.tr_run(Tn.step_run(Tn.Run{m, ph}, s)))), tc.cap1(ph)) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Launching{Tn.First{}}}), ih(Tn.Launching{Tn.First{}}))
            case Tn.Unreachable{}:
              tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Pong{+t}:
              tc.c1_elect(rest, m, Tn.same(t, m), ih)
            case Tn.Odd{}:
              tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Garbled{}:
              tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Hung{}:
              tc.up(TinyRun.tr_count(1n, rest, Tn.Run{m, Tn.Launching{Tn.First{}}}), ih(Tn.Launching{Tn.First{}}))
        case Tn.ShutHeard{h}:
          ih(Tn.Probing{})
        case Tn.Came{l}:
          ih(Tn.Probing{})
        case Tn.NoSpawn{}:
          ih(Tn.Probing{})
        case Tn.Locked{}:
          ih(Tn.Probing{})
    case Tn.Shutting{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Shutting{})
        case Tn.ShutHeard{h}:
          match h:
            case Tn.Bye{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Other{}:
              ih(Tn.Over{})
            case Tn.Eof{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Lost{}:
              ih(Tn.Over{})
        case Tn.Came{l}:
          ih(Tn.Shutting{})
        case Tn.NoSpawn{}:
          ih(Tn.Shutting{})
        case Tn.Locked{}:
          ih(Tn.Shutting{})
    case Tn.Launching{+f}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Launching{f})
        case Tn.ShutHeard{h}:
          ih(Tn.Launching{f})
        case Tn.Came{+l}:
          ih(Tn.Checking{Tn.launched(f, l)})
        case Tn.NoSpawn{}:
          ih(Tn.Over{})
        case Tn.Locked{}:
          ih(Tn.Launching{f})
    case Tn.Checking{+g}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{+t}:
              tc.c1_check(rest, m, g, Tn.same(t, m), ih)
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Checking{g})
        case Tn.Came{l}:
          ih(Tn.Checking{g})
        case Tn.NoSpawn{}:
          ih(Tn.Checking{g})
        case Tn.Locked{}:
          ih(Tn.Checking{g})
    case Tn.Locking{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Locking{})
        case Tn.ShutHeard{h}:
          ih(Tn.Locking{})
        case Tn.Came{l}:
          ih(Tn.Locking{})
        case Tn.NoSpawn{}:
          ih(Tn.Locking{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Seating{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{t}:
              ih(Tn.Over{})
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Seating{})
        case Tn.Came{l}:
          ih(Tn.Seating{})
        case Tn.NoSpawn{}:
          ih(Tn.Seating{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Over{}:
      ih(Tn.Over{})

def tc.c1(ss: List<&2, Tn.Seen>, +m: String, ph: Tn.Phase) -> {Nat.is_le(TinyRun.tr_count(1n, ss, Tn.Run{m, ph}), tc.cap1(ph)) == True{} : Bool}:
  match ss:
    case Nil{}:
      match ph:
        case Tn.Probing{}:
          {==}
        case Tn.Shutting{}:
          {==}
        case Tn.Launching{f}:
          {==}
        case Tn.Checking{g}:
          {==}
        case Tn.Locking{}:
          {==}
        case Tn.Seating{}:
          {==}
        case Tn.Over{}:
          {==}
    case s <> +rest:
      tc.c1_step(ph, s, m, rest, q => tc.c1(rest, m, q))

# a count from any phase is at most 1
def tc.le1(+m: String, ph: Tn.Phase, +ss: List<&2, Tn.Seen>) -> {Nat.is_le(TinyRun.tr_count(1n, ss, Tn.Run{m, ph}), 1n) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      tc.c1(ss, m, Tn.Probing{})
    case Tn.Shutting{}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Shutting{}}), tc.c1(ss, m, Tn.Shutting{}))
    case Tn.Launching{+f}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Launching{f}}), tc.c1(ss, m, Tn.Launching{f}))
    case Tn.Checking{+g}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Checking{g}}), tc.c1(ss, m, Tn.Checking{g}))
    case Tn.Locking{}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Locking{}}), tc.c1(ss, m, Tn.Locking{}))
    case Tn.Seating{}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Seating{}}), tc.c1(ss, m, Tn.Seating{}))
    case Tn.Over{}:
      tc.up(TinyRun.tr_count(1n, ss, Tn.Run{m, Tn.Over{}}), tc.c1(ss, m, Tn.Over{}))

# Kind 2
# ------

def tc.cap2(ph: Tn.Phase) -> Nat:
  match ph:
    case Tn.Probing{}:
      1n
    case Tn.Shutting{}:
      1n
    case Tn.Launching{f}:
      1n
    case Tn.Checking{g}:
      0n
    case Tn.Locking{}:
      1n
    case Tn.Seating{}:
      0n
    case Tn.Over{}:
      0n

def tc.c2_elect(+rest: List<&2, Tn.Seen>, +m: String, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(2n, rest, Tn.Run{m, q}), tc.cap2(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.elect(m, Tn.elect.pong(b))), 2n), TinyRun.tr_count(2n, rest, TinyRun.tr_run(Tn.run.elect(m, Tn.elect.pong(b))))), 1n) == True{} : Bool}:
  match b:
    case True{}:
      tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
    case False{}:
      ih(Tn.Shutting{})

def tc.c2_check(+rest: List<&2, Tn.Seen>, +m: String, +g: Tn.Got, b: Bool, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(2n, rest, Tn.Run{m, q}), tc.cap2(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.run.check(m, g, Tn.confirm.pong(b))), 2n), TinyRun.tr_count(2n, rest, TinyRun.tr_run(Tn.run.check(m, g, Tn.confirm.pong(b))))), 0n) == True{} : Bool}:
  match b:
    case True{}:
      ih(Tn.Over{})
    case False{}:
      ih(Tn.Over{})

def tc.c2_step(ph: Tn.Phase, s: Tn.Seen, +m: String, +rest: List<&2, Tn.Seen>, ih: @q: Tn.Phase -> {Nat.is_le(TinyRun.tr_count(2n, rest, Tn.Run{m, q}), tc.cap2(q)) == True{} : Bool}) -> {Nat.is_le(Nat.add(TinyRun.tr_is(TinyRun.tr_do(Tn.step_run(Tn.Run{m, ph}, s)), 2n), TinyRun.tr_count(2n, rest, TinyRun.tr_run(Tn.step_run(Tn.Run{m, ph}, s)))), tc.cap2(ph)) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Launching{Tn.First{}})
            case Tn.Unreachable{}:
              tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Pong{+t}:
              tc.c2_elect(rest, m, Tn.same(t, m), ih)
            case Tn.Odd{}:
              tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Garbled{}:
              tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Hung{}:
              ih(Tn.Launching{Tn.First{}})
        case Tn.ShutHeard{h}:
          ih(Tn.Probing{})
        case Tn.Came{l}:
          ih(Tn.Probing{})
        case Tn.NoSpawn{}:
          ih(Tn.Probing{})
        case Tn.Locked{}:
          ih(Tn.Probing{})
    case Tn.Shutting{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Shutting{})
        case Tn.ShutHeard{h}:
          match h:
            case Tn.Bye{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Other{}:
              tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
            case Tn.Eof{}:
              ih(Tn.Launching{Tn.Again{}})
            case Tn.Lost{}:
              tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
        case Tn.Came{l}:
          ih(Tn.Shutting{})
        case Tn.NoSpawn{}:
          ih(Tn.Shutting{})
        case Tn.Locked{}:
          ih(Tn.Shutting{})
    case Tn.Launching{+f}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Launching{f})
        case Tn.ShutHeard{h}:
          ih(Tn.Launching{f})
        case Tn.Came{+l}:
          ih(Tn.Checking{Tn.launched(f, l)})
        case Tn.NoSpawn{}:
          tc.up(TinyRun.tr_count(2n, rest, Tn.Run{m, Tn.Over{}}), ih(Tn.Over{}))
        case Tn.Locked{}:
          ih(Tn.Launching{f})
    case Tn.Checking{+g}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{+t}:
              tc.c2_check(rest, m, g, Tn.same(t, m), ih)
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Checking{g})
        case Tn.Came{l}:
          ih(Tn.Checking{g})
        case Tn.NoSpawn{}:
          ih(Tn.Checking{g})
        case Tn.Locked{}:
          ih(Tn.Checking{g})
    case Tn.Locking{}:
      match s:
        case Tn.Pinged{p}:
          ih(Tn.Locking{})
        case Tn.ShutHeard{h}:
          ih(Tn.Locking{})
        case Tn.Came{l}:
          ih(Tn.Locking{})
        case Tn.NoSpawn{}:
          ih(Tn.Locking{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Seating{}:
      match s:
        case Tn.Pinged{p}:
          match p:
            case Tn.Missing{}:
              ih(Tn.Over{})
            case Tn.Unreachable{}:
              ih(Tn.Over{})
            case Tn.Pong{t}:
              ih(Tn.Over{})
            case Tn.Odd{}:
              ih(Tn.Over{})
            case Tn.Garbled{}:
              ih(Tn.Over{})
            case Tn.Hung{}:
              ih(Tn.Over{})
        case Tn.ShutHeard{h}:
          ih(Tn.Seating{})
        case Tn.Came{l}:
          ih(Tn.Seating{})
        case Tn.NoSpawn{}:
          ih(Tn.Seating{})
        case Tn.Locked{}:
          ih(Tn.Seating{})
    case Tn.Over{}:
      ih(Tn.Over{})

def tc.c2(ss: List<&2, Tn.Seen>, +m: String, ph: Tn.Phase) -> {Nat.is_le(TinyRun.tr_count(2n, ss, Tn.Run{m, ph}), tc.cap2(ph)) == True{} : Bool}:
  match ss:
    case Nil{}:
      match ph:
        case Tn.Probing{}:
          {==}
        case Tn.Shutting{}:
          {==}
        case Tn.Launching{f}:
          {==}
        case Tn.Checking{g}:
          {==}
        case Tn.Locking{}:
          {==}
        case Tn.Seating{}:
          {==}
        case Tn.Over{}:
          {==}
    case s <> +rest:
      tc.c2_step(ph, s, m, rest, q => tc.c2(rest, m, q))

# a count from any phase is at most 1
def tc.le2(+m: String, ph: Tn.Phase, +ss: List<&2, Tn.Seen>) -> {Nat.is_le(TinyRun.tr_count(2n, ss, Tn.Run{m, ph}), 1n) == True{} : Bool}:
  match ph:
    case Tn.Probing{}:
      tc.c2(ss, m, Tn.Probing{})
    case Tn.Shutting{}:
      tc.c2(ss, m, Tn.Shutting{})
    case Tn.Launching{+f}:
      tc.c2(ss, m, Tn.Launching{f})
    case Tn.Checking{+g}:
      tc.up(TinyRun.tr_count(2n, ss, Tn.Run{m, Tn.Checking{g}}), tc.c2(ss, m, Tn.Checking{g}))
    case Tn.Locking{}:
      tc.c2(ss, m, Tn.Locking{})
    case Tn.Seating{}:
      tc.up(TinyRun.tr_count(2n, ss, Tn.Run{m, Tn.Seating{}}), tc.c2(ss, m, Tn.Seating{}))
    case Tn.Over{}:
      tc.up(TinyRun.tr_count(2n, ss, Tn.Run{m, Tn.Over{}}), tc.c2(ss, m, Tn.Over{}))

def TinyRun.tiny_run_at_most_once(x, ss):
  match x:
    case Tn.Run{+m, +ph}:
      tc.three(Nat.is_le(TinyRun.tr_count(0n, ss, Tn.Run{m, ph}), 1n), Nat.is_le(TinyRun.tr_count(1n, ss, Tn.Run{m, ph}), 1n), Nat.is_le(TinyRun.tr_count(2n, ss, Tn.Run{m, ph}), 1n), tc.le0(m, ph, ss), tc.le1(m, ph, ss), tc.le2(m, ph, ss))
