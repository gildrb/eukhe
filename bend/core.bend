def step.go(state: State, input: String) -> State & String:
  match state:
    case Echo{s}:
      step.echo(ffi_echo.step(s, input))
    case Admission{s}:
      step.admission(ffi_admission.step(s, input))
    case Cvar{s}:
      step.cvar(ffi_cvar.step(s, input))
    case Tree{s}:
      step.tree(ffi_tree.step(s, input))
    case Notice{s}:
      step.notice(ffi_notice.step(s, input))
    case Log{s}:
      step.log(ffi_log.step(s, input))
    case Selection{s}:
      step.selection(ffi_selection.step(s, input))
    case DocSearch{s}:
      step.doc_search(ffi_doc_search.step(s, input))
    case DocGlob{s}:
      step.doc_glob(ffi_doc_glob.step(s, input))
    case Quirks{s}:
      step.quirks(ffi_quirks.step(s, input))
    case InferGuard{s}:
      step.infer_guard(ffi_infer_guard.step(s, input))
    case Bound{s}:
      step.bound(ffi_bound.step(s, input))
    case Work{s}:
      step.work(ffi_work.step(s, input))
    case Lease{s}:
      step.lease(ffi_lease.step(s, input))
    case AuthFlight{s}:
      step.auth_flight(ffi_auth_flight.step(s, input))
    case WaitRace{s}:
      step.wait_race(ffi_wait_race.step(s, input))
    case Unknown{}:
      (Unknown{}, W.err("unknown entry"))

# step: the state after one input, and the reply.
def step(state: State, input: String) -> State & String:
  r u = step.go(state, input) seg.pin()
  r

def close.go(state: State) -> Unit:
  match state:
    case Echo{s}:
      Unit{}
    case Admission{s}:
      Unit{}
    case Cvar{s}:
      Unit{}
    case Tree{s}:
      Unit{}
    case Notice{s}:
      Unit{}
    case Log{s}:
      Unit{}
    case Selection{s}:
      Unit{}
    case DocSearch{s}:
      Unit{}
    case DocGlob{s}:
      Unit{}
    case Quirks{s}:
      Unit{}
    case InferGuard{s}:
      Unit{}
    case Bound{s}:
      Unit{}
    case Work{s}:
      Unit{}
    case Lease{s}:
      Unit{}
    case AuthFlight{s}:
      Unit{}
    case WaitRace{s}:
      Unit{}
    case Unknown{}:
      Unit{}

# close: drops a state.
def close(state: State) -> Unit:
  r u = close.go(state) seg.pin()
  r

# The debugging CLI (bend bend/core.bend call|open ...).
def cli.done(u: Unit, reply: String) -> List<String>:
  match u:
    case Unit{}:
      [reply]

def cli.steps(events: List<String>, r: State & String) -> List<String>:
  match events r:
    case Nil{} Tuple{state, reply}:
      cli.done(close(state), reply)
    case Con{ev, rest} Tuple{state, reply}:
      reply <> cli.steps(rest, step(state, ev))

def cli.call(events: List<String>, +entry: U32, input: String) -> Maybe<&1, List<String>>:
  match events:
    case Nil{}:
      Some{[ffi(entry, input)]}
    case Con{ev, rest}:
      None{}

def cli.run(
  is_call: Bool, is_open: Bool, id: Maybe<&2, U32>, input: String, events: List<String>
) -> Maybe<&1, List<String>>:
  match is_call is_open id:
    case True{} False{} Some{+n}:
      cli.call(events, n, input)
    case False{} True{} Some{+n}:
      Some{cli.steps(events, open(n, input))}
    case True{} True{} Some{+n}:
      None{}
    case False{} False{} Some{+n}:
      None{}
    case _ _ None{}:
      None{}

def cli.args(args: List<String>) -> Maybe<&1, List<String>>:
  match args:
    case Con{prog, Con{+mode, Con{id, Con{input, events}}}}:
      cli.run(String.eq(mode, "call"), String.eq(mode, "open"), U32.read(id), input, events)
    case Nil{}:
      None{}
    case Con{prog, Nil{}}:
      None{}
    case Con{prog, Con{mode, Nil{}}}:
      None{}
    case Con{prog, Con{mode, Con{id, Nil{}}}}:
      None{}

def cli.print(lines: List<String>) -> IO(Unit):
  match lines:
    case Nil{}:
      IO.pure(Unit, Unit{})
    case Con{line, rest}:
      do IO<Unit>:
        IO.print(line)
        cli.print(rest)

def cli.out(r: Maybe<&1, List<String>>) -> IO(Unit):
  match r:
    case Some{lines}:
      cli.print(lines)
    case None{}:
      IO.die(Unit, 2, "usage: core call <entry> <input> | core open <entry> <input> [<event>...]")

def main() -> IO(Unit):
  do IO<Unit>:
    args : List<String> <- IO.args()
    cli.out(cli.args(args))
