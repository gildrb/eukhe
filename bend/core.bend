# call: the reply of the entry's `ffi` to one input.
def ffi(+entry: U32, input: String) -> String:
  r u = ffi.go(entry, input) seg.pin()
  r

# A stepper's state, tagged with its entry; Unknown: an unknown entry.
type State is Type:
  Echo{s: ffi_echo.St}
  Admission{s: ffi_admission.St}
  Cvar{s: ffi_cvar.St}
  Tree{s: ffi_tree.St}
  Notice{s: ffi_notice.St}
  Log{s: ffi_log.St}
  DocSearch{s: ffi_doc_search.St}
  Unknown{}

def open.echo(r: ffi_echo.St & String) -> State & String:
  match r:
    case (s, reply):
      (Echo{s}, reply)

def open.admission(r: ffi_admission.St & String) -> State & String:
  match r:
    case (s, reply):
      (Admission{s}, reply)

def open.cvar(r: ffi_cvar.St & String) -> State & String:
  match r:
    case (s, reply):
      (Cvar{s}, reply)

def open.tree(r: ffi_tree.St & String) -> State & String:
  match r:
    case (s, reply):
      (Tree{s}, reply)

def open.notice(r: ffi_notice.St & String) -> State & String:
  match r:
    case (s, reply):
      (Notice{s}, reply)

def open.log(r: ffi_log.St & String) -> State & String:
  match r:
    case (s, reply):
      (Log{s}, reply)

def open.doc_search(r: ffi_doc_search.St & String) -> State & String:
  match r:
    case (s, reply):
      (DocSearch{s}, reply)

def open.go(+entry: U32, input: String) -> State & String:
  match entry:
    case 0:
      open.echo(ffi_echo.open(input))
    case 2:
      open.admission(ffi_admission.open(input))
    case 6:
      open.cvar(ffi_cvar.open(input))
    case 20:
      open.tree(ffi_tree.open(input))
    case 32:
      open.notice(ffi_notice.open(input))
    case 33:
      open.log(ffi_log.open(input))
    case 40:
      open.doc_search(ffi_doc_search.open(input))
    case _:
      (Unknown{}, W.err("unknown entry"))

# open: a new state of the entry's stepper and its reply.
def open(+entry: U32, input: String) -> State & String:
  r u = open.go(entry, input) seg.pin()
  r

def step.echo(r: ffi_echo.St & String) -> State & String:
